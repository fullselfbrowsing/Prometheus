From ee7552e19bcfa05845c4e49110b25b1595fb0c13 Mon Sep 17 00:00:00 2001
From: Lakshman <lakshman@lakshman-GG9LQ90J61.local>
Date: Thu, 25 Jun 2026 03:45:49 -0500
Subject: [PATCH 09/15] feat(14-05): prometheus_vector_icons GN target, GRIT
 IDR constants, and PrometheusAction resolver header (DESIGN-04, D-06, D-08,
 D-09, D-10)

- chrome/browser/resources/prometheus/BUILD.gn: aggregate_vector_icons('prometheus_vector_icons') with all 72 .icon sources; no grit() target here (owned by 14-06)
- chrome/browser/resources/prometheus/vector_icons/vector_icons.{cc,h}.template: copied from components/vector_icons per Pitfall 6 (must be physically present in icon_directory)
- chrome/browser/resources/prometheus/prometheus_resources.grdp: IDR constants for 5 woff2 + 2 ttf (Thin+SpaceMono per D-11) + 72 FA SVGs + 7 brand mark PNGs
- chrome/browser/prometheus/prometheus_action.h: PrometheusAction enum (72 values) + GetPrometheusActionIconMap() + GetPrometheusActionSvgPath() declarations with D-08 substitution comments
---
 chrome/browser/prometheus/prometheus_action.h | 124 ++++++++
 chrome/browser/resources/prometheus/BUILD.gn  |  91 ++++++
 .../prometheus/prometheus_resources.grdp      | 292 ++++++++++++++++++
 .../vector_icons/vector_icons.cc.template     |  20 ++
 .../vector_icons/vector_icons.h.template      |  30 ++
 5 files changed, 557 insertions(+)
 create mode 100644 chrome/browser/prometheus/prometheus_action.h
 create mode 100644 chrome/browser/resources/prometheus/BUILD.gn
 create mode 100644 chrome/browser/resources/prometheus/prometheus_resources.grdp
 create mode 100644 chrome/browser/resources/prometheus/vector_icons/vector_icons.cc.template
 create mode 100644 chrome/browser/resources/prometheus/vector_icons/vector_icons.h.template

