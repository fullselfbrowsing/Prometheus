+TEST(PrometheusSupervisionTransportCodecTest,
+     EnforcesFieldProjectionAndTwoMiBResultCeiling) {
+  EXPECT_EQ(2'097'152u, kMaxSupervisionTransportOutputBytes);
+  SupervisionTransportResult at = SupervisionTransportResult::TransportFailure(
+      SupervisionTransportOperation::kHeartbeat,
+      SupervisionTransportErrorCode::kUnavailable,
+      std::string(kMaxSupervisionTransportMessageBytes, 'm'),
+      std::string(kMaxSupervisionTransportMessageBytes, 'r'));
+  EXPECT_TRUE(SerializeSupervisionDashboardResult(at).has_value());
+
+  SupervisionTransportResult over = at;
+  over.message.push_back('x');
+  auto oversized = SerializeSupervisionDashboardResult(over);
+  ASSERT_FALSE(oversized.has_value());
+  EXPECT_EQ(SupervisionTransportErrorCode::kRequestTooLarge,
+            oversized.error().transport_error);
+
+  SupervisionTransportResult invalid =
+      MakeDashboardResult(SupervisionTransportOperation::kBaseline);
+  invalid.sanitized_snapshot->target.safe_title =
+      std::string(kMaxSupervisionSafeTitleBytes + 1, 'x');
+  auto unsanitized = SerializeSupervisionCompatibilityResult(invalid);
+  ASSERT_FALSE(unsanitized.has_value());
+  EXPECT_EQ(SupervisionTransportErrorCode::kOutputNotSanitized,
+            unsanitized.error().transport_error);
+}
