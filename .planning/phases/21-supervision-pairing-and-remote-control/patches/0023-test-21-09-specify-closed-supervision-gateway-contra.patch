+TEST(PrometheusAgentGatewayTest,
+     SupervisionContractAcceptsOnlyTheAuthenticatedClosedPostPath) {
+  ExpectRejected(ValidRequest("/v1/supervision"),
+                 PrometheusAgentRequestRejection::kNone);
+
+  auto remote_peer = ValidRequest("/v1/supervision");
+  remote_peer.peer = net::IPEndPoint(net::IPAddress(192, 0, 2, 1), 52123);
+  ExpectRejected(remote_peer,
+                 PrometheusAgentRequestRejection::kNonLoopbackPeer);
+
+  auto bad_host = ValidRequest("/v1/supervision");
+  bad_host.headers["host"] = "localhost:43210";
+  ExpectRejected(bad_host, PrometheusAgentRequestRejection::kInvalidHost);
+
+  auto origin = ValidRequest("/v1/supervision");
+  origin.headers["origin"] = "https://dashboard.example";
+  ExpectRejected(origin, PrometheusAgentRequestRejection::kOriginForbidden);
+
+  auto missing_bearer = ValidRequest("/v1/supervision");
+  missing_bearer.headers.erase("authorization");
+  ExpectRejected(missing_bearer,
+                 PrometheusAgentRequestRejection::kUnauthorized);
+}
+
+TEST(PrometheusAgentGatewayTest,
+     SupervisionContractRejectsUpgradeMethodMediaSizeAndInflightBeforeDispatch) {
+  int dispatch_calls = 0;
+  auto expect_rejected_without_dispatch =
+      [&dispatch_calls](const net::HttpServerRequestInfo& request,
+                        PrometheusAgentRequestRejection rejection,
+                        size_t in_flight = 0) {
+        ExpectRejected(request, rejection, in_flight);
+        EXPECT_EQ(0, dispatch_calls);
+      };
+
+  auto websocket = ValidRequest("/v1/supervision");
+  websocket.headers["upgrade"] = "websocket";
+  expect_rejected_without_dispatch(
+      websocket, PrometheusAgentRequestRejection::kMethodNotAllowed);
+
+  auto wrong_method = ValidRequest("/v1/supervision");
+  wrong_method.method = "GET";
+  expect_rejected_without_dispatch(
+      wrong_method, PrometheusAgentRequestRejection::kMethodNotAllowed);
+
+  auto wrong_media = ValidRequest("/v1/supervision");
+  wrong_media.headers["content-type"] = "text/plain";
+  expect_rejected_without_dispatch(
+      wrong_media, PrometheusAgentRequestRejection::kUnsupportedMediaType);
+
+  auto oversized = ValidRequest("/v1/supervision");
+  oversized.data.assign(1'048'577, 'x');
+  expect_rejected_without_dispatch(
+      oversized, PrometheusAgentRequestRejection::kRequestTooLarge);
+
+  expect_rejected_without_dispatch(
+      ValidRequest("/v1/supervision"),
+      PrometheusAgentRequestRejection::kTooManyRequests, 16);
+}
+
 TEST(PrometheusAgentGatewayTest,
      RejectsMethodContentTypeBodyAndConcurrencyViolations) {
