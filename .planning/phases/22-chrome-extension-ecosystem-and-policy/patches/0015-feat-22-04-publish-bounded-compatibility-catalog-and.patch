+// Observation-only: this is not one of the five required MV3 acceptance
+// categories and must never be counted or rendered as a sixth compatibility
+// row (see PrometheusExtensionCompatibilityCatalogTest and
+// verify-phase-22-extension-fixtures.sh). It loads a minimal, non-component,
+// developer-mode Manifest V2 extension through the ordinary
+// `extensions::UnpackedInstaller` path -- the same native path
+// `chrome://extensions` Load unpacked uses -- with no test-only MV2
+// allowance helper, install-verification bypass, or hand-authored expected
+// outcome. Whatever the pinned Chromium revision's unmodified MV2
+// deprecation policy actually does (accept, or install-then-disable) is
+// recorded as closed gtest properties for
+// verify-phase-22-extension-fixtures.sh to turn into
+// `22-MV2-OBSERVATION.json`. The test intentionally exits 0 either way.
+IN_PROC_BROWSER_TEST_F(PrometheusExtensionFixturesBrowserTest,
+                       ManifestV2PinnedPolicyObservation) {
+  extensions::TestExtensionDir fixture;
+  CopyFixture(&fixture, "mv2_observation", {"manifest.json", "background.js"});
+
+  scoped_refptr<extensions::UnpackedInstaller> installer =
+      extensions::UnpackedInstaller::Create(browser()->profile());
+  base::RunLoop run_loop;
+  scoped_refptr<const extensions::Extension> loaded_extension;
+  std::u16string load_error;
+  installer->set_completion_callback(base::BindLambdaForTesting(
+      [&](const extensions::Extension* extension, const base::FilePath&,
+          const std::u16string& error) {
+        if (extension) {
+          loaded_extension = extension;
+        }
+        load_error = error;
+        run_loop.Quit();
+      }));
+  installer->Load(fixture.UnpackedPath());
+  run_loop.Run();
+
+  std::string result;
+  std::string reason;
+
+  if (!loaded_extension) {
+    result = "rejected";
+    reason = "unpacked_load_failed";
+  } else {
+    EXPECT_EQ(2, loaded_extension->manifest_version());
+    extensions::ExtensionRegistry* const registry =
+        extensions::ExtensionRegistry::Get(browser()->profile());
+    ASSERT_TRUE(registry);
+    const std::string extension_id = loaded_extension->id();
+    if (registry->enabled_extensions().Contains(extension_id)) {
+      result = "accepted";
+      reason = "manifest_v2_loaded_enabled";
+    } else if (registry->disabled_extensions().Contains(extension_id)) {
+      result = "rejected";
+      extensions::ExtensionPrefs* const prefs =
+          extensions::ExtensionPrefs::Get(browser()->profile());
+      reason = (prefs &&
+               prefs->HasDisableReason(
+                   extension_id,
+                   extensions::disable_reason::
+                       DISABLE_UNSUPPORTED_MANIFEST_VERSION))
+                   ? "manifest_v2_disabled_unsupported"
+                   : "manifest_v2_disabled_other";
+    } else {
+      result = "rejected";
+      reason = "manifest_v2_installed_untracked";
+    }
+  }
+
+  // Closed two-value result and one bounded stable reason code. Recorded two
+  // ways: as gtest properties (for a full test-launcher aggregation that
+  // preserves them), and -- because this fixture's out-of-process browser
+  // test child does not reliably surface RecordProperty() through
+  // --test-launcher-summary-output in this synthesized-binary harness --
+  // written directly to the exact path verify-phase-22-extension-fixtures.sh
+  // passes via --prometheus-mv2-observation-output, which it then turns into
+  // 22-MV2-OBSERVATION.json. Never asserted against a hand-authored expected
+  // value: this test must pass whichever way the pinned, unmodified policy
+  // actually resolves.
+  RecordProperty("mv2_observation_result", result);
+  RecordProperty("mv2_observation_reason", reason);
+  RecordProperty("mv2_observation_manifest_version", "2");
+
+  const base::FilePath output_path =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+          "prometheus-mv2-observation-output");
+  if (!output_path.empty()) {
+    const std::string json = base::StrCat(
+        {"{\"mv2_observation_result\":\"", result,
+         "\",\"mv2_observation_reason\":\"", reason,
+         "\",\"mv2_observation_manifest_version\":\"2\"}\n"});
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    EXPECT_TRUE(base::WriteFile(output_path, json))
+        << "failed to write MV2 observation output to "
+        << output_path.AsUTF8Unsafe();
+  }
+
+  EXPECT_TRUE(result == "accepted" || result == "rejected")
+      << "unexpected observation result: " << result;
+}
