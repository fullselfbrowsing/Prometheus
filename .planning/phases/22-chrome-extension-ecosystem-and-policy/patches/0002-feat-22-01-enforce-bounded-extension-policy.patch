 ExtensionPolicySnapshot PrometheusExtensionPolicyService::GetSnapshot() const {
   ExtensionPolicySnapshot snapshot;
   snapshot.generation = generation_;
+  if (shutdown_ || !prefs_) {
+    return snapshot;
+  }
+
+  const bool system_ready = IsSystemReady();
+  const ExtensionPolicyChoices choices =
+      ReadPrometheusExtensionPolicyChoices(*prefs_);
+  std::vector<ExtensionPolicyInventoryEntry> inventory = BuildInventory();
+  if (inventory.size() > kMaxExtensionPolicySnapshotRows) {
+    inventory.resize(kMaxExtensionPolicySnapshotRows);
+  }
+
+  snapshot.rows.reserve(inventory.size());
+  for (const ExtensionPolicyInventoryEntry& entry : inventory) {
+    const auto choice_it = choices.find(entry.extension_id);
+    const ExtensionPolicyChoice choice = choice_it == choices.end()
+                                             ? ExtensionPolicyChoice()
+                                             : choice_it->second;
+    const bool active = system_ready && entry.enabled && entry.ready &&
+                        entry.browser_context == regular_context_;
+
+    ExtensionPolicyRow row;
+    row.name = SanitizeExtensionPolicyName(entry.name);
+    row.id_suffix = ExtensionPolicyIdSuffix(entry.extension_id);
+    row.source = entry.source;
+    row.enabled = entry.enabled;
+    row.manifest_version = std::max(0, entry.manifest_version);
+    row.native_private_eligible = entry.native_private_eligible;
+    row.requested_regular = choice.regular;
+    row.requested_private =
+        ClampPrivateExtensionGrant(choice.regular, choice.private_mode);
+    row.effective_regular =
+        active ? choice.regular : ExtensionAgentGrant::kBlocked;
+    row.effective_private =
+        active && entry.native_private_eligible
+            ? ClampPrivateExtensionGrant(choice.regular, choice.private_mode)
+            : ExtensionAgentGrant::kBlocked;
+    row.ordinal = snapshot.rows.size();
+    row.generation = snapshot.generation;
+    snapshot.rows.push_back(std::move(row));
+  }
   return snapshot;
 }
 
