+void PrometheusAgentGateway::SetSupervisionTestHandoffDispatcher(
+    SupervisionTestHandoffDispatcher dispatcher) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  ShutdownSupervisionTestHandoffDispatcher();
+  if (dispatcher.IsComplete()) {
+    supervision_test_handoff_dispatcher_ = std::move(dispatcher);
+    supervision_test_handoff_enabled_.store(true);
+  }
+}
+
+void PrometheusAgentGateway::ShutdownSupervisionTestHandoffDispatcher() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  supervision_test_handoff_enabled_.store(false);
+  if (supervision_test_handoff_dispatcher_) {
+    supervision_test_handoff_dispatcher_->shutdown.Run();
+    supervision_test_handoff_dispatcher_.reset();
+  }
+}
