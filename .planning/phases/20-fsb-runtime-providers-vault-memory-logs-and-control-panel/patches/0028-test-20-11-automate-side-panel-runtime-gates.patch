@@ -515,7 +515,14 @@ textarea {
   background: var(--prometheus-color-accent);
   display: block;
   height: 100%;
-  width: 48%;
+  width: 0;
+}
+
+.runtime-task[data-task-state="running"] .runtime-progress span,
+.runtime-task[data-task-state="cancelling"] .runtime-progress span {
+  animation: runtime-indeterminate 1.4s ease-in-out infinite;
+  transform: translateX(-120%);
