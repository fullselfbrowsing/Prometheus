+bool PrometheusTabState::Supervision::HasActiveAction() const {
+  switch (activity_state) {
+    case ActivityState::kValidating:
+    case ActivityState::kExecuting:
+    case ActivityState::kAwaitingConfirmation:
+    case ActivityState::kVerifying:
+      return true;
+    case ActivityState::kNone:
+    case ActivityState::kCompleted:
+    case ActivityState::kBlocked:
+    case ActivityState::kFailed:
+      return false;
+  }
+}
