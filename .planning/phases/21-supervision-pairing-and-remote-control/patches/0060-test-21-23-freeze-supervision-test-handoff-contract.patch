+TEST_F(PrometheusSupervisionTestBootstrapTest,
+       HandoffDeliversExactlyTwoOrderedSlotsAfterRedemption) {
+  ASSERT_EQ(Create(MakeLaunch(base::FilePath(kConfigPath))),
+            PrometheusSupervisionTestBootstrapResult::kApplied);
+  ASSERT_TRUE(bootstrap_);
+
+  HandoffResponse early = Dispatch(kChallenge, "owner-session", 2);
+  ASSERT_EQ(1u, early.callbacks);
+  EXPECT_EQ(SupervisionTestHandoffStatus::kOutOfOrder, early.result->status);
+  EXPECT_TRUE(early.result->pairing_code.empty());
+
+  HandoffResponse first = Dispatch(kChallenge, "owner-session", 1);
+  ASSERT_EQ(1u, first.callbacks);
+  EXPECT_EQ(SupervisionTestHandoffStatus::kDelivered, first.result->status);
+  EXPECT_EQ("ABCD-EFGH", first.result->pairing_code);
+  EXPECT_EQ(1, create_code_calls_);
+
+  HandoffResponse replay = Dispatch(kChallenge, "owner-session", 1);
+  EXPECT_NE(SupervisionTestHandoffStatus::kDelivered, replay.result->status);
+  EXPECT_TRUE(replay.result->pairing_code.empty());
+  HandoffResponse before_redemption = Dispatch(kChallenge, "owner-session", 2);
+  EXPECT_EQ(SupervisionTestHandoffStatus::kNotReady,
+            before_redemption.result->status);
+
+  EXPECT_TRUE(bootstrap_->ObservePairingRedeemed(1));
+  HandoffResponse second = Dispatch(kChallenge, "owner-session", 2);
+  EXPECT_EQ(SupervisionTestHandoffStatus::kDelivered, second.result->status);
+  EXPECT_EQ("JKLM-NPQR", second.result->pairing_code);
+  EXPECT_EQ(2, create_code_calls_);
+  EXPECT_FALSE(bootstrap_->ObservePairingRedeemed(1));
+  EXPECT_TRUE(bootstrap_->ObservePairingRedeemed(2));
+  EXPECT_TRUE(bootstrap_->is_terminal_for_testing());
+}
