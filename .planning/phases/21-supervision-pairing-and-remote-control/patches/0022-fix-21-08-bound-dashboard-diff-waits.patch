+SupervisionDashboardDiffWaitRegistration
+PrometheusSupervisionProfileService::BeginDashboardDiffWait(
+    const base::UnguessableToken& dashboard_session,
+    DashboardDiffWaitCallback callback) {
+  SupervisionDashboardDiffWaitRegistration result;
+  if (shutdown_) {
+    static_cast<SupervisionServiceResult&>(result) = UnavailableResult();
+    return result;
+  }
+  if (!callback) {
+    static_cast<SupervisionServiceResult&>(result) =
+        ServiceFailure(SupervisionErrorCode::kRestrictedTarget,
+                       "A dashboard diff completion callback is required",
+                       "Provide one bounded completion callback");
+    return result;
+  }
+  SweepExpired();
+  if (!viewers_.contains(dashboard_session)) {
+    static_cast<SupervisionServiceResult&>(result) = UnknownSessionResult();
+    return result;
+  }
+  if (!RevalidateViewerOwner(dashboard_session)) {
+    static_cast<SupervisionServiceResult&>(result) =
+        ServiceFailure(SupervisionErrorCode::kUnknownSession,
+                       "The dashboard session no longer has target authority",
+                       "Create and redeem a new pairing");
+    return result;
+  }
+
+  auto viewer = viewers_.find(dashboard_session);
+  CaptureHubEntry* capture_hub = FindCaptureHub(*viewer->second);
+  if (!capture_hub || !viewer->second->capture_consumer_token.has_value()) {
+    static_cast<SupervisionServiceResult&>(result) =
+        ServiceFailure(SupervisionErrorCode::kStaleTarget,
+                       "The dashboard capture target is unavailable",
+                       "Create and redeem a new pairing");
+    return result;
+  }
+  if (viewer->second->diff_wait_token.has_value()) {
+    static_cast<SupervisionServiceResult&>(result) = ServiceFailure(
+        SupervisionErrorCode::kTooLarge,
+        "A dashboard diff wait is already active",
+        "Cancel or complete the current wait before waiting again");
+    return result;
+  }
+  const CaptureConsumerToken consumer_token =
+      *viewer->second->capture_consumer_token;
+  if (capture_hub->hub->ConsumerNeedsBaseline(consumer_token)) {
+    viewer->second->stream_state = SupervisionStreamState::kResyncing;
+    static_cast<SupervisionServiceResult&>(result) = ServiceFailure(
+        SupervisionErrorCode::kResyncRequired,
+        "A fresh dashboard baseline is required",
+        "Read and acknowledge the current baseline before waiting");
+    return result;
+  }
+
+  result.wait_token = base::UnguessableToken::Create();
+  viewer->second->diff_wait_token = result.wait_token;
+  viewer->second->diff_wait_callback = std::move(callback);
+  const bool registered = capture_hub->hub->WaitForNextDiff(
+      consumer_token,
+      base::BindOnce(
+          &PrometheusSupervisionProfileService::OnDashboardDiffWaitReady,
+          weak_factory_.GetWeakPtr(), dashboard_session, result.wait_token));
+  if (!registered) {
+    viewer = viewers_.find(dashboard_session);
+    if (viewer != viewers_.end() &&
+        viewer->second->diff_wait_token == result.wait_token) {
+      viewer->second->diff_wait_token.reset();
+      viewer->second->diff_wait_callback.Reset();
+    }
+    static_cast<SupervisionServiceResult&>(result) =
+        ServiceFailure(SupervisionErrorCode::kTooLarge,
+                       "The dashboard diff wait could not be registered",
+                       "Retry after the current wait completes");
+    result.wait_token = base::UnguessableToken();
+    return result;
+  }
+  static_cast<SupervisionServiceResult&>(result) =
+      SupervisionServiceResult::Success();
+  return result;
+}
+
+SupervisionServiceResult
+PrometheusSupervisionProfileService::CancelDashboardDiffWait(
+    const base::UnguessableToken& dashboard_session,
+    const base::UnguessableToken& wait_token) {
+  if (shutdown_) {
+    return UnavailableResult();
+  }
+  auto viewer = viewers_.find(dashboard_session);
+  if (viewer == viewers_.end() || !wait_token ||
+      viewer->second->diff_wait_token != wait_token) {
+    return UnknownSessionResult();
+  }
+  CaptureHubEntry* capture_hub = FindCaptureHub(*viewer->second);
+  if (capture_hub && viewer->second->capture_consumer_token.has_value()) {
+    capture_hub->hub->CancelDiffWait(*viewer->second->capture_consumer_token);
+  }
+  viewer->second->diff_wait_token.reset();
+  viewer->second->diff_wait_callback.Reset();
+  return SupervisionServiceResult::Success();
+}
+
+void PrometheusSupervisionProfileService::OnDashboardDiffWaitReady(
+    const base::UnguessableToken& dashboard_session,
+    const base::UnguessableToken& wait_token,
+    SupervisionCaptureWaitReason reason) {
+  auto viewer = viewers_.find(dashboard_session);
+  if (viewer == viewers_.end() ||
+      viewer->second->diff_wait_token != wait_token ||
+      !viewer->second->diff_wait_callback) {
+    return;
+  }
+  DashboardDiffWaitCallback callback =
+      std::move(viewer->second->diff_wait_callback);
+  viewer->second->diff_wait_token.reset();
+
+  SupervisionDashboardDiffResult result;
+  if (reason == SupervisionCaptureWaitReason::kDataAvailable) {
+    result = ReadDashboardDiff(dashboard_session);
+  } else if (reason == SupervisionCaptureWaitReason::kBaselineRequired) {
+    viewer->second->stream_state = SupervisionStreamState::kResyncing;
+    static_cast<SupervisionServiceResult&>(result) =
+        ServiceFailure(SupervisionErrorCode::kResyncRequired,
+                       "A fresh dashboard baseline is required",
+                       "Read and acknowledge the current baseline");
+  } else {
+    const bool expired = viewer->second->expires_at <= Now();
+    const int32_t stable_tab_id = viewer->second->stable_tab_id;
+    static_cast<SupervisionServiceResult&>(result) = ServiceFailure(
+        SupervisionErrorCode::kUnknownSession,
+        "The dashboard diff wait has ended",
+        "Create and redeem a new pairing if supervision is still needed");
+    if (expired) {
+      TerminateViewer(dashboard_session, SupervisionViewerState::kExpired,
+                      SupervisionTerminalReason::kExpired,
+                      SupervisionAuditEvent::kAccessExpired,
+                      SupervisionErrorCode::kNone);
+    } else {
+      HandleTargetLost(stable_tab_id);
+    }
+  }
+  std::move(callback).Run(std::move(result));
+}
