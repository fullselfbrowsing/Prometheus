+  // TODO(phase-14-03): mixer[kColorPrometheusTabIdle] = {...};
+  // TODO(phase-14-03): mixer[kColorPrometheusTabHover] = {...};
+  // TODO(phase-14-03): mixer[kColorPrometheusText] = {...};
+  // TODO(phase-14-03): mixer[kColorPrometheusText2] = {...};
+  // TODO(phase-14-03): mixer[kColorPrometheusText3] = {...};
+  // TODO(phase-14-03): mixer[kColorPrometheusBorder] = {...};
