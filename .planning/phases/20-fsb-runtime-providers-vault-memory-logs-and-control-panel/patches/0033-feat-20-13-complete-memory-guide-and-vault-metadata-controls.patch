+
+PrometheusVaultMetadataResult
+PrometheusRuntimeProfileService::SaveVaultMetadataForControlUi(
+    RuntimeCallerOrigin caller,
+    std::string entry_id,
+    std::string label,
+    PrometheusVaultKind kind,
+    std::string canonical_site_origin) {
+  if (caller != RuntimeCallerOrigin::kLocalControlUi ||
+      !IsVaultAvailableForTransport()) {
+    return {.status = PrometheusVaultStatus::kDenied};
+  }
+  PrometheusVaultMetadataResult result;
+  if (entry_id.empty()) {
+    result = owned_vault_service_->CreateMetadata(
+        std::move(label), kind, std::move(canonical_site_origin));
+  } else {
+    PrometheusVaultMetadataResult existing =
+        owned_vault_service_->GetMetadata(entry_id);
+    if (!existing.ok() || !existing.metadata ||
+        existing.metadata->kind != kind) {
+      return existing.ok()
+                 ? PrometheusVaultMetadataResult{.status =
+                                                     PrometheusVaultStatus::
+                                                         kInvalidArgument}
+                 : existing;
+    }
+    result = owned_vault_service_->UpdateMetadata(
+        entry_id, std::move(label), std::move(canonical_site_origin));
+  }
+  if (result.ok()) {
+    for (Observer& observer : observers_) {
+      observer.OnRuntimeSidePanelSnapshotChanged();
+    }
+  }
+  return result;
+}
