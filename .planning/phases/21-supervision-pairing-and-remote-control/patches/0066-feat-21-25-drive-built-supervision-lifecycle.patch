+TEST_F(PrometheusSupervisionActionControllerTest,
+       SuccessfulRouteMayAdvanceCaptureBeforeCompletion) {
+  hold_dispatch_ = true;
+  auto controller = MakeController();
+  std::vector<SupervisionActionResult> results;
+  controller->ExecuteAction(
+      dashboard_session_, document_epoch_.ToString(), sequence_,
+      Action(SupervisionRemoteActionCategory::kClick),
+      base::BindLambdaForTesting([&](SupervisionActionResult result) {
+        results.push_back(std::move(result));
+      }));
+  ASSERT_EQ(1u, pending_agent_callbacks_.size());
+  authority_.sequence = sequence_ + 1;
+  authority_.stream_live = false;
+  std::move(pending_agent_callbacks_[0])
+      .Run(AgentRouteResult::Success({"changed"}));
+  ASSERT_EQ(1u, results.size());
+  EXPECT_TRUE(results[0].ok);
+  EXPECT_EQ(SupervisionErrorCode::kNone, results[0].error_code);
+}
