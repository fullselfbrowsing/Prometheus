+    case ActionCategory::kHover:
+      return u"Hover";
+    case ActionCategory::kSelect:
+      return u"Select";
+    case ActionCategory::kClear:
+      return u"Clear";
+    case ActionCategory::kDrag:
+      return u"Drag";
+    case ActionCategory::kDrop:
+      return u"Drop";
+    case ActionCategory::kNavigate:
+      return u"Navigate";
+  }
 }
 
