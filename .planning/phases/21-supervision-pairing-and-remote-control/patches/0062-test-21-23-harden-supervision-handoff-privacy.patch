+bool ContainsStringRecursively(const base::Value& value,
+                               std::string_view sentinel) {
+  if (value.is_string()) {
+    return value.GetString().find(sentinel) != std::string::npos;
+  }
+  if (value.is_list()) {
+    return std::ranges::any_of(
+        value.GetList(), [sentinel](const base::Value& child) {
+          return ContainsStringRecursively(child, sentinel);
+        });
+  }
+  if (value.is_dict()) {
+    for (const auto [key, child] : value.GetDict()) {
+      if (key.find(sentinel) != std::string_view::npos ||
+          ContainsStringRecursively(child, sentinel)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+size_t CountOccurrences(std::string_view text, std::string_view needle) {
+  size_t count = 0;
+  for (size_t position = text.find(needle); position != std::string_view::npos;
+       position = text.find(needle, position + needle.size())) {
+    ++count;
+  }
+  return count;
+}
+
+std::optional<std::string> ReadPrometheusSource(std::string_view file_name) {
+  base::FilePath source_root;
+  if (!base::PathService::Get(base::DIR_SRC_TEST_DATA_ROOT, &source_root)) {
+    return std::nullopt;
+  }
+  std::string contents;
+  if (!base::ReadFileToString(source_root.AppendASCII("chrome")
+                                  .AppendASCII("browser")
+                                  .AppendASCII("prometheus")
+                                  .AppendASCII(file_name),
+                              &contents)) {
+    return std::nullopt;
+  }
+  return contents;
+}
