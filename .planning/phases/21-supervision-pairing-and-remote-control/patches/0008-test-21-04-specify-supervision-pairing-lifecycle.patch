+  SupervisionPairingCreationResult creation = CreatePairing();
+  ASSERT_TRUE(creation.ok);
+  SupervisionRedemptionResult viewer =
+      Redeem(creation, "Bearer SESSION-AUTHORITY selector=#SECRET-NODE");
+  ASSERT_TRUE(viewer.ok);
+  SanitizedSupervisionSnapshot snapshot =
+      service_->GetSanitizedSnapshot(creation.stable_tab_id);
+  std::optional<base::DictValue> value =
+      SanitizedSupervisionSnapshotToValue(snapshot);
+  ASSERT_TRUE(value.has_value());
+  const std::string json = base::WriteJson(*value).value_or("");
+  for (const std::string& forbidden :
+       std::vector<std::string>{
+           creation.pairing_code, viewer.dashboard_session.ToString(),
+           "SESSION-AUTHORITY", "SECRET-NODE", "profile_path",
+           "document_epoch", "controller_lease", "selector",
+           "page_content"}) {
+    EXPECT_EQ(std::string::npos, json.find(forbidden)) << forbidden;
+  }
+  EXPECT_LE(service_->audit_count_for_testing(), kDefaultSupervisionAuditRows);
+}
