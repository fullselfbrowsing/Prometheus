+void PrometheusSupervisionProfileService::NotifySnapshotChanged(
+    int32_t stable_tab_id) {
+  if (shutdown_) {
+    return;
+  }
+  const SanitizedSupervisionSnapshot snapshot =
+      BuildSanitizedSnapshot(stable_tab_id);
+  for (Observer& observer : observers_) {
+    observer.OnPrometheusSupervisionSnapshotChanged(stable_tab_id, snapshot);
+  }
+}
