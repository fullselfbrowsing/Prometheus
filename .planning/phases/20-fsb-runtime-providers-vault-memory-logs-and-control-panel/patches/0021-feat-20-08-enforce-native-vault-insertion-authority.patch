+          *frame.render_process_id ||
+      render_frame->GetRoutingID() != *frame.render_frame_routing_id) {
+    return std::nullopt;
+  }
+  std::optional<std::string> live_document =
+      optimization_guide::DocumentIdentifierUserData::GetDocumentIdentifier(
+          render_frame->GetGlobalFrameToken());
+  if (!live_document.has_value() || *live_document != *frame.document_token) {
+    return std::nullopt;
+  }
+
+  const url::Origin origin = render_frame->GetLastCommittedOrigin();
+  if (origin.opaque() || !origin.GetURL().SchemeIsHTTPOrHTTPS()) {
+    return std::nullopt;
