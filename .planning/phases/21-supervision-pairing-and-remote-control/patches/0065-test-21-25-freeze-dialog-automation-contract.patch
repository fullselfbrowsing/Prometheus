   return g_dialog_launch_count;
 }
diff --git a/chrome/browser/ui/views/prometheus/prometheus_runtime_dialogs.h b/chrome/browser/ui/views/prometheus/prometheus_runtime_dialogs.h
index ee411b789a..e4f470cc19 100644
--- a/chrome/browser/ui/views/prometheus/prometheus_runtime_dialogs.h
+++ b/chrome/browser/ui/views/prometheus/prometheus_runtime_dialogs.h
@@ -41,6 +41,19 @@ enum class PrometheusSupervisionDialogResult {
   kDenied,
 };
 
+enum class PrometheusSupervisionDialogAutomationResponse {
+  kNoResponse,
+  kAccept,
+  kCancel,
+};
+
+// Non-production test automation is intentionally narrower than the dialog
+// model. It receives only the exact Browser and closed supervision dialog kind.
+using PrometheusSupervisionDialogAutomation = base::RepeatingCallback<
+    PrometheusSupervisionDialogAutomationResponse(
+        BrowserWindowInterface*,
+        PrometheusSupervisionDialogKind)>;
+
 // Display-only values. Browser, profile, tab, owner, session, document,
 // controller, and action-payload authority stays in the invoking backend.
 struct PrometheusSupervisionDialogModel {
@@ -93,6 +106,8 @@ bool ShowPrometheusSupervisionDialog(
     const PrometheusSupervisionDialogModel& model,
     PrometheusSupervisionDialogCallback reply_callback);
 
+void SetPrometheusSupervisionDialogAutomationForTesting(
+    PrometheusSupervisionDialogAutomation automation);
 size_t PrometheusRuntimeDialogLaunchCountForTesting();
 PrometheusRuntimeDialogKind PrometheusRuntimeDialogKindForTesting();
 BrowserWindowInterface* PrometheusRuntimeDialogBrowserForTesting();
