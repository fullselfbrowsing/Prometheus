+#ifndef CHROME_BROWSER_UI_VIEWS_TOOLBAR_PROMETHEUS_TOOLBAR_BUTTON_H_
+#define CHROME_BROWSER_UI_VIEWS_TOOLBAR_PROMETHEUS_TOOLBAR_BUTTON_H_
+
+#include <string>
+
+#include "chrome/browser/prometheus/prometheus_action.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_button.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/gfx/geometry/size.h"
+
+class PrometheusToolbarButton : public ToolbarButton {
+  METADATA_HEADER(PrometheusToolbarButton, ToolbarButton)
+
+ public:
+  static constexpr int kVisualSize = 32;
+
+  PrometheusToolbarButton(PrometheusAction action,
+                          const std::u16string& accessible_name,
+                          PressedCallback callback);
+  PrometheusToolbarButton(const PrometheusToolbarButton&) = delete;
+  PrometheusToolbarButton& operator=(const PrometheusToolbarButton&) = delete;
+  ~PrometheusToolbarButton() override;
+
+  void SetPrometheusActive(bool active);
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  gfx::Size GetMinimumSize() const override;
+  void OnThemeChanged() override;
+
+ private:
+  void UpdatePrometheusIcon();
+
+  const PrometheusAction action_;
+  bool active_ = false;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TOOLBAR_PROMETHEUS_TOOLBAR_BUTTON_H_
