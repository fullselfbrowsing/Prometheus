+// Shutdown() before any asynchronous stage callback fires must terminalize
+// the controller (never crash, never leave the global chooser factory
+// installed) and must be idempotent.
+IN_PROC_BROWSER_TEST_F(PrometheusExtensionSmokeControllerBrowserTest,
+                       EarlyShutdownTerminalizesWithoutCrashing) {
+  std::unique_ptr<PrometheusExtensionSmokeBootstrap> bootstrap =
+      CreateValidBootstrap();
+  ASSERT_TRUE(bootstrap);
+
+  std::unique_ptr<PrometheusExtensionSmokeController> controller =
+      PrometheusExtensionSmokeController::Create(std::move(bootstrap),
+                                                 browser()->profile(),
+                                                 browser());
+  ASSERT_TRUE(controller);
+
+  controller->Shutdown();
+  EXPECT_EQ(PrometheusExtensionSmokeOutcome::kFailed,
+           controller->outcome_for_testing());
+
+  // Idempotent: a second Shutdown() call must not crash or change the
+  // already-terminal outcome.
+  controller->Shutdown();
+  EXPECT_EQ(PrometheusExtensionSmokeOutcome::kFailed,
+           controller->outcome_for_testing());
+}
