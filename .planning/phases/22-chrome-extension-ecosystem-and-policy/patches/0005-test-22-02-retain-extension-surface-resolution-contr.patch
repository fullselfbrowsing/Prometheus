+TEST(PrometheusAgentTransportCodecTest,
+     ExtensionSurfaceSelectorsRequireExactStableTabAndRoundTrip) {
+  for (const auto& [name, selector] :
+       std::array<std::pair<std::string_view, AgentExtensionSurfaceSelector>, 2>{
+           {std::pair{"popup", AgentExtensionSurfaceSelector::kPopup},
+            std::pair{"side_panel",
+                      AgentExtensionSurfaceSelector::kSidePanel}}}) {
+    SCOPED_TRACE(name);
+    auto parsed = ParseAgentTransportRequest(
+        RequestJson("read_page",
+                    "{\"tab_id\":19,\"extension_surface\":\"" +
+                        std::string(name) + "\"}"));
+    ASSERT_TRUE(parsed.has_value()) << parsed.error().message;
+    EXPECT_EQ(19, parsed->target.tab_handle.raw_value());
+    EXPECT_EQ(selector, parsed->target.extension_surface);
+    EXPECT_FALSE(parsed->target.tab_index.has_value());
+
+    AgentRouteResult result = AgentRouteResult::Success({"read_complete"});
+    result.target = parsed->target;
+    auto root = SerializeRoot(result);
+    ASSERT_TRUE(root.has_value()) << root.error().message;
+    const base::DictValue* target = root->FindDict("target");
+    ASSERT_TRUE(target);
+    EXPECT_EQ(2u, target->size());
+    EXPECT_EQ(19, target->FindInt("tab_id"));
+    const std::string* serialized_surface =
+        target->FindString("extension_surface");
+    ASSERT_TRUE(serialized_surface);
+    EXPECT_EQ(name, *serialized_surface);
+    EXPECT_FALSE(target->contains("extension_id"));
+    EXPECT_FALSE(target->contains("url"));
+    EXPECT_FALSE(target->contains("renderer_id"));
+  }
+}
+
+TEST(PrometheusAgentTransportCodecTest,
+     ExtensionSurfaceSelectorsRejectMissingOrUnstableTabAnchors) {
+  for (std::string_view target : {
+           R"({"extension_surface":"popup"})",
+           R"({"tabIndex":0,"extension_surface":"popup"})",
+           R"({"tabId":7,"extension_surface":"side_panel"})",
+           R"({"tab_id":0,"extension_surface":"popup"})",
+           R"({"tab_id":-1,"extension_surface":"popup"})",
+       }) {
+    SCOPED_TRACE(target);
+    AgentRouteResult error = ParseError(RequestJson("read_page", target));
+    EXPECT_EQ(AgentErrorCode::kInvalidTarget, error.error_code);
+  }
+}
+
+TEST(PrometheusAgentTransportCodecTest,
+     ExtensionSurfaceSelectorsRejectUnknownWrongTypeAndAmbiguity) {
+  for (std::string_view target : {
+           R"({"tab_id":7,"extension_surface":"background"})",
+           R"({"tab_id":7,"extension_surface":true})",
+           R"({"tab_id":7,"extension_surface":1})",
+           R"({"tab_id":7,"extension_surface":null})",
+           R"({"tab_id":7,"extension_surface":["popup","side_panel"]})",
+       }) {
+    SCOPED_TRACE(target);
+    AgentRouteResult error = ParseError(RequestJson("read_page", target));
+    EXPECT_EQ(AgentErrorCode::kInvalidTarget, error.error_code);
+  }
+}
+
+TEST(PrometheusAgentTransportCodecTest,
+     ExtensionSurfaceSelectorsRejectDuplicateOrConflictingTabAliases) {
+  for (std::string_view target : {
+           R"({"tab_id":7,"tabId":7,"extension_surface":"popup"})",
+           R"({"tab_id":7,"tabId":8,"extension_surface":"popup"})",
+           R"({"tab_id":7,"tabIndex":0,"extension_surface":"side_panel"})",
+       }) {
+    SCOPED_TRACE(target);
+    AgentRouteResult error = ParseError(RequestJson("read_page", target));
+    EXPECT_EQ(AgentErrorCode::kInvalidTarget, error.error_code);
+  }
+}
+
+TEST(PrometheusAgentTransportCodecTest,
+     ExtensionSurfaceSelectorsRejectCallerSuppliedIdentity) {
+  for (std::string_view identity : {
+           R"("extension_id":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")",
+           R"("url":"chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/popup.html")",
+           R"("frame_id":4)",
+           R"("renderer_id":5)",
+           R"("ordinal":0)",
+           R"("web_contents":1)",
+       }) {
+    SCOPED_TRACE(identity);
+    const std::string target =
+        "{\"tab_id\":7,\"extension_surface\":\"popup\"," +
+        std::string(identity) + "}";
+    AgentRouteResult error = ParseError(RequestJson("read_page", target));
+    EXPECT_EQ(AgentErrorCode::kInvalidRequest, error.error_code);
+  }
+}
