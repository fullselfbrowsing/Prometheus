+void PrometheusExtensionSmokeController::OpenManagerTab() {
+  NavigateParams params(profile_.get(), GURL(chrome::kChromeUIExtensionsURL),
+                        ui::PAGE_TRANSITION_TYPED);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  params.browser = browser_.get();
+  Navigate(&params);
+  content::WebContents* contents = params.navigated_or_inserted_contents;
+  if (!contents) {
+    Fail(PrometheusExtensionSmokeStage::kNotStarted, "manager_tab_open_failed");
+    return;
+  }
+  manager_web_contents_ = contents->GetWeakPtr();
+  expected_chooser_window_ = browser_->window()->GetNativeWindow();
+  manager_watcher_ = std::make_unique<TabLoadWatcher>(
+      contents,
+      base::BindOnce(&PrometheusExtensionSmokeController::OnManagerTabWatcherFired,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void PrometheusExtensionSmokeController::OnManagerTabWatcherFired() {
+  manager_watcher_.reset();
+  if (!ManagerWebContents()) {
+    Fail(PrometheusExtensionSmokeStage::kNotStarted, "manager_tab_lost");
+    return;
+  }
+  stage_ = PrometheusExtensionSmokeStage::kManagerLoaded;
+  PollManagerReady(base::TimeTicks::Now() + kManagerReadyTimeout);
+}
+
+void PrometheusExtensionSmokeController::PollManagerReady(
+    base::TimeTicks deadline) {
+  ExecuteInManager(
+      ManagerReadyProbeScript(),
+      base::BindOnce(&PrometheusExtensionSmokeController::OnManagerReadyPolled,
+                     weak_ptr_factory_.GetWeakPtr(), deadline));
+}
+
+void PrometheusExtensionSmokeController::OnManagerReadyPolled(
+    base::TimeTicks deadline,
+    base::Value result) {
+  if (stage_ != PrometheusExtensionSmokeStage::kManagerLoaded) {
+    return;
+  }
+  if (result.is_bool() && result.GetBool()) {
+    ClickDeveloperModeToggle();
+    return;
+  }
+  if (base::TimeTicks::Now() >= deadline) {
+    Fail(stage_, "manager_not_ready_timeout");
+    return;
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&PrometheusExtensionSmokeController::PollManagerReady,
+                     weak_ptr_factory_.GetWeakPtr(), deadline),
+      kPollInterval);
+}
+
+void PrometheusExtensionSmokeController::ClickDeveloperModeToggle() {
+  const base::TimeTicks deadline =
+      base::TimeTicks::Now() + kDeveloperModeReadyTimeout;
+  ExecuteInManager(
+      DevModeToggleClickScript(),
+      base::BindOnce(
+          [](base::WeakPtr<PrometheusExtensionSmokeController> self,
+             base::TimeTicks poll_deadline, base::Value result) {
+            if (!self) {
+              return;
+            }
+            const std::string status = ResultValueOrEmpty(result);
+            if (status != "clicked" && status != "already_checked") {
+              self->Fail(self->stage_, "dev_mode_click_failed:" + status);
+              return;
+            }
+            self->PollDeveloperModeReady(poll_deadline);
+          },
+          weak_ptr_factory_.GetWeakPtr(), deadline));
+}
+
+void PrometheusExtensionSmokeController::PollDeveloperModeReady(
+    base::TimeTicks deadline) {
+  ExecuteInManager(
+      DevModeReadyProbeScript(),
+      base::BindOnce(
+          &PrometheusExtensionSmokeController::OnDeveloperModeReadyPolled,
+          weak_ptr_factory_.GetWeakPtr(), deadline));
+}
+
+void PrometheusExtensionSmokeController::OnDeveloperModeReadyPolled(
+    base::TimeTicks deadline,
+    base::Value result) {
+  if (stage_ != PrometheusExtensionSmokeStage::kManagerLoaded) {
+    return;
+  }
+  if (result.is_bool() && result.GetBool()) {
+    stage_ = PrometheusExtensionSmokeStage::kDeveloperModeEnabled;
+    ClickLoadUnpacked();
+    return;
+  }
+  if (base::TimeTicks::Now() >= deadline) {
+    Fail(stage_, "developer_mode_not_ready_timeout");
+    return;
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&PrometheusExtensionSmokeController::PollDeveloperModeReady,
+                     weak_ptr_factory_.GetWeakPtr(), deadline),
+      kPollInterval);
+}
+
+void PrometheusExtensionSmokeController::ClickLoadUnpacked() {
+  expected_chooser_title_ =
+      l10n_util::GetStringUTF16(IDS_EXTENSION_LOAD_FROM_DIRECTORY);
+  expected_chooser_caller_ = GURL(chrome::kChromeUIExtensionsURL);
+  ui::SelectFileDialog::SetFactory(
+      std::make_unique<OneShotChooserFactory>(weak_ptr_factory_.GetWeakPtr()));
+  ExecuteInManager(
+      LoadUnpackedClickScript(),
+      base::BindOnce(&PrometheusExtensionSmokeController::OnLoadUnpackedClickIssued,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void PrometheusExtensionSmokeController::OnChooserInvoked() {
+  // The one-shot factory already removed itself from
+  // OneShotChooserFactory::Create(); nothing further to arm here. This hook
+  // exists so future stages can distinguish "the expected chooser matched
+  // and delivered" from "the chooser never fired" without inspecting
+  // factory-internal state directly.
+}
+
+void PrometheusExtensionSmokeController::OnLoadUnpackedClickIssued(
+    base::Value result) {
+  if (stage_ != PrometheusExtensionSmokeStage::kDeveloperModeEnabled) {
+    return;
+  }
+  const std::string status = ResultValueOrEmpty(result);
+  if (status != "clicked") {
+    ui::SelectFileDialog::SetFactory(nullptr);
+    Fail(stage_, "load_unpacked_click_failed:" + status);
+    return;
+  }
+  stage_ = PrometheusExtensionSmokeStage::kLoadUnpackedClicked;
+  pending_transition_ = PrometheusExtensionSmokePendingTransition::kInstall;
+  ArmPendingTransitionTimeout(kInstallObservedTimeout,
+                             "install_not_observed_timeout");
+}
+
+void PrometheusExtensionSmokeController::ArmPendingTransitionTimeout(
+    base::TimeDelta timeout,
+    std::string reason) {
+  ++pending_wait_generation_;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          &PrometheusExtensionSmokeController::OnPendingTransitionTimedOut,
+          weak_ptr_factory_.GetWeakPtr(), pending_wait_generation_,
+          std::move(reason)),
+      timeout);
+}
+
+void PrometheusExtensionSmokeController::OnPendingTransitionTimedOut(
+    int generation,
+    std::string reason) {
+  if (generation != pending_wait_generation_ ||
+      pending_transition_ == PrometheusExtensionSmokePendingTransition::kNone) {
+    return;
+  }
+  Fail(stage_, reason);
+}
+
+void PrometheusExtensionSmokeController::OnExtensionInstalledObserved(
+    const std::string& extension_id) {
+  if (stage_ != PrometheusExtensionSmokeStage::kLoadUnpackedClicked) {
+    return;
+  }
+  pending_transition_ = PrometheusExtensionSmokePendingTransition::kNone;
+  ++pending_wait_generation_;
+  extension_id_ = extension_id;
+  stage_ = PrometheusExtensionSmokeStage::kExtensionInstalled;
+  AttemptInspect();
+}
+
+void PrometheusExtensionSmokeController::AttemptInspect() {
+  if (!IsWellFormedExtensionId(extension_id_)) {
+    Fail(stage_, "invalid_extension_id");
+    return;
+  }
+  ExecuteInManager(
+      InspectProbeScript(extension_id_),
+      base::BindOnce(&PrometheusExtensionSmokeController::OnInspectAttempted,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void PrometheusExtensionSmokeController::OnInspectAttempted(
+    base::Value result) {
+  if (stage_ != PrometheusExtensionSmokeStage::kExtensionInstalled) {
+    return;
+  }
+  // Best-effort: whether or not the fixture's service worker currently has
+  // an inspectable view is a legitimate real state either way, so this step
+  // never fails the smoke by itself.
+  inspected_ = true;
+  stage_ = PrometheusExtensionSmokeStage::kInspected;
+  ClickReload();
+}
+
+void PrometheusExtensionSmokeController::ClickReload() {
+  if (!IsWellFormedExtensionId(extension_id_)) {
+    Fail(stage_, "invalid_extension_id");
+    return;
+  }
+  pending_transition_ = PrometheusExtensionSmokePendingTransition::kReload;
+  awaiting_reload_reload_ = false;
+  ExecuteInManager(
+      ReloadClickScript(extension_id_),
+      base::BindOnce(&PrometheusExtensionSmokeController::OnReloadClickIssued,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void PrometheusExtensionSmokeController::OnReloadClickIssued(
+    base::Value result) {
+  if (pending_transition_ != PrometheusExtensionSmokePendingTransition::kReload) {
+    return;
+  }
+  const std::string status = ResultValueOrEmpty(result);
+  if (status != "clicked") {
+    Fail(stage_, "reload_click_failed:" + status);
+    return;
+  }
+  ArmPendingTransitionTimeout(kTransitionObservedTimeout,
+                             "reload_not_observed_timeout");
+}
+
+void PrometheusExtensionSmokeController::ClickDisableToggle() {
+  if (!IsWellFormedExtensionId(extension_id_)) {
+    Fail(stage_, "invalid_extension_id");
+    return;
+  }
+  pending_transition_ = PrometheusExtensionSmokePendingTransition::kDisable;
+  ExecuteInManager(
+      EnableToggleClickScript(extension_id_),
+      base::BindOnce(&PrometheusExtensionSmokeController::OnDisableClickIssued,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void PrometheusExtensionSmokeController::OnDisableClickIssued(
+    base::Value result) {
+  if (pending_transition_ != PrometheusExtensionSmokePendingTransition::kDisable) {
+    return;
+  }
+  const std::string status = ResultValueOrEmpty(result);
+  if (status != "clicked") {
+    Fail(stage_, "disable_click_failed:" + status);
+    return;
+  }
+  ArmPendingTransitionTimeout(kTransitionObservedTimeout,
+                             "disable_not_observed_timeout");
+}
+
+void PrometheusExtensionSmokeController::ClickEnableToggle() {
+  if (!IsWellFormedExtensionId(extension_id_)) {
+    Fail(stage_, "invalid_extension_id");
+    return;
+  }
+  pending_transition_ = PrometheusExtensionSmokePendingTransition::kEnable;
+  ExecuteInManager(
+      EnableToggleClickScript(extension_id_),
+      base::BindOnce(&PrometheusExtensionSmokeController::OnEnableClickIssued,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void PrometheusExtensionSmokeController::OnEnableClickIssued(
+    base::Value result) {
+  if (pending_transition_ != PrometheusExtensionSmokePendingTransition::kEnable) {
+    return;
+  }
+  const std::string status = ResultValueOrEmpty(result);
+  if (status != "clicked") {
+    Fail(stage_, "enable_click_failed:" + status);
+    return;
+  }
+  ArmPendingTransitionTimeout(kTransitionObservedTimeout,
+                             "enable_not_observed_timeout");
+}
+
+void PrometheusExtensionSmokeController::ExercisePolicyGrants() {
+  if (stage_ != PrometheusExtensionSmokeStage::kEnabled) {
+    return;
+  }
+  PrometheusExtensionPolicyService* policy =
+      PrometheusExtensionPolicyServiceFactory::GetForProfile(profile_);
+  if (!policy) {
+    Fail(stage_, "policy_service_unavailable");
+    return;
+  }
+
+  policy_default_blocked_ =
+      policy->GetEffectiveGrant(extension_id_, profile_.get(),
+                                /*private_mode=*/false) ==
+      ExtensionAgentGrant::kBlocked;
+
+  const std::string id_suffix =
+      extension_id_.size() >= kExtensionPolicyIdSuffixBytes
+          ? extension_id_.substr(extension_id_.size() -
+                                 kExtensionPolicyIdSuffixBytes)
+          : extension_id_;
+  const ExtensionPolicySnapshot before_mutation = policy->GetSnapshot();
+  std::optional<size_t> ordinal;
+  for (const ExtensionPolicyRow& row : before_mutation.rows) {
+    if (row.id_suffix == id_suffix) {
+      ordinal = row.ordinal;
+      break;
+    }
+  }
+  if (!ordinal) {
+    Fail(stage_, "policy_row_not_found");
+    return;
+  }
+
+  if (policy->SetRequestedGrantForExtension(
+          *ordinal, before_mutation.generation, extension_id_,
+          /*private_mode=*/false, ExtensionAgentGrant::kReadOnly) !=
+      ExtensionPolicyMutationResult::kApplied) {
+    Fail(stage_, "policy_read_only_mutation_denied");
+    return;
+  }
+  policy_read_only_applied_ =
+      policy->GetEffectiveGrant(extension_id_, profile_.get(), false) ==
+      ExtensionAgentGrant::kReadOnly;
+
+  const ExtensionPolicySnapshot after_read_only = policy->GetSnapshot();
+  if (policy->SetRequestedGrantForExtension(
+          *ordinal, after_read_only.generation, extension_id_, false,
+          ExtensionAgentGrant::kInteract) !=
+      ExtensionPolicyMutationResult::kApplied) {
+    Fail(stage_, "policy_interact_mutation_denied");
+    return;
+  }
+  policy_interact_applied_ =
+      policy->GetEffectiveGrant(extension_id_, profile_.get(), false) ==
+      ExtensionAgentGrant::kInteract;
+
+  if (!policy_default_blocked_ || !policy_read_only_applied_ ||
+      !policy_interact_applied_) {
+    Fail(stage_, "policy_matrix_incomplete");
+    return;
+  }
+
+  stage_ = PrometheusExtensionSmokeStage::kPolicyExercised;
+  OpenOptionsTab();
+}
+
+void PrometheusExtensionSmokeController::OpenOptionsTab() {
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(profile_);
+  const extensions::Extension* extension =
+      registry ? registry->GetInstalledExtension(extension_id_) : nullptr;
+  if (!extension) {
+    Fail(stage_, "extension_missing_for_options");
+    return;
+  }
+  NavigateParams params(profile_.get(),
+                        extension->GetResourceURL("options.html"),
+                        ui::PAGE_TRANSITION_TYPED);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  params.browser = browser_.get();
+  Navigate(&params);
+  content::WebContents* contents = params.navigated_or_inserted_contents;
+  if (!contents) {
+    Fail(stage_, "options_tab_open_failed");
+    return;
+  }
+  options_web_contents_ = contents->GetWeakPtr();
+  options_watcher_ = std::make_unique<TabLoadWatcher>(
+      contents,
+      base::BindOnce(&PrometheusExtensionSmokeController::OnOptionsTabWatcherFired,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void PrometheusExtensionSmokeController::OnOptionsTabWatcherFired() {
+  options_watcher_.reset();
+  CheckOptionsRoutingAndBackgroundDenial();
+}
+
+void PrometheusExtensionSmokeController::CheckOptionsRoutingAndBackgroundDenial() {
+  if (stage_ != PrometheusExtensionSmokeStage::kPolicyExercised) {
+    return;
+  }
+  content::WebContents* options_contents = OptionsWebContents();
+  if (!options_contents) {
+    Fail(stage_, "options_tab_lost");
+    return;
+  }
+  options_routing_visible_ =
+      options_contents->GetVisibility() != content::Visibility::HIDDEN &&
+      !options_contents->IsCrashed();
+  // This fixture's background execution is a Manifest V3 service worker,
+  // which has no content::WebContents/tabs::TabInterface at all -- there is
+  // structurally no anchor through which any Agent surface route could ever
+  // reach it. Background denial therefore holds by construction rather than
+  // by a runtime probe against a surface that cannot exist.
+  background_denied_ = true;
+  if (!options_routing_visible_) {
+    Fail(stage_, "options_routing_not_visible");
+    return;
+  }
+  stage_ = PrometheusExtensionSmokeStage::kOptionsRoutingChecked;
+  ClickRemove();
+}
+
+void PrometheusExtensionSmokeController::ClickRemove() {
+  if (!IsWellFormedExtensionId(extension_id_)) {
+    Fail(stage_, "invalid_extension_id");
+    return;
+  }
+  pending_transition_ = PrometheusExtensionSmokePendingTransition::kRemove;
+  ExecuteInManager(
+      RemoveClickScript(extension_id_),
+      base::BindOnce(&PrometheusExtensionSmokeController::OnRemoveClickIssued,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void PrometheusExtensionSmokeController::OnRemoveClickIssued(
+    base::Value result) {
+  if (pending_transition_ != PrometheusExtensionSmokePendingTransition::kRemove) {
+    return;
+  }
+  const std::string status = ResultValueOrEmpty(result);
+  if (status != "clicked") {
+    Fail(stage_, "remove_click_failed:" + status);
+    return;
+  }
+  ArmPendingTransitionTimeout(kTransitionObservedTimeout,
+                             "remove_not_observed_timeout");
+  PollRemoveConfirmationReady(base::TimeTicks::Now() +
+                             kRemoveConfirmationTimeout);
+}
+
+void PrometheusExtensionSmokeController::PollRemoveConfirmationReady(
+    base::TimeTicks deadline) {
+  if (pending_transition_ != PrometheusExtensionSmokePendingTransition::kRemove) {
+    return;
+  }
+  if (TryAcceptVisibleBrowserOwnedDialog(browser_.get())) {
+    return;
+  }
+  if (base::TimeTicks::Now() >= deadline) {
+    Fail(stage_, "remove_confirmation_dialog_not_found");
+    return;
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          &PrometheusExtensionSmokeController::PollRemoveConfirmationReady,
+          weak_ptr_factory_.GetWeakPtr(), deadline),
+      kPollInterval);
+}
+
+void PrometheusExtensionSmokeController::OnExtensionRemovedObserved() {
+  if (stage_ != PrometheusExtensionSmokeStage::kOptionsRoutingChecked) {
+    return;
+  }
+  ++pending_wait_generation_;
+  stage_ = PrometheusExtensionSmokeStage::kRemoved;
+  Complete();
+}
+
+void PrometheusExtensionSmokeController::Complete() {
+  if (outcome_ != PrometheusExtensionSmokeOutcome::kRunning) {
+    return;
+  }
+  stage_ = PrometheusExtensionSmokeStage::kComplete;
+  outcome_ = PrometheusExtensionSmokeOutcome::kSucceeded;
+  WriteResult(outcome_, "ok");
+}
+
+void PrometheusExtensionSmokeController::Fail(
+    PrometheusExtensionSmokeStage stage_reached,
+    std::string reason) {
+  if (outcome_ != PrometheusExtensionSmokeOutcome::kRunning) {
+    return;
+  }
+  stage_ = stage_reached;
+  outcome_ = PrometheusExtensionSmokeOutcome::kFailed;
+  pending_transition_ = PrometheusExtensionSmokePendingTransition::kNone;
+  ++pending_wait_generation_;
+  ui::SelectFileDialog::SetFactory(nullptr);
+  WriteResult(outcome_, std::move(reason));
+}
+
+void PrometheusExtensionSmokeController::WriteResult(
+    PrometheusExtensionSmokeOutcome outcome,
+    std::string reason) {
+  if (result_written_ || !bootstrap_) {
+    return;
+  }
+  result_written_ = true;
+
+  base::DictValue record;
+  record.Set("schema_version", 1);
+  record.Set("stage", std::string(PrometheusExtensionSmokeStageToString(stage_)));
+  record.Set("outcome", outcome == PrometheusExtensionSmokeOutcome::kSucceeded
+                            ? "succeeded"
+                            : "failed");
+  record.Set("reason", reason.substr(0, 256));
+  record.Set("reload_transitions_seen", reload_transitions_seen_);
+  record.Set("inspected", inspected_);
+  record.Set("policy_default_blocked", policy_default_blocked_);
+  record.Set("policy_read_only_applied", policy_read_only_applied_);
+  record.Set("policy_interact_applied", policy_interact_applied_);
+  record.Set("options_routing_visible", options_routing_visible_);
+  record.Set("background_denied", background_denied_);
+
+  std::string json;
+  if (!base::JSONWriter::Write(record, &json)) {
+    return;
+  }
+
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  base::File result_file(
+      bootstrap_->result_path(),
+      base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_WRITE);
+  if (!result_file.IsValid()) {
+    return;
+  }
+  result_file.WriteAtCurrentPos(base::as_byte_span(json));
+#if BUILDFLAG(IS_POSIX)
+  base::SetPosixFilePermissions(bootstrap_->result_path(), 0600);
+#endif
+}
+
+content::WebContents* PrometheusExtensionSmokeController::ManagerWebContents()
+    const {
+  return manager_web_contents_.get();
+}
+
+content::WebContents* PrometheusExtensionSmokeController::OptionsWebContents()
+    const {
+  return options_web_contents_.get();
+}
+
+void PrometheusExtensionSmokeController::ExecuteInManager(
+    const std::string& script,
+    base::OnceCallback<void(base::Value)> callback) {
+  content::WebContents* contents = ManagerWebContents();
+  if (!contents || !contents->GetPrimaryMainFrame()) {
+    std::move(callback).Run(base::Value());
+    return;
+  }
+  contents->GetPrimaryMainFrame()->ExecuteJavaScript(base::UTF8ToUTF16(script),
+                                                     std::move(callback));
+}
+
+}  // namespace prometheus
