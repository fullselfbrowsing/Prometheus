 ...etheus_runtime_profile_service_unittest.cc | 108 ++++++++++++++++++
 3 files changed, 205 insertions(+), 4 deletions(-)

diff --git a/chrome/browser/prometheus/prometheus_runtime_profile_service.cc b/chrome/browser/prometheus/prometheus_runtime_profile_service.cc
index 79b0b5a7ef..eabda595cc 100644
--- a/chrome/browser/prometheus/prometheus_runtime_profile_service.cc
+++ b/chrome/browser/prometheus/prometheus_runtime_profile_service.cc
@@ -794,8 +794,8 @@ void PrometheusRuntimeProfileService::StartAutomaticProviderTurn(
       task->second.provider.provider_id, std::move(transport_request),
       base::BindOnce(
           &PrometheusRuntimeProfileService::OnAutomaticProviderTurnComplete,
-          weak_factory_.GetWeakPtr(), task_id, callback_generation,
-          immediate_result, std::move(request)));
+          weak_factory_.GetWeakPtr(), task_id, task->second.generation,
+          callback_generation, immediate_result, std::move(request)));
   task = tasks_.find(task_id);
   if (task != tasks_.end() && !task->second.finished &&
       task->second.callback_generation == callback_generation &&
@@ -812,6 +812,7 @@ void PrometheusRuntimeProfileService::StartAutomaticProviderTurn(
 
 void PrometheusRuntimeProfileService::OnAutomaticProviderTurnComplete(
     std::string task_id,
+    uint64_t task_generation,
     uint64_t callback_generation,
     std::shared_ptr<std::optional<RuntimeOperationResult>> immediate_result,
     ProviderTurnRequest request,
@@ -825,6 +826,96 @@ void PrometheusRuntimeProfileService::OnAutomaticProviderTurnComplete(
 
   if (!result.ok() && IsRetryableProviderFailure(result.failure) &&
       !task->second.mutation_started && hooks_.execute_provider_turn) {
+    if (task->second.generation != task_generation) {
+      FinishTaskOnce(task_id, task->second.generation,
+                     RuntimeCompletionSource::kProvider, {}, {},
+                     RuntimeErrorCode::kInvalidTransition);
+      *immediate_result = RuntimeOperationResult{
+          .status = RuntimeProfileStatus::kInvalidRequest,
+          .recovery = "Refresh the task snapshot and retry",
+      };
+      return;
+    }
+
+    const RuntimePolicy policy = ReadEffectivePolicy();
+    const RuntimeProfileStatus authority_status =
+        ValidateAuthority(task->second.authority);
+    if (authority_status != RuntimeProfileStatus::kOk) {
+      const std::string lost_session_id =
+          task->second.authority.agent_session_id;
+      HandleAgentSessionLost(lost_session_id);
+      *immediate_result = RuntimeOperationResult{
+          .status = authority_status,
+          .recovery = kAuthorityRecovery,
+      };
+      return;
+    }
+
+    const size_t competing_task_count = std::ranges::count_if(
+        tasks_, [&task_id](const auto& item) {
+          return item.first != task_id && !item.second.finished;
+        });
+    const RuntimePolicyDecision admission =
+        EvaluateRuntimeTaskAdmission(policy, competing_task_count);
+    const RuntimePolicyDecision dispatch = EvaluateRuntimeDispatch(
+        policy, /*internal_surface=*/false, /*background_action=*/false,
+        /*target_owned=*/true);
+    if (!IsRuntimePolicyDecisionAllowed(admission) ||
+        !IsRuntimePolicyDecisionAllowed(dispatch)) {
+      RuntimeOperationResult operation;
+      const RuntimePolicyDecision denial =
+          IsRuntimePolicyDecisionAllowed(admission) ? dispatch : admission;
+      operation.status = PolicyDenial(denial, &operation.recovery);
+      EmitTelemetryIfEnabled(policy, RuntimeTelemetryEventKind::kPolicyDenial);
+      FinishTaskOnce(task_id, task->second.generation,
+                     RuntimeCompletionSource::kProvider, {}, {},
+                     RuntimeErrorCode::kPolicyBlocked);
+      *immediate_result = std::move(operation);
+      return;
+    }
+
+    const int64_t now_ms = hooks_.now_ms ? hooks_.now_ms.Run() : 0;
+    if (task->second.turn_count >
+            static_cast<size_t>(policy.limits.max_turns) ||
+        now_ms < task->second.started_at_ms ||
+        now_ms - task->second.started_at_ms >
+            policy.limits.max_duration_ms) {
+      FinishTaskOnce(task_id, task->second.generation,
+                     RuntimeCompletionSource::kTimeout, {},
+                     task->second.snapshot.usage);
+      *immediate_result = RuntimeOperationResult{
+          .status = RuntimeProfileStatus::kTimeout,
+          .recovery = "The bounded task duration or turn cap was reached",
+      };
+      return;
+    }
+    if (request.user_text.size() >
+        static_cast<size_t>(policy.limits.max_prompt_bytes)) {
+      FinishTaskOnce(task_id, task->second.generation,
+                     RuntimeCompletionSource::kProvider, {}, {},
+                     RuntimeErrorCode::kRequestTooLarge);
+      *immediate_result = RuntimeOperationResult{
+          .status = RuntimeProfileStatus::kRequestTooLarge,
+          .recovery = "Shorten the task prompt and retry",
+      };
+      return;
+    }
+    const int64_t used_tokens = task->second.snapshot.usage.input_tokens +
+                                task->second.snapshot.usage.output_tokens;
+    const int64_t remaining_tokens =
+        policy.limits.max_total_tokens - used_tokens;
+    if (remaining_tokens <= 0) {
+      FinishTaskOnce(task_id, task->second.generation,
+                     RuntimeCompletionSource::kProvider, {},
+                     task->second.snapshot.usage,
+                     RuntimeErrorCode::kProviderInvalidResponse);
+      *immediate_result = RuntimeOperationResult{
+          .status = RuntimeProfileStatus::kProviderUnavailable,
+          .recovery = kProviderUnavailableRecovery,
+      };
+      return;
+    }
+
     const std::vector<PrometheusProviderConfig> fresh_providers =
         hooks_.list_providers ? hooks_.list_providers.Run()
                               : std::vector<PrometheusProviderConfig>();
@@ -849,13 +940,14 @@ void PrometheusRuntimeProfileService::OnAutomaticProviderTurnComplete(
       request.family = candidate.family;
       request.use_responses_api = candidate.capabilities.responses_api;
       request.model = candidate.model_id;
+      request.max_output_tokens = std::min<int64_t>(1024, remaining_tokens);
       ProviderTurnRequest transport_request = CloneProviderTurnRequest(request);
       const uint64_t provider_operation_id = hooks_.execute_provider_turn.Run(
           candidate.provider_id, std::move(transport_request),
           base::BindOnce(
               &PrometheusRuntimeProfileService::OnAutomaticProviderTurnComplete,
-              weak_factory_.GetWeakPtr(), task_id, callback_generation,
-              immediate_result, std::move(request)));
+              weak_factory_.GetWeakPtr(), task_id, task_generation,
+              callback_generation, immediate_result, std::move(request)));
       task = tasks_.find(task_id);
       if (task != tasks_.end() && !task->second.finished &&
           task->second.callback_generation == callback_generation &&
diff --git a/chrome/browser/prometheus/prometheus_runtime_profile_service.h b/chrome/browser/prometheus/prometheus_runtime_profile_service.h
