+  const std::string metadata_dump =
+      store_->GetSanitizedMetadataSnapshot().DebugString();
+  for (std::string_view sentinel :
+       {kPlaintextSentinel, kReplacementSentinel, kSuffixSentinel,
+        kAuthorizationSentinel, kRawErrorSentinel, "api_key_sentinel",
+        "password_sentinel", "endpoint_query_sentinel"}) {
+    EXPECT_EQ(pref_dump.find(sentinel), std::string::npos);
+    EXPECT_EQ(metadata_dump.find(sentinel), std::string::npos);
