+TEST(PrometheusExtensionSurfaceResolverTest, RejectsMismatchedCommittedOrigin) {
+  auto evidence = VisiblePopupEvidence();
+  evidence.origin_matches_browser_identity = false;
+  ExpectDenied(evidence,
+               PrometheusExtensionSurfaceDenial::kMismatchedExtensionOrigin,
+               AgentErrorCode::kInvalidTarget);
+}
+
+TEST(PrometheusExtensionSurfaceResolverTest, RejectsNonExtensionOrigin) {
+  auto evidence = VisibleTabEvidence();
+  evidence.extension_origin = false;
+  ExpectDenied(evidence,
+               PrometheusExtensionSurfaceDenial::kMismatchedExtensionOrigin,
+               AgentErrorCode::kInvalidTarget);
+}
