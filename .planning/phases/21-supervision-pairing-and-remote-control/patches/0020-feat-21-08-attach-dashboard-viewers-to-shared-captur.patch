+SupervisionBaseline MakeServiceBaseline(std::string name) {
+  SupervisionNormalizedNode node;
+  node.ref = "document:1";
+  node.tag = "root";
+  node.name = std::move(name);
+
+  SupervisionBaseline baseline;
+  baseline.state = SupervisionProjectionState::kAuthoritative;
+  baseline.nodes.push_back(std::move(node));
+  baseline.serialized_json = "{\"safe\":true}";
+  return baseline;
+}
+
+class ServiceCaptureSource {
+ public:
+  void Capture(base::OnceCallback<void(SupervisionBaseline)> callback) {
+    pending_.push_back(std::move(callback));
+  }
+
+  size_t pending_count() const { return pending_.size(); }
+
+  void CompleteNext(SupervisionBaseline baseline) {
+    ASSERT_FALSE(pending_.empty());
+    auto callback = std::move(pending_.front());
+    pending_.pop_front();
+    std::move(callback).Run(std::move(baseline));
+  }
+
+ private:
+  std::deque<base::OnceCallback<void(SupervisionBaseline)>> pending_;
+};
