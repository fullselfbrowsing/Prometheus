+// `extension_id` must already be validated by IsWellFormedExtensionId()
+// (fixed 32-character a-p alphabet) before it is ever interpolated below: it
+// is always a value this controller itself observed from
+// extensions::Extension::id(), never externally supplied, but every
+// interpolation site still defends independently rather than trusting a
+// single upstream check.
+std::string ItemQueryExpression(const std::string& extension_id) {
+  return "document.querySelector('extensions-manager').shadowRoot"
+        ".querySelector('extensions-item-list').shadowRoot"
+        ".querySelector('#" +
+        extension_id + "')";
+}
