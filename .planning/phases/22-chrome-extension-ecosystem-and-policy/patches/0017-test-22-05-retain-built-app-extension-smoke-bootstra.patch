+void PrometheusBrowserMainExtraParts::OnExtensionSmokeBrowserReady(
+    Profile* profile,
+    Browser* browser) {
+  extension_smoke_browser_waiter_.reset();
+  if (!profile || !browser || extension_smoke_controller_) {
+    return;
+  }
+
+#if defined(OFFICIAL_BUILD)
+  constexpr bool kIsOfficialBuild = true;
+#else
+  constexpr bool kIsOfficialBuild = false;
+#endif
+  std::unique_ptr<PrometheusExtensionSmokeBootstrap> bootstrap;
+  const PrometheusExtensionSmokeBootstrapResult result =
+      PrometheusExtensionSmokeBootstrap::Create(
+          *base::CommandLine::ForCurrentProcess(), kIsOfficialBuild,
+          {.is_regular_profile = profile->IsRegularProfile(),
+           .is_disposable_profile = IsDisposableSupervisionTestProfile(profile),
+           .is_off_the_record = profile->IsOffTheRecord()},
+          CreatePrometheusExtensionSmokeBootstrapFileAccess(),
+          CreatePrometheusExtensionSmokeFixtureAccess(), &bootstrap);
+  if (result != PrometheusExtensionSmokeBootstrapResult::kApplied) {
+    return;
+  }
+  extension_smoke_controller_ = PrometheusExtensionSmokeController::Create(
+      std::move(bootstrap), profile, browser);
+}
