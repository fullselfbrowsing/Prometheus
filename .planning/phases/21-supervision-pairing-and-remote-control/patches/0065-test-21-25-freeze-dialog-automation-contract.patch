diff --git a/chrome/browser/prometheus/prometheus_supervision_confirmation_browsertest.cc b/chrome/browser/prometheus/prometheus_supervision_confirmation_browsertest.cc
index 777d4470ee..37398172d3 100644
--- a/chrome/browser/prometheus/prometheus_supervision_confirmation_browsertest.cc
+++ b/chrome/browser/prometheus/prometheus_supervision_confirmation_browsertest.cc
@@ -6,6 +6,7 @@
 #include <vector>
 
 #include "base/run_loop.h"
+#include "base/functional/callback_helpers.h"
 #include "base/test/bind.h"
 #include "base/test/run_until.h"
 #include "base/test/scoped_feature_list.h"
@@ -108,6 +109,185 @@ class PrometheusSupervisionConfirmationBrowserTest
   base::test::ScopedFeatureList feature_list_;
 };
 
+IN_PROC_BROWSER_TEST_F(
+    PrometheusSupervisionConfirmationBrowserTest,
+    TestBootstrapAcceptsOnlyVisibleExactSupervisionWidgetOnce) {
+  base::ScopedClosureRunner clear_automation(base::BindOnce([]() {
+    SetPrometheusSupervisionDialogAutomationForTesting({});
+  }));
+  bool saw_visible_exact_widget = false;
+  int automation_consults = 0;
+  int replies = 0;
+  PrometheusSupervisionDialogResult result =
+      PrometheusSupervisionDialogResult::kDenied;
+  SetPrometheusSupervisionDialogAutomationForTesting(base::BindLambdaForTesting(
+      [&](BrowserWindowInterface* exact_browser,
+          PrometheusSupervisionDialogKind kind) {
+        ++automation_consults;
+        views::Widget* widget = PrometheusRuntimeDialogWidgetForTesting();
+        views::DialogDelegate* dialog = CurrentDialog();
+        saw_visible_exact_widget =
+            exact_browser == browser() &&
+            kind == PrometheusSupervisionDialogKind::kEnableControl && widget &&
+            widget->IsVisible() && dialog &&
+            dialog->GetWindowTitle() == u"Enable remote control?" &&
+            JoinLabelText(widget->GetRootView()).find(
+                u"Keep view only") != std::u16string::npos;
+        return PrometheusSupervisionDialogAutomationResponse::kAccept;
+      }));
+  ASSERT_TRUE(ShowPrometheusSupervisionDialog(
+      browser(), EnableModel(),
+      base::BindLambdaForTesting(
+          [&](PrometheusSupervisionDialogResult reply) {
+            ++replies;
+            result = reply;
+          })));
+
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(saw_visible_exact_widget);
+  EXPECT_EQ(1, automation_consults);
+  EXPECT_EQ(1, replies);
+  EXPECT_EQ(PrometheusSupervisionDialogResult::kApproved, result);
+  if (views::DialogDelegate* dialog = CurrentDialog()) {
+    dialog->CancelDialog();
+    ASSERT_TRUE(base::test::RunUntil(
+        []() { return !PrometheusRuntimeDialogWidgetForTesting(); }));
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(
+    PrometheusSupervisionConfirmationBrowserTest,
+    TestBootstrapMismatchReplayAndRemovalDoNotClick) {
+  base::ScopedClosureRunner clear_automation(base::BindOnce([]() {
+    SetPrometheusSupervisionDialogAutomationForTesting({});
+  }));
+  Browser* const other_browser = CreateBrowser(browser()->profile());
+  ASSERT_TRUE(other_browser);
+  int automation_consults = 0;
+  bool consumed = false;
+  SetPrometheusSupervisionDialogAutomationForTesting(base::BindLambdaForTesting(
+      [&](BrowserWindowInterface* exact_browser,
+          PrometheusSupervisionDialogKind kind) {
+        ++automation_consults;
+        if (exact_browser != browser() ||
+            kind != PrometheusSupervisionDialogKind::kEnableControl ||
+            consumed) {
+          return PrometheusSupervisionDialogAutomationResponse::kNoResponse;
+        }
+        consumed = true;
+        return PrometheusSupervisionDialogAutomationResponse::kAccept;
+      }));
+
+  int wrong_browser_replies = 0;
+  ASSERT_TRUE(ShowPrometheusSupervisionDialog(
+      other_browser, EnableModel(),
+      base::BindLambdaForTesting(
+          [&](PrometheusSupervisionDialogResult) {
+            ++wrong_browser_replies;
+          })));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1, automation_consults);
+  EXPECT_EQ(0, wrong_browser_replies);
+  ASSERT_TRUE(CurrentDialog());
+  CurrentDialog()->CancelDialog();
+  ASSERT_TRUE(base::test::RunUntil(
+      []() { return !PrometheusRuntimeDialogWidgetForTesting(); }));
+
+  int accepted_replies = 0;
+  ASSERT_TRUE(ShowPrometheusSupervisionDialog(
+      browser(), EnableModel(),
+      base::BindLambdaForTesting(
+          [&](PrometheusSupervisionDialogResult reply) {
+            EXPECT_EQ(PrometheusSupervisionDialogResult::kApproved, reply);
+            ++accepted_replies;
+          })));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(2, automation_consults);
+  EXPECT_EQ(1, accepted_replies);
+
+  int replay_replies = 0;
+  ASSERT_TRUE(ShowPrometheusSupervisionDialog(
+      browser(), EnableModel(),
+      base::BindLambdaForTesting(
+          [&](PrometheusSupervisionDialogResult) { ++replay_replies; })));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(3, automation_consults);
+  EXPECT_EQ(0, replay_replies);
+  ASSERT_TRUE(CurrentDialog());
+  CurrentDialog()->CancelDialog();
+  ASSERT_TRUE(base::test::RunUntil(
+      []() { return !PrometheusRuntimeDialogWidgetForTesting(); }));
+
+  int removed_replies = 0;
+  consumed = false;
+  ASSERT_TRUE(ShowPrometheusSupervisionDialog(
+      browser(), EnableModel(),
+      base::BindLambdaForTesting(
+          [&](PrometheusSupervisionDialogResult) { ++removed_replies; })));
+  SetPrometheusSupervisionDialogAutomationForTesting({});
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(0, removed_replies);
+  ASSERT_TRUE(CurrentDialog());
+  CurrentDialog()->CancelDialog();
+  ASSERT_TRUE(base::test::RunUntil(
+      []() { return !PrometheusRuntimeDialogWidgetForTesting(); }));
+}
+
+IN_PROC_BROWSER_TEST_F(
+    PrometheusSupervisionConfirmationBrowserTest,
+    TestBootstrapProviderAndVaultDialogsDoNotConsultAutomation) {
+  base::ScopedClosureRunner clear_automation(base::BindOnce([]() {
+    SetPrometheusSupervisionDialogAutomationForTesting({});
+  }));
+  int automation_consults = 0;
+  SetPrometheusSupervisionDialogAutomationForTesting(base::BindLambdaForTesting(
+      [&](BrowserWindowInterface*, PrometheusSupervisionDialogKind) {
+        ++automation_consults;
+        return PrometheusSupervisionDialogAutomationResponse::kAccept;
+      }));
+
+  PrometheusProviderConfig provider;
+  provider.label = "Provider sentinel";
+  provider.canonical_endpoint = "https://provider.example.test/v1";
+  int provider_replies = 0;
+  ASSERT_TRUE(ShowPrometheusProviderSecretRemovalDialog(
+      browser(), provider,
+      base::BindLambdaForTesting(
+          [&](bool accepted) {
+            EXPECT_FALSE(accepted);
+            ++provider_replies;
+          })));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(0, automation_consults);
+  ASSERT_TRUE(CurrentDialog());
+  CurrentDialog()->CancelDialog();
+  ASSERT_TRUE(base::test::RunUntil(
+      []() { return !PrometheusRuntimeDialogWidgetForTesting(); }));
+  EXPECT_EQ(1, provider_replies);
+
+  PrometheusVaultMetadata metadata;
+  metadata.id = "vault-sentinel";
+  metadata.label = "Vault sentinel";
+  metadata.kind = PrometheusVaultKind::kCredential;
+  metadata.canonical_site_origin = "https://vault.example.test";
+  int vault_replies = 0;
+  ASSERT_TRUE(ShowPrometheusVaultSecretDialog(
+      browser(), metadata, false,
+      base::BindLambdaForTesting(
+          [&](NativeVaultEntryReply reply) {
+            EXPECT_EQ(PrometheusVaultStatus::kNativeEntryCancelled,
+                      reply.status);
+            ++vault_replies;
+          })));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(0, automation_consults);
+  ASSERT_TRUE(CurrentDialog());
+  CurrentDialog()->CancelDialog();
+  ASSERT_TRUE(base::test::RunUntil(
+      []() { return !PrometheusRuntimeDialogWidgetForTesting(); }));
+  EXPECT_EQ(1, vault_replies);
+}
+
 IN_PROC_BROWSER_TEST_F(PrometheusSupervisionConfirmationBrowserTest,
                        EnableControlHasExactCopyRowsAndSafeFocus) {
   int replies = 0;
