+IN_PROC_BROWSER_TEST_F(PrometheusTabSupervisionBadgeBrowserTest,
+                       StateCompressionPriorityKeepsCompleteAccessibleName) {
+  PrometheusTabStatusBadge badge;
+  PrometheusTabState state = ViewingState(2);
+  state.owner_label = "Agent A";
+  state.automation_active = true;
+  state.supervision.control_state = ControlState::kControllerReady;
+  state.supervision.controller_label = "Dashboard A";
+  state.supervision.activity_state = ActivityState::kExecuting;
+  state.supervision.action_category = ActionCategory::kClick;
+  state.supervision.severity = Severity::kNeedsAttention;
+  badge.SetState(state);
+  const std::u16string complete_name =
+      badge.GetViewAccessibility().GetCachedName();
+
+  badge.SetAvailableWidth(PrometheusTabStatusBadge::kMaximumWidth);
+  EXPECT_EQ(gfx::Size(44, 12), badge.GetPreferredSize());
+  EXPECT_TRUE(badge.owner_or_automation_badge_for_testing()->GetVisible());
+  EXPECT_TRUE(badge.supervision_badge_for_testing()->GetVisible());
+  EXPECT_TRUE(badge.health_badge_for_testing()->GetVisible());
+
+  badge.SetAvailableWidth(28);
+  EXPECT_EQ(gfx::Size(28, 12), badge.GetPreferredSize());
+  EXPECT_TRUE(badge.owner_or_automation_badge_for_testing()->GetVisible());
+  EXPECT_TRUE(badge.supervision_badge_for_testing()->GetVisible());
+  EXPECT_FALSE(badge.health_badge_for_testing()->GetVisible());
+  EXPECT_EQ(complete_name, badge.GetViewAccessibility().GetCachedName());
+
+  badge.SetAvailableWidth(12);
+  EXPECT_EQ(gfx::Size(12, 12), badge.GetPreferredSize());
+  EXPECT_FALSE(badge.owner_or_automation_badge_for_testing()->GetVisible());
+  EXPECT_TRUE(badge.supervision_badge_for_testing()->GetVisible());
+  EXPECT_FALSE(badge.health_badge_for_testing()->GetVisible());
+  EXPECT_EQ(complete_name, badge.GetTooltipText());
+
+  badge.SetAvailableWidth(0);
+  EXPECT_EQ(gfx::Size(), badge.GetPreferredSize());
+  EXPECT_EQ(gfx::Size(12, 12), badge.GetMinimumSize());
+  EXPECT_TRUE(badge.GetVisible());
+  EXPECT_FALSE(badge.owner_or_automation_badge_for_testing()->GetVisible());
+  EXPECT_FALSE(badge.supervision_badge_for_testing()->GetVisible());
+  EXPECT_FALSE(badge.health_badge_for_testing()->GetVisible());
+  EXPECT_EQ(complete_name, badge.GetViewAccessibility().GetCachedName());
+
+  state.automation_active = false;
+  badge.SetAvailableWidth(28);
+  badge.SetState(state);
+  EXPECT_FALSE(badge.owner_or_automation_badge_for_testing()->GetVisible());
+  EXPECT_TRUE(badge.supervision_badge_for_testing()->GetVisible());
+  EXPECT_TRUE(badge.health_badge_for_testing()->GetVisible());
+
+  state.supervision = PrometheusTabState::Supervision();
+  state.health = PrometheusTabState::Health::kNeedsAttention;
+  badge.SetAvailableWidth(12);
+  badge.SetState(state);
+  EXPECT_FALSE(badge.owner_or_automation_badge_for_testing()->GetVisible());
+  EXPECT_FALSE(badge.supervision_badge_for_testing()->GetVisible());
+  EXPECT_TRUE(badge.health_badge_for_testing()->GetVisible());
+}
