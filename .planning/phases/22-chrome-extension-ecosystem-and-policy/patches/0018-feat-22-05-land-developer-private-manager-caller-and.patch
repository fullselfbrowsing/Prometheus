-  AttemptInspect();
+  if (!IsWellFormedExtensionId(extension_id_)) {
+    Fail(stage_, "invalid_extension_id");
+    return;
+  }
+  // The browser-owned ExtensionRegistry (this observation) and the WebUI's
+  // own reactive item-list render are two independent paths reacting to the
+  // same install: developerPrivate.onItemStateChanged must still round-trip
+  // to the renderer and re-render before the item's card exists in the DOM.
+  // Poll instead of assuming it is already there.
+  PollItemRendered(base::TimeTicks::Now() + kItemRenderedTimeout);
+}
+
+void PrometheusExtensionSmokeController::PollItemRendered(
+    base::TimeTicks deadline) {
+  if (stage_ != PrometheusExtensionSmokeStage::kExtensionInstalled) {
+    return;
+  }
+  ExecuteInManager(
+      ItemPresentProbeScript(extension_id_),
+      base::BindOnce(&PrometheusExtensionSmokeController::OnItemRenderedPolled,
+                     weak_ptr_factory_.GetWeakPtr(), deadline));
+}
+
+void PrometheusExtensionSmokeController::OnItemRenderedPolled(
+    base::TimeTicks deadline,
+    base::Value result) {
+  if (stage_ != PrometheusExtensionSmokeStage::kExtensionInstalled) {
+    return;
+  }
+  if (result.is_bool() && result.GetBool()) {
+    AttemptInspect();
+    return;
+  }
+  if (base::TimeTicks::Now() >= deadline) {
+    Fail(stage_, "item_not_rendered_timeout");
+    return;
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&PrometheusExtensionSmokeController::PollItemRendered,
+                     weak_ptr_factory_.GetWeakPtr(), deadline),
+      kPollInterval);
 }
 
