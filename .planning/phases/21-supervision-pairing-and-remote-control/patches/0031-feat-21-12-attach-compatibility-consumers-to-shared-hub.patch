+  }
+
+  const int32_t stable_tab_id = session->second->stable_tab_id;
+  PrometheusAgentService::RouteCallback pending =
+      std::move(session->second->pending_callback);
+  if (CaptureHubEntry* const capture_hub = FindCaptureHub(*session->second)) {
+    if (session->second->pending_route.has_value()) {
+      capture_hub->hub->CancelDiffWait(session->second->capture_consumer_token);
+    }
+    capture_hub->hub->DetachConsumer(session->second->capture_consumer_token);
+  }
+  compatibility_sessions_.erase(session);
+  ReleaseCaptureHubIfUnused(stable_tab_id);
+  ScheduleObservedTabRelease(stable_tab_id);
+  return pending;
+}
+
+void PrometheusSupervisionProfileService::TerminateCompatibilitySession(
+    std::string_view agent_session_id,
+    AgentRouteResult result) {
+  PrometheusAgentService::RouteCallback pending =
+      DetachCompatibilitySession(agent_session_id);
+  if (pending) {
+    std::move(pending).Run(std::move(result));
+  }
+}
+
+void PrometheusSupervisionProfileService::TerminateCompatibilitySessionsForTab(
+    int32_t stable_tab_id,
+    const AgentRouteResult& result) {
+  std::vector<std::string> sessions;
+  for (const auto& [agent_session_id, session] : compatibility_sessions_) {
+    if (session->stable_tab_id == stable_tab_id) {
+      sessions.push_back(agent_session_id);
+    }
+  }
+  for (const std::string& agent_session_id : sessions) {
+    TerminateCompatibilitySession(agent_session_id, result);
+  }
+}
+
+bool PrometheusSupervisionProfileService::RevalidateCompatibilitySession(
+    std::string_view agent_session_id,
+    const CompatibilitySession& session) const {
+  const CaptureHubEntry* const capture_hub = FindCaptureHub(session);
+  auto observed = observed_tabs_.find(session.stable_tab_id);
+  return capture_hub && capture_hub->exact_browser &&
+         IsEligibleTarget(profile_, capture_hub->exact_browser.get(),
+                          capture_hub->tab) &&
+         observed != observed_tabs_.end() && observed->second->lease.data() &&
+         observed->second->tab == capture_hub->tab &&
+         observed->second->lease.data()->owner_session_id() == agent_session_id;
+}
+
+std::optional<AgentRouteResult>
+PrometheusSupervisionProfileService::TryReadCompatibilityRoute(
+    CompatibilitySession& session,
+    AgentRouteName route_name) {
+  CaptureHubEntry* const capture_hub = FindCaptureHub(session);
+  if (!capture_hub) {
+    return CompatibilityStale("The shared supervision capture hub ended");
+  }
+
+  if (route_name == AgentRouteName::kStartSupervisionSession ||
+      route_name == AgentRouteName::kGetSupervisionSnapshot) {
+    const bool requires_baseline =
+        capture_hub->hub->ConsumerNeedsBaseline(session.capture_consumer_token);
+    std::optional<SupervisionCaptureBaselineDelivery> delivery =
+        requires_baseline
+            ? capture_hub->hub->ReadBaseline(session.capture_consumer_token)
+            : capture_hub->hub->ReadCurrentBaseline(
+                  session.capture_consumer_token);
+    if (!delivery.has_value()) {
+      return std::nullopt;
+    }
+    AgentRouteResult result = PreflightCompatibilityResult(
+        MakeCompatibilityBaselineResult(route_name, *delivery));
+    if (!result.ok) {
+      return result;
+    }
+    if (requires_baseline &&
+        !capture_hub->hub->Ack(session.capture_consumer_token,
+                               delivery->stamp)) {
+      return CompatibilityNeedsSnapshot();
+    }
+    return result;
+  }
+
+  if (route_name != AgentRouteName::kGetSupervisionDiff) {
+    return AgentRouteResult::Failure(
+        AgentErrorCode::kInvalidRoute,
+        "The compatibility route cannot read supervision state",
+        "Use start, snapshot, or diff for supervision reads");
+  }
+
+  std::optional<SupervisionCaptureDiffDelivery> delivery =
+      capture_hub->hub->ReadNext(session.capture_consumer_token);
+  if (delivery.has_value()) {
+    AgentRouteResult result =
+        PreflightCompatibilityResult(MakeCompatibilityDiffResult(*delivery));
+    if (!result.ok) {
+      return result;
+    }
+    if (!capture_hub->hub->Ack(session.capture_consumer_token,
+                               delivery->stamp)) {
+      return CompatibilityNeedsSnapshot();
+    }
+    return result;
+  }
+  if (capture_hub->hub->ConsumerNeedsBaseline(session.capture_consumer_token)) {
+    return CompatibilityNeedsSnapshot();
+  }
+  if (capture_hub->hub->CanReturnNoChange(session.capture_consumer_token)) {
+    return PreflightCompatibilityResult(AgentRouteResult::SupervisionSuccess(
+        route_name, AgentSupervisionNoChangeResult()));
+  }
+  return std::nullopt;
+}
+
+bool PrometheusSupervisionProfileService::BeginCompatibilityWait(
+    CompatibilitySession& session,
+    AgentRouteName route_name,
+    PrometheusAgentService::RouteCallback callback) {
+  CaptureHubEntry* const capture_hub = FindCaptureHub(session);
+  if (!capture_hub || !callback || session.pending_callback) {
+    return false;
+  }
+  const auto match = std::find_if(
+      compatibility_sessions_.begin(), compatibility_sessions_.end(),
+      [&session](const auto& entry) { return entry.second.get() == &session; });
+  if (match == compatibility_sessions_.end()) {
+    return false;
+  }
+  const std::string agent_session_id = match->first;
+  const uint64_t generation = session.generation;
+  if (!capture_hub->hub->WaitForNextDiff(
+          session.capture_consumer_token,
+          base::BindOnce(
+              &PrometheusSupervisionProfileService::OnCompatibilityWaitReady,
+              weak_factory_.GetWeakPtr(), agent_session_id, generation))) {
+    session.pending_route = route_name;
+    session.pending_callback = std::move(callback);
+    return false;
+  }
+  session.pending_route = route_name;
+  session.pending_callback = std::move(callback);
+  return true;
+}
+
+void PrometheusSupervisionProfileService::OnCompatibilityWaitReady(
+    std::string agent_session_id,
+    uint64_t generation,
+    SupervisionCaptureWaitReason reason) {
+  auto session = compatibility_sessions_.find(agent_session_id);
+  if (session == compatibility_sessions_.end() ||
+      session->second->generation != generation ||
+      !session->second->pending_callback ||
+      !session->second->pending_route.has_value()) {
+    return;
+  }
+
+  PrometheusAgentService::RouteCallback callback =
+      std::move(session->second->pending_callback);
+  const AgentRouteName route_name = *session->second->pending_route;
+  session->second->pending_route.reset();
+  if (reason == SupervisionCaptureWaitReason::kConsumerEnded ||
+      !RevalidateCompatibilitySession(agent_session_id, *session->second)) {
+    DetachCompatibilitySession(agent_session_id);
+    std::move(callback).Run(
+        CompatibilityStale("The pending supervision target ended"));
+    return;
+  }
+  if (reason == SupervisionCaptureWaitReason::kNoChange) {
+    std::move(callback).Run(
+        PreflightCompatibilityResult(AgentRouteResult::SupervisionSuccess(
+            AgentRouteName::kGetSupervisionDiff,
+            AgentSupervisionNoChangeResult())));
+    return;
+  }
+
+  std::optional<AgentRouteResult> result =
+      TryReadCompatibilityRoute(*session->second, route_name);
+  if (!result.has_value()) {
+    std::move(callback).Run(AgentRouteResult::Failure(
+        AgentErrorCode::kCapabilityNotReady,
+        "A safe supervision baseline is not currently available",
+        "Retry after the exact tab finishes loading"));
+    return;
+  }
+  std::move(callback).Run(std::move(*result));
+}
