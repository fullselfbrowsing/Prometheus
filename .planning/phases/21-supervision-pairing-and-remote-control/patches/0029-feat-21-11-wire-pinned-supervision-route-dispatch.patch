+void PrometheusAgentService::ExecuteSupervisionRoute(
+    BrowserWindowInterface* browser,
+    const AgentRouteRequest& request,
+    RouteCallback callback) {
+  const base::Time timestamp = Now();
+  const base::TimeTicks started_at = base::TimeTicks::Now();
+  auto finish = [&](AgentRouteResult result) {
+    std::move(callback).Run(
+        FinishRoute(request, timestamp, started_at, std::move(result)));
+  };
+
+  AgentSessionResult session_result =
+      session_registry_->ValidateSession(request.session_id, timestamp);
+  if (!session_result.route_result.ok) {
+    finish(std::move(session_result.route_result));
+    return;
+  }
+  AgentRouteResult touch_result =
+      session_registry_->TouchSession(request.session_id, Now());
+  if (!touch_result.ok) {
+    finish(std::move(touch_result));
+    return;
+  }
+
+  if (!browser || browser->IsDeleteScheduled() ||
+      browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    finish(InvalidTarget("Missing or closing regular browser target"));
+    return;
+  }
+  const int32_t browser_session_id = browser->GetSessionID().id();
+  if (!request.target.browser_session_id.has_value() ||
+      !request.target.window_session_id.has_value() ||
+      *request.target.browser_session_id != browser_session_id ||
+      *request.target.window_session_id != browser_session_id ||
+      request.target.tab_index.has_value() ||
+      IsNullTabHandle(request.target.tab_handle)) {
+    finish(InvalidTarget("Supervision requires one exact browser and tab"));
+    return;
+  }
+  tabs::TabInterface* const tab = request.target.tab_handle.Get();
+  if (!tab || tab->GetHandle() != request.target.tab_handle ||
+      tab->GetBrowserWindowInterface() != browser) {
+    finish(StaleTarget("The pinned supervision tab is no longer live"));
+    return;
+  }
+
+  SupervisionRouteDispatcher dispatcher = SupervisionRouteDispatcherStorage();
+  if (!dispatcher) {
+    finish(SupervisionRouteNotReady(request.route_name));
+    return;
+  }
+  dispatcher.Run(
+      browser, request,
+      base::BindOnce(&PrometheusAgentService::OnSupervisionRouteComplete,
+                     weak_factory_.GetWeakPtr(), request, timestamp, started_at,
+                     std::move(callback)));
+}
+
+// static
+void PrometheusAgentService::OnSupervisionRouteComplete(
+    base::WeakPtr<PrometheusAgentService> service,
+    AgentRouteRequest request,
+    base::Time timestamp,
+    base::TimeTicks started_at,
+    RouteCallback callback,
+    AgentRouteResult result) {
+  if (service) {
+    result =
+        service->FinishRoute(request, timestamp, started_at, std::move(result));
+  } else {
+    result = BrowserShuttingDown();
+  }
+  std::move(callback).Run(std::move(result));
+}
