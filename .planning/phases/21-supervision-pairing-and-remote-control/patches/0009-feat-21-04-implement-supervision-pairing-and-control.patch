+    pending_pairings_.erase(stable_tab_id);
+    ScheduleObservedTabRelease(stable_tab_id);
+    static_cast<SupervisionServiceResult&>(result) = ServiceFailure(
+        SupervisionErrorCode::kExpiredCode, "The pairing code has expired",
+        "Create a new pairing code");
+    return result;
+  }
+  if (pairing->state != SupervisionPairingState::kPending) {
+    static_cast<SupervisionServiceResult&>(result) =
+        ServiceFailure(SupervisionErrorCode::kInvalidCode,
+                       "The pairing code is no longer redeemable",
+                       "Create a new pairing code");
+    return result;
+  }
+
+  tabs::TabInterface* tab = ResolveExactTarget(*pairing);
+  ObservedTab* observed = AcquireObservedTab(tab);
+  if (!tab || !observed || !observed->lease.data()) {
+    last_pairing_states_[stable_tab_id] = SupervisionPairingState::kTargetLost;
+    pending_pairings_.erase(stable_tab_id);
+    ScheduleObservedTabRelease(stable_tab_id);
+    static_cast<SupervisionServiceResult&>(result) =
+        ServiceFailure(SupervisionErrorCode::kStaleTarget,
+                       "The paired tab is no longer available",
+                       "Create a new pairing for a live tab");
+    return result;
+  }
+
+  const size_t viewers_for_tab = viewer_count_for_testing(stable_tab_id);
+  if (viewers_.size() >= limits_.sessions_per_profile ||
+      viewers_for_tab >= limits_.viewers_per_tab) {
+    static_cast<SupervisionServiceResult&>(result) =
+        ServiceFailure(SupervisionErrorCode::kTooLarge,
+                       "The viewer session limit has been reached",
+                       "End an existing viewer session and retry");
+    return result;
+  }
