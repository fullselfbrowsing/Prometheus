+// static
+void PrometheusExtensionPageAdapter::CompleteWithAudit(
+    AgentTarget target,
+    PrometheusExtensionAuditProjection projection,
+    CompletionCallback callback,
+    AgentRouteResult result) {
+  projection.result = AuditResultFor(result);
+  result.target = std::move(target);
+  std::move(callback).Run(std::move(result), std::move(projection));
+}
+
+AgentRouteResult
+PrometheusExtensionPageAdapter::ValidateSurfaceForDispatch(
+    base::WeakPtr<Browser> browser,
+    base::WeakPtr<tabs::TabInterface> anchor_tab,
+    std::optional<AgentExtensionSurfaceSelector> selector,
+    std::string extension_id,
+    PrometheusExtensionSurfaceKind surface,
+    uint64_t policy_generation,
+    content::GlobalRenderFrameHostId primary_frame_id,
+    AgentRouteName route_name,
+    content::WebContents* dispatched_web_contents,
+    content::RenderFrameHost* dispatched_frame) {
+  if (!browser || !anchor_tab || !policy_service_) {
+    return AdmissionFailure(PrometheusExtensionAdmissionDenial::kUnavailable);
+  }
+  PrometheusExtensionSurfaceResolver resolver(policy_service_);
+  auto resolution =
+      resolver.Resolve(browser.get(), anchor_tab.get(), selector,
+                       policy_generation);
+  if (!resolution.has_value()) {
+    return resolution.error().error_code == AgentErrorCode::kStaleTarget
+               ? AdmissionFailure(
+                     PrometheusExtensionAdmissionDenial::kStalePolicy)
+               : AdmissionFailure(
+                     PrometheusExtensionAdmissionDenial::kUnsupportedRoute);
+  }
+  const PrometheusResolvedExtensionSurface& current = resolution.value();
+  if (current.extension_id != extension_id || current.kind != surface ||
+      current.policy_generation != policy_generation ||
+      current.primary_frame_id != primary_frame_id ||
+      current.web_contents.get() != dispatched_web_contents ||
+      !IsExtensionPrimaryFrame(dispatched_web_contents, dispatched_frame,
+                               extension_id) ||
+      dispatched_frame->GetGlobalId() != primary_frame_id) {
+    return AdmissionFailure(
+        PrometheusExtensionAdmissionDenial::kStalePolicy);
+  }
+  const ExtensionAgentGrant grant = policy_service_->GetEffectiveGrant(
+      extension_id, dispatched_web_contents->GetBrowserContext(),
+      current.private_mode);
+  PrometheusExtensionAdmissionEvidence evidence;
+  evidence.private_mode = current.private_mode;
+  evidence.private_policy_allowed =
+      !current.private_mode || grant != ExtensionAgentGrant::kBlocked;
+  const PrometheusExtensionAdmissionDecision admission =
+      EvaluateAdmissionForTesting(route_name, grant, evidence);
+  return admission.allowed ? AgentRouteResult::Success({})
+                           : AdmissionFailure(admission.denial);
+}
+
+AgentRouteResult PrometheusExtensionPageAdapter::ResolveRequestedPrimaryFrame(
+    content::WebContents* web_contents,
+    content::GlobalRenderFrameHostId expected_frame_id,
+    const AgentFrameTarget& frame_target,
+    content::RenderFrameHost** frame) const {
+  content::RenderFrameHost* primary_frame =
+      content::RenderFrameHost::FromID(expected_frame_id);
+  if (!web_contents || !frame || !primary_frame ||
+      web_contents->GetPrimaryMainFrame() != primary_frame ||
+      content::WebContents::FromRenderFrameHost(primary_frame) !=
+          web_contents) {
+    return AdmissionFailure(
+        PrometheusExtensionAdmissionDenial::kStalePolicy);
+  }
+  const bool has_process = frame_target.render_process_id.has_value();
+  const bool has_routing = frame_target.render_frame_routing_id.has_value();
+  if (has_process != has_routing) {
+    return InvalidPageInput(
+        "Explicit frame targets require both process and routing identifiers",
+        "Request a fresh extension snapshot and use its exact frame target");
+  }
+  if (has_process &&
+      (*frame_target.render_process_id !=
+           primary_frame->GetProcess()->GetDeprecatedID() ||
+       *frame_target.render_frame_routing_id !=
+           primary_frame->GetRoutingID())) {
+    return AdmissionFailure(
+        PrometheusExtensionAdmissionDenial::kStalePolicy);
+  }
+  if (frame_target.document_token.has_value()) {
+    const std::optional<std::string> live_document =
+        optimization_guide::DocumentIdentifierUserData::GetDocumentIdentifier(
+            primary_frame->GetGlobalFrameToken());
+    if (frame_target.document_token->empty() || !live_document.has_value() ||
+        *live_document != *frame_target.document_token) {
+      return AdmissionFailure(
+          PrometheusExtensionAdmissionDenial::kStalePolicy);
+    }
+  }
+  *frame = primary_frame;
+  return AgentRouteResult::Success({});
+}
+
+void PrometheusExtensionPageAdapter::OnInnerTextReady(
+    size_t max_chars,
+    SurfaceValidationCallback validation_callback,
+    content::GlobalRenderFrameHostId frame_id,
+    AuditedRouteCallback callback,
+    std::unique_ptr<content_extraction::InnerTextResult> inner_text_result) {
+  content::RenderFrameHost* frame = content::RenderFrameHost::FromID(frame_id);
+  content::WebContents* web_contents =
+      frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+  AgentRouteResult validation =
+      validation_callback.Run(web_contents, frame);
+  if (!validation.ok) {
+    std::move(callback).Run(std::move(validation));
+    return;
+  }
+  if (!inner_text_result) {
+    std::move(callback).Run(
+        AdmissionFailure(PrometheusExtensionAdmissionDenial::kStalePolicy));
+    return;
+  }
+  AgentPageResult page_result;
+  page_result.visible_text =
+      BoundString(std::move(inner_text_result->inner_text), max_chars,
+                  &page_result.truncated, &page_result.omitted_count);
+  AgentRouteResult result =
+      AgentRouteResult::Success({"visible_text_returned"});
+  result.page_result = std::move(page_result);
+  std::move(callback).Run(std::move(result));
+}
