+  ASSERT_EQ(1u, revoked_results.size());
+
+  ReadyActionViewer expired = CreateReadyActionViewer();
+  std::vector<SupervisionActionResult> expired_results;
+  service_->ExecuteDashboardAction(
+      expired.redemption.dashboard_session,
+      expired.stamp.document_epoch.ToString(), expired.stamp.sequence,
+      MakeNavigationAction("https://example.test/expire"),
