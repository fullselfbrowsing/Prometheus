diff --git a/chrome/browser/prometheus/prometheus_browser_main_extra_parts.cc b/chrome/browser/prometheus/prometheus_browser_main_extra_parts.cc
index fb0095e32a..2dd25e8ee3 100644
--- a/chrome/browser/prometheus/prometheus_browser_main_extra_parts.cc
+++ b/chrome/browser/prometheus/prometheus_browser_main_extra_parts.cc
@@ -438,6 +438,42 @@ class NativePrometheusSidePanelRuntime final
             exact_browser_.get(), selected_tab));
   }
 
+  base::DictValue EndSelectedTabSupervision() override {
+    if (ending_supervision_) {
+      return SupervisionOperationValue(SupervisionServiceResult::Failure(
+          SupervisionErrorCode::kControllerConflict,
+          "An end request is already running",
+          "Wait for the selected-tab state to refresh"));
+    }
+    tabs::TabInterface* selected_tab = ResolveSelectedTab();
+    PrometheusSupervisionProfileService* supervision_service =
+        ResolveSupervisionService();
+    if (!selected_tab || !supervision_service || !exact_browser_) {
+      return SupervisionOperationValue(SupervisionServiceResult::Failure(
+          SupervisionErrorCode::kStaleTarget,
+          "The selected supervision target is unavailable",
+          "Select the intended supervised tab in this window"));
+    }
+
+    ending_supervision_ = true;
+    PublishSnapshot();
+    selected_tab = ResolveSelectedTab();
+    supervision_service = ResolveSupervisionService();
+    SupervisionServiceResult result;
+    if (!selected_tab || !supervision_service || !exact_browser_) {
+      result = SupervisionServiceResult::Failure(
+          SupervisionErrorCode::kStaleTarget,
+          "The selected supervision target changed before end",
+          "Refresh the selected-tab supervision state");
+    } else {
+      result = supervision_service->EndSelectedTabSupervision(
+          exact_browser_.get(), selected_tab);
+    }
+    ending_supervision_ = false;
+    PublishSnapshot();
+    return SupervisionOperationValue(std::move(result));
+  }
+
   void HandleTargetLost() override {
     if (!principal_) {
       return;
diff --git a/chrome/browser/prometheus/prometheus_supervision_profile_service.cc b/chrome/browser/prometheus/prometheus_supervision_profile_service.cc
index 97df639cee..60ddb4624d 100644
--- a/chrome/browser/prometheus/prometheus_supervision_profile_service.cc
+++ b/chrome/browser/prometheus/prometheus_supervision_profile_service.cc
@@ -1270,6 +1270,66 @@ PrometheusSupervisionProfileService::OpenManagementForSelectedTab(
   return SupervisionServiceResult::Success();
 }
 
+SupervisionServiceResult
+PrometheusSupervisionProfileService::EndSelectedTabSupervision(
+    BrowserWindowInterface* exact_browser,
+    tabs::TabInterface* exact_tab) {
+  if (shutdown_) {
+    return UnavailableResult();
+  }
+  SweepExpired();
+  if (!IsEligibleTarget(profile_, exact_browser, exact_tab) ||
+      exact_browser->GetActiveTabInterface() != exact_tab) {
+    return ServiceFailure(
+        SupervisionErrorCode::kStaleTarget,
+        "The selected supervision target is no longer live",
+        "Select the intended supervised tab in this window and retry");
+  }
+
+  const int32_t stable_tab_id = exact_tab->GetHandle().raw_value();
+  std::vector<base::UnguessableToken> sessions;
+  for (const auto& [dashboard_session, viewer] : viewers_) {
+    if (viewer->stable_tab_id == stable_tab_id &&
+        viewer->exact_browser.get() == exact_browser &&
+        ResolveExactTarget(*viewer) == exact_tab) {
+      sessions.push_back(dashboard_session);
+    }
+  }
+  if (sessions.empty()) {
+    return ServiceFailure(SupervisionErrorCode::kUnknownSession,
+                          "No live supervision remains for this tab",
+                          "Refresh the selected-tab supervision state");
+  }
+
+  for (const base::UnguessableToken& dashboard_session : sessions) {
+    if (!RevalidateViewerOwner(dashboard_session)) {
+      return ServiceFailure(
+          SupervisionErrorCode::kViewOnly,
+          "Supervision ended because the Agent owner is no longer live",
+          "Create a new supervised session from the intended tab");
+    }
+  }
+  for (const base::UnguessableToken& dashboard_session : sessions) {
+    auto viewer = viewers_.find(dashboard_session);
+    if (viewer == viewers_.end() ||
+        viewer->second->stable_tab_id != stable_tab_id ||
+        viewer->second->exact_browser.get() != exact_browser ||
+        ResolveExactTarget(*viewer->second) != exact_tab) {
+      return ServiceFailure(
+          SupervisionErrorCode::kStaleTarget,
+          "The selected supervision authority changed before end",
+          "Refresh the selected-tab supervision state");
+    }
+  }
+  for (const base::UnguessableToken& dashboard_session : sessions) {
+    TerminateViewer(dashboard_session, SupervisionViewerState::kEnded,
+                    SupervisionTerminalReason::kNone,
+                    SupervisionAuditEvent::kControlStopped,
+                    SupervisionErrorCode::kNone);
+  }
+  return SupervisionServiceResult::Success();
+}
