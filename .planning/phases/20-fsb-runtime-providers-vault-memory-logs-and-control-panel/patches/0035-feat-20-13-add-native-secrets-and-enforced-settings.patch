+      exact_browser, PrometheusRuntimeDialogKind::kProviderSecretRemoval,
+      std::make_unique<ConfirmationDialog>(
+          u"Remove saved key",
+          u"Remove the saved key for " + base::UTF8ToUTF16(provider.label) +
+              u"? Tasks will use the next eligible fallback.",
+          u"Remove Key", u"Keep Saved Key", std::move(reply_callback)));
+}
