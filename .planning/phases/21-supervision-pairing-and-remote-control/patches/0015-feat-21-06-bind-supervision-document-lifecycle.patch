 #include "third_party/blink/renderer/platform/testing/unit_test_helpers.h"
 #include "third_party/blink/renderer/platform/testing/url_test_helpers.h"
@@ -211,6 +212,36 @@ TEST_F(PrometheusSupervisionDocumentSupplementTest,
   EXPECT_TRUE(host.signals().empty());
 }
 
+TEST_F(PrometheusSupervisionDocumentSupplementTest,
+       HostDisconnectAllowsReenable) {
+  RecordingHost old_host;
+  Enable(old_host);
+  old_host.Disconnect();
+  test::RunPendingTasks();
+
+  RecordingHost new_host;
+  Enable(new_host);
+  MutateAttribute("new-generation");
+  AdvanceDebounce();
+
+  EXPECT_TRUE(old_host.signals().empty());
+  ASSERT_EQ(new_host.signals().size(), 1u);
+  EXPECT_EQ(new_host.signals()[0], DirtySignal::kDirty);
+}
+
+TEST_F(PrometheusSupervisionDocumentSupplementTest,
+       GarbageCollectionPreservesEnabledSupplement) {
+  RecordingHost host;
+  Enable(host);
+
+  ThreadState::Current()->CollectAllGarbageForTesting();
+  MutateAttribute("after-gc");
+  AdvanceDebounce();
+
+  ASSERT_EQ(host.signals().size(), 1u);
+  EXPECT_EQ(host.signals()[0], DirtySignal::kDirty);
+}
+
 TEST_F(PrometheusSupervisionDocumentSupplementTest,
        DocumentReplacementDropsOldSignal) {
   RecordingHost old_host;
