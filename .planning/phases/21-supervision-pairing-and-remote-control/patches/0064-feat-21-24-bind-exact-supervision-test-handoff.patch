+std::optional<PrometheusAgentGateway::ExactSessionBindingForComposition>
+PrometheusAgentGateway::GetExactSessionBindingForComposition(
+    std::string_view session_id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  PruneSessionBindings();
+  const auto binding = session_bindings_.find(session_id);
+  if (session_id.empty() || binding == session_bindings_.end() ||
+      !binding->second.profile || !binding->second.browser ||
+      binding->second.stable_tab_id <= 0) {
+    return std::nullopt;
+  }
+  return ExactSessionBindingForComposition{
+      .profile = binding->second.profile,
+      .browser = binding->second.browser,
+      .stable_tab_id = binding->second.stable_tab_id,
+  };
+}
+
 void PrometheusAgentGateway::ShutdownSupervisionTestHandoffDispatcher() {
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
   supervision_test_handoff_enabled_.store(false);
