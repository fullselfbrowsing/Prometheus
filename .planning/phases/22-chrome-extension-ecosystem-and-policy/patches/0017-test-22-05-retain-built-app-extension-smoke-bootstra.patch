+#ifndef CHROME_BROWSER_PROMETHEUS_PROMETHEUS_EXTENSION_SMOKE_BOOTSTRAP_H_
+#define CHROME_BROWSER_PROMETHEUS_PROMETHEUS_EXTENSION_SMOKE_BOOTSTRAP_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+
+namespace prometheus {
+
+// Reuses kPrometheusRuntimeTestTypeSwitch / kPrometheusRuntimeTestType from
+// prometheus_runtime_test_bootstrap.h for the shared non-official
+// "--test-type=prometheus-runtime" launch gate.
+inline constexpr char kPrometheusExtensionSmokeBootstrapSwitch[] =
+    "prometheus-extension-smoke-bootstrap";
+inline constexpr size_t kMaxPrometheusExtensionSmokeBootstrapBytes = 4 * 1024;
+inline constexpr size_t kMaxPrometheusExtensionSmokeFixtureManifestBytes =
+    8 * 1024;
+inline constexpr size_t kPrometheusExtensionSmokeSha256HexLength = 64;
+
+enum class PrometheusExtensionSmokeBootstrapResult {
+  kApplied,
+  kNotRequested,
+  kOfficialBuildDenied,
+  kLaunchDenied,
+  kProfileDenied,
+  kFileDenied,
+  kPathDenied,
+  kReadDenied,
+  kJsonDenied,
+  kSchemaDenied,
+  kFixtureDenied,
+  kResultPathDenied,
+};
+
+struct PrometheusExtensionSmokeBootstrapProfileFacts {
+  bool is_regular_profile = false;
+  bool is_disposable_profile = false;
+  bool is_off_the_record = false;
+};
+
+struct PrometheusExtensionSmokeBootstrapFileFacts {
+  bool is_regular_file = false;
+  bool is_directory = false;
+  bool is_symbolic_link = false;
+  bool is_owned_by_current_user = false;
+  int posix_permissions = 0;
+  int64_t size = 0;
+};
+
+// Strict boundary for the owner-only 0600 launch-config file. Modeled on
+// PrometheusSupervisionTestBootstrapFileAccess.
+struct PrometheusExtensionSmokeBootstrapFileAccess {
+  using InspectCallback = base::RepeatingCallback<std::optional<
+      PrometheusExtensionSmokeBootstrapFileFacts>(const base::FilePath&)>;
+  using ReadCallback =
+      base::RepeatingCallback<std::optional<std::string>(const base::FilePath&,
+                                                          size_t max_bytes)>;
+
+  InspectCallback inspect;
+  ReadCallback read;
+};
+
+// More lenient boundary used only to inspect/hash the checked-in developer
+// workflow fixture's manifest.json (ordinary test data, never secret
+// config); still rejects symlinks and bounds the read size, but does not
+// require the strict 0600 owner-only mode.
+struct PrometheusExtensionSmokeFixtureAccess {
+  using InspectCallback = base::RepeatingCallback<std::optional<
+      PrometheusExtensionSmokeBootstrapFileFacts>(const base::FilePath&)>;
+  using ReadCallback =
+      base::RepeatingCallback<std::optional<std::string>(const base::FilePath&,
+                                                          size_t max_bytes)>;
+
+  InspectCallback inspect;
+  ReadCallback read;
+};
+
+// Validates and holds the closed launch-time configuration for the Phase 22
+// built-app extension lifecycle smoke: which fixture directory to load
+// unpacked, its expected manifest.json SHA-256, and where to write the
+// bounded stage/result record. Carries no dialog, pairing, or dispatcher
+// state of its own -- PrometheusExtensionSmokeController owns behavior.
+class PrometheusExtensionSmokeBootstrap {
+ public:
+  PrometheusExtensionSmokeBootstrap(const PrometheusExtensionSmokeBootstrap&) =
+      delete;
+  PrometheusExtensionSmokeBootstrap& operator=(
+      const PrometheusExtensionSmokeBootstrap&) = delete;
+  ~PrometheusExtensionSmokeBootstrap();
+
+  static PrometheusExtensionSmokeBootstrapResult Create(
+      const base::CommandLine& command_line,
+      bool is_official_build,
+      PrometheusExtensionSmokeBootstrapProfileFacts profile_facts,
+      const PrometheusExtensionSmokeBootstrapFileAccess& file_access,
+      const PrometheusExtensionSmokeFixtureAccess& fixture_access,
+      std::unique_ptr<PrometheusExtensionSmokeBootstrap>* bootstrap);
+
+  const base::FilePath& fixture_path() const { return fixture_path_; }
+  const std::string& fixture_sha256() const { return fixture_sha256_; }
+  const base::FilePath& result_path() const { return result_path_; }
+
+ private:
+  PrometheusExtensionSmokeBootstrap();
+
+  base::FilePath fixture_path_;
+  std::string fixture_sha256_;
+  base::FilePath result_path_;
+};
+
+// Returns the no-follow, mode-checked (0600) local file boundary the built
+// application uses for the strict launch-config file. Tests inject their own
+// deterministic access instead of touching production paths.
+PrometheusExtensionSmokeBootstrapFileAccess
+CreatePrometheusExtensionSmokeBootstrapFileAccess();
+
+// Returns the more lenient no-follow boundary used only to hash the
+// checked-in fixture manifest.
+PrometheusExtensionSmokeFixtureAccess
+CreatePrometheusExtensionSmokeFixtureAccess();
+
+}  // namespace prometheus
+
+#endif  // CHROME_BROWSER_PROMETHEUS_PROMETHEUS_EXTENSION_SMOKE_BOOTSTRAP_H_
