+std::optional<SupervisionActionAuthoritySnapshot>
+PrometheusSupervisionActionController::ValidateAuthority(
+    const base::UnguessableToken& dashboard_session,
+    std::string_view document_epoch,
+    uint64_t sequence,
+    const SupervisionActionAuthoritySnapshot* admitted_authority,
+    SupervisionErrorCode* error_code) const {
+  *error_code = SupervisionErrorCode::kStaleTarget;
+  if (dashboard_session != dashboard_session_) {
+    *error_code = SupervisionErrorCode::kUnknownSession;
+    return std::nullopt;
+  }
+  if (!exact_browser_ || exact_browser_->IsDeleteScheduled() ||
+      exact_browser_->GetProfile() != profile_ || !authority_resolver_) {
+    return std::nullopt;
+  }
+  std::optional<SupervisionActionAuthoritySnapshot> authority =
+      authority_resolver_.Run();
+  if (!authority.has_value() || authority->profile != profile_ ||
+      authority->exact_browser != exact_browser_.get() ||
+      authority->stable_tab != stable_tab_) {
+    return std::nullopt;
+  }
+  tabs::TabInterface* const tab = stable_tab_.Get();
+  if (!tab || tab->GetHandle() != stable_tab_ ||
+      tab->GetProfile() != profile_ ||
+      tab->GetBrowserWindowInterface() != exact_browser_.get()) {
+    return std::nullopt;
+  }
+  if (!authority->active_controller_session.has_value()) {
+    *error_code = SupervisionErrorCode::kViewOnly;
+    return std::nullopt;
+  }
+  if (*authority->active_controller_session != dashboard_session_) {
+    *error_code = SupervisionErrorCode::kControllerConflict;
+    return std::nullopt;
+  }
+  if (!authority->controller_lease.has_value() ||
+      authority->controller_lease->is_empty()) {
+    *error_code = SupervisionErrorCode::kViewOnly;
+    return std::nullopt;
+  }
+  if (immutable_owner_session_id_.empty() ||
+      authority->live_owner_session_id.empty() ||
+      authority->live_owner_session_id != immutable_owner_session_id_) {
+    *error_code = SupervisionErrorCode::kViewOnly;
+    return std::nullopt;
+  }
+  if (!authority->stream_live) {
+    *error_code = SupervisionErrorCode::kResyncRequired;
+    return std::nullopt;
+  }
+  if (authority->document_epoch.ToString() != document_epoch) {
+    *error_code = SupervisionErrorCode::kStaleEpoch;
+    return std::nullopt;
+  }
+  if (authority->sequence != sequence) {
+    *error_code = SupervisionErrorCode::kStaleSequence;
+    return std::nullopt;
+  }
+  if (admitted_authority) {
+    if (authority->document_epoch != admitted_authority->document_epoch) {
+      *error_code = SupervisionErrorCode::kStaleEpoch;
+      return std::nullopt;
+    }
+    if (authority->sequence != admitted_authority->sequence) {
+      *error_code = SupervisionErrorCode::kStaleSequence;
+      return std::nullopt;
+    }
+    if (authority->authority_generation !=
+            admitted_authority->authority_generation ||
+        authority->controller_lease !=
+            admitted_authority->controller_lease) {
+      return std::nullopt;
+    }
+  }
+  *error_code = SupervisionErrorCode::kNone;
+  return authority;
+}
+
+std::optional<AgentRouteRequest>
+PrometheusSupervisionActionController::BuildAgentRoute(
+    const SupervisionRemoteActionRequest& action) const {
+  if (Classify(action) == SupervisionActionClassification::kRejected ||
+      !exact_browser_) {
+    return std::nullopt;
+  }
+  AgentRouteRequest request;
+  request.route_name = RouteForCategory(action.category);
+  request.session_id = immutable_owner_session_id_;
+  request.target.browser_session_id = exact_browser_->GetSessionID().id();
+  request.target.window_session_id = exact_browser_->GetSessionID().id();
+  request.target.tab_handle = stable_tab_;
+
+  if (action.category == SupervisionRemoteActionCategory::kNavigate) {
+    request.url = GURL(*action.navigation);
+    return request;
+  }
+  if (!frame_resolver_) {
+    return std::nullopt;
+  }
+  std::optional<AgentFrameTarget> frame =
+      frame_resolver_.Run(exact_browser_.get(), stable_tab_, action);
+  if (!frame.has_value() || !frame->document_token.has_value() ||
+      frame->document_token->empty() ||
+      !frame->render_process_id.has_value() ||
+      !frame->render_frame_routing_id.has_value() ||
+      !RefMatchesDocument(action.element_ref, *frame->document_token) ||
+      !RefMatchesDocument(action.target_element_ref, *frame->document_token)) {
+    return std::nullopt;
+  }
+
+  AgentPageRequest page;
+  page.frame = *frame;
+  page.action.frame = *frame;
+  page.action.element.element_ref = action.element_ref;
+  page.action.text = action.text;
+  page.action.key = action.key;
+  page.action.option_value = action.option;
+  page.action.scroll_delta_x = action.scroll_delta_x;
+  page.action.scroll_delta_y = action.scroll_delta_y;
+  page.verify_mutation = true;
+  request.page_request = std::move(page);
+  return request;
+}
