+TEST_F(PrometheusSupervisionProfileServiceTest,
+       HubDashboardBaselineDiffAndAckStayConsumerLocal) {
+  SupervisionPairingCreationResult first = CreatePairing();
+  ASSERT_TRUE(first.ok);
+  SupervisionRedemptionResult viewer_a = Redeem(first, "Viewer A");
+  ASSERT_TRUE(viewer_a.ok);
+  SupervisionPairingCreationResult second = CreatePairing();
+  ASSERT_TRUE(second.ok);
+  SupervisionRedemptionResult viewer_b = Redeem(second, "Viewer B");
+  ASSERT_TRUE(viewer_b.ok);
+  ASSERT_EQ(1u, capture_source_.pending_count());
+
+  capture_source_.CompleteNext(MakeServiceBaseline("shared baseline"));
+  SupervisionDashboardBaselineResult baseline_a =
+      service_->ReadDashboardBaseline(viewer_a.dashboard_session);
+  SupervisionDashboardBaselineResult baseline_b =
+      service_->ReadDashboardBaseline(viewer_b.dashboard_session);
+  ASSERT_TRUE(baseline_a.ok);
+  ASSERT_TRUE(baseline_b.ok);
+  ASSERT_TRUE(baseline_a.delivery.has_value());
+  ASSERT_TRUE(baseline_b.delivery.has_value());
+  EXPECT_EQ(baseline_a.delivery->baseline, baseline_b.delivery->baseline);
+  EXPECT_NE(baseline_a.delivery->stamp.session,
+            baseline_b.delivery->stamp.session);
+  ASSERT_TRUE(
+      service_
+          ->AckDashboard(viewer_a.dashboard_session, baseline_a.delivery->stamp)
+          .ok);
+  ASSERT_TRUE(
+      service_
+          ->AckDashboard(viewer_b.dashboard_session, baseline_b.delivery->stamp)
+          .ok);
+
+  PrometheusSupervisionCaptureHub* hub =
+      service_->capture_hub_for_testing(first.stable_tab_id);
+  ASSERT_NE(nullptr, hub);
+  hub->NotifyDirtyForTesting(/*overflow=*/false);
+  capture_source_.CompleteNext(MakeServiceBaseline("shared mutation"));
+  SupervisionDashboardDiffResult diff_a =
+      service_->ReadDashboardDiff(viewer_a.dashboard_session);
+  SupervisionDashboardDiffResult diff_b =
+      service_->ReadDashboardDiff(viewer_b.dashboard_session);
+  ASSERT_TRUE(diff_a.ok);
+  ASSERT_TRUE(diff_b.ok);
+  ASSERT_TRUE(diff_a.delivery.has_value());
+  ASSERT_TRUE(diff_b.delivery.has_value());
+  EXPECT_EQ(diff_a.delivery->diff, diff_b.delivery->diff);
+  ASSERT_TRUE(
+      service_->AckDashboard(viewer_a.dashboard_session, diff_a.delivery->stamp)
+          .ok);
+  EXPECT_FALSE(service_->ReadDashboardDiff(viewer_a.dashboard_session)
+                   .delivery.has_value());
+  SupervisionDashboardDiffResult unread_b =
+      service_->ReadDashboardDiff(viewer_b.dashboard_session);
+  ASSERT_TRUE(unread_b.ok);
+  ASSERT_TRUE(unread_b.delivery.has_value());
+  EXPECT_EQ(diff_b.delivery->stamp.sequence, unread_b.delivery->stamp.sequence);
+}
