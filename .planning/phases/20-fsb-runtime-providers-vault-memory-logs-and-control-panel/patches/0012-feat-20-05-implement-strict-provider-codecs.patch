+      return ModelListError(ProviderModelListState::kInvalidOutput);
+    }
+    bool supports_generation = false;
+    for (const base::Value& method : *methods) {
+      if (!method.is_string()) {
+        return ModelListError(ProviderModelListState::kInvalidOutput);
+      }
+      supports_generation |= method.GetString() == "generateContent";
+    }
+    if (!supports_generation) {
