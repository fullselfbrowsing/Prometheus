+IN_PROC_BROWSER_TEST_F(
+    PrometheusAgentGatewayBrowserTest,
+    RuntimePolicyCapsOnlyNewSessionsAndPreservesExistingRuntimeAccess) {
+  Profile* const profile = browser()->profile();
+  PrometheusRuntimeProfileService* const runtime =
+      PrometheusRuntimeProfileServiceFactory::GetForProfile(profile);
+  PrometheusAgentProfileService* const agent_service =
+      PrometheusAgentProfileServiceFactory::GetForProfile(profile);
+  ASSERT_TRUE(runtime);
+  ASSERT_TRUE(agent_service);
+
+  RuntimePolicy policy = runtime->effective_policy_for_testing();
+  policy.max_active_agents = 3;
+  ASSERT_EQ(RuntimeProfileStatus::kOk,
+            runtime->SetRuntimePolicyForControlUi(
+                RuntimeCallerOrigin::kLocalControlUi, policy));
+
+  std::vector<std::string> session_ids;
+  for (size_t index = 0; index < 3; ++index) {
+    HttpResult created = Authorized(
+        "POST", "/v1/session/create",
+        "{\"display_label\":\"Agent " + std::to_string(index) + "\"}");
+    ASSERT_EQ(200, created.status) << index;
+    std::string session_id = ExtractSessionId(created);
+    ASSERT_FALSE(session_id.empty()) << index;
+    session_ids.push_back(std::move(session_id));
+  }
+  EXPECT_EQ(3u, agent_service->ActiveSessionCount());
+
+  HttpResult at_cap =
+      Authorized("POST", "/v1/session/create", R"({"display_label":"At cap"})");
+  ASSERT_EQ(200, at_cap.status);
+  std::optional<base::DictValue> at_cap_body =
+      base::JSONReader::ReadDict(at_cap.body, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(at_cap_body);
+  EXPECT_FALSE(at_cap_body->FindBool("ok").value_or(true));
+  const std::string* const at_cap_code = at_cap_body->FindString("error_code");
+  ASSERT_TRUE(at_cap_code);
+  EXPECT_EQ("AGENT_CAP_REACHED", *at_cap_code);
+
+  policy.max_active_agents = 2;
+  ASSERT_EQ(RuntimeProfileStatus::kOk,
+            runtime->SetRuntimePolicyForControlUi(
+                RuntimeCallerOrigin::kLocalControlUi, policy));
+  EXPECT_EQ(3u, agent_service->ActiveSessionCount());
+
+  HttpResult existing_runtime = Authorized(
+      "POST", "/v1/agent/command",
+      "{\"route\":\"run_task\",\"session_id\":\"" + session_ids.back() +
+          "\",\"params\":{\"prompt\":\"Existing session remains "
+          "authorized\",\"requested_execution\":\"auto\"}}");
+  ASSERT_EQ(200, existing_runtime.status);
+  std::optional<base::DictValue> existing_runtime_body =
+      base::JSONReader::ReadDict(existing_runtime.body, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(existing_runtime_body);
+  EXPECT_FALSE(existing_runtime_body->FindBool("ok").value_or(true));
+  const std::string* const existing_runtime_code =
+      existing_runtime_body->FindString("error_code");
+  ASSERT_TRUE(existing_runtime_code);
+  EXPECT_EQ("CAPABILITY_NOT_READY", *existing_runtime_code);
+
+  ASSERT_EQ(200, Authorized("POST", "/v1/session/close",
+                            "{\"session_id\":\"" + session_ids[0] + "\"}")
+                     .status);
+  EXPECT_EQ(2u, agent_service->ActiveSessionCount());
+  HttpResult still_capped = Authorized("POST", "/v1/session/create",
+                                       R"({"display_label":"Still capped"})");
+  std::optional<base::DictValue> still_capped_body =
+      base::JSONReader::ReadDict(still_capped.body, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(still_capped_body);
+  const std::string* const still_capped_code =
+      still_capped_body->FindString("error_code");
+  ASSERT_TRUE(still_capped_code);
+  EXPECT_EQ("AGENT_CAP_REACHED", *still_capped_code);
+
+  ASSERT_EQ(200, Authorized("POST", "/v1/session/close",
+                            "{\"session_id\":\"" + session_ids[1] + "\"}")
+                     .status);
+  EXPECT_EQ(1u, agent_service->ActiveSessionCount());
+  HttpResult replacement = Authorized("POST", "/v1/session/create",
+                                      R"({"display_label":"Replacement"})");
+  EXPECT_FALSE(ExtractSessionId(replacement).empty());
+  EXPECT_EQ(2u, agent_service->ActiveSessionCount());
+}
