+TEST(PrometheusProviderCodecTest,
+     ValidatesToolArgumentsAgainstExactAdvertisedClosedSchema) {
+  ProviderTurnRequest request =
+      MakeTurnRequest(PrometheusProviderFamily::kOpenAICompatible, true);
+  request.tools.clear();
+  request.tools.push_back(MakeStructuredTool());
+
+  for (
+      std::string invalid : {
+          R"json({})json",
+          R"json({"options":{"label":"four","attempts":2}})json",
+          R"json({"options":{"label":"four","attempts":2,"enabled":true,"extra":"value"}})json",
+          R"json({"options":{"label":4,"attempts":2,"enabled":true}})json",
+          R"json({"options":{"label":"four","attempts":"2","enabled":true}})json",
+          R"json({"options":{"label":"four","attempts":2,"enabled":"true"}})json",
+      }) {
+    EXPECT_EQ(
+        ParseOpenAIResponsesToolArguments(request, std::move(invalid)).failure,
+        ProviderFailureKind::kInvalidOutput);
+  }
+
+  EXPECT_EQ(
+      ParseOpenAIResponsesToolArguments(
+          request,
+          R"json({"options":{"label":"fives","attempts":2,"enabled":true}})json")
+          .failure,
+      ProviderFailureKind::kBounds);
+  EXPECT_EQ(
+      ParseOpenAIResponsesToolArguments(
+          request,
+          R"json({"options":{"label":"four","attempts":3,"enabled":true}})json")
+          .failure,
+      ProviderFailureKind::kBounds);
+
+  ProviderTurnResult minimum_boundary = ParseOpenAIResponsesToolArguments(
+      request,
+      R"json({"options":{"label":"x","attempts":0,"enabled":false}})json");
+  ASSERT_TRUE(minimum_boundary.ok());
+  ASSERT_TRUE(minimum_boundary.tool_call);
+  ProviderTurnResult maximum_boundary = ParseOpenAIResponsesToolArguments(
+      request,
+      R"json({"options":{"label":"four","attempts":2,"enabled":true}})json");
+  ASSERT_TRUE(maximum_boundary.ok());
+  ASSERT_TRUE(maximum_boundary.tool_call);
+}
