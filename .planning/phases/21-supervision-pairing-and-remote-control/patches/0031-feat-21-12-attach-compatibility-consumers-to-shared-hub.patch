+template <typename HubNode>
+AgentSupervisionNode MakeAgentSupervisionNode(const HubNode& node) {
+  AgentSupervisionNode result;
+  result.ref = node.ref;
+  result.parent_ref = node.parent_ref;
+  result.child_refs = node.child_refs;
+  result.tag = node.tag;
+  result.role = node.role;
+  result.name = node.name;
+  result.text_snippet = node.text_snippet;
+  result.disabled = node.disabled;
+  result.focusable = node.focusable;
+  result.clickable = node.clickable;
+  result.input_value = node.input_value;
+  result.input_type = node.input_type;
+  result.checked = node.checked;
+  result.required = node.required;
+  result.readonly = node.readonly;
+  result.frame_restricted = node.frame_restricted;
+  result.frame_restricted_reason = node.frame_restricted_reason;
+  return result;
+}
+
+template <typename HubOperation>
+AgentSupervisionDiffOperation MakeAgentSupervisionOperation(
+    const HubOperation& operation) {
+  AgentSupervisionDiffOperation result;
+  switch (operation.type) {
+    case SupervisionDiffOperationType::kInsertSubtree:
+      result.type = AgentSupervisionDiffOperationType::kInsertSubtree;
+      break;
+    case SupervisionDiffOperationType::kRemove:
+      result.type = AgentSupervisionDiffOperationType::kRemove;
+      break;
+    case SupervisionDiffOperationType::kReplaceFields:
+      result.type = AgentSupervisionDiffOperationType::kReplaceFields;
+      break;
+    case SupervisionDiffOperationType::kReorderChildren:
+      result.type = AgentSupervisionDiffOperationType::kReorderChildren;
+      break;
+  }
+  result.ref = operation.ref;
+  result.parent_ref = operation.parent_ref;
+  result.index = operation.index;
+  result.subtree.reserve(operation.subtree.size());
+  for (const auto& node : operation.subtree) {
+    result.subtree.push_back(MakeAgentSupervisionNode(node));
+  }
+  if (operation.replacement.has_value()) {
+    result.replacement = MakeAgentSupervisionNode(*operation.replacement);
+  }
+  result.child_order = operation.child_order;
+  return result;
+}
+
+AgentRouteResult MakeCompatibilityBaselineResult(
+    AgentRouteName route_name,
+    const SupervisionCaptureBaselineDelivery& delivery) {
+  AgentSupervisionBaselineResult payload;
+  payload.nodes.reserve(delivery.baseline.nodes.size());
+  for (const auto& node : delivery.baseline.nodes) {
+    payload.nodes.push_back(MakeAgentSupervisionNode(node));
+  }
+  return AgentRouteResult::SupervisionSuccess(route_name, std::move(payload));
+}
+
+AgentRouteResult MakeCompatibilityDiffResult(
+    const SupervisionCaptureDiffDelivery& delivery) {
+  AgentSupervisionDiffResult payload;
+  payload.operations.reserve(delivery.diff.operations.size());
+  for (const auto& operation : delivery.diff.operations) {
+    payload.operations.push_back(MakeAgentSupervisionOperation(operation));
+  }
+  return AgentRouteResult::SupervisionSuccess(
+      AgentRouteName::kGetSupervisionDiff, std::move(payload));
+}
+
+AgentRouteResult PreflightCompatibilityResult(AgentRouteResult result) {
+  auto serialized = SerializeAgentTransportResult(result);
+  if (!serialized.has_value()) {
+    return std::move(serialized.error());
+  }
+  return result;
+}
+
+AgentRouteResult CompatibilityStale(std::string message) {
+  return AgentRouteResult::Failure(
+      AgentErrorCode::kStaleTarget, std::move(message),
+      "Start supervision again from the live Agent-owned tab");
+}
+
+AgentRouteResult CompatibilityNeedsSnapshot() {
+  return AgentRouteResult::Failure(
+      AgentErrorCode::kStaleTarget,
+      "The supervision stream requires a current safe baseline",
+      "Call get_supervision_snapshot before requesting another diff");
+}
+
+AgentRouteResult CompatibilityOwnerMismatch() {
+  return AgentRouteResult::Failure(
+      AgentErrorCode::kTabNotOwned,
+      "The exact supervision tab is not owned by this Agent session",
+      "Use the Agent session that currently owns the exact tab");
+}
