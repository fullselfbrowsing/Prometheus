+TEST_F(PrometheusSupervisionProfileServiceTest,
+       HubViewerExpiryRevokeAndEndDetachExactlyOnce) {
+  SupervisionLimits limits;
+  limits.viewer_ttl_ms = base::Minutes(2).InMilliseconds();
+  ResetService(SupervisionProfileKind::kRegular, limits);
+  SupervisionPairingCreationResult first = CreatePairing();
+  ASSERT_TRUE(first.ok);
+  SupervisionRedemptionResult expiring = Redeem(first, "Expiring");
+  ASSERT_TRUE(expiring.ok);
+  now_ += base::Minutes(1);
+  SupervisionPairingCreationResult second = CreatePairing();
+  ASSERT_TRUE(second.ok);
+  SupervisionRedemptionResult surviving = Redeem(second, "Surviving");
+  ASSERT_TRUE(surviving.ok);
+  ASSERT_EQ(2u,
+            service_->capture_consumer_count_for_testing(first.stable_tab_id));
+
+  now_ += base::Seconds(90);
+  service_->GetSanitizedSnapshot(first.stable_tab_id);
+  EXPECT_EQ(1u, service_->viewer_count_for_testing(first.stable_tab_id));
+  EXPECT_EQ(1u,
+            service_->capture_consumer_count_for_testing(first.stable_tab_id));
+  EXPECT_FALSE(service_->EndSession(expiring.dashboard_session).ok);
+  EXPECT_EQ(1u,
+            service_->capture_consumer_count_for_testing(first.stable_tab_id));
+  EXPECT_TRUE(service_->RevokeSession(surviving.dashboard_session).ok);
+  EXPECT_EQ(0u, service_->capture_hub_count_for_testing());
+  EXPECT_EQ(1u, service_->released_capture_disable_count_for_testing());
+  EXPECT_FALSE(service_->RevokeSession(surviving.dashboard_session).ok);
+  EXPECT_EQ(1u, service_->released_capture_disable_count_for_testing());
+}
