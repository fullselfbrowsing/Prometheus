+std::vector<std::string> AgentSessionRegistry::CloseAllSessions() {
+  std::vector<std::string> closed_ids;
+  closed_ids.reserve(sessions_.size());
+  for (const auto& [session_id, session] : sessions_) {
+    if (session.active) {
+      closed_ids.push_back(session_id);
+    }
+  }
+  sessions_.clear();
+  return closed_ids;
+}
