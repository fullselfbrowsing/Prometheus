 .../frame/prometheus_compact_chrome_layout.h  | 24 +++++++++
 4 files changed, 107 insertions(+)
 create mode 100644 chrome/browser/ui/views/frame/prometheus_compact_chrome_layout.cc
 create mode 100644 chrome/browser/ui/views/frame/prometheus_compact_chrome_layout.h

