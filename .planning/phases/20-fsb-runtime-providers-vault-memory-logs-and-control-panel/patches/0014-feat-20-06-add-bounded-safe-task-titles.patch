+TEST_F(PrometheusRuntimeTypesTest, SafeTitleRedactsEveryClass) {
+  constexpr std::array<std::string_view, 10> kSensitivePrompts = {
+      "Visit https://private.example/path?q=alpha",
+      "Email private.person@example.com",
+      "Use account 123456789",
+      "Set workspace=private-value",
+      "Use SECRET=private-value",
