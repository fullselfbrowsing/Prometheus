+  using NativeEntryDelegate = base::RepeatingCallback<void(
+      const PrometheusVaultMetadata&,
+      bool,
+      NativeEntryReplyCallback)>;
+  using NativeConfirmationReply = base::RepeatingCallback<void(bool)>;
+  using NativeConfirmationDelegate = base::RepeatingCallback<void(
+      const PrometheusVaultConfirmationBinding&,
+      NativeConfirmationReply)>;
+  using TargetInspector =
+      PrometheusAgentService::ConfirmedVaultTargetInspector;
+  using InsertionDelegate = base::RepeatingCallback<void(
+      BrowserWindowInterface*,
+      ConfirmedVaultInsertionRequest,
+      PrometheusAgentService::ConfirmedVaultCallback)>;
+  using UseCallback = base::OnceCallback<void(PrometheusVaultUseResult)>;
+
+  PrometheusVaultService(Profile* profile,
+                         PrometheusSecretStore* secret_store,
+                         PrometheusAgentProfileService* agent_profile_service);
+  PrometheusVaultService(const PrometheusVaultService&) = delete;
+  PrometheusVaultService& operator=(const PrometheusVaultService&) = delete;
+  ~PrometheusVaultService();
+
+  PrometheusVaultMetadataResult CreateMetadata(
+      std::string label,
+      PrometheusVaultKind kind,
+      std::string canonical_site_origin);
+  PrometheusVaultMetadataResult GetMetadata(std::string_view entry_id) const;
+  PrometheusVaultMetadataResult UpdateMetadata(
+      std::string_view entry_id,
