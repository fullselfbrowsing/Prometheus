   }
-  HandleNativeRequest(path, body, std::move(callback));
+  HandleNativeRequest(path, body, SupervisionGatewayCancellationToken{request_id},
+                      std::move(callback));
+}
+
+void PrometheusAgentGateway::OnSupervisionRequestCompleted(
+    SupervisionGatewayCancellationToken cancellation,
+    SupervisionGatewayResult result) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto pending = pending_supervision_requests_.find(cancellation.value);
+  if (pending == pending_supervision_requests_.end()) {
+    return;
+  }
+  PendingSupervisionRequest request = std::move(pending->second);
+  pending_supervision_requests_.erase(pending);
+  if (result.transport.operation != request.operation) {
+    result.transport = SupervisionTransportResult::TransportFailure(
+        request.operation, SupervisionTransportErrorCode::kInternal,
+        "The supervision dispatcher returned a mismatched operation",
+        "Refresh supervision state and retry");
+  }
+  std::move(request.callback)
+      .Run(net::HTTP_OK, SerializeSupervisionResponse(result.transport));
+}
+
+void PrometheusAgentGateway::CancelOutstandingSupervisionRequests(
+    bool complete_unavailable) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  std::map<uint64_t, PendingSupervisionRequest> pending =
+      std::move(pending_supervision_requests_);
+  pending_supervision_requests_.clear();
+  for (auto& [token, request] : pending) {
+    if (supervision_dispatcher_) {
+      supervision_dispatcher_->cancel.Run(
+          SupervisionGatewayCancellationToken{token});
+    }
+    if (complete_unavailable) {
+      std::move(request.callback)
+          .Run(net::HTTP_OK,
+               SerializeSupervisionResponse(
+                   SupervisionUnavailable(request.operation)));
+    }
+  }
+}
+
+void PrometheusAgentGateway::ShutdownSupervisionDispatcher(
+    bool complete_unavailable) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CancelOutstandingSupervisionRequests(complete_unavailable);
+  if (supervision_dispatcher_) {
+    supervision_dispatcher_->shutdown.Run();
+    supervision_dispatcher_.reset();
+  }
 }
 
