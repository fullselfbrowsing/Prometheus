+class PrometheusTabCommandsBrowserTest : public InProcessBrowserTest {
+ public:
+  TabStripModel* tab_strip_model() { return browser()->tab_strip_model(); }
+
+  void AddTabsUntil(int tab_count) {
+    while (tab_strip_model()->count() < tab_count) {
+      chrome::AddTabAt(browser(), GURL("about:blank"), -1,
+                       /*foreground=*/false);
+    }
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(PrometheusTabCommandsBrowserTest,
+                       DuplicateIncreasesTabCount) {
+  AddTabsUntil(3);
+  const int original_tab_count = tab_strip_model()->count();
+
+  EXPECT_TRUE(ExecutePrometheusTabCommand(
+      browser(), PrometheusTabCommand::kDuplicate, /*tab_index=*/1));
+
+  EXPECT_EQ(original_tab_count + 1, tab_strip_model()->count());
+}
+
+IN_PROC_BROWSER_TEST_F(PrometheusTabCommandsBrowserTest,
+                       MoveToNewWindowCreatesBrowserWhenSupported) {
+  AddTabsUntil(3);
+  const size_t original_browser_count =
+      GlobalBrowserCollection::GetInstance()->GetSize();
+  const int original_tab_count = tab_strip_model()->count();
+
+  ui_test_utils::BrowserCreatedObserver browser_created_observer;
+  EXPECT_TRUE(ExecutePrometheusTabCommand(
+      browser(), PrometheusTabCommand::kMoveToNewWindow, /*tab_index=*/1));
+  Browser* const new_browser = browser_created_observer.Wait();
+  ui_test_utils::WaitUntilBrowserBecomeActive(new_browser);
+
+  EXPECT_NE(new_browser, browser());
+  EXPECT_EQ(original_browser_count + 1,
+            GlobalBrowserCollection::GetInstance()->GetSize());
+  EXPECT_EQ(original_tab_count - 1, tab_strip_model()->count());
+  EXPECT_EQ(1, new_browser->tab_strip_model()->count());
+}
+
+IN_PROC_BROWSER_TEST_F(PrometheusTabCommandsBrowserTest,
+                       AddToNewGroupCreatesGroup) {
+  AddTabsUntil(3);
+  ASSERT_EQ(0u, tab_strip_model()->group_model()->ListTabGroups().size());
+  ASSERT_FALSE(tab_strip_model()->GetTabGroupForTab(1).has_value());
+
+  EXPECT_TRUE(ExecutePrometheusTabCommand(
+      browser(), PrometheusTabCommand::kAddToNewGroup, /*tab_index=*/1));
+
+  EXPECT_TRUE(tab_strip_model()->GetTabGroupForTab(1).has_value());
+  EXPECT_EQ(1u, tab_strip_model()->group_model()->ListTabGroups().size());
+}
+
+IN_PROC_BROWSER_TEST_F(PrometheusTabCommandsBrowserTest,
+                       UnsupportedUnloadReturnsFalse) {
+  AddTabsUntil(3);
+  const int original_tab_count = tab_strip_model()->count();
+
+  EXPECT_FALSE(ExecutePrometheusTabCommand(
+      browser(), PrometheusTabCommand::kUnloadOrDiscard, /*tab_index=*/1));
+
+  EXPECT_EQ(original_tab_count, tab_strip_model()->count());
+}
+
+class PrometheusCompactTabSearchBrowserTest : public InProcessBrowserTest {
+ public:
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+
+  HorizontalTabStripRegionView* tab_strip_region_view() {
+    return views::AsViewClass<HorizontalTabStripRegionView>(
+        browser_view()->tab_strip_view());
+  }
+
+  TabSearchBubbleHost* tab_search_bubble_host() {
+    return browser_view()->GetTabSearchBubbleHost();
+  }
+
+  WebUIBubbleManager* bubble_manager() {
+    return tab_search_bubble_host()->webui_bubble_manager_for_testing();
+  }
+
+  void RunUntilBubbleWidgetDestroyed() {
+    ASSERT_NE(nullptr, bubble_manager()->GetBubbleWidget());
+    base::RunLoop run_loop;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, run_loop.QuitClosure());
+    run_loop.Run();
+    ASSERT_EQ(nullptr, bubble_manager()->GetBubbleWidget());
+  }
+
+  void SetPrometheusMode(PrometheusChromeMode mode) {
+    SetPrometheusChromeMode(*browser()->profile()->GetPrefs(), mode);
+    RunScheduledLayouts();
+  }
+
+  void ResizeBrowserTo(int width, int height) {
+    browser_view()->GetWidget()->SetBounds(gfx::Rect(0, 0, width, height));
+    browser_view()->GetWidget()->LayoutRootViewIfNecessary();
+    RunScheduledLayouts();
+  }
+
+  void AddBackgroundTabs(int count) {
+    for (int i = 0; i < count; ++i) {
+      chrome::AddTabAt(browser(), GURL("about:blank"), -1,
+                       /*foreground=*/false);
+    }
+    RunScheduledLayouts();
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(PrometheusCompactTabSearchBrowserTest,
+                       PrometheusTabSearchBubbleOpensFromCompactChrome) {
+  SetPrometheusMode(PrometheusChromeMode::kCompact);
+  ResizeBrowserTo(800, 900);
+  AddBackgroundTabs(12);
+
+  ASSERT_TRUE(tab_strip_region_view());
+  ASSERT_TRUE(tab_strip_region_view()->GetVisible());
+  ASSERT_TRUE(tab_strip_region_view()->GetTabSearchButton());
+  ASSERT_EQ(nullptr, bubble_manager()->GetBubbleWidget());
+
+  EXPECT_TRUE(tab_search_bubble_host()->ShowTabSearchBubble());
+  ASSERT_NE(nullptr, bubble_manager()->GetBubbleWidget());
+
+  bubble_manager()->bubble_view_for_testing()->ShowUI();
+  EXPECT_TRUE(bubble_manager()->GetBubbleWidget()->IsVisible());
+
+  tab_search_bubble_host()->CloseTabSearchBubble();
+  ASSERT_TRUE(bubble_manager()->GetBubbleWidget()->IsClosed());
+  RunUntilBubbleWidgetDestroyed();
+}
