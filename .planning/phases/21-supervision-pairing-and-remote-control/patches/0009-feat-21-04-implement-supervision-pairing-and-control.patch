+tabs::TabInterface* PrometheusSupervisionProfileService::ResolveExactTarget(
+    const PendingPairing& pairing) const {
+  auto observed = observed_tabs_.find(pairing.stable_tab_id);
+  if (observed == observed_tabs_.end() || !observed->second->lease.data() ||
+      observed->second->tab != pairing.tab || !pairing.exact_browser ||
+      !IsEligibleTarget(profile_, pairing.exact_browser.get(), pairing.tab)) {
+    return nullptr;
+  }
+  return pairing.tab;
+}
