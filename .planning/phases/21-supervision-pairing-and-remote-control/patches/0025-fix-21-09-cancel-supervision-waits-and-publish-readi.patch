+IN_PROC_BROWSER_TEST_F(
+    PrometheusAgentGatewayBrowserTest,
+    SupervisionTimeoutDisconnectAndUnbindCancelPendingDiffExactlyOnce) {
+  hold_supervision_requests_ = true;
+  gateway_->SetRequestTimeoutForTesting(base::Milliseconds(25));
+
+  RawHttpClient timed_out(gateway_->endpoint_for_testing());
+  timed_out.Send(MakeRequest("POST", "/v1/supervision",
+                             gateway_->port_for_testing(),
+                             gateway_->bearer_for_testing(),
+                             kSupervisionRequests[2]));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return supervision_requests_.size() == 1u; }));
+  EXPECT_EQ(504, timed_out.ReadResponse().status);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return supervision_cancellations_.size() == 1u; }));
+  EXPECT_EQ(supervision_requests_[0].cancellation_token,
+            supervision_cancellations_[0]);
+  std::move(held_supervision_callbacks_[0])
+      .Run(SupervisionGatewayResult{
+          .transport = SupervisionTransportResult::Success(
+              SupervisionTransportOperation::kDiff)});
+  EXPECT_EQ(1u, supervision_cancellations_.size());
+
+  gateway_->SetRequestTimeoutForTesting(base::Seconds(30));
+  RawHttpClient disconnected(gateway_->endpoint_for_testing());
+  disconnected.Send(MakeRequest("POST", "/v1/supervision",
+                                 gateway_->port_for_testing(),
+                                 gateway_->bearer_for_testing(),
+                                 kSupervisionRequests[2]));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return supervision_requests_.size() == 2u; }));
+  disconnected.Disconnect();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return supervision_cancellations_.size() == 2u; }));
+  EXPECT_EQ(supervision_requests_[1].cancellation_token,
+            supervision_cancellations_[1]);
+  std::move(held_supervision_callbacks_[1])
+      .Run(SupervisionGatewayResult{
+          .transport = SupervisionTransportResult::Success(
+              SupervisionTransportOperation::kDiff)});
+  EXPECT_EQ(2u, supervision_cancellations_.size());
+
+  RawHttpClient unbound(gateway_->endpoint_for_testing());
+  unbound.Send(MakeRequest("POST", "/v1/supervision",
+                           gateway_->port_for_testing(),
+                           gateway_->bearer_for_testing(),
+                           kSupervisionRequests[2]));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return supervision_requests_.size() == 3u; }));
+  gateway_->SetSupervisionGatewayDispatcher({});
+  HttpResult unavailable = unbound.ReadResponse();
+  EXPECT_EQ(200, unavailable.status);
+  EXPECT_NE(std::string::npos, unavailable.body.find("UNAVAILABLE"));
+  ASSERT_EQ(3u, supervision_cancellations_.size());
+  EXPECT_EQ(supervision_requests_[2].cancellation_token,
+            supervision_cancellations_[2]);
+  EXPECT_EQ(1u, supervision_shutdowns_);
+  std::move(held_supervision_callbacks_[2])
+      .Run(SupervisionGatewayResult{
+          .transport = SupervisionTransportResult::Success(
+              SupervisionTransportOperation::kDiff)});
+  EXPECT_EQ(3u, supervision_cancellations_.size());
+}
