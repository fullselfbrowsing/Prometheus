     ":prometheus_runtime_transport_codec",
diff --git a/chrome/browser/prometheus/prometheus_agent_gateway.cc b/chrome/browser/prometheus/prometheus_agent_gateway.cc
index bae6b336c4..89bcf34ea4 100644
--- a/chrome/browser/prometheus/prometheus_agent_gateway.cc
+++ b/chrome/browser/prometheus/prometheus_agent_gateway.cc
@@ -36,6 +36,8 @@
 #include "chrome/browser/prometheus/prometheus_agent_profile_service_factory.h"
 #include "chrome/browser/prometheus/prometheus_agent_transport_codec.h"
 #include "chrome/browser/prometheus/prometheus_endpoint_descriptor.h"
+#include "chrome/browser/prometheus/prometheus_extension_policy_service.h"
+#include "chrome/browser/prometheus/prometheus_extension_policy_service_factory.h"
 #include "chrome/browser/prometheus/prometheus_runtime_profile_service.h"
 #include "chrome/browser/prometheus/prometheus_runtime_profile_service_factory.h"
 #include "chrome/browser/prometheus/prometheus_supervision_transport_codec.h"
@@ -230,6 +232,19 @@ AgentDiagnosticStatus ToAgentDiagnosticStatus(
   }
 }
 
+std::optional<AgentDiagnosticStatus> ToExtensionDiagnosticStatus(
+    ExtensionPolicyHealthStatus status) {
+  switch (status) {
+    case ExtensionPolicyHealthStatus::kReady:
+      return AgentDiagnosticStatus::kReady;
+    case ExtensionPolicyHealthStatus::kDegraded:
+      return AgentDiagnosticStatus::kDegraded;
+    case ExtensionPolicyHealthStatus::kUnavailable:
+      return AgentDiagnosticStatus::kUnavailable;
+  }
+  return std::nullopt;
+}
+
 bool IsSanitizedSupervisionDiagnostic(std::string_view value) {
   if (value.empty() || value.size() > 256u || !base::IsStringUTF8(value) ||
       value.find('\n') != std::string_view::npos ||
@@ -721,9 +736,16 @@ AgentRouteResult BuildPrometheusGatewayHealthForTesting(
       valid_supervision_readiness
           ? supervision_readiness->next_action
           : "Open a regular Prometheus browser window and retry");
-  add("extensions", AgentDiagnosticStatus::kNotReady,
-      "Agent extension policy is owned by Phase 22",
-      "Retry after extension diagnostics reports ready");
+  ExtensionPolicyHealth extension_health = runtime_health.extension_health;
+  std::optional<AgentDiagnosticStatus> extension_status =
+      ToExtensionDiagnosticStatus(extension_health.status);
+  if (!extension_status.has_value()) {
+    extension_health = ExtensionPolicyHealth();
+    extension_status = AgentDiagnosticStatus::kUnavailable;
+  }
+  add("extensions", extension_status.value(),
+      SanitizeExtensionPolicyReason(extension_health.reason),
+      SanitizeExtensionPolicyRecovery(extension_health.recovery));
   return health;
 }
 
@@ -1939,10 +1961,15 @@ void PrometheusAgentGateway::HandleNativeRequest(
                 : std::vector<PrometheusProviderConfig>();
     const bool policy_operable_provider =
         std::ranges::any_of(providers, IsProviderPolicyOperable);
-    const RuntimeGatewayHealthState runtime_health =
+    RuntimeGatewayHealthState runtime_health =
         BuildPrometheusRuntimeHealthStateForTesting(
             runtime != nullptr, providers.size(), policy_operable_provider,
             runtime && runtime->IsVaultAvailableForTransport());
+    PrometheusExtensionPolicyService* const extension_policy =
+        PrometheusExtensionPolicyServiceFactory::GetForProfile(profile);
+    if (extension_policy) {
+      runtime_health.extension_health = extension_policy->GetHealth();
+    }
     std::optional<SupervisionGatewayReadiness> supervision_readiness;
     if (supervision_dispatcher_) {
       supervision_readiness = supervision_dispatcher_->readiness.Run();
diff --git a/chrome/browser/prometheus/prometheus_agent_gateway_browsertest.cc b/chrome/browser/prometheus/prometheus_agent_gateway_browsertest.cc
