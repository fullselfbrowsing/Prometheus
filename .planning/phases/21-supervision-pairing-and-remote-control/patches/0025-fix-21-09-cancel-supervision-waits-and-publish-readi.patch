+AgentDiagnosticStatus ToAgentDiagnosticStatus(
+    SupervisionGatewayReadinessStatus status) {
+  switch (status) {
+    case SupervisionGatewayReadinessStatus::kReady:
+      return AgentDiagnosticStatus::kReady;
+    case SupervisionGatewayReadinessStatus::kDegraded:
+      return AgentDiagnosticStatus::kDegraded;
+    case SupervisionGatewayReadinessStatus::kNotReady:
+      return AgentDiagnosticStatus::kNotReady;
+    case SupervisionGatewayReadinessStatus::kUnavailable:
+      return AgentDiagnosticStatus::kUnavailable;
+  }
+}
+
+bool IsSanitizedSupervisionDiagnostic(std::string_view value) {
+  if (value.empty() || value.size() > 256u || !base::IsStringUTF8(value) ||
+      value.find('\n') != std::string_view::npos ||
+      value.find('\r') != std::string_view::npos) {
+    return false;
+  }
+  const std::string lower = base::ToLowerASCII(value);
+  for (std::string_view forbidden :
+       {"authorization", "bearer", "api_key", "secret", "pairing_code",
+        "dashboard_session", "document_epoch", "profile_path", "selector",
+        "page_content", "typed_value"}) {
+    if (lower.find(forbidden) != std::string::npos) {
+      return false;
+    }
+  }
+  return true;
+}
