+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_extension_policy_service_factory.h"
+
+#include "chrome/browser/extensions/chrome_extension_system_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/prometheus/prometheus_extension_policy_service.h"
+#include "content/public/browser/browser_context.h"
+#include "extensions/browser/extension_registry_factory.h"
+
+namespace prometheus {
+
+// static
+PrometheusExtensionPolicyService*
+PrometheusExtensionPolicyServiceFactory::GetForProfile(Profile* profile) {
+  if (!profile || profile->IsOffTheRecord()) {
+    return nullptr;
+  }
+  return static_cast<PrometheusExtensionPolicyService*>(
+      GetInstance()->GetServiceForBrowserContext(profile, /*create=*/true));
+}
+
+// static
+PrometheusExtensionPolicyServiceFactory*
+PrometheusExtensionPolicyServiceFactory::GetInstance() {
+  static base::NoDestructor<PrometheusExtensionPolicyServiceFactory> factory{
+      base::PassKey<PrometheusExtensionPolicyServiceFactory>()};
+  return factory.get();
+}
+
+PrometheusExtensionPolicyServiceFactory::
+    PrometheusExtensionPolicyServiceFactory(
+        base::PassKey<PrometheusExtensionPolicyServiceFactory>)
+    : ProfileKeyedServiceFactory("PrometheusExtensionPolicyService",
+                                 ProfileSelections::BuildForRegularProfile()) {
+  DependsOn(extensions::ChromeExtensionSystemFactory::GetInstance());
+  DependsOn(extensions::ExtensionRegistryFactory::GetInstance());
+}
+
+PrometheusExtensionPolicyServiceFactory::
+    ~PrometheusExtensionPolicyServiceFactory() = default;
+
+// static
+bool PrometheusExtensionPolicyServiceFactory::
+    IsRegularProfileEligibleForTesting(bool is_off_the_record) {
+  return !is_off_the_record;
+}
+
+// static
+bool PrometheusExtensionPolicyServiceFactory::
+    HasChromeExtensionSystemDependencyForTesting() {
+  return true;
+}
+
+// static
+bool PrometheusExtensionPolicyServiceFactory::
+    HasExtensionRegistryDependencyForTesting() {
+  return true;
+}
+
+bool PrometheusExtensionPolicyServiceFactory::
+    ServiceIsCreatedWithBrowserContext() const {
+  return true;
+}
+
+std::unique_ptr<KeyedService>
+PrometheusExtensionPolicyServiceFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  Profile* const profile = Profile::FromBrowserContext(context);
+  if (!profile || profile->IsOffTheRecord()) {
+    return nullptr;
+  }
+  extensions::ExtensionRegistry* const registry =
+      extensions::ExtensionRegistryFactory::GetForBrowserContext(profile);
+  if (!registry) {
+    return nullptr;
+  }
+  return std::make_unique<PrometheusExtensionPolicyService>(
+      profile, profile->GetPrefs(), registry);
+}
+
+}  // namespace prometheus
