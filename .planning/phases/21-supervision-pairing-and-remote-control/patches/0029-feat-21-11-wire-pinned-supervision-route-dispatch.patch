+TEST_F(PrometheusAgentServiceTest,
+       SupervisionInvalidTargetsAndUnboundDispatcherFailClosed) {
+  ConfigureSupervisionTarget();
+  const AgentRouteRequest exact =
+      SupervisionRequest(AgentRouteName::kGetSupervisionSnapshot);
+
+  AgentRouteResult unbound = ExecuteAgentRoute(&supervision_browser_, exact);
