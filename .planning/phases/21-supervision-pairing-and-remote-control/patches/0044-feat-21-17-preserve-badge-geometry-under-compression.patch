   SetTooltipText(accessible_name);
@@ -231,6 +231,53 @@ void PrometheusTabStatusBadge::SetState(const PrometheusTabState& state) {
   SchedulePaint();
 }
 
+void PrometheusTabStatusBadge::SetAvailableWidth(int available_width) {
+  const int constrained_width =
+      std::clamp(available_width, 0, kMaximumWidth);
+  if (available_width_ == constrained_width) {
+    return;
+  }
+  available_width_ = constrained_width;
+  ApplyVisualCompression();
+  PreferredSizeChanged();
+  SchedulePaint();
+}
+
+gfx::Size PrometheusTabStatusBadge::GetMinimumSize() const {
+  return GetVisible() ? gfx::Size(kIconSize, kIconSize) : gfx::Size();
+}
+
+void PrometheusTabStatusBadge::ApplyVisualCompression() {
+  int remaining_slots =
+      available_width_ < kIconSize
+          ? 0
+          : std::min(3, 1 + (available_width_ - kIconSize) /
+                                (kIconSize + kIconSpacing));
+  bool show_owner = false;
+  bool show_supervision = false;
+  bool show_health = false;
+
+  if (has_supervision_ && remaining_slots > 0) {
+    show_supervision = true;
+    --remaining_slots;
+  }
+  if (has_owner_or_automation_ && owner_is_active_ && remaining_slots > 0) {
+    show_owner = true;
+    --remaining_slots;
+  }
+  if (has_health_warning_ && remaining_slots > 0) {
+    show_health = true;
+    --remaining_slots;
+  }
+  if (has_owner_or_automation_ && !owner_is_active_ && remaining_slots > 0) {
+    show_owner = true;
+  }
+
+  owner_or_automation_badge_->SetVisible(show_owner);
+  supervision_badge_->SetVisible(show_supervision);
+  health_badge_->SetVisible(show_health);
+}
+
 void PrometheusTabStatusBadge::OnPrometheusTabStateChanged(
     const PrometheusTabState& state) {
   SetState(state);
