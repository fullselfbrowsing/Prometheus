+// Every script below reaches the real, currently-committed chrome://extensions
+// document through content::RenderFrameHost::ExecuteJavaScript(), which the
+// production implementation restricts to chrome:// and devtools:// frames.
+// Nothing here reads extension content, page content, or any host page --
+// only the Prometheus-owned manager/options chrome://* documents this
+// controller itself opened.
+std::string ManagerReadyProbeScript() {
+  return "(function(){"
+        "var m=document.querySelector('extensions-manager');"
+        "if(!m||!m.shadowRoot)return false;"
+        "var t=m.shadowRoot.querySelector('extensions-toolbar');"
+        "if(!t||!t.shadowRoot)return false;"
+        "return !!t.shadowRoot.querySelector('#devMode');"
+        "})()";
+}
+
+std::string DevModeToggleClickScript() {
+  return "(function(){"
+        "var m=document.querySelector('extensions-manager');"
+        "if(!m||!m.shadowRoot)return 'missing_manager';"
+        "var t=m.shadowRoot.querySelector('extensions-toolbar');"
+        "if(!t||!t.shadowRoot)return 'missing_toolbar';"
+        "var toggle=t.shadowRoot.querySelector('#devMode');"
+        "if(!toggle)return 'missing_toggle';"
+        "if(toggle.checked)return 'already_checked';"
+        "toggle.click();"
+        "return 'clicked';"
+        "})()";
+}
+
+std::string DevModeReadyProbeScript() {
+  return "(function(){"
+        "var m=document.querySelector('extensions-manager');"
+        "if(!m||!m.shadowRoot)return false;"
+        "var t=m.shadowRoot.querySelector('extensions-toolbar');"
+        "if(!t||!t.shadowRoot)return false;"
+        "var toggle=t.shadowRoot.querySelector('#devMode');"
+        "var button=t.shadowRoot.querySelector('#loadUnpacked');"
+        "return !!(toggle&&toggle.checked&&button&&!button.hidden);"
