+module blink.mojom;
+
+// A content-free notification that the browser should recapture the document.
+enum PrometheusSupervisionDirtySignal {
+  kDirty,
+  kOverflow,
+};
+
+// Browser endpoint receiving bounded document invalidation signals.
+interface PrometheusSupervisionDocumentHost {
+  OnDocumentDirty(PrometheusSupervisionDirtySignal signal);
+};
+
+// Document-scoped renderer endpoint controlling invalidation observation.
+interface PrometheusSupervisionDocument {
+  Enable(pending_remote<PrometheusSupervisionDocumentHost> host);
+  Disable();
+};
