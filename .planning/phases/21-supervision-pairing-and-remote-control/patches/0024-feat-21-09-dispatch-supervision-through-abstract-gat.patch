+TEST(PrometheusAgentGatewayTest,
+     SupervisionMalformedAbsentAndClearedDispatcherFailClosed) {
+  FakeSupervisionGatewayDispatcher fake;
+  PrometheusAgentGateway gateway({});
+
+  NativeResponse malformed = HandleSupervisionRequest(
+      gateway,
+      R"({"operation":"heartbeat","params":{"session":"legacy"}})");
+  EXPECT_EQ(1u, malformed.callbacks);
+  EXPECT_EQ(net::HTTP_BAD_REQUEST, malformed.status);
+  auto malformed_body =
+      base::JSONReader::ReadDict(malformed.body, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(malformed_body.has_value()) << malformed.body;
+  EXPECT_EQ(false, malformed_body->FindBool("ok"));
+  const std::string* malformed_code =
+      malformed_body->FindString("error_code");
+  ASSERT_TRUE(malformed_code);
+  EXPECT_NE("NONE", *malformed_code);
+
+  NativeResponse absent =
+      HandleSupervisionRequest(gateway, kSupervisionRequests[0]);
+  EXPECT_EQ(1u, absent.callbacks);
+  EXPECT_EQ(net::HTTP_OK, absent.status);
+  EXPECT_NE(std::string::npos, absent.body.find("UNAVAILABLE"));
+
+  gateway.SetSupervisionGatewayDispatcher(fake.Bind());
+  gateway.SetSupervisionGatewayDispatcher({});
+  EXPECT_EQ(1u, fake.shutdowns);
+  NativeResponse cleared =
+      HandleSupervisionRequest(gateway, kSupervisionRequests[1]);
+  EXPECT_EQ(1u, cleared.callbacks);
+  EXPECT_EQ(net::HTTP_OK, cleared.status);
+  EXPECT_NE(std::string::npos, cleared.body.find("UNAVAILABLE"));
+  EXPECT_TRUE(fake.requests.empty());
+}
