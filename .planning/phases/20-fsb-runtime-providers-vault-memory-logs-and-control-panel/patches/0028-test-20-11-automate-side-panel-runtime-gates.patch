@@ -28,6 +28,8 @@ const terminalRuntimeStates = new Set(['succeeded', 'failed', 'cancelled']);
 let runtimeSnapshot = {status: 'NOT_IMPLEMENTED', tasks: [], providers: []};
 let runtimeSubmitPending = false;
 let pendingCancelTaskId = '';
+let pendingCancelTrigger = null;
+let cancellationFocusTaskId = '';
 const requestedCancellationTaskIds = new Set();
 
 function setAskFsbStatus(text) {
@@ -44,8 +46,9 @@ function activateSidePanelMode(mode) {
     return;
   }
   for (const button of buttons) {
