+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_CONTENT_EXTRACTION_PROMETHEUS_SUPERVISION_DOCUMENT_SUPPLEMENT_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_CONTENT_EXTRACTION_PROMETHEUS_SUPERVISION_DOCUMENT_SUPPLEMENT_H_
+
+#include "base/types/pass_key.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "third_party/blink/public/mojom/content_extraction/prometheus_supervision_document.mojom-blink.h"
+#include "third_party/blink/renderer/modules/modules_export.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+#include "third_party/blink/renderer/platform/mojo/heap_mojo_receiver.h"
+#include "third_party/blink/renderer/platform/mojo/heap_mojo_remote.h"
+#include "third_party/blink/renderer/platform/supplementable.h"
+
+namespace blink {
+
+class Document;
+class LocalFrame;
+
+// Document-owned renderer endpoint for content-free supervision invalidation.
+class MODULES_EXPORT PrometheusSupervisionDocumentSupplement final
+    : public GarbageCollected<PrometheusSupervisionDocumentSupplement>,
+      public mojom::blink::PrometheusSupervisionDocument,
+      public Supplement<Document> {
+ public:
+  static const char kSupplementName[];
+  static PrometheusSupervisionDocumentSupplement* From(Document&);
+  static void BindReceiver(
+      LocalFrame* frame,
+      mojo::PendingReceiver<mojom::blink::PrometheusSupervisionDocument>
+          receiver);
+
+  PrometheusSupervisionDocumentSupplement(
+      base::PassKey<PrometheusSupervisionDocumentSupplement>,
+      LocalFrame& frame);
+  PrometheusSupervisionDocumentSupplement(
+      const PrometheusSupervisionDocumentSupplement&) = delete;
+  PrometheusSupervisionDocumentSupplement& operator=(
+      const PrometheusSupervisionDocumentSupplement&) = delete;
+  ~PrometheusSupervisionDocumentSupplement() override;
+
+  void Trace(Visitor* visitor) const override;
+
+  // mojom::blink::PrometheusSupervisionDocument:
+  void Enable(
+      mojo::PendingRemote<mojom::blink::PrometheusSupervisionDocumentHost>
+          host) override;
+  void Disable() override;
+
+ private:
+  void Bind(
+      mojo::PendingReceiver<mojom::blink::PrometheusSupervisionDocument>
+          receiver);
+
+  HeapMojoReceiver<mojom::blink::PrometheusSupervisionDocument,
+                   PrometheusSupervisionDocumentSupplement>
+      receiver_;
+  HeapMojoRemote<mojom::blink::PrometheusSupervisionDocumentHost> host_;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_CONTENT_EXTRACTION_PROMETHEUS_SUPERVISION_DOCUMENT_SUPPLEMENT_H_
