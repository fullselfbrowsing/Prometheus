+
+bool ReadOptionalInt(const base::DictValue& value,
+                     std::string_view key,
+                     int minimum,
+                     int maximum,
+                     std::optional<int>* output) {
+  const base::Value* field = value.Find(key);
+  if (!field) {
+    output->reset();
+    return true;
+  }
+  if (!field->is_int() || field->GetInt() < minimum ||
+      field->GetInt() > maximum) {
+    return false;
+  }
+  *output = field->GetInt();
+  return true;
+}
