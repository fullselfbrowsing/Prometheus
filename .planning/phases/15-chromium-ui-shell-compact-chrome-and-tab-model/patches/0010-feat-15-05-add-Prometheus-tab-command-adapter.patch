diff --git a/chrome/browser/prometheus/prometheus_tab_commands.cc b/chrome/browser/prometheus/prometheus_tab_commands.cc
new file mode 100644
index 0000000000..c60edd3463
--- /dev/null
+++ b/chrome/browser/prometheus/prometheus_tab_commands.cc
@@ -0,0 +1,78 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_tab_commands.h"
+
+#include <vector>
+
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+
+namespace {
+
+bool ExecuteContextMenuCommandIfEnabled(
+    TabStripModel* model,
+    int tab_index,
+    TabStripModel::ContextMenuCommand command) {
+  if (!model || !model->ContainsIndex(tab_index) ||
+      !model->IsContextMenuCommandEnabled(tab_index, command)) {
+    return false;
+  }
+
+  model->ExecuteContextMenuCommand(tab_index, command);
+  return true;
+}
+
+}  // namespace
+
+bool ExecutePrometheusTabCommand(BrowserWindowInterface* browser,
+                                 PrometheusTabCommand command,
+                                 int tab_index) {
+  if (!browser) {
+    return false;
+  }
+
+  TabStripModel* const model = browser->GetTabStripModel();
+  if (!model || !model->ContainsIndex(tab_index)) {
+    return false;
+  }
+
+  switch (command) {
+    case PrometheusTabCommand::kDuplicate:
+      if (!chrome::CanDuplicateTabAt(browser, tab_index)) {
+        return false;
+      }
+      chrome::DuplicateTabAt(browser, tab_index);
+      return true;
+    case PrometheusTabCommand::kMoveToNewWindow: {
+      const std::vector<int> tab_indices = {tab_index};
+      if (!chrome::CanMoveTabsToNewWindow(browser, tab_indices)) {
+        return false;
+      }
+      chrome::MoveTabsToNewWindow(browser, tab_indices);
+      return true;
+    }
+    case PrometheusTabCommand::kClose:
+      return ExecuteContextMenuCommandIfEnabled(
+          model, tab_index, TabStripModel::CommandCloseTab);
+    case PrometheusTabCommand::kCloseOthers:
+      return ExecuteContextMenuCommandIfEnabled(
+          model, tab_index, TabStripModel::CommandCloseOtherTabs);
+    case PrometheusTabCommand::kCloseToRight:
+      return ExecuteContextMenuCommandIfEnabled(
+          model, tab_index, TabStripModel::CommandCloseTabsToRight);
+    case PrometheusTabCommand::kAddToNewGroup:
+      return ExecuteContextMenuCommandIfEnabled(
+          model, tab_index, TabStripModel::CommandAddToNewGroup);
+    case PrometheusTabCommand::kTogglePinned:
+      return ExecuteContextMenuCommandIfEnabled(
+          model, tab_index, TabStripModel::CommandTogglePinned);
+    case PrometheusTabCommand::kToggleMuted:
+      return ExecuteContextMenuCommandIfEnabled(
+          model, tab_index, TabStripModel::CommandToggleSiteMuted);
+    case PrometheusTabCommand::kUnloadOrDiscard:
+      return false;
+  }
+}
diff --git a/chrome/browser/prometheus/prometheus_tab_commands.h b/chrome/browser/prometheus/prometheus_tab_commands.h
