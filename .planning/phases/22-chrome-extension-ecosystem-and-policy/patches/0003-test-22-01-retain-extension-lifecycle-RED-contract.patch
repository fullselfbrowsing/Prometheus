+TEST(PrometheusExtensionPolicyLifecycleTest,
+     NativePrivateEligibilityLossBlocksBeforeObserverNotification) {
+  ASSERT_TRUE(ExtensionPolicyLifecycleImplementedForTesting())
+      << "retained RED: registry lifecycle reconciliation is not implemented";
+  sync_preferences::TestingPrefServiceSyncable prefs;
+  RegisterPrometheusExtensionPolicyProfilePrefs(prefs.registry());
+  PrometheusExtensionPolicyService service(nullptr, &prefs, nullptr);
+  service.SetSystemReadyForTesting(true);
+  service.SetInventoryForTesting({MakeInventoryEntry(kFirstExtensionId)});
+
+  ExtensionPolicySnapshot snapshot = service.GetSnapshot();
+  ASSERT_EQ(
+      ExtensionPolicyMutationResult::kApplied,
+      service.SetRequestedGrant(0, snapshot.generation, /*private_mode=*/false,
+                                ExtensionAgentGrant::kInteract));
+  snapshot = service.GetSnapshot();
+  ASSERT_EQ(
+      ExtensionPolicyMutationResult::kApplied,
+      service.SetRequestedGrant(0, snapshot.generation, /*private_mode=*/true,
+                                ExtensionAgentGrant::kInteract));
+  RecordingPolicyObserver observer(&service, &prefs, kFirstExtensionId);
+
+  service.SetInventoryForTesting(
+      {MakeInventoryEntry(kFirstExtensionId, "First extension",
+                          /*native_private_eligible=*/false)});
+  service.ReconcileForTesting();
+
+  ASSERT_EQ(1u, observer.snapshots.size());
+  ASSERT_EQ(1u, observer.private_grants_during_notification.size());
+  EXPECT_EQ(ExtensionAgentGrant::kBlocked,
+            observer.private_grants_during_notification.front());
+  EXPECT_EQ(ExtensionAgentGrant::kBlocked,
+            observer.snapshots.front().rows.front().effective_private);
+  EXPECT_EQ(ExtensionAgentGrant::kBlocked,
+            ReadPrometheusExtensionPolicyChoices(prefs)
+                .at(kFirstExtensionId)
+                .private_mode);
+}
+
+TEST(PrometheusExtensionPolicyLifecycleTest,
+     ObserverReentrancyAdvancesGenerationBeforeEveryNotification) {
+  ASSERT_TRUE(ExtensionPolicyLifecycleImplementedForTesting())
+      << "retained RED: registry lifecycle reconciliation is not implemented";
+  sync_preferences::TestingPrefServiceSyncable prefs;
+  RegisterPrometheusExtensionPolicyProfilePrefs(prefs.registry());
+  PrometheusExtensionPolicyService service(nullptr, &prefs, nullptr);
+  service.SetSystemReadyForTesting(true);
+  service.SetInventoryForTesting({MakeInventoryEntry(kFirstExtensionId)});
+  RecordingPolicyObserver observer(&service);
+  observer.reenter_once = true;
+
+  const uint64_t old_generation = service.GetSnapshot().generation;
+  service.ReconcileForTesting();
+
+  ASSERT_EQ(2u, observer.snapshots.size());
+  EXPECT_GT(observer.snapshots[0].generation, old_generation);
+  EXPECT_GT(observer.snapshots[1].generation, observer.snapshots[0].generation);
+}
+
+TEST(PrometheusExtensionPolicyLifecycleTest,
+     ProfileShutdownMakesLateCallbacksHarmless) {
+  ASSERT_TRUE(ExtensionPolicyLifecycleImplementedForTesting())
+      << "retained RED: registry lifecycle reconciliation is not implemented";
+  sync_preferences::TestingPrefServiceSyncable prefs;
+  RegisterPrometheusExtensionPolicyProfilePrefs(prefs.registry());
+  PrometheusExtensionPolicyService service(nullptr, &prefs, nullptr);
+  service.SetSystemReadyForTesting(true);
+  service.SetInventoryForTesting({MakeInventoryEntry(kFirstExtensionId)});
+  scoped_refptr<const extensions::Extension> extension =
+      MakeExtension("First extension", kFirstExtensionId);
+  RecordingPolicyObserver observer(&service);
+
+  const ExtensionPolicySnapshot snapshot = service.GetSnapshot();
+  service.Shutdown();
+  service.OnExtensionLoaded(nullptr, extension.get());
+  service.OnExtensionReady(nullptr, extension.get());
+  service.OnExtensionUnloaded(nullptr, extension.get(),
+                              extensions::UnloadedExtensionReason::DISABLE);
+  service.OnExtensionInstalled(nullptr, extension.get(), /*is_update=*/false);
+  service.OnExtensionUninstalled(nullptr, extension.get(),
+                                 extensions::UNINSTALL_REASON_FOR_TESTING);
+  service.ReconcileForTesting();
+
+  EXPECT_TRUE(observer.snapshots.empty());
+  EXPECT_TRUE(service.GetSnapshot().rows.empty());
+  EXPECT_EQ(ExtensionAgentGrant::kBlocked,
+            service.GetEffectiveGrant(kFirstExtensionId, nullptr,
+                                      /*private_mode=*/false));
+  EXPECT_EQ(
+      ExtensionPolicyMutationResult::kUnavailable,
+      service.SetRequestedGrant(0, snapshot.generation, /*private_mode=*/false,
+                                ExtensionAgentGrant::kInteract));
+}
