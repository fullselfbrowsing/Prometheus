+std::string SanitizeBoundedText(std::string_view value,
+                                size_t max_bytes,
+                                std::string_view fallback,
+                                bool reject_sensitive_markers) {
+  if (!base::IsStringUTF8(value)) {
+    return std::string(fallback);
+  }
+
+  std::string sanitized = base::CollapseWhitespaceASCII(value, true);
+  if (sanitized.empty() ||
+      std::ranges::any_of(sanitized, [](unsigned char character) {
+        return character < 0x20 || character == 0x7f;
+      })) {
+    return std::string(fallback);
+  }
+
+  if (reject_sensitive_markers) {
+    constexpr std::array<std::string_view, 8> kSensitiveMarkers = {
+        "extension id", "permission", "origin", "page content",
+        "profile path", "authority",  "bearer", "token",
+    };
+    const std::string lowered = base::ToLowerASCII(sanitized);
+    if (std::ranges::any_of(kSensitiveMarkers,
+                            [&lowered](std::string_view marker) {
+                              return lowered.find(marker) != std::string::npos;
+                            })) {
+      return std::string(fallback);
+    }
+  }
+
+  sanitized = base::TruncateUTF8ToByteSize(sanitized, max_bytes);
+  return sanitized.empty() ? std::string(fallback) : sanitized;
+}
