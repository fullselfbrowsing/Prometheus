+  ConfigurePrometheusDataSource(web_ui, chrome::kChromeUIPrometheusNewTabHost,
+                                IDR_PROMETHEUS_NEWTAB_HTML);
+  web_ui->AddMessageHandler(std::make_unique<PrometheusNewTabMessageHandler>());
+}
+
+PrometheusNewTabUI::~PrometheusNewTabUI() = default;
