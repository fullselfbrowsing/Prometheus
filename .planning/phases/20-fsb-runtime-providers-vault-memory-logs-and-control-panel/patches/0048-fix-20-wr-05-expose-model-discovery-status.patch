+TEST(PrometheusAgentGatewayTest,
+     CallerScopedAsyncDiscoveryCanBePolledWithoutStartingAgain) {
+  PrometheusGatewayDiscoveryTracker tracker;
+  int start_calls = 0;
+  int status_calls = 0;
+  bool completed = false;
+  auto start = base::BindRepeating(
+      [](int* calls, std::string_view provider_id) {
+        ++*calls;
+        EXPECT_EQ("provider-1", provider_id);
+        return RuntimeTransportResult::Success(
+            RuntimeRouteName::kDiscoverModels,
+            RuntimeModelListResult{
+                .operation_id = "17", .models = {}, .pending = true});
+      },
+      &start_calls);
+  auto status = base::BindRepeating(
+      [](int* calls, bool* completed, std::string_view operation_id) {
+        ++*calls;
+        EXPECT_EQ("17", operation_id);
+        return RuntimeTransportResult::Success(
+            RuntimeRouteName::kDiscoverModels,
+            RuntimeModelListResult{
+                .operation_id = "17",
+                .models = *completed
+                              ? std::vector<std::string>{"model-a", "model-b"}
+                              : std::vector<std::string>(),
+                .pending = !*completed,
+            });
+      },
+      &status_calls, &completed);
+
+  DiscoverModelsParams start_params{.provider_id = "provider-1"};
+  RuntimeTransportResult pending =
+      tracker.Dispatch(start_params, "session-1", "caller-1", start, status);
+  ASSERT_TRUE(pending.ok);
+  EXPECT_TRUE(std::get<RuntimeModelListResult>(pending.payload).pending);
+  EXPECT_EQ("17",
+            std::get<RuntimeModelListResult>(pending.payload).operation_id);
+  EXPECT_EQ(1, start_calls);
+  EXPECT_EQ(1u, tracker.operation_count_for_testing());
+
+  DiscoverModelsParams status_params{.operation_id = "17"};
+  RuntimeTransportResult wrong_caller =
+      tracker.Dispatch(status_params, "session-1", "caller-2", start, status);
+  EXPECT_FALSE(wrong_caller.ok);
+  EXPECT_EQ(RuntimeTransportErrorCode::kNotFound, wrong_caller.error_code);
+  RuntimeTransportResult wrong_session =
+      tracker.Dispatch(status_params, "session-2", "caller-1", start, status);
+  EXPECT_FALSE(wrong_session.ok);
+  EXPECT_EQ(RuntimeTransportErrorCode::kNotFound, wrong_session.error_code);
+  EXPECT_EQ(0, status_calls);
+
+  completed = true;
+  RuntimeTransportResult finished =
+      tracker.Dispatch(status_params, "session-1", "caller-1", start, status);
+  ASSERT_TRUE(finished.ok);
+  const RuntimeModelListResult& models =
+      std::get<RuntimeModelListResult>(finished.payload);
+  EXPECT_FALSE(models.pending);
+  EXPECT_EQ((std::vector<std::string>{"model-a", "model-b"}), models.models);
+  EXPECT_EQ(1, start_calls);
+  EXPECT_EQ(1, status_calls);
+  EXPECT_EQ(0u, tracker.operation_count_for_testing());
+}
