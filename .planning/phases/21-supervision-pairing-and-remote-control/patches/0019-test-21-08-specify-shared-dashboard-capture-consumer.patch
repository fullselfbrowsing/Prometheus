diff --git a/chrome/browser/prometheus/prometheus_supervision_profile_service_unittest.cc b/chrome/browser/prometheus/prometheus_supervision_profile_service_unittest.cc
index 661a619d78..249076ed1f 100644
--- a/chrome/browser/prometheus/prometheus_supervision_profile_service_unittest.cc
+++ b/chrome/browser/prometheus/prometheus_supervision_profile_service_unittest.cc
@@ -621,5 +621,27 @@ TEST_F(PrometheusSupervisionProfileServiceTest,
   EXPECT_LE(service_->audit_count_for_testing(), kDefaultSupervisionAuditRows);
 }
 
+TEST_F(PrometheusSupervisionProfileServiceTest,
+       HubRedeemedViewersRequireOneExactTargetRegistry) {
+  SupervisionPairingCreationResult first = CreatePairing();
+  ASSERT_TRUE(first.ok);
+  SupervisionRedemptionResult viewer_a = Redeem(first, "Viewer A");
+  ASSERT_TRUE(viewer_a.ok);
+  SupervisionPairingCreationResult second = CreatePairing();
+  ASSERT_TRUE(second.ok);
+  SupervisionRedemptionResult viewer_b = Redeem(second, "Viewer B");
+  ASSERT_TRUE(viewer_b.ok);
+
+  EXPECT_EQ(1u, service_->capture_hub_count_for_testing());
+  EXPECT_EQ(2u,
+            service_->capture_consumer_count_for_testing(first.stable_tab_id));
+  EXPECT_TRUE(service_->EndSession(viewer_a.dashboard_session).ok);
+  EXPECT_EQ(1u, service_->capture_hub_count_for_testing());
+  EXPECT_EQ(1u,
+            service_->capture_consumer_count_for_testing(first.stable_tab_id));
+  EXPECT_TRUE(service_->RevokeSession(viewer_b.dashboard_session).ok);
+  EXPECT_EQ(0u, service_->capture_hub_count_for_testing());
+}
+
 }  // namespace
 }  // namespace prometheus
