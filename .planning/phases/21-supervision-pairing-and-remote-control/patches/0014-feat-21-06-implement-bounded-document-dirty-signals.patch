 3 files changed, 146 insertions(+), 2 deletions(-)

diff --git a/third_party/blink/renderer/modules/content_extraction/prometheus_supervision_document_supplement.cc b/third_party/blink/renderer/modules/content_extraction/prometheus_supervision_document_supplement.cc
index a7d87f9328..dc789ad672 100644
--- a/third_party/blink/renderer/modules/content_extraction/prometheus_supervision_document_supplement.cc
+++ b/third_party/blink/renderer/modules/content_extraction/prometheus_supervision_document_supplement.cc
@@ -4,12 +4,41 @@
 
 #include "third_party/blink/renderer/modules/content_extraction/prometheus_supervision_document_supplement.h"
 
+#include "third_party/blink/renderer/bindings/core/v8/v8_mutation_observer_init.h"
 #include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/dom/element.h"
+#include "third_party/blink/renderer/core/dom/mutation_observer.h"
 #include "third_party/blink/renderer/core/frame/local_dom_window.h"
 #include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/platform/bindings/exception_state.h"
 
 namespace blink {
 
+class PrometheusSupervisionDocumentSupplement::MutationDelegate final
+    : public MutationObserver::Delegate {
+ public:
+  explicit MutationDelegate(
+      PrometheusSupervisionDocumentSupplement* supplement)
+      : supplement_(supplement) {}
+
+  ExecutionContext* GetExecutionContext() const override {
+    return supplement_->GetSupplementable()->GetExecutionContext();
+  }
+
+  void Deliver(const MutationRecordVector& records,
+               MutationObserver&) override {
+    supplement_->OnMutationRecordCount(records.size());
+  }
+
+  void Trace(Visitor* visitor) const override {
+    visitor->Trace(supplement_);
+    MutationObserver::Delegate::Trace(visitor);
+  }
+
+ private:
+  Member<PrometheusSupervisionDocumentSupplement> supplement_;
+};
+
 const char PrometheusSupervisionDocumentSupplement::kSupplementName[] =
     "PrometheusSupervisionDocumentSupplement";
 
@@ -42,8 +71,16 @@ PrometheusSupervisionDocumentSupplement::
         base::PassKey<PrometheusSupervisionDocumentSupplement>,
         LocalFrame& frame)
     : Supplement<Document>(*frame.GetDocument()),
+      ExecutionContextLifecycleObserver(frame.DomWindow()),
       receiver_(this, frame.DomWindow()),
-      host_(frame.DomWindow()) {}
+      host_(frame.DomWindow()),
+      mutation_delegate_(MakeGarbageCollected<MutationDelegate>(this)),
+      mutation_observer_(MutationObserver::Create(mutation_delegate_)),
+      dirty_timer_(
+          GetSupplementable()->GetTaskRunner(
+              TaskType::kInternalUserInteraction),
+          this,
+          &PrometheusSupervisionDocumentSupplement::DirtyTimerFired) {}
 
 PrometheusSupervisionDocumentSupplement::
     ~PrometheusSupervisionDocumentSupplement() = default;
@@ -64,16 +101,85 @@ void PrometheusSupervisionDocumentSupplement::Enable(
   host_.Bind(
       std::move(host),
       GetSupplementable()->GetTaskRunner(TaskType::kInternalUserInteraction));
+  enabled_ = true;
+  ObserveDocument();
 }
 
 void PrometheusSupervisionDocumentSupplement::Disable() {
+  enabled_ = false;
+  mutation_observer_->disconnect();
+  dirty_timer_.Stop();
+  pending_mutation_record_count_ = 0u;
+  overflow_pending_ = false;
   host_.reset();
 }
 
+void PrometheusSupervisionDocumentSupplement::ObserveDocument() {
+  Element* document_element = GetSupplementable()->documentElement();
+  if (!document_element) {
+    return;
+  }
+
+  MutationObserverInit* init = MutationObserverInit::Create();
+  init->setChildList(true);
+  init->setAttributes(true);
+  init->setCharacterData(true);
+  init->setSubtree(true);
+  DummyExceptionStateForTesting exception_state;
+  mutation_observer_->observe(document_element, init, exception_state);
+  DCHECK(!exception_state.HadException());
+}
+
+void PrometheusSupervisionDocumentSupplement::OnMutationRecordCount(
+    size_t record_count) {
+  if (!enabled_ || !host_.is_bound() || record_count == 0u) {
+    return;
+  }
+
+  if (!overflow_pending_) {
+    if (record_count >
+        kMaxPendingMutationRecords - pending_mutation_record_count_) {
+      overflow_pending_ = true;
+      pending_mutation_record_count_ = 0u;
+    } else {
+      pending_mutation_record_count_ += record_count;
+    }
+  }
+
+  if (!dirty_timer_.IsActive()) {
+    dirty_timer_.StartOneShot(kDirtyDebounce, FROM_HERE);
+  }
+}
+
+void PrometheusSupervisionDocumentSupplement::DirtyTimerFired(TimerBase*) {
+  if (!enabled_ || !host_.is_bound()) {
+    pending_mutation_record_count_ = 0u;
+    overflow_pending_ = false;
+    return;
+  }
+
+  const mojom::blink::PrometheusSupervisionDirtySignal signal =
+      overflow_pending_
+          ? mojom::blink::PrometheusSupervisionDirtySignal::kOverflow
+          : mojom::blink::PrometheusSupervisionDirtySignal::kDirty;
+  pending_mutation_record_count_ = 0u;
+  overflow_pending_ = false;
+  host_->OnDocumentDirty(signal);
+}
+
+void PrometheusSupervisionDocumentSupplement::ContextDestroyed() {
+  Disable();
+  receiver_.reset();
+}
+
 void PrometheusSupervisionDocumentSupplement::Trace(Visitor* visitor) const {
   Supplement<Document>::Trace(visitor);
+  ExecutionContextLifecycleObserver::Trace(visitor);
   visitor->Trace(receiver_);
   visitor->Trace(host_);
+  visitor->Trace(mutation_delegate_);
+  visitor->Trace(mutation_observer_);
+  visitor->Trace(dirty_timer_);
 }
 
 }  // namespace blink
