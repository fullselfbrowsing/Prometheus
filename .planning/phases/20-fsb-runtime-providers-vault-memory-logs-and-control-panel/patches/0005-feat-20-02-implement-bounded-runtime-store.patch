+    return RuntimeEventKind::kStateChanged;
+  }
+  if (value == "provider_attempt") {
+    return RuntimeEventKind::kProviderAttempt;
+  }
+  if (value == "fallback") {
+    return RuntimeEventKind::kFallback;
+  }
+  if (value == "tool_dispatched") {
+    return RuntimeEventKind::kToolDispatched;
+  }
+  if (value == "confirmation") {
+    return RuntimeEventKind::kConfirmation;
+  }
+  if (value == "task_finished") {
+    return RuntimeEventKind::kTaskFinished;
+  }
+  if (value == "cancellation") {
+    return RuntimeEventKind::kCancellation;
+  }
+  if (value == "timeout") {
+    return RuntimeEventKind::kTimeout;
+  }
+  if (value == "shutdown") {
+    return RuntimeEventKind::kShutdown;
