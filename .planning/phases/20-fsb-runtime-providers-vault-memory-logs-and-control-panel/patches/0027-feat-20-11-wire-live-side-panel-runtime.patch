+      if (cancelling.status == RuntimeStoreStatus::kAlreadyFinished) {
+        return RuntimeProfileStatus::kAlreadyFinished;
+      }
+      if (cancelling.status != RuntimeStoreStatus::kOk) {
+        return RuntimeProfileStatus::kInvalidRequest;
+      }
+      store_generation = cancelling.generation;
+    }
     const RuntimeStoreStatus store_status =
-        owned_runtime_store_->FinishTaskOnce(task_id, generation, state, error,
-                                             result, terminal_usage, now_ms);
+        owned_runtime_store_->FinishTaskOnce(task_id, store_generation, state,
+                                             error, result, terminal_usage,
+                                             now_ms);
     if (store_status == RuntimeStoreStatus::kAlreadyFinished) {
       return RuntimeProfileStatus::kAlreadyFinished;
     }
