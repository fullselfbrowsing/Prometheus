+  state = ProjectPrometheusTabSupervisionState(snapshot);
+  EXPECT_EQ(TabSupervision::ResyncState::kPaused, state.resync_state);
+  EXPECT_EQ(TabSupervision::ActivityState::kBlocked, state.activity_state);
+  EXPECT_EQ(TabSupervision::Severity::kBlocked, state.severity);
