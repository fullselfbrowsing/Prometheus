+struct PrometheusSupervisionTestCompositionHooks {
+  PrometheusSupervisionTestBootstrapProfileFacts profile_facts;
+  bool service_available = false;
+  PrometheusSupervisionTestBootstrapFileAccess file_access;
+  PrometheusSupervisionTestBootstrap::BindingCallback binding;
+  PrometheusSupervisionTestBootstrap::CreatePairingCodeCallback
+      create_pairing_code;
+  PrometheusSupervisionTestBootstrap::NowCallback now;
+  PrometheusSupervisionTestBootstrap::ZeroizationCallback zeroization;
+  base::RepeatingCallback<void(SupervisionTestHandoffDispatcher)> set_dispatcher;
+  base::RepeatingCallback<void(std::string_view)> observe_lifecycle;
+};
+
+// Owns the validated runtime-test handoff and its gateway registration. The
+// caller supplies exact-session resolution; this owner supplies only lifetime
+// and teardown ordering.
+class PrometheusSupervisionTestComposition {
+ public:
+  PrometheusSupervisionTestComposition(
+      const PrometheusSupervisionTestComposition&) = delete;
+  PrometheusSupervisionTestComposition& operator=(
+      const PrometheusSupervisionTestComposition&) = delete;
+  ~PrometheusSupervisionTestComposition();
+
+  static PrometheusSupervisionTestBootstrapResult Create(
+      const base::CommandLine& command_line,
+      bool is_official_build,
+      PrometheusSupervisionTestCompositionHooks hooks,
+      std::unique_ptr<PrometheusSupervisionTestComposition>* composition);
+
+  bool ObservePairingRedeemed(int sequence);
+  void Shutdown();
+
+  bool is_bound_for_testing() const { return bound_; }
+
+ private:
+  PrometheusSupervisionTestComposition(
+      std::unique_ptr<PrometheusSupervisionTestBootstrap> bootstrap,
+      PrometheusSupervisionTestCompositionHooks hooks);
+
+  void ObserveLifecycle(std::string_view event);
+
+  std::unique_ptr<PrometheusSupervisionTestBootstrap> bootstrap_;
+  base::RepeatingCallback<void(SupervisionTestHandoffDispatcher)>
+      set_dispatcher_;
+  base::RepeatingCallback<void(std::string_view)> observe_lifecycle_;
+  bool bound_ = false;
+  bool shutdown_ = false;
+};
