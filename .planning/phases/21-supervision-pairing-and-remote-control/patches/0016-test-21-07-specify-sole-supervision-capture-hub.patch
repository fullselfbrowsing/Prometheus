+
+#ifndef CHROME_BROWSER_PROMETHEUS_PROMETHEUS_SUPERVISION_CAPTURE_HUB_H_
+#define CHROME_BROWSER_PROMETHEUS_PROMETHEUS_SUPERVISION_CAPTURE_HUB_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/functional/callback.h"
