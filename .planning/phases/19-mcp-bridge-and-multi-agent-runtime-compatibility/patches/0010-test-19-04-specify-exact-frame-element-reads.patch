+  const std::string ref =
+      SnapshotRef(target_tab, session_id, "Child button", "button");
+  ASSERT_FALSE(ref.empty());
+  const AgentFrameTarget detached_target = FrameTargetFor(child);
+  content::RenderFrameDeletedObserver deleted_observer(child);
+  ASSERT_TRUE(content::ExecJs(
+      target_tab->GetContents(),
+      "document.querySelector('#prometheus-child-frame').remove()"));
+  deleted_observer.WaitUntilDeleted();
+
+  AgentRouteResult result = Execute(ElementReadRequest(
+      AgentRouteName::kGetText, session_id, target_tab, ref, detached_target));
+  ExpectElementReadDenied(result, AgentRouteName::kGetText,
+                          AgentErrorCode::kStaleTarget, "Child button");
+}
