+  auto state = std::unique_ptr<PrometheusSupervisionTestBootstrap>(
+      new PrometheusSupervisionTestBootstrap());
+  state->binding_ = std::move(binding);
+  state->create_pairing_code_ = std::move(create_pairing_code);
+  state->now_ = std::move(now);
+  state->zeroization_ = std::move(zeroization);
+  state->initial_binding_ = *initial_binding;
+  state->challenge_ = std::move(*challenge);
+  state->pinned_session_id_ = initial_binding->owner_session_id;
+  state->expires_at_ = state->now_.Run() + kPrometheusSupervisionTestHandoffTtl;
