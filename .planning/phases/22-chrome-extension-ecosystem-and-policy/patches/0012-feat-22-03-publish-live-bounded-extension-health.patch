   auto read_status = [](const HttpResult& response, std::string_view key) {
     std::string status;
     auto root = base::JSONReader::ReadDict(response.body, base::JSON_PARSE_RFC);
@@ -782,7 +787,7 @@ IN_PROC_BROWSER_TEST_F(PrometheusAgentGatewayBrowserTest,
   HttpResult ready = Authorized("GET", "/v1/health", "");
   EXPECT_EQ(200, ready.status);
   EXPECT_EQ("ready", read_status(ready, "supervision"));
-  EXPECT_EQ("not_ready", read_status(ready, "extensions"));
+  EXPECT_EQ("ready", read_status(ready, "extensions"));
 
   supervision_readiness_.reason = "Bearer SECRET-READINESS-SENTINEL";
   HttpResult rejected = Authorized("GET", "/v1/health", "");
@@ -792,7 +797,7 @@ IN_PROC_BROWSER_TEST_F(PrometheusAgentGatewayBrowserTest,
   gateway_->SetSupervisionGatewayDispatcher({});
   HttpResult absent = Authorized("GET", "/v1/health", "");
   EXPECT_EQ("not_ready", read_status(absent, "supervision"));
-  EXPECT_EQ("not_ready", read_status(absent, "extensions"));
+  EXPECT_EQ("ready", read_status(absent, "extensions"));
 }
 
 IN_PROC_BROWSER_TEST_F(PrometheusAgentGatewayBrowserTest,
@@ -899,6 +904,11 @@ IN_PROC_BROWSER_TEST_F(PrometheusAgentGatewayBrowserTest,
 
 IN_PROC_BROWSER_TEST_F(PrometheusAgentGatewayBrowserTest,
                        RunsPinnedSessionCommandAndClosedTenKeyHealth) {
+  PrometheusExtensionPolicyService* const extension_policy =
+      PrometheusExtensionPolicyServiceFactory::GetForProfile(
+          browser()->profile());
+  ASSERT_TRUE(extension_policy);
+  extension_policy->SetSystemReadyForTesting(true);
   HttpResult created =
       Authorized("POST", "/v1/session/create", R"({"display_label":"Codex"})");
   ASSERT_EQ(200, created.status);
@@ -935,8 +945,7 @@ IN_PROC_BROWSER_TEST_F(PrometheusAgentGatewayBrowserTest,
       "supervision",      "extensions"};
   const std::set<std::string> allowed_statuses = {"ready", "degraded",
                                                   "not_ready", "unavailable"};
-  const std::set<std::string> not_ready_keys = {"provider", "supervision",
-                                                "extensions"};
+  const std::set<std::string> not_ready_keys = {"provider", "supervision"};
   std::set<std::string> actual_keys;
   for (const base::Value& value : *diagnostics) {
     const base::DictValue* component = value.GetIfDict();
@@ -953,6 +962,10 @@ IN_PROC_BROWSER_TEST_F(PrometheusAgentGatewayBrowserTest,
     EXPECT_TRUE(allowed_statuses.contains(*status)) << *status;
     if (*key == "vault") {
       EXPECT_EQ("ready", *status) << *key;
+    } else if (*key == "extensions") {
+      EXPECT_EQ("ready", *status) << *key;
+      EXPECT_LE(reason->size(), kMaxExtensionPolicyReasonBytes);
+      EXPECT_LE(next_action->size(), kMaxExtensionPolicyRecoveryBytes);
     } else if (not_ready_keys.contains(*key)) {
       EXPECT_EQ("not_ready", *status) << *key;
       EXPECT_FALSE(reason->empty()) << *key;
