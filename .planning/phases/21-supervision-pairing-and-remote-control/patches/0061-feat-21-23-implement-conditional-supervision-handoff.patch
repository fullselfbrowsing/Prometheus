+         binding.browser_live && binding.target_live && binding.document_live &&
+         binding.is_regular_profile && !binding.is_off_the_record &&
+         binding.expected_origin == expected_origin &&
+         !binding.document_identity.empty() &&
+         binding.document_identity.size() <= kMaxDocumentIdentityBytes &&
+         base::IsStringUTF8(binding.document_identity) &&
+         !binding.owner_session_id.empty() &&
+         binding.owner_session_id.size() <= 128u &&
+         base::IsStringUTF8(binding.owner_session_id);
+}
