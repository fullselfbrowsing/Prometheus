+TEST(PrometheusSupervisionTransportCodecTest,
+     SerializesTransportAndSupervisionFailuresWithStableTypedCodes) {
+  auto transport = SerializeSupervisionDashboardResult(
+      SupervisionTransportResult::TransportFailure(
+          SupervisionTransportOperation::kRedeem,
+          SupervisionTransportErrorCode::kForbiddenField,
+          "Request contains a prohibited field", "Use documented fields"));
+  ASSERT_TRUE(transport.has_value()) << transport.error().message;
+  EXPECT_NE(std::string::npos, transport->find("FORBIDDEN_FIELD"));
+  EXPECT_EQ(std::string::npos, transport->find("DASHBOARD-SESSION-7"));
+
+  auto domain = SerializeSupervisionDashboardResult(
+      SupervisionTransportResult::SupervisionFailure(
+          SupervisionTransportOperation::kAction,
+          SupervisionErrorCode::kViewOnly, "Control is not enabled",
+          "Enable control locally and retry"));
+  ASSERT_TRUE(domain.has_value()) << domain.error().message;
+  EXPECT_NE(std::string::npos, domain->find("VIEW_ONLY"));
+  EXPECT_NE(std::string::npos, domain->find("action"));
+}
