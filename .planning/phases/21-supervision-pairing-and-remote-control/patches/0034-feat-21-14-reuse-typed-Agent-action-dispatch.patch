+bool HasBoundedValue(const std::optional<std::string>& value, size_t limit) {
+  return value.has_value() && !value->empty() && value->size() <= limit &&
+         base::IsStringUTF8(*value);
+}
+
+bool HasOnlyActionFields(const SupervisionRemoteActionRequest& action,
+                         bool element_ref,
+                         bool target_element_ref,
+                         bool text,
+                         bool key,
+                         bool option,
+                         bool scroll_delta_x,
+                         bool scroll_delta_y,
+                         bool navigation) {
+  return action.element_ref.has_value() == element_ref &&
+         action.target_element_ref.has_value() == target_element_ref &&
+         action.text.has_value() == text && action.key.has_value() == key &&
+         action.option.has_value() == option &&
+         action.scroll_delta_x.has_value() == scroll_delta_x &&
+         action.scroll_delta_y.has_value() == scroll_delta_y &&
+         action.navigation.has_value() == navigation;
+}
+
+bool IsAllowedNavigation(const std::optional<std::string>& navigation) {
+  if (!HasBoundedValue(navigation, kMaxSupervisionTransportNavigationBytes)) {
+    return false;
+  }
+  const GURL url(*navigation);
+  return url.is_valid() &&
+         (url.SchemeIsHTTPOrHTTPS() ||
+          (url.SchemeIs("about") && url.path() == "blank"));
+}
+
+bool HasValidShape(const SupervisionRemoteActionRequest& action) {
+  switch (action.category) {
+    case SupervisionRemoteActionCategory::kClick:
+    case SupervisionRemoteActionCategory::kHover:
+    case SupervisionRemoteActionCategory::kClear:
+    case SupervisionRemoteActionCategory::kDrop:
+      return HasOnlyActionFields(action, true, false, false, false, false,
+                                 false, false, false) &&
+             HasBoundedValue(action.element_ref,
+                             kMaxSupervisionTransportElementRefBytes);
+    case SupervisionRemoteActionCategory::kType:
+      return HasOnlyActionFields(action, true, false, true, false, false,
+                                 false, false, false) &&
+             HasBoundedValue(action.element_ref,
+                             kMaxSupervisionTransportElementRefBytes) &&
+             HasBoundedValue(action.text, kMaxSupervisionTransportTextBytes);
+    case SupervisionRemoteActionCategory::kKeyPress:
+      return HasOnlyActionFields(action, false, false, false, true, false,
+                                 false, false, false) &&
+             HasBoundedValue(action.key, kMaxSupervisionTransportKeyBytes);
+    case SupervisionRemoteActionCategory::kScroll: {
+      if (action.element_ref.has_value() ||
+          action.target_element_ref.has_value() || action.text.has_value() ||
+          action.key.has_value() || action.option.has_value() ||
+          action.navigation.has_value() ||
+          (!action.scroll_delta_x.has_value() &&
+           !action.scroll_delta_y.has_value())) {
+        return false;
+      }
+      const int64_t delta_x = action.scroll_delta_x.value_or(0);
+      const int64_t delta_y = action.scroll_delta_y.value_or(0);
+      return (delta_x != 0 || delta_y != 0) &&
+             delta_x >= -kMaxSupervisionTransportScrollDelta &&
+             delta_x <= kMaxSupervisionTransportScrollDelta &&
+             delta_y >= -kMaxSupervisionTransportScrollDelta &&
+             delta_y <= kMaxSupervisionTransportScrollDelta;
+    }
+    case SupervisionRemoteActionCategory::kSelect:
+      return HasOnlyActionFields(action, true, false, false, false, true,
+                                 false, false, false) &&
+             HasBoundedValue(action.element_ref,
+                             kMaxSupervisionTransportElementRefBytes) &&
+             HasBoundedValue(action.option,
+                             kMaxSupervisionTransportOptionBytes);
+    case SupervisionRemoteActionCategory::kDrag:
+      return HasOnlyActionFields(action, true, true, false, false, false,
+                                 false, false, false) &&
+             HasBoundedValue(action.element_ref,
+                             kMaxSupervisionTransportElementRefBytes) &&
+             HasBoundedValue(action.target_element_ref,
+                             kMaxSupervisionTransportElementRefBytes) &&
+             action.element_ref != action.target_element_ref;
+    case SupervisionRemoteActionCategory::kNavigate:
+      return HasOnlyActionFields(action, false, false, false, false, false,
+                                 false, false, true) &&
+             IsAllowedNavigation(action.navigation);
+  }
+  return false;
+}
+
+std::optional<std::string> DocumentTokenFromRef(std::string_view ref) {
+  const size_t separator = ref.rfind(':');
+  if (separator == std::string_view::npos || separator == 0 ||
+      separator + 1 >= ref.size()) {
+    return std::nullopt;
+  }
+  return std::string(ref.substr(0, separator));
+}
+
+bool RefMatchesDocument(const std::optional<std::string>& ref,
+                        std::string_view document_token) {
+  if (!ref.has_value()) {
+    return true;
+  }
+  const std::optional<std::string> ref_document = DocumentTokenFromRef(*ref);
+  return ref_document.has_value() && *ref_document == document_token;
+}
+
+std::optional<AgentFrameTarget> ResolveProductionFrame(
+    BrowserWindowInterface* exact_browser,
+    tabs::TabHandle stable_tab,
+    const SupervisionRemoteActionRequest& action) {
+  tabs::TabInterface* const tab = stable_tab.Get();
+  if (!exact_browser || exact_browser->IsDeleteScheduled() || !tab ||
+      tab->GetHandle() != stable_tab ||
+      tab->GetBrowserWindowInterface() != exact_browser ||
+      tab->GetProfile() != exact_browser->GetProfile()) {
+    return std::nullopt;
+  }
+  content::WebContents* const web_contents = tab->GetContents();
+  if (!web_contents) {
+    return std::nullopt;
+  }
+
+  std::optional<std::string> requested_document;
+  if (action.element_ref.has_value()) {
+    requested_document = DocumentTokenFromRef(*action.element_ref);
+  } else if (action.target_element_ref.has_value()) {
+    requested_document = DocumentTokenFromRef(*action.target_element_ref);
+  }
+  if ((action.element_ref.has_value() ||
+       action.target_element_ref.has_value()) &&
+      !requested_document.has_value()) {
+    return std::nullopt;
+  }
+
+  content::RenderFrameHost* frame =
+      requested_document.has_value()
+          ? optimization_guide::GetRenderFrameForDocumentIdentifier(
+                *web_contents, *requested_document)
+          : web_contents->GetPrimaryMainFrame();
+  if (!frame || !frame->IsActive() || !frame->IsRenderFrameLive()) {
+    return std::nullopt;
+  }
+  const std::optional<std::string> live_document =
+      optimization_guide::DocumentIdentifierUserData::GetDocumentIdentifier(
+          frame->GetGlobalFrameToken());
+  if (!live_document.has_value() || live_document->empty() ||
+      (requested_document.has_value() &&
+       *requested_document != *live_document) ||
+      !RefMatchesDocument(action.element_ref, *live_document) ||
+      !RefMatchesDocument(action.target_element_ref, *live_document)) {
+    return std::nullopt;
+  }
+
+  AgentFrameTarget target;
+  target.document_token = *live_document;
+  target.render_process_id = frame->GetProcess()->GetDeprecatedID();
+  target.render_frame_routing_id = frame->GetRoutingID();
+  return target;
+}
+
+AgentRouteName RouteForCategory(SupervisionRemoteActionCategory category) {
+  switch (category) {
+    case SupervisionRemoteActionCategory::kClick:
+      return AgentRouteName::kClick;
+    case SupervisionRemoteActionCategory::kType:
+      return AgentRouteName::kTypeText;
+    case SupervisionRemoteActionCategory::kKeyPress:
+      return AgentRouteName::kPressKey;
+    case SupervisionRemoteActionCategory::kScroll:
+      return AgentRouteName::kScroll;
+    case SupervisionRemoteActionCategory::kHover:
+      return AgentRouteName::kHover;
+    case SupervisionRemoteActionCategory::kSelect:
+      return AgentRouteName::kSelectOption;
+    case SupervisionRemoteActionCategory::kClear:
+      return AgentRouteName::kClear;
+    case SupervisionRemoteActionCategory::kDrag:
+      return AgentRouteName::kDrag;
+    case SupervisionRemoteActionCategory::kDrop:
+      return AgentRouteName::kDropFile;
+    case SupervisionRemoteActionCategory::kNavigate:
+      return AgentRouteName::kNavigate;
+  }
+  return AgentRouteName::kUnsupportedPageAction;
+}
+
+SupervisionActionResult AdmissionFailure(SupervisionErrorCode error_code) {
+  SupervisionActionResult result;
+  result.error_code = error_code;
+  return result;
+}
