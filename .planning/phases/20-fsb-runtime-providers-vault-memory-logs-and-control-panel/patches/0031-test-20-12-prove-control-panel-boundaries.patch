+IN_PROC_BROWSER_TEST_F(
+    PrometheusControlPanelBrowserTest,
+    ControlPanelResponsiveAtContractWidthsAndKeepsActionsVisible) {
+  ASSERT_TRUE(ConfigureLocalRuntimeProvider());
+  content::WebContents* const web_contents =
+      NavigateTo(chrome::kChromeUIPrometheusControlPanelURL);
+  ASSERT_TRUE(web_contents);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(web_contents, R"(
+      window.prometheusControlSnapshotForTesting?.providers?.length === 1;
+    )")
+        .ExtractBool();
+  }));
+  ASSERT_TRUE(content::ExecJs(web_contents, R"(
+    document.querySelector('[data-section-target="providers"]').click();
+    document.querySelector('#control-add-provider').click();
+  )"));
+
+  for (const int width : std::array{320, 480, 720, 1024}) {
+    web_contents->Resize(gfx::Rect(0, 0, width, 900));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return content::EvalJs(web_contents, "window.innerWidth").ExtractInt() ==
+             width;
+    })) << width;
+    const std::string issues = content::EvalJs(web_contents, R"(
+      (() => {
+        const issues = [];
+        const viewport = document.documentElement.clientWidth;
+        const visible = element => {
+          const style = getComputedStyle(element);
+          return style.display !== 'none' && style.visibility !== 'hidden' &&
+              element.getClientRects().length > 0;
+        };
+        if (document.documentElement.scrollWidth > viewport ||
+            document.body.scrollWidth > viewport) {
+          issues.push(`page-overflow:${document.documentElement.scrollWidth}`);
+        }
+        const railVisible = getComputedStyle(
+            document.querySelector('.section-rail')).display !== 'none';
+        const selectVisible = visible(
+            document.querySelector('.section-select-label'));
+        if (railVisible !== (innerWidth >= 720)) {
+          issues.push(`rail:${railVisible}`);
+        }
+        if (selectVisible !== (innerWidth < 720)) {
+          issues.push(`select:${selectVisible}`);
+        }
+        const detailTracks = getComputedStyle(
+            document.querySelector('.control-details')).gridTemplateColumns
+            .trim().split(/\s+/).length;
+        if (detailTracks !== (innerWidth >= 1024 ? 2 : 1)) {
+          issues.push(`detail-tracks:${detailTracks}`);
+        }
+        const formTracks = getComputedStyle(
+            document.querySelector('.control-form-grid')).gridTemplateColumns
+            .trim().split(/\s+/).length;
+        if (formTracks !== (innerWidth >= 1024 ? 2 : 1)) {
+          issues.push(`form-tracks:${formTracks}`);
+        }
+        const controls = Array.from(document.querySelectorAll(
+            'button, input, select, textarea')).filter(visible);
+        for (const control of controls) {
+          const rect = control.getBoundingClientRect();
+          if (rect.left < -0.5 || rect.right > viewport + 0.5) {
+            issues.push(`clipped:${control.id || control.name ||
+                control.textContent.trim()}`);
+          }
+          if (!control.disabled && control.tabIndex < 0 &&
+              control.getAttribute('role') !== 'tab') {
+            issues.push(`unreachable:${control.id || control.name}`);
+          }
+          if (control.matches('button, input:not([type="checkbox"]):not(' +
+              '[type="radio"]), select, textarea') && rect.height < 47.5) {
+            issues.push(`short:${control.id || control.name ||
+                control.textContent.trim()}:${rect.height}`);
+          }
+          if (control.matches('input, select, textarea') &&
+              !control.labels?.length && !control.getAttribute('aria-label')) {
+            issues.push(`unlabelled:${control.id || control.name}`);
+          }
+          if (control.matches('button') &&
+              !control.textContent.trim() &&
+              !control.getAttribute('aria-label') &&
+              !control.getAttribute('title')) {
+            issues.push(`unnamed-button:${control.id}`);
+          }
+        }
+        for (const checkbox of document.querySelectorAll(
+            'input[type="checkbox"]')) {
+          if (visible(checkbox) &&
+              checkbox.closest('label')?.getBoundingClientRect().height < 48) {
+            issues.push(`small-checkbox-target:${checkbox.name}`);
+          }
+        }
+        return issues.join('|');
+      })();
+    )")
+                                   .ExtractString();
+    EXPECT_TRUE(issues.empty()) << "width=" << width << " " << issues;
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(
+    PrometheusControlPanelBrowserTest,
+    ControlPanelKeyboardStatesLiveRegionsAndFocusPreservation) {
+  prometheus::PrometheusRuntimeProfileService* const service =
+      ConfigureLocalRuntimeProvider();
+  ASSERT_TRUE(service);
+  content::WebContents* const web_contents =
+      NavigateTo(chrome::kChromeUIPrometheusControlPanelURL);
+  ASSERT_TRUE(web_contents);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(web_contents, R"(
+      window.prometheusControlSnapshotForTesting?.providers?.length === 1;
+    )")
+        .ExtractBool();
+  }));
+
+  EXPECT_TRUE(content::EvalJs(web_contents, R"(
+    (() => {
+      const labelledPanels = Array.from(document.querySelectorAll(
+          '[data-section-panel]')).every(panel => {
+        const label = panel.getAttribute('aria-labelledby');
+        return panel.getAttribute('role') === 'tabpanel' && label &&
+            document.getElementById(label);
+      });
+      const labelledFields = Array.from(document.querySelectorAll(
+          'input, select, textarea')).every(field =>
+        field.labels?.length || field.getAttribute('aria-label'));
+      const namedButtons = Array.from(document.querySelectorAll('button'))
+          .every(button => button.textContent.trim() ||
+              button.getAttribute('aria-label') || button.title);
+      return !!document.querySelector('main') &&
+          document.querySelector('nav[aria-label][role="tablist"]') &&
+          labelledPanels && labelledFields && namedButtons &&
+          document.querySelector('#control-tasks-state[role="status"]' +
+              '[aria-live="polite"]') &&
+          document.querySelector('#control-logs-state[role="status"]' +
+              '[aria-live="polite"]') &&
+          document.querySelector('#control-provider-operation[role="alert"]' +
+              '[aria-live="assertive"]') &&
+          document.querySelector('#control-cancel-task-dialog' +
+              '[aria-labelledby][aria-describedby]') &&
+          document.querySelector('#control-clear-logs-dialog' +
+              '[aria-labelledby][aria-describedby]') &&
+          matchMedia('(prefers-reduced-motion: reduce)').matches;
+    })();
+  )")
+                  .ExtractBool());
+
+  EXPECT_TRUE(content::EvalJs(web_contents, R"(
+    (() => {
+      const taskTab = document.querySelector('[data-section-target="tasks"]');
+      taskTab.focus();
+      taskTab.dispatchEvent(new KeyboardEvent(
+          'keydown', {key: 'ArrowDown', bubbles: true}));
+      const providerTab = document.activeElement;
+      if (providerTab.dataset.sectionTarget !== 'providers' ||
+          document.documentElement.dataset.controlPanelSection !==
+              'providers') {
+        return false;
+      }
+      providerTab.dispatchEvent(new KeyboardEvent(
+          'keydown', {key: 'End', bubbles: true}));
+      if (document.activeElement.dataset.sectionTarget !== 'parity') {
+        return false;
+      }
+      document.activeElement.dispatchEvent(new KeyboardEvent(
+          'keydown', {key: 'Home', bubbles: true}));
+      const active = document.activeElement;
+      const style = getComputedStyle(active);
+      return active.dataset.sectionTarget === 'tasks' &&
+          active.getAttribute('aria-selected') === 'true' &&
+          style.outlineStyle !== 'none' &&
+          parseFloat(style.outlineWidth) >= 2;
+    })();
+  )")
+                  .ExtractBool());
+
+  ASSERT_TRUE(content::ExecJs(web_contents, R"(
+    window.controlNativeSnapshotForTesting = structuredClone(
+        window.prometheusControlSnapshotForTesting);
