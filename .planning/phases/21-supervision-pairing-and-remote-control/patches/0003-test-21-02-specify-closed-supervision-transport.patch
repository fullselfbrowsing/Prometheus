+TEST(PrometheusSupervisionTransportCodecTest,
+     SanitizedProjectionRejectsAuthorityContentAndSecretSentinels) {
+  SupervisionTransportResult result =
+      MakeDashboardResult(SupervisionTransportOperation::kHeartbeat);
+  result.sanitized_snapshot->target.safe_title = "selector=#SECRET-NODE";
+  result.sanitized_snapshot->target.owner_label = "Bearer BEARER-AUTHORITY";
+  result.sanitized_snapshot->target.controller_label = "lease LEASE-AUTHORITY";
+  result.sanitized_snapshot->sessions[0].client.display_label =
