+std::string NormalizeSensitiveMarker(std::string_view value) {
+  std::string normalized;
+  normalized.reserve(value.size());
+  for (char character : value) {
+    if (base::IsAsciiAlphaNumeric(character)) {
+      normalized.push_back(base::ToLowerASCII(character));
+    } else {
+      normalized.push_back('_');
+    }
+  }
+  return normalized;
+}
+
+bool ContainsBoundedMarker(std::string_view value, std::string_view marker) {
+  size_t position = value.find(marker);
+  while (position != std::string_view::npos) {
+    const size_t end = position + marker.size();
+    const bool starts_at_boundary =
+        position == 0 || !base::IsAsciiAlphaNumeric(value[position - 1]);
+    const bool ends_at_boundary =
+        end == value.size() || !base::IsAsciiAlphaNumeric(value[end]);
+    if (starts_at_boundary && ends_at_boundary) {
+      return true;
+    }
+    position = value.find(marker, position + 1);
+  }
+  return false;
+}
+
+template <size_t N>
+bool ContainsAnyMarker(
+    std::string_view value,
+    const std::array<std::string_view, N>& forbidden_markers) {
+  const std::string normalized = NormalizeSensitiveMarker(value);
+  return std::any_of(forbidden_markers.begin(), forbidden_markers.end(),
+                     [&normalized](std::string_view marker) {
+                       return ContainsBoundedMarker(normalized, marker);
+                     });
+}
+
+bool ContainsSensitiveResultData(std::string_view value) {
+  return ContainsAnyMarker(value, kSensitiveResultMarkers);
+}
+
+bool ContainsForbiddenSupervisionData(std::string_view value) {
+  return ContainsSensitiveResultData(value) ||
+         ContainsAnyMarker(value, kSupervisionAuthorityMarkers);
+}
