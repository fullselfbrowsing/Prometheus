+  NativeVaultFieldValue(const NativeVaultFieldValue&) = delete;
+  NativeVaultFieldValue& operator=(const NativeVaultFieldValue&) = delete;
+  ~NativeVaultFieldValue();
+
+  std::string field_name;
+  ScopedSensitiveVaultValue value;
+};
