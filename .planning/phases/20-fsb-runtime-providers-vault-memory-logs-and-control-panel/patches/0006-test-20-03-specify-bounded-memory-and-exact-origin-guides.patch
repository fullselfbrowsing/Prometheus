+                .status);
+  EXPECT_EQ(MemoryStoreStatus::kInvalidInput,
+            store
+                ->CreateMemory(kCallerA, MemoryVisibility::kCallerOwned,
+                               "title", "text", {std::string("bad\xFF", 4)},
+                               kNow)
+                .status);
+  EXPECT_EQ(MemoryStoreStatus::kInvalidInput,
+            store
+                ->CreateMemory(kCallerA, MemoryVisibility::kCallerOwned,
+                               "title", "text", {}, -1)
+                .status);
+}
