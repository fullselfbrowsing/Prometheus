+      border-bottom: 1px solid var(--color-prometheus-border);
+      padding-bottom: 8px;
+      margin-bottom: 16px;
+    }
+
+    /* Token swatch grid */
+    .swatch-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
+      gap: 12px;
+    }
+    .swatch-cell {
+      background: var(--color-prometheus-surface);
+      border: 1px solid var(--color-prometheus-border);
