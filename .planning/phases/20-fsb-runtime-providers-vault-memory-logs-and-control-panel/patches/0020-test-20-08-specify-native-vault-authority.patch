+
+struct PrometheusVaultMetadataResult {
+  PrometheusVaultStatus status = PrometheusVaultStatus::kInvalidArgument;
+  std::optional<PrometheusVaultMetadata> metadata;
+
+  bool ok() const { return status == PrometheusVaultStatus::kSuccess; }
+};
