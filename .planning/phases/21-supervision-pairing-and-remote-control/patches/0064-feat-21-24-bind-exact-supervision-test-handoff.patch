+uint64_t OpaquePointerIdentity(const void* pointer) {
+  return static_cast<uint64_t>(reinterpret_cast<uintptr_t>(pointer));
+}
+
+bool IsDisposableSupervisionTestProfile(Profile* profile) {
+  base::FilePath temporary_directory;
+  if (!profile || !base::GetTempDir(&temporary_directory)) {
+    return false;
+  }
+  const base::FilePath profile_path =
+      profile->GetPath().StripTrailingSeparators();
+  temporary_directory = temporary_directory.StripTrailingSeparators();
+  return profile_path == temporary_directory ||
+         temporary_directory.IsParent(profile_path);
+}
+
+Profile* FindSoleDisposableSupervisionTestProfile() {
+  if (!g_browser_process || !g_browser_process->profile_manager()) {
+    return nullptr;
+  }
+  Profile* candidate = nullptr;
+  for (Profile* profile :
+       g_browser_process->profile_manager()->GetLoadedProfiles()) {
+    if (!profile || !profile->IsRegularProfile() ||
+        profile->IsOffTheRecord() ||
+        !IsDisposableSupervisionTestProfile(profile) ||
+        !PrometheusSupervisionProfileServiceFactory::GetForProfile(profile)) {
+      continue;
+    }
+    if (candidate) {
+      return nullptr;
+    }
+    candidate = profile;
+  }
+  return candidate;
+}
+
+struct ResolvedSupervisionTestBinding {
+  PrometheusSupervisionTestBindingFacts facts;
+  raw_ptr<BrowserWindowInterface> browser = nullptr;
+  raw_ptr<tabs::TabInterface> tab = nullptr;
+  base::WeakPtr<PrometheusSupervisionProfileService> service;
+};
+
+std::optional<ResolvedSupervisionTestBinding>
+ResolveExactSupervisionTestBinding(
+    PrometheusAgentGateway* gateway,
+    base::WeakPtr<Profile> expected_profile,
+    std::string_view requesting_session_id) {
+  if (!gateway || !expected_profile || requesting_session_id.empty()) {
+    return std::nullopt;
+  }
+  const std::optional<
+      PrometheusAgentGateway::ExactSessionBindingForComposition>
+      gateway_binding =
+          gateway->GetExactSessionBindingForComposition(requesting_session_id);
+  Profile* const profile =
+      gateway_binding ? gateway_binding->profile.get() : nullptr;
+  BrowserWindowInterface* const browser =
+      gateway_binding ? gateway_binding->browser.get() : nullptr;
+  if (!profile || profile != expected_profile.get() ||
+      !profile->IsRegularProfile() || profile->IsOffTheRecord() || !browser ||
+      browser->IsDeleteScheduled() ||
+      browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      browser->GetProfile() != profile || gateway_binding->stable_tab_id <= 0) {
+    return std::nullopt;
+  }
+
+  tabs::TabInterface* const tab =
+      tabs::TabHandle(gateway_binding->stable_tab_id).Get();
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  content::RenderFrameHost* const frame =
+      contents ? contents->GetPrimaryMainFrame() : nullptr;
+  if (!tab ||
+      tab->GetHandle().raw_value() != gateway_binding->stable_tab_id ||
+      tab->GetBrowserWindowInterface() != browser || !contents || !frame ||
+      !frame->IsActive() || !frame->IsRenderFrameLive() ||
+      contents->GetBrowserContext() != profile ||
+      !contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) {
+    return std::nullopt;
+  }
+
+  std::optional<std::string> document_identity =
+      optimization_guide::DocumentIdentifierUserData::GetDocumentIdentifier(
+          frame->GetGlobalFrameToken());
+  PrometheusAgentTabData* const tab_data =
+      PrometheusAgentTabData::From(tab);
+  PrometheusSupervisionProfileService* const service =
+      PrometheusSupervisionProfileServiceFactory::GetForProfile(profile);
+  if (!document_identity || document_identity->empty() || !tab_data ||
+      tab_data->owner_session_id() != requesting_session_id || !service) {
+    return std::nullopt;
+  }
+
+  return ResolvedSupervisionTestBinding{
+      .facts =
+          {
+              .profile_identity = OpaquePointerIdentity(profile),
+              .browser_identity = OpaquePointerIdentity(browser),
+              .stable_tab_id = gateway_binding->stable_tab_id,
+              .expected_origin =
+                  url::Origin::Create(contents->GetLastCommittedURL())
+                      .Serialize(),
+              .document_identity = std::move(*document_identity),
+              .owner_session_id = std::string(requesting_session_id),
+              .profile_live = true,
+              .browser_live = true,
+              .target_live = true,
+              .document_live = true,
+              .is_regular_profile = true,
+              .is_off_the_record = false,
+          },
+      .browser = browser,
+      .tab = tab,
+      .service = service->GetWeakPtr(),
+  };
+}
+
+bool SameSupervisionTestBinding(
+    const PrometheusSupervisionTestBindingFacts& left,
+    const PrometheusSupervisionTestBindingFacts& right) {
+  return left.profile_identity == right.profile_identity &&
+         left.browser_identity == right.browser_identity &&
+         left.stable_tab_id == right.stable_tab_id &&
+         left.expected_origin == right.expected_origin &&
+         left.document_identity == right.document_identity &&
+         left.owner_session_id == right.owner_session_id &&
+         left.profile_live == right.profile_live &&
+         left.browser_live == right.browser_live &&
+         left.target_live == right.target_live &&
+         left.document_live == right.document_live &&
+         left.is_regular_profile == right.is_regular_profile &&
+         left.is_off_the_record == right.is_off_the_record;
+}
+
+std::optional<PrometheusSupervisionTestBindingFacts>
+ResolveSupervisionTestBindingFacts(
+    PrometheusAgentGateway* gateway,
+    base::WeakPtr<Profile> expected_profile,
+    std::string_view requesting_session_id) {
+  std::optional<ResolvedSupervisionTestBinding> resolved =
+      ResolveExactSupervisionTestBinding(gateway, std::move(expected_profile),
+                                         requesting_session_id);
+  return resolved ? std::optional(std::move(resolved->facts)) : std::nullopt;
+}
+
+std::optional<std::string> CreateExactSupervisionTestPairingCode(
+    PrometheusAgentGateway* gateway,
+    base::WeakPtr<Profile> expected_profile,
+    const PrometheusSupervisionTestBindingFacts& pinned_binding) {
+  std::optional<ResolvedSupervisionTestBinding> resolved =
+      ResolveExactSupervisionTestBinding(
+          gateway, std::move(expected_profile),
+          pinned_binding.owner_session_id);
+  if (!resolved || !SameSupervisionTestBinding(resolved->facts,
+                                               pinned_binding) ||
+      !resolved->service) {
+    return std::nullopt;
+  }
+  SupervisionPairingCreationResult creation =
+      resolved->service->CreatePairing(resolved->browser, resolved->tab);
+  if (!creation.ok || creation.stable_tab_id != pinned_binding.stable_tab_id ||
+      creation.pairing_code.size() != 8u ||
+      !IsValidSupervisionPairingCode(creation.pairing_code)) {
+    if (creation.ok && creation.stable_tab_id > 0) {
+      resolved->service->CancelPairing(creation.stable_tab_id);
+    }
+    std::ranges::fill(creation.pairing_code, '\0');
+    creation.pairing_code.clear();
+    return std::nullopt;
+  }
+  std::string formatted_code =
+      creation.pairing_code.substr(0, 4) + "-" +
+      creation.pairing_code.substr(4, 4);
+  std::ranges::fill(creation.pairing_code, '\0');
+  creation.pairing_code.clear();
+  return formatted_code;
+}
