+
+TEST_F(PrometheusRuntimeProfileServiceTest,
+       PrincipalRejectsWrongWindowTabAndProfile) {
+  RuntimeSubmitRequest wrong_window = Request();
+  wrong_window.authority.exact_browser = other_browser();
+  EXPECT_EQ(RuntimeProfileStatus::kTargetLost,
+            service_->SubmitTask(std::move(wrong_window)).status);
+
+  RuntimeSubmitRequest wrong_tab = Request();
+  wrong_tab.authority.stable_tab_id = 99;
+  EXPECT_EQ(RuntimeProfileStatus::kTargetLost,
+            service_->SubmitTask(std::move(wrong_tab)).status);
+
+  RuntimeSubmitRequest wrong_profile = Request();
+  wrong_profile.authority.caller_id = "other-profile";
+  EXPECT_EQ(RuntimeProfileStatus::kUnauthorized,
+            service_->SubmitTask(std::move(wrong_profile)).status);
+}
