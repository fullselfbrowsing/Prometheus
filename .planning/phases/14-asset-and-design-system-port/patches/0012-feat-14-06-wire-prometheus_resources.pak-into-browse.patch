diff --git a/chrome/browser/prometheus/prometheus_asset_resource_unittest.cc b/chrome/browser/prometheus/prometheus_asset_resource_unittest.cc
index b228419ca4..5b23c5bcd8 100644
--- a/chrome/browser/prometheus/prometheus_asset_resource_unittest.cc
+++ b/chrome/browser/prometheus/prometheus_asset_resource_unittest.cc
@@ -2,43 +2,97 @@
 // Use of this source code is governed by a BSD-style license that can be
 // found in the LICENSE file.
 
-// Wave 0 RED tests: these tests verify that Prometheus resource bundle IDR
-// constants resolve to non-null data. All tests are RED until Plans 14-04
-// (fonts) and 14-05 (icons/marks) register the IDR constants and pak resources.
-// Tests use EXPECT_TRUE(false) stubs to clearly fail with a descriptive message.
+#include <memory>
 
+#include "base/files/file_path.h"
+#include "base/path_service.h"
+#include "chrome/grit/prometheus_resources.h"
 #include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/resource/resource_bundle.h"
+#include "ui/base/resource/resource_scale_factor.h"
 
-// Font resource tests (DESIGN-03) — RED until Plan 14-04
+namespace {
 
-// Verifies IDR_PROMETHEUS_FONT_POPPINS_THIN_WOFF2 resolves to non-null data.
-TEST(PrometheusAssetResourceTest, FontResourcePoppinsThinResolves) {
-  EXPECT_TRUE(false)
-      << "IDR_PROMETHEUS_FONT_POPPINS_THIN_WOFF2 not registered yet "
-         "-- RED until Plan 14-04 adds Poppins pak resources";
-}
+struct PrometheusResourceExpectation {
+  int id;
+  const char* name;
+};
+
+class PrometheusAssetResourceTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    resource_bundle_ = std::make_unique<ui::ResourceBundle>(nullptr);
+
+    base::FilePath pak_path;
+    ASSERT_TRUE(base::PathService::Get(base::DIR_ASSETS, &pak_path));
+    pak_path = pak_path.AppendASCII("prometheus_resources.pak");
+    resource_bundle_->AddDataPackFromPath(pak_path, ui::kScaleFactorNone);
+  }
+
+  void TearDown() override { resource_bundle_.reset(); }
+
+  void ExpectNonEmptyResource(const PrometheusResourceExpectation& resource) {
+    EXPECT_TRUE(resource_bundle_->HasDataResource(resource.id))
+        << resource.name;
+    EXPECT_GT(resource_bundle_->GetRawDataResource(resource.id).size(), 0u)
+        << resource.name;
+  }
+
+ private:
+  std::unique_ptr<ui::ResourceBundle> resource_bundle_;
+};
 
-// Verifies IDR_PROMETHEUS_FONT_SPACE_MONO_WOFF2 resolves to non-null data.
-TEST(PrometheusAssetResourceTest, FontResourceSpaceMonoResolves) {
-  EXPECT_TRUE(false)
-      << "IDR_PROMETHEUS_FONT_SPACE_MONO_WOFF2 not registered yet "
-         "-- RED until Plan 14-04 adds Space Mono pak resources";
+constexpr PrometheusResourceExpectation kFontResources[] = {
+    {IDR_PROMETHEUS_FONT_POPPINS_THIN_WOFF2,
+     "IDR_PROMETHEUS_FONT_POPPINS_THIN_WOFF2"},
+    {IDR_PROMETHEUS_FONT_POPPINS_LIGHT_WOFF2,
+     "IDR_PROMETHEUS_FONT_POPPINS_LIGHT_WOFF2"},
+    {IDR_PROMETHEUS_FONT_POPPINS_EXTRABOLD_WOFF2,
+     "IDR_PROMETHEUS_FONT_POPPINS_EXTRABOLD_WOFF2"},
+    {IDR_PROMETHEUS_FONT_POPPINS_BLACK_WOFF2,
+     "IDR_PROMETHEUS_FONT_POPPINS_BLACK_WOFF2"},
+    {IDR_PROMETHEUS_FONT_SPACE_MONO_WOFF2,
+     "IDR_PROMETHEUS_FONT_SPACE_MONO_WOFF2"},
+};
+
+constexpr PrometheusResourceExpectation kBrandAssetResources[] = {
+    {IDR_PROMETHEUS_ASSET_PM_MARK_DARK, "IDR_PROMETHEUS_ASSET_PM_MARK_DARK"},
+    {IDR_PROMETHEUS_ASSET_PM_MARK_LIGHT, "IDR_PROMETHEUS_ASSET_PM_MARK_LIGHT"},
+    {IDR_PROMETHEUS_ASSET_PM_WORDMARK_DARK,
+     "IDR_PROMETHEUS_ASSET_PM_WORDMARK_DARK"},
+    {IDR_PROMETHEUS_ASSET_PM_WORDMARK_LIGHT,
+     "IDR_PROMETHEUS_ASSET_PM_WORDMARK_LIGHT"},
+    {IDR_PROMETHEUS_ASSET_FSB_LOGO_DARK, "IDR_PROMETHEUS_ASSET_FSB_LOGO_DARK"},
+    {IDR_PROMETHEUS_ASSET_FSB_LOGO_LIGHT,
+     "IDR_PROMETHEUS_ASSET_FSB_LOGO_LIGHT"},
+    {IDR_PROMETHEUS_ASSET_FSB_ICON, "IDR_PROMETHEUS_ASSET_FSB_ICON"},
+};
+
+}  // namespace
+
+TEST_F(PrometheusAssetResourceTest, FontResourcePoppinsThinResolves) {
+  ExpectNonEmptyResource({IDR_PROMETHEUS_FONT_POPPINS_THIN_WOFF2,
+                          "IDR_PROMETHEUS_FONT_POPPINS_THIN_WOFF2"});
 }
 
-// Icon resource tests (DESIGN-04) — RED until Plan 14-05
+TEST_F(PrometheusAssetResourceTest, FontResourceSpaceMonoResolves) {
+  ExpectNonEmptyResource({IDR_PROMETHEUS_FONT_SPACE_MONO_WOFF2,
+                          "IDR_PROMETHEUS_FONT_SPACE_MONO_WOFF2"});
+}
 
-// Verifies IDR_PROMETHEUS_ICON_FA_BOLT resolves to non-null data.
-TEST(PrometheusAssetResourceTest, IconResourceFaBoltResolves) {
-  EXPECT_TRUE(false)
-      << "IDR_PROMETHEUS_ICON_FA_BOLT not registered yet "
-         "-- RED until Plan 14-05 adds FA icon resources";
