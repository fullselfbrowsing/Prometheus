+enum class RuntimePolicyDecision {
+  kAllowed,
+  kTaskCapReached,
+  kAgentCapReached,
+  kTabOwnershipRequired,
+  kInternalSurfaceDenied,
+  kBackgroundActionDenied,
+  kTelemetryDisabled,
+};
