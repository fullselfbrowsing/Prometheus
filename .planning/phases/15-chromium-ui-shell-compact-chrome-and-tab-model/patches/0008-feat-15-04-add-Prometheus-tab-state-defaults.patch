diff --git a/chrome/browser/prometheus/prometheus_tab_state.h b/chrome/browser/prometheus/prometheus_tab_state.h
new file mode 100644
index 0000000000..45073b9e56
--- /dev/null
+++ b/chrome/browser/prometheus/prometheus_tab_state.h
@@ -0,0 +1,31 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PROMETHEUS_PROMETHEUS_TAB_STATE_H_
+#define CHROME_BROWSER_PROMETHEUS_PROMETHEUS_TAB_STATE_H_
+
+#include <string>
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+struct PrometheusTabState {
+  enum class Health {
+    kOk,
+    kNeedsAttention,
+  };
+
+  static PrometheusTabState SafeDefault();
+
+  std::string owner_label;
+  bool automation_active = false;
+  bool supervision_active = false;
+  Health health = Health::kOk;
+};
+
+PrometheusTabState GetPrometheusTabStateForWebContents(
+    content::WebContents* web_contents);
+
+#endif  // CHROME_BROWSER_PROMETHEUS_PROMETHEUS_TAB_STATE_H_
diff --git a/chrome/browser/prometheus/prometheus_tab_state_unittest.cc b/chrome/browser/prometheus/prometheus_tab_state_unittest.cc
new file mode 100644
index 0000000000..af5c20735a
--- /dev/null
+++ b/chrome/browser/prometheus/prometheus_tab_state_unittest.cc
@@ -0,0 +1,56 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_tab_state.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/supports_user_data.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/test_renderer_host.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace {
+
+class CallerProvidedLabelUserData : public base::SupportsUserData::Data {
+ public:
+  explicit CallerProvidedLabelUserData(std::string label)
+      : label_(std::move(label)) {}
+
+  const std::string& label() const { return label_; }
+
+ private:
+  std::string label_;
+};
+
+}  // namespace
+
+TEST(PrometheusTabStateTest, SafeDefaultHasNoOwner) {
+  const PrometheusTabState state = PrometheusTabState::SafeDefault();
+
+  EXPECT_TRUE(state.owner_label.empty());
+  EXPECT_FALSE(state.automation_active);
+  EXPECT_FALSE(state.supervision_active);
+  EXPECT_EQ(PrometheusTabState::Health::kOk, state.health);
+}
+
+class PrometheusTabStateWebContentsTest
+    : public content::RenderViewHostTestHarness {};
+
+TEST_F(PrometheusTabStateWebContentsTest, DoesNotTrustCallerProvidedLabel) {
+  constexpr int kCallerProvidedLabelKey = 0;
+  web_contents()->SetUserData(
+      &kCallerProvidedLabelKey,
+      std::make_unique<CallerProvidedLabelUserData>("Injected owner"));
+
+  const PrometheusTabState state =
+      GetPrometheusTabStateForWebContents(web_contents());
+
+  EXPECT_TRUE(state.owner_label.empty());
+  EXPECT_FALSE(state.automation_active);
+  EXPECT_FALSE(state.supervision_active);
+  EXPECT_EQ(PrometheusTabState::Health::kOk, state.health);
+}
