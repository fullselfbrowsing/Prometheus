+class WebContents;
+}
+
+namespace tabs {
+class TabInterface;
+}
+
+namespace prometheus {
+
+class PrometheusExtensionPolicyService;
+
+enum class PrometheusExtensionSurfaceKind {
+  kTab,
+  kOptionsPage,
+  kPopup,
+  kSidePanel,
+  kOptionsGuest,
+};
+
+enum class PrometheusExtensionObservedContext {
+  kTabContents,
+  kPopup,
+  kSidePanel,
+  kOptionsGuest,
+  kBackgroundPage,
+  kBackgroundContents,
+  kOffscreenDocument,
+  kDeveloperTools,
+  kUnknown,
+};
+
+enum class PrometheusExtensionSurfaceDenial {
+  kNone,
+  kNoSelectorMatch,
+  kAmbiguousSelectorMatch,
+  kWrongSelectorKind,
+  kWrongBrowser,
+  kWrongBrowserContext,
+  kUncommittedPrimaryFrame,
+  kMismatchedExtensionOrigin,
+  kUnsupportedContext,
+  kHiddenSurface,
+  kUnownedSurface,
+  kAmbiguousOptionsGuest,
+  kSystemUnavailable,
+  kExtensionUnavailable,
+  kStaleGeneration,
+  kLifecycleLost,
+};
+
+struct PrometheusExtensionSurfaceEvidence {
+  std::optional<AgentExtensionSurfaceSelector> selector;
+  PrometheusExtensionObservedContext observed_context =
+      PrometheusExtensionObservedContext::kUnknown;
+  size_t selector_match_count = 1;
+  bool exact_browser = true;
+  bool exact_browser_context = true;
+  bool primary_frame_committed = true;
+  bool extension_origin = true;
+  bool origin_matches_browser_identity = true;
+  bool extension_system_ready = true;
+  bool extension_enabled = true;
+  bool extension_terminated = false;
+  bool visible = true;
+  bool browser_ui_owned = true;
+  bool options_page = false;
+  bool options_guest_primary_frame = true;
+  bool options_guest_ambiguous = false;
+  bool lifecycle_alive = true;
+  uint64_t policy_generation = 1;
+  std::optional<uint64_t> expected_policy_generation;
+};
+
+struct PrometheusExtensionSurfaceClassification {
+  std::optional<PrometheusExtensionSurfaceKind> kind;
+  PrometheusExtensionSurfaceDenial denial =
+      PrometheusExtensionSurfaceDenial::kNone;
+  AgentErrorCode error_code = AgentErrorCode::kNone;
+
+  bool accepted() const { return kind.has_value(); }
+};
+
+struct PrometheusResolvedExtensionSurface {
+  std::string extension_id;
+  PrometheusExtensionSurfaceKind kind =
+      PrometheusExtensionSurfaceKind::kTab;
+  uint64_t policy_generation = 0;
+  bool private_mode = false;
+  base::WeakPtr<tabs::TabInterface> anchor_tab;
+  base::WeakPtr<content::WebContents> web_contents;
+  content::GlobalRenderFrameHostId primary_frame_id;
+};
+
+class PrometheusExtensionSurfaceResolver {
+ public:
+  explicit PrometheusExtensionSurfaceResolver(
+      PrometheusExtensionPolicyService* policy_service);
+  PrometheusExtensionSurfaceResolver(
+      const PrometheusExtensionSurfaceResolver&) = delete;
+  PrometheusExtensionSurfaceResolver& operator=(
+      const PrometheusExtensionSurfaceResolver&) = delete;
+  ~PrometheusExtensionSurfaceResolver();
+
+  base::expected<PrometheusResolvedExtensionSurface, AgentRouteResult> Resolve(
+      Browser* browser,
+      tabs::TabInterface* anchor_tab,
+      std::optional<AgentExtensionSurfaceSelector> selector,
+      std::optional<uint64_t> expected_policy_generation = std::nullopt) const;
+
+  static PrometheusExtensionSurfaceClassification ClassifyEvidenceForTesting(
+      const PrometheusExtensionSurfaceEvidence& evidence);
+
+ private:
+  raw_ptr<PrometheusExtensionPolicyService> policy_service_;
+};
+
+bool ExtensionSurfaceResolutionContractImplementedForTesting();
+
+}  // namespace prometheus
+
+#endif  // CHROME_BROWSER_PROMETHEUS_PROMETHEUS_EXTENSION_SURFACE_RESOLVER_H_
