+      prometheus::SupervisionRemoteActionState::kAwaitingConfirmation,
+      prometheus::SupervisionRemoteActionCategory::kNavigate));
+
+  TabSupervision state = ProjectPrometheusTabSupervisionState(snapshot);
+  EXPECT_EQ(TabSupervision::ResyncState::kResyncing, state.resync_state);
