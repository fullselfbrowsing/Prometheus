+++ b/chrome/browser/prometheus/prometheus_runtime_tool_contract.cc
@@ -0,0 +1,302 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_runtime_tool_contract.h"
+
+#include <algorithm>
+#include <array>
+#include <initializer_list>
+#include <limits>
+#include <utility>
+
+#include "base/notreached.h"
+#include "base/strings/string_util.h"
+
+namespace prometheus {
+namespace {
+
+constexpr size_t kMaxToolElementRefBytes = 4096;
+constexpr size_t kMaxToolTextBytes = 20000;
+constexpr size_t kMaxToolKeyBytes = 128;
+constexpr int kMaxToolReadChars = 200000;
+constexpr int kMaxToolReadNodes = 10000;
+
+constexpr std::array<RuntimeSafeTool, 9> kRuntimeSafeTools = {
+    RuntimeSafeTool::kReadPage, RuntimeSafeTool::kGetPageSnapshot,
+    RuntimeSafeTool::kClick,    RuntimeSafeTool::kTypeText,
+    RuntimeSafeTool::kPressKey, RuntimeSafeTool::kScroll,
+    RuntimeSafeTool::kHover,    RuntimeSafeTool::kSelectOption,
+    RuntimeSafeTool::kClear,
+};
+
+bool HasOnlyKeys(const base::DictValue& arguments,
+                 std::initializer_list<std::string_view> allowed) {
+  for (const auto [key, ignored] : arguments) {
+    static_cast<void>(ignored);
+    if (std::find(allowed.begin(), allowed.end(), key) == allowed.end()) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool IsBoundedString(const std::string* value,
+                     size_t max_bytes,
+                     bool allow_empty = false) {
+  return value && (allow_empty || !value->empty()) &&
+         value->size() <= max_bytes && base::IsStringUTF8(*value);
+}
+
+base::DictValue StringProperty(size_t max_length, bool allow_empty = false) {
+  base::DictValue property;
+  property.Set("type", "string");
+  if (!allow_empty) {
+    property.Set("minLength", 1);
+  }
+  property.Set("maxLength", static_cast<int>(max_length));
+  return property;
+}
+
+base::DictValue IntegerProperty(int minimum, int maximum) {
+  base::DictValue property;
+  property.Set("type", "integer");
+  property.Set("minimum", minimum);
+  property.Set("maximum", maximum);
+  return property;
+}
+
+}  // namespace
+
+std::string_view RuntimeSafeToolToString(RuntimeSafeTool tool) {
+  switch (tool) {
+    case RuntimeSafeTool::kReadPage:
+      return "read_page";
+    case RuntimeSafeTool::kGetPageSnapshot:
+      return "get_page_snapshot";
+    case RuntimeSafeTool::kClick:
+      return "click";
+    case RuntimeSafeTool::kTypeText:
+      return "type_text";
+    case RuntimeSafeTool::kPressKey:
+      return "press_key";
+    case RuntimeSafeTool::kScroll:
+      return "scroll";
+    case RuntimeSafeTool::kHover:
+      return "hover";
+    case RuntimeSafeTool::kSelectOption:
+      return "select_option";
+    case RuntimeSafeTool::kClear:
+      return "clear";
+  }
+  NOTREACHED();
+}
+
+std::optional<RuntimeSafeTool> RuntimeSafeToolFromString(
+    std::string_view name) {
+  for (RuntimeSafeTool tool : kRuntimeSafeTools) {
+    if (RuntimeSafeToolToString(tool) == name) {
+      return tool;
+    }
+  }
+  return std::nullopt;
+}
+
+AgentRouteName RouteForRuntimeSafeTool(RuntimeSafeTool tool) {
+  switch (tool) {
+    case RuntimeSafeTool::kReadPage:
+      return AgentRouteName::kReadPage;
+    case RuntimeSafeTool::kGetPageSnapshot:
+      return AgentRouteName::kGetPageSnapshot;
+    case RuntimeSafeTool::kClick:
+      return AgentRouteName::kClick;
+    case RuntimeSafeTool::kTypeText:
+      return AgentRouteName::kTypeText;
+    case RuntimeSafeTool::kPressKey:
+      return AgentRouteName::kPressKey;
+    case RuntimeSafeTool::kScroll:
+      return AgentRouteName::kScroll;
+    case RuntimeSafeTool::kHover:
+      return AgentRouteName::kHover;
+    case RuntimeSafeTool::kSelectOption:
+      return AgentRouteName::kSelectOption;
+    case RuntimeSafeTool::kClear:
+      return AgentRouteName::kClear;
+  }
+  NOTREACHED();
+}
+
+ProviderToolDefinition MakeRuntimeSafeToolDefinition(RuntimeSafeTool tool) {
+  base::DictValue properties;
+  base::ListValue required;
+  if (tool == RuntimeSafeTool::kReadPage ||
+      tool == RuntimeSafeTool::kGetPageSnapshot) {
+    properties.Set("max_chars",
+                   IntegerProperty(/*minimum=*/1, kMaxToolReadChars));
+    properties.Set("max_nodes",
+                   IntegerProperty(/*minimum=*/1, kMaxToolReadNodes));
+    base::DictValue compact;
+    compact.Set("type", "boolean");
+    properties.Set("compact", std::move(compact));
+  } else {
+    properties.Set("element_ref", StringProperty(kMaxToolElementRefBytes));
+    required.Append("element_ref");
+    switch (tool) {
+      case RuntimeSafeTool::kTypeText:
+        properties.Set("text", StringProperty(kMaxToolTextBytes,
+                                              /*allow_empty=*/true));
+        required.Append("text");
+        break;
+      case RuntimeSafeTool::kPressKey:
+        properties.Set("key", StringProperty(kMaxToolKeyBytes));
+        required.Append("key");
+        break;
+      case RuntimeSafeTool::kScroll:
+        properties.Set("scroll_delta_x",
+                       IntegerProperty(std::numeric_limits<int>::min(),
+                                       std::numeric_limits<int>::max()));
+        properties.Set("scroll_delta_y",
+                       IntegerProperty(std::numeric_limits<int>::min(),
+                                       std::numeric_limits<int>::max()));
+        required.Append("scroll_delta_y");
+        break;
+      case RuntimeSafeTool::kSelectOption:
+        properties.Set("option_value", StringProperty(kMaxToolElementRefBytes));
+        required.Append("option_value");
+        break;
+      case RuntimeSafeTool::kReadPage:
+      case RuntimeSafeTool::kGetPageSnapshot:
+        NOTREACHED();
+      case RuntimeSafeTool::kClick:
+      case RuntimeSafeTool::kHover:
+      case RuntimeSafeTool::kClear:
+        break;
+    }
+  }
+
+  ProviderToolDefinition definition;
+  definition.name = RuntimeSafeToolToString(tool);
+  definition.description = "Closed browser-owned page operation";
+  definition.input_schema.Set("type", "object");
+  definition.input_schema.Set("properties", std::move(properties));
+  definition.input_schema.Set("required", std::move(required));
+  definition.input_schema.Set("additionalProperties", false);
+  return definition;
+}
+
+std::vector<ProviderToolDefinition> MakeRuntimeSafeToolDefinitions() {
+  std::vector<ProviderToolDefinition> definitions;
+  definitions.reserve(kRuntimeSafeTools.size());
+  for (RuntimeSafeTool tool : kRuntimeSafeTools) {
+    definitions.push_back(MakeRuntimeSafeToolDefinition(tool));
+  }
+  return definitions;
+}
+
+std::optional<AgentRouteRequest> ParseRuntimeSafeToolArguments(
+    RuntimeSafeTool tool,
+    const base::DictValue& arguments) {
+  AgentRouteRequest route;
+  route.route_name = RouteForRuntimeSafeTool(tool);
+  route.foreground = true;
+
+  if (tool == RuntimeSafeTool::kReadPage ||
+      tool == RuntimeSafeTool::kGetPageSnapshot) {
+    if (!HasOnlyKeys(arguments, {"max_chars", "max_nodes", "compact"})) {
+      return std::nullopt;
+    }
+    std::optional<int> max_chars = arguments.FindInt("max_chars");
+    std::optional<int> max_nodes = arguments.FindInt("max_nodes");
+    std::optional<bool> compact = arguments.FindBool("compact");
+    if ((arguments.contains("max_chars") && !max_chars) ||
+        (arguments.contains("max_nodes") && !max_nodes) ||
+        (arguments.contains("compact") && !compact) ||
+        (max_chars && (*max_chars < 1 || *max_chars > kMaxToolReadChars)) ||
+        (max_nodes && (*max_nodes < 1 || *max_nodes > kMaxToolReadNodes))) {
+      return std::nullopt;
+    }
+    route.page_request.emplace();
+    if (max_chars) {
+      route.page_request->read_options.max_chars =
+          static_cast<size_t>(*max_chars);
+    }
+    if (max_nodes) {
+      route.page_request->read_options.max_nodes =
+          static_cast<size_t>(*max_nodes);
+    }
+    route.page_request->read_options.compact = compact.value_or(false);
+    return route;
+  }
+
+  const std::string* element_ref = arguments.FindString("element_ref");
+  if (!IsBoundedString(element_ref, kMaxToolElementRefBytes)) {
+    return std::nullopt;
+  }
+  route.page_request.emplace();
+  route.page_request->action.element.element_ref = *element_ref;
+  route.page_request->verify_mutation = true;
+
+  switch (tool) {
+    case RuntimeSafeTool::kClick:
+    case RuntimeSafeTool::kHover:
+    case RuntimeSafeTool::kClear:
+      if (!HasOnlyKeys(arguments, {"element_ref"})) {
+        return std::nullopt;
+      }
+      break;
+    case RuntimeSafeTool::kTypeText: {
+      if (!HasOnlyKeys(arguments, {"element_ref", "text"})) {
+        return std::nullopt;
+      }
+      const std::string* text = arguments.FindString("text");
+      if (!IsBoundedString(text, kMaxToolTextBytes, /*allow_empty=*/true)) {
+        return std::nullopt;
+      }
+      route.page_request->action.text = *text;
+      break;
+    }
+    case RuntimeSafeTool::kPressKey: {
+      if (!HasOnlyKeys(arguments, {"element_ref", "key"})) {
+        return std::nullopt;
+      }
+      const std::string* key = arguments.FindString("key");
+      if (!IsBoundedString(key, kMaxToolKeyBytes)) {
+        return std::nullopt;
+      }
+      route.page_request->action.key = *key;
+      break;
+    }
+    case RuntimeSafeTool::kScroll: {
+      if (!HasOnlyKeys(arguments,
+                       {"element_ref", "scroll_delta_x", "scroll_delta_y"})) {
+        return std::nullopt;
+      }
+      std::optional<int> delta_x = arguments.FindInt("scroll_delta_x");
+      std::optional<int> delta_y = arguments.FindInt("scroll_delta_y");
+      if ((arguments.contains("scroll_delta_x") && !delta_x) ||
+          (arguments.contains("scroll_delta_y") && !delta_y) || !delta_y) {
+        return std::nullopt;
+      }
+      route.page_request->action.scroll_delta_x = delta_x;
+      route.page_request->action.scroll_delta_y = delta_y;
+      break;
+    }
+    case RuntimeSafeTool::kSelectOption: {
+      if (!HasOnlyKeys(arguments, {"element_ref", "option_value"})) {
+        return std::nullopt;
+      }
+      const std::string* option_value = arguments.FindString("option_value");
+      if (!IsBoundedString(option_value, kMaxToolElementRefBytes)) {
+        return std::nullopt;
+      }
+      route.page_request->action.option_value = *option_value;
+      break;
+    }
+    case RuntimeSafeTool::kReadPage:
+    case RuntimeSafeTool::kGetPageSnapshot:
+      NOTREACHED();
+  }
+  return route;
+}
