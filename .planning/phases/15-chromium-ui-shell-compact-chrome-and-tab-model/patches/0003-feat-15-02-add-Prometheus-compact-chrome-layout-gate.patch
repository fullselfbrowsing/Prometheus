+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_PROMETHEUS_COMPACT_CHROME_LAYOUT_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_PROMETHEUS_COMPACT_CHROME_LAYOUT_H_
+
+#include "chrome/browser/ui/views/frame/layout/browser_view_layout_params.h"
+
+inline constexpr int kPrometheusCompactChromeHeight = 50;
+inline constexpr int kPrometheusCompactMinLocationWidth = 240;
+
+struct PrometheusCompactChromeAllocation {
+  int reserved_control_width = 0;
+  int available_location_width = 0;
+  bool protects_min_location_width = false;
+};
+
+PrometheusCompactChromeAllocation CalculatePrometheusCompactChromeAllocation(
+    const BrowserLayoutParams& params);
+
+void ApplyPrometheusCompactChromeReservation(BrowserLayoutParams& params);
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_PROMETHEUS_COMPACT_CHROME_LAYOUT_H_
