+SanitizedSupervisionSnapshot
+PrometheusSupervisionProfileService::BuildSanitizedSnapshot(
+    int32_t stable_tab_id) const {
+  SanitizedSupervisionSnapshot snapshot;
+  auto pairing = pending_pairings_.find(stable_tab_id);
+  auto last_pairing = last_pairing_states_.find(stable_tab_id);
+  if (pairing != pending_pairings_.end()) {
+    snapshot.pairing_state = pairing->second->state;
+  } else if (last_pairing != last_pairing_states_.end()) {
+    snapshot.pairing_state = last_pairing->second;
+  }
+
+  tabs::TabInterface* tab = nullptr;
+  PrometheusAgentTabData* data = nullptr;
+  auto observed = observed_tabs_.find(stable_tab_id);
+  if (observed != observed_tabs_.end()) {
+    tab = observed->second->tab;
+    data = observed->second->lease.data();
+  }
+  snapshot.target.safe_title = SafeTitle(tab);
+  snapshot.target.safe_origin = SafeOrigin(tab);
+  snapshot.target.eligible = tab && tab->GetProfile() == profile_ &&
+                             tab->GetURL().is_valid() &&
+                             tab->GetURL().SchemeIsHTTPOrHTTPS();
+  snapshot.target.agent_active = data && !data->owner_session_id().empty();
+  if (data && !data->owner_label().empty()) {
+    snapshot.target.owner_label =
+        DeriveSupervisionSafeClientLabel(data->owner_label());
+  }
+  snapshot.target.viewer_count = viewer_count_for_testing(stable_tab_id);
+  auto controller = controllers_.find(stable_tab_id);
+  if (controller != controllers_.end()) {
+    auto controller_viewer = viewers_.find(controller->second);
+    if (controller_viewer != viewers_.end()) {
+      snapshot.target.controller_label =
+          controller_viewer->second->client_label;
+    }
+  }
+
+  for (const auto& [dashboard_session, viewer] : viewers_) {
+    if (viewer->stable_tab_id != stable_tab_id ||
+        snapshot.sessions.size() >= limits_.sessions_per_profile) {
+      continue;
+    }
+    SupervisionSessionSnapshot session;
+    session.client.display_label = viewer->client_label;
+    session.client.connected_at_ms =
+        viewer->connected_at.InMillisecondsSinceUnixEpoch();
+    session.client.last_seen_at_ms =
+        viewer->last_seen_at.InMillisecondsSinceUnixEpoch();
+    session.client.expires_at_ms =
+        viewer->expires_at.InMillisecondsSinceUnixEpoch();
+    session.viewer_state = viewer->viewer_state;
+    session.stream_state = viewer->stream_state;
+    session.terminal_reason = viewer->terminal_reason;
+    snapshot.sessions.push_back(std::move(session));
+  }
+  for (const RecentTerminalSession& recent : recent_terminal_sessions_) {
+    if (recent.stable_tab_id == stable_tab_id &&
+        snapshot.sessions.size() < limits_.sessions_per_profile) {
+      snapshot.sessions.push_back(recent.snapshot);
+    }
+  }
+  for (const auto& [audit_tab_id, row] : audit_) {
+    if (audit_tab_id == stable_tab_id) {
+      snapshot.audit.push_back(row);
+    }
+  }
+  return snapshot;
 }
 
