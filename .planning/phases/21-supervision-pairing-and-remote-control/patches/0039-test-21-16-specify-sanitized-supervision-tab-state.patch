+  prometheus::SanitizedSupervisionSnapshot snapshot;
+  snapshot.target.eligible = true;
+  snapshot.target.agent_active = true;
+  snapshot.target.viewer_count = 1;
+  snapshot.target.controller_label = "Reviewer";
+  snapshot.sessions.push_back(MakeSession(
