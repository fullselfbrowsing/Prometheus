+using optimization_guide::proto::AnnotatedPageContent;
+using optimization_guide::proto::ContentAttributeType;
+using optimization_guide::proto::ContentNode;
+using optimization_guide::proto::FormControlType;
+using optimization_guide::proto::RedactionDecision;
+
+void SetNode(ContentNode* node, int dom_node_id, ContentAttributeType type) {
+  auto* attributes = node->mutable_content_attributes();
+  attributes->set_common_ancestor_dom_node_id(dom_node_id);
+  attributes->set_attribute_type(type);
+}
+
+ContentNode* AddNode(ContentNode* parent,
+                     int dom_node_id,
+                     ContentAttributeType type) {
+  ContentNode* node = parent->add_children_nodes();
+  SetNode(node, dom_node_id, type);
+  return node;
+}
+
+AnnotatedPageContent MakePageContent() {
+  AnnotatedPageContent page_content;
+  page_content.mutable_main_frame_data()
+      ->mutable_document_identifier()
+      ->set_serialized_token("main-doc");
+  SetNode(page_content.mutable_root_node(), 1,
+          optimization_guide::proto::CONTENT_ATTRIBUTE_ROOT);
+  return page_content;
+}
+
+ContentNode* AddFormControl(AnnotatedPageContent* page_content,
+                            int dom_node_id,
+                            std::string value,
+                            FormControlType control_type,
+                            RedactionDecision redaction_decision) {
+  ContentNode* node =
+      AddNode(page_content->mutable_root_node(), dom_node_id,
+              optimization_guide::proto::CONTENT_ATTRIBUTE_FORM_CONTROL);
+  auto* attributes = node->mutable_content_attributes();
+  attributes->set_label("Field " + std::to_string(dom_node_id));
+  attributes->set_redaction_decision(redaction_decision);
+  auto* form = attributes->mutable_form_control_data();
+  form->set_field_name("field-" + std::to_string(dom_node_id));
+  form->set_field_value(std::move(value));
+  form->set_form_control_type(control_type);
+  attributes->mutable_interaction_info()->set_is_focusable(true);
+  return node;
+}
+
+const SupervisionNormalizedNode* FindNormalizedNode(
+    const SupervisionBaseline& baseline,
+    std::string_view ref) {
+  auto found =
+      std::ranges::find(baseline.nodes, ref, &SupervisionNormalizedNode::ref);
+  return found == baseline.nodes.end() ? nullptr : &*found;
+}
+
+const base::DictValue* FindSerializedNode(const SupervisionBaseline& baseline,
+                                          std::string_view ref) {
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(baseline.serialized_json, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    return nullptr;
+  }
+  const base::ListValue* nodes = parsed->GetDict().FindList("nodes");
+  if (!nodes) {
+    return nullptr;
+  }
+  for (const base::Value& value : *nodes) {
+    if (!value.is_dict()) {
+      continue;
+    }
+    const std::string* candidate = value.GetDict().FindString("ref");
+    if (candidate && *candidate == ref) {
+      return &value.GetDict();
+    }
+  }
+  return nullptr;
+}
+
+bool ContainsKeyOrString(const base::Value& value,
+                         const std::vector<std::string>& forbidden) {
+  if (value.is_string()) {
+    return std::ranges::find(forbidden, value.GetString()) != forbidden.end();
+  }
+  if (value.is_list()) {
+    for (const base::Value& child : value.GetList()) {
+      if (ContainsKeyOrString(child, forbidden)) {
+        return true;
+      }
+    }
+  }
+  if (value.is_dict()) {
+    for (const auto [key, child] : value.GetDict()) {
+      if (std::ranges::find(forbidden, key) != forbidden.end() ||
+          ContainsKeyOrString(child, forbidden)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
