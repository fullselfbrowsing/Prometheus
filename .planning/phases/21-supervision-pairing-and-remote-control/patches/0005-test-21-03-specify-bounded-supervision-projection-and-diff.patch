+TEST(PrometheusSupervisionProjectionTest,
+     OmitsPasswordCustomPaymentOtpAndUnknownSensitiveValues) {
+  AnnotatedPageContent page_content = MakePageContent();
+  AddFormControl(
+      &page_content, 2, "password-value-sentinel",
+      optimization_guide::proto::FORM_CONTROL_TYPE_INPUT_PASSWORD,
+      optimization_guide::proto::REDACTION_DECISION_NO_REDACTION_NECESSARY);
+  AddFormControl(&page_content, 3, "custom-password-value-sentinel",
+                 optimization_guide::proto::FORM_CONTROL_TYPE_INPUT_TEXT,
+                 optimization_guide::proto::
+                     REDACTION_DECISION_REDACTED_CUSTOM_PASSWORD_CSS);
+  ContentNode* payment = AddFormControl(
+      &page_content, 4, "payment-value-sentinel",
+      optimization_guide::proto::FORM_CONTROL_TYPE_INPUT_TEXT,
+      optimization_guide::proto::
+          REDACTION_DECISION_REDACTED_IS_SENSITIVE_PAYMENT_FIELD);
+  payment->mutable_content_attributes()
+      ->mutable_form_control_data()
+      ->add_coarse_autofill_field_type(
+          optimization_guide::proto::COARSE_AUTOFILL_FIELD_TYPE_CREDIT_CARD);
+  ContentNode* otp = AddFormControl(
+      &page_content, 5, "otp-value-sentinel",
+      optimization_guide::proto::FORM_CONTROL_TYPE_INPUT_TEXT,
+      optimization_guide::proto::REDACTION_DECISION_REDACTED_IS_OTP);
+  otp->mutable_content_attributes()
+      ->mutable_form_control_data()
+      ->add_coarse_autofill_field_type(
+          optimization_guide::proto::COARSE_AUTOFILL_FIELD_TYPE_OTP);
+  AddFormControl(&page_content, 6, "unknown-redaction-value-sentinel",
+                 optimization_guide::proto::FORM_CONTROL_TYPE_INPUT_TEXT,
+                 static_cast<RedactionDecision>(999));
+  AddFormControl(
+      &page_content, 7, "explicitly-safe-value",
+      optimization_guide::proto::FORM_CONTROL_TYPE_INPUT_TEXT,
+      optimization_guide::proto::REDACTION_DECISION_NO_REDACTION_NECESSARY);
+
+  const SupervisionBaseline baseline =
+      BuildSupervisionBaseline(page_content, "main-doc");
+
+  ASSERT_TRUE(baseline.authoritative());
+  for (int id = 2; id <= 6; ++id) {
+    const std::string ref = "main-doc:" + std::to_string(id);
+    const SupervisionNormalizedNode* node = FindNormalizedNode(baseline, ref);
+    ASSERT_NE(nullptr, node) << ref;
+    EXPECT_FALSE(node->input_value.has_value()) << ref;
+    const base::DictValue* serialized = FindSerializedNode(baseline, ref);
+    ASSERT_NE(nullptr, serialized) << ref;
+    EXPECT_EQ(nullptr, serialized->Find("input_value")) << ref;
+  }
+  const SupervisionNormalizedNode* safe =
+      FindNormalizedNode(baseline, "main-doc:7");
+  ASSERT_NE(nullptr, safe);
+  ASSERT_TRUE(safe->input_value.has_value());
+  EXPECT_EQ("explicitly-safe-value", *safe->input_value);
+
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(baseline.serialized_json, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(parsed.has_value());
+  EXPECT_FALSE(ContainsKeyOrString(
+      *parsed, {"password-value-sentinel", "custom-password-value-sentinel",
+                "payment-value-sentinel", "otp-value-sentinel",
+                "unknown-redaction-value-sentinel"}));
+}
