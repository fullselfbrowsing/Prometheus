-void PrometheusSupervisionActionController::ResolvePendingConfirmation(
-    bool allow_once) {
-  if (!pending_action_ || !pending_action_->awaiting_confirmation) {
+bool PrometheusSupervisionActionController::LaunchPendingConfirmation() {
+  if (!pending_action_ || !pending_action_->awaiting_confirmation ||
+      !dialog_launcher_ || !exact_browser_) {
+    return false;
+  }
+  tabs::TabInterface* const tab = stable_tab_.Get();
+  const std::string_view action_label =
+      DialogLabelForCategory(pending_action_->action.category);
+  if (!tab || tab->GetHandle() != stable_tab_ || action_label.empty()) {
+    return false;
+  }
+
+  PrometheusSupervisionDialogModel model;
+  model.kind = PrometheusSupervisionDialogKind::kConsequentialAction;
+  model.client_label = client_label_;
+  model.target_tab_title =
+      DeriveSupervisionSafeTargetTitle(base::UTF16ToUTF8(tab->GetTitle()));
+  model.site_origin = CanonicalizeSupervisionSafeOrigin(tab->GetURL().spec())
+                          .value_or(std::string(kUnavailableOrigin));
+  model.expires_label = controller_expires_label_;
+  model.action_label = std::string(action_label);
+  model.permission_boundary = "Page actions";
+  const uint64_t action_id = pending_action_->id;
+  return dialog_launcher_.Run(
+      exact_browser_.get(), model,
+      base::BindOnce(
+          &PrometheusSupervisionActionController::OnConfirmationResult,
+          weak_factory_.GetWeakPtr(), action_id));
+}
+
+void PrometheusSupervisionActionController::OnConfirmationResult(
+    uint64_t action_id,
+    PrometheusSupervisionDialogResult result) {
+  if (!pending_action_ || pending_action_->id != action_id ||
+      !pending_action_->awaiting_confirmation) {
     return;
   }
-  if (!allow_once) {
+  if (result != PrometheusSupervisionDialogResult::kApproved) {
     CompletePendingAction(
         AdmissionFailure(SupervisionErrorCode::kConfirmationDenied));
     return;
   }
   SupervisionErrorCode error_code = SupervisionErrorCode::kNone;
-  if (!ValidateAuthority(
-          pending_action_->dashboard_session, pending_action_->document_epoch,
-          pending_action_->sequence, &pending_action_->admitted_authority,
-          &error_code)) {
+  if (!ValidateAuthority(pending_action_->dashboard_session,
+                         pending_action_->document_epoch,
+                         pending_action_->sequence,
+                         &pending_action_->admitted_authority, &error_code)) {
     CompletePendingAction(AdmissionFailure(error_code));
     return;
   }
   pending_action_->route = BuildAgentRoute(pending_action_->action);
   if (!pending_action_->route.has_value()) {
-    CompletePendingAction(
-        AdmissionFailure(SupervisionErrorCode::kStaleTarget));
+    CompletePendingAction(AdmissionFailure(SupervisionErrorCode::kStaleTarget));
     return;
   }
   pending_action_->awaiting_confirmation = false;
@@ -503,10 +576,10 @@ void PrometheusSupervisionActionController::DispatchPendingAction() {
     return;
   }
   SupervisionErrorCode error_code = SupervisionErrorCode::kNone;
-  if (!ValidateAuthority(
-          pending_action_->dashboard_session, pending_action_->document_epoch,
-          pending_action_->sequence, &pending_action_->admitted_authority,
-          &error_code)) {
+  if (!ValidateAuthority(pending_action_->dashboard_session,
+                         pending_action_->document_epoch,
+                         pending_action_->sequence,
+                         &pending_action_->admitted_authority, &error_code)) {
     CompletePendingAction(AdmissionFailure(error_code));
     return;
   }
@@ -530,10 +603,10 @@ void PrometheusSupervisionActionController::OnAgentRouteCompleted(
     return;
   }
