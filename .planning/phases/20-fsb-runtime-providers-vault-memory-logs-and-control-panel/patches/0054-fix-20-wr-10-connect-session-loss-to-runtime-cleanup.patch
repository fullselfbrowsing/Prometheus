+IN_PROC_BROWSER_TEST_F(
+    PrometheusMcpIntegrationBrowserTest,
+    RuntimeSessionCloseExpiryAndGatewayShutdownCancelExactlyOnce) {
+  UseTestClock(base::Time::FromSecondsSinceUnixEpoch(4000));
+  PrometheusRuntimeProfileService* const runtime =
+      PrometheusRuntimeProfileServiceFactory::GetForProfile(
+          browser()->profile());
+  ASSERT_TRUE(runtime);
+  runtime->SetAutoStartTasksForTesting(false);
+  const PrometheusProviderConfig provider =
+      MakeCorpusProvider("openai_responses", 2000);
+  ASSERT_EQ(
+      RuntimeProfileStatus::kOk,
+      runtime->SetProviders(RuntimeCallerOrigin::kLocalControlUi, {provider}));
+
+  const auto submit_task = [this](std::string_view session_id,
+                                  std::string prompt) {
+    base::DictValue params;
+    params.Set("prompt", std::move(prompt));
+    params.Set("requested_execution", "auto");
+    base::DictValue response = Command(std::string(session_id), "run_task",
+                                       std::nullopt, std::move(params));
+    if (!response.FindBool("ok").value_or(false)) {
+      ADD_FAILURE() << base::WriteJson(response).value_or("");
+      return std::string();
+    }
+    const base::DictValue* task = response.FindDict("result")->FindDict("task");
+    if (!task || !task->FindString("task_id")) {
+      ADD_FAILURE() << "run_task omitted its task id";
+      return std::string();
+    }
+    return *task->FindString("task_id");
+  };
+  const auto expect_cancelled_once = [runtime](std::string_view task_id) {
+    const std::optional<RuntimeTaskSnapshot> task = runtime->GetTask(task_id);
+    ASSERT_TRUE(task);
+    EXPECT_EQ(RuntimeTaskState::kCancelled, task->state);
+    EXPECT_EQ(RuntimeErrorCode::kCancelled, task->error_code);
+    EXPECT_EQ(1u, runtime->finish_count_for_testing(task_id));
+  };
+
+  const std::string closed_session =
+      SessionId(CreateSession("Runtime close owner"));
+  const std::string closed_task =
+      submit_task(closed_session, "Wait for explicit session close");
+  ASSERT_FALSE(closed_task.empty());
+  ASSERT_EQ(1u, runtime->active_session_count_for_testing());
+  EXPECT_TRUE(SessionOperation("/v1/session/close", closed_session)
+                  .FindBool("ok")
+                  .value_or(false));
+  expect_cancelled_once(closed_task);
+  EXPECT_EQ(0u, runtime->active_session_count_for_testing());
+  ExpectCode(SessionOperation("/v1/session/close", closed_session),
+             "UNAUTHORIZED");
+  expect_cancelled_once(closed_task);
+
+  const std::string expiring_session =
+      SessionId(CreateSession("Runtime expiry owner"));
+  const std::string expired_task =
+      submit_task(expiring_session, "Wait for session expiry");
+  ASSERT_FALSE(expired_task.empty());
+  ASSERT_EQ(1u, runtime->active_session_count_for_testing());
+  now_ += kAgentReconnectGrace + base::Milliseconds(1);
+  const std::string shutdown_session =
+      SessionId(CreateSession("Runtime shutdown owner"));
+  ASSERT_FALSE(shutdown_session.empty());
+  expect_cancelled_once(expired_task);
+  EXPECT_EQ(0u, runtime->active_session_count_for_testing());
+  EXPECT_FALSE(service()->HasSession(expiring_session));
+  EXPECT_FALSE(service()->HasSession(expiring_session));
+  expect_cancelled_once(expired_task);
+
+  const std::string shutdown_task =
+      submit_task(shutdown_session, "Wait for gateway shutdown");
+  ASSERT_FALSE(shutdown_task.empty());
+  ASSERT_EQ(1u, runtime->active_session_count_for_testing());
+  base::test::TestFuture<void> stopped;
+  gateway_->Shutdown(stopped.GetCallback());
+  ASSERT_TRUE(stopped.Wait());
+  expect_cancelled_once(shutdown_task);
+  EXPECT_EQ(0u, runtime->active_session_count_for_testing());
+  EXPECT_EQ(0u, gateway_->session_binding_count_for_testing());
+  base::RunLoop().RunUntilIdle();
+  expect_cancelled_once(shutdown_task);
+  gateway_.reset();
+}
+
 IN_PROC_BROWSER_TEST_F(PrometheusMcpIntegrationBrowserTest,
                        TwoSessionsEnforceCapAndOwnership) {
   ASSERT_TRUE(service());
