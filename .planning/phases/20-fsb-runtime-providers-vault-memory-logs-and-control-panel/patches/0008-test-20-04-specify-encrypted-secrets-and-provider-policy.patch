+TEST_F(PrometheusSecretStoreTest, SaveReadReplaceDeleteLifecycle) {
+  EXPECT_EQ(Save(), PrometheusSecretError::kNone);
+  EXPECT_EQ(Save(), PrometheusSecretError::kAlreadyExists);
+
+  PrometheusSecretReadResult read = Read();
+  ASSERT_EQ(read.error, PrometheusSecretError::kNone);
+  ASSERT_TRUE(read.value.has_value());
+  EXPECT_EQ(*read.value, kPlaintextSentinel);
+
+  EXPECT_EQ(Replace(kReplacementSentinel), PrometheusSecretError::kNone);
+  read = Read();
+  ASSERT_TRUE(read.value.has_value());
+  EXPECT_EQ(*read.value, kReplacementSentinel);
+
+  EXPECT_EQ(Delete(), PrometheusSecretError::kNone);
+  EXPECT_EQ(Read().error, PrometheusSecretError::kNotFound);
+}
