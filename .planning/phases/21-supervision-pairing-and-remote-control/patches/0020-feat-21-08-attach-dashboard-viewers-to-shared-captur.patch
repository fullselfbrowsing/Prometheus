+PrometheusSupervisionProfileService::CaptureHubEntry*
+PrometheusSupervisionProfileService::GetOrCreateCaptureHub(
+    BrowserWindowInterface* exact_browser,
+    tabs::TabInterface* stable_tab) {
+  if (!IsEligibleTarget(profile_, exact_browser, stable_tab)) {
+    return nullptr;
+  }
+  const int32_t stable_tab_id = stable_tab->GetHandle().raw_value();
+  auto existing = capture_hubs_.find(stable_tab_id);
+  if (existing != capture_hubs_.end()) {
+    CaptureHubEntry* entry = existing->second.get();
+    return entry->tab == stable_tab && entry->exact_browser &&
+                   entry->exact_browser.get() == exact_browser
+               ? entry
+               : nullptr;
+  }
+
+  base::WeakPtr<BrowserWindowInterface> exact_browser_weak =
+      exact_browser->GetWeakPtr();
+  if (!exact_browser_weak) {
+    return nullptr;
+  }
+  std::unique_ptr<PrometheusSupervisionCaptureHub> hub =
+      capture_hub_factory_.Run(stable_tab->GetContents(), stable_tab_id,
+                               limits_);
+  if (!hub) {
+    return nullptr;
+  }
+  auto entry = std::make_unique<CaptureHubEntry>();
+  entry->stable_tab_id = stable_tab_id;
+  entry->tab = stable_tab;
+  entry->exact_browser = std::move(exact_browser_weak);
+  entry->hub = std::move(hub);
+  CaptureHubEntry* result = entry.get();
+  capture_hubs_.emplace(stable_tab_id, std::move(entry));
+  return result;
+}
+
+PrometheusSupervisionProfileService::CaptureHubEntry*
+PrometheusSupervisionProfileService::FindCaptureHub(
+    const ViewerSession& viewer) {
+  return const_cast<CaptureHubEntry*>(
+      std::as_const(*this).FindCaptureHub(viewer));
+}
+
+const PrometheusSupervisionProfileService::CaptureHubEntry*
+PrometheusSupervisionProfileService::FindCaptureHub(
+    const ViewerSession& viewer) const {
+  auto capture_hub = capture_hubs_.find(viewer.stable_tab_id);
+  if (capture_hub == capture_hubs_.end()) {
+    return nullptr;
+  }
+  const CaptureHubEntry* entry = capture_hub->second.get();
+  if (!entry->hub || entry->tab != viewer.tab || !entry->exact_browser ||
+      !viewer.exact_browser ||
+      entry->exact_browser.get() != viewer.exact_browser.get()) {
+    return nullptr;
+  }
+  return entry;
+}
+
+void PrometheusSupervisionProfileService::DetachCaptureConsumer(
+    ViewerSession& viewer) {
+  if (!viewer.capture_consumer_token.has_value()) {
+    return;
+  }
+  auto capture_hub = capture_hubs_.find(viewer.stable_tab_id);
+  if (capture_hub != capture_hubs_.end() &&
+      capture_hub->second->tab == viewer.tab) {
+    capture_hub->second->hub->DetachConsumer(*viewer.capture_consumer_token);
+  }
+  viewer.capture_consumer_token.reset();
+  ReleaseCaptureHubIfUnused(viewer.stable_tab_id);
+}
+
+void PrometheusSupervisionProfileService::ReleaseCaptureHubIfUnused(
+    int32_t stable_tab_id) {
+  auto capture_hub = capture_hubs_.find(stable_tab_id);
+  if (capture_hub == capture_hubs_.end() ||
+      !capture_hub->second->hub->CanReleaseAfterLastConsumer()) {
+    return;
+  }
+  released_capture_disable_count_for_testing_ +=
+      capture_hub->second->hub->disable_count_for_testing();
+  capture_hubs_.erase(capture_hub);
+}
