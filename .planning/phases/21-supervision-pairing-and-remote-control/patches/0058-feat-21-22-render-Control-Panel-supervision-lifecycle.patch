 }
 
 function controlLogRecords() {
@@ -1702,18 +1711,699 @@ function renderControlLogs() {
           'Not reported');
 }
 
-function restoreControlFocus(focusKey) {
+const controlSupervisionStreamCopy = Object.freeze({
+  preparing_baseline: {
+    label: 'Starting view',
+    copy: 'Prometheus is preparing a safe page snapshot.',
+  },
+  live: {
+    label: 'Live',
+    copy: 'Structured page updates are current.',
+  },
+  resyncing: {
+    label: 'Resyncing',
+    copy: 'The page changed. Prometheus is preparing a fresh supervised view.',
+  },
+  paused: {
+    label: 'View paused for resync',
+    copy: 'A fresh page snapshot is required before updates continue.',
+  },
+  ended: {
+    label: 'Ended',
+    copy: 'The target tab closed. Dashboard access ended.',
+  },
+});
+
+const controlSupervisionActionCopy = Object.freeze({
+  idle: 'No remote action active',
+  validating: 'Validating remote action',
+  awaiting_confirmation: 'Confirmation required in Prometheus',
+  verifying: 'Verifying page change',
+  completed: 'Remote action complete',
+  blocked: 'Remote action blocked',
+  failed: 'Remote action failed',
+});
+
+const controlSupervisionAuditLabels = Object.freeze({
+  pairing_code_created: 'Pairing code created',
+  pairing_code_cancelled: 'Pairing code cancelled',
+  pairing_code_expired: 'Pairing code expired',
+  dashboard_paired: 'Dashboard paired',
+  viewing_started: 'Viewing started',
+  control_enabled: 'Control enabled',
+  remote_action_requested: 'Remote action requested',
+  remote_action_completed: 'Remote action completed',
+  remote_action_blocked: 'Remote action blocked',
+  control_stopped: 'Control stopped',
+  access_revoked: 'Access revoked',
+  access_expired: 'Access expired',
+  resync_required: 'Resync required',
+  resync_completed: 'Resync completed',
+  target_closed: 'Target closed',
+  authority_lost: 'Authority lost',
+});
+
+function controlSupervisionRows() {
+  const supervision = controlSnapshot.supervision;
+  return supervision && typeof supervision === 'object' ? supervision : null;
+}
+
+function controlSupervisionRelativeTime(timestampMs) {
+  const timestamp = Number(timestampMs);
+  if (!Number.isFinite(timestamp) || timestamp <= 0) {
+    return 'Time unavailable';
+  }
+  const seconds = Math.max(
+      0, Math.round(Math.abs(Date.now() - timestamp) / 1000));
+  if (seconds < 60) {
+    return seconds <= 1 ? 'just now' : `${seconds} seconds ago`;
+  }
+  const minutes = Math.round(seconds / 60);
+  if (minutes < 60) {
+    return `${minutes} ${minutes === 1 ? 'minute' : 'minutes'} ago`;
+  }
+  const hours = Math.round(minutes / 60);
+  return `${hours} ${hours === 1 ? 'hour' : 'hours'} ago`;
+}
+
+function controlSupervisionRemainingTime(timestampMs, prefix = 'Expires in') {
+  const remaining = Math.max(0, Number(timestampMs) - Date.now());
+  if (!Number.isFinite(remaining)) {
+    return `${prefix} unavailable`;
+  }
+  const totalSeconds = Math.max(0, Math.ceil(remaining / 1000));
+  const minutes = Math.floor(totalSeconds / 60);
+  const seconds = String(totalSeconds % 60).padStart(2, '0');
+  return `${prefix} ${String(minutes).padStart(2, '0')}:${seconds}`;
+}
+
+function controlSupervisionActionText(row) {
+  if (row?.action_state === 'executing') {
+    const category = supervisionActionLabels[row.action_category];
+    return category ? `Remote action: ${category}` : 'Remote action blocked';
+  }
+  return controlSupervisionActionCopy[row?.action_state] ||
+      'No remote action active';
+}
+
+function controlSupervisionStreamState(rows) {
+  if (!rows.length) {
+    return null;
+  }
+  for (const state of [
+    'paused', 'resyncing', 'preparing_baseline', 'ended', 'live',
+  ]) {
+    if (rows.some((row) => row?.stream_state === state)) {
+      return state;
+    }
+  }
+  return 'ended';
+}
+
+function sendControlSupervisionMessage(message, args) {
+  const safeArgs = Array.isArray(args) ? args.map((value) =>
+    typeof value === 'boolean' ? value : controlInteger(value)) : [];
+  const messages =
+      Array.isArray(window.prometheusSupervisionMessagesForTesting) ?
+      window.prometheusSupervisionMessagesForTesting : [];
+  window.prometheusSupervisionMessagesForTesting = messages;
+  messages.push({message, args: [...safeArgs]});
+  chrome.send(message, safeArgs);
+}
+
+function eraseControlPairingCharacters() {
+  controlPairingCode = '';
+  controlPairingExpiresAtMs = 0;
+  controlPairingAnnouncements = new Set();
+  if (controlPairingTimer) {
+    clearInterval(controlPairingTimer);
+    controlPairingTimer = 0;
+  }
+  const code = document.querySelector('#control-supervision-code');
+  if (code) {
+    code.textContent = '';
+  }
+}
+
+function setControlPairingState(state, body = '') {
+  controlPairingUiState = state;
+  renderControlPairingPresentation(body);
+}
+
+function renderControlPairingPresentation(overrideBody = '') {
+  const panel = document.querySelector('#control-supervision-code-panel');
+  const heading = document.querySelector('#control-supervision-code-heading');
+  const code = document.querySelector('#control-supervision-code');
+  const body = document.querySelector('#control-supervision-code-copy');
+  const timer = document.querySelector('#control-supervision-code-timer');
+  const copy = document.querySelector('#control-supervision-copy');
+  const cancel = document.querySelector('#control-supervision-cancel-code');
+  const another =
+      document.querySelector('#control-supervision-create-another');
+  if (!panel || !heading || !code || !body || !timer || !copy || !cancel ||
+      !another) {
+    return;
+  }
+  const states = {
+    loading: [
+      'Creating pairing code',
+      'Prometheus is validating the target and local gateway.',
+    ],
+    active: [
+      'Pairing code ready',
+      'Enter this one-time code in the local dashboard. It can be used once.',
+    ],
+    expiring: [
+      'Pairing code expires soon',
+      'Use this code now or create a new one after it expires.',
+    ],
+    redeemed: [
+      'Pairing code used',
+      'The dashboard is connected in view-only mode.',
+    ],
+    expired: ['Pairing code expired', 'Create a new code to continue.'],
+    cancelled: ['Pairing code cancelled', 'The code can no longer be used.'],
+    target_lost: [
+      'Target unavailable',
+      'Choose another tab and create a new pairing code.',
+    ],
+    failure: [
+      'Pairing code could not be created',
+      'Check supervision diagnostics, then try again.',
+    ],
+  };
+  const copyForState = states[controlPairingUiState];
+  panel.hidden = !copyForState;
+  if (!copyForState) {
+    code.textContent = '';
+    return;
+  }
+  heading.textContent = copyForState[0];
+  body.textContent = overrideBody || copyForState[1];
+  const hasCode = (controlPairingUiState === 'active' ||
+      controlPairingUiState === 'expiring') && controlPairingCode;
+  code.textContent = hasCode ? controlPairingCode : '';
+  code.hidden = !hasCode;
+  timer.hidden = !hasCode;
+  timer.textContent = hasCode ?
+      controlSupervisionRemainingTime(controlPairingExpiresAtMs) : '';
+  copy.hidden = !hasCode;
+  cancel.hidden = !hasCode;
+  another.hidden = controlPairingUiState !== 'redeemed';
+  updateControlSupervisionCreateAction();
+}
+
+function updateControlPairingTimer() {
+  if (!controlPairingCode || controlPairingExpiresAtMs <= 0) {
+    return;
+  }
+  const remainingMs = controlPairingExpiresAtMs - Date.now();
+  if (remainingMs <= 0) {
+    eraseControlPairingCharacters();
+    setControlPairingState('expired');
+    const status =
+        document.querySelector('#control-supervision-code-status');
+    if (status) {
+      status.textContent = 'Pairing code expired';
+    }
+    return;
+  }
+  const remainingSeconds = Math.ceil(remainingMs / 1000);
+  if (remainingSeconds <= 60 && controlPairingUiState === 'active') {
+    controlPairingUiState = 'expiring';
+    renderControlPairingPresentation();
+  } else {
+    const timer = document.querySelector('#control-supervision-code-timer');
+    if (timer) {
+      timer.textContent =
+          controlSupervisionRemainingTime(controlPairingExpiresAtMs);
+    }
+  }
+  const status = document.querySelector('#control-supervision-code-status');
+  for (const [threshold, announcement] of [
+    [60, 'Pairing code expires in one minute'],
+    [10, 'Pairing code expires in ten seconds'],
+  ]) {
+    if (remainingSeconds <= threshold &&
+        !controlPairingAnnouncements.has(threshold)) {
+      controlPairingAnnouncements.add(threshold);
+      if (status) {
+        status.textContent = announcement;
+      }
+    }
+  }
+}
+
+function selectedControlSupervisionTarget() {
+  const supervision = controlSupervisionRows();
+  return controlArray(supervision?.targets)
+      .find((target) => target?.selected === true) || null;
+}
+
+function updateControlSupervisionCreateAction() {
+  const create = document.querySelector('#control-supervision-create');
+  const supervision = controlSupervisionRows();
+  const target = selectedControlSupervisionTarget();
+  if (!create) {
+    return;
+  }
+  const loading = controlPairingUiState === 'loading';
+  const another = !!controlPairingCode ||
+      controlPairingUiState === 'redeemed';
+  create.textContent = loading ? 'Creating pairing code' :
+      another ? 'Create another code' : 'Create pairing code';
+  create.disabled = loading || !supervision?.available || !target;
+}
+
+function reconcileControlPairingState(supervision) {
+  const pairingState = typeof supervision?.pairing_state === 'string' ?
+      supervision.pairing_state : '';
+  if (!['redeemed', 'expired', 'cancelled', 'target_lost']
+      .includes(pairingState)) {
+    return;
+  }
+  const hadPresentation = !!controlPairingCode ||
+      controlPairingUiState !== 'idle' ||
+      controlPairingAwaitingTerminal;
+  if (!hadPresentation) {
+    return;
+  }
+  eraseControlPairingCharacters();
+  controlPairingAwaitingTerminal = false;
+  setControlPairingState(pairingState);
+}
+
+function renderControlSupervisionTarget(supervision) {
+  const select = document.querySelector('#control-supervision-target');
+  const detail =
+      document.querySelector('#control-supervision-target-detail');
+  if (!select || !detail) {
+    return;
+  }
+  const targets = controlArray(supervision?.targets);
+  select.replaceChildren();
+  if (!targets.length) {
+    const option = document.createElement('option');
+    option.value = '';
+    option.textContent = 'No eligible target tab';
+    select.append(option);
+    select.disabled = true;
+    detail.textContent =
+        'Open a supported page in this window, then try again.';
+  } else {
+    for (const target of targets) {
+      const option = document.createElement('option');
+      option.value = String(controlInteger(target?.ordinal));
+      option.textContent =
+          `${target?.safe_title || 'Untitled tab'} · ` +
+          `${target?.safe_origin || 'Unavailable'}`;
+      option.selected = target?.selected === true;
+      select.append(option);
+    }
+    select.disabled = false;
+    const selected = selectedControlSupervisionTarget();
+    detail.textContent = selected ?
+        `${selected.safe_title || 'Untitled tab'} · ` +
+            `${selected.safe_origin || 'Unavailable'}` :
+        'Choose a target tab to continue.';
+  }
+  updateControlSupervisionCreateAction();
+}
+
+function appendControlSupervisionAction(
+    parent, label, action, ordinal, listener, danger = false,
+    focusKey = '', focusLabel = '') {
+  const button = appendTextElement(
+      parent, 'button', danger ? 'danger-button' : 'quiet-button', label);
+  button.type = 'button';
+  button.dataset.supervisionAction = action;
+  button.dataset.supervisionOrdinal = String(ordinal);
+  button.dataset.controlFocusKey =
+      focusKey || `supervision-${action}:${ordinal}`;
+  if (focusLabel) {
+    controlSupervisionFocusLabels.set(button, focusLabel);
+  }
+  button.addEventListener('click', listener);
+  return button;
+}
+
+function requestControlSupervisionRevoke(ordinal, label, trigger) {
+  const dialog =
+      document.querySelector('#control-supervision-revoke-dialog');
+  if (!dialog || dialog.open || controlSupervisionMutationPending) {
+    return;
+  }
+  pendingControlSupervisionDialog = {
+    kind: 'revoke',
+    ordinal,
+    trigger,
+  };
+  const copy = document.querySelector('#control-supervision-revoke-copy');
+  if (copy) {
+    copy.textContent =
+        `Revoke access for ${label || 'Local dashboard'}? Viewing and ` +
+        'control for this pairing will end immediately.';
+  }
+  trigger?.setAttribute('aria-expanded', 'true');
+  dialog.showModal();
+  document.querySelector('#control-supervision-revoke-dismiss')
+      ?.focus({preventScroll: true});
+}
+
+function requestControlSupervisionEnd(trigger) {
+  const dialog = document.querySelector('#control-supervision-end-dialog');
+  const target = selectedControlSupervisionTarget();
+  if (!dialog || !target || dialog.open || controlSupervisionMutationPending) {
+    return;
+  }
+  pendingControlSupervisionDialog = {
+    kind: 'end',
+    ordinal: controlInteger(target.ordinal),
+    trigger,
+  };
+  const copy = document.querySelector('#control-supervision-end-copy');
+  if (copy) {
+    copy.textContent =
+        `End supervision for ${target.safe_title || 'this tab'}? All paired ` +
+        'dashboards will lose viewing and control immediately.';
+  }
+  trigger?.setAttribute('aria-expanded', 'true');
+  dialog.showModal();
+  document.querySelector('#control-supervision-end-dismiss')
+      ?.focus({preventScroll: true});
+}
+
+function renderControlSupervisionConnected(supervision) {
+  const list =
+      document.querySelector('#control-supervision-connected-list');
