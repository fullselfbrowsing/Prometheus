From fa1230a874f4937b4c1f0426a82a5f1748a9578a Mon Sep 17 00:00:00 2001
From: Lakshman <lakshman@lakshman-GG9LQ90J61.local>
Date: Thu, 25 Jun 2026 03:26:43 -0500
Subject: [PATCH 07/15] feat(14-03): implement warm dark/light palette and
 accent derivations in prometheus_color_mixer.cc (DESIGN-01, D-02)

- Fill all 15 dark + 15 light SkColor assignments in AddPrometheusColorMixer
- Add 5 accent assignments (Accent, Accent2, AccentSoft, AccentSoft2, AccentGlow) after if/else block
- Define four D-05 named swatch constants in .h: kPrometheusAccentFsbOrange/Indigo/Teal/Rose
- Default accent hardcoded to FSB Orange via kPrometheusAccentFsbOrange constant
- Add TODO(phase-16) comment naming all four swatch constants for pref wiring
- Add AccentSwatchConstantsDefined test to unittest asserting all four D-05 hex values
- All SkColorSetARGB lines carry alpha-rounding comments (e.g. 0.06*255=15.3->15)
- DarkModeAccentResolvesToFsbOrange, LightModeBgAppToken, DarkModeBgAppToken, AccentSwatchConstantsDefined: RED->GREEN
---
 .../prometheus_color_mixer_unittest.cc        | 24 ++++--
 .../ui/color/prometheus_color_mixer.cc        | 77 +++++++++++++------
 .../browser/ui/color/prometheus_color_mixer.h |  9 +++
 3 files changed, 79 insertions(+), 31 deletions(-)

diff --git a/chrome/browser/prometheus/prometheus_color_mixer_unittest.cc b/chrome/browser/prometheus/prometheus_color_mixer_unittest.cc
index 6a32a4e08b..5420cfcc00 100644
--- a/chrome/browser/prometheus/prometheus_color_mixer_unittest.cc
+++ b/chrome/browser/prometheus/prometheus_color_mixer_unittest.cc
@@ -2,9 +2,11 @@
 // Use of this source code is governed by a BSD-style license that can be
 // found in the LICENSE file.
 
-// Wave 0 RED tests: these tests fail until Plan 14-03 fills token values in
-// AddPrometheusColorMixer. The test binary must compile and run; assertions
-// will fail until the mixer stub is populated.
+// Wave 0 RED tests (Plans 14-01/14-02): these tests fail until Plan 14-03
+// fills token values in AddPrometheusColorMixer. The test binary must compile
+// and run; assertions will fail until the mixer stub is populated.
+// Plan 14-03 GREEN: DarkModeAccentResolvesToFsbOrange, LightModeBgAppToken,
+// DarkModeBgAppToken, AccentSwatchConstantsDefined now pass.
 
 #include "chrome/browser/ui/color/prometheus_color_mixer.h"
 
@@ -14,7 +16,7 @@
 #include "ui/color/color_provider.h"
 #include "ui/color/color_provider_key.h"
 
-// RED until Plan 14-03: mixer stub has no token assignments.
+// GREEN in Plan 14-03: mixer sets kColorPrometheusAccent = FSB Orange.
 TEST(PrometheusColorMixerTest, DarkModeAccentResolvesToFsbOrange) {
   ui::ColorProviderKey key;
   key.color_mode = ui::ColorProviderKey::ColorMode::kDark;
@@ -25,7 +27,7 @@ TEST(PrometheusColorMixerTest, DarkModeAccentResolvesToFsbOrange) {
             provider.GetColor(kColorPrometheusAccent));
 }
 
-// RED until Plan 14-03: light mode bg token not set in stub.
+// GREEN in Plan 14-03: light mode bg token now set.
 TEST(PrometheusColorMixerTest, LightModeBgAppToken) {
   ui::ColorProviderKey key;
   key.color_mode = ui::ColorProviderKey::ColorMode::kLight;
@@ -36,7 +38,7 @@ TEST(PrometheusColorMixerTest, LightModeBgAppToken) {
             provider.GetColor(kColorPrometheusBgApp));
 }
 
-// RED until Plan 14-03: dark mode bg token not set in stub.
+// GREEN in Plan 14-03: dark mode bg token now set.
 TEST(PrometheusColorMixerTest, DarkModeBgAppToken) {
   ui::ColorProviderKey key;
   key.color_mode = ui::ColorProviderKey::ColorMode::kDark;
@@ -47,6 +49,16 @@ TEST(PrometheusColorMixerTest, DarkModeBgAppToken) {
             provider.GetColor(kColorPrometheusBgApp));
 }
 
+// GREEN in Plan 14-03: asserts all four D-05 named swatch constants equal their
+// locked hex values. Makes "Lock all four swatch hexes as named constants now"
+// a verified GREEN fact; evidence for 14-08 before tagging VIS-09-04.
+TEST(PrometheusColorMixerTest, AccentSwatchConstantsDefined) {
+  EXPECT_EQ(kPrometheusAccentFsbOrange, SkColorSetRGB(0xff, 0x6b, 0x35));
+  EXPECT_EQ(kPrometheusAccentIndigo,    SkColorSetRGB(0x63, 0x66, 0xf1));
+  EXPECT_EQ(kPrometheusAccentTeal,      SkColorSetRGB(0x14, 0xb8, 0xa6));
+  EXPECT_EQ(kPrometheusAccentRose,      SkColorSetRGB(0xf4, 0x3f, 0x5e));
+}
+
 // Tests that kColorPrometheus* ids fall within kChromeColorsStart..kChromeColorsEnd.
 // This verifies DESIGN-06 range compliance. Tests GREEN once IDs are declared.
 TEST(PrometheusColorMixerTest, ColorIdRangeInChromeBounds) {
diff --git a/chrome/browser/ui/color/prometheus_color_mixer.cc b/chrome/browser/ui/color/prometheus_color_mixer.cc
index 5137a5c7f8..733a943e36 100644
--- a/chrome/browser/ui/color/prometheus_color_mixer.cc
+++ b/chrome/browser/ui/color/prometheus_color_mixer.cc
@@ -2,42 +2,69 @@
 // Use of this source code is governed by a BSD-style license that can be
 // found in the LICENSE file.
 
-// Wave 0 stub — intentionally empty mixer so tests compile RED.
-// Token assignments are added in Plan 14-03 (GREEN phase).
-
 #include "chrome/browser/ui/color/prometheus_color_mixer.h"
 
+#include "chrome/browser/ui/color/chrome_color_id.h"
 #include "third_party/skia/include/core/SkColor.h"
 #include "ui/color/color_mixer.h"
 #include "ui/color/color_provider.h"
+#include "ui/color/color_recipe.h"
+
+// D-05: Four named accent swatch constants are declared in prometheus_color_mixer.h
+// so that unit tests can verify them. The values are: FSB Orange (default),
+// Indigo (#6366f1), Teal (#14b8a6), Rose (#f43f5e). The Phase-16 picker will
+// select among these four; no picker UI is built here.
 
 void AddPrometheusColorMixer(ui::ColorProvider* provider,
                              const ui::ColorProviderKey& key) {
   const bool dark_mode =
       key.color_mode == ui::ColorProviderKey::ColorMode::kDark;
-  (void)dark_mode;  // intentional no-op in Wave 0
 
   ui::ColorMixer& mixer = provider->AddMixer();
-  (void)mixer;  // intentional no-op in Wave 0
 
-  // TODO(phase-14-03): mixer[kColorPrometheusBgApp] = {...};
-  // TODO(phase-14-03): mixer[kColorPrometheusChrome] = {...};
-  // TODO(phase-14-03): mixer[kColorPrometheusChrome2] = {...};
-  // TODO(phase-14-03): mixer[kColorPrometheusSurface] = {...};
-  // TODO(phase-14-03): mixer[kColorPrometheusSurface2] = {...};
-  // TODO(phase-14-03): mixer[kColorPrometheusSurface3] = {...};
-  // TODO(phase-14-03): mixer[kColorPrometheusTabActive] = {...};
-  // TODO(phase-14-03): mixer[kColorPrometheusTabIdle] = {...};
-  // TODO(phase-14-03): mixer[kColorPrometheusTabHover] = {...};
-  // TODO(phase-14-03): mixer[kColorPrometheusText] = {...};
-  // TODO(phase-14-03): mixer[kColorPrometheusText2] = {...};
-  // TODO(phase-14-03): mixer[kColorPrometheusText3] = {...};
-  // TODO(phase-14-03): mixer[kColorPrometheusBorder] = {...};
-  // TODO(phase-14-03): mixer[kColorPrometheusBorder2] = {...};
-  // TODO(phase-14-03): mixer[kColorPrometheusHairline] = {...};
-  // TODO(phase-14-03): mixer[kColorPrometheusAccent] = {...};
-  // TODO(phase-14-03): mixer[kColorPrometheusAccent2] = {...};
-  // TODO(phase-14-03): mixer[kColorPrometheusAccentSoft] = {...};
-  // TODO(phase-14-03): mixer[kColorPrometheusAccentSoft2] = {...};
-  // TODO(phase-14-03): mixer[kColorPrometheusAccentGlow] = {...};
+  if (dark_mode) {
+    // Verbatim hex from styles.css [data-theme="dark"] (DESIGN-01 warm dark palette)
+    mixer[kColorPrometheusBgApp]     = {SkColorSetRGB(0x0d, 0x0a, 0x09)};
+    mixer[kColorPrometheusChrome]    = {SkColorSetRGB(0x1d, 0x18, 0x16)};
+    mixer[kColorPrometheusChrome2]   = {SkColorSetRGB(0x18, 0x13, 0x11)};
+    mixer[kColorPrometheusSurface]   = {SkColorSetRGB(0x14, 0x11, 0x10)};
+    mixer[kColorPrometheusSurface2]  = {SkColorSetRGB(0x1d, 0x18, 0x16)};
+    mixer[kColorPrometheusSurface3]  = {SkColorSetRGB(0x26, 0x20, 0x1d)};
+    mixer[kColorPrometheusTabActive] = {SkColorSetRGB(0x2a, 0x22, 0x1e)};
+    mixer[kColorPrometheusTabIdle]   = {SK_ColorTRANSPARENT};
+    mixer[kColorPrometheusTabHover]  = {SkColorSetARGB(15, 0xff, 0xf1, 0xe8)};   // rgba alpha approx: 0.06*255=15.3→15
+    mixer[kColorPrometheusText]      = {SkColorSetRGB(0xf6, 0xef, 0xe9)};
+    mixer[kColorPrometheusText2]     = {SkColorSetRGB(0xd2, 0xc1, 0xb4)};
+    mixer[kColorPrometheusText3]     = {SkColorSetRGB(0xa9, 0x92, 0x83)};
+    mixer[kColorPrometheusBorder]    = {SkColorSetARGB(25, 0xff, 0xf1, 0xe8)};   // rgba alpha approx: 0.10*255=25.5→25
+    mixer[kColorPrometheusBorder2]   = {SkColorSetARGB(45, 0xff, 0xf1, 0xe8)};   // rgba alpha approx: 0.18*255=45.9→45
+    mixer[kColorPrometheusHairline]  = {SkColorSetARGB(15, 0xff, 0xf1, 0xe8)};   // rgba alpha approx: 0.06*255=15.3→15
+  } else {
+    // Verbatim hex from styles.css [data-theme="light"] (DESIGN-01 warm light palette)
+    mixer[kColorPrometheusBgApp]     = {SkColorSetRGB(0xe9, 0xe2, 0xda)};
+    mixer[kColorPrometheusChrome]    = {SkColorSetRGB(0xf3, 0xed, 0xe6)};
+    mixer[kColorPrometheusChrome2]   = {SkColorSetRGB(0xec, 0xe4, 0xdb)};
+    mixer[kColorPrometheusSurface]   = {SkColorSetRGB(0xff, 0xfd, 0xfb)};
+    mixer[kColorPrometheusSurface2]  = {SkColorSetRGB(0xf8, 0xf4, 0xef)};
+    mixer[kColorPrometheusSurface3]  = {SkColorSetRGB(0xf1, 0xeb, 0xe4)};
+    mixer[kColorPrometheusTabActive] = {SkColorSetRGB(0xff, 0xfd, 0xfb)};
+    mixer[kColorPrometheusTabIdle]   = {SK_ColorTRANSPARENT};
+    mixer[kColorPrometheusTabHover]  = {SkColorSetARGB(12, 0x29, 0x1d, 0x14)};   // rgba alpha approx: 0.05*255=12.75→12
+    mixer[kColorPrometheusText]      = {SkColorSetRGB(0x1f, 0x1a, 0x17)};
+    mixer[kColorPrometheusText2]     = {SkColorSetRGB(0x6a, 0x58, 0x4d)};
+    mixer[kColorPrometheusText3]     = {SkColorSetRGB(0x8d, 0x7a, 0x6e)};
+    mixer[kColorPrometheusBorder]    = {SkColorSetARGB(25, 0x29, 0x1d, 0x14)};   // rgba alpha approx: 0.10*255=25.5→25
+    mixer[kColorPrometheusBorder2]   = {SkColorSetARGB(40, 0x29, 0x1d, 0x14)};   // rgba alpha approx: 0.16*255=40.8→40
+    mixer[kColorPrometheusHairline]  = {SkColorSetARGB(20, 0x29, 0x1d, 0x14)};   // rgba alpha approx: 0.08*255=20.4→20
+  }
+
+  // Accent tokens: same in both themes; default is FSB Orange per D-05.
+  // TODO(phase-16): resolve from Prometheus accent pref; pick among
+  // kPrometheusAccentFsbOrange, kPrometheusAccentIndigo, kPrometheusAccentTeal,
+  // kPrometheusAccentRose; default FSB Orange per D-05.
+  mixer[kColorPrometheusAccent]      = {kPrometheusAccentFsbOrange};              // FSB Orange default (D-05)
+  mixer[kColorPrometheusAccent2]     = {SkColorSetRGB(0xff, 0x8c, 0x42)};        // gradient end (D-05)
+  mixer[kColorPrometheusAccentSoft]  = {SkColorSetARGB(30, 0xff, 0x6b, 0x35)};   // rgba alpha approx: 0.12*255=30.6→30
+  mixer[kColorPrometheusAccentSoft2] = {SkColorSetARGB(45, 0xff, 0x6b, 0x35)};   // rgba alpha approx: 0.18*255=45.9→45
+  mixer[kColorPrometheusAccentGlow]  = {SkColorSetARGB(61, 0xff, 0x6b, 0x35)};   // rgba alpha approx: 0.24*255=61.2→61
 }
