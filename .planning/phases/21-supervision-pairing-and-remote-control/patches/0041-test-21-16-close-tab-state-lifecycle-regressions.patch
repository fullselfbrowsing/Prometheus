diff --git a/chrome/browser/prometheus/prometheus_agent_tab_data_unittest.cc b/chrome/browser/prometheus/prometheus_agent_tab_data_unittest.cc
index 1b1e3d718f..adc17d0452 100644
--- a/chrome/browser/prometheus/prometheus_agent_tab_data_unittest.cc
+++ b/chrome/browser/prometheus/prometheus_agent_tab_data_unittest.cc
@@ -7,6 +7,7 @@
 #include <memory>
 #include <vector>
 
+#include "base/memory/raw_ptr.h"
 #include "components/tabs/public/mock_tab_interface.h"
 #include "testing/gmock/include/gmock/gmock.h"
 #include "testing/gtest/include/gtest/gtest.h"
@@ -30,6 +31,27 @@ class RecordingTabStateObserver final : public PrometheusTabStateObserver {
   size_t invalidations = 0;
 };
 
+class ClearSupervisionOnOwnerLoss final
+    : public PrometheusAgentTabData::Observer {
+ public:
+  void set_data(PrometheusAgentTabData* data) { data_ = data; }
+
+  void OnPrometheusAgentTabOwnerChanged(
+      std::string_view old_owner_session_id,
+      std::string_view new_owner_session_id) override {
+    if (!old_owner_session_id.empty() && new_owner_session_id.empty()) {
+      if (data_) {
+        data_->ClearSupervisionState();
+      }
+    }
+  }
+
+  void OnPrometheusAgentTabDataDestroying() override { data_ = nullptr; }
+
+ private:
+  raw_ptr<PrometheusAgentTabData> data_ = nullptr;
+};
+
 class PrometheusAgentTabDataTest : public testing::Test {
  protected:
   void SetUp() override {
@@ -144,6 +166,7 @@ TEST_F(PrometheusAgentTabDataTest,
 
   data->UpdateSupervisionState(supervision);
   data->ClearSupervisionState();
+  data->ClearSupervisionState();
 
   ASSERT_EQ(2u, observer.states.size());
   EXPECT_EQ(supervision, observer.states[0].supervision);
@@ -185,6 +208,74 @@ TEST_F(PrometheusAgentTabDataTest,
   data.reset();
 
   EXPECT_EQ(1u, observer.invalidations);
+  data = PrometheusAgentTabData::ForTabForTesting(&tab_);
+  ASSERT_NE(nullptr, data);
+  EXPECT_EQ(PrometheusTabState::Supervision(), data->ToTabState().supervision);
+}
+
+TEST_F(PrometheusAgentTabDataTest,
+       SupervisionOwnerLossPublishesOnlyClearedCoherentState) {
+  RecordingTabStateObserver state_observer;
+  ClearSupervisionOnOwnerLoss owner_observer;
+  std::unique_ptr<PrometheusAgentTabData> data =
+      PrometheusAgentTabData::ForTabForTesting(&tab_);
+  ASSERT_NE(nullptr, data);
+  ASSERT_TRUE(data->ClaimIfUnowned("owner-a", "Agent A").ok);
+  owner_observer.set_data(data.get());
+  data->AddObserver(&owner_observer);
+  data->AddTabStateObserver(&state_observer);
+  PrometheusTabState::Supervision supervision;
+  supervision.available = true;
+  supervision.viewer_count = 1;
+  supervision.viewer_labels = {"Controller"};
+  supervision.controller_label = "Controller";
+  supervision.view_state = PrometheusTabState::Supervision::ViewState::kViewing;
+  supervision.control_state =
+      PrometheusTabState::Supervision::ControlState::kControllerReady;
+  supervision.activity_state =
+      PrometheusTabState::Supervision::ActivityState::kExecuting;
+  supervision.action_category =
+      PrometheusTabState::Supervision::ActionCategory::kClick;
+  data->UpdateSupervisionState(supervision);
+  state_observer.states.clear();
+
+  AgentRouteResult release = data->ReleaseIfOwned("owner-a");
+  data->RemoveTabStateObserver(&state_observer);
+  data->RemoveObserver(&owner_observer);
+
+  EXPECT_TRUE(release.ok);
+  ASSERT_EQ(1u, state_observer.states.size());
+  const PrometheusTabState& terminal = state_observer.states.front();
+  EXPECT_TRUE(terminal.owner_label.empty());
+  EXPECT_FALSE(terminal.supervision_active);
+  EXPECT_EQ(PrometheusTabState::Supervision(), terminal.supervision);
+}
+
+TEST_F(PrometheusAgentTabDataTest,
+       SupervisionExactTabUpdateDoesNotAttachToAnotherTab) {
+  ui::UnownedUserDataHost other_host;
+  tabs::MockTabInterface other_tab;
+  ON_CALL(other_tab, GetUnownedUserDataHost())
+      .WillByDefault(ReturnRef(other_host));
+  std::unique_ptr<PrometheusAgentTabData> data =
+      PrometheusAgentTabData::ForTabForTesting(&tab_);
+  std::unique_ptr<PrometheusAgentTabData> other_data =
+      PrometheusAgentTabData::ForTabForTesting(&other_tab);
+  ASSERT_NE(nullptr, data);
+  ASSERT_NE(nullptr, other_data);
+  PrometheusTabState::Supervision supervision;
+  supervision.available = true;
+  supervision.viewer_count = 1;
+  supervision.viewer_labels = {"Reviewer"};
+  supervision.view_state = PrometheusTabState::Supervision::ViewState::kViewing;
+  supervision.control_state =
+      PrometheusTabState::Supervision::ControlState::kViewOnly;
+
+  data->UpdateSupervisionState(supervision);
+
+  EXPECT_EQ(supervision, data->ToTabState().supervision);
+  EXPECT_EQ(PrometheusTabState::Supervision(),
+            other_data->ToTabState().supervision);
 }
 
 }  // namespace
diff --git a/chrome/browser/prometheus/prometheus_supervision_profile_service_unittest.cc b/chrome/browser/prometheus/prometheus_supervision_profile_service_unittest.cc
