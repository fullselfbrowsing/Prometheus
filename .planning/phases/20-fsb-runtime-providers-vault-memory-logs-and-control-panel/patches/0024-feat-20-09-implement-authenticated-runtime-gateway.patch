+bool ReadOptionalInt64(const base::DictValue& value,
+                       std::string_view key,
+                       int64_t minimum,
+                       int64_t maximum,
+                       std::optional<int64_t>* output) {
+  const base::Value* field = value.Find(key);
+  if (!field) {
+    output->reset();
+    return true;
+  }
+  if (!field->is_int() || field->GetInt() < minimum ||
+      field->GetInt() > maximum) {
