 #include "chrome/browser/ui/views/frame/vertical_tab_strip_region_view.h"
 #include "chrome/browser/ui/views/infobars/infobar_container_view.h"
@@ -98,6 +102,12 @@ void InsetHorizontal(gfx::Rect& rect, int amount, bool leading) {
       gfx::Insets::TLBR(0, leading ? amount : 0, 0, !leading ? amount : 0));
 }
 
+bool ShouldUsePrometheusCompactChrome(const Browser* browser) {
+  return browser && browser->profile() &&
+         GetPrometheusChromeMode(*browser->profile()->GetPrefs()) ==
+             PrometheusChromeMode::kCompact;
+}
+
 }  // namespace
 
 // Allocate space across the vertical tabstrip, toolbar, and side panels,
@@ -1206,6 +1216,15 @@ gfx::Rect BrowserViewTabbedLayoutImpl::CalculateTopContainerLayout(
     BrowserLayoutParams params,
     bool needs_exclusion) const {
   const int original_top = params.visual_client_area.y();
+  const bool prometheus_compact_chrome =
+      ShouldUsePrometheusCompactChrome(browser()) &&
+      layout_data_->tab_strip_type == TabStripType::kHorizontal;
+  if (prometheus_compact_chrome) {
+    ApplyPrometheusCompactChromeReservation(params);
+  } else {
+    // Separate/default Prometheus chrome mode keeps Chromium's conventional
+    // top-container layout unchanged.
+  }
 
   if (IsParentedTo(views().horizontal_tab_strip_region_view,
                    views().top_container)) {
@@ -1214,6 +1233,10 @@ gfx::Rect BrowserViewTabbedLayoutImpl::CalculateTopContainerLayout(
       const int leading_margin = GetHorizontalTabStripLeadingMargin(params);
       tabstrip_bounds = GetBoundsWithExclusion(
           params, views().horizontal_tab_strip_region_view, leading_margin);
+      if (prometheus_compact_chrome) {
+        tabstrip_bounds.set_height(std::max(
+            tabstrip_bounds.height(), kPrometheusCompactChromeHeight));
+      }
       params.SetTop(tabstrip_bounds.bottom() -
                     GetLayoutConstant(LayoutConstant::kTabstripToolbarOverlap));
       needs_exclusion = false;
@@ -1235,6 +1258,10 @@ gfx::Rect BrowserViewTabbedLayoutImpl::CalculateTopContainerLayout(
                           params.visual_client_area.y(),
                           params.visual_client_area.width(),
                           views().toolbar->GetPreferredSize().height());
+      if (prometheus_compact_chrome) {
+        toolbar_bounds.set_height(std::max(toolbar_bounds.height(),
+                                           kPrometheusCompactChromeHeight));
+      }
       params.SetTop(toolbar_bounds.bottom());
       needs_exclusion = false;
     }
diff --git a/chrome/browser/ui/views/frame/prometheus_compact_chrome_layout.cc b/chrome/browser/ui/views/frame/prometheus_compact_chrome_layout.cc
new file mode 100644
index 0000000000..f6c5a3d510
--- /dev/null
+++ b/chrome/browser/ui/views/frame/prometheus_compact_chrome_layout.cc
@@ -0,0 +1,53 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/prometheus_compact_chrome_layout.h"
+
+#include <algorithm>
+
+#include "base/numerics/safe_conversions.h"
+
+namespace {
+
+constexpr int kPrometheusCompactNavigationReserveWidth = 132;
+constexpr int kPrometheusCompactTabSearchReserveWidth = 40;
+constexpr int kPrometheusCompactSidePanelReserveWidth = 40;
+constexpr int kPrometheusCompactMenuReserveWidth = 40;
+
+int ExclusionWidth(const BrowserLayoutExclusionArea& exclusion) {
+  return base::ClampCeil(exclusion.ContentWithPadding().width());
+}
+
+}  // namespace
+
+PrometheusCompactChromeAllocation CalculatePrometheusCompactChromeAllocation(
+    const BrowserLayoutParams& params) {
+  PrometheusCompactChromeAllocation allocation;
+  allocation.reserved_control_width =
+      kPrometheusCompactNavigationReserveWidth +
+      kPrometheusCompactTabSearchReserveWidth +
+      kPrometheusCompactSidePanelReserveWidth +
+      kPrometheusCompactMenuReserveWidth;
+
+  allocation.available_location_width =
+      std::max(0, params.visual_client_area.width() -
+                      ExclusionWidth(params.leading_exclusion) -
+                      ExclusionWidth(params.trailing_exclusion) -
+                      allocation.reserved_control_width);
+  allocation.protects_min_location_width =
+      allocation.available_location_width >= kPrometheusCompactMinLocationWidth;
+  return allocation;
+}
+
+void ApplyPrometheusCompactChromeReservation(BrowserLayoutParams& params) {
+  const PrometheusCompactChromeAllocation allocation =
+      CalculatePrometheusCompactChromeAllocation(params);
+  if (!allocation.protects_min_location_width) {
+    return;
+  }
+
+  params.trailing_exclusion.horizontal_padding = std::max(
+      params.trailing_exclusion.horizontal_padding,
+      static_cast<float>(allocation.reserved_control_width));
+}
