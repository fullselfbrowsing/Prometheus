+  EXPECT_TRUE(code_failure.result->pairing_code.empty());
+  ExpectTerminalBuffersClearedExactlyOnce();
+  create_code_succeeds_ = true;
+
+  ASSERT_TRUE(CreateReadyAndClearZeroization());
+  HandoffResponse first = Dispatch(kChallenge, "owner-session", 1);
+  ASSERT_TRUE(first.result);
+  ASSERT_EQ(SupervisionTestHandoffStatus::kDelivered, first.result->status);
+  EXPECT_TRUE(bootstrap_->ObservePairingRedeemed(1));
+  HandoffResponse second = Dispatch(kChallenge, "owner-session", 2);
+  ASSERT_TRUE(second.result);
+  ASSERT_EQ(SupervisionTestHandoffStatus::kDelivered, second.result->status);
+  EXPECT_TRUE(bootstrap_->ObservePairingRedeemed(2));
+  EXPECT_EQ(2u, ZeroizationCount("pairing_code"));
+  EXPECT_EQ(2u, ZeroizationCount("request_challenge"));
+  EXPECT_EQ(2u, ZeroizationCount("request_session_id"));
+  ExpectTerminalBuffersClearedExactlyOnce();
+}
