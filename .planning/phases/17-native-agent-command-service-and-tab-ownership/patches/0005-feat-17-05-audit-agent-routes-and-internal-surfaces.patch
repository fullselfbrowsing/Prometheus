+    const AgentTarget& target,
+    const GURL& url,
+    std::string changed_state) {
+  ResolvedTarget resolved;
+  AgentRouteResult resolved_result =
+      ResolveTarget(browser, target, /*require_tab=*/false, &resolved);
+  if (!resolved_result.ok) {
+    return resolved_result;
+  }
+
+  content::OpenURLParams params(url, content::Referrer(),
+                                WindowOpenDisposition::NEW_FOREGROUND_TAB,
+                                ui::PAGE_TRANSITION_AUTO_BOOKMARK,
+                                /*is_renderer_initiated=*/false);
+  content::WebContents* web_contents =
+      resolved.browser->OpenURL(params, base::NullCallback());
+  if (!web_contents) {
+    return StaleTarget("Failed to open Prometheus internal surface");
+  }
+
+  return SuccessForTarget(
+      {std::move(changed_state)}, resolved.browser,
+      tabs::TabInterface::MaybeGetFromContents(web_contents));
+}
+
+AgentRouteResult PrometheusAgentService::OpenPrometheusSidePanel(
+    BrowserWindowInterface* browser,
+    const AgentTarget& target) {
+  ResolvedTarget resolved;
+  AgentRouteResult resolved_result =
+      ResolveTarget(browser, target, /*require_tab=*/false, &resolved);
+  if (!resolved_result.ok) {
+    return resolved_result;
+  }
+
+  ShowPrometheusSidePanel(resolved.browser,
+                          SidePanelOpenTrigger::kToolbarButton);
+  return SuccessForTarget({"prometheus_side_panel_opened"}, resolved.browser,
+                          nullptr);
+}
