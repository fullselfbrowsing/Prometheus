+SupervisionTestHandoffRequest::SupervisionTestHandoffRequest() = default;
+
+SupervisionTestHandoffRequest::SupervisionTestHandoffRequest(
+    std::string challenge,
+    std::string session_id,
+    int sequence)
+    : challenge(std::move(challenge)),
+      session_id(std::move(session_id)),
+      sequence(sequence) {}
+
+SupervisionTestHandoffRequest::SupervisionTestHandoffRequest(
+    SupervisionTestHandoffRequest&&) = default;
+
+SupervisionTestHandoffRequest& SupervisionTestHandoffRequest::operator=(
+    SupervisionTestHandoffRequest&&) = default;
+
+SupervisionTestHandoffRequest::~SupervisionTestHandoffRequest() {
+  ClearString(&challenge);
+  ClearString(&session_id);
+}
+
+SupervisionTestHandoffResult::SupervisionTestHandoffResult() = default;
+SupervisionTestHandoffResult::SupervisionTestHandoffResult(
+    SupervisionTestHandoffResult&&) = default;
+SupervisionTestHandoffResult& SupervisionTestHandoffResult::operator=(
+    SupervisionTestHandoffResult&&) = default;
+
+SupervisionTestHandoffResult::~SupervisionTestHandoffResult() {
+  ClearString(&pairing_code);
+}
+
+SupervisionTestHandoffResult SupervisionTestHandoffResult::Delivered(
+    int sequence,
+    std::string pairing_code) {
+  SupervisionTestHandoffResult result;
+  result.status = SupervisionTestHandoffStatus::kDelivered;
+  result.sequence = sequence;
+  result.pairing_code = std::move(pairing_code);
+  return result;
+}
+
+SupervisionTestHandoffResult SupervisionTestHandoffResult::Failure(
+    SupervisionTestHandoffStatus status) {
+  SupervisionTestHandoffResult result;
+  result.status = status;
+  return result;
+}
+
+SupervisionTestHandoffParseResult ParseSupervisionTestHandoffRequest(
+    std::string_view body) {
+  static_cast<void>(body);
+  return base::unexpected(SupervisionTestHandoffResult::Failure(
+      SupervisionTestHandoffStatus::kInvalidRequest));
+}
+
+std::string SerializeSupervisionTestHandoffResult(
+    const SupervisionTestHandoffResult& result) {
+  base::DictValue value;
+  const bool delivered =
+      result.status == SupervisionTestHandoffStatus::kDelivered;
+  value.Set("ok", delivered);
+  value.Set("status", HandoffStatusString(result.status));
+  if (delivered) {
+    value.Set("sequence", result.sequence);
+    value.Set("pairing_code", result.pairing_code);
+  }
+  return base::WriteJson(value).value_or(
+      R"({"ok":false,"status":"INVALID_REQUEST"})");
+}
+
 }  // namespace prometheus
