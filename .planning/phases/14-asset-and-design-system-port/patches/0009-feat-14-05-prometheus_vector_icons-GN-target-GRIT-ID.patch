@@ -0,0 +1,124 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// PrometheusAction — semantic action enum and resolver functions for the
+// Prometheus design system icon pipeline. Maps each action to a
+// gfx::VectorIcon (Views) and a WebUI SVG resource path.
+//
+// D-08: One semantic-action resolver mapping PrometheusAction to both the
+//       Views VectorIcon and the WebUI SVG symbol id.
+//
+// Usage examples:
+//   Views:
+//     auto& icon_map = GetPrometheusActionIconMap();
+//     const gfx::VectorIcon* icon = icon_map.at(PrometheusAction::kBolt);
+//     ui::ImageModel img = ui::ImageModel::FromVectorIcon(
+//         *icon, kColorPrometheusAccent, kIconSize);
+//
+//   WebUI:
+//     const char* path = GetPrometheusActionSvgPath(PrometheusAction::kBolt);
+//     // -> "fa_bolt.svg" (relative to the chrome://prometheus/ resources root)
+
+#ifndef CHROME_BROWSER_PROMETHEUS_PROMETHEUS_ACTION_H_
+#define CHROME_BROWSER_PROMETHEUS_PROMETHEUS_ACTION_H_
+
+#include "base/containers/flat_map.h"
+#include "ui/gfx/vector_icon_types.h"
+
+// PrometheusAction: 72 semantic actions mapping to the curated FA Free 6.x
+// icon subset. Values are stable across builds — do not reorder.
+//
+// Substitutions (D-08):
+//   kDownload       — arrow-down-to-line not in FA Free 6 solid; uses arrow-down
+//   kSidebarFlip    — Pro-only icon; uses a hand-authored placeholder
+enum class PrometheusAction {
+  kArrowDownToLine,  // substitution: arrow-down-to-line not in FA Free 6 solid (D-08)
+  kArrowLeft,
+  kArrowRight,
+  kArrowUp,
+  kArrowUpFromBracket,
+  kBars,
+  kBolt,
+  kBookOpen,
+  kCalendarCheck,
+  kCamera,
+  kCartShopping,
+  kCheckDouble,
+  kCircleCheck,
+  kCircleHalfStroke,
+  kCircleInfo,
+  kCircleMinus,
+  kCircleNodes,
+  kCirclePlus,
+  kCircleQuestion,
+  kCircleXmark,
+  kCompass,
+  kCopy,
+  kEye,
+  kFolderPlus,
+  kHeartPulse,
+  kHighlighter,
+  kHouse,
+  kInbox,
+  kKey,
+  kKeyboard,
+  kLanguage,
+  kLayerGroup,
+  kLink,
+  kLinkSlash,
+  kLock,
+  kLockOpen,
+  kMagnifyingGlass,
+  kMicrochip,
+  kMicrophone,
+  kMoon,
+  kNoteSticky,
+  kPalette,
+  kPaste,
+  kPen,
+  kPlug,
+  kPlugCircleXmark,
+  kPlus,
+  kPuzzlePiece,
+  kRotateLeft,
+  kRotateRight,
+  kScissors,
+  kScroll,
+  kServer,
+  kShield,
+  kSidebarFlip,  // placeholder: sidebar-flip is Pro-only (D-08)
+  kSliders,
+  kStar,
+  kStarHalfStroke,
+  kStop,
+  kTable,
+  kTableCellsLarge,
+  kTag,
+  kThumbtack,
+  kTrash,
+  kTriangleExclamation,
+  kUserSecret,
+  kVault,
+  kVolumeHigh,
+  kVolumeXmark,
+  kWandMagicSparkles,
+  kWrench,
+  kXmark,
+};
+
+// Returns a map from PrometheusAction to the corresponding generated
+// gfx::VectorIcon from the prometheus_vector_icons aggregate target.
+// The map is a function-local static (initialized once; thread-safe).
+// Map contains exactly 72 entries — one per PrometheusAction value.
+const base::flat_map<PrometheusAction, const gfx::VectorIcon*>&
+GetPrometheusActionIconMap();
+
+// Returns the WebUI SVG resource path for the given action.
+// Paths are relative to the Prometheus resource root (chrome://prometheus/).
+// Returns a non-empty string for every PrometheusAction value.
+//
+// Example: GetPrometheusActionSvgPath(PrometheusAction::kBolt) -> "fa_bolt.svg"
+const char* GetPrometheusActionSvgPath(PrometheusAction action);
+
+#endif  // CHROME_BROWSER_PROMETHEUS_PROMETHEUS_ACTION_H_
