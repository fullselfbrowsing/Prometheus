+class PrometheusVaultService {
+ public:
+  using NowCallback = base::RepeatingCallback<base::Time()>;
+  using MetadataDeleteCallback =
+      base::OnceCallback<void(PrometheusVaultStatus)>;
+  using NativeEntryCompletion =
+      base::OnceCallback<void(PrometheusVaultStatus)>;
+  using NativeEntryReplyCallback =
