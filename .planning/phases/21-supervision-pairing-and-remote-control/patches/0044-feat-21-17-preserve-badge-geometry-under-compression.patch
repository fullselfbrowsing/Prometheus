+IN_PROC_BROWSER_TEST_F(PrometheusTabSupervisionBadgeBrowserTest,
+                       RealTabCompressionPreservesNativeGeometry) {
+  Tab* const tab = tab_view_at(0);
+  ASSERT_TRUE(tab);
+  PrometheusTabStatusBadge* const badge =
+      tab->prometheus_tab_status_badge_for_testing();
+  ASSERT_TRUE(badge);
+  TabCloseButton* const close_button = tab->close_button();
+  ASSERT_TRUE(close_button);
+
+  std::unique_ptr<prometheus::PrometheusAgentTabData> tab_data =
+      prometheus::PrometheusAgentTabData::ForTabForTesting(
+          tab_interface_at(0));
+  ASSERT_TRUE(tab_data);
+
+  PrometheusTabState::Supervision supervision = ViewingState(2).supervision;
+  supervision.control_state = ControlState::kControllerReady;
+  supervision.controller_label = "Dashboard A";
+  supervision.activity_state = ActivityState::kExecuting;
+  supervision.action_category = ActionCategory::kNavigate;
+  supervision.severity = Severity::kNeedsAttention;
+
+  FlushLayouts();
+  ASSERT_TRUE(close_button->GetVisible());
+  const int normal_tab_height = tab->height();
+  const gfx::Rect normal_close_bounds = close_button->bounds();
+  const gfx::Rect normal_location_bounds =
+      browser_view()->GetLocationBarView()->GetBoundsInScreen();
+  const gfx::Rect normal_title_bounds = tab->title_bounds_for_testing();
+
+  EXPECT_TRUE(tab_data->ClaimIfUnowned("owner-a", "Agent A").ok);
+  tab_data->set_automation_active(true);
+  tab_data->UpdateSupervisionState(supervision);
+  FlushLayouts();
+
+  EXPECT_EQ(gfx::Size(44, 12), badge->GetPreferredSize());
+  EXPECT_EQ(normal_tab_height, tab->height());
+  EXPECT_EQ(normal_close_bounds, close_button->bounds());
+  EXPECT_EQ(normal_location_bounds,
+            browser_view()->GetLocationBarView()->GetBoundsInScreen());
+  EXPECT_EQ(normal_title_bounds.x(), tab->title_bounds_for_testing().x());
+  EXPECT_EQ(normal_title_bounds.height(),
+            tab->title_bounds_for_testing().height());
+  EXPECT_LE(tab->title_bounds_for_testing().right(), badge->x());
+  EXPECT_FALSE(badge->bounds().Intersects(close_button->bounds()));
+
+  ResizeBrowserTo(800, 900);
+  bool found_compressed_supervision_slot = false;
+  for (int i = 0; i < 24; ++i) {
+    AddBackgroundTab();
+    tab_strip()->StopAnimating();
+    FlushLayouts();
+    if (badge->GetPreferredSize().width() <
+            PrometheusTabStatusBadge::kMaximumWidth &&
+        badge->supervision_badge_for_testing()->GetVisible()) {
+      found_compressed_supervision_slot = true;
+      break;
+    }
+  }
+  ASSERT_TRUE(found_compressed_supervision_slot);
+  ASSERT_EQ(tab, tab_view_at(0));
+  const gfx::Size compressed_badge_size = badge->GetPreferredSize();
+
+  tab_data->ClearSupervisionState();
+  EXPECT_TRUE(tab_data->ReleaseIfOwned("owner-a").ok);
+  FlushLayouts();
+
+  const int compressed_tab_height = tab->height();
+  const gfx::Rect compressed_close_bounds = close_button->bounds();
+  const bool compressed_close_visible = close_button->GetVisible();
+  const gfx::Rect compressed_location_bounds =
+      browser_view()->GetLocationBarView()->GetBoundsInScreen();
+  const gfx::Rect compressed_title_bounds = tab->title_bounds_for_testing();
+
+  EXPECT_TRUE(tab_data->ClaimIfUnowned("owner-a", "Agent A").ok);
+  tab_data->set_automation_active(true);
+  tab_data->UpdateSupervisionState(supervision);
+  FlushLayouts();
+
+  EXPECT_EQ(compressed_badge_size, badge->GetPreferredSize());
+  EXPECT_LT(compressed_badge_size.width(),
+            PrometheusTabStatusBadge::kMaximumWidth);
+  EXPECT_TRUE(badge->supervision_badge_for_testing()->GetVisible());
+  EXPECT_EQ(
+      u"Owned by Agent A; Agent is working in this tab; Supervised by 2 trusted clients; Remote control enabled for Dashboard A; Remote action active: Navigate; Tab needs attention",
+      badge->GetViewAccessibility().GetCachedName());
+  EXPECT_EQ(compressed_tab_height, tab->height());
+  EXPECT_EQ(compressed_close_bounds, close_button->bounds());
+  EXPECT_EQ(compressed_close_visible, close_button->GetVisible());
+  if (compressed_close_visible) {
+    EXPECT_GT(close_button->width(), 0);
+  }
+  EXPECT_EQ(compressed_location_bounds,
+            browser_view()->GetLocationBarView()->GetBoundsInScreen());
+  EXPECT_EQ(compressed_title_bounds.x(), tab->title_bounds_for_testing().x());
+  EXPECT_EQ(compressed_title_bounds.height(),
+            tab->title_bounds_for_testing().height());
+  EXPECT_LE(tab->title_bounds_for_testing().width(),
+            compressed_title_bounds.width());
+  if (badge->width() > 0) {
+    EXPECT_LE(tab->title_bounds_for_testing().right(), badge->x());
+  }
+  EXPECT_FALSE(badge->bounds().Intersects(close_button->bounds()));
+}
