+std::optional<std::string> CanonicalSiteOrigin(std::string_view input) {
+  if (input.empty() || input.size() > kMaxPrometheusSecretBindingUrlBytes ||
+      !base::IsStringUTF8(input)) {
+    return std::nullopt;
+  }
+  const GURL url(input);
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || url.host().empty() ||
+      url.has_username() || url.has_password()) {
+    return std::nullopt;
+  }
+  const url::Origin origin = url::Origin::Create(url);
+  if (origin.opaque()) {
