-    service->ExecuteRoute(
-        *request,
-        base::BindOnce(
-            [](ResponseCallback callback, AgentRouteResult result) {
-              auto serialized = SerializeAgentTransportResult(result);
-              if (serialized.has_value()) {
-                std::move(callback).Run(net::HTTP_OK,
-                                        std::move(serialized.value()));
-                return;
-              }
-              AgentRouteResult failure = AgentRouteResult::Failure(
-                  AgentErrorCode::kRequestTooLarge,
-                  "Native route result exceeded transport bounds",
-                  "Reduce requested output bounds and retry");
-              auto failure_json = SerializeAgentTransportResult(failure);
-              std::move(callback).Run(
-                  net::HTTP_OK,
-                  failure_json.has_value()
-                      ? std::move(failure_json.value())
-                      : R"({"ok":false,"error_code":"REQUEST_TOO_LARGE"})");
-            },
-            std::move(callback)));
+    const bool is_supervision = IsAgentSupervisionRoute(request->route_name);
+    BrowserWindowInterface* exact_browser = nullptr;
+    AgentRouteRequest canonical_request = *request;
+    if (is_supervision) {
+      if (HasCallerSelectedSupervisionTarget(request->target)) {
+        std::move(callback).Run(
+            net::HTTP_OK,
+            SerializeRouteFailure(
+                AgentErrorCode::kInvalidTarget,
+                "Supervision scope is derived from the authenticated session",
+                "Remove caller-selected browser, window, tab, and index "
+                "fields"));
+        return;
+      }
+      Profile* const profile = binding->second.profile.get();
+      exact_browser = binding->second.browser.get();
+      const int32_t stable_tab_id = binding->second.stable_tab_id;
+      tabs::TabInterface* const stable_tab =
+          stable_tab_id > 0 ? tabs::TabHandle(stable_tab_id).Get() : nullptr;
+      if (!profile || !profile->IsRegularProfile() || !exact_browser ||
+          exact_browser->IsDeleteScheduled() ||
+          exact_browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+          exact_browser->GetProfile() != profile || !stable_tab ||
+          stable_tab->GetHandle().raw_value() != stable_tab_id ||
+          stable_tab->GetBrowserWindowInterface() != exact_browser) {
+        std::move(callback).Run(
+            net::HTTP_OK,
+            SerializeRouteFailure(
+                AgentErrorCode::kStaleTarget,
+                "The authenticated supervision browser or tab is unavailable",
+                "Create a new browser-issued session from the intended tab"));
+        return;
+      }
+      const int32_t window_id = exact_browser->GetSessionID().id();
+      canonical_request.target.browser_session_id = window_id;
+      canonical_request.target.window_session_id = window_id;
+      canonical_request.target.tab_handle = stable_tab->GetHandle();
+    }
+
+    auto route_callback = base::BindOnce(
+        [](ResponseCallback callback, AgentRouteResult result) {
+          auto serialized = SerializeAgentTransportResult(result);
+          if (serialized.has_value()) {
+            std::move(callback).Run(net::HTTP_OK,
+                                    std::move(serialized.value()));
+            return;
+          }
+          AgentRouteResult failure = AgentRouteResult::Failure(
+              AgentErrorCode::kRequestTooLarge,
+              "Native route result exceeded transport bounds",
+              "Reduce requested output bounds and retry");
+          auto failure_json = SerializeAgentTransportResult(failure);
+          std::move(callback).Run(
+              net::HTTP_OK,
+              failure_json.has_value()
+                  ? std::move(failure_json.value())
+                  : R"({"ok":false,"error_code":"REQUEST_TOO_LARGE"})");
+        },
+        std::move(callback));
+    if (is_supervision) {
+      service->ExecuteBrowserLocalRoute(exact_browser, canonical_request,
+                                        std::move(route_callback));
+    } else {
+      service->ExecuteRoute(canonical_request, std::move(route_callback));
+    }
     return;
   }
 
