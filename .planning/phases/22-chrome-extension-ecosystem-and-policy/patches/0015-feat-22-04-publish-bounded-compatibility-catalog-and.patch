+                "AdBlockerLifecycleAndPermissionIsolation",
+            .last_verified = kLastVerified,
+        },
+        {
+            .category =
+                ExtensionCompatibilityCategory::kProductivityContentScript,
+            .category_key = "productivity_content_script",
+            .category_label = "Productivity content script",
+            .fixture_name = "productivity_content_script",
+            .fixture_version = "1.0.0",
