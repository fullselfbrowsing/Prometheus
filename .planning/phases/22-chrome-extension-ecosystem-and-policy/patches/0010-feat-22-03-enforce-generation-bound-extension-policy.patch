+void PrometheusControlPanelUI::HandleControlSetExtensionPolicyForWebUI(
+    size_t ordinal,
+    uint64_t generation,
+    prometheus::ExtensionAgentGrant grant,
+    bool private_mode) {
+  if (!HasExactControlBinding() || !extension_policy_service_) {
+    SendExtensionPolicyOperation(
+        "TARGET_LOST", false,
+        "Reload the exact regular-profile control panel");
+    SendFreshControlSnapshot();
+    return;
+  }
+  if (pending_extension_policy_mutation_) {
+    SendExtensionPolicyOperation(
+        "MUTATION_PENDING", false,
+        "Finish the current extension policy change, then try again.");
+    return;
+  }
+
+  const prometheus::ExtensionPolicySnapshot snapshot =
+      extension_policy_service_->GetSnapshot();
+  if (snapshot.generation != generation || ordinal >= snapshot.rows.size()) {
+    SendExtensionPolicyOperation(
+        "STALE_POLICY", false,
+        "The extension list changed. Review the current extension and try "
+        "again.");
+    SendFreshControlSnapshot();
+    return;
+  }
+  const prometheus::ExtensionPolicyRow& row = snapshot.rows[ordinal];
+  const std::optional<std::string> extension_id =
+      extension_policy_service_->ResolveExtensionIdForMutation(ordinal,
+                                                               generation);
+  if (!extension_id || !row.enabled) {
+    SendExtensionPolicyOperation(
+        "EXTENSION_NOT_FOUND", false,
+        "Extension no longer available. Refresh the policy list.");
+    SendFreshControlSnapshot();
+    return;
+  }
+  if (private_mode &&
+      (!row.native_private_eligible ||
+       ExtensionGrantRank(grant) >
+           ExtensionGrantRank(row.requested_regular))) {
+    SendExtensionPolicyOperation(
+        "PRIVATE_DENIED", false,
+        "Agent access is blocked for this extension in Private mode.");
+    SendFreshControlSnapshot();
+    return;
+  }
+
+  PendingExtensionPolicyMutation mutation{
+      .ordinal = ordinal,
+      .generation = generation,
+      .extension_id = *extension_id,
+      .grant = grant,
+      .private_mode = private_mode,
+  };
+  const prometheus::ExtensionAgentGrant current_effective =
+      private_mode ? row.effective_private : row.effective_regular;
+  if (grant != prometheus::ExtensionAgentGrant::kInteract ||
+      current_effective == prometheus::ExtensionAgentGrant::kInteract) {
+    ApplyExtensionPolicyMutation(mutation);
+    return;
+  }
+
+  BrowserWindowInterface* const exact_browser =
+      webui::GetBrowserWindowInterface(bound_web_contents_);
+  pending_extension_policy_mutation_ = std::move(mutation);
+  const prometheus::PrometheusExtensionInteractDialogModel model{
+      .extension_name = row.name,
+      .private_mode = private_mode,
+  };
+  if (!prometheus::ShowPrometheusExtensionInteractDialog(
+          exact_browser, model,
+          base::BindOnce(
+              &PrometheusControlPanelUI::OnExtensionInteractConfirmation,
+              weak_factory_.GetWeakPtr()))) {
+    pending_extension_policy_mutation_.reset();
+    SendExtensionPolicyOperation(
+        "DIALOG_UNAVAILABLE", false,
+        "Prometheus could not open the interaction confirmation. Try again.");
+    SendFreshControlSnapshot();
+    return;
+  }
+  views::Widget* const dialog =
+      prometheus::PrometheusRuntimeDialogWidgetForTesting();
+  if (!dialog ||
+      prometheus::PrometheusRuntimeDialogKindForTesting() !=
+          prometheus::PrometheusRuntimeDialogKind::
+              kExtensionInteractConfirmation) {
+    DismissPendingExtensionConfirmation(/*announce_stale=*/false);
+    SendExtensionPolicyOperation(
+        "DIALOG_UNAVAILABLE", false,
+        "Prometheus could not open the interaction confirmation. Try again.");
+    SendFreshControlSnapshot();
+    return;
+  }
+  pending_extension_policy_mutation_->dialog = dialog->GetWeakPtr();
+}
+
+void PrometheusControlPanelUI::ApplyExtensionPolicyMutation(
+    const PendingExtensionPolicyMutation& mutation) {
+  if (!HasExactControlBinding() || !extension_policy_service_) {
+    SendExtensionPolicyOperation(
+        "TARGET_LOST", false,
+        "Reload the exact regular-profile control panel");
+    SendFreshControlSnapshot();
+    return;
+  }
+  const std::optional<std::string> current_extension_id =
+      extension_policy_service_->ResolveExtensionIdForMutation(
+          mutation.ordinal, mutation.generation);
+  if (!current_extension_id ||
+      *current_extension_id != mutation.extension_id) {
+    SendExtensionPolicyOperation(
+        "STALE_POLICY", false,
+        "The extension list changed. Review the current extension and try "
+        "again.");
+    SendFreshControlSnapshot();
+    return;
+  }
+
+  const prometheus::ExtensionPolicyMutationResult result =
+      extension_policy_service_->SetRequestedGrantForExtension(
+          mutation.ordinal, mutation.generation, mutation.extension_id,
+          mutation.private_mode, mutation.grant);
+  switch (result) {
+    case prometheus::ExtensionPolicyMutationResult::kApplied:
+      SendExtensionPolicyOperation("OK", true, std::string());
+      break;
+    case prometheus::ExtensionPolicyMutationResult::kStaleGeneration:
+      SendExtensionPolicyOperation(
+          "STALE_POLICY", false,
+          "The extension list changed. Review the current extension and try "
+          "again.");
+      break;
+    case prometheus::ExtensionPolicyMutationResult::kMissingExtension:
+    case prometheus::ExtensionPolicyMutationResult::kInactiveExtension:
+      SendExtensionPolicyOperation(
+          "EXTENSION_NOT_FOUND", false,
+          "Extension no longer available. Refresh the policy list.");
+      break;
+    case prometheus::ExtensionPolicyMutationResult::kInvalidPrivateGrant:
+      SendExtensionPolicyOperation(
+          "PRIVATE_DENIED", false,
+          "Agent access is blocked for this extension in Private mode.");
+      break;
+    case prometheus::ExtensionPolicyMutationResult::kUnavailable:
+      SendExtensionPolicyOperation(
+          "EXTENSION_UNAVAILABLE", false,
+          "Review extension diagnostics and try again.");
+      break;
+  }
+  SendFreshControlSnapshot();
+}
+
+void PrometheusControlPanelUI::OnExtensionInteractConfirmation(
+    bool accepted) {
+  if (!pending_extension_policy_mutation_) {
+    return;
+  }
+  PendingExtensionPolicyMutation mutation =
+      *pending_extension_policy_mutation_;
+  pending_extension_policy_mutation_.reset();
+  if (!accepted) {
+    SendExtensionPolicyOperation("CANCELLED", false, std::string());
+    SendFreshControlSnapshot();
+    return;
+  }
+  ApplyExtensionPolicyMutation(mutation);
+}
+
+void PrometheusControlPanelUI::OnPrometheusExtensionPolicyChanged(
+    const prometheus::ExtensionPolicySnapshot& snapshot) {
+  if (pending_extension_policy_mutation_ &&
+      pending_extension_policy_mutation_->generation != snapshot.generation) {
+    DismissPendingExtensionConfirmation(/*announce_stale=*/true);
+    return;
+  }
+  SendFreshControlSnapshot();
+}
+
+void PrometheusControlPanelUI::DismissPendingExtensionConfirmation(
+    bool announce_stale) {
+  if (!pending_extension_policy_mutation_) {
+    return;
+  }
+  base::WeakPtr<views::Widget> dialog =
+      pending_extension_policy_mutation_->dialog;
+  pending_extension_policy_mutation_.reset();
+  if (dialog) {
+    dialog->Close();
+  }
+  if (announce_stale) {
+    SendExtensionPolicyOperation(
