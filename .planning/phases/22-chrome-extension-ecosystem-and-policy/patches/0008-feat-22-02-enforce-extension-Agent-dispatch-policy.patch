+void PrometheusExtensionPageAdapter::OnSnapshotReady(
+    AgentRouteName route_name,
+    AgentPageRequest page_request,
+    SurfaceValidationCallback validation_callback,
+    content::GlobalRenderFrameHostId frame_id,
+    AuditedRouteCallback callback,
+    optimization_guide::AIPageContentResultOrError snapshot_result) {
