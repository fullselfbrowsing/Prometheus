+         (to == SupervisionPairingState::kRedeemed ||
+          to == SupervisionPairingState::kCancelled ||
+          to == SupervisionPairingState::kExpired ||
+          to == SupervisionPairingState::kTargetLost);
 }
 
 bool IsTerminalSupervisionPairingState(SupervisionPairingState state) {
+  switch (state) {
+    case SupervisionPairingState::kPending:
+      return false;
+    case SupervisionPairingState::kRedeemed:
+    case SupervisionPairingState::kCancelled:
+    case SupervisionPairingState::kExpired:
+    case SupervisionPairingState::kTargetLost:
+      return true;
+  }
   return false;
 }
 
 bool IsLegalSupervisionViewerTransition(SupervisionViewerState from,
                                         SupervisionViewerState to) {
+  switch (from) {
+    case SupervisionViewerState::kViewOnly:
+      return to == SupervisionViewerState::kController ||
+             to == SupervisionViewerState::kExpired ||
+             to == SupervisionViewerState::kRevoked ||
+             to == SupervisionViewerState::kTargetClosed ||
+             to == SupervisionViewerState::kAuthorityLost ||
+             to == SupervisionViewerState::kEnded;
+    case SupervisionViewerState::kController:
+      return to == SupervisionViewerState::kViewOnly ||
+             to == SupervisionViewerState::kExpired ||
+             to == SupervisionViewerState::kRevoked ||
+             to == SupervisionViewerState::kTargetClosed ||
+             to == SupervisionViewerState::kAuthorityLost ||
+             to == SupervisionViewerState::kEnded;
+    case SupervisionViewerState::kExpired:
+    case SupervisionViewerState::kRevoked:
+    case SupervisionViewerState::kTargetClosed:
+    case SupervisionViewerState::kAuthorityLost:
+    case SupervisionViewerState::kEnded:
+      return false;
+  }
   return false;
 }
 
 bool IsTerminalSupervisionViewerState(SupervisionViewerState state) {
+  switch (state) {
+    case SupervisionViewerState::kViewOnly:
+    case SupervisionViewerState::kController:
+      return false;
+    case SupervisionViewerState::kExpired:
+    case SupervisionViewerState::kRevoked:
+    case SupervisionViewerState::kTargetClosed:
+    case SupervisionViewerState::kAuthorityLost:
+    case SupervisionViewerState::kEnded:
+      return true;
+  }
   return false;
 }
 
 bool IsLegalSupervisionStreamTransition(SupervisionStreamState from,
                                         SupervisionStreamState to) {
+  switch (from) {
+    case SupervisionStreamState::kPreparingBaseline:
+      return to == SupervisionStreamState::kLive ||
+             to == SupervisionStreamState::kResyncing ||
+             to == SupervisionStreamState::kPaused ||
+             to == SupervisionStreamState::kEnded;
+    case SupervisionStreamState::kLive:
+      return to == SupervisionStreamState::kResyncing ||
+             to == SupervisionStreamState::kPaused ||
+             to == SupervisionStreamState::kEnded;
+    case SupervisionStreamState::kResyncing:
+      return to == SupervisionStreamState::kLive ||
+             to == SupervisionStreamState::kPaused ||
+             to == SupervisionStreamState::kEnded;
+    case SupervisionStreamState::kPaused:
+      return to == SupervisionStreamState::kResyncing ||
+             to == SupervisionStreamState::kEnded;
+    case SupervisionStreamState::kEnded:
+      return false;
+  }
   return false;
 }
 
 bool IsLegalSupervisionRemoteActionTransition(SupervisionRemoteActionState from,
                                               SupervisionRemoteActionState to) {
+  switch (from) {
+    case SupervisionRemoteActionState::kIdle:
+      return to == SupervisionRemoteActionState::kValidating;
+    case SupervisionRemoteActionState::kValidating:
+      return to == SupervisionRemoteActionState::kExecuting ||
+             to == SupervisionRemoteActionState::kAwaitingConfirmation ||
+             to == SupervisionRemoteActionState::kBlocked ||
+             to == SupervisionRemoteActionState::kFailed;
+    case SupervisionRemoteActionState::kExecuting:
+      return to == SupervisionRemoteActionState::kVerifying ||
+             to == SupervisionRemoteActionState::kCompleted ||
+             to == SupervisionRemoteActionState::kBlocked ||
+             to == SupervisionRemoteActionState::kFailed;
+    case SupervisionRemoteActionState::kAwaitingConfirmation:
+      return to == SupervisionRemoteActionState::kExecuting ||
+             to == SupervisionRemoteActionState::kBlocked ||
+             to == SupervisionRemoteActionState::kFailed;
+    case SupervisionRemoteActionState::kVerifying:
+      return to == SupervisionRemoteActionState::kCompleted ||
+             to == SupervisionRemoteActionState::kBlocked ||
+             to == SupervisionRemoteActionState::kFailed;
+    case SupervisionRemoteActionState::kCompleted:
+    case SupervisionRemoteActionState::kBlocked:
+    case SupervisionRemoteActionState::kFailed:
+      return false;
+  }
   return false;
 }
 
