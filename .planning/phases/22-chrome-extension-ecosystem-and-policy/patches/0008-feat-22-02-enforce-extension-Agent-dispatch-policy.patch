+// static
+AgentRouteResult PrometheusExtensionPageAdapter::AdmissionFailure(
+    PrometheusExtensionAdmissionDenial denial) {
+  switch (denial) {
+    case PrometheusExtensionAdmissionDenial::kNone:
+      return AgentRouteResult::Success({});
+    case PrometheusExtensionAdmissionDenial::kSurfaceBlocked:
+      return ExactCopyFailure(AgentErrorCode::kPermissionBlocked,
+                              kSurfaceBlocked);
+    case PrometheusExtensionAdmissionDenial::kReadDenied:
+      return ExactCopyFailure(AgentErrorCode::kPermissionBlocked, kReadDenied);
+    case PrometheusExtensionAdmissionDenial::kInteractionDenied:
+      return ExactCopyFailure(AgentErrorCode::kPermissionBlocked,
+                              kInteractionDenied);
+    case PrometheusExtensionAdmissionDenial::kScriptDenied:
+      return ExactCopyFailure(AgentErrorCode::kPermissionBlocked,
+                              kScriptDenied);
+    case PrometheusExtensionAdmissionDenial::kUnsupportedRoute:
+      return ExactCopyFailure(AgentErrorCode::kUnsupportedRoute,
+                              kUnsupportedContext);
+    case PrometheusExtensionAdmissionDenial::kStalePolicy:
+      return ExactCopyFailure(AgentErrorCode::kStaleTarget, kStalePolicy);
+    case PrometheusExtensionAdmissionDenial::kPrivateDenied:
+      return ExactCopyFailure(AgentErrorCode::kPermissionBlocked,
+                              kPrivateDenied);
+    case PrometheusExtensionAdmissionDenial::kUnavailable:
+      return ExactCopyFailure(AgentErrorCode::kStaleTarget,
+                              kExtensionNotFound);
+  }
+}
+
+// static
+std::string PrometheusExtensionPageAdapter::AuditResultFor(
+    const AgentRouteResult& result) {
+  if (result.ok) {
+    return "allowed";
+  }
+  if (result.message == kSurfaceBlocked) {
+    return "surface_blocked";
+  }
+  if (result.message == kReadDenied) {
+    return "read_denied";
+  }
+  if (result.message == kInteractionDenied) {
+    return "interaction_denied";
+  }
+  if (result.message == kScriptDenied) {
+    return "script_denied";
+  }
+  if (result.message == kExtensionNotFound) {
+    return "extension_not_found";
+  }
+  if (result.message == kStalePolicy ||
+      result.error_code == AgentErrorCode::kStaleTarget) {
+    return "stale_policy";
+  }
+  if (result.message == kPrivateDenied) {
+    return "private_denied";
+  }
+  return "unsupported_context";
+}
