+tabs::TabInterface* PrometheusSupervisionProfileService::ResolveExactTarget(
+    const ViewerSession& viewer) const {
+  auto observed = observed_tabs_.find(viewer.stable_tab_id);
+  if (observed == observed_tabs_.end() || !observed->second->lease.data() ||
+      observed->second->tab != viewer.tab || !viewer.exact_browser ||
+      !IsEligibleTarget(profile_, viewer.exact_browser.get(), viewer.tab)) {
+    return nullptr;
+  }
+  return viewer.tab;
+}
