+void PrometheusAgentService::InvalidateTabObservations(int32_t tab_handle) {
+  for (auto token_it = tab_observation_tokens_.begin();
+       token_it != tab_observation_tokens_.end();) {
+    if (token_it->second.tab_handle != tab_handle) {
+      ++token_it;
+      continue;
+    }
+    tab_observation_keys_.erase(
+        std::make_pair(tab_handle, token_it->second.observer.get()));
+    token_it = tab_observation_tokens_.erase(token_it);
+  }
+}
+
+void PrometheusAgentService::SchedulePruneUnownedTabData(int32_t tab_handle) {
+  auto data_it = tab_data_.find(tab_handle);
+  if (data_it == tab_data_.end() || HasTabObservations(tab_handle) ||
+      !data_it->second->data->owner_session_id().empty()) {
+    return;
+  }
+  PrometheusAgentTabData* expected_data = data_it->second->data.get();
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&PrometheusAgentService::PruneUnownedTabData,
+                     weak_factory_.GetWeakPtr(), tab_handle, expected_data));
+}
 
 void PrometheusAgentService::PruneUnownedTabData(
     int32_t tab_handle,
-    PrometheusAgentTabData* expected_data) {}
+    PrometheusAgentTabData* expected_data) {
+  auto data_it = tab_data_.find(tab_handle);
+  if (data_it == tab_data_.end() ||
+      data_it->second->data.get() != expected_data ||
+      HasTabObservations(tab_handle) ||
+      !data_it->second->data->owner_session_id().empty()) {
+    return;
+  }
+  InvalidateTabObservations(tab_handle);
+  tab_data_.erase(data_it);
+}
 
 bool PrometheusAgentService::HasTabObservations(int32_t tab_handle) const {
+  for (const auto& [token, observation] : tab_observation_tokens_) {
+    if (observation.tab_handle == tab_handle) {
+      return true;
+    }
+  }
   return false;
 }
 
