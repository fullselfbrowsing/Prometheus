+TEST_F(PrometheusSupervisionDocumentSupplementTest, DirtyForCharacterData) {
+  Text* text = Text::Create(GetDocument(), "before");
+  GetDocument().body()->AppendChild(text);
+  test::RunPendingTasks();
+
+  RecordingHost host;
+  Enable(host);
+  text->setData("after");
+  test::RunPendingTasks();
+  AdvanceDebounce();
+
+  ASSERT_EQ(host.signals().size(), 1u);
+  EXPECT_EQ(host.signals()[0], DirtySignal::kDirty);
+}
