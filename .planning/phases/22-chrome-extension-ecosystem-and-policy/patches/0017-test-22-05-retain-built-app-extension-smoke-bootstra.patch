+bool IsWellFormedExtensionId(const std::string& id) {
+  if (id.size() != 32) {
+    return false;
+  }
+  for (char character : id) {
+    if (character < 'a' || character > 'p') {
+      return false;
+    }
+  }
+  return true;
+}
