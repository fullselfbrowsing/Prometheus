+
+bool ReadListLimit(const base::DictValue& value, size_t* output) {
+  const base::Value* field = value.Find("limit");
+  if (!field) {
+    *output = kMaxRuntimeTransportListItems;
+    return true;
+  }
+  if (!field->is_int() || field->GetInt() < 1 ||
+      field->GetInt() > static_cast<int>(kMaxRuntimeTransportListItems)) {
+    return false;
+  }
+  *output = static_cast<size_t>(field->GetInt());
+  return true;
+}
+
+bool ReadTags(const base::DictValue& value, std::vector<std::string>* output) {
+  const base::ListValue* tags = value.FindList("tags");
+  if (!tags || tags->size() > kMaxMemoryTags) {
+    return false;
+  }
+  output->clear();
+  output->reserve(tags->size());
+  for (const base::Value& tag : *tags) {
+    if (!IsBoundedString(&tag, kMaxMemoryTagBytes)) {
+      return false;
+    }
+    output->push_back(tag.GetString());
+  }
+  return true;
+}
