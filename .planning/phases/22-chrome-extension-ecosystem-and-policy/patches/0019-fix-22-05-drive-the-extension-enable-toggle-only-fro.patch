       base::TimeTicks::Now() < deadline) {
     base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
         FROM_HERE,
@@ -904,6 +956,32 @@ void PrometheusExtensionSmokeController::OnEnableClickIssued(
   Fail(stage_, "enable_click_failed:" + status);
 }
 
+void PrometheusExtensionSmokeController::PollExtensionReady(
+    base::TimeTicks deadline) {
+  if (shutdown_ || outcome_ != PrometheusExtensionSmokeOutcome::kRunning ||
+      stage_ != PrometheusExtensionSmokeStage::kEnabled) {
+    return;
+  }
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(profile_);
+  extensions::ExtensionSystem* system =
+      extensions::ExtensionSystem::Get(profile_);
+  if (registry && system && system->is_ready() &&
+      registry->ready_extensions().Contains(extension_id_)) {
+    ExercisePolicyGrants();
+    return;
+  }
+  if (base::TimeTicks::Now() >= deadline) {
+    Fail(stage_, "extension_not_ready_timeout");
+    return;
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&PrometheusExtensionSmokeController::PollExtensionReady,
+                     weak_ptr_factory_.GetWeakPtr(), deadline),
+      kPollInterval);
+}
