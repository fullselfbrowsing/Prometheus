diff --git a/chrome/browser/resources/prometheus/prometheus_webui.js b/chrome/browser/resources/prometheus/prometheus_webui.js
index 87c04bd5de..4243118433 100644
--- a/chrome/browser/resources/prometheus/prometheus_webui.js
+++ b/chrome/browser/resources/prometheus/prometheus_webui.js
@@ -1763,6 +1763,107 @@ const controlSupervisionAuditLabels = Object.freeze({
   authority_lost: 'Authority lost',
 });
 
+function controlSupervisionText(value, fallback = '', limit = 256) {
+  if (typeof value !== 'string' || value.length > limit ||
+      /[\u0000-\u001f\u007f-\u009f\u202a-\u202e\u2066-\u2069]/u
+          .test(value)) {
+    return fallback;
+  }
+  return value;
+}
+
+function controlSupervisionTimestamp(value) {
+  const number = Number(value);
+  return Number.isSafeInteger(number) && number >= 0 ? number : 0;
+}
+
+function normalizeControlSupervisionSnapshot(value) {
+  if (!value || typeof value !== 'object') {
+    return null;
+  }
+  const result = {
+    available: value.available === true,
+    pairing_state: controlSupervisionText(
+        value.pairing_state, 'target_lost', 32),
+    safe_target_title:
+        controlSupervisionText(value.safe_target_title, '', 256),
+    safe_origin: controlSupervisionText(value.safe_origin, '', 2048),
+    agent_active: value.agent_active === true,
+    viewer_count: controlInteger(value.viewer_count),
+    targets: [],
+    connected: [],
+    recent: [],
+    audit: [],
+  };
+  if (typeof value.controller_label === 'string') {
+    result.controller_label =
+        controlSupervisionText(value.controller_label, 'Local dashboard', 160);
+  }
+  for (const target of controlArray(value.targets).slice(0, 64)) {
+    const ordinal = Number(target?.ordinal);
+    if (!Number.isSafeInteger(ordinal) || ordinal < 0) {
+      continue;
+    }
+    result.targets.push({
+      ordinal,
+      safe_title: controlSupervisionText(
+          target?.safe_title, 'Untitled tab', 256),
+      safe_origin: controlSupervisionText(
+          target?.safe_origin, 'Unavailable', 2048),
+      selected: target?.selected === true,
+      agent_active: target?.agent_active === true,
+    });
+  }
+  for (const row of controlArray(value.connected).slice(0, 16)) {
+    const connected = {
+      display_label: controlSupervisionText(
+          row?.display_label, 'Local dashboard', 160),
+      access: controlSupervisionText(row?.access, 'view_only', 32),
+      stream_state: controlSupervisionText(row?.stream_state, 'ended', 32),
+      action_state: controlSupervisionText(row?.action_state, 'idle', 32),
+      connected_at_ms: controlSupervisionTimestamp(row?.connected_at_ms),
+      last_seen_at_ms: controlSupervisionTimestamp(row?.last_seen_at_ms),
+      expires_at_ms: controlSupervisionTimestamp(row?.expires_at_ms),
+    };
+    if (typeof row?.action_category === 'string') {
+      connected.action_category =
+          controlSupervisionText(row.action_category, '', 32);
+    }
+    result.connected.push(connected);
+  }
+  for (const row of controlArray(value.recent).slice(0, 20)) {
+    result.recent.push({
+      display_label: controlSupervisionText(
+          row?.display_label, 'Local dashboard', 160),
+      state: controlSupervisionText(row?.state, 'ended', 32),
+      reason: controlSupervisionText(row?.reason, 'none', 32),
+      last_seen_at_ms: controlSupervisionTimestamp(row?.last_seen_at_ms),
+    });
+  }
+  for (const row of controlArray(value.audit).slice(0, 20)) {
+    const audit = {
+      event: controlSupervisionText(row?.event, '', 48),
+      timestamp_ms: controlSupervisionTimestamp(row?.timestamp_ms),
+      safe_target_title: controlSupervisionText(
+          row?.safe_target_title, 'Unavailable', 256),
+      safe_origin: controlSupervisionText(
+          row?.safe_origin, 'Unavailable', 2048),
+      error: controlSupervisionText(row?.error, 'NONE', 48),
+      duration_ms: controlSupervisionTimestamp(row?.duration_ms),
+    };
+    if (typeof row?.client_label === 'string') {
+      audit.client_label = controlSupervisionText(
+          row.client_label, 'Local dashboard', 160);
+    }
+    if (typeof row?.action_category === 'string') {
+      audit.action_category =
+          controlSupervisionText(row.action_category, '', 32);
+    }
+    result.audit.push(audit);
+  }
+  return result;
+}
+
 function controlSupervisionRows() {
   const supervision = controlSnapshot.supervision;
   return supervision && typeof supervision === 'object' ? supervision : null;
@@ -2404,7 +2505,7 @@ function renderControlSnapshot(snapshot) {
   const focusKey = document.activeElement?.dataset?.controlFocusKey || '';
   const supervisionFocusLabel =
       controlSupervisionFocusLabels.get(document.activeElement) || '';
-  controlSnapshot = snapshot && typeof snapshot === 'object' ? snapshot : {
+  const candidate = snapshot && typeof snapshot === 'object' ? snapshot : {
     status: 'INVALID_REQUEST',
     tasks: [],
     providers: [],
@@ -2417,6 +2518,15 @@ function renderControlSnapshot(snapshot) {
     diagnostics: [],
     recovery: 'Refresh the control panel and retry',
   };
+  const codeFreeCandidate = {...candidate};
+  const candidateSupervision = codeFreeCandidate.supervision;
+  delete codeFreeCandidate.formatted_code;
+  delete codeFreeCandidate.pairing_code;
+  delete codeFreeCandidate.supervision;
