+
+void PrometheusControlPanelUI::HandleControlRetrySupervisionBaselineForWebUI(
+    size_t ordinal) {
+  SendControlOperation(
+      HasExactControlBinding()
+          ? prometheus::ControlSupervisionOperationValue(
