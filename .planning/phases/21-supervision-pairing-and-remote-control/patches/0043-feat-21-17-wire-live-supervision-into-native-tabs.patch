   return state == prometheus::SupervisionViewerState::kViewOnly ||
@@ -142,6 +151,63 @@ PrometheusTabState PrometheusTabState::SafeDefault() {
   return PrometheusTabState();
 }
 
+PrometheusTabStateObservation::PrometheusTabStateObservation(
+    tabs::TabInterface* tab,
+    PrometheusTabStateObserver* observer)
+    : tab_(tab), observer_(observer) {
+  CHECK(tab_);
+  CHECK(observer_);
+  GetTabStateObservations().push_back(this);
+  AttachToCurrentSource();
+}
+
+PrometheusTabStateObservation::~PrometheusTabStateObservation() {
+  if (source_) {
+    source_->RemoveTabStateObserver(this);
+  }
+  std::erase(GetTabStateObservations(), this);
+}
+
+// static
+void PrometheusTabStateObservation::NotifySourceAvailable(
+    tabs::TabInterface* tab) {
+  CHECK(tab);
+  const TabStateObservations observations = GetTabStateObservations();
+  for (PrometheusTabStateObservation* observation : observations) {
+    if (observation->tab_ == tab) {
+      observation->AttachToCurrentSource();
+    }
+  }
+}
+
+void PrometheusTabStateObservation::AttachToCurrentSource() {
+  prometheus::PrometheusAgentTabData* source =
+      prometheus::PrometheusAgentTabData::From(tab_);
+  if (source_ == source) {
+    return;
+  }
+  if (source_) {
+    source_->RemoveTabStateObserver(this);
+  }
+  source_ = source;
+  if (!source_) {
+    observer_->OnPrometheusTabStateChanged(PrometheusTabState::SafeDefault());
+    return;
+  }
+  source_->AddTabStateObserver(this);
+  observer_->OnPrometheusTabStateChanged(source_->ToTabState());
+}
+
+void PrometheusTabStateObservation::OnPrometheusTabStateChanged(
+    const PrometheusTabState& state) {
+  observer_->OnPrometheusTabStateChanged(state);
+}
+
+void PrometheusTabStateObservation::OnPrometheusTabStateInvalidated() {
+  source_ = nullptr;
+  observer_->OnPrometheusTabStateInvalidated();
+}
+
 PrometheusTabState::Supervision ProjectPrometheusTabSupervisionState(
     const prometheus::SanitizedSupervisionSnapshot& snapshot) {
   TabSupervision result;
