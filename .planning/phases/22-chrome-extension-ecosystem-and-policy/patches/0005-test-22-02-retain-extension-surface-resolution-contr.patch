diff --git a/chrome/browser/prometheus/prometheus_extension_surface_resolver.cc b/chrome/browser/prometheus/prometheus_extension_surface_resolver.cc
new file mode 100644
index 0000000000..e11754ba65
--- /dev/null
+++ b/chrome/browser/prometheus/prometheus_extension_surface_resolver.cc
@@ -0,0 +1,152 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_extension_surface_resolver.h"
+
+#include <utility>
+
+namespace prometheus {
+namespace {
+
+PrometheusExtensionSurfaceClassification Deny(
+    PrometheusExtensionSurfaceDenial denial,
+    AgentErrorCode error_code) {
+  return {.kind = std::nullopt,
+          .denial = denial,
+          .error_code = error_code};
+}
+
+PrometheusExtensionSurfaceClassification Accept(
+    PrometheusExtensionSurfaceKind kind) {
+  return {.kind = kind,
+          .denial = PrometheusExtensionSurfaceDenial::kNone,
+          .error_code = AgentErrorCode::kNone};
+}
+
+}  // namespace
+
+PrometheusExtensionSurfaceResolver::PrometheusExtensionSurfaceResolver(
+    PrometheusExtensionPolicyService* policy_service)
+    : policy_service_(policy_service) {}
+
+PrometheusExtensionSurfaceResolver::~PrometheusExtensionSurfaceResolver() =
+    default;
+
+base::expected<PrometheusResolvedExtensionSurface, AgentRouteResult>
+PrometheusExtensionSurfaceResolver::Resolve(
+    Browser* browser,
+    tabs::TabInterface* anchor_tab,
+    std::optional<AgentExtensionSurfaceSelector> selector,
+    std::optional<uint64_t> expected_policy_generation) const {
+  static_cast<void>(browser);
+  static_cast<void>(anchor_tab);
+  static_cast<void>(selector);
+  static_cast<void>(expected_policy_generation);
+  return base::unexpected(AgentRouteResult::Failure(
+      AgentErrorCode::kInvalidTarget,
+      "The selected extension surface is not available",
+      "Show the extension surface in the selected tab and retry"));
+}
+
+// static
+PrometheusExtensionSurfaceClassification
+PrometheusExtensionSurfaceResolver::ClassifyEvidenceForTesting(
+    const PrometheusExtensionSurfaceEvidence& evidence) {
+  if (evidence.expected_policy_generation.has_value() &&
+      *evidence.expected_policy_generation != evidence.policy_generation) {
+    return Deny(PrometheusExtensionSurfaceDenial::kStaleGeneration,
+                AgentErrorCode::kStaleTarget);
+  }
+  if (!evidence.lifecycle_alive) {
+    return Deny(PrometheusExtensionSurfaceDenial::kLifecycleLost,
+                AgentErrorCode::kStaleTarget);
+  }
+  if (!evidence.extension_system_ready) {
+    return Deny(PrometheusExtensionSurfaceDenial::kSystemUnavailable,
+                AgentErrorCode::kStaleTarget);
+  }
+  if (!evidence.extension_enabled || evidence.extension_terminated) {
+    return Deny(PrometheusExtensionSurfaceDenial::kExtensionUnavailable,
+                AgentErrorCode::kStaleTarget);
+  }
+  if (evidence.selector.has_value()) {
+    if (evidence.selector_match_count == 0u) {
+      return Deny(PrometheusExtensionSurfaceDenial::kNoSelectorMatch,
+                  AgentErrorCode::kInvalidTarget);
+    }
+    if (evidence.selector_match_count != 1u) {
+      return Deny(PrometheusExtensionSurfaceDenial::kAmbiguousSelectorMatch,
+                  AgentErrorCode::kInvalidTarget);
+    }
+  }
+  if (!evidence.primary_frame_committed) {
+    return Deny(PrometheusExtensionSurfaceDenial::kUncommittedPrimaryFrame,
+                AgentErrorCode::kStaleTarget);
+  }
+  if (!evidence.extension_origin ||
+      !evidence.origin_matches_browser_identity) {
+    return Deny(PrometheusExtensionSurfaceDenial::kMismatchedExtensionOrigin,
+                AgentErrorCode::kInvalidTarget);
+  }
+  if (!evidence.exact_browser) {
+    return Deny(PrometheusExtensionSurfaceDenial::kWrongBrowser,
+                AgentErrorCode::kInvalidTarget);
+  }
+  if (!evidence.exact_browser_context) {
+    return Deny(PrometheusExtensionSurfaceDenial::kWrongBrowserContext,
+                AgentErrorCode::kInvalidTarget);
+  }
+  if (!evidence.visible) {
+    return Deny(PrometheusExtensionSurfaceDenial::kHiddenSurface,
+                AgentErrorCode::kInvalidTarget);
+  }
+  if (!evidence.browser_ui_owned) {
+    return Deny(PrometheusExtensionSurfaceDenial::kUnownedSurface,
+                AgentErrorCode::kInvalidTarget);
+  }
+
+  switch (evidence.observed_context) {
+    case PrometheusExtensionObservedContext::kTabContents:
+      if (evidence.selector.has_value()) {
+        return Deny(PrometheusExtensionSurfaceDenial::kWrongSelectorKind,
+                    AgentErrorCode::kInvalidTarget);
+      }
+      return Accept(evidence.options_page
+                        ? PrometheusExtensionSurfaceKind::kOptionsPage
+                        : PrometheusExtensionSurfaceKind::kTab);
+    case PrometheusExtensionObservedContext::kPopup:
+      if (evidence.selector != AgentExtensionSurfaceSelector::kPopup) {
+        return Deny(PrometheusExtensionSurfaceDenial::kWrongSelectorKind,
+                    AgentErrorCode::kInvalidTarget);
+      }
+      return Accept(PrometheusExtensionSurfaceKind::kPopup);
+    case PrometheusExtensionObservedContext::kSidePanel:
+      if (evidence.selector != AgentExtensionSurfaceSelector::kSidePanel) {
+        return Deny(PrometheusExtensionSurfaceDenial::kWrongSelectorKind,
+                    AgentErrorCode::kInvalidTarget);
+      }
+      return Accept(PrometheusExtensionSurfaceKind::kSidePanel);
+    case PrometheusExtensionObservedContext::kOptionsGuest:
+      if (evidence.selector.has_value() ||
+          !evidence.options_guest_primary_frame ||
+          evidence.options_guest_ambiguous) {
+        return Deny(PrometheusExtensionSurfaceDenial::kAmbiguousOptionsGuest,
+                    AgentErrorCode::kInvalidTarget);
+      }
+      return Accept(PrometheusExtensionSurfaceKind::kOptionsGuest);
+    case PrometheusExtensionObservedContext::kBackgroundPage:
+    case PrometheusExtensionObservedContext::kBackgroundContents:
+    case PrometheusExtensionObservedContext::kOffscreenDocument:
+    case PrometheusExtensionObservedContext::kDeveloperTools:
+    case PrometheusExtensionObservedContext::kUnknown:
+      return Deny(PrometheusExtensionSurfaceDenial::kUnsupportedContext,
+                  AgentErrorCode::kInvalidTarget);
+  }
+}
+
+bool ExtensionSurfaceResolutionContractImplementedForTesting() {
+  return false;
+}
+
+}  // namespace prometheus
