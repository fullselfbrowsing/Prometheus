+scoped_refptr<const extensions::Extension> MakeExtension(
+    std::string name,
+    std::string extension_id) {
+  return extensions::ExtensionBuilder(std::move(name))
+      .SetID(std::move(extension_id))
+      .Build();
+}
+
+class RecordingPolicyObserver
+    : public PrometheusExtensionPolicyServiceObserver {
+ public:
+  RecordingPolicyObserver(PrometheusExtensionPolicyService* service,
+                          PrefService* prefs = nullptr,
+                          std::string extension_id = std::string())
+      : service_(service),
+        prefs_(prefs),
+        extension_id_(std::move(extension_id)) {
+    service_->AddObserver(this);
+  }
+
+  RecordingPolicyObserver(const RecordingPolicyObserver&) = delete;
+  RecordingPolicyObserver& operator=(const RecordingPolicyObserver&) = delete;
+
+  ~RecordingPolicyObserver() override { service_->RemoveObserver(this); }
+
+  void OnPrometheusExtensionPolicyChanged(
+      const ExtensionPolicySnapshot& snapshot) override {
+    snapshots.push_back(snapshot);
+    if (prefs_ && !extension_id_.empty()) {
+      choice_present_during_notification.push_back(
+          ReadPrometheusExtensionPolicyChoices(*prefs_).contains(
+              extension_id_));
+    }
+    if (!extension_id_.empty()) {
+      private_grants_during_notification.push_back(
+          service_->GetEffectiveGrant(extension_id_, nullptr,
+                                      /*private_mode=*/true));
+    }
+    if (reenter_once && snapshots.size() == 1u) {
+      service_->ReconcileForTesting();
+    }
+  }
+
+  bool reenter_once = false;
+  std::vector<ExtensionPolicySnapshot> snapshots;
+  std::vector<bool> choice_present_during_notification;
+  std::vector<ExtensionAgentGrant> private_grants_during_notification;
+
+ private:
+  raw_ptr<PrometheusExtensionPolicyService> service_;
+  raw_ptr<PrefService> prefs_;
+  std::string extension_id_;
+};
+
 void RequireGreenContract() {
   ASSERT_TRUE(ExtensionPolicyContractImplementedForTesting())
       << "retained RED: bounded extension policy behavior is not implemented";
@@ -378,5 +434,224 @@ TEST(PrometheusExtensionPolicyFactoryTest,
                   HasExtensionRegistryDependencyForTesting());
 }
 
+TEST(PrometheusExtensionPolicyRegistryTest,
+     ReadyInstallEnableDisableTerminateAndReloadRequeryById) {
+  ASSERT_TRUE(ExtensionPolicyLifecycleImplementedForTesting())
+      << "retained RED: registry lifecycle reconciliation is not implemented";
+  sync_preferences::TestingPrefServiceSyncable prefs;
+  RegisterPrometheusExtensionPolicyProfilePrefs(prefs.registry());
+  PrometheusExtensionPolicyService service(nullptr, &prefs, nullptr);
+  service.SetSystemReadyForTesting(true);
+  service.SetInventoryForTesting({MakeInventoryEntry(kFirstExtensionId)});
+  scoped_refptr<const extensions::Extension> extension =
+      MakeExtension("First extension", kFirstExtensionId);
+
+  ExtensionPolicySnapshot snapshot = service.GetSnapshot();
+  ASSERT_EQ(
+      ExtensionPolicyMutationResult::kApplied,
+      service.SetRequestedGrant(0, snapshot.generation, /*private_mode=*/false,
+                                ExtensionAgentGrant::kInteract));
+  const size_t lookup_count = service.registry_lookup_count_for_testing();
+
+  ExtensionPolicyInventoryEntry inactive =
+      MakeInventoryEntry(kFirstExtensionId);
+  inactive.enabled = false;
+  inactive.ready = false;
+  service.SetInventoryForTesting({inactive});
+  service.OnExtensionUnloaded(nullptr, extension.get(),
+                              extensions::UnloadedExtensionReason::DISABLE);
+  EXPECT_EQ(ExtensionAgentGrant::kBlocked,
+            service.GetEffectiveGrant(kFirstExtensionId, nullptr,
+                                      /*private_mode=*/false));
+  EXPECT_GT(service.registry_lookup_count_for_testing(), lookup_count);
+  EXPECT_EQ(ExtensionAgentGrant::kInteract,
+            ReadPrometheusExtensionPolicyChoices(prefs)
+                .at(kFirstExtensionId)
+                .regular);
+
+  service.OnExtensionUnloaded(nullptr, extension.get(),
+                              extensions::UnloadedExtensionReason::TERMINATE);
+  service.SetInventoryForTesting({MakeInventoryEntry(kFirstExtensionId)});
+  service.OnExtensionLoaded(nullptr, extension.get());
+  service.OnExtensionReady(nullptr, extension.get());
+  EXPECT_EQ(ExtensionAgentGrant::kInteract,
+            service.GetEffectiveGrant(kFirstExtensionId, nullptr,
+                                      /*private_mode=*/false));
+
+  scoped_refptr<const extensions::Extension> second =
+      MakeExtension("Second extension", kSecondExtensionId);
+  service.SetInventoryForTesting({MakeInventoryEntry(kFirstExtensionId),
+                                  MakeInventoryEntry(kSecondExtensionId)});
+  service.OnExtensionInstalled(nullptr, second.get(), /*is_update=*/false);
+  EXPECT_EQ(2u, service.GetSnapshot().rows.size());
+
+  service.SetSystemReadyForTesting(false);
+  service.ReconcileForTesting();
+  EXPECT_EQ(ExtensionAgentGrant::kBlocked,
+            service.GetEffectiveGrant(kFirstExtensionId, nullptr,
+                                      /*private_mode=*/false));
+}
+
+TEST(PrometheusExtensionPolicyRegistryTest,
+     UninstallErasesPersistedChoiceBeforeNotification) {
+  ASSERT_TRUE(ExtensionPolicyLifecycleImplementedForTesting())
+      << "retained RED: registry lifecycle reconciliation is not implemented";
+  sync_preferences::TestingPrefServiceSyncable prefs;
+  RegisterPrometheusExtensionPolicyProfilePrefs(prefs.registry());
+  PrometheusExtensionPolicyService service(nullptr, &prefs, nullptr);
+  service.SetSystemReadyForTesting(true);
+  service.SetInventoryForTesting({MakeInventoryEntry(kFirstExtensionId)});
+  scoped_refptr<const extensions::Extension> extension =
+      MakeExtension("First extension", kFirstExtensionId);
+
+  ExtensionPolicySnapshot snapshot = service.GetSnapshot();
+  ASSERT_EQ(
+      ExtensionPolicyMutationResult::kApplied,
+      service.SetRequestedGrant(0, snapshot.generation, /*private_mode=*/false,
+                                ExtensionAgentGrant::kInteract));
+  RecordingPolicyObserver observer(&service, &prefs, kFirstExtensionId);
+
+  service.SetInventoryForTesting({});
+  service.OnExtensionUninstalled(nullptr, extension.get(),
+                                 extensions::UNINSTALL_REASON_FOR_TESTING);
+
+  ASSERT_EQ(1u, observer.snapshots.size());
+  ASSERT_EQ(1u, observer.choice_present_during_notification.size());
+  EXPECT_FALSE(observer.choice_present_during_notification.front());
+  EXPECT_TRUE(ReadPrometheusExtensionPolicyChoices(prefs).empty());
+  EXPECT_TRUE(observer.snapshots.front().rows.empty());
+}
