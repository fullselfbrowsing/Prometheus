+IN_PROC_BROWSER_TEST_F(PrometheusAgentGatewayBrowserTest,
+                       SupervisionHealthUsesOnlySanitizedReadiness) {
+  auto read_status = [](const HttpResult& response, std::string_view key) {
+    std::string status;
+    auto root =
+        base::JSONReader::ReadDict(response.body, base::JSON_PARSE_RFC);
+    EXPECT_TRUE(root.has_value()) << response.body;
+    const base::ListValue* diagnostics =
+        root ? root->FindList("diagnostics") : nullptr;
+    EXPECT_TRUE(diagnostics);
+    if (!diagnostics) {
+      return status;
+    }
+    for (const base::Value& value : *diagnostics) {
+      const base::DictValue* diagnostic = value.GetIfDict();
+      if (diagnostic && diagnostic->FindString("key") &&
+          *diagnostic->FindString("key") == key &&
+          diagnostic->FindString("status")) {
+        return *diagnostic->FindString("status");
+      }
+    }
+    return status;
+  };
+
+  supervision_readiness_ = SupervisionGatewayReadiness{
+      .status = SupervisionGatewayReadinessStatus::kReady,
+      .reason = "Supervision transport is ready",
+      .next_action = "No supervision recovery action is required",
+  };
+  HttpResult ready = Authorized("GET", "/v1/health", "");
+  EXPECT_EQ(200, ready.status);
+  EXPECT_EQ("ready", read_status(ready, "supervision"));
+  EXPECT_EQ("not_ready", read_status(ready, "extensions"));
+
+  supervision_readiness_.reason = "Bearer SECRET-READINESS-SENTINEL";
+  HttpResult rejected = Authorized("GET", "/v1/health", "");
+  EXPECT_EQ("not_ready", read_status(rejected, "supervision"));
+  EXPECT_EQ(std::string::npos,
+            rejected.body.find("SECRET-READINESS-SENTINEL"));
+
+  gateway_->SetSupervisionGatewayDispatcher({});
+  HttpResult absent = Authorized("GET", "/v1/health", "");
+  EXPECT_EQ("not_ready", read_status(absent, "supervision"));
+  EXPECT_EQ("not_ready", read_status(absent, "extensions"));
+}
