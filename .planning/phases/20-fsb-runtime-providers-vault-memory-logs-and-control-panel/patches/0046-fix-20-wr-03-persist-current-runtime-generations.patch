+TEST_F(PrometheusRuntimeProfileServiceTest,
+       OwnedStorePersistsRunningGenerationAndSuccessAcrossReconstruction) {
+  service_.reset();
+  sync_preferences::TestingPrefServiceSyncable prefs;
+  RegisterPrometheusRuntimeProfilePrefs(prefs.registry());
+  FakeRuntimeProfileBoundaries persisted_boundaries;
+  ProviderTurnResult tool_call = ProviderSuccess("");
+  tool_call.stop_reason = ProviderStopReason::kToolCall;
+  tool_call.tool_call.emplace();
+  tool_call.tool_call->call_id = "persisted-read-call";
+  tool_call.tool_call->name = "read_page";
+  tool_call.usage.tool_calls = 1;
+  persisted_boundaries.provider_results.push_back(std::move(tool_call));
+  persisted_boundaries.provider_results.push_back(
+      ProviderSuccess("persisted verified result"));
+
+  std::string task_id;
+  {
+    RuntimeProfileHooks hooks = persisted_boundaries.MakeHooks();
+    hooks.expected_caller_id = "caller-1";
+    hooks.expected_browser = browser();
+    hooks.expected_stable_tab_id = 7;
+    hooks.auto_start_tasks = true;
+    PrometheusRuntimeProfileService service(std::move(hooks), &prefs);
+    RuntimeSubmitRequest request = Request();
+    request.prompt = "Persist a verified result";
+    RuntimeSubmitResult submitted = service.SubmitTask(std::move(request));
+    ASSERT_EQ(submitted.status, RuntimeProfileStatus::kOk);
+    ASSERT_TRUE(submitted.task);
+    task_id = submitted.task->task_id;
+    EXPECT_EQ(persisted_boundaries.execute_route_count, 1);
+    EXPECT_EQ(persisted_boundaries.provider_turn_count, 2);
+
+    const RuntimeStoreSnapshot persisted =
+        service.GetRuntimeSnapshotForTransport();
+    ASSERT_EQ(persisted.tasks.size(), 1u);
+    EXPECT_EQ(persisted.tasks[0].snapshot.task_id, task_id);
+    EXPECT_EQ(persisted.tasks[0].snapshot.state, RuntimeTaskState::kSucceeded);
+    EXPECT_EQ(persisted.tasks[0].generation, 2u);
+    ASSERT_TRUE(persisted.tasks[0].result);
+    EXPECT_EQ(persisted.tasks[0].result->text, "persisted verified result");
+    ASSERT_EQ(persisted.events.size(), 3u);
+    EXPECT_EQ(persisted.events[0].kind, RuntimeEventKind::kTaskCreated);
+    EXPECT_EQ(persisted.events[1].kind, RuntimeEventKind::kStateChanged);
+    EXPECT_EQ(persisted.events[2].kind, RuntimeEventKind::kTaskFinished);
+  }
+
+  RuntimeProfileHooks reconstructed_hooks = persisted_boundaries.MakeHooks();
+  PrometheusRuntimeProfileService reconstructed(std::move(reconstructed_hooks),
+                                                &prefs);
+  const RuntimeStoreSnapshot after_restart =
+      reconstructed.GetRuntimeSnapshotForTransport();
+  ASSERT_EQ(after_restart.tasks.size(), 1u);
+  EXPECT_EQ(after_restart.tasks[0].snapshot.task_id, task_id);
+  EXPECT_EQ(after_restart.tasks[0].snapshot.state,
+            RuntimeTaskState::kSucceeded);
+  EXPECT_EQ(after_restart.tasks[0].generation, 2u);
+  ASSERT_TRUE(after_restart.tasks[0].result);
+  EXPECT_EQ(after_restart.tasks[0].result->text, "persisted verified result");
+  EXPECT_EQ(std::ranges::count_if(after_restart.events,
+                                  [&task_id](const RuntimeEventRecord& event) {
+                                    return event.task_id == task_id;
+                                  }),
+            3);
+}
+
