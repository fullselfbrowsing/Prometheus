 namespace prometheus {
 
+PrometheusAgentTabObservationLease::PrometheusAgentTabObservationLease() =
+    default;
+
+PrometheusAgentTabObservationLease::PrometheusAgentTabObservationLease(
+    base::WeakPtr<PrometheusAgentService> service,
+    uint64_t token)
+    : service_(std::move(service)), token_(token) {}
+
+PrometheusAgentTabObservationLease::PrometheusAgentTabObservationLease(
+    PrometheusAgentTabObservationLease&& other) noexcept = default;
+
+PrometheusAgentTabObservationLease&
+PrometheusAgentTabObservationLease::operator=(
+    PrometheusAgentTabObservationLease&& other) noexcept {
+  if (this != &other) {
+    Reset();
+    service_ = std::move(other.service_);
+    token_ = std::exchange(other.token_, 0);
+  }
+  return *this;
+}
+
+PrometheusAgentTabObservationLease::~PrometheusAgentTabObservationLease() {
+  Reset();
+}
+
+PrometheusAgentTabData* PrometheusAgentTabObservationLease::data() const {
+  return service_ && token_ ? service_->GetObservedTabData(token_) : nullptr;
+}
+
+void PrometheusAgentTabObservationLease::Reset() {
+  if (service_ && token_) {
+    service_->ReleaseTabObservation(token_);
+  }
+  service_.reset();
+  token_ = 0;
+}
