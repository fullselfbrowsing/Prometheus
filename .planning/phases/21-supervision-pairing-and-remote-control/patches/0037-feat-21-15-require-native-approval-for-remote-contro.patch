+TEST_F(PrometheusSupervisionProfileServiceTest,
+       EnableControlCreatesLeaseOnlyAfterFreshNativeApproval) {
+  PrometheusAgentTabObservationLease owner_lease =
+      agent_service_->ObserveOrCreateTabData(&tab_, &observer_tab_data_);
+  ASSERT_NE(nullptr, owner_lease.data());
+  ASSERT_TRUE(owner_lease.data()->ClaimIfUnowned("owner-a", "Agent A").ok);
+  SupervisionPairingCreationResult creation = CreatePairing();
+  ASSERT_TRUE(creation.ok);
+  SupervisionRedemptionResult viewer = Redeem(creation, "Review console");
+  ASSERT_TRUE(viewer.ok);
+  hold_dialog_callbacks_ = true;
+
+  ASSERT_TRUE(service_->EnableControl(viewer.dashboard_session).ok);
+  EXPECT_EQ(0u, service_->controller_count_for_testing());
+  ASSERT_EQ(1u, pending_dialog_callbacks_.size());
+  ASSERT_EQ(1u, dialog_models_.size());
+  EXPECT_EQ(PrometheusSupervisionDialogKind::kEnableControl,
+            dialog_models_.back().kind);
+  EXPECT_EQ("Review console", dialog_models_.back().client_label);
+  EXPECT_EQ("Release notes", dialog_models_.back().target_tab_title);
+  EXPECT_EQ("https://example.test", dialog_models_.back().site_origin);
+  EXPECT_FALSE(dialog_models_.back().expires_label.empty());
+  EXPECT_EQ(std::string::npos,
+            dialog_models_.back().site_origin.find("private"));
+  EXPECT_EQ(std::string::npos,
+            dialog_models_.back().site_origin.find("secret"));
+
+  ReplyToNextDialog(PrometheusSupervisionDialogResult::kApproved);
+  EXPECT_EQ(1u, service_->controller_count_for_testing());
+  EXPECT_TRUE(service_->StopControl(viewer.dashboard_session).ok);
+}
