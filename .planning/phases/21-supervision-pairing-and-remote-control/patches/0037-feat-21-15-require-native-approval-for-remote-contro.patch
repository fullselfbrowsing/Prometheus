+bool IsSafeDisplayText(std::string_view value, size_t maximum_bytes) {
+  if (value.empty() || value.size() > maximum_bytes ||
+      !base::IsStringUTF8(value)) {
+    return false;
+  }
+  return std::ranges::none_of(value, [](unsigned char character) {
+    return character < 0x20 || character == 0x7f;
+  });
+}
+
+bool IsClosedActionLabel(std::string_view label) {
+  static constexpr std::string_view kLabels[] = {
+      "Click",  "Type",   "Key press", "Scroll", "Hover",
+      "Select", "Clear",  "Drag",      "Drop",   "Navigate",
+  };
+  return std::ranges::find(kLabels, label) != std::end(kLabels);
+}
+
+bool IsValidSupervisionDialogModel(
+    const PrometheusSupervisionDialogModel& model) {
+  if (!IsSafeDisplayText(model.client_label, 128u) ||
+      !IsSafeDisplayText(model.target_tab_title, 256u) ||
+      !IsSafeDisplayText(model.site_origin, 512u) ||
+      !IsSafeDisplayText(model.expires_label, 128u)) {
+    return false;
+  }
+  if (model.kind == PrometheusSupervisionDialogKind::kEnableControl) {
+    return model.action_label.empty() && model.permission_boundary.empty();
+  }
+  return IsClosedActionLabel(model.action_label) &&
+         model.permission_boundary == "Page actions";
+}
+
+class SupervisionConfirmationDialog final : public RuntimeDialogDelegate {
+ public:
+  SupervisionConfirmationDialog(
+      const PrometheusSupervisionDialogModel& model,
+      PrometheusSupervisionDialogCallback callback)
+      : RuntimeDialogDelegate(
+            model.kind == PrometheusSupervisionDialogKind::kEnableControl
+                ? u"Enable control"
+                : u"Allow once",
+            model.kind == PrometheusSupervisionDialogKind::kEnableControl
+                ? u"Keep view only"
+                : u"Block action",
+            ui::mojom::DialogButton::kCancel),
+        model_(model),
+        callback_(std::move(callback)) {
+    CHECK(callback_);
+    const bool enabling =
+        model_.kind == PrometheusSupervisionDialogKind::kEnableControl;
+    if (enabling) {
+      AddMultilineLabel(
+          contents(), base::UTF8ToUTF16(
+                          model_.client_label + " can act in " +
+                          model_.target_tab_title + " until " +
+                          model_.expires_label +
+                          ". Prometheus will still enforce tab ownership, "
+                          "permissions, target validation, and confirmations."));
+    } else {
+      AddMultilineLabel(
+          contents(), base::UTF8ToUTF16(
+                          model_.client_label + " wants to " +
+                          model_.action_label + " in " +
+                          model_.target_tab_title +
+                          ". Prometheus will recheck ownership, permissions, "
+                          "and the current page before acting."));
+    }
+    AddRow("Client", model_.client_label);
+    AddRow("Target tab", model_.target_tab_title);
+    AddRow("Site origin", model_.site_origin);
+    if (enabling) {
+      AddRow("Access", "Page actions");
+      AddRow("Expires", model_.expires_label);
+      AddRow("Vault", "Confirmation required");
+    } else {
+      AddRow("Action", model_.action_label);
+      AddRow("Controller expires", model_.expires_label);
+      AddRow("Permission boundary", model_.permission_boundary);
+    }
+    SetCloseCallback(
+        base::BindOnce(&SupervisionConfirmationDialog::Reply,
+                       base::Unretained(this),
+                       PrometheusSupervisionDialogResult::kDenied));
+  }
+
+  SupervisionConfirmationDialog(const SupervisionConfirmationDialog&) =
+      delete;
+  SupervisionConfirmationDialog& operator=(
+      const SupervisionConfirmationDialog&) = delete;
+  ~SupervisionConfirmationDialog() override = default;
+
+  std::u16string GetWindowTitle() const override {
+    return model_.kind == PrometheusSupervisionDialogKind::kEnableControl
+               ? u"Enable remote control?"
+               : u"Confirm remote action";
+  }
+
+  views::View* GetInitiallyFocusedView() override { return GetCancelButton(); }
+
+  bool Accept() override {
+    Reply(PrometheusSupervisionDialogResult::kApproved);
+    return true;
+  }
+
+  bool Cancel() override {
+    Reply(PrometheusSupervisionDialogResult::kDenied);
+    return true;
+  }
+
+ private:
+  void AddRow(std::string_view label, std::string_view value) {
+    AddMultilineLabel(contents(), base::UTF8ToUTF16(label));
+    AddMultilineLabel(contents(), base::UTF8ToUTF16(value));
+  }
+
+  void Reply(PrometheusSupervisionDialogResult result) {
+    if (callback_) {
+      std::move(callback_).Run(result);
+    }
+  }
+
+  const PrometheusSupervisionDialogModel model_;
+  PrometheusSupervisionDialogCallback callback_;
+};
