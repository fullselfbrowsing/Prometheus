 namespace prometheus {
 
+inline constexpr size_t kMaxSidePanelSafeTargetTitleCharacters = 80;
+
+// Closed browser-owned activity vocabulary for the selected-tab supervision
+// strip. WebUI maps these values to copy and never receives free-form activity
+// text or remote action values.
+enum class PrometheusSidePanelSupervisionActivity {
+  kViewing,
+  kControlReady,
+  kValidatingRemoteAction,
+  kRemoteAction,
+  kConfirmationRequired,
+  kResyncing,
+  kPausedForResync,
+  kRemoteActionBlocked,
+  kStoppingControl,
+};
+
+enum class PrometheusSidePanelSupervisionActionCategory {
+  kClick,
+  kType,
+  kKeyPress,
+  kScroll,
+  kHover,
+  kSelect,
+  kClear,
+  kDrag,
+  kDrop,
+  kNavigate,
+};
+
+struct PrometheusSidePanelSupervisionSnapshot {
+  bool available = false;
+  size_t viewer_count = 0;
+  bool controlled = false;
+  std::optional<std::string> client_label;
+  PrometheusSidePanelSupervisionActivity activity =
+      PrometheusSidePanelSupervisionActivity::kViewing;
+  std::optional<PrometheusSidePanelSupervisionActionCategory> action_category;
+  bool resyncing = false;
+  bool stopping = false;
+  bool ending = false;
+  std::string safe_target_title = "this tab";
+};
+
+std::string SanitizeSidePanelSupervisionTargetTitle(
+    std::u16string_view title);
+base::DictValue SidePanelSupervisionSnapshotValue(
+    const PrometheusSidePanelSupervisionSnapshot& snapshot);
+
 // Browser-process-only authority used by one side-panel controller. Concrete
 // implementations retain the move-only runtime principal; this narrow UI-layer
 // interface deliberately has no identity getters or serialization methods.
@@ -43,6 +92,9 @@ class PrometheusSidePanelRuntime {
       std::string requested_execution,
       std::optional<std::string> provider_id) = 0;
   virtual base::DictValue CancelTask(std::string task_id) = 0;
+  virtual base::DictValue StopSupervisionControl();
+  virtual base::DictValue EndSelectedTabSupervision();
+  virtual base::DictValue OpenSupervisionManagement();
   virtual void HandleTargetLost() = 0;
 };
 
