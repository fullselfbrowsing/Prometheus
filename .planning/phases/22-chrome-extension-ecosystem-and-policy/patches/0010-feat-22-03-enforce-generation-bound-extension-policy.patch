+base::DictValue PrometheusControlPanelUI::BuildExtensionPolicySnapshot() const {
+  base::DictValue value;
+  value.Set("install_path", "web_store_unverified");
+  if (!extension_policy_service_) {
+    value.Set("state", "unavailable");
+    value.Set("subsystem_status", "unavailable");
+    value.Set("generation", 0.0);
+    value.Set("installed_count", 0);
+    value.Set("agent_enabled_count", 0);
+    value.Set("rows", base::ListValue());
+  } else {
+    const prometheus::ExtensionPolicyHealth health =
+        extension_policy_service_->GetHealth();
+    const prometheus::ExtensionPolicySnapshot snapshot =
+        extension_policy_service_->GetSnapshot();
+    const std::string_view status =
+        prometheus::ExtensionPolicyHealthStatusToString(health.status);
+    value.Set("state", status);
+    value.Set("subsystem_status", status);
+    value.Set("generation", static_cast<double>(snapshot.generation));
+    if (std::optional<base::DictValue> health_value =
+            prometheus::ExtensionPolicyHealthToValue(health)) {
+      value.Set("health", std::move(*health_value));
+    }
+    base::ListValue rows;
+    size_t agent_enabled_count = 0;
+    for (const prometheus::ExtensionPolicyRow& row : snapshot.rows) {
+      if (row.effective_regular !=
+              prometheus::ExtensionAgentGrant::kBlocked ||
+          row.effective_private !=
+              prometheus::ExtensionAgentGrant::kBlocked) {
+        ++agent_enabled_count;
+      }
+      if (std::optional<base::DictValue> row_value =
+              prometheus::ExtensionPolicyRowToValue(row)) {
+        rows.Append(std::move(*row_value));
+      }
+    }
+    value.Set("installed_count", static_cast<int>(snapshot.rows.size()));
+    value.Set("agent_enabled_count",
+              static_cast<int>(agent_enabled_count));
+    value.Set("rows", std::move(rows));
+  }
+
+  static constexpr std::string_view kCompatibilityCategories[] = {
+      "Password manager",
+      "Ad blocker",
+      "Productivity content script",
+      "Side panel and tooling",
+      "Developer extension",
+  };
+  base::ListValue compatibility;
+  for (std::string_view category : kCompatibilityCategories) {
+    base::DictValue row;
+    row.Set("category", category);
+    row.Set("status", "unsupported");
+    row.Set("fixture", "No verified fixture");
+    row.Set("manifest", "Manifest unknown");
+    row.Set("source", "Not verified");
+    row.Set("behaviors", "No representative behaviors verified");
+    row.Set("revision", "Current Chromium and Prometheus revision");
+    row.Set("last_verified", "Not verified");
+    row.Set("limitation",
+            "Representative compatibility evidence has not run in this "
+            "build.");
+    compatibility.Append(std::move(row));
+  }
+  value.Set("compatibility", std::move(compatibility));
+  return value;
+}
