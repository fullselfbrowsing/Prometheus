+TEST(PrometheusExtensionSurfaceResolverTest, RejectsDisabledExtension) {
+  auto evidence = VisibleTabEvidence();
+  evidence.extension_enabled = false;
+  ExpectDenied(evidence,
+               PrometheusExtensionSurfaceDenial::kExtensionUnavailable,
+               AgentErrorCode::kStaleTarget);
+}
