+TEST(PrometheusSupervisionTransportCodecTest,
+     DashboardSerializationCarriesOnlyDedicatedWireAuthority) {
+  SupervisionTransportResult result =
+      MakeDashboardResult(SupervisionTransportOperation::kDiff);
+  auto first = SerializeSupervisionDashboardResult(result);
+  auto second = SerializeSupervisionDashboardResult(result);
+  ASSERT_TRUE(first.has_value()) << first.error().message;
+  ASSERT_TRUE(second.has_value()) << second.error().message;
+  EXPECT_EQ(*first, *second);
+
+  auto root = base::JSONReader::ReadDict(*first, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(root);
+  EXPECT_EQ(root->FindBool("ok"), true);
+  ASSERT_TRUE(root->FindString("operation"));
+  EXPECT_EQ("diff", *root->FindString("operation"));
+  const base::DictValue* payload = root->FindDict("result");
+  ASSERT_TRUE(payload);
+  EXPECT_EQ(kDashboardSession, *payload->FindString("dashboard_session"));
+  EXPECT_EQ(kDocumentEpoch, *payload->FindString("document_epoch"));
+  ASSERT_TRUE(payload->FindDouble("sequence"));
+  EXPECT_EQ(7, *payload->FindDouble("sequence"));
+  EXPECT_TRUE(payload->FindDict("snapshot"));
+}
