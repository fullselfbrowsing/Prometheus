+namespace prometheus {
+
+struct PrometheusProviderTransport::Operation {};
+
+PrometheusProviderTransport::PrometheusProviderTransport(
+    PrometheusProviderRegistry* registry,
+    PrometheusSecretStore* secret_store,
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory,
+    ProviderTransportLimits limits,
+    const base::TickClock* tick_clock)
+    : registry_(registry),
+      secret_store_(secret_store),
+      url_loader_factory_(std::move(url_loader_factory)),
+      limits_(limits),
+      tick_clock_(tick_clock ? tick_clock
+                             : base::DefaultTickClock::GetInstance()) {}
+
+PrometheusProviderTransport::~PrometheusProviderTransport() = default;
+
+PrometheusProviderTransport::OperationId
+PrometheusProviderTransport::ExecuteTurn(std::string provider_id,
+                                         ProviderTurnRequest request,
+                                         TurnCallback callback) {
+  const OperationId operation_id = next_operation_id_++;
+  std::move(callback).Run({.failure = ProviderFailureKind::kInvalidOutput});
+  return operation_id;
+}
+
+PrometheusProviderTransport::OperationId
+PrometheusProviderTransport::DiscoverModels(std::string provider_id,
+                                            ModelsCallback callback) {
+  const OperationId operation_id = next_operation_id_++;
+  std::move(callback).Run({.state = ProviderModelListState::kInvalidOutput});
+  return operation_id;
+}
+
+bool PrometheusProviderTransport::Cancel(OperationId operation_id) {
+  return false;
+}
