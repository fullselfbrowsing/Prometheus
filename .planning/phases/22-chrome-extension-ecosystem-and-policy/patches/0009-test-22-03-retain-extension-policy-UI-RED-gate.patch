+    PrometheusWebUIExtensionPolicyBrowserTest,
+    ResponsiveKeyboardPrivacyContrastAndFailureRecoveryContract) {
+  ASSERT_TRUE(ExtensionPolicyWebUIImplementedForTesting());
+  content::WebContents* const contents =
+      NavigateTo(chrome::kChromeUIPrometheusControlPanelURL);
+  ASSERT_TRUE(contents);
+  ASSERT_TRUE(content::WaitForLoadStop(contents));
+  ASSERT_TRUE(content::ExecJs(contents, R"(
+    document.querySelector(
+        '[data-section-target="permissions"]')?.click();
+    window.prometheusControlReceiveSnapshot({
+      status: 'OK',
+      tasks: [],
+      providers: [],
+      memories: [],
+      site_guides: [],
+      guide_applications: [],
+      vault_entries: [],
+      events: [],
+      actions: [],
+      diagnostics: [],
+      permissions: {},
+      extension_policy: {
+        state: 'ready',
+        generation: 41,
+        subsystem_status: 'ready',
+        install_path: 'developer_mode',
+        rows: [{
+          name: 'A long but bounded extension name used for wrapping evidence',
+          id_suffix: 'mnopab',
+          source: 'unpacked',
+          enabled: true,
+          manifest_version: 3,
+          private_eligible: true,
+          requested_regular: 'interact',
+          requested_private: 'read_only',
+          effective_regular: 'interact',
+          effective_private: 'read_only',
+          ordinal: 0,
+          generation: 41,
+          extension_id: 'FULL_EXTENSION_ID_SENTINEL',
+          permissions: ['PERMISSION_SENTINEL'],
+          origin: 'ORIGIN_SENTINEL',
+          profile_path: 'PROFILE_PATH_SENTINEL',
+          authority: 'AUTHORITY_SENTINEL',
+          content: 'CONTENT_SENTINEL',
+        }],
+      },
+    });
+    window.prometheusExtensionPolicyResponsiveIssuesForTesting = () => {
+      const policy = document.querySelector('#control-extension-policy');
+      const layout =
+          document.querySelector('#control-extension-policy-layout');
+      const choices = Array.from(policy.querySelectorAll(
+          '.control-extension-grant-choice'));
+      const controls = Array.from(policy.querySelectorAll(
+          'button, [role="option"], .control-extension-grant-choice'));
+      const fontSizes = new Set(Array.from(policy.querySelectorAll('*'))
+          .map(node => getComputedStyle(node).fontSize)
+          .filter(size => size !== '0px'));
+      const columns =
+          getComputedStyle(layout).gridTemplateColumns.split(' ').length;
+      const expectedColumns = window.innerWidth >= 1024 ? 2 : 1;
+      const issues = [];
+      if (document.documentElement.scrollWidth >
+          document.documentElement.clientWidth) {
+        issues.push('overflow');
+      }
+      if (columns !== expectedColumns) {
+        issues.push('columns');
+      }
+      if (controls.some(control =>
+          control.getBoundingClientRect().height < 48)) {
+        issues.push('target');
+      }
+      if (window.innerWidth <= 479 &&
+          getComputedStyle(policy).padding !== '16px') {
+        issues.push('padding');
+      }
+      if (choices.some(choice => choice.getBoundingClientRect().width >
+          policy.getBoundingClientRect().width + 0.5)) {
+        issues.push('choice-width');
+      }
+      if ([...fontSizes].some(size =>
+          !['12px', '13px', '16px', '20px'].includes(size))) {
+        issues.push('type');
+      }
+      return issues.join('|');
+    };
+  )"));
+
+  const std::string serialized = content::EvalJs(contents, R"(
+    JSON.stringify({
+      policy: window.prometheusControlSnapshotForTesting?.extension_policy,
+      dom: document.querySelector('#control-extension-policy')?.outerHTML,
+    });
+  )")
+                                     .ExtractString();
+  for (const std::string& sentinel : std::vector<std::string>{
