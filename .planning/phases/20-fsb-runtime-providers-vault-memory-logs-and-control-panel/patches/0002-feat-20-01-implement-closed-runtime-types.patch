-  return false;
+bool IsTerminalRuntimeTaskState(RuntimeTaskState state) {
+  return state == RuntimeTaskState::kSucceeded ||
+         state == RuntimeTaskState::kFailed ||
+         state == RuntimeTaskState::kCancelled;
 }
 
