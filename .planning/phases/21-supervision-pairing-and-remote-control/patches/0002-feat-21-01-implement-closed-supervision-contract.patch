+uint64_t ClampLimit(uint64_t value,
+                    uint64_t default_value,
+                    uint64_t hard_limit) {
+  return value == 0 ? default_value : std::min(value, hard_limit);
+}
+
+bool IsBoundedUtf8(std::string_view value, size_t max_bytes) {
+  return value.size() <= max_bytes && base::IsStringUTF8(value);
+}
+
+bool HasDisallowedControl(std::string_view value) {
+  for (unsigned char character : value) {
+    if ((character < 0x20 && !base::IsAsciiWhitespace(character)) ||
+        character == 0x7f) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool ContainsAsciiWord(std::string_view value, std::string_view word) {
+  size_t position = value.find(word);
+  while (position != std::string_view::npos) {
+    const bool starts_word =
+        position == 0 || !base::IsAsciiAlphaNumeric(value[position - 1]);
+    const size_t end = position + word.size();
+    const bool ends_word =
+        end == value.size() || !base::IsAsciiAlphaNumeric(value[end]);
+    if (starts_word && ends_word) {
+      return true;
+    }
+    position = value.find(word, position + 1);
+  }
+  return false;
+}
+
+std::string CollapseWhitespace(std::string_view input) {
+  std::string collapsed;
+  collapsed.reserve(input.size());
+  bool pending_space = false;
+  for (char character : input) {
+    if (base::IsAsciiWhitespace(character)) {
+      pending_space = true;
+      continue;
+    }
+    if (pending_space && !collapsed.empty()) {
+      collapsed.push_back(' ');
+    }
+    pending_space = false;
+    collapsed.push_back(character);
+  }
+  return collapsed;
+}
+
+std::string DeriveSafeDisplayString(std::string_view input,
+                                    size_t max_bytes,
+                                    std::string_view fallback) {
+  if (!base::IsStringUTF8(input) || HasDisallowedControl(input)) {
+    return std::string(fallback);
+  }
+
+  std::string value = CollapseWhitespace(input);
+  const std::string lowercase = base::ToLowerASCII(value);
+  for (std::string_view marker : kSensitiveDisplayMarkers) {
+    if (lowercase.find(marker) != std::string::npos) {
+      return std::string(fallback);
+    }
+  }
+  if (ContainsAsciiWord(lowercase, "lease")) {
+    return std::string(fallback);
+  }
+  if (value.empty()) {
+    return std::string(fallback);
+  }
+  return std::string(base::TruncateUTF8ToByteSize(value, max_bytes));
+}
+
+bool IsSafeTimestamp(int64_t timestamp_ms) {
+  constexpr int64_t kMaximumExactJsonInteger = (int64_t{1} << 53) - 1;
+  return timestamp_ms >= 0 && timestamp_ms <= kMaximumExactJsonInteger;
+}
