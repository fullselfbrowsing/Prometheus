+void PrometheusAgentProfileService::ExecuteConfirmedVaultInsertion(
+    BrowserWindowInterface* exact_browser,
+    ConfirmedVaultInsertionRequest request,
+    PrometheusAgentService::ConfirmedVaultCallback callback) {
+  SweepExpiredSessions();
+  if (!exact_browser || exact_browser->GetProfile() != profile_ ||
+      request.binding.profile != profile_ ||
+      request.binding.browser != exact_browser) {
+    ConfirmedVaultInsertionResult result;
+    result.status = ConfirmedVaultInsertionStatus::kProfileMismatch;
+    std::move(callback).Run(result);
+    return;
+  }
+  agent_service_.ExecuteConfirmedVaultInsertion(
+      exact_browser, std::move(request), std::move(callback));
+}
