+
+struct SupervisionServiceResult {
+  bool ok = false;
+  SupervisionErrorCode error_code = SupervisionErrorCode::kNone;
+  std::string message;
+  std::string recovery;
+
+  static SupervisionServiceResult Success();
+  static SupervisionServiceResult Failure(SupervisionErrorCode error_code,
+                                          std::string message,
+                                          std::string recovery);
+};
+
+struct SupervisionPairingCreationResult : SupervisionServiceResult {
+  // One-shot local UI response only. The service retains a salted digest.
+  std::string pairing_code;
+  int32_t stable_tab_id = 0;
+  base::Time expires_at;
+};
+
+struct SupervisionRedemptionResult : SupervisionServiceResult {
+  // Browser-only authority. Only the authenticated dashboard serializer may
+  // later turn this into an opaque wire value.
+  base::UnguessableToken dashboard_session;
+  int32_t stable_tab_id = 0;
+  base::Time expires_at;
+};
+
+// In-memory, regular-profile authority for pairing and viewer/controller
+// lifecycles. It can observe tab ownership only through the narrow Agent-owned
+// move-only lease callback supplied by composition.
+class PrometheusSupervisionProfileService final : public KeyedService {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnPrometheusSupervisionSnapshotChanged(
+        int32_t stable_tab_id,
+        const SanitizedSupervisionSnapshot& snapshot) = 0;
+  };
+
+  using ObserveTabDataCallback =
+      base::RepeatingCallback<PrometheusAgentTabObservationLease(
+          tabs::TabInterface*,
+          PrometheusAgentTabData::Observer*)>;
+  using NowCallback = base::RepeatingCallback<base::Time()>;
+  using PairingCodeGenerator = base::RepeatingCallback<std::string()>;
+
+  PrometheusSupervisionProfileService(Profile* profile,
+                                      SupervisionProfileKind profile_kind,
+                                      ObserveTabDataCallback observe_tab_data);
+  PrometheusSupervisionProfileService(
+      Profile* profile,
+      SupervisionProfileKind profile_kind,
+      ObserveTabDataCallback observe_tab_data,
+      NowCallback now_callback,
+      PairingCodeGenerator pairing_code_generator,
+      SupervisionLimits limits = SupervisionLimits());
+  PrometheusSupervisionProfileService(
+      const PrometheusSupervisionProfileService&) = delete;
+  PrometheusSupervisionProfileService& operator=(
+      const PrometheusSupervisionProfileService&) = delete;
+  ~PrometheusSupervisionProfileService() override;
+
+  SupervisionPairingCreationResult CreatePairing(
+      BrowserWindowInterface* exact_browser,
+      tabs::TabInterface* exact_tab);
+  SupervisionServiceResult CancelPairing(int32_t stable_tab_id);
+  SupervisionRedemptionResult RedeemPairing(std::string_view pairing_code,
+                                            std::string_view client_label);
+  SupervisionServiceResult EnableControl(
+      const base::UnguessableToken& dashboard_session);
+  SupervisionServiceResult StopControl(
+      const base::UnguessableToken& dashboard_session);
+  SupervisionServiceResult RevokeSession(
+      const base::UnguessableToken& dashboard_session);
+  SupervisionServiceResult EndSession(
+      const base::UnguessableToken& dashboard_session);
+  void HandleTargetLost(int32_t stable_tab_id);
+
+  SanitizedSupervisionSnapshot GetSanitizedSnapshot(int32_t stable_tab_id);
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  void Shutdown() override;
+
+  size_t pending_pairing_count_for_testing() const;
+  size_t viewer_count_for_testing(int32_t stable_tab_id) const;
+  size_t observed_tab_count_for_testing() const;
+  size_t controller_count_for_testing() const;
+  size_t audit_count_for_testing() const;
+  size_t global_failed_attempt_count_for_testing() const;
+  std::optional<std::string> immutable_owner_for_testing(
+      const base::UnguessableToken& dashboard_session) const;
+  uint64_t authority_generation_for_testing(
+      const base::UnguessableToken& dashboard_session) const;
+
+ private:
+  class TabOwnerObserver;
+  struct PendingPairing;
+  struct ViewerSession;
+  struct ObservedTab;
+  struct RecentTerminalSession;
+
+  base::Time Now() const;
+  std::string GeneratePairingCode() const;
+  void SweepExpired();
+  void SweepExpiredPairings(base::Time now);
+  void SweepExpiredViewers(base::Time now);
+  void SweepFailedAttempts(base::Time now);
+  PendingPairing* FindPendingPairing(std::string_view normalized_code);
+  tabs::TabInterface* ResolveExactTarget(const PendingPairing& pairing) const;
+  tabs::TabInterface* ResolveExactTarget(const ViewerSession& viewer) const;
+  ObservedTab* AcquireObservedTab(tabs::TabInterface* tab);
+  void ReleaseObservedTabIfUnused(int32_t stable_tab_id);
+  void ScheduleObservedTabRelease(int32_t stable_tab_id);
+  void OnObservedOwnerChanged(int32_t stable_tab_id,
+                              std::string_view old_owner_session_id,
+                              std::string_view new_owner_session_id);
+  void OnObservedTabDataDestroying(int32_t stable_tab_id);
+  void TerminateViewer(const base::UnguessableToken& dashboard_session,
+                       SupervisionViewerState viewer_state,
+                       SupervisionTerminalReason reason,
+                       SupervisionAuditEvent audit_event,
+                       SupervisionErrorCode error_code);
+  void TerminateViewersForTab(int32_t stable_tab_id,
+                              SupervisionViewerState viewer_state,
+                              SupervisionTerminalReason reason,
+                              SupervisionAuditEvent audit_event,
+                              SupervisionErrorCode error_code);
+  bool RevalidateViewerOwner(const base::UnguessableToken& dashboard_session);
+  void AddAudit(int32_t stable_tab_id,
+                SupervisionAuditEvent event,
+                std::optional<std::string> client_label,
+                SupervisionErrorCode error_code = SupervisionErrorCode::kNone);
+  void NotifySnapshotChanged(int32_t stable_tab_id);
+  SanitizedSupervisionSnapshot BuildSanitizedSnapshot(
+      int32_t stable_tab_id) const;
+  SupervisionServiceResult UnavailableResult() const;
+  SupervisionServiceResult UnknownSessionResult() const;
+
+  raw_ptr<Profile> profile_ = nullptr;
+  const SupervisionProfileKind profile_kind_;
+  ObserveTabDataCallback observe_tab_data_;
+  NowCallback now_callback_;
+  PairingCodeGenerator pairing_code_generator_;
+  const SupervisionLimits limits_;
+  bool shutdown_ = false;
+  uint64_t next_pairing_serial_ = 0;
+  std::map<int32_t, std::unique_ptr<PendingPairing>> pending_pairings_;
+  std::map<base::UnguessableToken, std::unique_ptr<ViewerSession>> viewers_;
+  std::map<int32_t, std::unique_ptr<ObservedTab>> observed_tabs_;
+  std::map<int32_t, base::UnguessableToken> controllers_;
+  std::deque<RecentTerminalSession> recent_terminal_sessions_;
+  std::deque<base::Time> failed_attempts_;
+  std::deque<std::pair<int32_t, SupervisionAuditSnapshot>> audit_;
+  std::map<int32_t, SupervisionPairingState> last_pairing_states_;
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<PrometheusSupervisionProfileService> weak_factory_{this};
+};
+
+}  // namespace prometheus
+
+#endif  // CHROME_BROWSER_PROMETHEUS_PROMETHEUS_SUPERVISION_PROFILE_SERVICE_H_
