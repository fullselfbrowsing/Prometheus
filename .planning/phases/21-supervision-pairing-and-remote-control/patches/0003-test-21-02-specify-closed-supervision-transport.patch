diff --git a/chrome/browser/prometheus/prometheus_supervision_transport_codec.cc b/chrome/browser/prometheus/prometheus_supervision_transport_codec.cc
new file mode 100644
index 0000000000..c7a923fc7a
--- /dev/null
+++ b/chrome/browser/prometheus/prometheus_supervision_transport_codec.cc
@@ -0,0 +1,86 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_supervision_transport_codec.h"
+
+#include <utility>
+
+namespace prometheus {
+
+SupervisionTransportResult SupervisionTransportResult::Success(
+    SupervisionTransportOperation operation) {
+  SupervisionTransportResult result;
+  result.operation = operation;
+  result.ok = true;
+  return result;
+}
+
+SupervisionTransportResult SupervisionTransportResult::TransportFailure(
+    SupervisionTransportOperation operation,
+    SupervisionTransportErrorCode error_code,
+    std::string message,
+    std::string recovery) {
+  SupervisionTransportResult result;
+  result.operation = operation;
+  result.transport_error = error_code;
+  result.message = std::move(message);
+  result.recovery = std::move(recovery);
+  return result;
+}
+
+SupervisionTransportResult SupervisionTransportResult::SupervisionFailure(
+    SupervisionTransportOperation operation,
+    SupervisionErrorCode error_code,
+    std::string message,
+    std::string recovery) {
+  SupervisionTransportResult result;
+  result.operation = operation;
+  result.supervision_error = error_code;
+  result.message = std::move(message);
+  result.recovery = std::move(recovery);
+  return result;
+}
+
+std::optional<SupervisionTransportOperation>
+SupervisionTransportOperationFromString(std::string_view value) {
+  return std::nullopt;
+}
+
+std::optional<std::string_view> SupervisionTransportOperationToString(
+    SupervisionTransportOperation operation) {
+  return std::nullopt;
+}
+
+std::optional<std::string_view> SupervisionTransportErrorCodeToString(
+    SupervisionTransportErrorCode error_code) {
+  return std::nullopt;
+}
+
+base::expected<SupervisionTransportRequest, SupervisionTransportResult>
+ParseSupervisionTransportRequest(std::string_view json) {
+  return base::unexpected(SupervisionTransportResult::TransportFailure(
+      SupervisionTransportOperation::kRedeem,
+      SupervisionTransportErrorCode::kInvalidRequest,
+      "Supervision transport codec is not implemented",
+      "Use the closed dashboard request contract"));
+}
+
+base::expected<std::string, SupervisionTransportResult>
+SerializeSupervisionDashboardResult(const SupervisionTransportResult& result) {
+  return base::unexpected(SupervisionTransportResult::TransportFailure(
+      result.operation, SupervisionTransportErrorCode::kInternal,
+      "Supervision transport codec is not implemented",
+      "Retry after the native codec is available"));
+}
+
+base::expected<std::string, SupervisionTransportResult>
+SerializeSupervisionCompatibilityResult(
+    const SupervisionTransportResult& result) {
+  return base::unexpected(SupervisionTransportResult::TransportFailure(
+      result.operation, SupervisionTransportErrorCode::kInternal,
+      "Supervision transport codec is not implemented",
+      "Retry after the native codec is available"));
+}
+
+}  // namespace prometheus
diff --git a/chrome/browser/prometheus/prometheus_supervision_transport_codec.h b/chrome/browser/prometheus/prometheus_supervision_transport_codec.h
new file mode 100644
index 0000000000..76160ebe6b
--- /dev/null
+++ b/chrome/browser/prometheus/prometheus_supervision_transport_codec.h
@@ -0,0 +1,178 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PROMETHEUS_PROMETHEUS_SUPERVISION_TRANSPORT_CODEC_H_
+#define CHROME_BROWSER_PROMETHEUS_PROMETHEUS_SUPERVISION_TRANSPORT_CODEC_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <variant>
+
+#include "base/types/expected.h"
+#include "chrome/browser/prometheus/prometheus_supervision_types.h"
+
+namespace prometheus {
+
+inline constexpr size_t kSupervisionTransportOperationCount = 7;
+inline constexpr size_t kMaxSupervisionTransportInputBytes = 1'048'576;
+inline constexpr size_t kMaxSupervisionTransportOutputBytes = 2'097'152;
+inline constexpr size_t kMaxSupervisionTransportSessionBytes = 128;
+inline constexpr size_t kMaxSupervisionTransportEpochBytes = 128;
+inline constexpr size_t kMaxSupervisionTransportElementRefBytes = 4096;
+inline constexpr size_t kMaxSupervisionTransportTextBytes = 20'000;
+inline constexpr size_t kMaxSupervisionTransportKeyBytes = 128;
+inline constexpr size_t kMaxSupervisionTransportOptionBytes = 4096;
+inline constexpr size_t kMaxSupervisionTransportNavigationBytes = 4096;
+inline constexpr size_t kMaxSupervisionTransportMessageBytes = 512;
+inline constexpr uint64_t kMaxSupervisionTransportSequence =
+    (uint64_t{1} << 53) - 1;
+inline constexpr int32_t kMaxSupervisionTransportScrollDelta = 100'000;
+
+enum class SupervisionTransportOperation {
+  kRedeem,
+  kBaseline,
+  kDiff,
+  kAck,
+  kAction,
+  kHeartbeat,
+  kEnd,
+};
+
+enum class SupervisionTransportErrorCode {
+  kNone,
+  kInvalidOperation,
+  kInvalidRequest,
+  kRequestTooLarge,
+  kForbiddenField,
+  kOutputNotSanitized,
+  kUnavailable,
+  kInternal,
+};
+
+struct SupervisionRedeemParams {
+  std::string pairing_code;
+  std::string client_label;
+};
+
+struct SupervisionBaselineParams {
+  std::string dashboard_session;
+};
+
+struct SupervisionDiffParams {
+  std::string dashboard_session;
+  std::string document_epoch;
+  uint64_t after_sequence = 0;
+};
+
+struct SupervisionAckParams {
+  std::string dashboard_session;
+  std::string document_epoch;
+  uint64_t sequence = 0;
+};
+
+struct SupervisionRemoteActionRequest {
+  SupervisionRemoteActionCategory category =
+      SupervisionRemoteActionCategory::kClick;
+  std::optional<std::string> element_ref;
+  std::optional<std::string> target_element_ref;
+  std::optional<std::string> text;
+  std::optional<std::string> key;
+  std::optional<std::string> option;
+  std::optional<int32_t> scroll_delta_x;
+  std::optional<int32_t> scroll_delta_y;
+  std::optional<std::string> navigation;
+};
+
+struct SupervisionActionParams {
+  std::string dashboard_session;
+  std::string document_epoch;
+  uint64_t sequence = 0;
+  SupervisionRemoteActionRequest action;
+};
+
+struct SupervisionHeartbeatParams {
+  std::string dashboard_session;
+};
+
+struct SupervisionEndParams {
+  std::string dashboard_session;
+};
+
+using SupervisionTransportParams = std::variant<SupervisionRedeemParams,
+                                                SupervisionBaselineParams,
+                                                SupervisionDiffParams,
+                                                SupervisionAckParams,
+                                                SupervisionActionParams,
+                                                SupervisionHeartbeatParams,
+                                                SupervisionEndParams>;
+
+static_assert(std::variant_size_v<SupervisionTransportParams> ==
+              kSupervisionTransportOperationCount);
+
+struct SupervisionTransportRequest {
+  SupervisionTransportOperation operation =
+      SupervisionTransportOperation::kRedeem;
+  SupervisionTransportParams params = SupervisionRedeemParams();
+};
+
+// Dashboard-only wire authority. This DTO may cross only the authenticated
+// dashboard transport. Compatibility/WebUI serializers intentionally have no
+// code path that projects it.
+struct SupervisionDashboardWireAuthority {
+  std::string dashboard_session;
+  std::optional<std::string> document_epoch;
+  std::optional<uint64_t> sequence;
+};
+
+struct SupervisionTransportResult {
+  SupervisionTransportOperation operation =
+      SupervisionTransportOperation::kRedeem;
+  bool ok = false;
+  SupervisionTransportErrorCode transport_error =
+      SupervisionTransportErrorCode::kNone;
+  SupervisionErrorCode supervision_error = SupervisionErrorCode::kNone;
+  std::string message;
+  std::string recovery;
+  std::optional<SupervisionDashboardWireAuthority> dashboard_authority;
+  std::optional<SanitizedSupervisionSnapshot> sanitized_snapshot;
+  std::optional<bool> no_change;
+  std::optional<bool> requires_baseline;
+  std::optional<bool> ended;
+
+  static SupervisionTransportResult Success(
+      SupervisionTransportOperation operation);
+  static SupervisionTransportResult TransportFailure(
+      SupervisionTransportOperation operation,
+      SupervisionTransportErrorCode error_code,
+      std::string message,
+      std::string recovery);
+  static SupervisionTransportResult SupervisionFailure(
+      SupervisionTransportOperation operation,
+      SupervisionErrorCode error_code,
+      std::string message,
+      std::string recovery);
+};
+
+std::optional<SupervisionTransportOperation>
+SupervisionTransportOperationFromString(std::string_view value);
+std::optional<std::string_view> SupervisionTransportOperationToString(
+    SupervisionTransportOperation operation);
+std::optional<std::string_view> SupervisionTransportErrorCodeToString(
+    SupervisionTransportErrorCode error_code);
+
+base::expected<SupervisionTransportRequest, SupervisionTransportResult>
+ParseSupervisionTransportRequest(std::string_view json);
+
+base::expected<std::string, SupervisionTransportResult>
+SerializeSupervisionDashboardResult(const SupervisionTransportResult& result);
+
+base::expected<std::string, SupervisionTransportResult>
+SerializeSupervisionCompatibilityResult(
+    const SupervisionTransportResult& result);
+
+}  // namespace prometheus
+
+#endif  // CHROME_BROWSER_PROMETHEUS_PROMETHEUS_SUPERVISION_TRANSPORT_CODEC_H_
diff --git a/chrome/browser/prometheus/prometheus_supervision_transport_codec_unittest.cc b/chrome/browser/prometheus/prometheus_supervision_transport_codec_unittest.cc
new file mode 100644
index 0000000000..0ce46fbb5b
--- /dev/null
+++ b/chrome/browser/prometheus/prometheus_supervision_transport_codec_unittest.cc
@@ -0,0 +1,470 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_supervision_transport_codec.h"
+
+#include <array>
+#include <set>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/values.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace prometheus {
+namespace {
+
+constexpr std::string_view kDashboardSession = "DASHBOARD-SESSION-7";
+constexpr std::string_view kDocumentEpoch = "DOCUMENT-EPOCH-9";
+
+struct SupervisionSchemaCase {
+  std::string_view operation;
+  std::string_view params;
+};
+
+constexpr std::array<SupervisionSchemaCase, 7> kSchemaCases = {{
+    {"redeem",
+     R"({"pairing_code":"ab cd-efgh","client_label":"Dashboard one"})"},
+    {"baseline", R"({"dashboard_session":"DASHBOARD-SESSION-7"})"},
+    {"diff",
+     R"({"dashboard_session":"DASHBOARD-SESSION-7","document_epoch":"DOCUMENT-EPOCH-9","after_sequence":7})"},
+    {"ack",
+     R"({"dashboard_session":"DASHBOARD-SESSION-7","document_epoch":"DOCUMENT-EPOCH-9","sequence":7})"},
+    {"action",
+     R"({"dashboard_session":"DASHBOARD-SESSION-7","document_epoch":"DOCUMENT-EPOCH-9","sequence":7,"action":{"category":"click","ref":"document:7/node:11"}})"},
+    {"heartbeat", R"({"dashboard_session":"DASHBOARD-SESSION-7"})"},
+    {"end", R"({"dashboard_session":"DASHBOARD-SESSION-7"})"},
+}};
+
+std::string RequestJson(std::string_view operation, std::string_view params) {
+  return "{\"operation\":\"" + std::string(operation) +
+         "\",\"params\":" + std::string(params) + "}";
+}
+
+SupervisionTransportResult ParseError(std::string_view json) {
+  auto parsed = ParseSupervisionTransportRequest(json);
+  EXPECT_FALSE(parsed.has_value());
+  return parsed.has_value()
+             ? SupervisionTransportResult::TransportFailure(
+                   SupervisionTransportOperation::kRedeem,
+                   SupervisionTransportErrorCode::kInternal,
+                   "Expected parse failure", "Fix the test fixture")
+             : std::move(parsed.error());
+}
+
+SanitizedSupervisionSnapshot MakeSanitizedSnapshot() {
+  SanitizedSupervisionSnapshot snapshot;
+  snapshot.pairing_state = SupervisionPairingState::kRedeemed;
+  snapshot.target.safe_title = "Release notes";
+  snapshot.target.safe_origin = "https://example.test";
+  snapshot.target.owner_label = "Agent one";
+  snapshot.target.eligible = true;
+  snapshot.target.agent_active = true;
+  snapshot.target.viewer_count = 1;
+  snapshot.target.controller_label = "Dashboard one";
+
+  SupervisionSessionSnapshot session;
+  session.client.display_label = "Dashboard one";
+  session.client.connected_at_ms = 100;
+  session.client.last_seen_at_ms = 120;
+  session.client.expires_at_ms = 1000;
+  session.viewer_state = SupervisionViewerState::kViewOnly;
+  session.stream_state = SupervisionStreamState::kLive;
+  snapshot.sessions.push_back(std::move(session));
+  return snapshot;
+}
+
+SupervisionTransportResult MakeDashboardResult(
+    SupervisionTransportOperation operation) {
+  SupervisionTransportResult result =
+      SupervisionTransportResult::Success(operation);
+  result.dashboard_authority = SupervisionDashboardWireAuthority{
+      .dashboard_session = std::string(kDashboardSession),
+      .document_epoch = std::string(kDocumentEpoch),
+      .sequence = 7,
+  };
+  result.sanitized_snapshot = MakeSanitizedSnapshot();
+  if (operation == SupervisionTransportOperation::kDiff) {
+    result.no_change = false;
+    result.requires_baseline = false;
+  }
+  return result;
+}
+
+TEST(PrometheusSupervisionTransportCodecTest,
+     ManifestContainsExactlySevenClosedOperations) {
+  static_assert(kSchemaCases.size() == kSupervisionTransportOperationCount);
+  std::set<std::string_view> names;
+  std::set<SupervisionTransportOperation> operations;
+  for (const auto& fixture : kSchemaCases) {
+    SCOPED_TRACE(fixture.operation);
+    auto operation = SupervisionTransportOperationFromString(fixture.operation);
+    ASSERT_TRUE(operation.has_value());
+    EXPECT_EQ(fixture.operation,
+              SupervisionTransportOperationToString(*operation));
+    EXPECT_TRUE(names.insert(fixture.operation).second);
+    EXPECT_TRUE(operations.insert(*operation).second);
+  }
+  EXPECT_EQ(7u, names.size());
+  EXPECT_EQ(7u, operations.size());
+  EXPECT_FALSE(SupervisionTransportOperationFromString("snapshot"));
+  EXPECT_FALSE(SupervisionTransportOperationFromString("execute_route"));
+}
+
+TEST(PrometheusSupervisionTransportCodecTest,
+     ParsesEveryExactOperationIntoDistinctTypedParams) {
+  std::set<size_t> variants;
+  for (size_t index = 0; index < kSchemaCases.size(); ++index) {
+    const auto& fixture = kSchemaCases[index];
+    SCOPED_TRACE(fixture.operation);
+    auto parsed = ParseSupervisionTransportRequest(
+        RequestJson(fixture.operation, fixture.params));
+    ASSERT_TRUE(parsed.has_value()) << parsed.error().message;
+    EXPECT_EQ(index, parsed->params.index());
+    EXPECT_TRUE(variants.insert(parsed->params.index()).second);
+  }
+  EXPECT_EQ(7u, variants.size());
+}
+
+TEST(PrometheusSupervisionTransportCodecTest,
+     NormalizesOneCodeAndDerivesOneSafeClientLabel) {
+  auto parsed = ParseSupervisionTransportRequest(RequestJson(
+      "redeem",
+      R"({"pairing_code":"ab cd-efgh","client_label":"  Dashboard\tone  "})"));
+  ASSERT_TRUE(parsed.has_value()) << parsed.error().message;
+  const auto* params = std::get_if<SupervisionRedeemParams>(&parsed->params);
+  ASSERT_TRUE(params);
+  EXPECT_EQ("ABCDEFGH", params->pairing_code);
+  EXPECT_EQ("Dashboard one", params->client_label);
+
+  auto protected_label = ParseSupervisionTransportRequest(RequestJson(
+      "redeem",
+      R"({"pairing_code":"ABCDEFGH","client_label":"Bearer SESSION-AUTHORITY"})"));
+  ASSERT_TRUE(protected_label.has_value()) << protected_label.error().message;
+  EXPECT_EQ(
+      kSupervisionClientLabelFallback,
+      std::get<SupervisionRedeemParams>(protected_label->params).client_label);
+}
+
+TEST(PrometheusSupervisionTransportCodecTest,
+     RejectsUnknownTopLevelOperationAndActionKeys) {
+  EXPECT_EQ(
+      SupervisionTransportErrorCode::kInvalidRequest,
+      ParseError(
+          R"({"operation":"heartbeat","params":{"dashboard_session":"DASHBOARD-SESSION-7"},"extra":true})")
+          .transport_error);
+  EXPECT_EQ(
+      SupervisionTransportErrorCode::kInvalidRequest,
+      ParseError(
+          RequestJson(
+              "heartbeat",
+              R"({"dashboard_session":"DASHBOARD-SESSION-7","extra":true})"))
+          .transport_error);
+  EXPECT_EQ(
+      SupervisionTransportErrorCode::kInvalidRequest,
+      ParseError(
+          RequestJson(
+              "action",
+              R"({"dashboard_session":"DASHBOARD-SESSION-7","document_epoch":"DOCUMENT-EPOCH-9","sequence":7,"action":{"category":"click","ref":"node:1","extra":true}})"))
+          .transport_error);
+  EXPECT_EQ(
+      SupervisionTransportErrorCode::kInvalidOperation,
+      ParseError(RequestJson("eighth_operation", R"({})")).transport_error);
+}
+
+TEST(PrometheusSupervisionTransportCodecTest,
+     RejectsPrototypeStaleAndAuthorityInjectionAtEveryDepth) {
+  for (std::string_view field : {
+           "__proto__",
+           "constructor",
+           "prototype",
+           "profile_path",
+           "profile_id",
+           "browser_id",
+           "window_id",
+           "tab_id",
+           "tabId",
+           "tabIndex",
+           "tab_selector",
+           "owner",
+           "owner_session_id",
+           "controller",
+           "controller_lease",
+           "session_id",
+           "document_token",
+           "route",
+       }) {
+    SCOPED_TRACE(field);
+    const std::string params =
+        "{\"dashboard_session\":\"DASHBOARD-SESSION-7\",\"" +
+        std::string(field) + "\":\"injected\"}";
+    EXPECT_EQ(SupervisionTransportErrorCode::kForbiddenField,
+              ParseError(RequestJson("heartbeat", params)).transport_error);
+  }
+
+  for (std::string_view field :
+       {"script", "javascript", "execute_js", "vault", "secret", "bearer",
+        "authorization", "password", "token", "selector", "typed_value",
+        "page_content"}) {
+    SCOPED_TRACE(field);
+    const std::string action = "{\"category\":\"click\",\"ref\":\"node:1\",\"" +
+                               std::string(field) + "\":\"injected\"}";
+    const std::string params =
+        "{\"dashboard_session\":\"DASHBOARD-SESSION-7\","
+        "\"document_epoch\":\"DOCUMENT-EPOCH-9\",\"sequence\":7,"
+        "\"action\":" +
+        action + "}";
+    EXPECT_EQ(SupervisionTransportErrorCode::kForbiddenField,
+              ParseError(RequestJson("action", params)).transport_error);
+  }
+}
+
+TEST(PrometheusSupervisionTransportCodecTest,
+     RejectsMissingMalformedOversizedAndStaleShapes) {
+  for (
+      std::string_view json : {
+          "",
+          "[]",
+          R"({"operation":"heartbeat"})",
+          R"({"operation":7,"params":{}})",
+          R"({"operation":"heartbeat","params":[]})",
+          R"({"operation":"heartbeat","params":{"session":"old"}})",
+          R"({"operation":"diff","params":{"dashboard_session":"DASHBOARD-SESSION-7","epoch":"old","cursor":7}})",
+          R"({"operation":"action","params":{"dashboard_session":"DASHBOARD-SESSION-7","document_epoch":"DOCUMENT-EPOCH-9","sequence":7,"action":{"type":"click","ref":"node:1"}}})",
+      }) {
+    SCOPED_TRACE(json);
+    EXPECT_NE(SupervisionTransportErrorCode::kNone,
+              ParseError(json).transport_error);
+  }
+
+  const std::string oversized(kMaxSupervisionTransportInputBytes + 1, 'x');
+  EXPECT_EQ(SupervisionTransportErrorCode::kRequestTooLarge,
+            ParseError(oversized).transport_error);
+}
+
+TEST(PrometheusSupervisionTransportCodecTest,
+     EnforcesStringIntegerAndSequenceBoundsAtAndOverLimits) {
+  const std::string label_at(kMaxSupervisionSafeLabelBytes, 'a');
+  auto at_label = ParseSupervisionTransportRequest(RequestJson(
+      "redeem",
+      "{\"pairing_code\":\"ABCDEFGH\",\"client_label\":\"" + label_at + "\"}"));
+  EXPECT_TRUE(at_label.has_value()) << at_label.error().message;
+
+  const std::string label_over(kMaxSupervisionSafeLabelBytes + 1, 'a');
+  EXPECT_EQ(SupervisionTransportErrorCode::kInvalidRequest,
+            ParseError(RequestJson("redeem",
+                                   "{\"pairing_code\":\"ABCDEFGH\","
+                                   "\"client_label\":\"" +
+                                       label_over + "\"}"))
+                .transport_error);
+
+  const std::string session_at(kMaxSupervisionTransportSessionBytes, 'a');
+  EXPECT_TRUE(ParseSupervisionTransportRequest(
+                  RequestJson("heartbeat",
+                              "{\"dashboard_session\":\"" + session_at + "\"}"))
+                  .has_value());
+  const std::string session_over(kMaxSupervisionTransportSessionBytes + 1, 'a');
+  EXPECT_EQ(SupervisionTransportErrorCode::kInvalidRequest,
+            ParseError(RequestJson("heartbeat", "{\"dashboard_session\":\"" +
+                                                    session_over + "\"}"))
+                .transport_error);
+
+  EXPECT_TRUE(
+      ParseSupervisionTransportRequest(
+          RequestJson(
+              "ack",
+              R"({"dashboard_session":"DASHBOARD-SESSION-7","document_epoch":"DOCUMENT-EPOCH-9","sequence":9007199254740991})"))
+          .has_value());
+  for (std::string_view sequence :
+       {"0", "-1", "1.5", "9007199254740992", "\"7\"", "null"}) {
+    SCOPED_TRACE(sequence);
+    EXPECT_EQ(
+        SupervisionTransportErrorCode::kInvalidRequest,
+        ParseError(RequestJson("ack",
+                               "{\"dashboard_session\":\"DASHBOARD-SESSION-7\","
+                               "\"document_epoch\":\"DOCUMENT-EPOCH-9\","
+                               "\"sequence\":" +
+                                   std::string(sequence) + "}"))
+            .transport_error);
+  }
+}
+
+TEST(PrometheusSupervisionTransportCodecTest,
