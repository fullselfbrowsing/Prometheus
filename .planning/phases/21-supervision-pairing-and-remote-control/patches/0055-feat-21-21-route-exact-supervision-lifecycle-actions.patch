+bool PrometheusSupervisionCaptureHub::RequestBaseline(
+    SupervisionCaptureConsumerId consumer_id) {
+  SweepExpiredConsumers();
+  auto consumer = consumers_.find(consumer_id);
+  if (consumer == consumers_.end()) {
+    return false;
+  }
+  if (consumer->second.needs_baseline) {
+    NotifyReadyDiffWaiters();
+    return true;
+  }
+  RequireBaseline(consumer->second);
+  if (!IsUsableBaseline(baseline_) || sequence_ == 0u) {
+    RequestCapture(/*force_baseline=*/false);
+  }
+  NotifyReadyDiffWaiters();
+  return true;
+}
