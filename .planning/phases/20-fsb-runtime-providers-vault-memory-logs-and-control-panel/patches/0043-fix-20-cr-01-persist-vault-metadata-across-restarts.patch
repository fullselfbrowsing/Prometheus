+TEST(PrometheusVaultServicePersistenceTest,
+     CorruptMetadataDropsEntryAndDeletesOrphanedSecret) {
+  sync_preferences::TestingPrefServiceSyncable prefs;
+  RegisterPrometheusRuntimeProfilePrefs(prefs.registry());
+  std::unique_ptr<os_crypt_async::OSCryptAsync> os_crypt =
+      os_crypt_async::GetTestOSCryptAsyncForTesting(true);
+  int profile_storage = 0;
+  Profile* profile = reinterpret_cast<Profile*>(&profile_storage);
+
+  {
+    PrometheusOsCryptSecretStore secret_store(&prefs, false, os_crypt.get());
+    PrometheusVaultService vault(profile, &secret_store, nullptr, &prefs);
+    PrometheusVaultMetadataResult created = vault.CreateMetadata(
+        "Corrupt account", PrometheusVaultKind::kCredential,
+        "https://corrupt.example");
+    ASSERT_TRUE(created.ok());
+    base::test::TestFuture<PrometheusVaultStatus> saved;
+    vault.OpenNativeSecretEntryWithDelegate(
+        created.metadata->id, false,
+        base::BindRepeating(
+            [](const PrometheusVaultMetadata&, bool,
+               PrometheusVaultService::NativeEntryReplyCallback reply) {
+              NativeVaultEntryReply result;
+              result.status = PrometheusVaultStatus::kSuccess;
+              result.fields.emplace_back(
+                  "password", ScopedSensitiveVaultValue(kPlaintextSentinel));
+              reply.Run(std::move(result));
+            }),
+        saved.GetCallback());
+    EXPECT_EQ(saved.Get(), PrometheusVaultStatus::kSuccess);
+  }
+
+  base::DictValue root = prefs.GetDict(kPrometheusRuntimeProfileData).Clone();
+  base::DictValue* store = root.FindDict("data")->FindDict("vault_store");
+  ASSERT_TRUE(store);
+  store->Set("next_metadata_id", "corrupt");
+  base::ListValue* entries = store->FindList("entries");
+  ASSERT_TRUE(entries);
+  ASSERT_EQ(entries->size(), 1u);
+  entries->front().GetDict().Set("label", 7);
+  prefs.SetDict(kPrometheusRuntimeProfileData, std::move(root));
+
+  PrometheusOsCryptSecretStore secret_store(&prefs, false, os_crypt.get());
+  PrometheusVaultService restarted(profile, &secret_store, nullptr, &prefs);
+  EXPECT_TRUE(restarted.ListMetadata().empty());
+  EXPECT_TRUE(secret_store.GetSanitizedMetadataSnapshot().empty());
+  PrometheusVaultMetadataResult next = restarted.CreateMetadata(
+      "After corruption", PrometheusVaultKind::kCredential,
+      "https://corrupt.example");
+  ASSERT_TRUE(next.ok());
+  EXPECT_EQ(next.metadata->id, "vault-2");
+}
