+TEST_F(PrometheusSupervisionCaptureHubTest,
+       DashboardLongPollDataAndCancellationRemainConsumerLocal) {
+  auto hub = CreateHub();
+  const auto first = hub->AttachConsumer(
+      SupervisionCaptureConsumerKind::kDashboard, now_ + base::Minutes(10));
+  const auto second = hub->AttachConsumer(
+      SupervisionCaptureConsumerKind::kDashboard, now_ + base::Minutes(10));
+  ASSERT_TRUE(first.has_value());
+  ASSERT_TRUE(second.has_value());
+  CompleteAndAckBaseline(*hub, *first, *second);
+
+  std::optional<SupervisionCaptureWaitReason> first_reason;
+  std::optional<SupervisionCaptureWaitReason> second_reason;
+  EXPECT_TRUE(hub->WaitForNextDiff(
+      *first,
+      base::BindLambdaForTesting([&](SupervisionCaptureWaitReason reason) {
+        first_reason = reason;
+      })));
+  EXPECT_TRUE(hub->WaitForNextDiff(
+      *second,
+      base::BindLambdaForTesting([&](SupervisionCaptureWaitReason reason) {
+        second_reason = reason;
+      })));
+  EXPECT_FALSE(hub->WaitForNextDiff(
+      *first, base::BindOnce([](SupervisionCaptureWaitReason) {})));
+  EXPECT_EQ(2u, hub->pending_wait_count_for_testing());
+
+  hub->NotifyDirtyForTesting(/*overflow=*/false);
+  capture_source_.CompleteNext(MakeBaseline("wait mutation"));
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(SupervisionCaptureWaitReason::kDataAvailable, first_reason);
+  EXPECT_EQ(SupervisionCaptureWaitReason::kDataAvailable, second_reason);
+  EXPECT_EQ(0u, hub->pending_wait_count_for_testing());
+
+  const auto first_diff = hub->ReadNext(*first);
+  const auto second_diff = hub->ReadNext(*second);
+  ASSERT_TRUE(first_diff.has_value());
+  ASSERT_TRUE(second_diff.has_value());
+  ASSERT_TRUE(hub->Ack(*first, first_diff->stamp));
+  ASSERT_TRUE(hub->Ack(*second, second_diff->stamp));
+
+  bool cancelled_callback_ran = false;
+  second_reason.reset();
+  EXPECT_TRUE(hub->WaitForNextDiff(
+      *first, base::BindLambdaForTesting([&](SupervisionCaptureWaitReason) {
+        cancelled_callback_ran = true;
+      })));
+  EXPECT_TRUE(hub->WaitForNextDiff(
+      *second,
+      base::BindLambdaForTesting([&](SupervisionCaptureWaitReason reason) {
+        second_reason = reason;
+      })));
+  EXPECT_TRUE(hub->CancelDiffWait(*first));
+  hub->NotifyDirtyForTesting(/*overflow=*/false);
+  capture_source_.CompleteNext(MakeBaseline("surviving wait mutation"));
+  task_environment_.RunUntilIdle();
+  EXPECT_FALSE(cancelled_callback_ran);
+  EXPECT_EQ(SupervisionCaptureWaitReason::kDataAvailable, second_reason);
+}
+
+TEST_F(PrometheusSupervisionCaptureHubTest,
+       DashboardLongPollResyncRevokeAndExpiryCompleteExactlyOnce) {
+  auto hub = CreateHub();
+  const auto first = hub->AttachConsumer(
+      SupervisionCaptureConsumerKind::kDashboard, now_ + base::Minutes(10));
+  const auto second = hub->AttachConsumer(
+      SupervisionCaptureConsumerKind::kDashboard, now_ + base::Minutes(20));
+  ASSERT_TRUE(first.has_value());
+  ASSERT_TRUE(second.has_value());
+  CompleteAndAckBaseline(*hub, *first, *second);
+
+  std::vector<SupervisionCaptureWaitReason> first_reasons;
+  std::vector<SupervisionCaptureWaitReason> second_reasons;
+  EXPECT_TRUE(hub->WaitForNextDiff(
+      *first,
+      base::BindLambdaForTesting([&](SupervisionCaptureWaitReason reason) {
+        first_reasons.push_back(reason);
+      })));
+  EXPECT_TRUE(hub->WaitForNextDiff(
+      *second,
+      base::BindLambdaForTesting([&](SupervisionCaptureWaitReason reason) {
+        second_reasons.push_back(reason);
+      })));
+
+  SupervisionStreamStamp wrong_stamp;
+  wrong_stamp.session = base::UnguessableToken::Create();
+  wrong_stamp.stable_tab_id = 17;
+  wrong_stamp.document_epoch = base::UnguessableToken::Create();
+  wrong_stamp.sequence = 1;
+  EXPECT_FALSE(hub->Ack(*first, wrong_stamp));
+  task_environment_.RunUntilIdle();
+  ASSERT_EQ(1u, first_reasons.size());
+  EXPECT_EQ(SupervisionCaptureWaitReason::kBaselineRequired,
+            first_reasons.front());
+  EXPECT_TRUE(second_reasons.empty());
+
+  EXPECT_TRUE(hub->RevokeConsumer(*second));
+  task_environment_.RunUntilIdle();
+  ASSERT_EQ(1u, second_reasons.size());
+  EXPECT_EQ(SupervisionCaptureWaitReason::kConsumerEnded,
+            second_reasons.front());
+
+  const auto replacement_baseline = hub->ReadBaseline(*first);
+  ASSERT_TRUE(replacement_baseline.has_value());
+  ASSERT_TRUE(hub->Ack(*first, replacement_baseline->stamp));
+  std::vector<SupervisionCaptureWaitReason> expiry_reasons;
+  EXPECT_TRUE(hub->WaitForNextDiff(
+      *first,
+      base::BindLambdaForTesting([&](SupervisionCaptureWaitReason reason) {
+        expiry_reasons.push_back(reason);
+      })));
+  now_ += base::Minutes(11);
+  hub->SweepExpiredConsumers();
+  task_environment_.RunUntilIdle();
+  ASSERT_EQ(1u, expiry_reasons.size());
+  EXPECT_EQ(SupervisionCaptureWaitReason::kConsumerEnded,
+            expiry_reasons.front());
+  EXPECT_EQ(0u, hub->consumer_count());
+  EXPECT_EQ(1u, hub->disable_count_for_testing());
+  hub->SweepExpiredConsumers();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(1u, expiry_reasons.size());
+}
