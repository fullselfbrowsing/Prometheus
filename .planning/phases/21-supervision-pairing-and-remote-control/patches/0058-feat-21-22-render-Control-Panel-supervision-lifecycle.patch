@@ -30,6 +30,15 @@ let controlMemorySearchResults = null;
 let controlGuideSearchResults = null;
 let pendingControlSearch = '';
 let pendingControlPolicySave = false;
+let controlPairingCode = '';
+let controlPairingExpiresAtMs = 0;
+let controlPairingUiState = 'idle';
+let controlPairingTimer = 0;
+let controlPairingAwaitingTerminal = false;
+let controlPairingAnnouncements = new Set();
+let pendingControlSupervisionDialog = null;
+let controlSupervisionMutationPending = false;
+const controlSupervisionFocusLabels = new WeakMap();
 
 let controlSnapshot = {
   status: 'NOT_IMPLEMENTED',
@@ -1569,7 +1578,7 @@ function renderControlPermissions() {
