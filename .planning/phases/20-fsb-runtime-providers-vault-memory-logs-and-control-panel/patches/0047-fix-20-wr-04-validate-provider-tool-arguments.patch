+enum class ToolArgumentValidation {
+  kValid,
+  kInvalid,
+  kBounds,
+};
+
+ToolArgumentValidation ValidateValueAgainstSchema(const base::Value& value,
+                                                  const base::DictValue& schema,
+                                                  size_t depth);
+
+ToolArgumentValidation ValidateObjectAgainstSchema(
+    const base::DictValue& value,
+    const base::DictValue& schema,
+    size_t depth) {
+  if (depth > kMaxProviderToolSchemaDepth) {
+    return ToolArgumentValidation::kInvalid;
+  }
+  const base::DictValue* properties = schema.FindDict("properties");
+  for (const auto [name, member] : value) {
+    const base::Value* property = properties ? properties->Find(name) : nullptr;
+    if (!property || !property->is_dict()) {
+      return ToolArgumentValidation::kInvalid;
+    }
+    ToolArgumentValidation validation =
+        ValidateValueAgainstSchema(member, property->GetDict(), depth + 1);
+    if (validation != ToolArgumentValidation::kValid) {
+      return validation;
+    }
+  }
+  if (const base::ListValue* required = schema.FindList("required")) {
+    for (const base::Value& entry : *required) {
+      if (!value.contains(entry.GetString())) {
+        return ToolArgumentValidation::kInvalid;
+      }
+    }
+  }
+  return ToolArgumentValidation::kValid;
+}
+
+ToolArgumentValidation ValidateValueAgainstSchema(const base::Value& value,
+                                                  const base::DictValue& schema,
+                                                  size_t depth) {
+  if (depth > kMaxProviderToolSchemaDepth) {
+    return ToolArgumentValidation::kInvalid;
+  }
+  const std::string* type = schema.FindString("type");
+  if (!type) {
+    return ToolArgumentValidation::kInvalid;
+  }
+  if (*type == "object") {
+    return value.is_dict()
+               ? ValidateObjectAgainstSchema(value.GetDict(), schema, depth)
+               : ToolArgumentValidation::kInvalid;
+  }
+  if (*type == "array") {
+    if (!value.is_list()) {
+      return ToolArgumentValidation::kInvalid;
+    }
+    const base::ListValue& list = value.GetList();
+    std::optional<int> minimum = schema.FindInt("minItems");
+    std::optional<int> maximum = schema.FindInt("maxItems");
+    if ((minimum && list.size() < static_cast<size_t>(*minimum)) ||
+        (maximum && list.size() > static_cast<size_t>(*maximum))) {
+      return ToolArgumentValidation::kBounds;
+    }
+    const base::DictValue* items = schema.FindDict("items");
+    for (const base::Value& item : list) {
+      ToolArgumentValidation validation =
+          ValidateValueAgainstSchema(item, *items, depth + 1);
+      if (validation != ToolArgumentValidation::kValid) {
+        return validation;
+      }
+    }
+    return ToolArgumentValidation::kValid;
+  }
+  if (*type == "string") {
+    if (!value.is_string() || !base::IsStringUTF8(value.GetString())) {
+      return ToolArgumentValidation::kInvalid;
+    }
+    std::optional<int> minimum = schema.FindInt("minLength");
+    std::optional<int> maximum = schema.FindInt("maxLength");
+    if ((minimum && value.GetString().size() < static_cast<size_t>(*minimum)) ||
+        (maximum && value.GetString().size() > static_cast<size_t>(*maximum))) {
+      return ToolArgumentValidation::kBounds;
+    }
+    return ToolArgumentValidation::kValid;
+  }
+  if (*type == "integer") {
+    if (!value.is_int()) {
+      return ToolArgumentValidation::kInvalid;
+    }
+    std::optional<int> minimum = schema.FindInt("minimum");
+    std::optional<int> maximum = schema.FindInt("maximum");
+    if ((minimum && value.GetInt() < *minimum) ||
+        (maximum && value.GetInt() > *maximum)) {
+      return ToolArgumentValidation::kBounds;
+    }
+    return ToolArgumentValidation::kValid;
+  }
+  if (*type == "boolean") {
+    return value.is_bool() ? ToolArgumentValidation::kValid
+                           : ToolArgumentValidation::kInvalid;
+  }
+  return ToolArgumentValidation::kInvalid;
+}
