+const controlExtensionGrantCopy = Object.freeze({
+  blocked: Object.freeze({
+    label: 'Blocked',
+    helper: 'Agents cannot read or interact with this extension.',
+  }),
+  read_only: Object.freeze({
+    label: 'Read only',
+    helper:
+        'Agents may read approved visible extension pages but cannot change them.',
+  }),
+  interact: Object.freeze({
+    label: 'Interact',
+    helper:
+        'Agents may use approved typed actions on visible extension pages. ' +
+        'Scripts and hidden contexts remain blocked.',
+  }),
+});
+const controlExtensionGrantOrder =
+    Object.freeze(['blocked', 'read_only', 'interact']);
+const controlExtensionCompatibilityCategories = Object.freeze([
+  'Password manager',
+  'Ad blocker',
+  'Productivity content script',
+  'Side panel and tooling',
+  'Developer extension',
+]);
+
+function controlExtensionText(value, fallback, maximum = 160) {
+  if (typeof value !== 'string' || !value || value.length > maximum ||
+      /[\u0000-\u001f\u007f-\u009f\u202a-\u202e\u2066-\u2069]/u
+          .test(value)) {
+    return fallback;
+  }
+  return value;
+}
+
+function controlExtensionSource(value) {
+  return ['component', 'policy', 'web_store', 'unpacked', 'other']
+          .includes(value) ?
+      value :
+      'other';
+}
+
+function controlExtensionSourceLabel(value) {
+  return {
+    component: 'Component',
+    policy: 'Policy',
+    web_store: 'Web Store unverified',
+    unpacked: 'Developer mode',
+    other: 'Other source',
+  }[value] || 'Other source';
+}
+
+function controlExtensionGrant(value) {
+  return Object.hasOwn(controlExtensionGrantCopy, value) ? value : 'blocked';
+}
+
+function controlExtensionGrantRank(value) {
+  return controlExtensionGrantOrder.indexOf(controlExtensionGrant(value));
+}
+
+function normalizeControlExtensionCompatibility(value) {
+  const received = new Map();
+  for (const row of controlArray(value).slice(0, 5)) {
+    const category = controlExtensionText(row?.category, '', 64);
+    if (!controlExtensionCompatibilityCategories.includes(category) ||
+        received.has(category)) {
+      continue;
+    }
+    received.set(category, {
+      category,
+      status: ['verified', 'degraded', 'unsupported'].includes(row?.status) ?
+          row.status :
+          'unsupported',
+      fixture: controlExtensionText(
+          row?.fixture, 'No verified fixture', 128),
+      manifest: controlExtensionText(
+          row?.manifest, 'Manifest unknown', 32),
+      source: controlExtensionText(row?.source, 'Not verified', 64),
+      behaviors: controlExtensionText(
+          row?.behaviors, 'No representative behaviors verified', 160),
+      revision: controlExtensionText(
+          row?.revision, 'Current Chromium and Prometheus revision', 96),
+      last_verified: controlExtensionText(
+          row?.last_verified, 'Not verified', 64),
