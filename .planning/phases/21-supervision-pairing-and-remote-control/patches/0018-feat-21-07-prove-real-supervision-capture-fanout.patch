+// APC can repeat an input value in accessibility-derived label/text nodes.
+// Collect first so the browser projection can remove every copy, not only the
+// canonical FormControlData field.
+bool CollectRawFormValuesForSupervision(
+    const optimization_guide::proto::ContentNode& node,
+    std::vector<std::string>* raw_values,
+    size_t* raw_value_bytes) {
+  if (node.has_content_attributes() &&
+      node.content_attributes().has_form_control_data()) {
+    const auto& form_control =
+        node.content_attributes().form_control_data();
+    if (form_control.has_field_value() && !form_control.field_value().empty()) {
+      if (raw_values->size() >= kDefaultSupervisionBaselineNodes ||
+          form_control.field_value().size() >
+              kDefaultSupervisionBaselineBytes - *raw_value_bytes) {
+        return false;
+      }
+      *raw_value_bytes += form_control.field_value().size();
+      raw_values->push_back(form_control.field_value());
+    }
+  }
+  for (const auto& child : node.children_nodes()) {
+    if (!CollectRawFormValuesForSupervision(child, raw_values,
+                                            raw_value_bytes)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool ContainsRawFormValue(std::string_view text,
+                          const std::vector<std::string>& raw_values) {
+  return std::ranges::any_of(raw_values, [text](const std::string& raw_value) {
+    return text.find(raw_value) != std::string_view::npos;
+  });
+}
+
+void RemoveRawFormValuesForSupervision(
+    optimization_guide::proto::ContentNode* node,
+    const std::vector<std::string>& raw_values) {
+  if (node->has_content_attributes()) {
+    auto* attributes = node->mutable_content_attributes();
+    if (ContainsRawFormValue(attributes->label(), raw_values)) {
+      attributes->clear_label();
+    }
+    if (attributes->has_text_data() &&
+        ContainsRawFormValue(attributes->text_data().text_content(),
+                             raw_values)) {
+      attributes->mutable_text_data()->clear_text_content();
+    }
+  }
+  if (node->has_content_attributes() &&
+      node->content_attributes().has_form_control_data()) {
+    auto* form_control =
+        node->mutable_content_attributes()->mutable_form_control_data();
+    form_control->clear_field_value();
+    if (ContainsRawFormValue(form_control->field_name(), raw_values)) {
+      form_control->clear_field_name();
+    }
+    if (ContainsRawFormValue(form_control->placeholder(), raw_values)) {
+      form_control->clear_placeholder();
+    }
+    for (auto& option : *form_control->mutable_select_options()) {
+      option.clear_value();
+      if (ContainsRawFormValue(option.text(), raw_values)) {
+        option.clear_text();
+      }
+    }
+  }
+  for (auto& child : *node->mutable_children_nodes()) {
+    RemoveRawFormValuesForSupervision(&child, raw_values);
+  }
+}
