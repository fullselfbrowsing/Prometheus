+TEST_F(PrometheusSupervisionCaptureHubTest,
+       IdenticalCaptureEmitsNoSequenceOrBatch) {
+  auto hub = CreateHub();
+  const auto [first, second] = AttachTwo(*hub);
+  CompleteAndAckBaseline(*hub, first, second, "same");
+
+  hub->NotifyDirtyForTesting(/*overflow=*/false);
+  capture_source_.CompleteNext(MakeBaseline("same"));
+
+  EXPECT_FALSE(hub->ReadNext(first).has_value());
+  EXPECT_FALSE(hub->ReadNext(second).has_value());
+  EXPECT_EQ(0u, hub->retained_batch_count_for_testing());
+}
+
+TEST_F(PrometheusSupervisionCaptureHubTest,
+       LastDetachDisablesAndReleasesSharedHistory) {
+  auto hub = CreateHub();
+  const auto [first, second] = AttachTwo(*hub);
+  CompleteAndAckBaseline(*hub, first, second);
+  hub->NotifyDirtyForTesting(/*overflow=*/false);
+  capture_source_.CompleteNext(MakeBaseline("changed"));
+  ASSERT_EQ(1u, hub->retained_batch_count_for_testing());
+
+  EXPECT_TRUE(hub->DetachConsumer(first));
+  EXPECT_EQ(0u, hub->disable_count_for_testing());
+  EXPECT_TRUE(hub->DetachConsumer(second));
+  EXPECT_EQ(1u, hub->disable_count_for_testing());
+  EXPECT_EQ(0u, hub->retained_batch_count_for_testing());
+  EXPECT_EQ(0u, hub->retained_bytes_for_testing());
+}
+
+TEST_F(PrometheusSupervisionCaptureHubTest,
+       DocumentReplacementRotatesEpochAndRejectsStaleCapture) {
+  auto hub = CreateHub();
+  const auto [first, second] = AttachTwo(*hub);
+  ASSERT_EQ(1u, capture_source_.pending_count());
+
+  hub->ReplaceDocumentForTesting();
+  EXPECT_EQ(2u, capture_source_.pending_count());
+  capture_source_.CompleteNext(MakeBaseline("stale"));
+  EXPECT_FALSE(hub->ReadBaseline(first).has_value());
+  capture_source_.CompleteNext(MakeBaseline("current"));
+
+  const auto first_baseline = hub->ReadBaseline(first);
+  const auto second_baseline = hub->ReadBaseline(second);
+  ASSERT_TRUE(first_baseline.has_value());
+  ASSERT_TRUE(second_baseline.has_value());
+  EXPECT_EQ(first_baseline->stamp.document_epoch,
+            second_baseline->stamp.document_epoch);
+  EXPECT_EQ(2u, hub->enable_count_for_testing());
+  EXPECT_EQ(1u, hub->disable_count_for_testing());
+}
