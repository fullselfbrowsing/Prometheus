+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/modules/content_extraction/prometheus_supervision_document_supplement.h"
+
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+
+namespace blink {
+
+const char PrometheusSupervisionDocumentSupplement::kSupplementName[] =
+    "PrometheusSupervisionDocumentSupplement";
+
+// static
+PrometheusSupervisionDocumentSupplement*
+PrometheusSupervisionDocumentSupplement::From(Document& document) {
+  return Supplement<Document>::From<PrometheusSupervisionDocumentSupplement>(
+      document);
+}
+
+// static
+void PrometheusSupervisionDocumentSupplement::BindReceiver(
+    LocalFrame* frame,
+    mojo::PendingReceiver<mojom::blink::PrometheusSupervisionDocument>
+        receiver) {
+  CHECK(frame && frame->GetDocument() && frame->DomWindow());
+  Document& document = *frame->GetDocument();
+  auto* supplement = From(document);
+  if (!supplement) {
+    supplement =
+        MakeGarbageCollected<PrometheusSupervisionDocumentSupplement>(
+            base::PassKey<PrometheusSupervisionDocumentSupplement>(), *frame);
+    Supplement<Document>::ProvideTo(document, supplement);
+  }
+  supplement->Bind(std::move(receiver));
+}
+
+PrometheusSupervisionDocumentSupplement::
+    PrometheusSupervisionDocumentSupplement(
+        base::PassKey<PrometheusSupervisionDocumentSupplement>,
+        LocalFrame& frame)
+    : Supplement<Document>(*frame.GetDocument()),
+      receiver_(this, frame.DomWindow()),
+      host_(frame.DomWindow()) {}
+
+PrometheusSupervisionDocumentSupplement::
+    ~PrometheusSupervisionDocumentSupplement() = default;
+
+void PrometheusSupervisionDocumentSupplement::Bind(
+    mojo::PendingReceiver<mojom::blink::PrometheusSupervisionDocument>
+        receiver) {
+  Disable();
+  receiver_.reset();
+  receiver_.Bind(
+      std::move(receiver),
+      GetSupplementable()->GetTaskRunner(TaskType::kInternalUserInteraction));
+}
+
+void PrometheusSupervisionDocumentSupplement::Enable(
+    mojo::PendingRemote<mojom::blink::PrometheusSupervisionDocumentHost> host) {
+  Disable();
+  host_.Bind(
+      std::move(host),
+      GetSupplementable()->GetTaskRunner(TaskType::kInternalUserInteraction));
+}
+
+void PrometheusSupervisionDocumentSupplement::Disable() {
+  host_.reset();
+}
+
+void PrometheusSupervisionDocumentSupplement::Trace(Visitor* visitor) const {
+  Supplement<Document>::Trace(visitor);
+  visitor->Trace(receiver_);
+  visitor->Trace(host_);
+}
+
+}  // namespace blink
