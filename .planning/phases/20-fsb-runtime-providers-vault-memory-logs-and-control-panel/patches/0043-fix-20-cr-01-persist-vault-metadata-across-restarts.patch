+  BrowserWindowInterface* browser =
+      reinterpret_cast<BrowserWindowInterface*>(&browser_storage);
+  std::string entry_id;
+
+  {
+    PrometheusOsCryptSecretStore secret_store(&prefs, false, os_crypt.get());
+    PrometheusVaultService vault(profile, &secret_store, nullptr, &prefs);
+    PrometheusVaultMetadataResult created = vault.CreateMetadata(
+        "Restart account", PrometheusVaultKind::kCredential,
+        "https://restart.example/login");
+    ASSERT_TRUE(created.ok());
+    entry_id = created.metadata->id;
+    base::test::TestFuture<PrometheusVaultStatus> saved;
+    vault.OpenNativeSecretEntryWithDelegate(
+        entry_id, false,
+        base::BindRepeating(
+            [](const PrometheusVaultMetadata&, bool,
+               PrometheusVaultService::NativeEntryReplyCallback reply) {
+              NativeVaultEntryReply result;
+              result.status = PrometheusVaultStatus::kSuccess;
+              result.fields.emplace_back(
+                  "password", ScopedSensitiveVaultValue(kPlaintextSentinel));
+              reply.Run(std::move(result));
+            }),
+        saved.GetCallback());
+    EXPECT_EQ(saved.Get(), PrometheusVaultStatus::kSuccess);
+  }
+
+  {
+    PrometheusOsCryptSecretStore secret_store(&prefs, false, os_crypt.get());
+    PrometheusVaultService vault(profile, &secret_store, nullptr, &prefs);
+    ASSERT_EQ(vault.ListMetadata().size(), 1u);
+    EXPECT_EQ(vault.ListMetadata().front().id, entry_id);
+    EXPECT_TRUE(vault.ListMetadata().front().secret_configured);
+
+    ConfirmedVaultTargetBinding live_target;
+    live_target.profile = profile;
+    live_target.browser = browser;
+    live_target.window_session_id = 51;
+    live_target.tab_handle = tabs::TabHandle(9);
+    live_target.owner_session_id = "restart-owner";
+    live_target.canonical_origin = "https://restart.example";
+    live_target.frame_token = "303:404";
+    live_target.document_token = "restart-document";
+    live_target.target_refs = {"restart-document:1"};
+    live_target.focused = true;
+    vault.SetTargetInspectorForTesting(base::BindRepeating(
+        [](ConfirmedVaultTargetBinding* live_target, BrowserWindowInterface*,
+           const AgentTarget&, const AgentFrameTarget&,
+           const std::vector<std::string>&) {
+          return std::optional<ConfirmedVaultTargetBinding>(*live_target);
+        },
+        &live_target));
+    vault.SetNativeConfirmationDelegateForTesting(base::BindRepeating(
+        [](const PrometheusVaultConfirmationBinding&,
+           PrometheusVaultService::NativeConfirmationReply reply) {
+          reply.Run(true);
+        }));
+    vault.SetInsertionDelegateForTesting(base::BindRepeating(
+        [](BrowserWindowInterface*, ConfirmedVaultInsertionRequest request,
+           PrometheusAgentService::ConfirmedVaultCallback callback) {
+          ConfirmedVaultInsertionResult result;
+          result.status = ConfirmedVaultInsertionStatus::kSuccess;
+          result.fields_completed = request.fields.size();
+          std::move(callback).Run(result);
+        }));
+
+    PrometheusVaultUseRequest request;
+    request.caller_id = "restart-caller";
+    request.session_id = live_target.owner_session_id;
+    request.entry_id = entry_id;
+    request.exact_browser = browser;
+    request.target.window_session_id = live_target.window_session_id;
+    request.target.tab_handle = live_target.tab_handle;
+    request.frame.document_token = live_target.document_token;
+    request.frame.render_process_id = 303;
+    request.frame.render_frame_routing_id = 404;
+    request.target_refs = live_target.target_refs;
+    request.request_hash = "restart-request";
+    request.origin = PrometheusVaultUseOrigin::kBrowserUi;
+    base::test::TestFuture<PrometheusVaultUseResult> used;
+    vault.UseEntry(std::move(request), used.GetCallback());
+    EXPECT_EQ(used.Get().status, PrometheusVaultStatus::kSuccess);
+
+    base::test::TestFuture<PrometheusVaultStatus> deleted;
+    vault.DeleteMetadata(entry_id, deleted.GetCallback());
+    EXPECT_EQ(deleted.Get(), PrometheusVaultStatus::kSuccess);
+    PrometheusVaultMetadataResult replacement = vault.CreateMetadata(
+        "Replacement account", PrometheusVaultKind::kCredential,
+        "https://restart.example");
+    ASSERT_TRUE(replacement.ok());
+    EXPECT_NE(replacement.metadata->id, entry_id);
+    EXPECT_EQ(replacement.metadata->id, "vault-2");
+  }
+
+  PrometheusOsCryptSecretStore secret_store(&prefs, false, os_crypt.get());
+  PrometheusVaultService restarted(profile, &secret_store, nullptr, &prefs);
+  EXPECT_EQ(restarted.GetMetadata(entry_id).status,
+            PrometheusVaultStatus::kNotFound);
+  ASSERT_EQ(restarted.ListMetadata().size(), 1u);
+  EXPECT_EQ(restarted.ListMetadata().front().id, "vault-2");
+  EXPECT_TRUE(secret_store.GetSanitizedMetadataSnapshot().empty());
+}
