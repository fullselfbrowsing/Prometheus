+class RecordingTabDataObserver final : public PrometheusAgentTabData::Observer {
+ public:
+  void OnPrometheusAgentTabOwnerChanged(
+      std::string_view old_owner_session_id,
+      std::string_view new_owner_session_id) override {
+    owner_changes.emplace_back(old_owner_session_id, new_owner_session_id);
+  }
+
+  void OnPrometheusAgentTabDataDestroying() override { ++destroying_count; }
+
+  std::vector<std::pair<std::string, std::string>> owner_changes;
+  int destroying_count = 0;
+};
+
+class PrometheusAgentServiceObservationTest : public testing::Test {
+ public:
+  PrometheusAgentServiceObservationTest()
+      : registry_(kDefaultMaxAgentSessions, base::Hours(1)),
+        service_(std::make_unique<PrometheusAgentService>(&registry_)) {
+    ON_CALL(tab_, GetUnownedUserDataHost())
+        .WillByDefault(testing::ReturnRef(tab_data_host_));
+    ON_CALL(tab_, RegisterWillDetach(testing::_))
+        .WillByDefault([this](tabs::TabInterface::WillDetach callback) {
+          will_detach_ = std::move(callback);
+          return base::CallbackListSubscription();
+        });
+  }
+
+ protected:
+  base::test::TaskEnvironment task_environment_;
+  ui::UnownedUserDataHost tab_data_host_;
+  tabs::MockTabInterface tab_;
+  tabs::TabInterface::WillDetach will_detach_;
+  AgentSessionRegistry registry_;
+  RecordingTabDataObserver observer_;
+  std::unique_ptr<PrometheusAgentService> service_;
+};
+
+TEST_F(PrometheusAgentServiceObservationTest,
+       FreshUnownedObservationReusesOneAgentOwnedObjectAcrossOwnerChanges) {
+  PrometheusAgentTabObservationLease lease =
+      service_->ObserveOrCreateTabData(&tab_, &observer_);
+  ASSERT_NE(nullptr, lease.data());
+  EXPECT_EQ(lease.data(), PrometheusAgentTabData::From(&tab_));
+  EXPECT_EQ(1u, service_->owned_tab_data_count_for_testing());
+  EXPECT_EQ(1u, service_->tab_observation_count_for_testing());
+
+  EXPECT_TRUE(lease.data()->ClaimIfUnowned("owner-a", "Agent A").ok);
+  EXPECT_TRUE(lease.data()->ReleaseIfOwned("owner-a").ok);
+  EXPECT_TRUE(lease.data()->ClaimIfUnowned("owner-b", "Agent B").ok);
+
+  EXPECT_THAT(
+      observer_.owner_changes,
+      testing::ElementsAre(std::pair<std::string, std::string>("", "owner-a"),
+                           std::pair<std::string, std::string>("owner-a", ""),
+                           std::pair<std::string, std::string>("", "owner-b")));
+  EXPECT_EQ(lease.data(), PrometheusAgentTabData::From(&tab_));
+}
+
+TEST_F(PrometheusAgentServiceObservationTest,
+       SameObserverAndTabCoalesceUntilLastMoveOnlyLeaseReleases) {
+  PrometheusAgentTabObservationLease first =
+      service_->ObserveOrCreateTabData(&tab_, &observer_);
+  PrometheusAgentTabObservationLease second =
+      service_->ObserveOrCreateTabData(&tab_, &observer_);
+  ASSERT_NE(nullptr, first.data());
+  EXPECT_EQ(first.data(), second.data());
+  EXPECT_EQ(1u, service_->tab_observation_count_for_testing());
+
+  first.Reset();
+  EXPECT_NE(nullptr, second.data());
+  EXPECT_EQ(1u, service_->tab_observation_count_for_testing());
+  second.Reset();
+  task_environment_.RunUntilIdle();
+
+  EXPECT_EQ(0u, service_->tab_observation_count_for_testing());
+  EXPECT_EQ(0u, service_->owned_tab_data_count_for_testing());
+  EXPECT_EQ(nullptr, PrometheusAgentTabData::From(&tab_));
+}
+
+TEST_F(PrometheusAgentServiceObservationTest,
+       SessionReleaseNotifiesBeforeDeferredUnownedPrune) {
+  PrometheusAgentTabObservationLease lease =
+      service_->ObserveOrCreateTabData(&tab_, &observer_);
+  ASSERT_NE(nullptr, lease.data());
+  ASSERT_TRUE(lease.data()->ClaimIfUnowned("owner-a", "Agent A").ok);
+
+  service_->ReleaseSessionOwnership("owner-a");
+
+  ASSERT_EQ(2u, observer_.owner_changes.size());
+  EXPECT_EQ((std::pair<std::string, std::string>("owner-a", "")),
+            observer_.owner_changes.back());
+  EXPECT_NE(nullptr, lease.data());
+  lease.Reset();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(nullptr, PrometheusAgentTabData::From(&tab_));
+}
+
+TEST_F(PrometheusAgentServiceObservationTest,
+       DeleteDetachInvalidatesLeaseBeforeSingleDestroyingCallback) {
+  PrometheusAgentTabObservationLease lease =
+      service_->ObserveOrCreateTabData(&tab_, &observer_);
+  ASSERT_NE(nullptr, lease.data());
+  ASSERT_FALSE(will_detach_.is_null());
+
+  will_detach_.Run(&tab_, tabs::TabInterface::DetachReason::kDelete);
+
+  EXPECT_EQ(nullptr, lease.data());
+  EXPECT_EQ(1, observer_.destroying_count);
+  EXPECT_EQ(0u, service_->owned_tab_data_count_for_testing());
+  lease.Reset();
+  EXPECT_EQ(1, observer_.destroying_count);
+}
+
+TEST_F(PrometheusAgentServiceObservationTest,
+       AgentServiceShutdownInvalidatesLateLeaseWithoutUseAfterFree) {
+  PrometheusAgentTabObservationLease lease =
+      service_->ObserveOrCreateTabData(&tab_, &observer_);
+  ASSERT_NE(nullptr, lease.data());
+
+  service_.reset();
+
+  EXPECT_EQ(nullptr, lease.data());
+  EXPECT_EQ(1, observer_.destroying_count);
+  lease.Reset();
+  EXPECT_EQ(1, observer_.destroying_count);
+}
+
 }  // namespace
 }  // namespace prometheus
