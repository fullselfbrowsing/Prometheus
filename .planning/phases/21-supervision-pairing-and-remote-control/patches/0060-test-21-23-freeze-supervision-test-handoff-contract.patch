+TEST_F(PrometheusSupervisionTestBootstrapTest,
+       RealFileBoundaryAccepts0600AndRejectsSymlinkAndWrongMode) {
+  base::ScopedTempDir temp_dir;
+  ASSERT_TRUE(temp_dir.CreateUniqueTempDir());
+  const base::FilePath config_path =
+      temp_dir.GetPath().AppendASCII("supervision.json");
+  ASSERT_TRUE(base::WriteFile(config_path, MakeConfig()));
+  ASSERT_TRUE(base::SetPosixFilePermissions(config_path, 0600));
+
+  const auto real_access = CreatePrometheusSupervisionTestBootstrapFileAccess();
+  std::unique_ptr<PrometheusSupervisionTestBootstrap> bootstrap;
+  auto create = [&](const base::FilePath& path) {
+    return PrometheusSupervisionTestBootstrap::Create(
+        MakeLaunch(path), false,
+        {.is_regular_profile = true,
+         .is_disposable_profile = true,
+         .is_off_the_record = false},
+        real_access,
+        base::BindRepeating(
+            [](PrometheusSupervisionTestBindingFacts binding)
+                -> std::optional<PrometheusSupervisionTestBindingFacts> {
+              return binding;
+            },
+            current_binding_),
+        base::BindRepeating(
+            []() -> std::optional<std::string> { return "ABCD-EFGH"; }),
+        base::BindRepeating([]() { return base::TimeTicks::Now(); }),
+        PrometheusSupervisionTestBootstrap::ZeroizationCallback(), &bootstrap);
+  };
+  EXPECT_EQ(PrometheusSupervisionTestBootstrapResult::kApplied,
+            create(config_path));
+
+  bootstrap.reset();
+  ASSERT_TRUE(base::SetPosixFilePermissions(config_path, 0644));
+  EXPECT_EQ(PrometheusSupervisionTestBootstrapResult::kFileDenied,
+            create(config_path));
+
+  const base::FilePath link_path = temp_dir.GetPath().AppendASCII("link.json");
+  ASSERT_TRUE(base::CreateSymbolicLink(config_path, link_path));
+  EXPECT_EQ(PrometheusSupervisionTestBootstrapResult::kFileDenied,
+            create(link_path));
+}
