 void PrometheusAgentTabData::UpdateSupervisionState(
     PrometheusTabState::Supervision supervision) {
-  static_cast<void>(supervision);
+  if (supervision_ == supervision) {
+    return;
+  }
+  supervision_ = std::move(supervision);
+  NotifyTabStateIfChanged();
+}
+
+void PrometheusAgentTabData::ClearSupervisionState() {
+  UpdateSupervisionState(PrometheusTabState::Supervision());
+}
+
+void PrometheusAgentTabData::set_automation_active(bool active) {
