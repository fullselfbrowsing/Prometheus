+// static
+std::unique_ptr<PrometheusExtensionSmokeController>
+PrometheusExtensionSmokeController::Create(
+    std::unique_ptr<PrometheusExtensionSmokeBootstrap> bootstrap,
+    Profile* profile,
+    Browser* browser) {
+  if (!bootstrap || !profile || !browser) {
+    return nullptr;
+  }
+  if (profile->IsOffTheRecord() || !profile->IsRegularProfile()) {
+    return nullptr;
+  }
+  if (browser->profile() != profile) {
+    return nullptr;
+  }
+  auto controller = base::WrapUnique(new PrometheusExtensionSmokeController(
+      std::move(bootstrap), profile, browser));
+  controller->Start();
+  return controller;
+}
+
+void PrometheusExtensionSmokeController::Shutdown() {
+  if (shutdown_) {
+    return;
+  }
+  shutdown_ = true;
+  ui::SelectFileDialog::SetFactory(nullptr);
+  ++pending_wait_generation_;
+  pending_transition_ = PrometheusExtensionSmokePendingTransition::kNone;
+  manager_watcher_.reset();
+  options_watcher_.reset();
+  registry_observation_.Reset();
+  if (outcome_ == PrometheusExtensionSmokeOutcome::kRunning) {
+    outcome_ = PrometheusExtensionSmokeOutcome::kFailed;
+    WriteResult(outcome_, "shutdown");
+  }
+}
+
+void PrometheusExtensionSmokeController::OnExtensionLoaded(
+    content::BrowserContext* browser_context,
+    const extensions::Extension* extension) {
+  if (shutdown_ || outcome_ != PrometheusExtensionSmokeOutcome::kRunning ||
+      !extension) {
+    return;
+  }
+  if (pending_transition_ == PrometheusExtensionSmokePendingTransition::kInstall &&
+      stage_ == PrometheusExtensionSmokeStage::kLoadUnpackedClicked) {
+    if (extension->path() != bootstrap_->fixture_path()) {
+      return;
+    }
+    OnExtensionInstalledObserved(extension->id());
+    return;
+  }
+  if (extension_id_.empty() || extension->id() != extension_id_) {
+    return;
+  }
+  if (pending_transition_ == PrometheusExtensionSmokePendingTransition::kReload &&
+      awaiting_reload_reload_) {
+    pending_transition_ = PrometheusExtensionSmokePendingTransition::kNone;
+    awaiting_reload_reload_ = false;
+    ++reload_transitions_seen_;
+    stage_ = PrometheusExtensionSmokeStage::kReloaded;
+    ClickDisableToggle();
+    return;
+  }
+  if (pending_transition_ == PrometheusExtensionSmokePendingTransition::kEnable) {
+    pending_transition_ = PrometheusExtensionSmokePendingTransition::kNone;
+    stage_ = PrometheusExtensionSmokeStage::kEnabled;
+    ExercisePolicyGrants();
+  }
+}
+
+void PrometheusExtensionSmokeController::OnExtensionUnloaded(
+    content::BrowserContext* browser_context,
+    const extensions::Extension* extension,
+    extensions::UnloadedExtensionReason reason) {
+  if (shutdown_ || outcome_ != PrometheusExtensionSmokeOutcome::kRunning ||
+      !extension || extension_id_.empty() || extension->id() != extension_id_) {
+    return;
+  }
+  if (pending_transition_ == PrometheusExtensionSmokePendingTransition::kReload) {
+    // First half of the reload cycle; keep waiting for the matching load.
+    awaiting_reload_reload_ = true;
+    return;
+  }
+  if (pending_transition_ == PrometheusExtensionSmokePendingTransition::kDisable) {
+    pending_transition_ = PrometheusExtensionSmokePendingTransition::kNone;
+    stage_ = PrometheusExtensionSmokeStage::kDisabled;
+    ClickEnableToggle();
+  }
+}
+
+void PrometheusExtensionSmokeController::OnExtensionUninstalled(
+    content::BrowserContext* browser_context,
+    const extensions::Extension* extension,
+    extensions::UninstallReason reason) {
+  if (shutdown_ || outcome_ != PrometheusExtensionSmokeOutcome::kRunning ||
+      !extension || extension_id_.empty() || extension->id() != extension_id_) {
+    return;
+  }
+  if (pending_transition_ == PrometheusExtensionSmokePendingTransition::kRemove) {
+    pending_transition_ = PrometheusExtensionSmokePendingTransition::kNone;
+    OnExtensionRemovedObserved();
+  }
+}
+
+void PrometheusExtensionSmokeController::OnShutdown(
+    extensions::ExtensionRegistry* registry) {
+  registry_observation_.Reset();
+}
