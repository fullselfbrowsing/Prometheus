 void PrometheusSupervisionActionController::ExecuteAction(
     const base::UnguessableToken& dashboard_session,
     std::string_view document_epoch,
     uint64_t sequence,
     const SupervisionRemoteActionRequest& action,
     CompletionCallback callback) {
-  ++next_action_id_;
-  static_cast<void>(dashboard_session);
-  static_cast<void>(document_epoch);
-  static_cast<void>(sequence);
-  static_cast<void>(action);
