@@ -156,6 +168,28 @@ void PrometheusAgentProfileService::SetConfirmedVaultFieldInserterForTesting(
   agent_service_.SetConfirmedVaultFieldInserterForTesting(std::move(inserter));
 }
 
+void PrometheusAgentProfileService::AddObserver(Observer* observer) {
+  if (!shutdown_) {
+    observers_.AddObserver(observer);
+  }
+}
+
+void PrometheusAgentProfileService::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void PrometheusAgentProfileService::Shutdown() {
+  if (shutdown_) {
+    return;
+  }
+  shutdown_ = true;
+  for (const std::string& session_id : sessions_.CloseAllSessions()) {
+    agent_service_.ReleaseSessionOwnership(session_id);
+    NotifySessionLost(session_id);
+  }
+  observers_.Clear();
+}
+
 base::Time PrometheusAgentProfileService::Now() const {
   return now_callback_.Run();
 }
@@ -163,6 +197,14 @@ base::Time PrometheusAgentProfileService::Now() const {
 void PrometheusAgentProfileService::SweepExpiredSessions() {
   for (const std::string& session_id : sessions_.ExpireSessions(Now())) {
     agent_service_.ReleaseSessionOwnership(session_id);
+    NotifySessionLost(session_id);
+  }
+}
+
+void PrometheusAgentProfileService::NotifySessionLost(
+    std::string_view session_id) {
+  for (Observer& observer : observers_) {
+    observer.OnAgentSessionLost(session_id);
   }
 }
 
