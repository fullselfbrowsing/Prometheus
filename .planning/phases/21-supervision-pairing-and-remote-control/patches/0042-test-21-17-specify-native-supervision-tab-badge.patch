new file mode 100644
index 0000000000..ecc79af7fa
--- /dev/null
+++ b/chrome/browser/ui/views/prometheus/prometheus_tab_supervision_badge_browsertest.cc
@@ -0,0 +1,196 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/prometheus_tab_status_badge.h"
+
+#include <array>
+#include <optional>
+#include <string_view>
+
+#include "chrome/browser/prometheus/prometheus_action.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "content/public/test/browser_test.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/models/image_model.h"
+#include "ui/color/color_id.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/controls/image_view.h"
+
+namespace {
+
+using ActionCategory = PrometheusTabState::Supervision::ActionCategory;
+using ActivityState = PrometheusTabState::Supervision::ActivityState;
+using ControlState = PrometheusTabState::Supervision::ControlState;
+using Severity = PrometheusTabState::Supervision::Severity;
+using ViewState = PrometheusTabState::Supervision::ViewState;
+
+ui::ImageModel ExpectedIcon(PrometheusAction action, ui::ColorId color_id) {
+  return ui::ImageModel::FromVectorIcon(
+      *GetPrometheusActionIconMap().at(action), color_id,
+      PrometheusTabStatusBadge::kIconSize);
+}
+
+PrometheusTabState ViewingState(size_t viewers) {
+  PrometheusTabState state;
+  state.supervision.available = true;
+  state.supervision.viewer_count = viewers;
+  state.supervision.view_state = ViewState::kViewing;
+  state.supervision.control_state = ControlState::kViewOnly;
+  return state;
+}
+
+void ExpectSafeText(const PrometheusTabStatusBadge& badge) {
+  const std::u16string accessible_name =
+      badge.GetViewAccessibility().GetCachedName();
+  EXPECT_EQ(accessible_name, badge.GetTooltipText());
+  for (std::u16string_view forbidden :
+       {u"8J7K-2MNP", u"SESSION-AUTHORITY", u"LEASE-AUTHORITY",
+        u"https://private.example/path", u"/Users/private/profile",
+        u"#checkout-selector", u"RAW-TYPED-VALUE"}) {
+    EXPECT_EQ(std::u16string::npos, accessible_name.find(forbidden));
+    EXPECT_EQ(std::u16string::npos, badge.GetTooltipText().find(forbidden));
+  }
+}
+
+}  // namespace
+
+class PrometheusTabSupervisionBadgeBrowserTest : public InProcessBrowserTest {};
+
+IN_PROC_BROWSER_TEST_F(PrometheusTabSupervisionBadgeBrowserTest,
+                       StateSafeDefaultOwnerAgentAndSlotContract) {
+  PrometheusTabStatusBadge badge;
+  ASSERT_EQ(3u, badge.children().size());
+  EXPECT_EQ(12, PrometheusTabStatusBadge::kIconSize);
+  EXPECT_EQ(4, PrometheusTabStatusBadge::kIconSpacing);
+  for (views::View* child : badge.children()) {
+    EXPECT_EQ(gfx::Size(12, 12), child->GetPreferredSize());
+    EXPECT_FALSE(child->GetCanProcessEventsWithinSubtree());
+  }
+  EXPECT_FALSE(badge.GetCanProcessEventsWithinSubtree());
+  EXPECT_FALSE(badge.GetVisible());
+  EXPECT_EQ(u"No agent owns this tab",
+            badge.GetViewAccessibility().GetCachedName());
+
+  PrometheusTabState state;
+  state.owner_label = "Agent A";
+  badge.SetState(state);
+  EXPECT_TRUE(badge.GetVisible());
+  EXPECT_TRUE(badge.owner_or_automation_badge_for_testing()->GetVisible());
+  EXPECT_EQ(ExpectedIcon(PrometheusAction::kBolt, kColorPrometheusText2),
+            badge.owner_or_automation_badge_for_testing()->GetImageModel());
+  EXPECT_EQ(u"Owned by Agent A; Tab health OK",
+            badge.GetViewAccessibility().GetCachedName());
+
+  state.automation_active = true;
+  badge.SetState(state);
+  EXPECT_EQ(ExpectedIcon(PrometheusAction::kBolt, kColorPrometheusAccent),
+            badge.owner_or_automation_badge_for_testing()->GetImageModel());
+  EXPECT_EQ(
+      u"Owned by Agent A; Agent is working in this tab; Tab health OK",
+      badge.GetViewAccessibility().GetCachedName());
+}
+
+IN_PROC_BROWSER_TEST_F(PrometheusTabSupervisionBadgeBrowserTest,
+                       StateViewerControllerAndActionPriority) {
+  PrometheusTabStatusBadge badge;
+  PrometheusTabState state = ViewingState(1);
+  badge.SetState(state);
+  EXPECT_TRUE(badge.supervision_badge_for_testing()->GetVisible());
+  EXPECT_EQ(ExpectedIcon(PrometheusAction::kEye, kColorPrometheusAccent),
+            badge.supervision_badge_for_testing()->GetImageModel());
+  EXPECT_EQ(
+      u"No agent owns this tab; Supervised by 1 trusted client; Tab health OK",
+      badge.GetViewAccessibility().GetCachedName());
+
+  state.supervision.viewer_count = 3;
+  state.supervision.control_state = ControlState::kControllerReady;
+  state.supervision.controller_label = "Local dashboard";
+  badge.SetState(state);
+  EXPECT_EQ(ExpectedIcon(PrometheusAction::kShield, kColorPrometheusAccent),
+            badge.supervision_badge_for_testing()->GetImageModel());
+  EXPECT_EQ(
+      u"No agent owns this tab; Supervised by 3 trusted clients; Remote control enabled for Local dashboard; Tab health OK",
+      badge.GetViewAccessibility().GetCachedName());
+
+  constexpr std::array categories = {
+      std::pair{ActionCategory::kClick, u"Click"},
+      std::pair{ActionCategory::kType, u"Type"},
+      std::pair{ActionCategory::kKeyPress, u"Key press"},
+      std::pair{ActionCategory::kScroll, u"Scroll"},
+      std::pair{ActionCategory::kHover, u"Hover"},
+      std::pair{ActionCategory::kSelect, u"Select"},
+      std::pair{ActionCategory::kClear, u"Clear"},
+      std::pair{ActionCategory::kDrag, u"Drag"},
+      std::pair{ActionCategory::kDrop, u"Drop"},
+      std::pair{ActionCategory::kNavigate, u"Navigate"},
+  };
+  state.supervision.activity_state = ActivityState::kExecuting;
+  for (const auto& [category, phrase] : categories) {
+    state.supervision.action_category = category;
+    badge.SetState(state);
+    EXPECT_EQ(
+        ExpectedIcon(PrometheusAction::kCircleNodes, kColorPrometheusAccent),
+        badge.supervision_badge_for_testing()->GetImageModel());
+    EXPECT_NE(nullptr,
+              badge.supervision_badge_for_testing()->background());
+    EXPECT_NE(std::u16string::npos,
+              badge.GetViewAccessibility().GetCachedName().find(
+                  std::u16string(u"Remote action active: ") + phrase));
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(PrometheusTabSupervisionBadgeBrowserTest,
+                       StateCompleteOrderedNameAndHealthSeverity) {
+  PrometheusTabStatusBadge badge;
+  PrometheusTabState state = ViewingState(2);
+  state.owner_label = "Agent A";
+  state.automation_active = true;
+  state.supervision.control_state = ControlState::kControllerReady;
+  state.supervision.controller_label = "Dashboard A";
+  state.supervision.activity_state = ActivityState::kValidating;
+  state.supervision.action_category = ActionCategory::kNavigate;
+  state.supervision.severity = Severity::kBlocked;
+  badge.SetState(state);
+
+  EXPECT_TRUE(badge.health_badge_for_testing()->GetVisible());
+  EXPECT_EQ(ExpectedIcon(PrometheusAction::kTriangleExclamation,
+                         ui::kColorAlertHighSeverity),
+            badge.health_badge_for_testing()->GetImageModel());
+  EXPECT_EQ(
+      u"Owned by Agent A; Agent is working in this tab; Supervised by 2 trusted clients; Remote control enabled for Dashboard A; Remote action active: Navigate; Tab needs attention",
+      badge.GetViewAccessibility().GetCachedName());
+
+  state.supervision.severity = Severity::kNormal;
+  state.health = PrometheusTabState::Health::kNeedsAttention;
+  state.supervision.activity_state = ActivityState::kCompleted;
+  state.supervision.action_category.reset();
+  badge.SetState(state);
+  EXPECT_TRUE(badge.health_badge_for_testing()->GetVisible());
+  EXPECT_EQ(std::u16string::npos,
+            badge.GetViewAccessibility().GetCachedName().find(
+                u"Remote action active"));
+}
+
+IN_PROC_BROWSER_TEST_F(PrometheusTabSupervisionBadgeBrowserTest,
+                       StateTextIsContentFreeAndEventTransparent) {
+  PrometheusTabStatusBadge badge;
+  PrometheusTabState state = ViewingState(2);
+  state.owner_label =
+      "Bearer SESSION-AUTHORITY 8J7K-2MNP /Users/private/profile";
+  state.supervision.control_state = ControlState::kControllerReady;
+  state.supervision.controller_label =
+      "LEASE-AUTHORITY https://private.example/path #checkout-selector";
+  state.supervision.activity_state = ActivityState::kExecuting;
+  state.supervision.action_category = ActionCategory::kType;
+  state.supervision.severity = Severity::kNeedsAttention;
+  badge.SetState(state);
+
+  ExpectSafeText(badge);
+  EXPECT_FALSE(badge.GetCanProcessEventsWithinSubtree());
+  for (views::View* child : badge.children()) {
+    EXPECT_FALSE(child->GetCanProcessEventsWithinSubtree());
+    EXPECT_EQ(views::View::FocusBehavior::NEVER, child->GetFocusBehavior());
+  }
+}
