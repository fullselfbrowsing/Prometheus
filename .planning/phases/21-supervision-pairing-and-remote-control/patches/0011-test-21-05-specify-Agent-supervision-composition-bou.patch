@@ -0,0 +1,146 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_agent_profile_service.h"
+
+#include <memory>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/test/task_environment.h"
+#include "components/tabs/public/mock_tab_interface.h"
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/unowned_user_data/unowned_user_data_host.h"
+
+namespace prometheus {
+namespace {
+
+using testing::_;
+using testing::Return;
+using testing::ReturnRef;
+
+class RecordingAgentTabObserver final
+    : public PrometheusAgentTabData::Observer {
+ public:
+  void OnPrometheusAgentTabOwnerChanged(
+      std::string_view old_owner_session_id,
+      std::string_view new_owner_session_id) override {
+    owner_changes.emplace_back(old_owner_session_id, new_owner_session_id);
+  }
+
+  void OnPrometheusAgentTabDataDestroying() override { ++destroying_count; }
+
+  std::vector<std::pair<std::string, std::string>> owner_changes;
+  size_t destroying_count = 0;
+};
+
+class PrometheusAgentProfileServiceTest : public testing::Test {
+ public:
+  PrometheusAgentProfileServiceTest()
+      : profile_(reinterpret_cast<Profile*>(&profile_storage_)) {
+    ON_CALL(tab_, GetUnownedUserDataHost()).WillByDefault(ReturnRef(tab_host_));
+    ON_CALL(tab_, GetProfile()).WillByDefault(Return(profile_.get()));
+    ON_CALL(tab_, GetTabHandle()).WillByDefault(Return(41u));
+    ON_CALL(tab_, RegisterWillDetach(_))
+        .WillByDefault([this](tabs::TabInterface::WillDetach callback) {
+          will_detach_ = std::move(callback);
+          return base::CallbackListSubscription();
+        });
+    service_ = PrometheusAgentProfileService::CreateForTesting(profile_.get());
+  }
+
+ protected:
+  base::test::TaskEnvironment task_environment_;
+  int profile_storage_ = 0;
+  raw_ptr<Profile> profile_;
+  ui::UnownedUserDataHost tab_host_;
+  tabs::MockTabInterface tab_;
+  tabs::TabInterface::WillDetach will_detach_;
+  RecordingAgentTabObserver observer_;
+  std::unique_ptr<PrometheusAgentProfileService> service_;
+};
+
+TEST_F(PrometheusAgentProfileServiceTest,
+       SupervisionObservationForwardsFreshUnownedAndOwnerTransitions) {
+  PrometheusAgentTabObservationLease lease =
+      service_->ObserveOrCreateTabData(&tab_, &observer_);
+  ASSERT_NE(nullptr, lease.data());
+  EXPECT_EQ(lease.data(), PrometheusAgentTabData::From(&tab_));
+  EXPECT_TRUE(lease.data()->owner_session_id().empty());
+
+  AgentSessionResult owner_a = service_->CreateSession("Agent A");
+  AgentSessionResult owner_b = service_->CreateSession("Agent B");
+  ASSERT_TRUE(owner_a.route_result.ok);
+  ASSERT_TRUE(owner_b.route_result.ok);
+  ASSERT_TRUE(owner_a.session.has_value());
+  ASSERT_TRUE(owner_b.session.has_value());
+  ASSERT_TRUE(
+      lease.data()
+          ->ClaimIfUnowned(owner_a.session->id, owner_a.session->display_label)
+          .ok);
+  ASSERT_TRUE(service_->CloseSession(owner_a.session->id).ok);
+  ASSERT_TRUE(
+      lease.data()
+          ->ClaimIfUnowned(owner_b.session->id, owner_b.session->display_label)
+          .ok);
+
+  ASSERT_EQ(3u, observer_.owner_changes.size());
+  EXPECT_EQ(std::make_pair(std::string(), owner_a.session->id),
+            observer_.owner_changes[0]);
+  EXPECT_EQ(std::make_pair(owner_a.session->id, std::string()),
+            observer_.owner_changes[1]);
+  EXPECT_EQ(std::make_pair(std::string(), owner_b.session->id),
+            observer_.owner_changes[2]);
+}
+
+TEST_F(PrometheusAgentProfileServiceTest,
+       SupervisionObservationLastReleasePrunesTheAgentOwnedObject) {
+  PrometheusAgentTabObservationLease lease =
+      service_->ObserveOrCreateTabData(&tab_, &observer_);
+  ASSERT_NE(nullptr, lease.data());
+  EXPECT_NE(nullptr, PrometheusAgentTabData::From(&tab_));
+
+  lease.Reset();
+  task_environment_.RunUntilIdle();
+
+  EXPECT_EQ(nullptr, PrometheusAgentTabData::From(&tab_));
+  EXPECT_EQ(1u, observer_.destroying_count);
+}
+
+TEST_F(PrometheusAgentProfileServiceTest,
+       SupervisionObservationDetachInvalidatesLateLeaseDestruction) {
+  PrometheusAgentTabObservationLease lease =
+      service_->ObserveOrCreateTabData(&tab_, &observer_);
+  ASSERT_NE(nullptr, lease.data());
+  ASSERT_FALSE(will_detach_.is_null());
+
+  will_detach_.Run(&tab_, tabs::TabInterface::DetachReason::kDelete);
+
+  EXPECT_EQ(nullptr, lease.data());
+  EXPECT_EQ(nullptr, PrometheusAgentTabData::From(&tab_));
+  EXPECT_EQ(1u, observer_.destroying_count);
+  lease.Reset();
+  task_environment_.RunUntilIdle();
+}
+
+TEST_F(PrometheusAgentProfileServiceTest,
+       SupervisionObservationAgentDestructionInvalidatesLateLease) {
+  PrometheusAgentTabObservationLease lease =
+      service_->ObserveOrCreateTabData(&tab_, &observer_);
+  ASSERT_NE(nullptr, lease.data());
+
+  service_.reset();
+
+  EXPECT_EQ(nullptr, lease.data());
+  EXPECT_EQ(nullptr, PrometheusAgentTabData::From(&tab_));
+  EXPECT_EQ(1u, observer_.destroying_count);
+  lease.Reset();
+  task_environment_.RunUntilIdle();
+}
+
+}  // namespace
+}  // namespace prometheus
