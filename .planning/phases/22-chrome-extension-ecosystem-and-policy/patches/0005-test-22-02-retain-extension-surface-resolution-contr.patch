+
+#include "chrome/browser/prometheus/prometheus_extension_surface_resolver.h"
+
+#include <optional>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace prometheus {
+namespace {
+
+PrometheusExtensionSurfaceEvidence VisibleTabEvidence() {
+  PrometheusExtensionSurfaceEvidence evidence;
+  evidence.observed_context =
+      PrometheusExtensionObservedContext::kTabContents;
+  return evidence;
+}
+
+PrometheusExtensionSurfaceEvidence VisiblePopupEvidence() {
+  PrometheusExtensionSurfaceEvidence evidence = VisibleTabEvidence();
+  evidence.selector = AgentExtensionSurfaceSelector::kPopup;
+  evidence.observed_context = PrometheusExtensionObservedContext::kPopup;
+  return evidence;
+}
+
+PrometheusExtensionSurfaceEvidence VisibleSidePanelEvidence() {
+  PrometheusExtensionSurfaceEvidence evidence = VisibleTabEvidence();
+  evidence.selector = AgentExtensionSurfaceSelector::kSidePanel;
+  evidence.observed_context = PrometheusExtensionObservedContext::kSidePanel;
+  return evidence;
+}
+
+void RequireGreenContract() {
+  ASSERT_TRUE(ExtensionSurfaceResolutionContractImplementedForTesting())
+      << "retained RED: browser-owned extension surface resolution is not "
+         "implemented";
+}
+
+void ExpectAccepted(const PrometheusExtensionSurfaceEvidence& evidence,
+                    PrometheusExtensionSurfaceKind kind) {
+  RequireGreenContract();
+  const auto classification =
+      PrometheusExtensionSurfaceResolver::ClassifyEvidenceForTesting(evidence);
+  EXPECT_TRUE(classification.accepted());
+  EXPECT_EQ(kind, classification.kind);
+  EXPECT_EQ(PrometheusExtensionSurfaceDenial::kNone,
+            classification.denial);
+  EXPECT_EQ(AgentErrorCode::kNone, classification.error_code);
+}
+
+void ExpectDenied(const PrometheusExtensionSurfaceEvidence& evidence,
+                  PrometheusExtensionSurfaceDenial denial,
+                  AgentErrorCode error_code) {
+  RequireGreenContract();
+  const auto classification =
+      PrometheusExtensionSurfaceResolver::ClassifyEvidenceForTesting(evidence);
+  EXPECT_FALSE(classification.accepted());
+  EXPECT_EQ(denial, classification.denial);
+  EXPECT_EQ(error_code, classification.error_code);
+}
+
+TEST(PrometheusExtensionSurfaceResolverTest,
+     AcceptsCommittedVisibleTopLevelExtensionTab) {
+  ExpectAccepted(VisibleTabEvidence(), PrometheusExtensionSurfaceKind::kTab);
+}
+
+TEST(PrometheusExtensionSurfaceResolverTest,
+     AcceptsCommittedVisibleOptionsPage) {
+  auto evidence = VisibleTabEvidence();
+  evidence.options_page = true;
+  ExpectAccepted(evidence, PrometheusExtensionSurfaceKind::kOptionsPage);
+}
+
+TEST(PrometheusExtensionSurfaceResolverTest,
+     AcceptsExactlyOneShownPopupOwnedByAnchorBrowser) {
+  ExpectAccepted(VisiblePopupEvidence(),
+                 PrometheusExtensionSurfaceKind::kPopup);
+}
+
+TEST(PrometheusExtensionSurfaceResolverTest,
+     AcceptsExactlyOneActiveSidePanelOwnedByAnchorTab) {
+  ExpectAccepted(VisibleSidePanelEvidence(),
+                 PrometheusExtensionSurfaceKind::kSidePanel);
+}
+
+TEST(PrometheusExtensionSurfaceResolverTest,
+     AcceptsPositivelyOwnedPrimaryOptionsGuest) {
+  auto evidence = VisibleTabEvidence();
+  evidence.observed_context =
+      PrometheusExtensionObservedContext::kOptionsGuest;
+  ExpectAccepted(evidence, PrometheusExtensionSurfaceKind::kOptionsGuest);
+}
+
+TEST(PrometheusExtensionSurfaceResolverTest, RejectsZeroSelectorMatches) {
+  auto evidence = VisiblePopupEvidence();
+  evidence.selector_match_count = 0;
+  ExpectDenied(evidence,
+               PrometheusExtensionSurfaceDenial::kNoSelectorMatch,
+               AgentErrorCode::kInvalidTarget);
+}
+
+TEST(PrometheusExtensionSurfaceResolverTest, RejectsMultipleSelectorMatches) {
+  auto evidence = VisiblePopupEvidence();
+  evidence.selector_match_count = 2;
+  ExpectDenied(evidence,
+               PrometheusExtensionSurfaceDenial::kAmbiguousSelectorMatch,
+               AgentErrorCode::kInvalidTarget);
+}
+
+TEST(PrometheusExtensionSurfaceResolverTest, RejectsBackgroundPage) {
+  auto evidence = VisibleTabEvidence();
+  evidence.observed_context =
+      PrometheusExtensionObservedContext::kBackgroundPage;
+  ExpectDenied(evidence,
+               PrometheusExtensionSurfaceDenial::kUnsupportedContext,
+               AgentErrorCode::kInvalidTarget);
+}
+
+TEST(PrometheusExtensionSurfaceResolverTest, RejectsBackgroundContents) {
+  auto evidence = VisibleTabEvidence();
+  evidence.observed_context =
+      PrometheusExtensionObservedContext::kBackgroundContents;
+  ExpectDenied(evidence,
+               PrometheusExtensionSurfaceDenial::kUnsupportedContext,
+               AgentErrorCode::kInvalidTarget);
+}
+
+TEST(PrometheusExtensionSurfaceResolverTest, RejectsOffscreenDocument) {
+  auto evidence = VisibleTabEvidence();
+  evidence.observed_context =
+      PrometheusExtensionObservedContext::kOffscreenDocument;
+  ExpectDenied(evidence,
+               PrometheusExtensionSurfaceDenial::kUnsupportedContext,
+               AgentErrorCode::kInvalidTarget);
+}
+
+TEST(PrometheusExtensionSurfaceResolverTest, RejectsHiddenHost) {
+  auto evidence = VisiblePopupEvidence();
+  evidence.visible = false;
+  ExpectDenied(evidence, PrometheusExtensionSurfaceDenial::kHiddenSurface,
+               AgentErrorCode::kInvalidTarget);
+}
