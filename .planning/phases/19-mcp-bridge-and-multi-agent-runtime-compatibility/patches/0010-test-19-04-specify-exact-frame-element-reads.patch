+IN_PROC_BROWSER_TEST_F(PrometheusPageAdapterBrowserTest,
+                       ElementReadRejectsCrossOriginAndSandboxedFrames) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const std::string session_id = CreateSession("Restricted element frames");
+  ASSERT_FALSE(session_id.empty());
+  tabs::TabInterface* cross_origin_tab =
