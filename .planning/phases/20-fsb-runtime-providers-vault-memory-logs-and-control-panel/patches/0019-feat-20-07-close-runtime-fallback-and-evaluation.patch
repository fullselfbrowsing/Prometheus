-  if (selected == providers.end() || !enabled(*selected)) {
+  const auto eligible =
+      [requested_execution](const PrometheusProviderConfig& provider) {
+        if (!provider.enabled) {
+          return false;
+        }
+        switch (requested_execution) {
+          case RequestedExecution::kAuto:
+            return true;
+          case RequestedExecution::kProvider:
+            return provider.route_class != PrometheusProviderRouteClass::kLocal;
+          case RequestedExecution::kLocal:
+            return provider.route_class == PrometheusProviderRouteClass::kLocal;
+        }
+      };
+  const auto selected = std::ranges::find_if(providers, eligible);
+  if (selected == providers.end()) {
     return std::nullopt;
   }
   return *selected;
 }
 
+bool ProviderMatchesRequestedExecution(const PrometheusProviderConfig& provider,
+                                       RequestedExecution requested_execution) {
+  return SelectProvider({provider}, requested_execution).has_value();
+}
