+            '[data-pairing], [name*="secret"], [name*="endpoint"]') &&
+        !['claude.md', 'engine selector', 'client launch',
+          'prompt provisioner'].some(value => text.includes(value)) &&
+        Array.from(resourceNodes).every(node => {
