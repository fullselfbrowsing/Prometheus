+TEST_F(PrometheusProviderTransportTest,
+       RuntimeSafeToolContractReachesRealTransport) {
+  SetProvider(MakeProvider(PrometheusProviderKind::kOpenAI, true, true));
+  secret_store_.set_delay_reads(true);
+  CreateTransport();
+  ProviderTurnRequest request{
+      .family = provider_.family,
+      .use_responses_api = provider_.capabilities.responses_api,
+      .model = provider_.model_id,
+      .system_instruction = "Use one declared browser tool.",
+      .user_text = "Read the owned page.",
+      .max_output_tokens = 128,
+  };
+  request.tools = MakeRuntimeSafeToolDefinitions();
+  ASSERT_EQ(request.tools.size(), 9u);
+
+  std::optional<ProviderTurnResult> result;
+  const uint64_t operation_id = transport_->ExecuteTurn(
+      provider_.provider_id, std::move(request),
+      base::BindLambdaForTesting(
+          [&](ProviderTurnResult value) { result = std::move(value); }));
+
+  EXPECT_NE(operation_id, 0u);
+  EXPECT_FALSE(result);
+  EXPECT_EQ(secret_store_.read_count(), 1);
+  EXPECT_EQ(transport_->in_flight_for_testing(), 1u);
+  EXPECT_EQ(test_url_loader_factory_.total_requests(), 0u);
+
+  EXPECT_TRUE(transport_->Cancel(operation_id));
+  secret_store_.CompletePendingRead();
+  task_environment_.RunUntilIdle();
+  EXPECT_FALSE(result);
+  EXPECT_EQ(test_url_loader_factory_.total_requests(), 0u);
+}
