+void PrometheusSupervisionCaptureHub::NotifyReadyDiffWaiters() {
+  struct ReadyWait {
+    DiffWaitCallback callback;
+    SupervisionCaptureWaitReason reason =
+        SupervisionCaptureWaitReason::kDataAvailable;
+  };
+  std::vector<ReadyWait> ready;
+  for (auto& [consumer_id, consumer] : consumers_) {
+    static_cast<void>(consumer_id);
+    if (!consumer.pending_diff_wait) {
+      continue;
+    }
+    std::optional<SupervisionCaptureWaitReason> reason;
+    if (consumer.needs_baseline) {
+      reason = SupervisionCaptureWaitReason::kBaselineRequired;
+    } else if (consumer.next_sequence != 0u &&
+               std::ranges::find(history_, consumer.next_sequence,
+                                 &SharedBatch::sequence) != history_.end()) {
+      reason = SupervisionCaptureWaitReason::kDataAvailable;
+    }
+    if (reason.has_value()) {
+      ready.push_back(
+          ReadyWait{std::move(consumer.pending_diff_wait), *reason});
+    }
+  }
+  for (ReadyWait& wait : ready) {
+    CompleteDiffWaitAsync(std::move(wait.callback), wait.reason);
+  }
+}
