+            service_->SubmitTask(std::move(blank)).status);
+
+  RuntimeSubmitRequest oversize = Request();
+  oversize.prompt.assign(kHardRuntimePromptBytes + 1, 'x');
+  EXPECT_EQ(RuntimeProfileStatus::kRequestTooLarge,
