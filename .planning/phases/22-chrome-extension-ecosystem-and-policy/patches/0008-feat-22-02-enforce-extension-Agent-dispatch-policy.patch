+void PrometheusAgentService::OnExtensionPageRouteComplete(
+    AgentRouteRequest request,
+    base::Time timestamp,
+    base::TimeTicks started_at,
+    RouteCallback callback,
+    AgentRouteResult result,
+    PrometheusExtensionAuditProjection projection) {
+  result.elapsed = base::TimeTicks::Now() - started_at;
+  RecordExtensionAudit(request, result, projection, timestamp);
