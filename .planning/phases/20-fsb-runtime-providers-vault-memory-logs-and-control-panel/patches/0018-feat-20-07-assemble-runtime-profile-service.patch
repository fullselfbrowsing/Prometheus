+  active_submission_fingerprints_.insert(fingerprint);
+  EmitTelemetryIfEnabled(policy, RuntimeTelemetryEventKind::kTaskState);
+  return {.status = RuntimeProfileStatus::kOk, .task = std::move(snapshot)};
