@@ -930,6 +931,26 @@ void DeveloperPrivateLoadUnpackedFunction::ShowSelectFileDialog() {
   gfx::NativeWindow owning_window =
       platform_util::GetTopLevel(web_contents->GetNativeView());
 
+  // Stack-owned copy of the verified live sender's currently committed URL.
+  // Only the native chrome://extensions manager path is expected to reach
+  // here as that exact origin; every other caller (including this same
+  // function's ordinary chrome://extensions callers when the origin check
+  // somehow does not hold) keeps today's caller-less SelectFile() call. This
+  // makes no install decision and adds no Prometheus-specific hook: `caller`
+  // is the ordinary, already-public SelectFileDialog::SelectFile() argument,
+  // consumed only by a non-official, disposable-profile, exact-runtime-test
+  // built-app boundary (see
+  // chrome/browser/prometheus/prometheus_extension_smoke_controller.cc).
+  if (web_contents->GetLastCommittedURL() ==
+      GURL(chrome::kChromeUIExtensionsURL)) {
+    const GURL caller = web_contents->GetLastCommittedURL();
+    select_file_dialog_->SelectFile(file_type, title, last_directory,
+                                    &file_type_info, file_type_index,
+                                    base::FilePath::StringType(),
+                                    owning_window, &caller);
+    return;
+  }
+
   select_file_dialog_->SelectFile(file_type, title, last_directory,
                                   &file_type_info, file_type_index,
                                   base::FilePath::StringType(), owning_window);
