+IN_PROC_BROWSER_TEST_F(
+    PrometheusSupervisionConfirmationBrowserTest,
+    ConsequentialRequestApprovalRevalidatesAndDispatchesOnce) {
+  tabs::TabInterface* const tab =
+      TabListInterface::From(browser())->GetActiveTab();
+  ASSERT_TRUE(tab);
+  const base::UnguessableToken dashboard_session =
+      base::UnguessableToken::Create();
+  const base::UnguessableToken controller_lease =
+      base::UnguessableToken::Create();
+  const base::UnguessableToken document_epoch =
+      base::UnguessableToken::Create();
+  SupervisionActionAuthoritySnapshot authority;
+  authority.profile = browser()->profile();
+  authority.exact_browser = browser();
+  authority.stable_tab = tab->GetHandle();
+  authority.live_owner_session_id = "agent-owner";
+  authority.active_controller_session = dashboard_session;
+  authority.controller_lease = controller_lease;
+  authority.document_epoch = document_epoch;
+  authority.sequence = 9;
+  authority.authority_generation = 3;
+  authority.stream_live = true;
+  int authority_resolutions = 0;
+  int dispatches = 0;
+  std::vector<AgentRouteRequest> requests;
+  std::vector<SupervisionActionResult> results;
+  PrometheusSupervisionActionController controller(
+      browser()->profile(), browser()->GetWeakPtr(), tab->GetHandle(),
+      dashboard_session, "agent-owner", "Review console", "10:45 AM",
+      base::BindLambdaForTesting([&]() {
+        ++authority_resolutions;
+        return std::optional<SupervisionActionAuthoritySnapshot>(authority);
+      }),
+      base::BindLambdaForTesting(
+          [&](BrowserWindowInterface* exact_browser,
+              const AgentRouteRequest& request,
+              PrometheusAgentService::RouteCallback callback) {
+            EXPECT_EQ(browser(), exact_browser);
+            ++dispatches;
+            requests.push_back(request);
+            std::move(callback).Run(AgentRouteResult::Success({"changed"}));
+          }));
+
+  SupervisionRemoteActionRequest action;
+  action.category = SupervisionRemoteActionCategory::kNavigate;
+  action.navigation =
+      "https://private-destination.test/path?secret=raw-sentinel";
+  controller.ExecuteAction(
+      dashboard_session, document_epoch.ToString(), authority.sequence, action,
+      base::BindLambdaForTesting([&](SupervisionActionResult result) {
+        results.push_back(std::move(result));
+      }));
+  views::Widget* widget = PrometheusRuntimeDialogWidgetForTesting();
+  ASSERT_TRUE(widget);
+  views::DialogDelegate* dialog = CurrentDialog();
+  ASSERT_TRUE(dialog);
+  EXPECT_EQ(PrometheusRuntimeDialogKind::kSupervisionConsequentialAction,
+            PrometheusRuntimeDialogKindForTesting());
+  const std::u16string visible_text = JoinLabelText(widget->GetRootView());
+  EXPECT_EQ(std::u16string::npos, visible_text.find(u"private-destination"));
+  EXPECT_EQ(std::u16string::npos, visible_text.find(u"raw-sentinel"));
+  EXPECT_EQ(0, dispatches);
+  EXPECT_TRUE(results.empty());
+
+  dialog->AcceptDialog();
+  ASSERT_TRUE(base::test::RunUntil(
+      []() { return !PrometheusRuntimeDialogWidgetForTesting(); }));
+  ASSERT_EQ(1, dispatches);
+  ASSERT_EQ(1u, requests.size());
+  EXPECT_EQ(GURL(*action.navigation), requests[0].url);
+  ASSERT_EQ(1u, results.size());
+  EXPECT_TRUE(results[0].ok);
+  EXPECT_GE(authority_resolutions, 4);
+
+  controller.ExecuteAction(
+      dashboard_session, document_epoch.ToString(), authority.sequence, action,
+      base::BindLambdaForTesting([&](SupervisionActionResult result) {
+        results.push_back(std::move(result));
+      }));
+  views::Widget* denied_widget = PrometheusRuntimeDialogWidgetForTesting();
+  ASSERT_TRUE(denied_widget);
+  views::test::WidgetDestroyedWaiter denied_waiter(denied_widget);
+  EXPECT_TRUE(denied_widget->client_view()->AcceleratorPressed(
+      ui::Accelerator(ui::VKEY_ESCAPE, 0)));
+  denied_waiter.Wait();
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(2u, results.size());
+  EXPECT_EQ(SupervisionErrorCode::kConfirmationDenied, results[1].error_code);
+  EXPECT_EQ(1, dispatches);
+}
+
 }  // namespace
