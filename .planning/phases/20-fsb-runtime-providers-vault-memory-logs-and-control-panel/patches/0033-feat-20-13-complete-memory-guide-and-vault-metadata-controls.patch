+    mutation = owned_memory_store_->CreateMemory(
+        std::move(caller_id), visibility, std::move(title), std::move(text),
+        std::move(tags), base::Time::Now().InMillisecondsSinceUnixEpoch());
+  } else {
+    mutation.status = owned_memory_store_->UpdateMemory(
+        caller_id, memory_id, visibility, std::move(title), std::move(text),
+        std::move(tags), base::Time::Now().InMillisecondsSinceUnixEpoch());
+    mutation.record_id = std::move(memory_id);
+  }
+  if (mutation.ok()) {
+    for (Observer& observer : observers_) {
+      observer.OnRuntimeSidePanelSnapshotChanged();
+    }
+  }
+  return mutation;
