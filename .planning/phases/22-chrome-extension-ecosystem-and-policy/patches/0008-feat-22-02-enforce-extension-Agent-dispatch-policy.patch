+// static
+std::string PrometheusExtensionPageAdapter::BoundString(
+    std::string input,
+    size_t max_chars,
+    bool* truncated,
+    size_t* omitted_count) {
+  if (input.size() <= max_chars) {
+    *truncated = false;
+    *omitted_count = 0;
+    return input;
+  }
+  const size_t original_size = input.size();
+  input = std::string(base::TruncateUTF8ToByteSize(input, max_chars));
+  *truncated = true;
+  *omitted_count = original_size - input.size();
+  return input;
+}
