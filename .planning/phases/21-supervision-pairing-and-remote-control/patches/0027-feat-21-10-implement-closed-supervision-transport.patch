+base::expected<void, AgentRouteResult> ValidateSupervisionString(
+    std::string_view value,
+    size_t max_bytes,
+    bool allow_empty = true) {
+  if (value.size() > max_bytes) {
+    return base::unexpected(
+        RequestTooLarge("Supervision result exceeds structural limits"));
+  }
+  if ((!allow_empty && value.empty()) || !base::IsStringUTF8(value)) {
+    return base::unexpected(
+        InvalidRequest("Supervision result has invalid text structure"));
+  }
+  if (ContainsForbiddenSupervisionData(value)) {
+    return base::unexpected(
+        InvalidRequest("Supervision result contains forbidden data"));
+  }
+  return base::ok();
+}
+
+base::expected<void, AgentRouteResult> ValidateSupervisionNode(
+    const AgentSupervisionNode& node) {
+  struct StringConstraint {
+    std::string_view value;
+    size_t max_bytes;
+    bool allow_empty;
+  };
+  const std::array<StringConstraint, 7> constraints = {{
+      {node.ref, kMaxAgentSupervisionNodeRefBytes, false},
+      {node.parent_ref, kMaxAgentSupervisionNodeRefBytes, true},
+      {node.tag, kMaxSupervisionTagBytes, true},
+      {node.role, kMaxSupervisionTagBytes, true},
+      {node.name, kMaxSupervisionTextBytes, true},
+      {node.text_snippet, kMaxSupervisionTextBytes, true},
+      {node.frame_restricted_reason, kMaxSupervisionTextBytes, true},
+  }};
+  for (const StringConstraint& constraint : constraints) {
+    auto valid = ValidateSupervisionString(
+        constraint.value, constraint.max_bytes, constraint.allow_empty);
+    if (!valid.has_value()) {
+      return valid;
+    }
+  }
+  if (node.input_value.has_value()) {
+    auto valid =
+        ValidateSupervisionString(*node.input_value, kMaxSupervisionTextBytes);
+    if (!valid.has_value()) {
+      return valid;
+    }
+  }
+  if (node.input_type.has_value()) {
+    auto valid =
+        ValidateSupervisionString(*node.input_type, kMaxSupervisionTagBytes);
+    if (!valid.has_value()) {
+      return valid;
+    }
+  }
+  if ((!node.frame_restricted && !node.frame_restricted_reason.empty()) ||
+      (node.frame_restricted && node.frame_restricted_reason.empty())) {
+    return base::unexpected(InvalidRequest(
+        "Supervision restricted-frame metadata must be internally consistent"));
+  }
+  if (node.child_refs.size() > kMaxAgentSupervisionChildrenPerNode) {
+    return base::unexpected(RequestTooLarge(
+        "Supervision node exceeds the bounded child-reference count"));
+  }
+  std::set<std::string_view> child_refs;
+  for (const std::string& child_ref : node.child_refs) {
+    auto valid = ValidateSupervisionString(
+        child_ref, kMaxAgentSupervisionNodeRefBytes, false);
+    if (!valid.has_value()) {
+      return valid;
+    }
+    if (!child_refs.insert(child_ref).second) {
+      return base::unexpected(
+          InvalidRequest("Supervision node child references must be unique"));
+    }
+  }
+  return base::ok();
+}
+
+base::expected<void, AgentRouteResult> ValidateSupervisionNodeCollection(
+    const std::vector<AgentSupervisionNode>& nodes,
+    std::string_view external_parent = std::string_view()) {
+  if (nodes.size() > kMaxAgentSupervisionNodes) {
+    return base::unexpected(
+        RequestTooLarge("Supervision node count exceeds the result cap"));
+  }
+  if (nodes.empty()) {
+    return base::ok();
+  }
+
+  std::set<std::string_view> refs;
+  for (const AgentSupervisionNode& node : nodes) {
+    auto valid = ValidateSupervisionNode(node);
+    if (!valid.has_value()) {
+      return valid;
+    }
+    if (!refs.insert(node.ref).second) {
+      return base::unexpected(
+          InvalidRequest("Supervision node references must be unique"));
+    }
+  }
+  if (!external_parent.empty() && refs.contains(external_parent)) {
+    return base::unexpected(InvalidRequest(
+        "Supervision subtree parent cannot also be an inserted node"));
+  }
+
+  auto find_node =
+      [&nodes](std::string_view ref) -> const AgentSupervisionNode* {
+    const auto match = std::find_if(
+        nodes.begin(), nodes.end(),
+        [ref](const AgentSupervisionNode& node) { return node.ref == ref; });
+    return match == nodes.end() ? nullptr : &*match;
+  };
+
+  size_t root_count = 0;
+  size_t external_root_count = 0;
+  for (const AgentSupervisionNode& node : nodes) {
+    if (node.parent_ref.empty()) {
+      ++root_count;
+    } else if (node.parent_ref == external_parent && !external_parent.empty()) {
+      ++external_root_count;
+    } else if (!find_node(node.parent_ref)) {
+      return base::unexpected(
+          InvalidRequest("Supervision node references an unknown parent"));
+    }
+
+    for (const std::string& child_ref : node.child_refs) {
+      const AgentSupervisionNode* child = find_node(child_ref);
+      if (!child || child->parent_ref != node.ref) {
+        return base::unexpected(
+            InvalidRequest("Supervision parent and child references disagree"));
+      }
+    }
+    if (!node.parent_ref.empty() && node.parent_ref != external_parent) {
+      const AgentSupervisionNode* parent = find_node(node.parent_ref);
+      if (!parent ||
+          std::find(parent->child_refs.begin(), parent->child_refs.end(),
+                    node.ref) == parent->child_refs.end()) {
+        return base::unexpected(InvalidRequest(
+            "Supervision child is absent from its declared parent"));
+      }
+    }
+
+    std::set<std::string_view> lineage;
+    const AgentSupervisionNode* ancestor = &node;
+    while (ancestor) {
+      if (!lineage.insert(ancestor->ref).second) {
+        return base::unexpected(
+            InvalidRequest("Supervision node graph contains a cycle"));
+      }
+      if (ancestor->parent_ref.empty() ||
+          ancestor->parent_ref == external_parent) {
+        break;
+      }
+      ancestor = find_node(ancestor->parent_ref);
+    }
+  }
+
+  if (external_parent.empty()) {
+    if (root_count != 1 || external_root_count != 0) {
+      return base::unexpected(
+          InvalidRequest("Supervision node graph must have one root"));
+    }
+  } else if (root_count != 0 || external_root_count != 1) {
+    return base::unexpected(InvalidRequest(
+        "Inserted supervision subtree must have one external root"));
+  }
+  return base::ok();
+}
