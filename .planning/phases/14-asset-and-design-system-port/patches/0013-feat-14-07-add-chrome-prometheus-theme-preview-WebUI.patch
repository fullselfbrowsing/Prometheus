diff --git a/chrome/browser/ui/webui/prometheus/BUILD.gn b/chrome/browser/ui/webui/prometheus/BUILD.gn
new file mode 100644
index 0000000000..910a401915
--- /dev/null
+++ b/chrome/browser/ui/webui/prometheus/BUILD.gn
@@ -0,0 +1,31 @@
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# chrome://prometheus-theme-preview: a dev-only WebUI verification surface
+# (D-13). Explicitly throwaway — Phase 16 deletes or folds it into the real
+# FSB Control Panel. Modeled on chrome/browser/ui/webui/internals/BUILD.gn
+# (a small self-contained source_set that chrome/browser/ui/webui:webui
+# depends on), NOT inlined into the giant chrome/browser/ui/webui aggregate
+# source list, so this controller compiles as its own linked unit (closes
+# the HIGH review finding: "WebUI .cc not wired into a GN target").
+
+source_set("prometheus") {
+  sources = [
+    "prometheus_theme_preview_ui.cc",
+    "prometheus_theme_preview_ui.h",
+  ]
+
+  public_deps = [
+    "//chrome/common",
+    "//content/public/browser",
+  ]
+
+  deps = [
+    "//base",
+    "//chrome/browser/profiles:profile",
+    "//chrome/browser/resources/prometheus:prometheus_resources",
+    "//content/public/common",
+    "//ui/webui",
+  ]
+}
