       std::shared_ptr<std::optional<RuntimeOperationResult>> immediate_result,
       ProviderTurnRequest request,
diff --git a/chrome/browser/prometheus/prometheus_runtime_profile_service_unittest.cc b/chrome/browser/prometheus/prometheus_runtime_profile_service_unittest.cc
index 385b14a188..e3eb1a3b3b 100644
--- a/chrome/browser/prometheus/prometheus_runtime_profile_service_unittest.cc
+++ b/chrome/browser/prometheus/prometheus_runtime_profile_service_unittest.cc
@@ -889,6 +889,114 @@ TEST_F(PrometheusRuntimeProfileServiceTest,
   EXPECT_EQ(0, boundaries_.execute_route_count);
 }
 
+TEST_F(PrometheusRuntimeProfileServiceTest,
+       AutomaticFallbackRevalidatesRevokedSessionBeforeSendingRawPrompt) {
+  service_.reset();
+  const std::vector<PrometheusProviderConfig> providers = {
+      MakeProvider("primary", PrometheusProviderRouteClass::kHosted, 0),
+      MakeProvider("fallback", PrometheusProviderRouteClass::kHosted, 1)};
+  boundaries_.providers_override = providers;
+  boundaries_.fallback_order_override = providers;
+  boundaries_.defer_provider_turn = true;
+  RuntimeProfileHooks hooks = boundaries_.MakeHooks();
+  hooks.expected_caller_id = "caller-1";
+  hooks.expected_browser = browser();
+  hooks.expected_stable_tab_id = 7;
+  hooks.auto_start_tasks = true;
+  service_ =
+      std::make_unique<PrometheusRuntimeProfileService>(std::move(hooks));
+
+  ASSERT_EQ(RuntimeProfileStatus::kOk, service_->SubmitTask(Request()).status);
+  ASSERT_EQ(std::vector<std::string>({"primary"}), boundaries_.provider_ids);
+  ASSERT_EQ(1u, boundaries_.provider_requests.size());
+  EXPECT_EQ("Open the page and summarize it",
+            boundaries_.provider_requests.front().user_text);
+
+  boundaries_.session_is_valid = false;
+  boundaries_.policy.limits.max_prompt_bytes = 4;
+  ASSERT_TRUE(boundaries_.CompleteProviderTurn(
+      1, ProviderFailure(ProviderFailureKind::kNetwork)));
+
+  EXPECT_EQ(std::vector<std::string>({"primary"}), boundaries_.provider_ids);
+  EXPECT_EQ(1u, boundaries_.provider_requests.size());
+  const std::optional<RuntimeTaskSnapshot> task = service_->GetTask("task-1");
+  ASSERT_TRUE(task);
+  EXPECT_EQ(RuntimeTaskState::kCancelled, task->state);
+  EXPECT_EQ(RuntimeErrorCode::kCancelled, task->error_code);
+  EXPECT_EQ(1u, service_->finish_count_for_testing("task-1"));
+  EXPECT_EQ(0u, service_->active_session_count_for_testing());
+
+  service_->HandleAgentSessionLost("browser-issued-session");
+  EXPECT_EQ(1u, service_->finish_count_for_testing("task-1"));
+}
+
+TEST_F(PrometheusRuntimeProfileServiceTest,
+       AutomaticFallbackRevalidatesCurrentPromptLimit) {
+  service_.reset();
+  const std::vector<PrometheusProviderConfig> providers = {
+      MakeProvider("primary", PrometheusProviderRouteClass::kHosted, 0),
+      MakeProvider("fallback", PrometheusProviderRouteClass::kHosted, 1)};
+  boundaries_.providers_override = providers;
+  boundaries_.fallback_order_override = providers;
+  boundaries_.defer_provider_turn = true;
+  RuntimeProfileHooks hooks = boundaries_.MakeHooks();
+  hooks.expected_caller_id = "caller-1";
+  hooks.expected_browser = browser();
+  hooks.expected_stable_tab_id = 7;
+  hooks.auto_start_tasks = true;
+  service_ =
+      std::make_unique<PrometheusRuntimeProfileService>(std::move(hooks));
+
+  ASSERT_EQ(RuntimeProfileStatus::kOk, service_->SubmitTask(Request()).status);
+  boundaries_.policy.limits.max_prompt_bytes = 4;
+  ASSERT_TRUE(boundaries_.CompleteProviderTurn(
+      1, ProviderFailure(ProviderFailureKind::kServer)));
+
+  EXPECT_EQ(std::vector<std::string>({"primary"}), boundaries_.provider_ids);
+  EXPECT_EQ(1u, boundaries_.provider_requests.size());
+  const std::optional<RuntimeTaskSnapshot> task = service_->GetTask("task-1");
+  ASSERT_TRUE(task);
+  EXPECT_EQ(RuntimeTaskState::kFailed, task->state);
+  EXPECT_EQ(RuntimeErrorCode::kRequestTooLarge, task->error_code);
+  EXPECT_EQ(1u, service_->finish_count_for_testing("task-1"));
+}
+
+TEST_F(PrometheusRuntimeProfileServiceTest,
+       AutomaticFallbackRequiresUnchangedProviderConfiguration) {
+  service_.reset();
+  const PrometheusProviderConfig primary =
+      MakeProvider("primary", PrometheusProviderRouteClass::kHosted, 0);
+  PrometheusProviderConfig fallback =
+      MakeProvider("fallback", PrometheusProviderRouteClass::kHosted, 1);
+  fallback.canonical_endpoint = "https://first.example.test/v1";
+  boundaries_.providers_override =
+      std::vector<PrometheusProviderConfig>{primary, fallback};
+  boundaries_.fallback_order_override = boundaries_.providers_override;
+  boundaries_.defer_provider_turn = true;
+  RuntimeProfileHooks hooks = boundaries_.MakeHooks();
+  hooks.expected_caller_id = "caller-1";
+  hooks.expected_browser = browser();
+  hooks.expected_stable_tab_id = 7;
+  hooks.auto_start_tasks = true;
+  service_ =
+      std::make_unique<PrometheusRuntimeProfileService>(std::move(hooks));
+
+  ASSERT_EQ(RuntimeProfileStatus::kOk, service_->SubmitTask(Request()).status);
+  fallback.canonical_endpoint = "https://changed.example.test/v1";
+  boundaries_.providers_override =
+      std::vector<PrometheusProviderConfig>{primary, fallback};
+  ASSERT_TRUE(boundaries_.CompleteProviderTurn(
+      1, ProviderFailure(ProviderFailureKind::kServer)));
+
+  EXPECT_EQ(std::vector<std::string>({"primary"}), boundaries_.provider_ids);
+  EXPECT_EQ(1u, boundaries_.provider_requests.size());
+  const std::optional<RuntimeTaskSnapshot> task = service_->GetTask("task-1");
+  ASSERT_TRUE(task);
+  EXPECT_EQ(RuntimeTaskState::kFailed, task->state);
+  EXPECT_EQ(RuntimeErrorCode::kProviderUnavailable, task->error_code);
+  EXPECT_EQ(1u, service_->finish_count_for_testing("task-1"));
+}
+
 TEST_F(PrometheusRuntimeProfileServiceTest,
        TaskAdmissionDoesNotReapplyTheAgentSessionCap) {
   boundaries_.policy.limits.max_concurrent_tasks = 1;
