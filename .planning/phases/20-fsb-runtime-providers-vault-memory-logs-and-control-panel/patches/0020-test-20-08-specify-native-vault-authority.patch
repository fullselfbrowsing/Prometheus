+  PrometheusVaultUseOrigin origin = PrometheusVaultUseOrigin::kBrowserUi;
+};
+
+// Native-only confirmation state. The renderer and MCP receive only a closed
+// PrometheusVaultStatus and never this binding or an approval token.
+struct PrometheusVaultConfirmationBinding {
+  std::string caller_id;
+  raw_ptr<Profile> profile = nullptr;
+  raw_ptr<BrowserWindowInterface> browser = nullptr;
+  int32_t window_session_id = 0;
+  tabs::TabHandle tab_handle;
