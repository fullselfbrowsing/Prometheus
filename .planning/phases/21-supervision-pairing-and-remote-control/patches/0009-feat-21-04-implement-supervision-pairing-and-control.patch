+void PrometheusSupervisionProfileService::ReleaseObservedTabIfUnused(
+    int32_t stable_tab_id) {
+  auto observed = observed_tabs_.find(stable_tab_id);
+  if (observed == observed_tabs_.end()) {
+    return;
+  }
+  auto pairing = pending_pairings_.find(stable_tab_id);
+  if ((pairing != pending_pairings_.end() &&
+       pairing->second->state == SupervisionPairingState::kPending) ||
+      viewer_count_for_testing(stable_tab_id) != 0) {
+    return;
+  }
+  observed_tabs_.erase(observed);
+}
