+std::optional<SupervisionActionAuthoritySnapshot>
+PrometheusSupervisionProfileService::ResolveActionAuthority(
+    const base::UnguessableToken& dashboard_session) {
+  if (shutdown_) {
+    return std::nullopt;
+  }
+  auto viewer = viewers_.find(dashboard_session);
+  if (viewer == viewers_.end() || !ResolveExactTarget(*viewer->second)) {
+    return std::nullopt;
+  }
+  auto observed = observed_tabs_.find(viewer->second->stable_tab_id);
+  CaptureHubEntry* capture_hub = FindCaptureHub(*viewer->second);
+  if (observed == observed_tabs_.end() || !observed->second->lease.data() ||
+      !capture_hub || !capture_hub->hub ||
+      !viewer->second->capture_consumer_token.has_value()) {
+    return std::nullopt;
+  }
+  std::optional<SupervisionCaptureBaselineDelivery> current =
+      capture_hub->hub->ReadCurrentBaseline(
+          *viewer->second->capture_consumer_token);
+  if (!current.has_value()) {
+    return std::nullopt;
+  }
+
+  SupervisionActionAuthoritySnapshot authority;
+  authority.profile = profile_;
+  authority.exact_browser = viewer->second->exact_browser.get();
+  authority.stable_tab = viewer->second->tab->GetHandle();
+  authority.live_owner_session_id =
+      std::string(observed->second->lease.data()->owner_session_id());
+  auto controller = controllers_.find(viewer->second->stable_tab_id);
+  if (controller != controllers_.end()) {
+    authority.active_controller_session = controller->second;
+  }
+  authority.controller_lease = viewer->second->controller_lease;
+  authority.document_epoch = current->stamp.document_epoch;
+  authority.sequence = current->stamp.sequence;
+  authority.authority_generation = viewer->second->authority_generation;
+  authority.stream_live =
+      viewer->second->stream_state == SupervisionStreamState::kLive &&
+      viewer->second->last_acknowledged_stamp.has_value() &&
+      *viewer->second->last_acknowledged_stamp == current->stamp &&
+      !capture_hub->hub->ConsumerNeedsBaseline(
+          *viewer->second->capture_consumer_token);
+  return authority;
+}
+
+void PrometheusSupervisionProfileService::OnDashboardActionCompleted(
+    const base::UnguessableToken& dashboard_session,
+    SupervisionRemoteActionCategory category,
+    const SupervisionActionResult& result) {
+  auto viewer = viewers_.find(dashboard_session);
+  if (viewer == viewers_.end()) {
+    return;
+  }
+  viewer->second->action_state = result.state;
+  viewer->second->action_category = category;
+  AddAudit(viewer->second->stable_tab_id,
+           result.ok ? SupervisionAuditEvent::kRemoteActionCompleted
+                     : SupervisionAuditEvent::kRemoteActionBlocked,
+           std::optional<std::string>(viewer->second->client_label),
+           result.error_code, category, result.duration);
+  NotifySnapshotChanged(viewer->second->stable_tab_id);
+}
