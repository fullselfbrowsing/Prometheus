+bool PrometheusSupervisionTestComposition::ObservePairingRedeemedForExactTarget(
+    uint64_t profile_identity,
+    int32_t stable_tab_id) {
+  if (!bootstrap_ ||
+      !bootstrap_->ObservePairingRedeemedForExactTarget(
+          next_redemption_sequence_, profile_identity, stable_tab_id)) {
+    return false;
+  }
+  ++next_redemption_sequence_;
+  return true;
+}
