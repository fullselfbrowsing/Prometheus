+// Move-only observation authority for Agent-owned tab data. The lease never
+// owns the tab data and resolves it through the Agent service on every access.
+// Agent shutdown or tab destruction invalidates the opaque token first, making
+// late access and destruction no-ops.
+class PrometheusAgentTabObservationLease {
+ public:
+  PrometheusAgentTabObservationLease();
+  PrometheusAgentTabObservationLease(
+      PrometheusAgentTabObservationLease&& other) noexcept;
+  PrometheusAgentTabObservationLease& operator=(
+      PrometheusAgentTabObservationLease&& other) noexcept;
+  PrometheusAgentTabObservationLease(
+      const PrometheusAgentTabObservationLease&) = delete;
+  PrometheusAgentTabObservationLease& operator=(
+      const PrometheusAgentTabObservationLease&) = delete;
+  ~PrometheusAgentTabObservationLease();
+
+  PrometheusAgentTabData* data() const;
+  explicit operator bool() const { return data() != nullptr; }
+  void Reset();
+
+ private:
+  friend class PrometheusAgentService;
+
+  PrometheusAgentTabObservationLease(
+      base::WeakPtr<PrometheusAgentService> service,
+      uint64_t token);
+
+  base::WeakPtr<PrometheusAgentService> service_;
+  uint64_t token_ = 0;
+};
 
