+bool HasOnlyToolArgumentKeys(const base::DictValue& arguments,
+                             std::initializer_list<std::string_view> allowed) {
+  for (const auto [key, ignored] : arguments) {
+    static_cast<void>(ignored);
+    if (std::find(allowed.begin(), allowed.end(), key) == allowed.end()) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool IsBoundedToolString(const std::string* value,
+                         size_t max_bytes,
+                         bool allow_empty = false) {
+  return value && (allow_empty || !value->empty()) &&
+         value->size() <= max_bytes && base::IsStringUTF8(*value);
+}
+
+ProviderToolDefinition BasicToolDefinition(RuntimeSafeTool tool) {
+  const auto string_property = [](size_t max_length, bool allow_empty = false) {
+    base::DictValue property;
+    property.Set("type", "string");
+    if (!allow_empty) {
+      property.Set("minLength", 1);
+    }
+    property.Set("maxLength", static_cast<int>(max_length));
+    return property;
+  };
+  const auto integer_property = [](int minimum, int maximum) {
+    base::DictValue property;
+    property.Set("type", "integer");
+    property.Set("minimum", minimum);
+    property.Set("maximum", maximum);
+    return property;
+  };
+  base::DictValue properties;
+  base::ListValue required;
+  if (tool == RuntimeSafeTool::kReadPage ||
+      tool == RuntimeSafeTool::kGetPageSnapshot) {
+    properties.Set("max_chars",
+                   integer_property(/*minimum=*/1, kMaxRuntimeToolReadChars));
+    properties.Set("max_nodes",
+                   integer_property(/*minimum=*/1, kMaxRuntimeToolReadNodes));
+    base::DictValue compact;
+    compact.Set("type", "boolean");
+    properties.Set("compact", std::move(compact));
+  } else {
+    properties.Set("element_ref",
+                   string_property(kMaxRuntimeToolElementRefBytes));
+    required.Append("element_ref");
+    switch (tool) {
+      case RuntimeSafeTool::kTypeText:
+        properties.Set("text", string_property(kMaxRuntimeToolTextBytes,
+                                               /*allow_empty=*/true));
+        required.Append("text");
+        break;
+      case RuntimeSafeTool::kPressKey:
+        properties.Set("key", string_property(kMaxRuntimeToolKeyBytes));
+        required.Append("key");
+        break;
+      case RuntimeSafeTool::kScroll:
+        properties.Set("scroll_delta_x",
+                       integer_property(std::numeric_limits<int>::min(),
+                                        std::numeric_limits<int>::max()));
+        properties.Set("scroll_delta_y",
+                       integer_property(std::numeric_limits<int>::min(),
+                                        std::numeric_limits<int>::max()));
+        required.Append("scroll_delta_y");
+        break;
+      case RuntimeSafeTool::kSelectOption:
+        properties.Set("option_value",
+                       string_property(kMaxRuntimeToolElementRefBytes));
+        required.Append("option_value");
+        break;
+      case RuntimeSafeTool::kReadPage:
+      case RuntimeSafeTool::kGetPageSnapshot:
+        NOTREACHED();
+      case RuntimeSafeTool::kClick:
+      case RuntimeSafeTool::kHover:
+      case RuntimeSafeTool::kClear:
+        break;
+    }
+  }
+  ProviderToolDefinition definition;
+  definition.name = NameForSafeTool(tool);
+  definition.description = "Closed browser-owned page operation";
+  definition.input_schema.Set("type", "object");
+  definition.input_schema.Set("properties", std::move(properties));
+  definition.input_schema.Set("required", std::move(required));
+  definition.input_schema.Set("additionalProperties", false);
+  return definition;
+}
+
+std::optional<AgentRouteRequest> RouteForProviderToolCall(
+    RuntimeSafeTool tool,
+    const base::DictValue& arguments) {
+  AgentRouteRequest route;
+  route.route_name = RouteForSafeTool(tool);
+  route.foreground = true;
+
+  if (tool == RuntimeSafeTool::kReadPage ||
+      tool == RuntimeSafeTool::kGetPageSnapshot) {
+    if (!HasOnlyToolArgumentKeys(arguments,
+                                 {"max_chars", "max_nodes", "compact"})) {
+      return std::nullopt;
+    }
+    std::optional<int> max_chars = arguments.FindInt("max_chars");
+    std::optional<int> max_nodes = arguments.FindInt("max_nodes");
+    std::optional<bool> compact = arguments.FindBool("compact");
+    if ((arguments.contains("max_chars") && !max_chars) ||
+        (arguments.contains("max_nodes") && !max_nodes) ||
+        (arguments.contains("compact") && !compact) ||
+        (max_chars &&
+         (*max_chars < 1 || *max_chars > kMaxRuntimeToolReadChars)) ||
+        (max_nodes &&
+         (*max_nodes < 1 || *max_nodes > kMaxRuntimeToolReadNodes))) {
+      return std::nullopt;
+    }
+    route.page_request.emplace();
+    if (max_chars) {
+      route.page_request->read_options.max_chars =
+          static_cast<size_t>(*max_chars);
+    }
+    if (max_nodes) {
+      route.page_request->read_options.max_nodes =
+          static_cast<size_t>(*max_nodes);
+    }
+    route.page_request->read_options.compact = compact.value_or(false);
+    return route;
+  }
+
+  const std::string* element_ref = arguments.FindString("element_ref");
+  if (!IsBoundedToolString(element_ref, kMaxRuntimeToolElementRefBytes)) {
+    return std::nullopt;
+  }
+  route.page_request.emplace();
+  route.page_request->action.element.element_ref = *element_ref;
+  route.page_request->verify_mutation = true;
+
+  switch (tool) {
+    case RuntimeSafeTool::kClick:
+    case RuntimeSafeTool::kHover:
+    case RuntimeSafeTool::kClear:
+      if (!HasOnlyToolArgumentKeys(arguments, {"element_ref"})) {
+        return std::nullopt;
+      }
+      break;
+    case RuntimeSafeTool::kTypeText: {
+      if (!HasOnlyToolArgumentKeys(arguments, {"element_ref", "text"})) {
+        return std::nullopt;
+      }
+      const std::string* text = arguments.FindString("text");
+      if (!IsBoundedToolString(text, kMaxRuntimeToolTextBytes,
+                               /*allow_empty=*/true)) {
+        return std::nullopt;
+      }
+      route.page_request->action.text = *text;
+      break;
+    }
+    case RuntimeSafeTool::kPressKey: {
+      if (!HasOnlyToolArgumentKeys(arguments, {"element_ref", "key"})) {
+        return std::nullopt;
+      }
+      const std::string* key = arguments.FindString("key");
+      if (!IsBoundedToolString(key, kMaxRuntimeToolKeyBytes)) {
+        return std::nullopt;
+      }
+      route.page_request->action.key = *key;
+      break;
+    }
+    case RuntimeSafeTool::kScroll: {
+      if (!HasOnlyToolArgumentKeys(
+              arguments, {"element_ref", "scroll_delta_x", "scroll_delta_y"})) {
+        return std::nullopt;
+      }
+      std::optional<int> delta_x = arguments.FindInt("scroll_delta_x");
+      std::optional<int> delta_y = arguments.FindInt("scroll_delta_y");
+      if ((arguments.contains("scroll_delta_x") && !delta_x) ||
+          (arguments.contains("scroll_delta_y") && !delta_y) ||
+          (!delta_x && !delta_y)) {
+        return std::nullopt;
+      }
+      route.page_request->action.scroll_delta_x = delta_x;
+      route.page_request->action.scroll_delta_y = delta_y;
+      break;
+    }
+    case RuntimeSafeTool::kSelectOption: {
+      if (!HasOnlyToolArgumentKeys(arguments,
+                                   {"element_ref", "option_value"})) {
+        return std::nullopt;
+      }
+      const std::string* option_value = arguments.FindString("option_value");
+      if (!IsBoundedToolString(option_value, kMaxRuntimeToolElementRefBytes)) {
+        return std::nullopt;
+      }
+      route.page_request->action.option_value = *option_value;
+      break;
+    }
+    case RuntimeSafeTool::kReadPage:
+    case RuntimeSafeTool::kGetPageSnapshot:
+      NOTREACHED();
+  }
+  return route;
+}
