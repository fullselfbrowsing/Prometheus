@@ -0,0 +1,111 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PROMETHEUS_PROMETHEUS_AGENT_GATEWAY_CONTRACT_H_
+#define CHROME_BROWSER_PROMETHEUS_PROMETHEUS_AGENT_GATEWAY_CONTRACT_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+#include "base/functional/callback.h"
+#include "chrome/browser/prometheus/prometheus_supervision_transport_codec.h"
+
+namespace net {
+class HttpServerRequestInfo;
+}
+
+namespace prometheus {
+
+enum class PrometheusAgentRequestRejection {
+  kNone,
+  kUnauthorized,
+  kNonLoopbackPeer,
+  kInvalidHost,
+  kOriginForbidden,
+  kNotFound,
+  kMethodNotAllowed,
+  kUnsupportedMediaType,
+  kRequestTooLarge,
+  kTooManyRequests,
+};
+
+PrometheusAgentRequestRejection ValidatePrometheusAgentGatewayRequestForTesting(
+    const net::HttpServerRequestInfo& request,
+    int port,
+    std::string_view bearer,
+    size_t in_flight);
+
+class PrometheusAgentOneShotCompletion {
+ public:
+  explicit PrometheusAgentOneShotCompletion(base::OnceClosure completion);
+  PrometheusAgentOneShotCompletion(const PrometheusAgentOneShotCompletion&) =
+      delete;
+  PrometheusAgentOneShotCompletion& operator=(
+      const PrometheusAgentOneShotCompletion&) = delete;
+  ~PrometheusAgentOneShotCompletion();
+
+  bool TryComplete();
+
+ private:
+  base::OnceClosure completion_;
+};
+
+// A gateway-owned transport token. It identifies only the lifetime of one
+// authenticated HTTP request and carries no profile, target, viewer, or stream
+// authority.
+struct SupervisionGatewayCancellationToken {
+  uint64_t value = 0;
+
+  explicit operator bool() const { return value != 0; }
+  friend bool operator==(const SupervisionGatewayCancellationToken&,
+                         const SupervisionGatewayCancellationToken&) = default;
+};
+
+struct SupervisionGatewayRequest {
+  SupervisionTransportRequest transport;
+  SupervisionGatewayCancellationToken cancellation_token;
+};
+
+struct SupervisionGatewayResult {
+  SupervisionTransportResult transport;
+};
+
+enum class SupervisionGatewayReadinessStatus {
+  kReady,
+  kDegraded,
+  kNotReady,
+  kUnavailable,
+};
+
+// This is deliberately metadata-only. Callers must supply fixed, bounded
+// diagnostics and may not attach arbitrary dictionaries or authority values.
+struct SupervisionGatewayReadiness {
+  SupervisionGatewayReadinessStatus status =
+      SupervisionGatewayReadinessStatus::kNotReady;
+  std::string reason;
+  std::string next_action;
+};
+
+// Dependency-neutral gateway seam. The browser composition root installs the
+// concrete regular-profile adapter; the gateway itself never resolves a
+// profile service, Browser, tab, capture owner, renderer, or transport owner.
+class SupervisionGatewayDispatcher {
+ public:
+  using ResultCallback =
+      base::OnceCallback<void(SupervisionGatewayResult result)>;
+
+  virtual ~SupervisionGatewayDispatcher() = default;
+
+  virtual void Dispatch(SupervisionGatewayRequest request,
+                        ResultCallback callback) = 0;
+  virtual void Cancel(SupervisionGatewayCancellationToken token) = 0;
+  virtual SupervisionGatewayReadiness GetSanitizedReadiness() const = 0;
+  virtual void CancelAllAndShutdown() = 0;
+};
+
+}  // namespace prometheus
+
+#endif  // CHROME_BROWSER_PROMETHEUS_PROMETHEUS_AGENT_GATEWAY_CONTRACT_H_
