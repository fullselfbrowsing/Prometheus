+TEST_F(PrometheusSupervisionTestBootstrapTest,
+       EveryDenialAndTerminalPathClearsSensitiveBuffersExactlyOnce) {
+  ASSERT_TRUE(CreateReadyAndClearZeroization());
+  HandoffResponse wrong_challenge =
+      Dispatch(std::string(kPrometheusSupervisionTestChallengeBytes, 'a'),
+               "owner-session", 1);
+  ASSERT_TRUE(wrong_challenge.result);
+  EXPECT_EQ(SupervisionTestHandoffStatus::kDenied,
+            wrong_challenge.result->status);
+  EXPECT_EQ(1u, ZeroizationCount("request_challenge"));
+  EXPECT_EQ(1u, ZeroizationCount("request_session_id"));
+  EXPECT_EQ(0u, ZeroizationCount("challenge"));
+  EXPECT_FALSE(bootstrap_->is_terminal_for_testing());
+
+  current_binding_.owner_session_id = "replacement-owner";
+  HandoffResponse owner_lost = Dispatch(kChallenge, "owner-session", 1);
+  ASSERT_TRUE(owner_lost.result);
+  EXPECT_EQ(SupervisionTestHandoffStatus::kTargetLost,
+            owner_lost.result->status);
+  ExpectTerminalBuffersClearedExactlyOnce();
+  bootstrap_->Shutdown();
+  ExpectTerminalBuffersClearedExactlyOnce();
+
+  current_binding_.owner_session_id = "owner-session";
+  ASSERT_TRUE(CreateReadyAndClearZeroization());
+  now_ += kPrometheusSupervisionTestHandoffTtl + base::Milliseconds(1);
+  HandoffResponse expired = Dispatch(kChallenge, "owner-session", 1);
+  ASSERT_TRUE(expired.result);
+  EXPECT_EQ(SupervisionTestHandoffStatus::kExpired, expired.result->status);
+  ExpectTerminalBuffersClearedExactlyOnce();
+
+  now_ = base::TimeTicks() + base::Seconds(10);
+  ASSERT_TRUE(CreateReadyAndClearZeroization());
+  SupervisionTestHandoffDispatcher unbound =
+      bootstrap_->CreateGatewayDispatcher();
+  unbound.shutdown.Run();
+  unbound.shutdown.Run();
+  EXPECT_TRUE(bootstrap_->is_terminal_for_testing());
+  ExpectTerminalBuffersClearedExactlyOnce();
+
+  ASSERT_TRUE(CreateReadyAndClearZeroization());
+  bootstrap_->Shutdown();
+  bootstrap_->Shutdown();
+  ExpectTerminalBuffersClearedExactlyOnce();
+
+  ASSERT_TRUE(CreateReadyAndClearZeroization());
+  for (int attempt = 0; attempt < kMaxPrometheusSupervisionTestHandoffAttempts;
+       ++attempt) {
+    HandoffResponse denial =
+        Dispatch(std::string(kPrometheusSupervisionTestChallengeBytes, 'f'),
