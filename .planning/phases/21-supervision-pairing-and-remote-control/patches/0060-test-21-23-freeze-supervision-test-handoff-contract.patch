+  std::optional<std::string> Read(const base::FilePath&, size_t max_bytes) {
+    ++read_calls_;
+    last_max_bytes_ = max_bytes;
+    return read_succeeds_ ? std::optional(contents_) : std::nullopt;
+  }
+
+  std::optional<PrometheusSupervisionTestBindingFacts> GetBinding() {
+    ++binding_calls_;
+    return binding_available_ ? std::optional(current_binding_) : std::nullopt;
+  }
+
+  std::optional<std::string> CreatePairingCode() {
+    ++create_code_calls_;
+    return create_code_succeeds_
+               ? std::optional(create_code_calls_ == 1 ? "ABCD-EFGH"
+                                                       : "JKLM-NPQR")
+               : std::nullopt;
+  }
+
+  void ObserveZeroization(std::string_view buffer_name, size_t bytes_cleared) {
+    zeroized_.emplace_back(buffer_name, bytes_cleared);
+  }
+
+  PrometheusSupervisionTestBootstrapResult Create(
+      const base::CommandLine& command_line,
+      bool official_build = false,
+      PrometheusSupervisionTestBootstrapProfileFacts profile = {
+          .is_regular_profile = true,
+          .is_disposable_profile = true,
+          .is_off_the_record = false}) {
+    return PrometheusSupervisionTestBootstrap::Create(
+        command_line, official_build, profile, access_,
+        base::BindRepeating(&PrometheusSupervisionTestBootstrapTest::GetBinding,
+                            base::Unretained(this)),
+        base::BindRepeating(
+            &PrometheusSupervisionTestBootstrapTest::CreatePairingCode,
+            base::Unretained(this)),
+        base::BindRepeating(
+            [](PrometheusSupervisionTestBootstrapTest* test) {
+              return test->now_;
+            },
+            base::Unretained(this)),
+        base::BindRepeating(
+            &PrometheusSupervisionTestBootstrapTest::ObserveZeroization,
+            base::Unretained(this)),
+        &bootstrap_);
+  }
+
+  HandoffResponse Dispatch(std::string challenge,
+                           std::string session_id,
+                           int sequence) {
+    HandoffResponse response;
+    SupervisionTestHandoffDispatcher dispatcher =
+        bootstrap_->CreateGatewayDispatcher();
+    dispatcher.dispatch.Run(
+        SupervisionTestHandoffRequest(std::move(challenge),
+                                      std::move(session_id), sequence),
+        base::BindOnce(
+            [](HandoffResponse* output, SupervisionTestHandoffResult result) {
+              ++output->callbacks;
+              output->result.emplace(std::move(result));
+            },
+            &response));
+    return response;
+  }
+
+  void SetContents(std::string contents) {
+    contents_ = std::move(contents);
+    facts_.size = static_cast<int64_t>(contents_.size());
+  }
+
+  PrometheusSupervisionTestBootstrapFileFacts facts_;
+  PrometheusSupervisionTestBootstrapFileAccess access_;
+  PrometheusSupervisionTestBindingFacts current_binding_;
+  std::unique_ptr<PrometheusSupervisionTestBootstrap> bootstrap_;
+  std::string contents_;
+  base::TimeTicks now_ = base::TimeTicks() + base::Seconds(10);
+  std::vector<std::pair<std::string, size_t>> zeroized_;
+  bool inspect_succeeds_ = true;
+  bool read_succeeds_ = true;
+  bool binding_available_ = true;
+  bool create_code_succeeds_ = true;
+  int inspect_calls_ = 0;
+  int read_calls_ = 0;
+  int binding_calls_ = 0;
+  int create_code_calls_ = 0;
+  size_t last_max_bytes_ = 0;
+};
