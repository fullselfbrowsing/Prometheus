@@ -379,6 +379,55 @@ TEST(PrometheusExtensionPolicyServiceTest,
   EXPECT_LE(health.recovery.size(), kMaxExtensionPolicyRecoveryBytes);
 }
 
+TEST(PrometheusExtensionPolicyServiceTest,
+     FreshIdentityAndActiveStateAreRevalidatedBeforeMutation) {
+  RequireGreenContract();
+  sync_preferences::TestingPrefServiceSyncable prefs;
+  RegisterPrometheusExtensionPolicyProfilePrefs(prefs.registry());
+  PrometheusExtensionPolicyService service(nullptr, &prefs, nullptr);
+  service.SetInventoryForTesting({MakeInventoryEntry(kFirstExtensionId)});
+  service.SetSystemReadyForTesting(true);
+
+  ExtensionPolicySnapshot snapshot = service.GetSnapshot();
+  EXPECT_EQ(kFirstExtensionId,
+            service.ResolveExtensionIdForMutation(0, snapshot.generation));
+  EXPECT_EQ(std::nullopt,
+            service.ResolveExtensionIdForMutation(0,
+                                                  snapshot.generation + 1u));
+  EXPECT_EQ(
+      ExtensionPolicyMutationResult::kMissingExtension,
+      service.SetRequestedGrantForExtension(
+          0, snapshot.generation, kSecondExtensionId,
+          /*private_mode=*/false, ExtensionAgentGrant::kInteract));
+  EXPECT_TRUE(ReadPrometheusExtensionPolicyChoices(prefs).empty());
+
+  ExtensionPolicyInventoryEntry inactive =
+      MakeInventoryEntry(kFirstExtensionId);
+  inactive.enabled = false;
+  inactive.ready = false;
+  service.SetInventoryForTesting({std::move(inactive)});
+  service.ReconcileForTesting();
+  snapshot = service.GetSnapshot();
+  EXPECT_EQ(
+      ExtensionPolicyMutationResult::kInactiveExtension,
+      service.SetRequestedGrantForExtension(
+          0, snapshot.generation, kFirstExtensionId,
+          /*private_mode=*/false, ExtensionAgentGrant::kInteract));
+  EXPECT_TRUE(ReadPrometheusExtensionPolicyChoices(prefs).empty());
+
+  service.SetInventoryForTesting({MakeInventoryEntry(kFirstExtensionId)});
+  service.ReconcileForTesting();
+  snapshot = service.GetSnapshot();
+  EXPECT_EQ(
+      ExtensionPolicyMutationResult::kApplied,
+      service.SetRequestedGrantForExtension(
+          0, snapshot.generation, kFirstExtensionId,
+          /*private_mode=*/false, ExtensionAgentGrant::kInteract));
+  EXPECT_EQ(ExtensionAgentGrant::kInteract,
+            service.GetEffectiveGrant(kFirstExtensionId, nullptr,
+                                      /*private_mode=*/false));
+}
+
 TEST(PrometheusExtensionPolicySnapshotTest,
      SanitizedRowsOmitFullIdsContentPermissionsAndAuthority) {
   RequireGreenContract();
