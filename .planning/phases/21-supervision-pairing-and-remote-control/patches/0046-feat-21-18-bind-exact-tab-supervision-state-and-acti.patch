+SupervisionServiceResult
+PrometheusSupervisionProfileService::StopControlForSelectedTab(
+    BrowserWindowInterface* exact_browser,
+    tabs::TabInterface* exact_tab) {
+  if (shutdown_) {
+    return UnavailableResult();
+  }
+  SweepExpired();
+  if (!IsEligibleTarget(profile_, exact_browser, exact_tab) ||
+      exact_browser->GetActiveTabInterface() != exact_tab) {
+    return ServiceFailure(
+        SupervisionErrorCode::kStaleTarget,
+        "The selected supervision target is no longer live",
+        "Select the intended supervised tab in this window and retry");
+  }
+
+  const int32_t stable_tab_id = exact_tab->GetHandle().raw_value();
+  auto controller = controllers_.find(stable_tab_id);
+  if (controller == controllers_.end()) {
+    return ServiceFailure(SupervisionErrorCode::kViewOnly,
+                          "This tab is already view-only",
+                          "Refresh the selected-tab supervision state");
+  }
+  const base::UnguessableToken dashboard_session = controller->second;
+  auto viewer = viewers_.find(dashboard_session);
+  if (viewer == viewers_.end() ||
+      viewer->second->stable_tab_id != stable_tab_id ||
+      viewer->second->exact_browser.get() != exact_browser ||
+      ResolveExactTarget(*viewer->second) != exact_tab) {
+    return ServiceFailure(
+        SupervisionErrorCode::kStaleTarget,
+        "The active controller no longer matches the selected tab",
+        "Refresh the selected-tab supervision state");
+  }
+  if (!RevalidateViewerOwner(dashboard_session)) {
+    return ServiceFailure(
+        SupervisionErrorCode::kViewOnly,
+        "Control ended because the Agent owner is no longer live",
+        "Create a new supervised session from the intended tab");
+  }
+  viewer = viewers_.find(dashboard_session);
+  if (viewer == viewers_.end() ||
+      viewer->second->stable_tab_id != stable_tab_id ||
+      viewer->second->exact_browser.get() != exact_browser ||
+      ResolveExactTarget(*viewer->second) != exact_tab) {
+    return ServiceFailure(
+        SupervisionErrorCode::kStaleTarget,
+        "The selected supervision authority changed before stop",
+        "Refresh the selected-tab supervision state");
+  }
+  return StopControl(dashboard_session);
+}
+
+SupervisionServiceResult
+PrometheusSupervisionProfileService::OpenManagementForSelectedTab(
+    BrowserWindowInterface* exact_browser,
+    tabs::TabInterface* exact_tab) {
+  if (shutdown_ || profile_kind_ != SupervisionProfileKind::kRegular) {
+    return UnavailableResult();
+  }
+  if (!IsEligibleTarget(profile_, exact_browser, exact_tab) ||
+      exact_browser->GetActiveTabInterface() != exact_tab) {
+    return ServiceFailure(
+        SupervisionErrorCode::kStaleTarget,
+        "The selected supervision target is no longer live",
+        "Select the intended tab in this window and retry");
+  }
+  if (!local_ui_opener_.Run(
+          exact_browser, GURL(chrome::kChromeUIPrometheusControlPanelURL))) {
+    return ServiceFailure(
+        SupervisionErrorCode::kStaleTarget,
+        "The supervision Control Panel could not be opened",
+        "Retry from the live browser window");
+  }
+  return SupervisionServiceResult::Success();
+}
