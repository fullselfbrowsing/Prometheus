diff --git a/chrome/browser/prometheus/prometheus_supervision_capture_hub.h b/chrome/browser/prometheus/prometheus_supervision_capture_hub.h
index e6cc99bb7d..417f408bb9 100644
--- a/chrome/browser/prometheus/prometheus_supervision_capture_hub.h
+++ b/chrome/browser/prometheus/prometheus_supervision_capture_hub.h
@@ -35,7 +35,10 @@ enum class SupervisionCaptureConsumerKind {
   kAgentCompatibility,
 };
 
-using SupervisionCaptureConsumerId = uint64_t;
+// Opaque browser-only handle. It is meaningful only to the hub that issued it
+// and is never serialized as dashboard authority.
+using CaptureConsumerToken = uint64_t;
+using SupervisionCaptureConsumerId = CaptureConsumerToken;
 
 // Consumer-facing deliveries carry only browser-created stream stamps and
 // privacy-filtered projection output. Mojo endpoints and renderer identity are
diff --git a/chrome/browser/prometheus/prometheus_supervision_capture_hub_unittest.cc b/chrome/browser/prometheus/prometheus_supervision_capture_hub_unittest.cc
index ad70f3352c..2ca37066a1 100644
--- a/chrome/browser/prometheus/prometheus_supervision_capture_hub_unittest.cc
+++ b/chrome/browser/prometheus/prometheus_supervision_capture_hub_unittest.cc
@@ -311,5 +311,72 @@ TEST_F(PrometheusSupervisionCaptureHubTest,
   EXPECT_EQ(1u, hub->capture_count_for_testing());
 }
 
+TEST_F(PrometheusSupervisionCaptureHubTest,
+       DashboardConsumersShareCaptureAndAckIndependently) {
+  auto hub = CreateHub();
+  const auto first = hub->AttachConsumer(
+      SupervisionCaptureConsumerKind::kDashboard, now_ + base::Minutes(10));
+  const auto second = hub->AttachConsumer(
+      SupervisionCaptureConsumerKind::kDashboard, now_ + base::Minutes(10));
+  ASSERT_TRUE(first.has_value());
+  ASSERT_TRUE(second.has_value());
+  EXPECT_EQ(1u, hub->enable_count_for_testing());
+  EXPECT_EQ(1u, hub->capture_count_for_testing());
+
+  capture_source_.CompleteNext(MakeBaseline("shared baseline"));
+  const auto first_baseline = hub->ReadBaseline(*first);
+  const auto second_baseline = hub->ReadBaseline(*second);
+  ASSERT_TRUE(first_baseline.has_value());
+  ASSERT_TRUE(second_baseline.has_value());
+  EXPECT_EQ(first_baseline->baseline, second_baseline->baseline);
+  EXPECT_NE(first_baseline->stamp.session, second_baseline->stamp.session);
+  ASSERT_TRUE(hub->Ack(*first, first_baseline->stamp));
+  ASSERT_TRUE(hub->Ack(*second, second_baseline->stamp));
+
+  hub->NotifyDirtyForTesting(/*overflow=*/false);
+  capture_source_.CompleteNext(MakeBaseline("shared mutation"));
+  const auto first_diff = hub->ReadNext(*first);
+  const auto second_diff = hub->ReadNext(*second);
+  ASSERT_TRUE(first_diff.has_value());
+  ASSERT_TRUE(second_diff.has_value());
+  EXPECT_EQ(first_diff->diff, second_diff->diff);
+  ASSERT_TRUE(hub->Ack(*first, first_diff->stamp));
+  EXPECT_FALSE(hub->ReadNext(*first).has_value());
+  ASSERT_TRUE(hub->ReadNext(*second).has_value());
+  EXPECT_EQ(second_diff->stamp.sequence,
+            hub->ReadNext(*second)->stamp.sequence);
+}
+
+TEST_F(PrometheusSupervisionCaptureHubTest,
+       DashboardLagResyncAndRevocationRemainConsumerLocal) {
+  SupervisionLimits limits;
+  limits.retained_batches = 1;
+  auto hub = CreateHub(limits);
+  const auto lagging = hub->AttachConsumer(
+      SupervisionCaptureConsumerKind::kDashboard, now_ + base::Minutes(10));
+  const auto current = hub->AttachConsumer(
+      SupervisionCaptureConsumerKind::kDashboard, now_ + base::Minutes(10));
+  ASSERT_TRUE(lagging.has_value());
+  ASSERT_TRUE(current.has_value());
+  CompleteAndAckBaseline(*hub, *lagging, *current);
+
+  hub->NotifyDirtyForTesting(/*overflow=*/false);
+  capture_source_.CompleteNext(MakeBaseline("first mutation"));
+  const auto current_first = hub->ReadNext(*current);
+  ASSERT_TRUE(current_first.has_value());
+  ASSERT_TRUE(hub->Ack(*current, current_first->stamp));
+
+  hub->NotifyDirtyForTesting(/*overflow=*/false);
+  capture_source_.CompleteNext(MakeBaseline("second mutation"));
+  EXPECT_TRUE(hub->ConsumerNeedsBaseline(*lagging));
+  EXPECT_FALSE(hub->ConsumerNeedsBaseline(*current));
+  EXPECT_TRUE(hub->ReadNext(*current).has_value());
+
+  EXPECT_TRUE(hub->RevokeConsumer(*lagging));
+  EXPECT_EQ(1u, hub->consumer_count());
+  EXPECT_TRUE(hub->ReadNext(*current).has_value());
+  EXPECT_EQ(0u, hub->disable_count_for_testing());
+}
+
 }  // namespace
 }  // namespace prometheus
