+TEST_F(PrometheusSupervisionCaptureHubTest,
+       ConsumerAdmissionIsBoundedWithoutExtraEnableOrCapture) {
+  SupervisionLimits limits;
+  limits.viewers_per_tab = 2;
+  auto hub = CreateHub(limits);
+
+  EXPECT_TRUE(hub->AttachConsumer(SupervisionCaptureConsumerKind::kDashboard,
+                                  now_ + base::Minutes(1))
+                  .has_value());
+  EXPECT_TRUE(hub->AttachConsumer(
+                      SupervisionCaptureConsumerKind::kAgentCompatibility,
+                      now_ + base::Minutes(1))
+                  .has_value());
+  EXPECT_FALSE(hub->AttachConsumer(
+                       SupervisionCaptureConsumerKind::kDashboard,
+                       now_ + base::Minutes(1))
+                   .has_value());
+  EXPECT_EQ(1u, hub->enable_count_for_testing());
+  EXPECT_EQ(1u, hub->capture_count_for_testing());
+}
