+void PrometheusAgentGateway::SetSupervisionGatewayDispatcher(
+    SupervisionGatewayDispatcher dispatcher) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  ShutdownSupervisionDispatcher(/*complete_unavailable=*/true);
+  if (dispatcher.IsComplete()) {
+    supervision_dispatcher_ = std::move(dispatcher);
+  }
+}
