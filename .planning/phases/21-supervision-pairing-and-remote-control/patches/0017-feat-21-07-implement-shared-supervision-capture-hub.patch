+  const auto batch =
+      std::ranges::find(history_, stamp.sequence, &SharedBatch::sequence);
+  const std::optional<uint64_t> next =
+      CheckedNextSupervisionSequence(stamp.sequence);
+  if (batch == history_.end() || !next.has_value()) {
+    RequireBaseline(state);
+    PruneHistory();
+    return false;
+  }
+
+  state.acknowledged_sequence = stamp.sequence;
+  state.next_sequence = *next;
+  state.offered_diff_sequence.reset();
