@@ -0,0 +1,138 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Unit tests for PrometheusAction resolver (D-08).
+// Verifies that every PrometheusAction value maps to:
+//   - A non-null gfx::VectorIcon (Views rendering)
+//   - A non-empty SVG resource path string (WebUI rendering)
+// Also asserts the map has exactly 72 entries (parity with the 72-glyph manifest).
+
+#include "chrome/browser/prometheus/prometheus_action.h"
+
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "base/containers/flat_map.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/gfx/vector_icon_types.h"
+
+namespace {
+
+// The complete list of all 72 PrometheusAction values.
+// This list must stay in sync with the PrometheusAction enum in prometheus_action.h.
+constexpr PrometheusAction kAllActions[] = {
+    PrometheusAction::kArrowDownToLine,
+    PrometheusAction::kArrowLeft,
+    PrometheusAction::kArrowRight,
+    PrometheusAction::kArrowUp,
+    PrometheusAction::kArrowUpFromBracket,
+    PrometheusAction::kBars,
+    PrometheusAction::kBolt,
+    PrometheusAction::kBookOpen,
+    PrometheusAction::kCalendarCheck,
+    PrometheusAction::kCamera,
+    PrometheusAction::kCartShopping,
+    PrometheusAction::kCheckDouble,
+    PrometheusAction::kCircleCheck,
+    PrometheusAction::kCircleHalfStroke,
+    PrometheusAction::kCircleInfo,
+    PrometheusAction::kCircleMinus,
+    PrometheusAction::kCircleNodes,
+    PrometheusAction::kCirclePlus,
+    PrometheusAction::kCircleQuestion,
+    PrometheusAction::kCircleXmark,
+    PrometheusAction::kCompass,
+    PrometheusAction::kCopy,
+    PrometheusAction::kEye,
+    PrometheusAction::kFolderPlus,
+    PrometheusAction::kHeartPulse,
+    PrometheusAction::kHighlighter,
+    PrometheusAction::kHouse,
+    PrometheusAction::kInbox,
+    PrometheusAction::kKey,
+    PrometheusAction::kKeyboard,
+    PrometheusAction::kLanguage,
+    PrometheusAction::kLayerGroup,
+    PrometheusAction::kLink,
+    PrometheusAction::kLinkSlash,
+    PrometheusAction::kLock,
+    PrometheusAction::kLockOpen,
+    PrometheusAction::kMagnifyingGlass,
+    PrometheusAction::kMicrochip,
+    PrometheusAction::kMicrophone,
+    PrometheusAction::kMoon,
+    PrometheusAction::kNoteSticky,
+    PrometheusAction::kPalette,
+    PrometheusAction::kPaste,
+    PrometheusAction::kPen,
+    PrometheusAction::kPlug,
+    PrometheusAction::kPlugCircleXmark,
+    PrometheusAction::kPlus,
+    PrometheusAction::kPuzzlePiece,
+    PrometheusAction::kRotateLeft,
+    PrometheusAction::kRotateRight,
+    PrometheusAction::kScissors,
+    PrometheusAction::kScroll,
+    PrometheusAction::kServer,
+    PrometheusAction::kShield,
+    PrometheusAction::kSidebarFlip,
+    PrometheusAction::kSliders,
+    PrometheusAction::kStar,
+    PrometheusAction::kStarHalfStroke,
+    PrometheusAction::kStop,
+    PrometheusAction::kTable,
+    PrometheusAction::kTableCellsLarge,
+    PrometheusAction::kTag,
+    PrometheusAction::kThumbtack,
+    PrometheusAction::kTrash,
+    PrometheusAction::kTriangleExclamation,
+    PrometheusAction::kUserSecret,
+    PrometheusAction::kVault,
+    PrometheusAction::kVolumeHigh,
+    PrometheusAction::kVolumeXmark,
+    PrometheusAction::kWandMagicSparkles,
+    PrometheusAction::kWrench,
+    PrometheusAction::kXmark,
+};
+
+}  // namespace
+
+// Test that the icon map has exactly 72 entries.
+TEST(PrometheusActionTest, PrometheusActionMapSizeIs72) {
+  const auto& icon_map = GetPrometheusActionIconMap();
+  EXPECT_EQ(icon_map.size(), 72u)
+      << "Map should contain exactly 72 entries (one per PrometheusAction value)";
+}
+
+// Test that every PrometheusAction maps to a non-null gfx::VectorIcon.
+// This verifies D-08: the icon map covers the full 72-glyph set for Views rendering.
+TEST(PrometheusActionTest, PrometheusActionMapsEveryActionToVectorIcon) {
+  const auto& icon_map = GetPrometheusActionIconMap();
+  for (PrometheusAction action : kAllActions) {
+    auto it = icon_map.find(action);
+    ASSERT_NE(it, icon_map.end())
+        << "PrometheusAction value not found in icon map";
+    EXPECT_NE(it->second, nullptr)
+        << "PrometheusAction maps to a null gfx::VectorIcon";
+  }
+}
+
+// Test that every PrometheusAction maps to a non-empty SVG path.
+// The path should name a fa_*.svg WebUI resource file.
+// This verifies D-08: the SVG resolver covers the full 72-glyph set for WebUI rendering.
+TEST(PrometheusActionTest, PrometheusActionMapsEveryActionToSvgPath) {
+  for (PrometheusAction action : kAllActions) {
+    const char* path = GetPrometheusActionSvgPath(action);
+    ASSERT_NE(path, nullptr) << "GetPrometheusActionSvgPath returned null";
+    EXPECT_GT(std::strlen(path), 0u)
+        << "GetPrometheusActionSvgPath returned empty string";
+    // Verify path follows the fa_*.svg naming convention
+    std::string path_str(path);
+    EXPECT_EQ(path_str.substr(0, 3), "fa_")
+        << "SVG path should start with 'fa_': " << path_str;
+    EXPECT_EQ(path_str.substr(path_str.size() - 4), ".svg")
+        << "SVG path should end with '.svg': " << path_str;
+  }
+}
