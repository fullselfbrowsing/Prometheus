@@ -47,6 +47,29 @@ class RecordingSupervisionObserver final
   std::vector<SanitizedSupervisionSnapshot> snapshots;
 };
 
+class VerifyingTabStateProjectionObserver final
+    : public PrometheusSupervisionProfileService::Observer {
+ public:
+  explicit VerifyingTabStateProjectionObserver(tabs::TabInterface* tab)
+      : tab_(tab) {}
+
+  void OnPrometheusSupervisionSnapshotChanged(
+      int32_t stable_tab_id,
+      const SanitizedSupervisionSnapshot& snapshot) override {
+    PrometheusAgentTabData* data = PrometheusAgentTabData::From(tab_);
+    projection_was_current = projection_was_current && data &&
+                             data->ToTabState().supervision ==
+                                 ProjectPrometheusTabSupervisionState(snapshot);
+    observed_tab_ids.push_back(stable_tab_id);
+  }
+
+  bool projection_was_current = true;
+  std::vector<int32_t> observed_tab_ids;
+
+ private:
+  raw_ptr<tabs::TabInterface> tab_;
+};
+
 class NoopTabDataObserver final : public PrometheusAgentTabData::Observer {
  public:
   void OnPrometheusAgentTabOwnerChanged(std::string_view,
@@ -659,6 +682,43 @@ TEST_F(PrometheusSupervisionProfileServiceTest,
                             viewer.dashboard_session));
 }
 
+TEST_F(PrometheusSupervisionProfileServiceTest,
+       TabStateProjectionPrecedesObserversAndClearsOnOwnerLoss) {
+  PrometheusAgentTabObservationLease owner_lease =
+      agent_service_->ObserveOrCreateTabData(&tab_, &observer_tab_data_);
+  ASSERT_NE(nullptr, owner_lease.data());
+  ASSERT_TRUE(owner_lease.data()->ClaimIfUnowned("owner-a", "Agent A").ok);
+  SupervisionPairingCreationResult creation = CreatePairing();
+  ASSERT_TRUE(creation.ok);
+  VerifyingTabStateProjectionObserver projection_observer(&tab_);
+  service_->AddObserver(&projection_observer);
+
+  SupervisionRedemptionResult viewer = Redeem(creation, "Controller");
+  EXPECT_TRUE(viewer.ok);
+  if (viewer.ok) {
+    EXPECT_TRUE(service_->EnableControl(viewer.dashboard_session).ok);
+    const PrometheusTabState::Supervision controlling =
+        owner_lease.data()->ToTabState().supervision;
+    EXPECT_EQ(PrometheusTabState::Supervision::ControlState::kControllerReady,
+              controlling.control_state);
+    EXPECT_EQ(std::optional<std::string>("Controller"),
+              controlling.controller_label);
+    EXPECT_TRUE(owner_lease.data()->ReleaseIfOwned("owner-a").ok);
+  }
+
+  const PrometheusTabState::Supervision terminal =
+      owner_lease.data()->ToTabState().supervision;
+  service_->RemoveObserver(&projection_observer);
+  EXPECT_TRUE(projection_observer.projection_was_current);
+  EXPECT_GE(projection_observer.observed_tab_ids.size(), 2u);
+  EXPECT_EQ(PrometheusTabState::Supervision::ControlState::kNone,
+            terminal.control_state);
+  EXPECT_EQ(PrometheusTabState::Supervision::ActivityState::kNone,
+            terminal.activity_state);
+  EXPECT_FALSE(terminal.controller_label.has_value());
+  EXPECT_FALSE(terminal.action_category.has_value());
+}
+
