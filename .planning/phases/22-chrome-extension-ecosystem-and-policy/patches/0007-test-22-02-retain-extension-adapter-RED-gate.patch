+#include "chrome/browser/prometheus/prometheus_extension_page_adapter.h"
+
+#include "chrome/test/base/in_process_browser_test.h"
+#include "content/public/test/browser_test.h"
+
+namespace prometheus {
+
+class PrometheusExtensionAgentBrowserTest : public InProcessBrowserTest {};
+
+IN_PROC_BROWSER_TEST_F(PrometheusExtensionAgentBrowserTest,
+                       ExactNonTabSurfaceRoutingContract) {
+  ASSERT_TRUE(ExtensionAgentDispatchContractImplementedForTesting())
+      << "retained RED: popup and side-panel routes need exact browser-owned "
+         "dispatch";
+  EXPECT_TRUE(
+      PrometheusExtensionPageAdapter::ShouldUseExtensionAdapterForTesting(
+          true, GURL("https://example.test/anchor")));
+}
+
+IN_PROC_BROWSER_TEST_F(PrometheusExtensionAgentBrowserTest,
+                       ContentScriptProvenanceRemainsNormalPage) {
+  ASSERT_TRUE(ExtensionAgentDispatchContractImplementedForTesting())
+      << "retained RED: HTTP content-script hosts must stay normal-page "
+         "targets";
+  EXPECT_FALSE(
+      PrometheusExtensionPageAdapter::ShouldUseExtensionAdapterForTesting(
+          false, GURL("https://example.test/content-script-host")));
+}
+
+IN_PROC_BROWSER_TEST_F(PrometheusExtensionAgentBrowserTest,
+                       ReverseAuthorityAndScriptRemainUnreachable) {
+  ASSERT_TRUE(ExtensionAgentDispatchContractImplementedForTesting())
+      << "retained RED: extension dispatch needs the reverse-authority and "
+         "script denial boundary";
+  const auto decision =
+      PrometheusExtensionPageAdapter::EvaluateAdmissionForTesting(
+          AgentRouteName::kExecuteJs, ExtensionAgentGrant::kInteract,
+          PrometheusExtensionAdmissionEvidence());
+  EXPECT_FALSE(decision.allowed);
+  EXPECT_EQ(PrometheusExtensionAdmissionDenial::kScriptDenied,
+            decision.denial);
+}
+
+}  // namespace prometheus
