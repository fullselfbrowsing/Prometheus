+      if (request.route_name == RuntimeRouteName::kVaultAutofill) {
+        entry_id = std::get<VaultAutofillParams>(request.params).entry_id;
+      } else if (request.route_name == RuntimeRouteName::kFillCredential) {
+        entry_id = std::get<FillCredentialParams>(request.params).entry_id;
+        required_kind = PrometheusVaultKind::kCredential;
+      } else {
