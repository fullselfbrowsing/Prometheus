+class PrometheusExtensionSmokeControllerBrowserTest
+    : public InProcessBrowserTest {
+ protected:
+  // Points a fresh bootstrap at the real, checked-in Plan-22-04
+  // developer_workflow fixture (chrome/test/data/prometheus/extensions/
+  // developer_workflow/) through the exact same strict, non-official,
+  // exact-runtime-test, disposable-profile, 0600, no-follow production
+  // boundary the built app itself uses -- no fake file access, no
+  // install-verification or MV2 bypass, no direct install/registry mutation.
+  std::unique_ptr<PrometheusExtensionSmokeBootstrap> CreateValidBootstrap() {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    if (!scratch_dir_.IsValid() && !scratch_dir_.CreateUniqueTempDir()) {
+      return nullptr;
+    }
+
+    const base::FilePath fixture_path =
+        base::PathService::CheckedGet(base::DIR_SRC_TEST_DATA_ROOT)
+            .Append(GetChromeTestDataDir())
+            .AppendASCII("prometheus")
+            .AppendASCII("extensions")
+            .AppendASCII("developer_workflow");
+    const base::FilePath manifest_path =
+        fixture_path.AppendASCII("manifest.json");
+    std::string manifest_contents;
+    if (!base::ReadFileToString(manifest_path, &manifest_contents)) {
+      return nullptr;
+    }
+    const std::string fixture_sha256 =
+        base::HexEncodeLower(crypto::hash::Sha256(manifest_contents));
+
+    const base::FilePath result_path =
+        scratch_dir_.GetPath().AppendASCII("smoke-result.json");
+    const base::FilePath config_path =
+        scratch_dir_.GetPath().AppendASCII("smoke-config.json");
+    const std::string config_json = base::StrCat(
+        {"{\"schema_version\":1,\"fixture_path\":\"",
+         fixture_path.AsUTF8Unsafe(), "\",\"fixture_sha256\":\"",
+         fixture_sha256, "\",\"result_path\":\"", result_path.AsUTF8Unsafe(),
+         "\"}"});
+    if (!base::WriteFile(config_path, config_json)) {
+      return nullptr;
+    }
+    if (!base::SetPosixFilePermissions(config_path, 0600)) {
+      return nullptr;
+    }
+
+    base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+    command_line.AppendSwitchASCII(kPrometheusRuntimeTestTypeSwitch,
+                                   kPrometheusRuntimeTestType);
+    command_line.AppendSwitchPath(kPrometheusExtensionSmokeBootstrapSwitch,
+                                  config_path);
+
+    std::unique_ptr<PrometheusExtensionSmokeBootstrap> bootstrap;
+    const PrometheusExtensionSmokeBootstrapResult result =
+        PrometheusExtensionSmokeBootstrap::Create(
+            command_line, /*is_official_build=*/false,
+            {.is_regular_profile = true,
+             .is_disposable_profile = true,
+             .is_off_the_record = false},
+            CreatePrometheusExtensionSmokeBootstrapFileAccess(),
+            CreatePrometheusExtensionSmokeFixtureAccess(), &bootstrap);
+    if (result != PrometheusExtensionSmokeBootstrapResult::kApplied) {
+      return nullptr;
+    }
+    return bootstrap;
+  }
+
+  base::ScopedTempDir scratch_dir_;
+};
+
+// Retained RED (this plan) / GREEN (the following plan) contract: the full
+// native lifecycle drive can only reach extension installation once
+// developer-private code copies the live, committed chrome://extensions
+// caller into SelectFileDialog::SelectFile(). Until then, this controller's
+// one-shot chooser correctly observes a null caller and declines, and the
+// bounded install-wait timeout is the expected non-crashing failure.
+IN_PROC_BROWSER_TEST_F(
+    PrometheusExtensionSmokeControllerBrowserTest,
+    FullLifecycleRequiresDeveloperPrivateManagerCallerIntegration) {
+  std::unique_ptr<PrometheusExtensionSmokeBootstrap> bootstrap =
+      CreateValidBootstrap();
+  ASSERT_TRUE(bootstrap);
+
+  std::unique_ptr<PrometheusExtensionSmokeController> controller =
+      PrometheusExtensionSmokeController::Create(std::move(bootstrap),
+                                                 browser()->profile(),
+                                                 browser());
+  ASSERT_TRUE(controller);
+
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return controller->outcome_for_testing() !=
+          PrometheusExtensionSmokeOutcome::kRunning;
+  })) << "smoke controller never reached a terminal outcome";
+
+  EXPECT_EQ(PrometheusExtensionSmokeOutcome::kFailed,
+           controller->outcome_for_testing());
+  EXPECT_EQ(PrometheusExtensionSmokeStage::kLoadUnpackedClicked,
+           controller->stage_for_testing());
+  EXPECT_TRUE(controller->extension_id_for_testing().empty());
+
+  controller->Shutdown();
+}
+
+// Create() must reject an OTR profile/browser pairing before ever touching
+// bootstrap-owned fixture or chooser state -- the smoke never runs, let
+// alone installs anything, outside a live regular disposable profile.
+IN_PROC_BROWSER_TEST_F(PrometheusExtensionSmokeControllerBrowserTest,
+                       CreateRejectsOffTheRecordProfile) {
+  std::unique_ptr<PrometheusExtensionSmokeBootstrap> bootstrap =
+      CreateValidBootstrap();
+  ASSERT_TRUE(bootstrap);
+
+  Profile* otr_profile =
+      browser()->profile()->GetPrimaryOTRProfile(/*create_if_needed=*/true);
+  ASSERT_TRUE(otr_profile);
+  Browser* otr_browser = CreateBrowser(otr_profile);
+  ASSERT_TRUE(otr_browser);
+
+  std::unique_ptr<PrometheusExtensionSmokeController> controller =
+      PrometheusExtensionSmokeController::Create(std::move(bootstrap),
+                                                 otr_profile, otr_browser);
+  EXPECT_FALSE(controller);
+
+  CloseBrowserSynchronously(otr_browser);
+}
+
+// Create() must reject a browser/profile pairing where the Browser does not
+// belong to the supplied profile -- a mismatched, non-live target can never
+// become the smoke's manager tab owner. `mismatched_browser`'s own profile
+// is the primary OTR profile, which is never equal to the regular `profile`
+// argument passed alongside it.
+IN_PROC_BROWSER_TEST_F(PrometheusExtensionSmokeControllerBrowserTest,
+                       CreateRejectsMismatchedBrowserProfilePairing) {
+  std::unique_ptr<PrometheusExtensionSmokeBootstrap> bootstrap =
+      CreateValidBootstrap();
+  ASSERT_TRUE(bootstrap);
+
+  Profile* regular_profile = browser()->profile();
+  Browser* mismatched_browser = CreateBrowser(
+      regular_profile->GetPrimaryOTRProfile(/*create_if_needed=*/true));
+  ASSERT_TRUE(mismatched_browser);
+  ASSERT_NE(mismatched_browser->profile(), regular_profile);
+
+  std::unique_ptr<PrometheusExtensionSmokeController> controller =
+      PrometheusExtensionSmokeController::Create(
+          std::move(bootstrap), regular_profile, mismatched_browser);
+  EXPECT_FALSE(controller);
+
+  CloseBrowserSynchronously(mismatched_browser);
+}
