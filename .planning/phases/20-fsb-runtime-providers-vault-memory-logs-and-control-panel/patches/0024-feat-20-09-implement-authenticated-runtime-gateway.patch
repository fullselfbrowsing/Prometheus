+          request.route_name == RuntimeRouteName::kListCredentials;
+      const size_t limit = credentials
+                               ? std::get<ListCredentialsParams>(request.params)
+                                     .limit
+                               : std::get<ListPaymentMethodsParams>(
+                                     request.params)
+                                     .limit;
+      RuntimeVaultListResult payload;
+      for (const PrometheusVaultMetadata& metadata :
+           runtime->ListVaultMetadataForTransport(
+               credentials ? PrometheusVaultKind::kCredential
