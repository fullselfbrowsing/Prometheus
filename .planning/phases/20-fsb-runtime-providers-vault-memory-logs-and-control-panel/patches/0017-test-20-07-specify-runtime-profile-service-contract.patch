+
+TEST_F(PrometheusRuntimeProfileServiceTest,
+       PrincipalIsMoveOnlyAndHidesAuthority) {
+  static_assert(std::is_move_constructible_v<LocalRuntimePrincipal>);
+  static_assert(std::is_move_assignable_v<LocalRuntimePrincipal>);
+  static_assert(!std::is_copy_constructible_v<LocalRuntimePrincipal>);
