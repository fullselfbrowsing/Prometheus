+// Wave 0 stub — intentionally empty mixer so tests compile RED.
+// Token assignments are added in Plan 14-03 (GREEN phase).
+
+#include "chrome/browser/ui/color/prometheus_color_mixer.h"
+
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/color/color_mixer.h"
+#include "ui/color/color_provider.h"
+
+void AddPrometheusColorMixer(ui::ColorProvider* provider,
+                             const ui::ColorProviderKey& key) {
+  const bool dark_mode =
+      key.color_mode == ui::ColorProviderKey::ColorMode::kDark;
+  (void)dark_mode;  // intentional no-op in Wave 0
+
+  ui::ColorMixer& mixer = provider->AddMixer();
+  (void)mixer;  // intentional no-op in Wave 0
+
