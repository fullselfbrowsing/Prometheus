+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_PROMETHEUS_TAB_STATUS_BADGE_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_PROMETHEUS_TAB_STATUS_BADGE_H_
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/prometheus/prometheus_tab_state.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+
+namespace views {
+class ImageView;
+}  // namespace views
+
+class PrometheusTabStatusBadge : public views::View {
+  METADATA_HEADER(PrometheusTabStatusBadge, views::View)
+
+ public:
+  static constexpr int kIconSize = 12;
+
+  PrometheusTabStatusBadge();
+  PrometheusTabStatusBadge(const PrometheusTabStatusBadge&) = delete;
+  PrometheusTabStatusBadge& operator=(const PrometheusTabStatusBadge&) = delete;
+  ~PrometheusTabStatusBadge() override;
+
+  void SetState(const PrometheusTabState& state);
+
+ private:
+  raw_ptr<views::ImageView> owner_or_automation_badge_ = nullptr;
+  raw_ptr<views::ImageView> supervision_badge_ = nullptr;
+  raw_ptr<views::ImageView> health_badge_ = nullptr;
+};
