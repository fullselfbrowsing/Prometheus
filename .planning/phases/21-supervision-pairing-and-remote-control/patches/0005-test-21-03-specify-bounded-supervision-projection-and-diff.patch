new file mode 100644
index 0000000000..7e0633cb09
--- /dev/null
+++ b/chrome/browser/prometheus/prometheus_supervision_diff.cc
@@ -0,0 +1,65 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_supervision_diff.h"
+
+#include <utility>
+
+namespace prometheus {
+
+SupervisionDiff ComputeSupervisionDiff(const SupervisionBaseline& previous,
+                                       const SupervisionBaseline& current,
+                                       const SupervisionLimits& limits) {
+  static_cast<void>(previous);
+  static_cast<void>(current);
+  static_cast<void>(limits);
+  return {};
+}
+
+SupervisionViewerDiffCursor::SupervisionViewerDiffCursor(
+    const SupervisionLimits& limits)
+    : limits_(limits) {}
+
+SupervisionViewerDiffCursor::~SupervisionViewerDiffCursor() = default;
+
+void SupervisionViewerDiffCursor::BeginBaseline(
+    const SupervisionStreamStamp& baseline_stamp) {
+  baseline_stamp_ = baseline_stamp;
+  EnterNeedsBaseline();
+}
+
+bool SupervisionViewerDiffCursor::AcknowledgeBaseline(
+    const SupervisionStreamStamp& baseline_stamp) {
+  static_cast<void>(baseline_stamp);
+  return false;
+}
+
+bool SupervisionViewerDiffCursor::QueueBatch(SupervisionDiffBatch batch) {
+  static_cast<void>(batch);
+  EnterNeedsBaseline();
+  return false;
+}
+
+const SupervisionDiffBatch* SupervisionViewerDiffCursor::ReadNext() const {
+  return nullptr;
+}
+
+bool SupervisionViewerDiffCursor::Acknowledge(uint64_t sequence) {
+  static_cast<void>(sequence);
+  EnterNeedsBaseline();
+  return false;
+}
+
+void SupervisionViewerDiffCursor::RequireBaseline() {
+  EnterNeedsBaseline();
+}
+
+void SupervisionViewerDiffCursor::EnterNeedsBaseline() {
+  batches_.clear();
+  retained_bytes_ = 0;
+  acknowledged_sequence_ = 0;
+  needs_baseline_ = true;
+}
+
+}  // namespace prometheus
diff --git a/chrome/browser/prometheus/prometheus_supervision_diff.h b/chrome/browser/prometheus/prometheus_supervision_diff.h
new file mode 100644
index 0000000000..af70b98343
--- /dev/null
+++ b/chrome/browser/prometheus/prometheus_supervision_diff.h
@@ -0,0 +1,100 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PROMETHEUS_PROMETHEUS_SUPERVISION_DIFF_H_
+#define CHROME_BROWSER_PROMETHEUS_PROMETHEUS_SUPERVISION_DIFF_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "chrome/browser/prometheus/prometheus_supervision_projection.h"
+#include "chrome/browser/prometheus/prometheus_supervision_types.h"
+
+namespace prometheus {
+
+enum class SupervisionDiffOperationType {
+  kInsertSubtree,
+  kRemove,
+  kReplaceFields,
+  kReorderChildren,
+};
+
+struct SupervisionDiffOperation {
+  SupervisionDiffOperationType type =
+      SupervisionDiffOperationType::kReplaceFields;
+  std::string ref;
+  std::string parent_ref;
+  size_t index = 0;
+  std::vector<SupervisionNormalizedNode> subtree;
+  std::optional<SupervisionNormalizedNode> replacement;
+  std::vector<std::string> child_order;
+
+  bool operator==(const SupervisionDiffOperation&) const = default;
+};
+
+// Diff payloads intentionally contain no stream authority. The browser-only
+// stamp travels in SupervisionDiffBatch and is never part of serialized_json.
+struct SupervisionDiff {
+  bool needs_baseline = true;
+  std::vector<SupervisionDiffOperation> operations;
+  std::string serialized_json;
+
+  bool authoritative() const { return !needs_baseline; }
+
+  bool operator==(const SupervisionDiff&) const = default;
+};
+
+SupervisionDiff ComputeSupervisionDiff(
+    const SupervisionBaseline& previous,
+    const SupervisionBaseline& current,
+    const SupervisionLimits& limits = SupervisionLimits());
+
+struct SupervisionDiffBatch {
+  SupervisionStreamStamp stamp;
+  SupervisionDiff diff;
+
+  bool operator==(const SupervisionDiffBatch&) const = default;
+};
+
+// A single viewer's delivery/ack state. Callers create one cursor per viewer;
+// no cursor can advance, revoke, or resynchronize another cursor.
+class SupervisionViewerDiffCursor {
+ public:
+  explicit SupervisionViewerDiffCursor(
+      const SupervisionLimits& limits = SupervisionLimits());
+  SupervisionViewerDiffCursor(const SupervisionViewerDiffCursor&) = delete;
+  SupervisionViewerDiffCursor& operator=(const SupervisionViewerDiffCursor&) =
+      delete;
+  ~SupervisionViewerDiffCursor();
+
+  void BeginBaseline(const SupervisionStreamStamp& baseline_stamp);
+  bool AcknowledgeBaseline(const SupervisionStreamStamp& baseline_stamp);
+  bool QueueBatch(SupervisionDiffBatch batch);
+  const SupervisionDiffBatch* ReadNext() const;
+  bool Acknowledge(uint64_t sequence);
+  void RequireBaseline();
+
+  bool needs_baseline() const { return needs_baseline_; }
+  size_t retained_batches() const { return batches_.size(); }
+  size_t retained_bytes() const { return retained_bytes_; }
+  uint64_t acknowledged_sequence() const { return acknowledged_sequence_; }
+
+ private:
+  void EnterNeedsBaseline();
+
+  SupervisionLimits limits_;
+  std::optional<SupervisionStreamStamp> baseline_stamp_;
+  uint64_t acknowledged_sequence_ = 0;
+  std::deque<SupervisionDiffBatch> batches_;
+  size_t retained_bytes_ = 0;
+  bool needs_baseline_ = true;
+};
+
+}  // namespace prometheus
+
+#endif  // CHROME_BROWSER_PROMETHEUS_PROMETHEUS_SUPERVISION_DIFF_H_
diff --git a/chrome/browser/prometheus/prometheus_supervision_diff_unittest.cc b/chrome/browser/prometheus/prometheus_supervision_diff_unittest.cc
new file mode 100644
index 0000000000..5d1142d0c2
--- /dev/null
+++ b/chrome/browser/prometheus/prometheus_supervision_diff_unittest.cc
@@ -0,0 +1,308 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_supervision_diff.h"
+
+#include <cstdint>
+#include <limits>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/unguessable_token.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace prometheus {
+
+namespace {
+
+SupervisionNormalizedNode MakeNode(std::string ref,
+                                   std::string parent_ref,
+                                   std::vector<std::string> child_refs,
+                                   std::string name = std::string()) {
+  SupervisionNormalizedNode node;
+  node.ref = std::move(ref);
+  node.parent_ref = std::move(parent_ref);
+  node.child_refs = std::move(child_refs);
+  node.tag = "container";
+  node.name = std::move(name);
+  return node;
+}
+
+SupervisionBaseline MakeBaseline(std::vector<SupervisionNormalizedNode> nodes) {
+  SupervisionBaseline baseline;
+  baseline.state = SupervisionProjectionState::kAuthoritative;
+  baseline.nodes = std::move(nodes);
+  baseline.serialized_json = "{\"nodes\":[]}";
+  return baseline;
+}
+
+SupervisionBaseline MakeTwoChildTree(bool reverse = false) {
+  const std::vector<std::string> order =
+      reverse ? std::vector<std::string>{"doc:3", "doc:2"}
+              : std::vector<std::string>{"doc:2", "doc:3"};
+  return MakeBaseline({MakeNode("doc:1", "", order, "root"),
+                       MakeNode("doc:2", "doc:1", {}, "two"),
+                       MakeNode("doc:3", "doc:1", {}, "three")});
+}
+
+SupervisionStreamStamp MakeStamp(uint64_t sequence) {
+  return SupervisionStreamStamp{
+      .session = base::UnguessableToken::Create(),
+      .stable_tab_id = 7,
+      .document_epoch = base::UnguessableToken::Create(),
+      .sequence = sequence,
+  };
+}
+
+SupervisionStreamStamp NextStamp(const SupervisionStreamStamp& previous,
+                                 uint64_t sequence) {
+  SupervisionStreamStamp stamp = previous;
+  stamp.sequence = sequence;
+  return stamp;
+}
+
+SupervisionDiff MakeAuthoritativeDiff(size_t bytes = 2) {
+  SupervisionDiff diff;
+  diff.needs_baseline = false;
+  diff.serialized_json.assign(bytes, 'd');
+  return diff;
+}
+
+SupervisionDiffBatch MakeBatch(const SupervisionStreamStamp& stamp,
+                               size_t bytes = 2) {
+  return SupervisionDiffBatch{.stamp = stamp,
+                              .diff = MakeAuthoritativeDiff(bytes)};
+}
+
+TEST(PrometheusSupervisionDiffTest,
+     IdenticalTreesProduceDeterministicEmptyDiff) {
+  const SupervisionBaseline baseline = MakeTwoChildTree();
+
+  const SupervisionDiff first = ComputeSupervisionDiff(baseline, baseline);
+  const SupervisionDiff second = ComputeSupervisionDiff(baseline, baseline);
+
+  ASSERT_TRUE(first.authoritative());
+  EXPECT_TRUE(first.operations.empty());
+  EXPECT_EQ("[]", first.serialized_json);
+  EXPECT_EQ(first, second);
+}
+
+TEST(PrometheusSupervisionDiffTest, InsertEmitsOnlyInsertSubtree) {
+  const SupervisionBaseline previous =
+      MakeBaseline({MakeNode("doc:1", "", {"doc:2"}, "root"),
+                    MakeNode("doc:2", "doc:1", {}, "two")});
+  const SupervisionBaseline current = MakeTwoChildTree();
+
+  const SupervisionDiff diff = ComputeSupervisionDiff(previous, current);
+
+  ASSERT_TRUE(diff.authoritative());
+  ASSERT_EQ(1u, diff.operations.size());
+  EXPECT_EQ(SupervisionDiffOperationType::kInsertSubtree,
+            diff.operations[0].type);
+  EXPECT_EQ("doc:3", diff.operations[0].ref);
+  EXPECT_EQ("doc:1", diff.operations[0].parent_ref);
+  EXPECT_EQ(1u, diff.operations[0].index);
+  ASSERT_EQ(1u, diff.operations[0].subtree.size());
+  EXPECT_EQ("doc:3", diff.operations[0].subtree[0].ref);
+}
+
+TEST(PrometheusSupervisionDiffTest, RemoveEmitsOnlyRemove) {
+  const SupervisionBaseline previous = MakeTwoChildTree();
+  const SupervisionBaseline current =
+      MakeBaseline({MakeNode("doc:1", "", {"doc:2"}, "root"),
+                    MakeNode("doc:2", "doc:1", {}, "two")});
+
+  const SupervisionDiff diff = ComputeSupervisionDiff(previous, current);
+
+  ASSERT_TRUE(diff.authoritative());
+  ASSERT_EQ(1u, diff.operations.size());
+  EXPECT_EQ(SupervisionDiffOperationType::kRemove, diff.operations[0].type);
+  EXPECT_EQ("doc:3", diff.operations[0].ref);
+}
+
+TEST(PrometheusSupervisionDiffTest, FieldChangeEmitsOnlyReplaceFields) {
+  SupervisionBaseline previous = MakeTwoChildTree();
+  SupervisionBaseline current = previous;
+  current.nodes[1].name = "two changed";
+
+  const SupervisionDiff diff = ComputeSupervisionDiff(previous, current);
+
+  ASSERT_TRUE(diff.authoritative());
+  ASSERT_EQ(1u, diff.operations.size());
+  EXPECT_EQ(SupervisionDiffOperationType::kReplaceFields,
+            diff.operations[0].type);
+  EXPECT_EQ("doc:2", diff.operations[0].ref);
+  ASSERT_TRUE(diff.operations[0].replacement.has_value());
+  EXPECT_EQ("two changed", diff.operations[0].replacement->name);
+}
+
+TEST(PrometheusSupervisionDiffTest, ChildOrderChangeEmitsOnlyReorderChildren) {
+  const SupervisionBaseline previous = MakeTwoChildTree();
+  const SupervisionBaseline current = MakeTwoChildTree(/*reverse=*/true);
+
+  const SupervisionDiff diff = ComputeSupervisionDiff(previous, current);
+
+  ASSERT_TRUE(diff.authoritative());
+  ASSERT_EQ(1u, diff.operations.size());
+  EXPECT_EQ(SupervisionDiffOperationType::kReorderChildren,
+            diff.operations[0].type);
+  EXPECT_EQ("doc:1", diff.operations[0].ref);
+  EXPECT_EQ((std::vector<std::string>{"doc:3", "doc:2"}),
+            diff.operations[0].child_order);
+}
+
+TEST(PrometheusSupervisionDiffTest,
+     SessionTargetAndEpochDiscontinuitiesRequireBaseline) {
+  const SupervisionStreamStamp baseline = MakeStamp(1);
+
+  auto expect_rejected = [&](SupervisionStreamStamp changed) {
+    SupervisionViewerDiffCursor cursor;
+    cursor.BeginBaseline(baseline);
+    ASSERT_TRUE(cursor.AcknowledgeBaseline(baseline));
+    changed.sequence = 2;
+    EXPECT_FALSE(cursor.QueueBatch(MakeBatch(changed)));
+    EXPECT_TRUE(cursor.needs_baseline());
+    EXPECT_EQ(0u, cursor.retained_batches());
+  };
+
+  SupervisionStreamStamp changed_session = baseline;
+  changed_session.session = base::UnguessableToken::Create();
+  expect_rejected(changed_session);
+  SupervisionStreamStamp changed_target = baseline;
+  changed_target.stable_tab_id = 8;
+  expect_rejected(changed_target);
+  SupervisionStreamStamp changed_epoch = baseline;
+  changed_epoch.document_epoch = base::UnguessableToken::Create();
+  expect_rejected(changed_epoch);
+}
+
+TEST(PrometheusSupervisionDiffTest,
+     DuplicateGapAndOutOfOrderSequencesRequireBaseline) {
+  const SupervisionStreamStamp baseline = MakeStamp(1);
+
+  SupervisionViewerDiffCursor duplicate;
+  duplicate.BeginBaseline(baseline);
+  ASSERT_TRUE(duplicate.AcknowledgeBaseline(baseline));
+  ASSERT_TRUE(duplicate.QueueBatch(MakeBatch(NextStamp(baseline, 2))));
+  EXPECT_FALSE(duplicate.QueueBatch(MakeBatch(NextStamp(baseline, 2))));
+  EXPECT_TRUE(duplicate.needs_baseline());
+
+  SupervisionViewerDiffCursor gap;
+  gap.BeginBaseline(baseline);
+  ASSERT_TRUE(gap.AcknowledgeBaseline(baseline));
+  EXPECT_FALSE(gap.QueueBatch(MakeBatch(NextStamp(baseline, 3))));
+  EXPECT_TRUE(gap.needs_baseline());
+
+  SupervisionViewerDiffCursor out_of_order;
+  out_of_order.BeginBaseline(baseline);
+  ASSERT_TRUE(out_of_order.AcknowledgeBaseline(baseline));
+  ASSERT_TRUE(out_of_order.QueueBatch(MakeBatch(NextStamp(baseline, 2))));
+  EXPECT_FALSE(out_of_order.QueueBatch(MakeBatch(NextStamp(baseline, 1))));
+  EXPECT_TRUE(out_of_order.needs_baseline());
+}
+
+TEST(PrometheusSupervisionDiffTest,
+     OperationAndSerializedByteCapsRequireBaseline) {
+  SupervisionBaseline previous = MakeTwoChildTree();
+  SupervisionBaseline current = previous;
+  current.nodes[1].name = "changed two";
+  current.nodes[2].name = "changed three";
+
+  const SupervisionDiff unrestricted =
+      ComputeSupervisionDiff(previous, current);
+  ASSERT_TRUE(unrestricted.authoritative());
+  ASSERT_EQ(2u, unrestricted.operations.size());
+
+  SupervisionLimits operation_limits;
+  operation_limits.diff_operations = 1;
+  const SupervisionDiff too_many_operations =
+      ComputeSupervisionDiff(previous, current, operation_limits);
+  EXPECT_TRUE(too_many_operations.needs_baseline);
+  EXPECT_TRUE(too_many_operations.operations.empty());
+  EXPECT_TRUE(too_many_operations.serialized_json.empty());
+
+  SupervisionLimits byte_limits;
+  byte_limits.diff_bytes = 1;
+  const SupervisionDiff too_many_bytes =
+      ComputeSupervisionDiff(previous, current, byte_limits);
+  EXPECT_TRUE(too_many_bytes.needs_baseline);
+  EXPECT_TRUE(too_many_bytes.operations.empty());
+  EXPECT_TRUE(too_many_bytes.serialized_json.empty());
+}
+
+TEST(PrometheusSupervisionDiffTest,
+     RetainedBatchAndByteOverflowClearQueueAndRequireBaseline) {
+  const SupervisionStreamStamp baseline = MakeStamp(1);
+
+  SupervisionLimits batch_limits;
+  batch_limits.retained_batches = 1;
+  SupervisionViewerDiffCursor batch_overflow(batch_limits);
+  batch_overflow.BeginBaseline(baseline);
+  ASSERT_TRUE(batch_overflow.AcknowledgeBaseline(baseline));
+  ASSERT_TRUE(batch_overflow.QueueBatch(MakeBatch(NextStamp(baseline, 2))));
+  EXPECT_FALSE(batch_overflow.QueueBatch(MakeBatch(NextStamp(baseline, 3))));
+  EXPECT_TRUE(batch_overflow.needs_baseline());
+  EXPECT_EQ(0u, batch_overflow.retained_batches());
+  EXPECT_EQ(0u, batch_overflow.retained_bytes());
+
+  SupervisionLimits byte_limits;
+  byte_limits.retained_bytes_per_viewer = 5;
+  SupervisionViewerDiffCursor byte_overflow(byte_limits);
+  byte_overflow.BeginBaseline(baseline);
+  ASSERT_TRUE(byte_overflow.AcknowledgeBaseline(baseline));
+  ASSERT_TRUE(byte_overflow.QueueBatch(MakeBatch(NextStamp(baseline, 2), 5)));
+  EXPECT_FALSE(byte_overflow.QueueBatch(MakeBatch(NextStamp(baseline, 3), 1)));
+  EXPECT_TRUE(byte_overflow.needs_baseline());
+  EXPECT_EQ(0u, byte_overflow.retained_batches());
+  EXPECT_EQ(0u, byte_overflow.retained_bytes());
+}
+
+TEST(PrometheusSupervisionDiffTest, SequenceWrapRequiresFreshBaseline) {
+  SupervisionStreamStamp terminal =
+      MakeStamp(std::numeric_limits<uint64_t>::max());
+  SupervisionViewerDiffCursor cursor;
+  cursor.BeginBaseline(terminal);
+  EXPECT_FALSE(cursor.AcknowledgeBaseline(terminal));
+  EXPECT_TRUE(cursor.needs_baseline());
+
+  SupervisionStreamStamp before_terminal = terminal;
+  before_terminal.sequence = std::numeric_limits<uint64_t>::max() - 1;
+  cursor.BeginBaseline(before_terminal);
+  ASSERT_TRUE(cursor.AcknowledgeBaseline(before_terminal));
+  ASSERT_TRUE(cursor.QueueBatch(MakeBatch(terminal)));
+  EXPECT_FALSE(cursor.QueueBatch(MakeBatch(NextStamp(terminal, 0))));
+  EXPECT_TRUE(cursor.needs_baseline());
+}
+
+TEST(PrometheusSupervisionDiffTest,
+     IndependentViewerCursorsDoNotAdvanceOrRevokeEachOther) {
+  const SupervisionStreamStamp baseline = MakeStamp(1);
+  const SupervisionDiffBatch batch = MakeBatch(NextStamp(baseline, 2));
+  SupervisionViewerDiffCursor viewer_a;
+  SupervisionViewerDiffCursor viewer_b;
+  viewer_a.BeginBaseline(baseline);
+  viewer_b.BeginBaseline(baseline);
+  ASSERT_TRUE(viewer_a.AcknowledgeBaseline(baseline));
+  ASSERT_TRUE(viewer_b.AcknowledgeBaseline(baseline));
+  ASSERT_TRUE(viewer_a.QueueBatch(batch));
+  ASSERT_TRUE(viewer_b.QueueBatch(batch));
+
+  ASSERT_NE(nullptr, viewer_a.ReadNext());
+  ASSERT_NE(nullptr, viewer_b.ReadNext());
+  EXPECT_TRUE(viewer_a.Acknowledge(2));
+  EXPECT_EQ(nullptr, viewer_a.ReadNext());
+  ASSERT_NE(nullptr, viewer_b.ReadNext());
+  EXPECT_EQ(2u, viewer_b.ReadNext()->stamp.sequence);
+  EXPECT_EQ(1u, viewer_b.acknowledged_sequence());
+
+  viewer_a.RequireBaseline();
+  EXPECT_TRUE(viewer_a.needs_baseline());
+  EXPECT_FALSE(viewer_b.needs_baseline());
+  EXPECT_TRUE(viewer_b.Acknowledge(2));
+  EXPECT_EQ(2u, viewer_b.acknowledged_sequence());
+}
+
+}  // namespace
+}  // namespace prometheus
