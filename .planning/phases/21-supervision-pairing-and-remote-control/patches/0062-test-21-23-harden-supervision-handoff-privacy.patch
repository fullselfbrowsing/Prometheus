+TEST(PrometheusAgentGatewayTest,
+     SupervisionTestHandoffOutputsExposeOnlyTheIntentionalOneShotCode) {
+  constexpr std::string_view kChallenge =
+      "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
+  FakeSupervisionTestHandoffDispatcher fake;
+  PrometheusAgentGateway gateway({});
+  gateway.SetSupervisionTestHandoffDispatcher(fake.Bind());
+  NativeResponse delivered = HandleSupervisionTestHandoffRequest(
+      gateway, "{\"challenge\":\"" + std::string(kChallenge) +
+                   "\",\"session_id\":\"owner-session\",\"sequence\":1}");
+  ASSERT_EQ(net::HTTP_OK, delivered.status);
+  std::optional<base::DictValue> delivered_json =
+      base::JSONReader::ReadDict(delivered.body, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(delivered_json);
+  EXPECT_EQ(4u, delivered_json->size());
+  EXPECT_EQ(true, delivered_json->FindBool("ok"));
+  EXPECT_EQ("DELIVERED", *delivered_json->FindString("status"));
+  EXPECT_EQ(1, delivered_json->FindInt("sequence"));
+  EXPECT_EQ("ABCD-EFGH", *delivered_json->FindString("pairing_code"));
+  EXPECT_EQ(1u, CountOccurrences(delivered.body, "ABCD-EFGH"));
+  EXPECT_FALSE(ContainsStringRecursively(base::Value(delivered_json->Clone()),
+                                         kChallenge));
+  EXPECT_FALSE(ContainsStringRecursively(base::Value(delivered_json->Clone()),
+                                         "owner-session"));
+
+  NativeResponse health;
+  gateway.HandleNativeRequestForTesting(
+      "/v1/health", {},
+      base::BindOnce(
+          [](NativeResponse* output, int status, std::string body) {
+            ++output->callbacks;
+            output->status = status;
+            output->body = std::move(body);
+          },
+          &health));
+  ASSERT_EQ(net::HTTP_OK, health.status);
+  std::optional<base::Value> health_json =
+      base::JSONReader::Read(health.body, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(health_json);
+  constexpr std::array<std::string_view, 4> kForbiddenHealthSentinels = {
+      kChallenge, "owner-session", "ABCD-EFGH", "/v1/test/supervision-handoff"};
+  for (std::string_view sentinel : kForbiddenHealthSentinels) {
+    EXPECT_FALSE(ContainsStringRecursively(*health_json, sentinel));
+  }
+}
