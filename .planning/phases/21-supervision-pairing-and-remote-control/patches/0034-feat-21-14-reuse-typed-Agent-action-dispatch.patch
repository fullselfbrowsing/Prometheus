-  result.error_code = SupervisionErrorCode::kViewOnly;
-  std::move(callback).Run(std::move(result));
+  if (!callback) {
+    return;
+  }
+  if (pending_action_) {
+    std::move(callback).Run(
+        AdmissionFailure(SupervisionErrorCode::kControllerConflict));
+    return;
+  }
+  const SupervisionActionClassification classification = Classify(action);
+  if (classification == SupervisionActionClassification::kRejected) {
+    std::move(callback).Run(
+        AdmissionFailure(SupervisionErrorCode::kRestrictedTarget));
+    return;
+  }
+
+  SupervisionErrorCode error_code = SupervisionErrorCode::kNone;
+  std::optional<SupervisionActionAuthoritySnapshot> authority =
+      ValidateAuthority(dashboard_session, document_epoch, sequence, nullptr,
+                        &error_code);
+  if (!authority.has_value()) {
+    std::move(callback).Run(AdmissionFailure(error_code));
+    return;
+  }
+
+  auto pending = std::make_unique<PendingAction>();
+  pending->id = ++next_action_id_;
+  pending->action = action;
+  pending->classification = classification;
+  pending->dashboard_session = dashboard_session;
+  pending->document_epoch = std::string(document_epoch);
+  pending->sequence = sequence;
+  pending->admitted_authority = std::move(*authority);
+  pending->completion = std::move(callback);
+  pending->started_at = base::TimeTicks::Now();
+  pending->awaiting_confirmation =
+      classification == SupervisionActionClassification::kConsequential;
+  if (!pending->awaiting_confirmation) {
+    pending->route = BuildAgentRoute(action);
+    if (!pending->route.has_value()) {
+      std::move(pending->completion)
+          .Run(AdmissionFailure(SupervisionErrorCode::kStaleTarget));
+      return;
+    }
+  }
+  pending_action_ = std::move(pending);
+  if (!pending_action_->awaiting_confirmation) {
+    DispatchPendingAction();
+  }
 }
 
 void PrometheusSupervisionActionController::ResolvePendingConfirmation(
     bool allow_once) {
-  static_cast<void>(allow_once);
+  if (!pending_action_ || !pending_action_->awaiting_confirmation) {
+    return;
+  }
+  if (!allow_once) {
+    CompletePendingAction(
+        AdmissionFailure(SupervisionErrorCode::kConfirmationDenied));
+    return;
+  }
+  SupervisionErrorCode error_code = SupervisionErrorCode::kNone;
+  if (!ValidateAuthority(
+          pending_action_->dashboard_session, pending_action_->document_epoch,
+          pending_action_->sequence, &pending_action_->admitted_authority,
+          &error_code)) {
+    CompletePendingAction(AdmissionFailure(error_code));
+    return;
+  }
+  pending_action_->route = BuildAgentRoute(pending_action_->action);
+  if (!pending_action_->route.has_value()) {
+    CompletePendingAction(
+        AdmissionFailure(SupervisionErrorCode::kStaleTarget));
+    return;
+  }
+  pending_action_->awaiting_confirmation = false;
+  DispatchPendingAction();
+}
+
+void PrometheusSupervisionActionController::DispatchPendingAction() {
+  if (!pending_action_ || pending_action_->awaiting_confirmation ||
+      !pending_action_->route.has_value()) {
+    return;
+  }
+  SupervisionErrorCode error_code = SupervisionErrorCode::kNone;
+  if (!ValidateAuthority(
+          pending_action_->dashboard_session, pending_action_->document_epoch,
+          pending_action_->sequence, &pending_action_->admitted_authority,
+          &error_code)) {
+    CompletePendingAction(AdmissionFailure(error_code));
+    return;
+  }
+  if (!route_dispatcher_ || !exact_browser_) {
+    CompletePendingAction(AdmissionFailure(SupervisionErrorCode::kShutdown));
+    return;
+  }
+  const uint64_t action_id = pending_action_->id;
+  route_dispatcher_.Run(
+      exact_browser_.get(), *pending_action_->route,
+      base::BindOnce(
+          &PrometheusSupervisionActionController::OnAgentRouteCompleted,
+          weak_factory_.GetWeakPtr(), action_id));
+}
+
+void PrometheusSupervisionActionController::OnAgentRouteCompleted(
+    uint64_t action_id,
+    AgentRouteResult agent_result) {
+  if (!pending_action_ || pending_action_->id != action_id ||
+      pending_action_->awaiting_confirmation) {
+    return;
+  }
+  SupervisionErrorCode error_code = SupervisionErrorCode::kNone;
+  if (!ValidateAuthority(
+          pending_action_->dashboard_session, pending_action_->document_epoch,
+          pending_action_->sequence, &pending_action_->admitted_authority,
+          &error_code)) {
+    CompletePendingAction(AdmissionFailure(error_code));
+    return;
+  }
+
+  SupervisionActionResult result;
+  result.ok = agent_result.ok;
+  result.state = agent_result.ok ? SupervisionRemoteActionState::kCompleted
+                                 : SupervisionRemoteActionState::kBlocked;
+  result.agent_error_code = agent_result.error_code;
+  CompletePendingAction(std::move(result));
+}
+
+void PrometheusSupervisionActionController::CompletePendingAction(
+    SupervisionActionResult result) {
+  if (!pending_action_) {
+    return;
+  }
+  result.duration = base::TimeTicks::Now() - pending_action_->started_at;
+  CompletionCallback completion = std::move(pending_action_->completion);
+  pending_action_.reset();
+  if (completion) {
+    std::move(completion).Run(std::move(result));
+  }
 }
 
 void PrometheusSupervisionActionController::Cancel(
