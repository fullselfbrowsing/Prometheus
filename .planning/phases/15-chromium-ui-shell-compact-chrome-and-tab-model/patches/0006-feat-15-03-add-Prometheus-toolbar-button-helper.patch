+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/toolbar/prometheus_toolbar_button.h"
+
+#include <utility>
+
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/color/color_id.h"
+#include "ui/views/accessibility/view_accessibility.h"
+
+namespace {
+
+constexpr int kPrometheusToolbarIconSize = 16;
+
+}  // namespace
+
+PrometheusToolbarButton::PrometheusToolbarButton(
+    PrometheusAction action,
+    const std::u16string& accessible_name,
+    PressedCallback callback)
+    : ToolbarButton(std::move(callback)), action_(action) {
+  SetTooltipText(accessible_name);
+  GetViewAccessibility().SetName(accessible_name);
+  UpdatePrometheusIcon();
+}
+
+PrometheusToolbarButton::~PrometheusToolbarButton() = default;
+
+void PrometheusToolbarButton::SetPrometheusActive(bool active) {
+  if (active_ == active) {
+    return;
+  }
+  active_ = active;
+  UpdatePrometheusIcon();
+}
+
+gfx::Size PrometheusToolbarButton::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(kVisualSize, kVisualSize);
+}
+
+gfx::Size PrometheusToolbarButton::GetMinimumSize() const {
+  return gfx::Size(kVisualSize, kVisualSize);
+}
+
+void PrometheusToolbarButton::OnThemeChanged() {
+  ToolbarButton::OnThemeChanged();
+  UpdatePrometheusIcon();
+}
+
+void PrometheusToolbarButton::UpdatePrometheusIcon() {
+  const gfx::VectorIcon* const icon = GetPrometheusActionIconMap().at(action_);
+  const ui::ImageModel normal_icon = ui::ImageModel::FromVectorIcon(
+      *icon, active_ ? kColorPrometheusAccent : kColorPrometheusText2,
+      kPrometheusToolbarIconSize);
+  const ui::ImageModel active_icon = ui::ImageModel::FromVectorIcon(
+      *icon, kColorPrometheusAccent, kPrometheusToolbarIconSize);
+  const ui::ImageModel disabled_icon = ui::ImageModel::FromVectorIcon(
+      *icon, kColorPrometheusText2, kPrometheusToolbarIconSize);
+
+  SetImageModel(ButtonState::STATE_NORMAL, normal_icon);
+  SetImageModel(ButtonState::STATE_HOVERED, active_icon);
+  SetImageModel(ButtonState::STATE_PRESSED, active_icon);
+  SetImageModel(ButtonState::STATE_DISABLED, disabled_icon);
+}
+
+BEGIN_METADATA(PrometheusToolbarButton)
+END_METADATA
