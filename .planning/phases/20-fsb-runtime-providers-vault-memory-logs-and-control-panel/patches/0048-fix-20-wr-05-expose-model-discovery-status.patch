+RuntimeTransportResult PrometheusGatewayDiscoveryTracker::Dispatch(
+    const DiscoverModelsParams& params,
+    std::string_view gateway_session_id,
+    std::string_view caller_id,
+    StartCallback start,
+    StatusCallback status) {
+  if (gateway_session_id.empty() || caller_id.empty()) {
+    return RuntimeTransportResult::Failure(
+        RuntimeRouteName::kDiscoverModels,
+        RuntimeTransportErrorCode::kUnauthorized,
+        "The browser-issued discovery authority is unavailable",
+        "Create a new browser-issued session and retry");
+  }
+  if (params.provider_id.has_value() == params.operation_id.has_value()) {
+    return RuntimeTransportResult::Failure(
+        RuntimeRouteName::kDiscoverModels,
+        RuntimeTransportErrorCode::kInvalidRequest,
+        "The model discovery request was invalid",
+        "Supply exactly one provider_id or operation_id");
+  }
+  if (params.provider_id) {
+    if (!start) {
+      return RuntimeTransportResult::Failure(
+          RuntimeRouteName::kDiscoverModels,
+          RuntimeTransportErrorCode::kCapabilityNotReady,
+          "Model discovery is unavailable",
+          "Retry when provider diagnostics report ready");
+    }
+    RuntimeTransportResult result = start.Run(*params.provider_id);
+    RuntimeModelListResult* payload =
+        result.ok ? std::get_if<RuntimeModelListResult>(&result.payload)
+                  : nullptr;
+    if (result.ok && (!payload || payload->operation_id.empty())) {
+      return RuntimeTransportResult::Failure(
+          RuntimeRouteName::kDiscoverModels,
+          RuntimeTransportErrorCode::kInternal,
+          "The model discovery operation was invalid",
+          "Retry model discovery from the same browser-issued session");
+    }
+    if (payload && payload->pending) {
+      owners_[{std::string(gateway_session_id), payload->operation_id}] =
+          std::string(caller_id);
+    }
+    return result;
+  }
+
+  if (!params.operation_id || !status) {
+    return RuntimeTransportResult::Failure(
+        RuntimeRouteName::kDiscoverModels,
+        RuntimeTransportErrorCode::kInvalidRequest,
+        "The model discovery status request was invalid",
+        "Supply the operation_id returned by discover_models");
+  }
+  OperationKey key{std::string(gateway_session_id), *params.operation_id};
+  auto owner = owners_.find(key);
+  if (owner == owners_.end() || owner->second != caller_id) {
+    return RuntimeTransportResult::Failure(
+        RuntimeRouteName::kDiscoverModels, RuntimeTransportErrorCode::kNotFound,
+        "The caller-owned model discovery was not found",
+        "Start model discovery from this browser-issued session");
+  }
+  RuntimeTransportResult result = status.Run(*params.operation_id);
+  RuntimeModelListResult* payload =
+      result.ok ? std::get_if<RuntimeModelListResult>(&result.payload)
+                : nullptr;
+  if (!payload || payload->operation_id != *params.operation_id ||
+      !payload->pending) {
+    owners_.erase(owner);
+  }
+  if (result.ok && !payload) {
+    return RuntimeTransportResult::Failure(
+        RuntimeRouteName::kDiscoverModels, RuntimeTransportErrorCode::kInternal,
+        "The model discovery status was invalid",
+        "Restart model discovery from the same browser-issued session");
+  }
+  return result;
+}
+
+void PrometheusGatewayDiscoveryTracker::RemoveSession(
+    std::string_view gateway_session_id) {
+  for (auto operation = owners_.begin(); operation != owners_.end();) {
+    if (operation->first.first == gateway_session_id) {
+      operation = owners_.erase(operation);
+    } else {
+      ++operation;
+    }
+  }
+}
