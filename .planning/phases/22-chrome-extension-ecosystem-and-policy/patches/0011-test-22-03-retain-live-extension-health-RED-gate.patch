+TEST(PrometheusGatewayHealthTest,
+     LiveExtensionStateIsOrderedBoundedAndInventoryFree) {
+  constexpr std::array<std::string_view, 10> kExpectedKeys = {
+      "browser",          "bridge",        "active_tab", "content_adapter",
+      "internal_adapter", "webui_adapter", "vault",      "provider",
+      "supervision",      "extensions"};
+  struct ExtensionHealthCase {
+    ExtensionPolicyHealthStatus input_status;
+    AgentDiagnosticStatus expected_status;
+    std::string_view reason;
+    std::string_view recovery;
+  };
+  constexpr std::array<ExtensionHealthCase, 3> kCases = {{
+      {
+          .input_status = ExtensionPolicyHealthStatus::kReady,
+          .expected_status = AgentDiagnosticStatus::kReady,
+          .reason = "extension_policy_ready",
+          .recovery = "No recovery action is required.",
+      },
+      {
+          .input_status = ExtensionPolicyHealthStatus::kDegraded,
+          .expected_status = AgentDiagnosticStatus::kDegraded,
+          .reason = "extension_system_not_ready",
+          .recovery = "Wait for extension startup and try again.",
+      },
+      {
+          .input_status = ExtensionPolicyHealthStatus::kUnavailable,
+          .expected_status = AgentDiagnosticStatus::kUnavailable,
+          .reason = "extension_policy_unavailable",
+          .recovery = "Open Extension policy and try again.",
+      },
+  }};
+
+  for (const ExtensionHealthCase& test_case : kCases) {
+    SCOPED_TRACE(test_case.reason);
+    RuntimeGatewayHealthState runtime_health;
+    runtime_health.extension_health = ExtensionPolicyHealth{
+        test_case.input_status,
+        std::string(test_case.reason),
+        std::string(test_case.recovery),
+    };
+    AgentRouteResult result = BuildPrometheusGatewayHealthForTesting(
+        /*active_regular=*/true, runtime_health);
+    ASSERT_TRUE(result.ok);
+    ASSERT_EQ(kExpectedKeys.size(), result.diagnostics.size());
+
+    std::vector<std::string_view> actual_keys;
+    actual_keys.reserve(result.diagnostics.size());
+    for (const AgentDiagnosticComponent& component : result.diagnostics) {
+      actual_keys.push_back(component.key);
+    }
+    EXPECT_TRUE(std::ranges::equal(actual_keys, kExpectedKeys));
+    EXPECT_EQ(actual_keys.size(),
+              std::set<std::string_view>(actual_keys.begin(), actual_keys.end())
+                  .size());
+
+    const AgentDiagnosticComponent& extension = result.diagnostics.back();
+    ASSERT_EQ("extensions", extension.key);
+    EXPECT_EQ(test_case.expected_status, extension.status);
+    EXPECT_EQ(test_case.reason, extension.reason);
+    EXPECT_EQ(test_case.recovery, extension.next_action);
+    EXPECT_LE(extension.reason.size(), kMaxExtensionPolicyReasonBytes);
+    EXPECT_LE(extension.next_action.size(), kMaxExtensionPolicyRecoveryBytes);
+
+    auto serialized = SerializeAgentTransportResult(result);
+    ASSERT_TRUE(serialized.has_value());
+    auto parsed = base::JSONReader::Read(*serialized, base::JSON_PARSE_RFC);
+    ASSERT_TRUE(parsed.has_value());
+    for (std::string_view sentinel :
+         {"abcdefghijklmnopabcdefghijklmnop",
+          "Installed extension inventory sentinel", "manifest_permissions",
+          "https://private-origin.example", "page-content-sentinel",
+          "form-value-sentinel", "script-source-sentinel",
+          "/Users/private/profile", "browser-session-sentinel",
+          "bearer-authority-sentinel", "Interact"}) {
+      EXPECT_FALSE(ContainsStringRecursively(*parsed, sentinel)) << sentinel;
+    }
+  }
+
+  RuntimeGatewayHealthState bounded;
+  bounded.extension_health = ExtensionPolicyHealth{
+      ExtensionPolicyHealthStatus::kReady,
+      std::string(kMaxExtensionPolicyReasonBytes, 'r'),
+      std::string(kMaxExtensionPolicyRecoveryBytes, 'x'),
+  };
+  AgentRouteResult at_limit = BuildPrometheusGatewayHealthForTesting(
+      /*active_regular=*/true, bounded);
+  ASSERT_EQ(10u, at_limit.diagnostics.size());
+  EXPECT_EQ(bounded.extension_health.reason,
+            at_limit.diagnostics.back().reason);
+  EXPECT_EQ(bounded.extension_health.recovery,
+            at_limit.diagnostics.back().next_action);
+
+  bounded.extension_health.reason.push_back('r');
+  bounded.extension_health.recovery.push_back('x');
+  AgentRouteResult over_limit = BuildPrometheusGatewayHealthForTesting(
+      /*active_regular=*/true, bounded);
+  ASSERT_EQ(10u, over_limit.diagnostics.size());
+  EXPECT_LE(over_limit.diagnostics.back().reason.size(),
+            kMaxExtensionPolicyReasonBytes);
+  EXPECT_LE(over_limit.diagnostics.back().next_action.size(),
+            kMaxExtensionPolicyRecoveryBytes);
+
+  bounded.extension_health = ExtensionPolicyHealth{
+      static_cast<ExtensionPolicyHealthStatus>(255),
+      "Bearer bearer-authority-sentinel",
+      "Reveal extension id abcdefghijklmnopabcdefghijklmnop",
+  };
+  AgentRouteResult malformed = BuildPrometheusGatewayHealthForTesting(
+      /*active_regular=*/true, bounded);
+  ASSERT_EQ(10u, malformed.diagnostics.size());
+  EXPECT_EQ(AgentDiagnosticStatus::kUnavailable,
+            malformed.diagnostics.back().status);
+  EXPECT_EQ(kExtensionPolicyReasonFallback,
+            malformed.diagnostics.back().reason);
+  EXPECT_EQ(kExtensionPolicyRecoveryFallback,
+            malformed.diagnostics.back().next_action);
+  auto malformed_serialized = SerializeAgentTransportResult(malformed);
+  ASSERT_TRUE(malformed_serialized.has_value());
+  EXPECT_EQ(std::string::npos,
+            malformed_serialized->find("bearer-authority-sentinel"));
+  EXPECT_EQ(std::string::npos,
+            malformed_serialized->find("abcdefghijklmnopabcdefghijklmnop"));
+}
