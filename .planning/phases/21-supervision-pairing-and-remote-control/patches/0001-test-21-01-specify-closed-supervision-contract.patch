+#define EXPECT_SUPERVISION_CAP(field, default_value, hard_value)     \
+  do {                                                               \
+    SupervisionLimits at_cap;                                        \
+    at_cap.field = hard_value;                                       \
+    EXPECT_EQ(hard_value, ClampSupervisionLimits(at_cap).field);     \
+    SupervisionLimits over_cap;                                      \
+    over_cap.field = hard_value + 1;                                 \
+    EXPECT_EQ(hard_value, ClampSupervisionLimits(over_cap).field);   \
+    SupervisionLimits invalid;                                       \
+    invalid.field = 0;                                               \
+    EXPECT_EQ(default_value, ClampSupervisionLimits(invalid).field); \
+  } while (false)
+
