+// Waits for a live regular, non-OTR, disposable-profile normal Browser
+// window to exist, then reports it exactly once through `ready`. Reuses
+// IsDisposableSupervisionTestProfile()'s profile classification --
+// "disposable" means only "this profile's directory lives under the OS temp
+// directory", which is not specific to supervision.
+class PrometheusBrowserMainExtraParts::ExtensionSmokeBrowserWaiter
+    : public BrowserCollectionObserver {
+ public:
+  explicit ExtensionSmokeBrowserWaiter(
+      base::OnceCallback<void(Profile*, Browser*)> ready)
+      : ready_(std::move(ready)) {
+    collection_observation_.Observe(GlobalBrowserCollection::GetInstance());
+  }
+  ExtensionSmokeBrowserWaiter(const ExtensionSmokeBrowserWaiter&) = delete;
+  ExtensionSmokeBrowserWaiter& operator=(const ExtensionSmokeBrowserWaiter&) =
+      delete;
+  ~ExtensionSmokeBrowserWaiter() override = default;
+
+  // Scans browsers that already exist at construction time. Must be called
+  // only after the owner has already stored `this` in its final location:
+  // a match runs `ready_` synchronously, which may destroy `this`.
+  void CheckExistingBrowsers() {
+    GlobalBrowserCollection::GetInstance()->ForEach(
+        [this](BrowserWindowInterface* browser_window) {
+          return !MaybeReport(browser_window);
+        });
+  }
+
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser_window) override {
+    MaybeReport(browser_window);
+  }
+
+ private:
+  bool MaybeReport(BrowserWindowInterface* browser_window) {
+    if (!ready_ || !browser_window ||
+        browser_window->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+      return false;
+    }
+    Profile* const profile = browser_window->GetProfile();
+    Browser* const browser = browser_window->GetBrowserForMigrationOnly();
+    if (!profile || !browser || !profile->IsRegularProfile() ||
+        profile->IsOffTheRecord() ||
+        !IsDisposableSupervisionTestProfile(profile)) {
+      return false;
+    }
+    std::move(ready_).Run(profile, browser);
+    return true;
+  }
+
+  base::OnceCallback<void(Profile*, Browser*)> ready_;
+  // BrowserCollection::AddObserver()/RemoveObserver() are protected and
+  // friended only for base::ScopedObservationTraits<BrowserCollection,
+  // BrowserCollectionObserver> (not the GlobalBrowserCollection subclass), so
+  // the observation is templated on the base type; GlobalBrowserCollection*
+  // still implicitly upcasts when passed to Observe() below.
+  base::ScopedObservation<BrowserCollection, BrowserCollectionObserver>
+      collection_observation_{this};
+};
