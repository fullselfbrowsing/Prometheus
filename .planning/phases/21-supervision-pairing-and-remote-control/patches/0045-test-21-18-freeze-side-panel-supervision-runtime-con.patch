+constexpr std::array<std::string_view, 11> kRejectedTitleFragments = {
+    "://",       "session", "controller", "owner",    "token", "secret",
+    "password",  "pairing", "principal",  "document", "selector",
+};
+
+bool HasRejectedTitleCharacter(char16_t character) {
+  return character < 0x20 || character == 0x7f || character == u'/' ||
+         character == u'\\' || character == u'?' || character == u'#' ||
+         (character >= 0x202a && character <= 0x202e) ||
+         (character >= 0x2066 && character <= 0x2069);
+}
+
+std::string_view SupervisionActivityValue(
+    PrometheusSidePanelSupervisionActivity activity) {
+  switch (activity) {
+    case PrometheusSidePanelSupervisionActivity::kViewing:
+      return "viewing";
+    case PrometheusSidePanelSupervisionActivity::kControlReady:
+      return "control_ready";
+    case PrometheusSidePanelSupervisionActivity::kValidatingRemoteAction:
+      return "validating_remote_action";
+    case PrometheusSidePanelSupervisionActivity::kRemoteAction:
+      return "remote_action";
+    case PrometheusSidePanelSupervisionActivity::kConfirmationRequired:
+      return "confirmation_required";
+    case PrometheusSidePanelSupervisionActivity::kResyncing:
+      return "resyncing";
+    case PrometheusSidePanelSupervisionActivity::kPausedForResync:
+      return "paused_for_resync";
+    case PrometheusSidePanelSupervisionActivity::kRemoteActionBlocked:
+      return "remote_action_blocked";
+    case PrometheusSidePanelSupervisionActivity::kStoppingControl:
+      return "stopping_control";
+  }
+}
+
+std::string_view SupervisionActionCategoryValue(
+    PrometheusSidePanelSupervisionActionCategory category) {
+  switch (category) {
+    case PrometheusSidePanelSupervisionActionCategory::kClick:
+      return "click";
+    case PrometheusSidePanelSupervisionActionCategory::kType:
+      return "type";
+    case PrometheusSidePanelSupervisionActionCategory::kKeyPress:
+      return "key_press";
+    case PrometheusSidePanelSupervisionActionCategory::kScroll:
+      return "scroll";
+    case PrometheusSidePanelSupervisionActionCategory::kHover:
+      return "hover";
+    case PrometheusSidePanelSupervisionActionCategory::kSelect:
+      return "select";
+    case PrometheusSidePanelSupervisionActionCategory::kClear:
+      return "clear";
+    case PrometheusSidePanelSupervisionActionCategory::kDrag:
+      return "drag";
+    case PrometheusSidePanelSupervisionActionCategory::kDrop:
+      return "drop";
+    case PrometheusSidePanelSupervisionActionCategory::kNavigate:
+      return "navigate";
+  }
+}
+
+base::DictValue UnavailableSupervisionOperation() {
+  base::DictValue value;
+  value.Set("status", "NOT_READY");
+  value.Set("accepted", false);
+  value.Set("recovery", "Use a live supervised tab in this window");
+  return value;
+}
+
 }  // namespace
 
+std::string SanitizeSidePanelSupervisionTargetTitle(
+    std::u16string_view title) {
+  std::u16string candidate(title);
+  base::TrimWhitespace(candidate, base::TRIM_ALL, &candidate);
+  if (candidate.empty() ||
+      std::ranges::any_of(candidate, HasRejectedTitleCharacter)) {
+    return "this tab";
+  }
+
+  const std::string lower = base::ToLowerASCII(base::UTF16ToUTF8(candidate));
+  if (std::ranges::any_of(kRejectedTitleFragments,
+                          [&lower](std::string_view fragment) {
+                            return lower.find(fragment) != std::string::npos;
+                          })) {
+    return "this tab";
+  }
+
+  if (candidate.size() > kMaxSidePanelSafeTargetTitleCharacters) {
+    candidate.resize(kMaxSidePanelSafeTargetTitleCharacters);
+  }
+  return base::UTF16ToUTF8(candidate);
+}
+
+base::DictValue SidePanelSupervisionSnapshotValue(
+    const PrometheusSidePanelSupervisionSnapshot& snapshot) {
+  base::DictValue value;
+  value.Set("available", snapshot.available);
+  value.Set("viewer_count", static_cast<int>(snapshot.viewer_count));
+  value.Set("controlled", snapshot.controlled);
+  if (snapshot.client_label.has_value()) {
+    value.Set("client_label", *snapshot.client_label);
+  }
+  value.Set("activity", SupervisionActivityValue(snapshot.activity));
+  if (snapshot.action_category.has_value()) {
+    value.Set("action_category",
+              SupervisionActionCategoryValue(*snapshot.action_category));
+  }
+  value.Set("resyncing", snapshot.resyncing);
+  value.Set("stopping", snapshot.stopping);
+  value.Set("ending", snapshot.ending);
+  value.Set("safe_target_title", snapshot.safe_target_title);
+  return value;
+}
+
+base::DictValue PrometheusSidePanelRuntime::StopSupervisionControl() {
+  return UnavailableSupervisionOperation();
+}
+
+base::DictValue PrometheusSidePanelRuntime::EndSelectedTabSupervision() {
+  return UnavailableSupervisionOperation();
+}
+
+base::DictValue PrometheusSidePanelRuntime::OpenSupervisionManagement() {
+  return UnavailableSupervisionOperation();
+}
+
 void SetPrometheusSidePanelRuntimeFactory(
     PrometheusSidePanelRuntimeFactory factory) {
   RuntimeFactory() = std::move(factory);
