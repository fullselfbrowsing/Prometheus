+PrometheusSupervisionProfileService::PendingPairing*
+PrometheusSupervisionProfileService::FindPendingPairing(
+    std::string_view normalized_code) {
+  if (!IsValidSupervisionPairingCode(normalized_code)) {
+    return nullptr;
+  }
+  PendingPairing* match = nullptr;
+  for (auto& [stable_tab_id, pairing] : pending_pairings_) {
+    const std::string candidate = PairingDigest(pairing->salt, normalized_code);
+    if (DigestsEqual(candidate, pairing->digest)) {
+      match = pairing.get();
+    }
+  }
+  return match;
+}
