+  bool focused = false;
+  std::string entry_id;
+  std::string request_hash;
+  uint64_t generation = 0;
+  base::Time expires_at;
+  bool consumed = false;
+
+  bool operator==(const PrometheusVaultConfirmationBinding&) const = default;
+};
+
+struct PrometheusVaultUseResult {
+  PrometheusVaultStatus status = PrometheusVaultStatus::kInvalidArgument;
+
+  bool ok() const { return status == PrometheusVaultStatus::kSuccess; }
+};
