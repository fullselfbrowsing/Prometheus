index 1534c2bb10..80f0d28829 100644
--- a/chrome/browser/ui/views/prometheus/prometheus_toolbar_entrypoint_browsertest.cc
+++ b/chrome/browser/ui/views/prometheus/prometheus_toolbar_entrypoint_browsertest.cc
@@ -2,21 +2,70 @@
