@@ -0,0 +1,232 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_extension_policy_service.h"
+
+#include <string>
+
+#include "base/strings/string_util.h"
+#include "chrome/browser/prometheus/prometheus_extension_policy_prefs.h"
+#include "chrome/browser/prometheus/prometheus_extension_policy_service_factory.h"
+#include "components/crx_file/id_util.h"
+#include "components/sync_preferences/testing_pref_service_syncable.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace prometheus {
+namespace {
+
+constexpr char kFirstExtensionId[] = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+constexpr char kSecondExtensionId[] = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
+
+void RequireGreenContract() {
+  ASSERT_TRUE(ExtensionPolicyContractImplementedForTesting())
+      << "retained RED: bounded extension policy behavior is not implemented";
+}
+
+TEST(PrometheusExtensionPolicyTypesTest,
+     GrantLabelsAreBlockedReadOnlyAndInteract) {
+  RequireGreenContract();
+  EXPECT_EQ("Blocked",
+            ExtensionAgentGrantToString(ExtensionAgentGrant::kBlocked));
+  EXPECT_EQ("Read only",
+            ExtensionAgentGrantToString(ExtensionAgentGrant::kReadOnly));
+  EXPECT_EQ("Interact",
+            ExtensionAgentGrantToString(ExtensionAgentGrant::kInteract));
+  EXPECT_EQ(ExtensionAgentGrant::kBlocked,
+            ExtensionAgentGrantFromString("Blocked"));
+  EXPECT_EQ(ExtensionAgentGrant::kReadOnly,
+            ExtensionAgentGrantFromString("Read only"));
+  EXPECT_EQ(ExtensionAgentGrant::kInteract,
+            ExtensionAgentGrantFromString("Interact"));
+  EXPECT_EQ(std::nullopt, ExtensionAgentGrantFromString("allow"));
+}
+
+TEST(PrometheusExtensionPolicyTypesTest,
+     BothDefaultsAreBlockedAndPrivateNeverExceedsRegular) {
+  RequireGreenContract();
+  EXPECT_EQ(ExtensionAgentGrant::kBlocked, ExtensionPolicyChoice().regular);
+  EXPECT_EQ(ExtensionAgentGrant::kBlocked,
+            ExtensionPolicyChoice().private_mode);
+  EXPECT_EQ(ExtensionAgentGrant::kBlocked,
+            ClampPrivateExtensionGrant(ExtensionAgentGrant::kBlocked,
+                                       ExtensionAgentGrant::kInteract));
+  EXPECT_EQ(ExtensionAgentGrant::kReadOnly,
+            ClampPrivateExtensionGrant(ExtensionAgentGrant::kReadOnly,
+                                       ExtensionAgentGrant::kInteract));
+  EXPECT_EQ(ExtensionAgentGrant::kInteract,
+            ClampPrivateExtensionGrant(ExtensionAgentGrant::kInteract,
+                                       ExtensionAgentGrant::kInteract));
+}
+
+TEST(PrometheusExtensionPolicyBoundsTest, NamesAtAndOverLimitAreUtf8Bounded) {
+  RequireGreenContract();
+  const std::string at_limit(kMaxExtensionPolicyNameBytes, 'n');
+  const std::string over_limit(kMaxExtensionPolicyNameBytes + 1, 'n');
+  EXPECT_EQ(at_limit, SanitizeExtensionPolicyName(at_limit));
+  EXPECT_EQ(kMaxExtensionPolicyNameBytes,
+            SanitizeExtensionPolicyName(over_limit).size());
+  EXPECT_EQ(kExtensionPolicyNameFallback,
+            SanitizeExtensionPolicyName("\xff"));
+}
+
+TEST(PrometheusExtensionPolicyBoundsTest,
+     IdSuffixesAtAndOverLimitNeverExposeFullIdentity) {
+  RequireGreenContract();
+  EXPECT_EQ("aaaaaa", ExtensionPolicyIdSuffix(kFirstExtensionId));
+  EXPECT_EQ(kExtensionPolicyIdSuffixBytes,
+            ExtensionPolicyIdSuffix(kFirstExtensionId).size());
+  EXPECT_TRUE(ExtensionPolicyIdSuffix("short").empty());
+  EXPECT_NE(kFirstExtensionId, ExtensionPolicyIdSuffix(kFirstExtensionId));
+}
+
+TEST(PrometheusExtensionPolicyBoundsTest, ReasonsAtAndOverLimitAreBounded) {
+  RequireGreenContract();
+  const std::string at_limit(kMaxExtensionPolicyReasonBytes, 'r');
+  const std::string over_limit(kMaxExtensionPolicyReasonBytes + 1, 'r');
+  EXPECT_EQ(at_limit, SanitizeExtensionPolicyReason(at_limit));
+  EXPECT_EQ(kMaxExtensionPolicyReasonBytes,
+            SanitizeExtensionPolicyReason(over_limit).size());
+  EXPECT_EQ(kExtensionPolicyReasonFallback,
+            SanitizeExtensionPolicyReason("installed extension id"));
+}
+
+TEST(PrometheusExtensionPolicyBoundsTest,
+     RecoveryTextAtAndOverLimitIsBounded) {
+  RequireGreenContract();
+  const std::string at_limit(kMaxExtensionPolicyRecoveryBytes, 'r');
+  const std::string over_limit(kMaxExtensionPolicyRecoveryBytes + 1, 'r');
+  EXPECT_EQ(at_limit, SanitizeExtensionPolicyRecovery(at_limit));
+  EXPECT_EQ(kMaxExtensionPolicyRecoveryBytes,
+            SanitizeExtensionPolicyRecovery(over_limit).size());
+  EXPECT_EQ(kExtensionPolicyRecoveryFallback,
+            SanitizeExtensionPolicyRecovery("bearer token"));
+}
+
+TEST(PrometheusExtensionPolicyPrefsTest,
+     EntriesAtAndOverLimitPruneDeterministically) {
+  RequireGreenContract();
+  sync_preferences::TestingPrefServiceSyncable prefs;
+  RegisterPrometheusExtensionPolicyProfilePrefs(prefs.registry());
+  ExtensionPolicyChoices choices;
+  for (size_t index = 0; index < kMaxExtensionPolicyEntries + 1; ++index) {
+    choices.emplace(crx_file::id_util::GenerateId("entry-" +
+                                                  std::to_string(index)),
+                    ExtensionPolicyChoice{ExtensionAgentGrant::kInteract,
+                                          ExtensionAgentGrant::kReadOnly});
+  }
+  WritePrometheusExtensionPolicyChoices(prefs, choices);
+  const ExtensionPolicyChoices stored =
+      ReadPrometheusExtensionPolicyChoices(prefs);
+  EXPECT_EQ(kMaxExtensionPolicyEntries, stored.size());
+  EXPECT_EQ(choices.begin()->first, stored.begin()->first);
+}
+
+TEST(PrometheusExtensionPolicyPrefsTest,
+     RejectsUnknownSchemaEnumsAndKeys) {
+  RequireGreenContract();
+  sync_preferences::TestingPrefServiceSyncable prefs;
+  RegisterPrometheusExtensionPolicyProfilePrefs(prefs.registry());
+  base::DictValue grants;
+  grants.Set(kFirstExtensionId,
+             base::DictValue()
+                 .Set("regular", "Interact")
+                 .Set("private", "Blocked")
+                 .Set("authority", "unexpected"));
+  base::DictValue root;
+  root.Set("schema_version", kPrometheusExtensionPolicySchemaVersion + 1);
+  root.Set("grants", std::move(grants));
+  prefs.SetUserPref(kPrometheusExtensionPolicyProfileData, std::move(root));
+  EXPECT_TRUE(ReadPrometheusExtensionPolicyChoices(prefs).empty());
+
+  root.Set("schema_version", kPrometheusExtensionPolicySchemaVersion);
+  root.Set("unknown", true);
+  root.Set("grants",
+           base::DictValue().Set(
+               kSecondExtensionId,
+               base::DictValue()
+                   .Set("regular", "Owner")
+                   .Set("private", "Blocked")));
+  prefs.SetUserPref(kPrometheusExtensionPolicyProfileData, std::move(root));
+  EXPECT_TRUE(ReadPrometheusExtensionPolicyChoices(prefs).empty());
+}
+
+TEST(PrometheusExtensionPolicySnapshotTest,
+     SnapshotRowsAtAndOverLimitAreOrdinalAndGenerationBound) {
+  RequireGreenContract();
+  ExtensionPolicySnapshot snapshot;
+  snapshot.generation = 7;
+  for (size_t index = 0; index < kMaxExtensionPolicySnapshotRows; ++index) {
+    ExtensionPolicyRow row;
+    row.name = "Extension";
+    row.id_suffix = "aaaaaa";
+    row.ordinal = index;
+    row.generation = snapshot.generation;
+    snapshot.rows.push_back(std::move(row));
+  }
+  EXPECT_EQ(kMaxExtensionPolicySnapshotRows, snapshot.rows.size());
+  EXPECT_EQ(0u, snapshot.rows.front().ordinal);
+  EXPECT_EQ(kMaxExtensionPolicySnapshotRows - 1,
+            snapshot.rows.back().ordinal);
+  EXPECT_EQ(7u, snapshot.rows.back().generation);
+}
+
+TEST(PrometheusExtensionPolicySnapshotTest,
+     SanitizedRowsOmitFullIdsContentPermissionsAndAuthority) {
+  RequireGreenContract();
+  ExtensionPolicyRow row;
+  row.name = "Synthetic extension";
+  row.id_suffix = "aaaaaa";
+  row.source = ExtensionPolicySource::kUnpacked;
+  row.enabled = true;
+  row.manifest_version = 3;
+  row.native_private_eligible = true;
+  row.requested_regular = ExtensionAgentGrant::kInteract;
+  row.effective_regular = ExtensionAgentGrant::kInteract;
+  row.ordinal = 3;
+  row.generation = 9;
+  const std::optional<base::DictValue> value =
+      ExtensionPolicyRowToValue(row);
+  ASSERT_TRUE(value);
+  EXPECT_EQ(nullptr, value->Find("extension_id"));
+  EXPECT_EQ(nullptr, value->Find("permissions"));
+  EXPECT_EQ(nullptr, value->Find("content"));
+  EXPECT_EQ(nullptr, value->Find("profile_path"));
+  EXPECT_EQ(nullptr, value->Find("authority"));
+  ASSERT_NE(nullptr, value->FindString("id_suffix"));
+  EXPECT_EQ("aaaaaa", *value->FindString("id_suffix"));
+}
+
+TEST(PrometheusExtensionPolicyHealthTest,
+     ExternalHealthIsBoundedAndInventoryFree) {
+  RequireGreenContract();
+  ExtensionPolicyHealth health;
+  health.status = ExtensionPolicyHealthStatus::kDegraded;
+  health.reason = "web_store_unverified";
+  health.recovery = "Use developer mode to load an unpacked extension.";
+  const std::optional<base::DictValue> value =
+      ExtensionPolicyHealthToValue(health);
+  ASSERT_TRUE(value);
+  EXPECT_EQ(3u, value->size());
+  ASSERT_NE(nullptr, value->FindString("status"));
+  EXPECT_EQ("degraded", *value->FindString("status"));
+  EXPECT_EQ(nullptr, value->Find("installed_count"));
+  EXPECT_EQ(nullptr, value->Find("rows"));
+  EXPECT_EQ(nullptr, value->Find("extension_id"));
+}
+
+TEST(PrometheusExtensionPolicyFactoryTest,
+     FactoryIsRegularOnlyAndDependsOnNativeAuthorities) {
+  RequireGreenContract();
+  EXPECT_TRUE(PrometheusExtensionPolicyServiceFactory::
+                  IsRegularProfileEligibleForTesting(false));
+  EXPECT_FALSE(PrometheusExtensionPolicyServiceFactory::
+                   IsRegularProfileEligibleForTesting(true));
+  EXPECT_TRUE(PrometheusExtensionPolicyServiceFactory::
+                  HasChromeExtensionSystemDependencyForTesting());
+  EXPECT_TRUE(PrometheusExtensionPolicyServiceFactory::
+                  HasExtensionRegistryDependencyForTesting());
+}
+
