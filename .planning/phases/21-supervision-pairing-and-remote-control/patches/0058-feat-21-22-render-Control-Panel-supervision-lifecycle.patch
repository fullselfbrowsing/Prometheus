   const setChecked = (selector, checked) => {
     const input = document.querySelector(selector);
@@ -1596,7 +1605,7 @@ function renderControlPermissions() {
   setChecked('#control-vault-native-only', policy.vault_native_only);
   setChecked(
       '#control-vault-confirm-each-use', policy.vault_confirm_each_use);
-  setChecked('#control-supervision-ready', false);
