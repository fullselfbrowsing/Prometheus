+                         kDefaultSupervisionPairingCodeTtlMs,
+                         kHardSupervisionPairingCodeTtlMs);
+  EXPECT_SUPERVISION_CAP(viewer_ttl_ms, kDefaultSupervisionViewerTtlMs,
+                         kHardSupervisionViewerTtlMs);
+  EXPECT_SUPERVISION_CAP(viewers_per_tab, kDefaultSupervisionViewersPerTab,
+                         kHardSupervisionViewersPerTab);
+  EXPECT_SUPERVISION_CAP(sessions_per_profile,
+                         kDefaultSupervisionSessionsPerProfile,
+                         kHardSupervisionSessionsPerProfile);
+  EXPECT_SUPERVISION_CAP(attempts_per_code, kDefaultSupervisionAttemptsPerCode,
+                         kHardSupervisionAttemptsPerCode);
+  EXPECT_SUPERVISION_CAP(baseline_nodes, kDefaultSupervisionBaselineNodes,
+                         kHardSupervisionBaselineNodes);
+  EXPECT_SUPERVISION_CAP(baseline_bytes, kDefaultSupervisionBaselineBytes,
+                         kHardSupervisionBaselineBytes);
+  EXPECT_SUPERVISION_CAP(diff_operations, kDefaultSupervisionDiffOperations,
+                         kHardSupervisionDiffOperations);
+  EXPECT_SUPERVISION_CAP(diff_bytes, kDefaultSupervisionDiffBytes,
+                         kHardSupervisionDiffBytes);
+  EXPECT_SUPERVISION_CAP(retained_batches, kDefaultSupervisionRetainedBatches,
+                         kHardSupervisionRetainedBatches);
+  EXPECT_SUPERVISION_CAP(retained_bytes_per_viewer,
+                         kDefaultSupervisionRetainedBytesPerViewer,
