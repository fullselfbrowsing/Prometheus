+TEST(PrometheusAgentGatewayTest,
+     SupervisionTestHandoffSourceLayersStayConditionalAndDependencyNeutral) {
+  const std::optional<std::string> gateway_header =
+      ReadPrometheusSource("prometheus_agent_gateway.h");
+  const std::optional<std::string> gateway_source =
+      ReadPrometheusSource("prometheus_agent_gateway.cc");
+  const std::optional<std::string> contract_header =
+      ReadPrometheusSource("prometheus_agent_gateway_contract.h");
+  const std::optional<std::string> contract_source =
+      ReadPrometheusSource("prometheus_agent_gateway_contract.cc");
+  const std::optional<std::string> supervision_codec =
+      ReadPrometheusSource("prometheus_supervision_transport_codec.cc");
+  const std::optional<std::string> agent_codec =
+      ReadPrometheusSource("prometheus_agent_transport_codec.cc");
+  ASSERT_TRUE(gateway_header);
+  ASSERT_TRUE(gateway_source);
+  ASSERT_TRUE(contract_header);
+  ASSERT_TRUE(contract_source);
+  ASSERT_TRUE(supervision_codec);
+  ASSERT_TRUE(agent_codec);
+
+  constexpr std::string_view kValidator =
+      "ValidatePrometheusAgentGatewayRequestForTesting";
+  EXPECT_EQ(0u, CountOccurrences(*gateway_header, kValidator));
+  EXPECT_EQ(1u, CountOccurrences(*contract_header, kValidator));
+  EXPECT_EQ(1u, CountOccurrences(*contract_source, kValidator));
+  EXPECT_EQ(2u, CountOccurrences(*gateway_source, kValidator));
+  EXPECT_EQ(0u,
+            CountOccurrences(*gateway_header, "/v1/test/supervision-handoff"));
+  EXPECT_EQ(1u,
+            CountOccurrences(*gateway_source, "/v1/test/supervision-handoff"));
+  EXPECT_EQ(1u,
+            CountOccurrences(*contract_source, "/v1/test/supervision-handoff"));
+
+  for (std::string_view forbidden_include :
+       {"prometheus_supervision_test_bootstrap.h",
+        "prometheus_supervision_profile_service.h",
+        "prometheus_supervision_profile_service_factory.h",
+        "prometheus_runtime_dialogs.h"}) {
+    EXPECT_EQ(std::string::npos, gateway_header->find(forbidden_include));
+    EXPECT_EQ(std::string::npos, gateway_source->find(forbidden_include));
+  }
+  EXPECT_EQ(std::string::npos,
+            supervision_codec->find("/v1/test/supervision-handoff"));
+  EXPECT_EQ(std::string::npos,
+            agent_codec->find("/v1/test/supervision-handoff"));
+}
