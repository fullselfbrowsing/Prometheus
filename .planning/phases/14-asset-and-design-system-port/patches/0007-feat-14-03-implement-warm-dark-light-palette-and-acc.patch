 #ifndef CHROME_BROWSER_UI_COLOR_PROMETHEUS_COLOR_MIXER_H_
 #define CHROME_BROWSER_UI_COLOR_PROMETHEUS_COLOR_MIXER_H_
 
+#include "third_party/skia/include/core/SkColor.h"
