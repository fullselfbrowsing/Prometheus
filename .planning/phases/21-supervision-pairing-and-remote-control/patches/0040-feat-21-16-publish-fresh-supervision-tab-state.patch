diff --git a/chrome/browser/prometheus/prometheus_tab_state.cc b/chrome/browser/prometheus/prometheus_tab_state.cc
index 19ae24e3ab..df780d2ea5 100644
--- a/chrome/browser/prometheus/prometheus_tab_state.cc
+++ b/chrome/browser/prometheus/prometheus_tab_state.cc
@@ -4,10 +4,125 @@
 
 #include "chrome/browser/prometheus/prometheus_tab_state.h"
 
+#include <algorithm>
+#include <set>
+#include <string_view>
+#include <vector>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
 #include "chrome/browser/prometheus/prometheus_agent_tab_data.h"
 #include "chrome/browser/prometheus/prometheus_supervision_types.h"
 #include "components/tabs/public/tab_interface.h"
 
+namespace {
+
+using TabSupervision = PrometheusTabState::Supervision;
+
+bool IsActiveViewerState(prometheus::SupervisionViewerState state) {
+  return state == prometheus::SupervisionViewerState::kViewOnly ||
+         state == prometheus::SupervisionViewerState::kController;
+}
+
+TabSupervision::ActivityState ProjectActivityState(
+    prometheus::SupervisionRemoteActionState state) {
+  switch (state) {
+    case prometheus::SupervisionRemoteActionState::kIdle:
+      return TabSupervision::ActivityState::kNone;
+    case prometheus::SupervisionRemoteActionState::kValidating:
+      return TabSupervision::ActivityState::kValidating;
+    case prometheus::SupervisionRemoteActionState::kExecuting:
+      return TabSupervision::ActivityState::kExecuting;
+    case prometheus::SupervisionRemoteActionState::kAwaitingConfirmation:
+      return TabSupervision::ActivityState::kAwaitingConfirmation;
+    case prometheus::SupervisionRemoteActionState::kVerifying:
+      return TabSupervision::ActivityState::kVerifying;
+    case prometheus::SupervisionRemoteActionState::kCompleted:
+      return TabSupervision::ActivityState::kCompleted;
+    case prometheus::SupervisionRemoteActionState::kBlocked:
+      return TabSupervision::ActivityState::kBlocked;
+    case prometheus::SupervisionRemoteActionState::kFailed:
+      return TabSupervision::ActivityState::kFailed;
+  }
+}
+
+TabSupervision::ActionCategory ProjectActionCategory(
+    prometheus::SupervisionRemoteActionCategory category) {
+  switch (category) {
+    case prometheus::SupervisionRemoteActionCategory::kClick:
+      return TabSupervision::ActionCategory::kClick;
+    case prometheus::SupervisionRemoteActionCategory::kType:
+      return TabSupervision::ActionCategory::kType;
+    case prometheus::SupervisionRemoteActionCategory::kKeyPress:
+      return TabSupervision::ActionCategory::kKeyPress;
+    case prometheus::SupervisionRemoteActionCategory::kScroll:
+      return TabSupervision::ActionCategory::kScroll;
+    case prometheus::SupervisionRemoteActionCategory::kHover:
+      return TabSupervision::ActionCategory::kHover;
+    case prometheus::SupervisionRemoteActionCategory::kSelect:
+      return TabSupervision::ActionCategory::kSelect;
+    case prometheus::SupervisionRemoteActionCategory::kClear:
+      return TabSupervision::ActionCategory::kClear;
+    case prometheus::SupervisionRemoteActionCategory::kDrag:
+      return TabSupervision::ActionCategory::kDrag;
+    case prometheus::SupervisionRemoteActionCategory::kDrop:
+      return TabSupervision::ActionCategory::kDrop;
+    case prometheus::SupervisionRemoteActionCategory::kNavigate:
+      return TabSupervision::ActionCategory::kNavigate;
+  }
+}
+
+int ResyncRank(TabSupervision::ResyncState state) {
+  switch (state) {
+    case TabSupervision::ResyncState::kNone:
+      return 0;
+    case TabSupervision::ResyncState::kPreparing:
+      return 1;
+    case TabSupervision::ResyncState::kResyncing:
+      return 2;
+    case TabSupervision::ResyncState::kPaused:
+      return 3;
+  }
+}
+
+TabSupervision::ResyncState ProjectResyncState(
+    prometheus::SupervisionStreamState state) {
+  switch (state) {
+    case prometheus::SupervisionStreamState::kPreparingBaseline:
+      return TabSupervision::ResyncState::kPreparing;
+    case prometheus::SupervisionStreamState::kLive:
+      return TabSupervision::ResyncState::kNone;
+    case prometheus::SupervisionStreamState::kResyncing:
+      return TabSupervision::ResyncState::kResyncing;
+    case prometheus::SupervisionStreamState::kPaused:
+    case prometheus::SupervisionStreamState::kEnded:
+      return TabSupervision::ResyncState::kPaused;
+  }
+}
+
+std::string MakeUniqueViewerLabel(std::string_view untrusted_label,
+                                  std::set<std::string>& used_labels) {
+  const std::string safe_label =
+      prometheus::DeriveSupervisionSafeClientLabel(untrusted_label);
+  if (used_labels.insert(safe_label).second) {
+    return safe_label;
+  }
+
+  for (size_t suffix_number = 2;; ++suffix_number) {
+    const std::string suffix = " " + base::NumberToString(suffix_number);
+    const size_t prefix_bytes =
+        prometheus::kMaxSupervisionSafeLabelBytes - suffix.size();
+    std::string candidate(
+        base::TruncateUTF8ToByteSize(safe_label, prefix_bytes));
+    candidate += suffix;
+    if (used_labels.insert(candidate).second) {
+      return candidate;
+    }
+  }
+}
+
+}  // namespace
+
 bool PrometheusTabState::Supervision::HasActiveAction() const {
   switch (activity_state) {
     case ActivityState::kValidating:
@@ -29,7 +144,105 @@ PrometheusTabState PrometheusTabState::SafeDefault() {
 
 PrometheusTabState::Supervision ProjectPrometheusTabSupervisionState(
     const prometheus::SanitizedSupervisionSnapshot& snapshot) {
-  return PrometheusTabState::Supervision();
+  TabSupervision result;
+  result.available = snapshot.target.eligible;
+  result.viewer_count =
+      std::min(snapshot.target.viewer_count,
+               static_cast<size_t>(prometheus::kHardSupervisionViewersPerTab));
+  if (result.viewer_count == 0) {
+    return result;
+  }
+
+  result.view_state = TabSupervision::ViewState::kViewing;
+  result.control_state = TabSupervision::ControlState::kViewOnly;
+
+  std::vector<const prometheus::SupervisionSessionSnapshot*> active_sessions;
+  const prometheus::SupervisionSessionSnapshot* controller_session = nullptr;
+  for (const prometheus::SupervisionSessionSnapshot& session :
+       snapshot.sessions) {
+    if (!IsActiveViewerState(session.viewer_state)) {
+      continue;
+    }
+    if (active_sessions.size() < result.viewer_count) {
+      active_sessions.push_back(&session);
+    }
+    if (!controller_session &&
+        session.viewer_state ==
+            prometheus::SupervisionViewerState::kController) {
+      controller_session = &session;
+    }
+  }
+
+  const bool has_authoritative_controller =
+      result.available && snapshot.target.agent_active &&
+      snapshot.target.controller_label && controller_session &&
+      prometheus::DeriveSupervisionSafeClientLabel(
+          *snapshot.target.controller_label) ==
+          prometheus::DeriveSupervisionSafeClientLabel(
+              controller_session->client.display_label);
+  if (has_authoritative_controller) {
+    auto controller = std::ranges::find(active_sessions, controller_session);
+    if (controller == active_sessions.end()) {
+      if (active_sessions.size() == result.viewer_count) {
+        active_sessions.pop_back();
+      }
+      active_sessions.insert(active_sessions.begin(), controller_session);
+    } else {
+      std::rotate(active_sessions.begin(), controller, controller + 1);
+    }
+  }
+
+  std::set<std::string> used_labels;
+  for (const prometheus::SupervisionSessionSnapshot* session :
+       active_sessions) {
+    result.viewer_labels.push_back(
+        MakeUniqueViewerLabel(session->client.display_label, used_labels));
+  }
+
+  for (const prometheus::SupervisionSessionSnapshot* session :
+       active_sessions) {
+    const TabSupervision::ResyncState candidate =
+        ProjectResyncState(session->stream_state);
+    if (ResyncRank(candidate) > ResyncRank(result.resync_state)) {
+      result.resync_state = candidate;
+    }
+  }
+
+  if (!has_authoritative_controller) {
+    if (result.resync_state == TabSupervision::ResyncState::kPaused) {
+      result.severity = TabSupervision::Severity::kBlocked;
+    } else if (result.resync_state != TabSupervision::ResyncState::kNone) {
+      result.severity = TabSupervision::Severity::kNeedsAttention;
+    }
+    return result;
+  }
+
+  result.control_state = TabSupervision::ControlState::kControllerReady;
+  result.controller_label = result.viewer_labels.empty()
+                                ? prometheus::DeriveSupervisionSafeClientLabel(
+                                      controller_session->client.display_label)
+                                : result.viewer_labels.front();
+  if (controller_session->client.expires_at_ms > 0) {
+    result.controller_expires_at_ms = controller_session->client.expires_at_ms;
+  }
+  result.activity_state =
+      ProjectActivityState(controller_session->action_state);
+  if (result.activity_state != TabSupervision::ActivityState::kNone &&
+      controller_session->action_category) {
+    result.action_category =
+        ProjectActionCategory(*controller_session->action_category);
+  }
+
+  if (result.activity_state == TabSupervision::ActivityState::kBlocked ||
+      result.activity_state == TabSupervision::ActivityState::kFailed ||
+      result.resync_state == TabSupervision::ResyncState::kPaused) {
+    result.severity = TabSupervision::Severity::kBlocked;
+  } else if (result.activity_state ==
+                 TabSupervision::ActivityState::kAwaitingConfirmation ||
+             result.resync_state != TabSupervision::ResyncState::kNone) {
+    result.severity = TabSupervision::Severity::kNeedsAttention;
+  }
+  return result;
 }
 
 PrometheusTabState GetPrometheusTabStateForWebContents(
