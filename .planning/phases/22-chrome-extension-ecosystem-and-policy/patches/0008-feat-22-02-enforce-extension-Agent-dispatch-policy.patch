 #include "chrome/browser/prometheus/prometheus_agent_audit.h"
 
+#include <algorithm>
 #include <array>
 #include <string>
 #include <utility>
 
+#include "base/containers/span.h"
 #include "base/strings/string_util.h"
 
 namespace prometheus {
@@ -21,6 +23,25 @@ constexpr auto kDisallowedAuditMetadataTerms = std::to_array<std::string_view>(
      "selector",      "element_ref", "typed_text",   "file_path",
      "drop_path",     "page_html",   "page_content", "local_path"});
 
+bool IsClosedExtensionAuditValue(
+    std::string_view value,
+    base::span<const std::string_view> allowed) {
+  return std::ranges::find(allowed, value) != allowed.end();
+}
+
+bool IsSafeExtensionIdSuffix(std::string_view suffix) {
+  if (suffix.empty()) {
+    return true;
+  }
+  if (suffix.size() != 6u) {
+    return false;
+  }
+  return std::ranges::all_of(suffix, [](unsigned char character) {
+    return (character >= 'a' && character <= 'z') ||
+           (character >= '0' && character <= '9');
+  });
+}
+
 }  // namespace
 
 AgentRouteAuditRecord::AgentRouteAuditRecord() = default;
@@ -54,6 +75,25 @@ bool IsAgentRouteAuditRecordSafe(const AgentRouteAuditRecord& record) {
       return false;
     }
   }
+  if (record.extension.has_value()) {
+    static constexpr auto kSurfaces = std::to_array<std::string_view>(
+        {"tab", "options_page", "popup", "side_panel", "options_guest"});
+    static constexpr auto kGrants = std::to_array<std::string_view>(
+        {"blocked", "read_only", "interact"});
+    static constexpr auto kResults = std::to_array<std::string_view>(
+        {"allowed", "surface_blocked", "read_denied",
+         "interaction_denied", "script_denied", "unsupported_context",
+         "stale_policy", "private_denied", "extension_not_found"});
+    const AgentExtensionAuditMetadata& extension = *record.extension;
+    if (!record.session_id.empty() || record.browser_session_id.has_value() ||
+        record.window_session_id.has_value() || record.tab_handle.has_value() ||
+        !IsSafeExtensionIdSuffix(extension.id_suffix) ||
+        !IsClosedExtensionAuditValue(extension.surface, kSurfaces) ||
+        !IsClosedExtensionAuditValue(extension.grant, kGrants) ||
+        !IsClosedExtensionAuditValue(extension.result, kResults)) {
+      return false;
+    }
+  }
   return true;
 }
 
