@@ -0,0 +1,114 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_supervision_action_controller.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+
+namespace prometheus {
+
+struct PrometheusSupervisionActionController::PendingAction {};
+
+PrometheusSupervisionActionController::PrometheusSupervisionActionController(
+    Profile* profile,
+    base::WeakPtr<BrowserWindowInterface> exact_browser,
+    tabs::TabHandle stable_tab,
+    base::UnguessableToken dashboard_session,
+    std::string immutable_owner_session_id,
+    AuthorityResolver authority_resolver,
+    AgentRouteDispatcher route_dispatcher,
+    FrameResolver frame_resolver)
+    : profile_(profile),
+      exact_browser_(std::move(exact_browser)),
+      stable_tab_(stable_tab),
+      dashboard_session_(dashboard_session),
+      immutable_owner_session_id_(std::move(immutable_owner_session_id)),
+      authority_resolver_(std::move(authority_resolver)),
+      route_dispatcher_(std::move(route_dispatcher)),
+      frame_resolver_(std::move(frame_resolver)) {}
+
+PrometheusSupervisionActionController::~PrometheusSupervisionActionController() =
+    default;
+
+// static
+SupervisionActionClassification
+PrometheusSupervisionActionController::Classify(
+    const SupervisionRemoteActionRequest& action) {
+  switch (action.category) {
+    case SupervisionRemoteActionCategory::kClick:
+    case SupervisionRemoteActionCategory::kType:
+    case SupervisionRemoteActionCategory::kKeyPress:
+    case SupervisionRemoteActionCategory::kScroll:
+    case SupervisionRemoteActionCategory::kHover:
+    case SupervisionRemoteActionCategory::kSelect:
+    case SupervisionRemoteActionCategory::kClear:
+      return SupervisionActionClassification::kOrdinary;
+    case SupervisionRemoteActionCategory::kDrag:
+    case SupervisionRemoteActionCategory::kDrop:
+    case SupervisionRemoteActionCategory::kNavigate:
+      return SupervisionActionClassification::kConsequential;
+  }
+  return SupervisionActionClassification::kRejected;
+}
+
+void PrometheusSupervisionActionController::ExecuteAction(
+    const base::UnguessableToken& dashboard_session,
+    std::string_view document_epoch,
+    uint64_t sequence,
+    const SupervisionRemoteActionRequest& action,
+    CompletionCallback callback) {
+  ++next_action_id_;
+  static_cast<void>(dashboard_session);
+  static_cast<void>(document_epoch);
+  static_cast<void>(sequence);
+  static_cast<void>(action);
+  SupervisionActionResult result;
+  result.error_code = SupervisionErrorCode::kViewOnly;
+  std::move(callback).Run(std::move(result));
+}
+
+void PrometheusSupervisionActionController::ResolvePendingConfirmation(
+    bool allow_once) {
+  static_cast<void>(allow_once);
+}
+
+void PrometheusSupervisionActionController::Cancel(
+    SupervisionErrorCode error_code) {
+  static_cast<void>(error_code);
+}
+
+bool PrometheusSupervisionActionController::has_in_flight_action_for_testing()
+    const {
+  return pending_action_ != nullptr;
+}
+
+bool PrometheusSupervisionActionController::awaiting_confirmation_for_testing()
+    const {
+  return false;
+}
+
+PrometheusSupervisionActionController::AgentRouteDispatcher
+BindPrometheusSupervisionAgentRouteDispatcher(
+    base::WeakPtr<PrometheusAgentProfileService> agent_profile_service) {
+  return base::BindRepeating(
+      [](base::WeakPtr<PrometheusAgentProfileService> service,
+         BrowserWindowInterface* exact_browser,
+         const AgentRouteRequest& request,
+         PrometheusAgentService::RouteCallback callback) {
+        if (!service) {
+          std::move(callback).Run(AgentRouteResult::Failure(
+              AgentErrorCode::kBrowserShuttingDown,
+              "The supervision action service is unavailable",
+              "Create a new supervision session"));
+          return;
+        }
+        service->ExecuteBrowserLocalRoute(exact_browser, request,
+                                          std::move(callback));
+      },
+      std::move(agent_profile_service));
+}
+
+}  // namespace prometheus
