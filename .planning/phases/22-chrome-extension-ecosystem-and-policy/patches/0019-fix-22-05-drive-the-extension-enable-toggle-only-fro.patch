-std::string EnableToggleClickScript(const std::string& extension_id) {
+// Clicks the item card's `#enableToggle`, but only while the toggle's rendered
+// `checked` value still agrees with the native registry state this controller
+// last observed. `expect_checked` is that state: true right after a load (the
+// extension is enabled, so the next click must switch it off), false right
+// after an unload.
+//
+// chrome://extensions learns about a registry transition through its own
+// independent `developerPrivate.onItemStateChanged` round trip, so immediately
+// after a browser-side ExtensionRegistry notification the card can legitimately
+// still render the *previous* state. That stale render is neither hidden nor
+// disabled -- `userCanChangeEnablement()` ignores `disableReasons.reloading`
+// and `getEnableControl()` still returns ENABLE_TOGGLE -- it merely has the
+// wrong `checked` value. Since `cr-toggle` flips `checked` on click and
+// `extensions-item` then calls
+// `chrome.management.setEnabled(id, toggle.checked)`, clicking a stale toggle
+// requests the state the extension is *already* in, which the management API
+// answers successfully without any registry transition at all. Report that as
+// its own retryable status rather than clicking.
+//
+// Observed directly (Phase 22 Plan 22-05 instrumented run): the first disable
+// click, issued 4.5 ms after the reload's native OnExtensionLoaded, saw
+// `state:"DISABLED", disableReasons.reloading:true, hidden:false,
+// disabled:false, checked:false`; the retry 204 ms later saw
+// `state:"ENABLED", checked:true` and the matching OnExtensionUnloaded followed
+// 0.9 ms after the click. The enable stage showed the exact mirror image.
+std::string EnableToggleClickScript(const std::string& extension_id,
+                                    bool expect_checked) {
   return "(function(){"
         "var item=" +
         ItemQueryExpression(extension_id) +
@@ -184,6 +212,9 @@ std::string EnableToggleClickScript(const std::string& extension_id) {
         "if(!toggle)return 'missing_toggle';"
         "if(toggle.hidden)return 'hidden_toggle';"
         "if(toggle.disabled)return 'disabled_toggle';"
+        "if(!!toggle.checked!==" +
+        std::string(expect_checked ? "true" : "false") +
+        ")return 'toggle_state_not_settled';"
         "toggle.click();"
         "return 'clicked';"
         "})()";
@@ -483,6 +514,11 @@ void PrometheusExtensionSmokeController::OnExtensionLoaded(
   if (pending_transition_ == PrometheusExtensionSmokePendingTransition::kReload &&
       awaiting_reload_reload_) {
     pending_transition_ = PrometheusExtensionSmokePendingTransition::kNone;
+    // Retire the satisfied wait's generation so its still-queued timeout task
+    // can never fire against whatever wait replaces it. Without this, the
+    // reload timeout stays armed across the next stage's own bounded retry
+    // loop and can fail the smoke under the *previous* stage's reason.
+    ++pending_wait_generation_;
     awaiting_reload_reload_ = false;
     ++reload_transitions_seen_;
     stage_ = PrometheusExtensionSmokeStage::kReloaded;
@@ -491,8 +527,19 @@ void PrometheusExtensionSmokeController::OnExtensionLoaded(
   }
   if (pending_transition_ == PrometheusExtensionSmokePendingTransition::kEnable) {
     pending_transition_ = PrometheusExtensionSmokePendingTransition::kNone;
+    ++pending_wait_generation_;
     stage_ = PrometheusExtensionSmokeStage::kEnabled;
-    ExercisePolicyGrants();
+    // "Loaded" and "ready" are distinct registry states, and the gap between
+    // them is not observable from inside this notification:
+    // ExtensionRegistrar::ActivateExtension() calls
+    // ExtensionRegistry::TriggerOnLoaded() (this callback) and only afterwards
+    // ExtensionRegistry::AddReady()/TriggerOnReady(). Every
+    // PrometheusExtensionPolicyService decision is gated on
+    // `ready_extensions().Contains(id)` -- a not-yet-ready extension is
+    // "inactive", so its effective grant clamps to Blocked and every grant
+    // mutation is refused with kInactiveExtension. Wait for the real ready
+    // state before exercising the policy matrix.
+    PollExtensionReady(base::TimeTicks::Now() + kExtensionReadyTimeout);
   }
 }
 
