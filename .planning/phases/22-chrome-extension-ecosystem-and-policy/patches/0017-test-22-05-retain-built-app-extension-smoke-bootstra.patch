+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_extension_smoke_bootstrap.h"
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/prometheus/prometheus_runtime_test_bootstrap.h"
+#include "crypto/hash.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace prometheus {
+namespace {
+
+constexpr char kConfigPathString[] = "/tmp/prometheus-phase22-smoke.json";
+constexpr char kFixturePathString[] =
+    "/tmp/prometheus-phase22-fixture/developer_workflow";
+constexpr char kResultPathString[] =
+    "/tmp/prometheus-phase22-smoke-result.json";
+constexpr char kManifestBody[] =
+    "{\"name\":\"Prometheus Developer Workflow Fixture\","
+    "\"version\":\"1.0.0\",\"manifest_version\":3}";
+
+std::string ManifestSha256() {
+  return base::HexEncodeLower(crypto::hash::Sha256(std::string(kManifestBody)));
+}
+
+std::string MakeConfig(std::string_view fixture_path = kFixturePathString,
+                       std::string_view fixture_sha256 = "",
+                       std::string_view result_path = kResultPathString) {
+  const std::string hash =
+      fixture_sha256.empty() ? ManifestSha256() : std::string(fixture_sha256);
+  return "{\"schema_version\":1,\"fixture_path\":\"" +
+         std::string(fixture_path) + "\",\"fixture_sha256\":\"" + hash +
+         "\",\"result_path\":\"" + std::string(result_path) + "\"}";
+}
+
+base::CommandLine MakeLaunch(const base::FilePath& config_path) {
+  base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  command_line.AppendSwitchASCII(kPrometheusRuntimeTestTypeSwitch,
+                                 kPrometheusRuntimeTestType);
+  command_line.AppendSwitchPath(kPrometheusExtensionSmokeBootstrapSwitch,
+                                config_path);
+  return command_line;
+}
+
+class PrometheusExtensionSmokeBootstrapTest : public testing::Test {
+ protected:
+  PrometheusExtensionSmokeBootstrapTest() {
+    config_path_ = base::FilePath(kConfigPathString);
+    fixture_path_ = base::FilePath(kFixturePathString);
+    manifest_path_ = fixture_path_.AppendASCII("manifest.json");
+    result_path_ = base::FilePath(kResultPathString);
+    config_contents_ = MakeConfig();
+
+    file_facts_[config_path_.value()] = ValidConfigFacts(config_contents_);
+    file_facts_[result_path_.DirName().value()] = DirectoryFacts();
+    fixture_facts_[fixture_path_.value()] = DirectoryFacts();
+    fixture_facts_[manifest_path_.value()] = ValidManifestFacts();
+    fixture_contents_[manifest_path_.value()] = kManifestBody;
+
+    file_access_ = {
+        .inspect = base::BindRepeating(
+            &PrometheusExtensionSmokeBootstrapTest::InspectFile,
+            base::Unretained(this)),
+        .read = base::BindRepeating(
+            &PrometheusExtensionSmokeBootstrapTest::ReadFile,
+            base::Unretained(this)),
+    };
+    fixture_access_ = {
+        .inspect = base::BindRepeating(
+            &PrometheusExtensionSmokeBootstrapTest::InspectFixture,
+            base::Unretained(this)),
+        .read = base::BindRepeating(
+            &PrometheusExtensionSmokeBootstrapTest::ReadFixture,
+            base::Unretained(this)),
+    };
+  }
+
+  static PrometheusExtensionSmokeBootstrapFileFacts ValidConfigFacts(
+      std::string_view contents) {
+    return {
+        .is_regular_file = true,
+        .is_directory = false,
+        .is_symbolic_link = false,
+        .is_owned_by_current_user = true,
+        .posix_permissions = 0600,
+        .size = static_cast<int64_t>(contents.size()),
+    };
+  }
+
+  static PrometheusExtensionSmokeBootstrapFileFacts DirectoryFacts() {
+    return {
+        .is_regular_file = false,
+        .is_directory = true,
+        .is_symbolic_link = false,
+        .is_owned_by_current_user = true,
+        .posix_permissions = 0700,
+        .size = 0,
+    };
+  }
+
+  static PrometheusExtensionSmokeBootstrapFileFacts ValidManifestFacts() {
+    return {
+        .is_regular_file = true,
+        .is_directory = false,
+        .is_symbolic_link = false,
+        .is_owned_by_current_user = true,
+        .posix_permissions = 0644,
+        .size = static_cast<int64_t>(std::string_view(kManifestBody).size()),
+    };
+  }
+
+  std::optional<PrometheusExtensionSmokeBootstrapFileFacts> InspectFile(
+      const base::FilePath& path) {
+    ++file_inspect_calls_;
+    if (!inspect_file_succeeds_) {
+      return std::nullopt;
+    }
+    auto it = file_facts_.find(path.value());
+    return it == file_facts_.end() ? std::nullopt : std::optional(it->second);
+  }
+
+  std::optional<std::string> ReadFile(const base::FilePath& path,
+                                      size_t max_bytes) {
+    ++file_read_calls_;
+    last_file_read_max_bytes_ = max_bytes;
+    if (!read_file_succeeds_) {
+      return std::nullopt;
+    }
+    if (path == config_path_) {
+      return config_contents_;
+    }
+    return std::nullopt;
+  }
+
+  std::optional<PrometheusExtensionSmokeBootstrapFileFacts> InspectFixture(
+      const base::FilePath& path) {
+    ++fixture_inspect_calls_;
+    if (!inspect_fixture_succeeds_) {
+      return std::nullopt;
+    }
+    auto it = fixture_facts_.find(path.value());
+    return it == fixture_facts_.end() ? std::nullopt
+                                      : std::optional(it->second);
+  }
+
+  std::optional<std::string> ReadFixture(const base::FilePath& path,
+                                         size_t max_bytes) {
+    ++fixture_read_calls_;
+    if (!read_fixture_succeeds_) {
+      return std::nullopt;
+    }
+    auto it = fixture_contents_.find(path.value());
+    return it == fixture_contents_.end() ? std::nullopt
+                                         : std::optional(it->second);
+  }
+
+  // NOTE: does not (re)compute file_facts_[config_path_] -- the constructor
+  // seeds a valid entry for the default config_contents_, and any test that
+  // passes different contents and/or tampers with file facts is responsible
+  // for keeping both consistent itself. This lets permission/symlink/owner
+  // tampering tests mutate file_facts_ without this helper silently undoing
+  // it.
+  PrometheusExtensionSmokeBootstrapResult CreateWithConfig(
+      std::string_view contents,
+      PrometheusExtensionSmokeBootstrapProfileFacts profile_facts = {
+          .is_regular_profile = true,
+          .is_disposable_profile = true,
+          .is_off_the_record = false,
+      },
+      bool is_official_build = false) {
+    config_contents_ = std::string(contents);
+    return PrometheusExtensionSmokeBootstrap::Create(
+        MakeLaunch(config_path_), is_official_build, profile_facts,
+        file_access_, fixture_access_, &bootstrap_);
+  }
+
+  base::FilePath config_path_;
+  base::FilePath fixture_path_;
+  base::FilePath manifest_path_;
+  base::FilePath result_path_;
+  std::string config_contents_;
+  std::map<base::FilePath::StringType, PrometheusExtensionSmokeBootstrapFileFacts>
+      file_facts_;
+  std::map<base::FilePath::StringType, PrometheusExtensionSmokeBootstrapFileFacts>
+      fixture_facts_;
+  std::map<base::FilePath::StringType, std::string> fixture_contents_;
+  PrometheusExtensionSmokeBootstrapFileAccess file_access_;
+  PrometheusExtensionSmokeFixtureAccess fixture_access_;
+  std::unique_ptr<PrometheusExtensionSmokeBootstrap> bootstrap_;
+  bool inspect_file_succeeds_ = true;
+  bool read_file_succeeds_ = true;
+  bool inspect_fixture_succeeds_ = true;
+  bool read_fixture_succeeds_ = true;
+  size_t file_inspect_calls_ = 0;
+  size_t file_read_calls_ = 0;
+  size_t fixture_inspect_calls_ = 0;
+  size_t fixture_read_calls_ = 0;
+  size_t last_file_read_max_bytes_ = 0;
+};
