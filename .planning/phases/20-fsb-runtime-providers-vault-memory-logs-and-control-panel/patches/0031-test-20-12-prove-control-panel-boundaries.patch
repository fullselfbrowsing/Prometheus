+      status: 'LOADING', tasks: [], providers: [], events: [], actions: [],
+      diagnostics: [],
+    });
+  )"));
+  EXPECT_EQ("loading",
+            content::EvalJs(web_contents,
+                            "document.documentElement.dataset.controlState")
+                .ExtractString());
+  EXPECT_TRUE(content::EvalJs(web_contents, R"(
+    document.querySelector('#control-task-list').getAttribute('aria-busy') ===
+        'true' && document.body.textContent.includes('Loading native tasks');
+  )")
+                  .ExtractBool());
+
+  ASSERT_TRUE(content::ExecJs(web_contents, R"(
+    window.prometheusControlReceiveSnapshot({
+      status: 'OK', tasks: [], providers: [], events: [], actions: [],
+      diagnostics: [], mcp: {status: 'native_runtime'}, permissions: {},
+    });
+  )"));
+  EXPECT_EQ("empty",
+            content::EvalJs(web_contents,
+                            "document.documentElement.dataset.controlState")
+                .ExtractString());
+  EXPECT_TRUE(BodyTextContentContains(web_contents, "No tasks yet"));
+
+  ASSERT_TRUE(content::ExecJs(web_contents, R"(
