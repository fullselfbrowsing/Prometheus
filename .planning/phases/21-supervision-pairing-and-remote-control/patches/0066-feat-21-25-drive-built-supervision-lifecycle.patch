+void PrometheusSupervisionTestComposition::InstallDialogAutomation(
+    BrowserWindowInterface* exact_browser) {
+  if (shutdown_ || !bootstrap_ || !exact_browser ||
+      exact_browser->IsDeleteScheduled()) {
+    return;
+  }
+  exact_browser_ = exact_browser->GetWeakPtr();
+  SetPrometheusSupervisionDialogAutomationForTesting(base::BindRepeating(
+      [](base::WeakPtr<PrometheusSupervisionTestComposition> composition,
+         BrowserWindowInterface* dialog_browser,
+         PrometheusSupervisionDialogKind dialog_kind) {
+        if (!composition || composition->shutdown_ ||
+            !composition->bootstrap_ || !composition->exact_browser_ ||
+            dialog_browser != composition->exact_browser_.get()) {
+          return PrometheusSupervisionDialogAutomationResponse::kNoResponse;
+        }
+        const PrometheusSupervisionTestDialog expected_dialog =
+            dialog_kind == PrometheusSupervisionDialogKind::kEnableControl
+                ? PrometheusSupervisionTestDialog::kEnableControl
+                : PrometheusSupervisionTestDialog::kRemoteAction;
+        const std::optional<PrometheusSupervisionTestDialogResponse> response =
+            composition->bootstrap_->ConsumeDialogResponse(expected_dialog);
+        return response ==
+                       PrometheusSupervisionTestDialogResponse::kAccept
+                   ? PrometheusSupervisionDialogAutomationResponse::kAccept
+                   : PrometheusSupervisionDialogAutomationResponse::kNoResponse;
+      },
+      weak_ptr_factory_.GetWeakPtr()));
+  dialog_automation_bound_ = true;
+  ObserveLifecycle("dialog_automation_bound");
+}
+
+void PrometheusSupervisionTestComposition::ClearDialogAutomation() {
+  if (!dialog_automation_bound_) {
+    return;
+  }
+  SetPrometheusSupervisionDialogAutomationForTesting({});
+  exact_browser_.reset();
+  dialog_automation_bound_ = false;
+  ObserveLifecycle("dialog_automation_unbound");
+}
