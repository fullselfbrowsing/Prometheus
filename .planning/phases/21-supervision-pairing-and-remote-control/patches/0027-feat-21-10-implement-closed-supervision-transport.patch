+std::string_view SupervisionOperationName(
+    AgentSupervisionDiffOperationType type) {
+  switch (type) {
+    case AgentSupervisionDiffOperationType::kInsertSubtree:
+      return "insert_subtree";
+    case AgentSupervisionDiffOperationType::kRemove:
+      return "remove";
+    case AgentSupervisionDiffOperationType::kReplaceFields:
+      return "replace_fields";
+    case AgentSupervisionDiffOperationType::kReorderChildren:
+      return "reorder_children";
+  }
+}
+
+base::DictValue SupervisionOperationToValue(
+    const AgentSupervisionDiffOperation& operation) {
+  base::DictValue value;
+  value.Set("op", SupervisionOperationName(operation.type));
+  value.Set("ref", operation.ref);
+  switch (operation.type) {
+    case AgentSupervisionDiffOperationType::kInsertSubtree: {
+      if (!operation.parent_ref.empty()) {
+        value.Set("parent_ref", operation.parent_ref);
+      }
+      value.Set("index", static_cast<int>(operation.index));
+      base::ListValue subtree;
+      subtree.reserve(operation.subtree.size());
+      for (const AgentSupervisionNode& node : operation.subtree) {
+        subtree.Append(SupervisionNodeToValue(node));
+      }
+      value.Set("subtree", std::move(subtree));
+      break;
+    }
+    case AgentSupervisionDiffOperationType::kRemove:
+      break;
+    case AgentSupervisionDiffOperationType::kReplaceFields:
+      value.Set("fields", SupervisionNodeFieldsToValue(*operation.replacement));
+      break;
+    case AgentSupervisionDiffOperationType::kReorderChildren: {
+      base::ListValue children;
+      children.reserve(operation.child_order.size());
+      for (const std::string& child_ref : operation.child_order) {
+        children.Append(child_ref);
+      }
+      value.Set("children", std::move(children));
+      break;
+    }
+  }
+  return value;
+}
