+++ b/chrome/browser/prometheus/prometheus_supervision_capture_hub_browsertest.cc
@@ -12,6 +12,8 @@
 #include "base/functional/bind.h"
 #include "base/test/run_until.h"
 #include "base/time/time.h"
+#include "chrome/browser/prometheus/prometheus_supervision_profile_service.h"
+#include "chrome/browser/tab_list/tab_list_interface.h"
 #include "chrome/browser/ui/browser.h"
 #include "chrome/browser/ui/browser_tabstrip.h"
 #include "chrome/browser/ui/tabs/tab_strip_model.h"
@@ -38,7 +40,9 @@ namespace {
 constexpr char kHubPagePath[] = "/prometheus-supervision-hub.html";
 constexpr char kFramePagePath[] = "/prometheus-supervision-frame.html";
 constexpr char kReleasePath[] = "/prometheus-supervision-release";
+constexpr char kSecondReleasePath[] = "/prometheus-supervision-second-release";
 constexpr char kMutationMarker[] = "released-visible-marker";
+constexpr char kSecondMutationMarker[] = "second-released-visible-marker";
 constexpr char kPasswordSentinel[] = "PASSWORD_SENTINEL_21_07";
 constexpr char kPaymentSentinel[] = "4111111111112107";
 constexpr char kOtpSentinel[] = "927107";
@@ -75,6 +79,14 @@ fetch('/prometheus-supervision-release')
     document.querySelector('#mutation-region').append(button);
     document.querySelector('#mutation-status').textContent =
         'server mutation committed';
+    return fetch('/prometheus-supervision-second-release');
+  })
+  .then(response => response.text())
+  .then(message => {
+    const status = document.createElement('p');
+    status.id = 'second-server-release';
+    status.textContent = message;
+    document.querySelector('#mutation-region').append(status);
   });
 </script>
 )HTML";
@@ -103,18 +115,89 @@ class PrometheusSupervisionCaptureHubBrowserTest : public InProcessBrowserTest {
     release_response_ =
         std::make_unique<net::test_server::ControllableHttpResponse>(
             embedded_test_server(), kReleasePath);
+    second_release_response_ =
+        std::make_unique<net::test_server::ControllableHttpResponse>(
+            embedded_test_server(), kSecondReleasePath);
     embedded_test_server()->RegisterRequestHandler(base::BindRepeating(
         &PrometheusSupervisionCaptureHubBrowserTest::HandleRequest,
         base::Unretained(this)));
     ASSERT_TRUE(embedded_test_server()->Start());
     ASSERT_TRUE(ui_test_utils::NavigateToURL(
         browser(), embedded_test_server()->GetURL(kHubPagePath)));
+    now_ = base::Time::Now();
+    SupervisionLimits limits;
+    limits.viewer_ttl_ms = base::Minutes(2).InMilliseconds();
+    supervision_service_ =
+        std::make_unique<PrometheusSupervisionProfileService>(
+            browser()->profile(), SupervisionProfileKind::kRegular,
+            base::BindRepeating(
+                &PrometheusSupervisionCaptureHubBrowserTest::ObserveTabData,
+                base::Unretained(this)),
+            base::BindRepeating([](base::Time* now) { return *now; },
+                                base::Unretained(&now_)),
+            PrometheusSupervisionProfileService::PairingCodeGenerator(),
+            limits);
+  }
+
+  void TearDownOnMainThread() override {
+    supervision_service_.reset();
+    second_release_response_.reset();
+    release_response_.reset();
+    InProcessBrowserTest::TearDownOnMainThread();
   }
 
   content::WebContents* contents() {
     return browser()->tab_strip_model()->GetActiveWebContents();
   }
 
+  tabs::TabInterface* active_tab() {
+    return TabListInterface::From(browser())->GetActiveTab();
+  }
+
+  PrometheusAgentTabObservationLease ObserveTabData(
+      tabs::TabInterface* tab,
+      PrometheusAgentTabData::Observer* observer) {
+    return agent_service_.ObserveOrCreateTabData(tab, observer);
+  }
+
+  PrometheusSupervisionProfileService& supervision_service() {
+    return *supervision_service_;
+  }
+
+  SupervisionRedemptionResult RedeemDashboard(std::string_view label) {
+    SupervisionPairingCreationResult creation =
+        supervision_service().CreatePairing(browser(), active_tab());
+    EXPECT_TRUE(creation.ok) << creation.message;
+    SupervisionRedemptionResult redemption =
+        supervision_service().RedeemPairing(creation.pairing_code, label);
+    EXPECT_TRUE(redemption.ok) << redemption.message;
+    return redemption;
+  }
+
+  SupervisionDashboardBaselineResult WaitForDashboardBaseline(
+      const base::UnguessableToken& dashboard_session) {
+    SupervisionDashboardBaselineResult result;
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      result = supervision_service().ReadDashboardBaseline(dashboard_session);
+      return !result.ok || result.delivery.has_value();
+    }));
+    EXPECT_TRUE(result.ok) << result.message;
+    EXPECT_TRUE(result.delivery.has_value());
+    return result;
+  }
+
+  SupervisionDashboardDiffResult WaitForDashboardDiff(
+      const base::UnguessableToken& dashboard_session) {
+    SupervisionDashboardDiffResult result;
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      result = supervision_service().ReadDashboardDiff(dashboard_session);
+      return !result.ok || result.delivery.has_value();
+    }));
+    EXPECT_TRUE(result.ok) << result.message;
+    EXPECT_TRUE(result.delivery.has_value());
+    return result;
+  }
+
   std::optional<SupervisionCaptureBaselineDelivery> WaitForBaseline(
       PrometheusSupervisionCaptureHub& hub,
       SupervisionCaptureConsumerId consumer_id) {
@@ -147,6 +230,12 @@ class PrometheusSupervisionCaptureHubBrowserTest : public InProcessBrowserTest {
     return *release_response_;
   }
 
+  net::test_server::ControllableHttpResponse& second_release_response() {
+    return *second_release_response_;
+  }
+
+  void AdvanceNow(base::TimeDelta delta) { now_ += delta; }
+
  private:
   std::unique_ptr<net::test_server::HttpResponse> HandleRequest(
       const net::test_server::HttpRequest& request) {
@@ -166,8 +255,198 @@ class PrometheusSupervisionCaptureHubBrowserTest : public InProcessBrowserTest {
   }
 
   std::unique_ptr<net::test_server::ControllableHttpResponse> release_response_;
+  std::unique_ptr<net::test_server::ControllableHttpResponse>
+      second_release_response_;
+  AgentSessionRegistry registry_{8, base::Hours(1)};
+  PrometheusAgentService agent_service_{&registry_};
+  base::Time now_;
+  std::unique_ptr<PrometheusSupervisionProfileService> supervision_service_;
 };
 
+IN_PROC_BROWSER_TEST_F(
+    PrometheusSupervisionCaptureHubBrowserTest,
+    TwoDashboardConsumersShareRealMutationsAndDetachIndependently) {
+  ASSERT_TRUE(active_tab());
+  SupervisionRedemptionResult viewer_a = RedeemDashboard("Viewer A");
+  SupervisionRedemptionResult viewer_b = RedeemDashboard("Viewer B");
+  ASSERT_TRUE(viewer_a.ok);
+  ASSERT_TRUE(viewer_b.ok);
+  ASSERT_EQ(viewer_a.stable_tab_id, viewer_b.stable_tab_id);
+  ASSERT_EQ(1u, supervision_service().capture_hub_count_for_testing());
+  ASSERT_EQ(2u, supervision_service().capture_consumer_count_for_testing(
+                    viewer_a.stable_tab_id));
+
+  PrometheusSupervisionCaptureHub* hub =
+      supervision_service().capture_hub_for_testing(viewer_a.stable_tab_id);
+  ASSERT_NE(nullptr, hub);
+  EXPECT_EQ(1u, hub->enable_count_for_testing());
+  EXPECT_EQ(1u, hub->capture_count_for_testing());
+
+  SupervisionDashboardBaselineResult baseline_a =
+      WaitForDashboardBaseline(viewer_a.dashboard_session);
+  SupervisionDashboardBaselineResult baseline_b =
+      WaitForDashboardBaseline(viewer_b.dashboard_session);
+  ASSERT_TRUE(baseline_a.delivery.has_value());
+  ASSERT_TRUE(baseline_b.delivery.has_value());
+  EXPECT_EQ(baseline_a.delivery->baseline, baseline_b.delivery->baseline);
+  EXPECT_EQ(baseline_a.delivery->stamp.document_epoch,
+            baseline_b.delivery->stamp.document_epoch);
+  EXPECT_NE(baseline_a.delivery->stamp.session,
+            baseline_b.delivery->stamp.session);
+  ASSERT_TRUE(
+      supervision_service()
+          .AckDashboard(viewer_a.dashboard_session, baseline_a.delivery->stamp)
+          .ok);
+  ASSERT_TRUE(
+      supervision_service()
+          .AckDashboard(viewer_b.dashboard_session, baseline_b.delivery->stamp)
+          .ok);
+  for (std::string_view forbidden :
+       {kPasswordSentinel, kPaymentSentinel, kOtpSentinel, "attributeName",
+        "oldValue", "addedNodes", "removedNodes"}) {
+    EXPECT_TRUE(Omits(baseline_a.delivery->baseline.serialized_json, forbidden))
+        << forbidden;
+  }
+
+  const size_t dirty_before_first = hub->dirty_signal_count_for_testing();
+  const size_t captures_before_first = hub->capture_count_for_testing();
+  release_response().WaitForRequest();
+  release_response().Send(net::HTTP_OK, "text/plain", kMutationMarker);
+  release_response().Done();
+
+  SupervisionDashboardDiffResult first_diff_a =
+      WaitForDashboardDiff(viewer_a.dashboard_session);
+  SupervisionDashboardDiffResult first_diff_b =
+      WaitForDashboardDiff(viewer_b.dashboard_session);
+  ASSERT_TRUE(first_diff_a.delivery.has_value());
+  ASSERT_TRUE(first_diff_b.delivery.has_value());
+  EXPECT_EQ(first_diff_a.delivery->diff, first_diff_b.delivery->diff);
+  EXPECT_EQ(first_diff_a.delivery->stamp.sequence,
+            first_diff_b.delivery->stamp.sequence);
+  EXPECT_NE(std::string::npos,
+            first_diff_a.delivery->diff.serialized_json.find(kMutationMarker));
+  for (std::string_view forbidden :
+       {kPasswordSentinel, kPaymentSentinel, kOtpSentinel, "attributeName",
+        "oldValue", "addedNodes", "removedNodes"}) {
+    EXPECT_TRUE(Omits(first_diff_a.delivery->diff.serialized_json, forbidden))
+        << forbidden;
+  }
+  EXPECT_EQ(dirty_before_first + 1u, hub->dirty_signal_count_for_testing());
+  EXPECT_EQ(captures_before_first + 1u, hub->capture_count_for_testing());
+
+  ASSERT_TRUE(supervision_service()
+                  .AckDashboard(viewer_a.dashboard_session,
+                                first_diff_a.delivery->stamp)
+                  .ok);
+  EXPECT_FALSE(supervision_service()
+                   .ReadDashboardDiff(viewer_a.dashboard_session)
+                   .delivery.has_value());
+  SupervisionDashboardDiffResult unread_b =
+      supervision_service().ReadDashboardDiff(viewer_b.dashboard_session);
+  ASSERT_TRUE(unread_b.ok);
+  ASSERT_TRUE(unread_b.delivery.has_value());
+  EXPECT_EQ(first_diff_b.delivery->stamp.sequence,
+            unread_b.delivery->stamp.sequence);
+  ASSERT_TRUE(
+      supervision_service()
+          .AckDashboard(viewer_b.dashboard_session, unread_b.delivery->stamp)
+          .ok);
+
+  ASSERT_TRUE(
+      supervision_service().RevokeSession(viewer_a.dashboard_session).ok);
+  EXPECT_EQ(1u, supervision_service().capture_consumer_count_for_testing(
+                    viewer_a.stable_tab_id));
+  EXPECT_EQ(0u, hub->disable_count_for_testing());
+
+  const size_t dirty_before_second = hub->dirty_signal_count_for_testing();
+  const size_t captures_before_second = hub->capture_count_for_testing();
+  second_release_response().WaitForRequest();
+  second_release_response().Send(net::HTTP_OK, "text/plain",
+                                 kSecondMutationMarker);
+  second_release_response().Done();
+  SupervisionDashboardDiffResult second_diff_b =
+      WaitForDashboardDiff(viewer_b.dashboard_session);
+  ASSERT_TRUE(second_diff_b.delivery.has_value());
+  EXPECT_NE(
+      std::string::npos,
+      second_diff_b.delivery->diff.serialized_json.find(kSecondMutationMarker));
+  EXPECT_EQ(dirty_before_second + 1u, hub->dirty_signal_count_for_testing());
+  EXPECT_EQ(captures_before_second + 1u, hub->capture_count_for_testing());
+  ASSERT_TRUE(supervision_service()
+                  .AckDashboard(viewer_b.dashboard_session,
+                                second_diff_b.delivery->stamp)
+                  .ok);
+
+  AdvanceNow(base::Minutes(3));
+  supervision_service().GetSanitizedSnapshot(viewer_b.stable_tab_id);
+  EXPECT_EQ(0u, supervision_service().capture_hub_count_for_testing());
+  EXPECT_EQ(1u,
+            supervision_service().released_capture_disable_count_for_testing());
+}
+
+IN_PROC_BROWSER_TEST_F(
+    PrometheusSupervisionCaptureHubBrowserTest,
+    TwoDashboardConsumersNavigationRequiresIndependentBaselines) {
+  SupervisionRedemptionResult viewer_a = RedeemDashboard("Viewer A");
+  SupervisionRedemptionResult viewer_b = RedeemDashboard("Viewer B");
+  ASSERT_TRUE(viewer_a.ok);
+  ASSERT_TRUE(viewer_b.ok);
+  SupervisionDashboardBaselineResult old_a =
+      WaitForDashboardBaseline(viewer_a.dashboard_session);
+  SupervisionDashboardBaselineResult old_b =
+      WaitForDashboardBaseline(viewer_b.dashboard_session);
+  ASSERT_TRUE(old_a.delivery.has_value());
+  ASSERT_TRUE(old_b.delivery.has_value());
+  ASSERT_TRUE(
+      supervision_service()
+          .AckDashboard(viewer_a.dashboard_session, old_a.delivery->stamp)
+          .ok);
+  ASSERT_TRUE(
+      supervision_service()
+          .AckDashboard(viewer_b.dashboard_session, old_b.delivery->stamp)
+          .ok);
+
+  PrometheusSupervisionCaptureHub* hub =
+      supervision_service().capture_hub_for_testing(viewer_a.stable_tab_id);
+  ASSERT_NE(nullptr, hub);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title2.html")));
+  SupervisionDashboardBaselineResult new_a =
+      WaitForDashboardBaseline(viewer_a.dashboard_session);
+  SupervisionDashboardBaselineResult new_b =
+      WaitForDashboardBaseline(viewer_b.dashboard_session);
+  ASSERT_TRUE(new_a.delivery.has_value());
+  ASSERT_TRUE(new_b.delivery.has_value());
+  EXPECT_NE(old_a.delivery->stamp.document_epoch,
+            new_a.delivery->stamp.document_epoch);
+  EXPECT_EQ(new_a.delivery->stamp.document_epoch,
+            new_b.delivery->stamp.document_epoch);
+  EXPECT_FALSE(
+      supervision_service()
+          .AckDashboard(viewer_a.dashboard_session, old_a.delivery->stamp)
+          .ok);
+  EXPECT_TRUE(
+      supervision_service()
+          .AckDashboard(viewer_b.dashboard_session, new_b.delivery->stamp)
+          .ok);
+  SupervisionDashboardBaselineResult reoffered_a =
+      WaitForDashboardBaseline(viewer_a.dashboard_session);
+  ASSERT_TRUE(reoffered_a.delivery.has_value());
+  EXPECT_TRUE(
+      supervision_service()
+          .AckDashboard(viewer_a.dashboard_session, reoffered_a.delivery->stamp)
+          .ok);
+  EXPECT_EQ(2u, hub->enable_count_for_testing());
+  EXPECT_EQ(1u, hub->disable_count_for_testing());
+  EXPECT_EQ(2u, hub->capture_count_for_testing());
+
+  EXPECT_TRUE(supervision_service().EndSession(viewer_a.dashboard_session).ok);
+  EXPECT_EQ(1u, supervision_service().capture_consumer_count_for_testing(
+                    viewer_a.stable_tab_id));
+  EXPECT_TRUE(supervision_service().EndSession(viewer_b.dashboard_session).ok);
+  EXPECT_EQ(0u, supervision_service().capture_hub_count_for_testing());
+}
+
 IN_PROC_BROWSER_TEST_F(PrometheusSupervisionCaptureHubBrowserTest,
                        TwoConsumersUseOneRendererEnableAndApcCapture) {
   ASSERT_TRUE(contents());
