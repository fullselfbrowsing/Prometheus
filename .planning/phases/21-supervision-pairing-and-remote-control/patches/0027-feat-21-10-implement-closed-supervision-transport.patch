+        "Supervision result payload does not match its native route"));
+  }
+
+  base::DictValue value;
+  if (std::holds_alternative<AgentSupervisionLocalUiResult>(result.payload)) {
+    value.Set("kind", "local_ui");
+    value.Set("surface", "control_panel");
+    return value;
+  }
+  if (const auto* baseline =
+          std::get_if<AgentSupervisionBaselineResult>(&result.payload)) {
+    if (baseline->nodes.empty()) {
+      return base::unexpected(
+          InvalidRequest("Supervision baseline must contain a real root"));
+    }
+    auto valid = ValidateSupervisionNodeCollection(baseline->nodes);
+    if (!valid.has_value()) {
+      return base::unexpected(std::move(valid.error()));
+    }
+    value.Set("kind", "baseline");
+    base::ListValue nodes;
+    nodes.reserve(baseline->nodes.size());
+    for (const AgentSupervisionNode& node : baseline->nodes) {
+      nodes.Append(SupervisionNodeToValue(node));
+    }
+    value.Set("nodes", std::move(nodes));
+    return value;
+  }
+  if (const auto* diff =
+          std::get_if<AgentSupervisionDiffResult>(&result.payload)) {
+    if (diff->operations.empty()) {
+      return base::unexpected(InvalidRequest(
+          "Empty supervision diff must use the no-change result"));
+    }
+    if (diff->operations.size() > kMaxAgentSupervisionDiffOperations) {
+      return base::unexpected(
+          RequestTooLarge("Supervision diff exceeds the operation-count cap"));
+    }
+    value.Set("kind", "diff");
+    base::ListValue operations;
+    operations.reserve(diff->operations.size());
