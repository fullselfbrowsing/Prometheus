+class PrometheusSupervisionComposition {
+ public:
+  PrometheusSupervisionComposition() = default;
+  PrometheusSupervisionComposition(const PrometheusSupervisionComposition&) =
+      delete;
+  PrometheusSupervisionComposition& operator=(
+      const PrometheusSupervisionComposition&) = delete;
+  ~PrometheusSupervisionComposition() { Shutdown(); }
+
+  base::WeakPtr<PrometheusSupervisionComposition> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+  SupervisionGatewayDispatcher CreateDashboardDispatcher() {
+    SupervisionGatewayDispatcher dispatcher;
+    dispatcher.dispatch =
+        base::BindRepeating(&PrometheusSupervisionComposition::Dispatch,
+                            weak_factory_.GetWeakPtr());
+    dispatcher.cancel = base::BindRepeating(
+        &PrometheusSupervisionComposition::Cancel, weak_factory_.GetWeakPtr());
+    dispatcher.readiness = base::BindRepeating(
+        [](base::WeakPtr<PrometheusSupervisionComposition> composition) {
+          return composition
+                     ? composition->Readiness()
+                     : SupervisionGatewayReadiness{
+                           SupervisionGatewayReadinessStatus::kUnavailable,
+                           "Native supervision composition is unavailable",
+                           "Restart Prometheus"};
+        },
+        weak_factory_.GetWeakPtr());
+    dispatcher.shutdown =
+        base::BindRepeating(&PrometheusSupervisionComposition::Shutdown,
+                            weak_factory_.GetWeakPtr());
+    return dispatcher;
+  }
+
+  void DispatchAgentRoute(BrowserWindowInterface* exact_browser,
+                          const AgentRouteRequest& request,
+                          PrometheusAgentService::RouteCallback callback) {
+    Profile* const profile =
+        exact_browser ? exact_browser->GetProfile() : nullptr;
+    PrometheusSupervisionProfileService* const service =
+        profile && profile->IsRegularProfile()
+            ? PrometheusSupervisionProfileServiceFactory::GetForProfile(profile)
+            : nullptr;
+    if (!service || !exact_browser || exact_browser->IsDeleteScheduled()) {
+      std::move(callback).Run(AgentRouteResult::Failure(
+          AgentErrorCode::kCapabilityNotReady,
+          "Native supervision is unavailable for the exact browser",
+          "Create a new Agent session from a regular browser tab"));
+      return;
+    }
+    service->ExecuteCompatibilityRoute(exact_browser, request,
+                                       std::move(callback));
+  }
+
+ private:
+  struct DashboardOwner {
+    base::WeakPtr<PrometheusSupervisionProfileService> service;
+    base::UnguessableToken session;
+    int32_t stable_tab_id = 0;
+    std::optional<SupervisionStreamStamp> last_delivery;
+  };
+
+  struct PendingDiff {
+    std::string dashboard_session;
+    base::UnguessableToken service_session;
+    base::UnguessableToken wait_token;
+    SupervisionGatewayDispatcher::ResultCallback callback;
+  };
+
+  static SupervisionGatewayResult Result(SupervisionTransportResult result) {
+    return SupervisionGatewayResult{std::move(result)};
+  }
+
+  static SupervisionTransportResult Failure(
+      SupervisionTransportOperation operation,
+      const SupervisionServiceResult& service_result) {
+    return SupervisionTransportResult::SupervisionFailure(
+        operation, service_result.error_code, service_result.message,
+        service_result.recovery);
+  }
+
+  std::vector<PrometheusSupervisionProfileService*> LoadedServices() const {
+    constexpr size_t kMaxLoadedProfiles = 64;
+    std::vector<PrometheusSupervisionProfileService*> services;
+    if (!g_browser_process || !g_browser_process->profile_manager()) {
+      return services;
+    }
+    for (Profile* profile :
+         g_browser_process->profile_manager()->GetLoadedProfiles()) {
+      if (services.size() >= kMaxLoadedProfiles) {
+        break;
+      }
+      if (!profile || !profile->IsRegularProfile()) {
+        continue;
+      }
+      if (auto* service =
+              PrometheusSupervisionProfileServiceFactory::GetForProfile(
+                  profile)) {
+        services.push_back(service);
+      }
+    }
+    return services;
+  }
+
+  DashboardOwner* FindOwner(std::string_view wire_session) {
+    auto owner = dashboard_owners_.find(wire_session);
+    if (owner == dashboard_owners_.end() || !owner->second.service ||
+        !owner->second.service->OwnsDashboardSessionForComposition(
+            owner->second.session)) {
+      if (owner != dashboard_owners_.end()) {
+        dashboard_owners_.erase(owner);
+      }
+      return nullptr;
+    }
+    return &owner->second;
+  }
+
+  void Complete(SupervisionGatewayDispatcher::ResultCallback callback,
+                SupervisionTransportResult result) {
+    std::move(callback).Run(Result(std::move(result)));
+  }
+
+  void Dispatch(SupervisionGatewayRequest request,
+                SupervisionGatewayDispatcher::ResultCallback callback) {
+    if (shutdown_) {
+      Complete(std::move(callback),
+               SupervisionTransportResult::TransportFailure(
+                   request.transport.operation,
+                   SupervisionTransportErrorCode::kUnavailable,
+                   "Native supervision composition is shutting down",
+                   "Restart Prometheus and redeem a new pairing"));
+      return;
+    }
+    switch (request.transport.operation) {
+      case SupervisionTransportOperation::kRedeem:
+        Redeem(request, std::move(callback));
+        return;
+      case SupervisionTransportOperation::kBaseline:
+        Baseline(request, std::move(callback));
+        return;
+      case SupervisionTransportOperation::kDiff:
+        Diff(request, std::move(callback));
+        return;
+      case SupervisionTransportOperation::kAck:
+        Ack(request, std::move(callback));
+        return;
+      case SupervisionTransportOperation::kHeartbeat:
+        Heartbeat(request, std::move(callback));
+        return;
+      case SupervisionTransportOperation::kEnd:
+        End(request, std::move(callback));
+        return;
+      case SupervisionTransportOperation::kAction:
+        Complete(std::move(callback),
+                 SupervisionTransportResult::TransportFailure(
+                     request.transport.operation,
+                     SupervisionTransportErrorCode::kUnavailable,
+                     "Remote actions are not connected to native control",
+                     "Continue in view-only mode"));
+        return;
+    }
+  }
+
+  void Redeem(const SupervisionGatewayRequest& request,
+              SupervisionGatewayDispatcher::ResultCallback callback) {
+    const auto& params =
+        std::get<SupervisionRedeemParams>(request.transport.params);
+    PrometheusSupervisionProfileService* owner = nullptr;
+    for (PrometheusSupervisionProfileService* service : LoadedServices()) {
+      if (!service->MatchesPendingPairingForComposition(params.pairing_code)) {
+        continue;
+      }
+      if (owner) {
+        Complete(std::move(callback),
+                 SupervisionTransportResult::TransportFailure(
+                     request.transport.operation,
+                     SupervisionTransportErrorCode::kInternal,
+                     "Pairing authority is ambiguous",
+                     "Cancel the local pairing and create a new code"));
+        return;
+      }
+      owner = service;
+    }
+    if (!owner) {
+      Complete(std::move(callback),
+               SupervisionTransportResult::TransportFailure(
+                   request.transport.operation,
+                   SupervisionTransportErrorCode::kUnavailable,
+                   "No loaded regular profile owns this pairing",
+                   "Create a fresh local pairing and retry"));
+      return;
+    }
+    SupervisionRedemptionResult redeemed =
+        owner->RedeemPairing(params.pairing_code, params.client_label);
+    if (!redeemed.ok) {
+      Complete(std::move(callback),
+               Failure(request.transport.operation, redeemed));
+      return;
+    }
+    const std::string wire_session = redeemed.dashboard_session.ToString();
+    dashboard_owners_[wire_session] = DashboardOwner{
+        .service = owner->GetWeakPtr(),
+        .session = redeemed.dashboard_session,
+        .stable_tab_id = redeemed.stable_tab_id,
+    };
+    SupervisionTransportResult result =
+        SupervisionTransportResult::Success(request.transport.operation);
+    result.dashboard_authority =
+        SupervisionDashboardWireAuthority{.dashboard_session = wire_session};
+    result.sanitized_snapshot =
+        owner->GetSanitizedSnapshot(redeemed.stable_tab_id);
+    Complete(std::move(callback), std::move(result));
+  }
+
+  void Baseline(const SupervisionGatewayRequest& request,
+                SupervisionGatewayDispatcher::ResultCallback callback) {
+    const auto& params =
+        std::get<SupervisionBaselineParams>(request.transport.params);
+    DashboardOwner* owner = FindOwner(params.dashboard_session);
+    if (!owner) {
+      CompleteUnknown(request.transport.operation, std::move(callback));
+      return;
+    }
+    SupervisionDashboardBaselineResult baseline =
+        owner->service->ReadDashboardBaseline(owner->session);
+    if (!baseline.ok) {
+      Complete(std::move(callback),
+               Failure(request.transport.operation, baseline));
+      return;
+    }
+    SupervisionTransportResult result =
+        SupervisionTransportResult::Success(request.transport.operation);
+    result.sanitized_snapshot =
+        owner->service->GetSanitizedSnapshot(owner->stable_tab_id);
+    if (baseline.delivery) {
+      owner->last_delivery = baseline.delivery->stamp;
+      result.dashboard_authority = SupervisionDashboardWireAuthority{
+          .dashboard_session = params.dashboard_session,
+          .document_epoch = baseline.delivery->stamp.document_epoch.ToString(),
+          .sequence = baseline.delivery->stamp.sequence,
+      };
+    } else {
+      result.no_change = true;
+    }
+    Complete(std::move(callback), std::move(result));
+  }
+
+  void Diff(const SupervisionGatewayRequest& request,
+            SupervisionGatewayDispatcher::ResultCallback callback) {
+    const auto& params =
+        std::get<SupervisionDiffParams>(request.transport.params);
+    DashboardOwner* owner = FindOwner(params.dashboard_session);
+    if (!owner) {
+      CompleteUnknown(request.transport.operation, std::move(callback));
+      return;
+    }
+    SupervisionDashboardDiffResult diff =
+        owner->service->ReadDashboardDiff(owner->session);
+    if (!diff.ok) {
+      Complete(std::move(callback), Failure(request.transport.operation, diff));
+      return;
+    }
+    if (diff.delivery) {
+      CompleteDiff(params.dashboard_session, *owner, std::move(callback),
+                   std::move(diff));
+      return;
+    }
+    SupervisionDashboardDiffWaitRegistration wait =
+        owner->service->BeginDashboardDiffWait(
+            owner->session,
+            base::BindOnce(&PrometheusSupervisionComposition::OnDiffReady,
+                           weak_factory_.GetWeakPtr(),
+                           request.cancellation_token));
+    if (!wait.ok) {
+      Complete(std::move(callback), Failure(request.transport.operation, wait));
+      return;
+    }
+    pending_diffs_.emplace(request.cancellation_token.value,
+                           PendingDiff{params.dashboard_session, owner->session,
+                                       wait.wait_token, std::move(callback)});
+  }
+
+  void OnDiffReady(SupervisionGatewayCancellationToken token,
+                   SupervisionDashboardDiffResult diff) {
+    auto pending = pending_diffs_.find(token.value);
+    if (pending == pending_diffs_.end()) {
+      return;
+    }
+    PendingDiff operation = std::move(pending->second);
+    pending_diffs_.erase(pending);
+    DashboardOwner* owner = FindOwner(operation.dashboard_session);
+    if (!owner) {
+      CompleteUnknown(SupervisionTransportOperation::kDiff,
+                      std::move(operation.callback));
+      return;
+    }
+    if (!diff.ok) {
+      Complete(std::move(operation.callback),
+               Failure(SupervisionTransportOperation::kDiff, diff));
+      return;
+    }
+    CompleteDiff(operation.dashboard_session, *owner,
+                 std::move(operation.callback), std::move(diff));
+  }
+
+  void CompleteDiff(std::string_view wire_session,
+                    DashboardOwner& owner,
+                    SupervisionGatewayDispatcher::ResultCallback callback,
+                    SupervisionDashboardDiffResult diff) {
+    SupervisionTransportResult result = SupervisionTransportResult::Success(
+        SupervisionTransportOperation::kDiff);
+    result.sanitized_snapshot =
+        owner.service->GetSanitizedSnapshot(owner.stable_tab_id);
+    if (diff.delivery) {
+      owner.last_delivery = diff.delivery->stamp;
+      result.dashboard_authority = SupervisionDashboardWireAuthority{
+          .dashboard_session = std::string(wire_session),
+          .document_epoch = diff.delivery->stamp.document_epoch.ToString(),
+          .sequence = diff.delivery->stamp.sequence,
+      };
+    } else {
+      result.no_change = true;
+    }
+    Complete(std::move(callback), std::move(result));
+  }
+
+  void Ack(const SupervisionGatewayRequest& request,
+           SupervisionGatewayDispatcher::ResultCallback callback) {
+    const auto& params =
+        std::get<SupervisionAckParams>(request.transport.params);
+    DashboardOwner* owner = FindOwner(params.dashboard_session);
+    if (!owner || !owner->last_delivery ||
+        owner->last_delivery->document_epoch.ToString() !=
+            params.document_epoch ||
+        owner->last_delivery->sequence != params.sequence) {
+      CompleteUnknown(request.transport.operation, std::move(callback));
+      return;
+    }
+    SupervisionServiceResult ack =
+        owner->service->AckDashboard(owner->session, *owner->last_delivery);
+    SupervisionTransportResult result =
+        ack.ok
+            ? SupervisionTransportResult::Success(request.transport.operation)
+            : Failure(request.transport.operation, ack);
+    Complete(std::move(callback), std::move(result));
+  }
+
+  void Heartbeat(const SupervisionGatewayRequest& request,
+                 SupervisionGatewayDispatcher::ResultCallback callback) {
+    const auto& params =
+        std::get<SupervisionHeartbeatParams>(request.transport.params);
+    DashboardOwner* owner = FindOwner(params.dashboard_session);
+    if (!owner) {
+      CompleteUnknown(request.transport.operation, std::move(callback));
+      return;
+    }
+    SupervisionTransportResult result =
+        SupervisionTransportResult::Success(request.transport.operation);
+    result.sanitized_snapshot =
+        owner->service->GetSanitizedSnapshot(owner->stable_tab_id);
+    Complete(std::move(callback), std::move(result));
+  }
+
+  void End(const SupervisionGatewayRequest& request,
+           SupervisionGatewayDispatcher::ResultCallback callback) {
+    const auto& params =
+        std::get<SupervisionEndParams>(request.transport.params);
+    DashboardOwner* owner = FindOwner(params.dashboard_session);
+    if (!owner) {
+      CompleteUnknown(request.transport.operation, std::move(callback));
+      return;
+    }
+    SupervisionServiceResult ended = owner->service->EndSession(owner->session);
+    dashboard_owners_.erase(params.dashboard_session);
+    SupervisionTransportResult result =
+        ended.ok
+            ? SupervisionTransportResult::Success(request.transport.operation)
+            : Failure(request.transport.operation, ended);
+    if (ended.ok) {
+      result.ended = true;
+    }
+    Complete(std::move(callback), std::move(result));
+  }
+
+  void CompleteUnknown(SupervisionTransportOperation operation,
+                       SupervisionGatewayDispatcher::ResultCallback callback) {
+    Complete(std::move(callback),
+             SupervisionTransportResult::TransportFailure(
+                 operation, SupervisionTransportErrorCode::kUnavailable,
+                 "The dashboard session is unknown or expired",
+                 "Redeem a fresh local pairing"));
+  }
+
+  void Cancel(SupervisionGatewayCancellationToken token) {
+    auto pending = pending_diffs_.find(token.value);
+    if (pending == pending_diffs_.end()) {
+      return;
+    }
+    DashboardOwner* owner = FindOwner(pending->second.dashboard_session);
+    if (owner) {
+      owner->service->CancelDashboardDiffWait(pending->second.service_session,
+                                              pending->second.wait_token);
+    }
+    pending_diffs_.erase(pending);
+  }
+
+  SupervisionGatewayReadiness Readiness() {
+    if (shutdown_) {
+      return {SupervisionGatewayReadinessStatus::kUnavailable,
+              "Native supervision composition is stopped",
+              "Restart Prometheus"};
+    }
+    if (LoadedServices().empty()) {
+      return {SupervisionGatewayReadinessStatus::kNotReady,
+              "No loaded regular supervision service",
+              "Open a regular browser window"};
+    }
+    return {SupervisionGatewayReadinessStatus::kReady,
+            "Native supervision service is available",
+            "Create a local pairing to begin"};
+  }
+
+  void Shutdown() {
+    if (shutdown_) {
+      return;
+    }
+    shutdown_ = true;
+    std::vector<uint64_t> tokens;
+    tokens.reserve(pending_diffs_.size());
+    for (const auto& [token, ignored] : pending_diffs_) {
+      static_cast<void>(ignored);
+      tokens.push_back(token);
+    }
+    for (uint64_t token : tokens) {
+      Cancel(SupervisionGatewayCancellationToken{token});
+    }
+    pending_diffs_.clear();
+    dashboard_owners_.clear();
+    weak_factory_.InvalidateWeakPtrs();
+  }
+
+  std::map<std::string, DashboardOwner, std::less<>> dashboard_owners_;
+  std::map<uint64_t, PendingDiff> pending_diffs_;
+  bool shutdown_ = false;
+  base::WeakPtrFactory<PrometheusSupervisionComposition> weak_factory_{this};
+};
