 }
 
-void PrometheusAgentTabData::NotifyTabStateIfChanged() {}
+void PrometheusAgentTabData::NotifyTabStateIfChanged() {
+  PrometheusTabState state = ToTabState();
+  if (last_notified_tab_state_ && *last_notified_tab_state_ == state) {
+    return;
+  }
+  last_notified_tab_state_ = state;
+  for (PrometheusTabStateObserver& observer : tab_state_observers_) {
+    observer.OnPrometheusTabStateChanged(state);
+  }
+}
 
 bool PrometheusAgentTabData::HasOwner() const {
   return !owner_session_id_.empty();
