+void PrometheusSupervisionProfileService::TerminateViewer(
+    const base::UnguessableToken& dashboard_session,
+    SupervisionViewerState viewer_state,
+    SupervisionTerminalReason reason,
+    SupervisionAuditEvent audit_event,
+    SupervisionErrorCode error_code) {
+  auto viewer_it = viewers_.find(dashboard_session);
+  if (viewer_it == viewers_.end()) {
+    return;
+  }
+  std::unique_ptr<ViewerSession> viewer = std::move(viewer_it->second);
+  viewers_.erase(viewer_it);
+  auto controller = controllers_.find(viewer->stable_tab_id);
+  if (controller != controllers_.end() &&
+      controller->second == dashboard_session) {
+    controllers_.erase(controller);
+  }
+  viewer->viewer_state = viewer_state;
+  viewer->stream_state = SupervisionStreamState::kEnded;
+  viewer->terminal_reason = reason;
+  ++viewer->authority_generation;
+
+  SupervisionSessionSnapshot snapshot;
+  snapshot.client.display_label = viewer->client_label;
+  snapshot.client.connected_at_ms =
+      viewer->connected_at.InMillisecondsSinceUnixEpoch();
+  snapshot.client.last_seen_at_ms =
+      viewer->last_seen_at.InMillisecondsSinceUnixEpoch();
+  snapshot.client.expires_at_ms =
+      viewer->expires_at.InMillisecondsSinceUnixEpoch();
+  snapshot.viewer_state = viewer->viewer_state;
+  snapshot.stream_state = viewer->stream_state;
+  snapshot.terminal_reason = viewer->terminal_reason;
+
+  recent_terminal_sessions_.push_back(RecentTerminalSession{
+      dashboard_session, viewer->stable_tab_id, std::move(snapshot),
+      viewer->authority_generation, Now() + ViewerTtl(limits_)});
+  while (recent_terminal_sessions_.size() > limits_.sessions_per_profile) {
+    recent_terminal_sessions_.pop_front();
+  }
+
+  const int32_t stable_tab_id = viewer->stable_tab_id;
+  AddAudit(stable_tab_id, audit_event,
+           std::optional<std::string>(viewer->client_label), error_code);
+  NotifySnapshotChanged(stable_tab_id);
+  ScheduleObservedTabRelease(stable_tab_id);
+}
+
+void PrometheusSupervisionProfileService::TerminateViewersForTab(
+    int32_t stable_tab_id,
+    SupervisionViewerState viewer_state,
+    SupervisionTerminalReason reason,
+    SupervisionAuditEvent audit_event,
+    SupervisionErrorCode error_code) {
+  std::vector<base::UnguessableToken> sessions;
+  for (const auto& [dashboard_session, viewer] : viewers_) {
+    if (viewer->stable_tab_id == stable_tab_id) {
+      sessions.push_back(dashboard_session);
+    }
+  }
+  for (const base::UnguessableToken& dashboard_session : sessions) {
+    TerminateViewer(dashboard_session, viewer_state, reason, audit_event,
+                    error_code);
+  }
+}
+
+bool PrometheusSupervisionProfileService::RevalidateViewerOwner(
+    const base::UnguessableToken& dashboard_session) {
+  auto viewer = viewers_.find(dashboard_session);
+  if (viewer == viewers_.end()) {
+    return false;
+  }
+  auto observed = observed_tabs_.find(viewer->second->stable_tab_id);
+  if (!ResolveExactTarget(*viewer->second) ||
+      observed == observed_tabs_.end() || !observed->second->lease.data()) {
+    TerminateViewer(dashboard_session, SupervisionViewerState::kTargetClosed,
+                    SupervisionTerminalReason::kTargetClosed,
+                    SupervisionAuditEvent::kTargetClosed,
+                    SupervisionErrorCode::kStaleTarget);
+    return false;
+  }
+  if (observed->second->lease.data()->owner_session_id() !=
+      viewer->second->immutable_owner_session_id) {
+    TerminateViewer(dashboard_session, SupervisionViewerState::kAuthorityLost,
+                    SupervisionTerminalReason::kAuthorityLost,
+                    SupervisionAuditEvent::kAuthorityLost,
+                    SupervisionErrorCode::kViewOnly);
+    return false;
+  }
+  return true;
+}
