+                Action(SupervisionRemoteActionCategory::kNavigate)));
+}
+
+TEST_F(PrometheusSupervisionActionControllerTest,
+       UnknownScriptVaultAndAmbiguousShapesAreRejected) {
+  SupervisionRemoteActionRequest unknown =
+      Action(SupervisionRemoteActionCategory::kClick);
+  unknown.category = static_cast<SupervisionRemoteActionCategory>(999);
+  EXPECT_EQ(SupervisionActionClassification::kRejected,
+            PrometheusSupervisionActionController::Classify(unknown));
+  SupervisionRemoteActionRequest ambiguous =
+      Action(SupervisionRemoteActionCategory::kClick);
