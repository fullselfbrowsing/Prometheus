+bool PrometheusSupervisionCaptureHub::WaitForNextDiff(
+    SupervisionCaptureConsumerId consumer_id,
+    DiffWaitCallback callback) {
+  SweepExpiredConsumers();
+  auto consumer = consumers_.find(consumer_id);
+  if (!callback || consumer == consumers_.end() ||
+      consumer->second.pending_diff_wait) {
+    return false;
+  }
+  consumer->second.pending_diff_wait = std::move(callback);
+  NotifyReadyDiffWaiters();
+  return true;
+}
+
+bool PrometheusSupervisionCaptureHub::CancelDiffWait(
+    SupervisionCaptureConsumerId consumer_id) {
+  SweepExpiredConsumers();
+  auto consumer = consumers_.find(consumer_id);
+  if (consumer == consumers_.end() || !consumer->second.pending_diff_wait) {
+    return false;
+  }
+  consumer->second.pending_diff_wait.Reset();
   return true;
 }
 
