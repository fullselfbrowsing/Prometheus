+  gateway_->Start(base::BindOnce(
+      &PrometheusBrowserMainExtraParts::OnGatewayStarted,
+      weak_ptr_factory_.GetWeakPtr()));
+}
+
+void PrometheusBrowserMainExtraParts::OnGatewayStarted(bool started) {
+  if (!started || !gateway_ || supervision_test_composition_) {
+    return;
+  }
+  Profile* const exact_profile = FindSoleDisposableSupervisionTestProfile();
+  PrometheusSupervisionProfileService* const exact_service =
+      exact_profile
+          ? PrometheusSupervisionProfileServiceFactory::GetForProfile(
+                exact_profile)
+          : nullptr;
+  if (!exact_profile || !exact_service) {
+    return;
+  }
+
+  const base::WeakPtr<Profile> exact_profile_weak = exact_profile->GetWeakPtr();
+  PrometheusSupervisionTestCompositionHooks hooks;
+  hooks.profile_facts = {
+      .profile_identity = OpaquePointerIdentity(exact_profile),
+      .is_regular_profile = exact_profile->IsRegularProfile(),
+      .is_disposable_profile =
+          IsDisposableSupervisionTestProfile(exact_profile),
+      .is_off_the_record = exact_profile->IsOffTheRecord(),
+  };
+  hooks.service_available = true;
+  hooks.file_access = CreatePrometheusSupervisionTestBootstrapFileAccess();
+  hooks.binding =
+      base::BindRepeating(&ResolveSupervisionTestBindingFacts,
+                          base::Unretained(gateway_.get()), exact_profile_weak);
+  hooks.create_pairing_code =
+      base::BindRepeating(&CreateExactSupervisionTestPairingCode,
+                          base::Unretained(gateway_.get()), exact_profile_weak);
+  hooks.now =
+      base::BindRepeating([]() { return base::TimeTicks::Now(); });
+  hooks.set_dispatcher = base::BindRepeating(
+      [](PrometheusAgentGateway* gateway,
+         SupervisionTestHandoffDispatcher dispatcher) {
+        gateway->SetSupervisionTestHandoffDispatcher(std::move(dispatcher));
+      },
+      base::Unretained(gateway_.get()));
+
+#if defined(OFFICIAL_BUILD)
+  constexpr bool kIsOfficialBuild = true;
+#else
+  constexpr bool kIsOfficialBuild = false;
+#endif
+  const PrometheusSupervisionTestBootstrapResult result =
+      PrometheusSupervisionTestComposition::Create(
+          *base::CommandLine::ForCurrentProcess(), kIsOfficialBuild,
+          std::move(hooks), &supervision_test_composition_);
+  if (result != PrometheusSupervisionTestBootstrapResult::kApplied ||
+      !supervision_test_composition_ || !supervision_composition_) {
+    supervision_test_composition_.reset();
+    return;
+  }
+
+  supervision_composition_->SetPairingRedeemedCallback(base::BindRepeating(
+      [](base::WeakPtr<PrometheusSupervisionTestComposition> composition,
+         base::WeakPtr<PrometheusSupervisionProfileService> expected_service,
+         uint64_t profile_identity,
+         PrometheusSupervisionProfileService* redeemed_service,
+         int32_t stable_tab_id) {
+        if (composition && expected_service &&
+            expected_service.get() == redeemed_service) {
+          composition->ObservePairingRedeemedForExactTarget(profile_identity,
+                                                            stable_tab_id);
+        }
+      },
+      supervision_test_composition_->GetWeakPtr(), exact_service->GetWeakPtr(),
+      OpaquePointerIdentity(exact_profile)));
 }
 
