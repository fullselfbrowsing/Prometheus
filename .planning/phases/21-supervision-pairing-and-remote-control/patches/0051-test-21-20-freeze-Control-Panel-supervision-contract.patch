 }
 
+void PrometheusControlPanelUI::SendControlPairingCreateResult(
+    prometheus::PrometheusControlSupervisionCreateResult result) {
+  web_ui()->CallJavascriptFunctionUnsafe(
+      "prometheusControlReceivePairingCreateResult",
+      base::Value(
+          prometheus::ControlSupervisionCreateResultValue(std::move(result))));
+}
