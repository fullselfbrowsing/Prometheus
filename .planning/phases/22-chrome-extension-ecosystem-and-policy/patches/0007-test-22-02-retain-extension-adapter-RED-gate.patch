@@ -5,6 +5,7 @@
 #include "chrome/browser/prometheus/prometheus_agent_audit.h"
 
 #include "base/time/time.h"
+#include "chrome/browser/prometheus/prometheus_extension_page_adapter.h"
 #include "testing/gtest/include/gtest/gtest.h"
 
 namespace prometheus {
@@ -159,4 +160,28 @@ TEST_F(PrometheusAgentAuditTest, StoresStableErrorAndTargetMetadata) {
   EXPECT_EQ(base::Milliseconds(7), records[0].elapsed);
 }
 
+TEST(PrometheusExtensionAgentAuditTest,
+     ProjectionRejectsContentFullIdentityAndAuthoritySentinels) {
+  ASSERT_TRUE(ExtensionAgentDispatchContractImplementedForTesting())
+      << "retained RED: extension audit projection is not implemented";
+  const auto safe =
+      PrometheusExtensionPageAdapter::BuildAuditProjectionForTesting(
+          "aaaaaaaaaaaaaaaaaaaaaaaaaabc123",
+          PrometheusExtensionSurfaceKind::kSidePanel,
+          ExtensionAgentGrant::kInteract, "allowed");
+  EXPECT_TRUE(
+      PrometheusExtensionPageAdapter::IsAuditProjectionSafeForTesting(safe));
+
+  for (const std::string& sentinel :
+       {"page_content", "form_value", "script", "profile_path",
+        "browser-issued-session", "gateway_bearer", "vault",
+        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}) {
+    auto unsafe = safe;
+    unsafe.result = sentinel;
+    EXPECT_FALSE(
+        PrometheusExtensionPageAdapter::IsAuditProjectionSafeForTesting(
+            unsafe));
+  }
+}
+
 }  // namespace prometheus
