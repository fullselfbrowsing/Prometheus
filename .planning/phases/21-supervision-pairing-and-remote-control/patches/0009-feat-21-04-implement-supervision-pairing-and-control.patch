+void PrometheusSupervisionProfileService::ScheduleObservedTabRelease(
+    int32_t stable_tab_id) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          &PrometheusSupervisionProfileService::ReleaseObservedTabIfUnused,
+          weak_factory_.GetWeakPtr(), stable_tab_id));
+}
