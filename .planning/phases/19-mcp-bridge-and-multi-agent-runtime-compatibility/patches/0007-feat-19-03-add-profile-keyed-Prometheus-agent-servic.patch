+
+class PrometheusAgentProfileServiceFactory : public ProfileKeyedServiceFactory {
+ public:
+  explicit PrometheusAgentProfileServiceFactory(
+      base::PassKey<PrometheusAgentProfileServiceFactory>);
+
+  static PrometheusAgentProfileServiceFactory* GetInstance();
+  static PrometheusAgentProfileService* GetForProfile(Profile* profile);
+
+  PrometheusAgentProfileServiceFactory(
+      const PrometheusAgentProfileServiceFactory&) = delete;
+  PrometheusAgentProfileServiceFactory& operator=(
+      const PrometheusAgentProfileServiceFactory&) = delete;
+
+  bool ServiceIsCreatedWithBrowserContext() const override;
+  std::unique_ptr<KeyedService> BuildServiceInstanceForBrowserContext(
+      content::BrowserContext* context) const override;
+
+ private:
+  ~PrometheusAgentProfileServiceFactory() override;
+};
