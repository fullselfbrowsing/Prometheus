+  tasks_[handle->task_id] = RuntimeTaskRecord{
+      .snapshot = snapshot,
+      .generation = handle->generation,
+      .authority = std::move(request.authority),
+      .submission_fingerprint = fingerprint,
+      .provider = *provider,
