@@ -0,0 +1,315 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_supervision_capture_hub.h"
+
+#include <deque>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/time/time.h"
+#include "base/unguessable_token.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace prometheus {
+namespace {
+
+SupervisionBaseline MakeBaseline(std::string name,
+                                 size_t serialized_bytes = 32u) {
+  SupervisionNormalizedNode node;
+  node.ref = "document:1";
+  node.tag = "root";
+  node.name = std::move(name);
+
+  SupervisionBaseline baseline;
+  baseline.state = SupervisionProjectionState::kAuthoritative;
+  baseline.nodes.push_back(std::move(node));
+  baseline.serialized_json.assign(serialized_bytes, 'b');
+  return baseline;
+}
+
+class TestCaptureSource {
+ public:
+  void Capture(base::OnceCallback<void(SupervisionBaseline)> callback) {
+    pending_.push_back(std::move(callback));
+  }
+
+  size_t pending_count() const { return pending_.size(); }
+
+  void CompleteNext(SupervisionBaseline baseline) {
+    ASSERT_FALSE(pending_.empty());
+    auto callback = std::move(pending_.front());
+    pending_.pop_front();
+    std::move(callback).Run(std::move(baseline));
+  }
+
+ private:
+  std::deque<base::OnceCallback<void(SupervisionBaseline)>> pending_;
+};
+
+class PrometheusSupervisionCaptureHubTest : public testing::Test {
+ protected:
+  std::unique_ptr<PrometheusSupervisionCaptureHub> CreateHub(
+      const SupervisionLimits& limits = SupervisionLimits()) {
+    auto hub = std::make_unique<PrometheusSupervisionCaptureHub>(
+        17, limits,
+        base::BindRepeating(&TestCaptureSource::Capture,
+                            base::Unretained(&capture_source_)));
+    hub->SetNowCallbackForTesting(base::BindRepeating(
+        [](base::Time* now) { return *now; }, base::Unretained(&now_)));
+    return hub;
+  }
+
+  std::pair<SupervisionCaptureConsumerId, SupervisionCaptureConsumerId>
+  AttachTwo(PrometheusSupervisionCaptureHub& hub) {
+    const auto first = hub.AttachConsumer(
+        SupervisionCaptureConsumerKind::kDashboard, now_ + base::Minutes(10));
+    const auto second = hub.AttachConsumer(
+        SupervisionCaptureConsumerKind::kAgentCompatibility,
+        now_ + base::Minutes(10));
+    EXPECT_TRUE(first.has_value());
+    EXPECT_TRUE(second.has_value());
+    return {first.value_or(0u), second.value_or(0u)};
+  }
+
+  void CompleteAndAckBaseline(PrometheusSupervisionCaptureHub& hub,
+                              SupervisionCaptureConsumerId first,
+                              SupervisionCaptureConsumerId second,
+                              std::string name = "initial") {
+    capture_source_.CompleteNext(MakeBaseline(std::move(name)));
+    const auto first_baseline = hub.ReadBaseline(first);
+    const auto second_baseline = hub.ReadBaseline(second);
+    ASSERT_TRUE(first_baseline.has_value());
+    ASSERT_TRUE(second_baseline.has_value());
+    EXPECT_EQ(first_baseline->stamp.document_epoch,
+              second_baseline->stamp.document_epoch);
+    EXPECT_EQ(first_baseline->stamp.sequence,
+              second_baseline->stamp.sequence);
+    EXPECT_NE(first_baseline->stamp.session, second_baseline->stamp.session);
+    ASSERT_TRUE(hub.Ack(first, first_baseline->stamp));
+    ASSERT_TRUE(hub.Ack(second, second_baseline->stamp));
+  }
+
+  base::Time now_ = base::Time::UnixEpoch() + base::Hours(1);
+  TestCaptureSource capture_source_;
+};
+
+TEST_F(PrometheusSupervisionCaptureHubTest,
+       TwoConsumersShareOneEnableAndInitialCapture) {
+  auto hub = CreateHub();
+  const auto [first, second] = AttachTwo(*hub);
+
+  EXPECT_EQ(2u, hub->consumer_count());
+  EXPECT_EQ(1u, hub->enable_count_for_testing());
+  EXPECT_EQ(1u, hub->capture_count_for_testing());
+  EXPECT_EQ(1u, capture_source_.pending_count());
+
+  capture_source_.CompleteNext(MakeBaseline("initial"));
+  const auto first_baseline = hub->ReadBaseline(first);
+  const auto second_baseline = hub->ReadBaseline(second);
+  ASSERT_TRUE(first_baseline.has_value());
+  ASSERT_TRUE(second_baseline.has_value());
+  EXPECT_EQ(first_baseline->baseline, second_baseline->baseline);
+  EXPECT_EQ(first_baseline->stamp.document_epoch,
+            second_baseline->stamp.document_epoch);
+  EXPECT_EQ(1u, first_baseline->stamp.sequence);
+}
+
+TEST_F(PrometheusSupervisionCaptureHubTest,
+       IndependentAcknowledgementsAndReadsDoNotAdvancePeers) {
+  auto hub = CreateHub();
+  const auto [first, second] = AttachTwo(*hub);
+  CompleteAndAckBaseline(*hub, first, second);
+
+  hub->NotifyDirtyForTesting(/*overflow=*/false);
+  hub->NotifyDirtyForTesting(/*overflow=*/false);
+  EXPECT_EQ(2u, hub->capture_count_for_testing());
+  EXPECT_EQ(1u, capture_source_.pending_count());
+  capture_source_.CompleteNext(MakeBaseline("changed"));
+
+  const auto first_diff = hub->ReadNext(first);
+  const auto second_diff = hub->ReadNext(second);
+  ASSERT_TRUE(first_diff.has_value());
+  ASSERT_TRUE(second_diff.has_value());
+  EXPECT_EQ(first_diff->stamp.sequence, second_diff->stamp.sequence);
+  EXPECT_EQ(first_diff->diff, second_diff->diff);
+  EXPECT_TRUE(hub->Ack(first, first_diff->stamp));
+  EXPECT_FALSE(hub->ReadNext(first).has_value());
+  ASSERT_TRUE(hub->ReadNext(second).has_value());
+  EXPECT_EQ(second_diff->stamp.sequence,
+            hub->ReadNext(second)->stamp.sequence);
+}
+
+TEST_F(PrometheusSupervisionCaptureHubTest,
+       ExpiryRevokeAndDetachRemainConsumerLocal) {
+  auto hub = CreateHub();
+  const auto expiring = hub->AttachConsumer(
+      SupervisionCaptureConsumerKind::kDashboard, now_ + base::Seconds(1));
+  const auto surviving = hub->AttachConsumer(
+      SupervisionCaptureConsumerKind::kDashboard, now_ + base::Minutes(1));
+  ASSERT_TRUE(expiring.has_value());
+  ASSERT_TRUE(surviving.has_value());
+  capture_source_.CompleteNext(MakeBaseline("initial"));
+
+  now_ += base::Seconds(2);
+  hub->SweepExpiredConsumers();
+  EXPECT_EQ(1u, hub->consumer_count());
+  EXPECT_FALSE(hub->ReadBaseline(*expiring).has_value());
+  EXPECT_TRUE(hub->ReadBaseline(*surviving).has_value());
+  EXPECT_TRUE(hub->RevokeConsumer(*surviving));
+  EXPECT_EQ(0u, hub->consumer_count());
+  EXPECT_EQ(1u, hub->disable_count_for_testing());
+}
+
+TEST_F(PrometheusSupervisionCaptureHubTest,
+       LaggingConsumerAloneRequiresBaselineAtHistoryCap) {
+  SupervisionLimits limits;
+  limits.retained_batches = 1;
+  auto hub = CreateHub(limits);
+  const auto [lagging, current] = AttachTwo(*hub);
+  CompleteAndAckBaseline(*hub, lagging, current);
+
+  hub->NotifyDirtyForTesting(/*overflow=*/false);
+  capture_source_.CompleteNext(MakeBaseline("change-one"));
+  const auto current_first = hub->ReadNext(current);
+  ASSERT_TRUE(current_first.has_value());
+  ASSERT_TRUE(hub->Ack(current, current_first->stamp));
+
+  hub->NotifyDirtyForTesting(/*overflow=*/false);
+  capture_source_.CompleteNext(MakeBaseline("change-two"));
+
+  EXPECT_TRUE(hub->ConsumerNeedsBaseline(lagging));
+  EXPECT_FALSE(hub->ConsumerNeedsBaseline(current));
+  ASSERT_TRUE(hub->ReadNext(current).has_value());
+  EXPECT_FALSE(hub->ReadNext(lagging).has_value());
+}
+
+TEST_F(PrometheusSupervisionCaptureHubTest,
+       OverflowForcesFreshBaselineWithoutPartialDiff) {
+  auto hub = CreateHub();
+  const auto [first, second] = AttachTwo(*hub);
+  CompleteAndAckBaseline(*hub, first, second);
+
+  hub->NotifyDirtyForTesting(/*overflow=*/true);
+  capture_source_.CompleteNext(MakeBaseline("overflow replacement"));
+
+  EXPECT_TRUE(hub->ConsumerNeedsBaseline(first));
+  EXPECT_TRUE(hub->ConsumerNeedsBaseline(second));
+  EXPECT_EQ(0u, hub->retained_batch_count_for_testing());
+  EXPECT_TRUE(hub->ReadBaseline(first).has_value());
+  EXPECT_TRUE(hub->ReadBaseline(second).has_value());
+}
