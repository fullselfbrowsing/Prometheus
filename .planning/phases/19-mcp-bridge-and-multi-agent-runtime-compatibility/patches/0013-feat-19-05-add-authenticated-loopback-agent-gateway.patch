+void PrometheusAgentGateway::SetRequestTimeoutForTesting(
+    base::TimeDelta timeout) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  request_timeout_ = timeout;
+  if (io_data_) {
+    io_thread_.task_runner()->PostTask(
+        FROM_HERE, base::BindOnce(&IOThreadData::SetTimeout,
+                                  base::Unretained(io_data_.get()), timeout));
+  }
+}
+
