+      EXPECT_EQ(RuntimeStoreStatus::kOk,
+                store->FinishTaskOnce(task.task_id, generation, edge.to, error,
+                                      RuntimeSafeResult(), RuntimeUsage(),
+                                      start + 4));
+    } else {
+      EXPECT_TRUE(
+          store->TransitionTask(task.task_id, generation, edge.to, start + 4)
+              .ok());
+    }
+  }
+}
