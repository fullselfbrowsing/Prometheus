+bool SupervisionPayloadMatchesRoute(
+    const AgentSupervisionTransportResult& result) {
+  switch (result.route_name) {
+    case AgentRouteName::kCreateSupervisionPairing:
+      return std::holds_alternative<AgentSupervisionLocalUiResult>(
+          result.payload);
+    case AgentRouteName::kStartSupervisionSession:
+    case AgentRouteName::kGetSupervisionSnapshot:
+      return std::holds_alternative<AgentSupervisionBaselineResult>(
+          result.payload);
+    case AgentRouteName::kGetSupervisionDiff:
+      return std::holds_alternative<AgentSupervisionDiffResult>(
+                 result.payload) ||
+             std::holds_alternative<AgentSupervisionNoChangeResult>(
+                 result.payload);
+    case AgentRouteName::kEndSupervisionSession:
+      return std::holds_alternative<AgentSupervisionEndedResult>(
+          result.payload);
+    default:
+      return false;
+  }
+}
