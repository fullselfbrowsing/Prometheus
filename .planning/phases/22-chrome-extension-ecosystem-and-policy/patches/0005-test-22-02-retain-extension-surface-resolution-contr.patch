+TEST(PrometheusExtensionSurfaceResolverTest, RejectsDeveloperTools) {
+  auto evidence = VisibleTabEvidence();
+  evidence.observed_context =
+      PrometheusExtensionObservedContext::kDeveloperTools;
+  ExpectDenied(evidence,
+               PrometheusExtensionSurfaceDenial::kUnsupportedContext,
+               AgentErrorCode::kInvalidTarget);
+}
+
+TEST(PrometheusExtensionSurfaceResolverTest,
+     RejectsNonPrimaryOptionsGuest) {
+  auto evidence = VisibleTabEvidence();
+  evidence.observed_context =
+      PrometheusExtensionObservedContext::kOptionsGuest;
+  evidence.options_guest_primary_frame = false;
+  ExpectDenied(evidence,
+               PrometheusExtensionSurfaceDenial::kAmbiguousOptionsGuest,
+               AgentErrorCode::kInvalidTarget);
+}
+
+TEST(PrometheusExtensionSurfaceResolverTest, RejectsAmbiguousOptionsGuest) {
+  auto evidence = VisibleTabEvidence();
+  evidence.observed_context =
+      PrometheusExtensionObservedContext::kOptionsGuest;
+  evidence.options_guest_ambiguous = true;
+  ExpectDenied(evidence,
+               PrometheusExtensionSurfaceDenial::kAmbiguousOptionsGuest,
+               AgentErrorCode::kInvalidTarget);
+}
+
+TEST(PrometheusExtensionSurfaceResolverTest, RejectsWrongBrowser) {
+  auto evidence = VisiblePopupEvidence();
+  evidence.exact_browser = false;
+  ExpectDenied(evidence, PrometheusExtensionSurfaceDenial::kWrongBrowser,
+               AgentErrorCode::kInvalidTarget);
+}
+
+TEST(PrometheusExtensionSurfaceResolverTest, RejectsWrongProfile) {
+  auto evidence = VisibleTabEvidence();
+  evidence.exact_browser_context = false;
+  ExpectDenied(evidence,
+               PrometheusExtensionSurfaceDenial::kWrongBrowserContext,
+               AgentErrorCode::kInvalidTarget);
+}
+
+TEST(PrometheusExtensionSurfaceResolverTest,
+     RejectsSharedRegistryWrongOffTheRecordContext) {
+  auto evidence = VisibleSidePanelEvidence();
+  evidence.exact_browser_context = false;
+  ExpectDenied(evidence,
+               PrometheusExtensionSurfaceDenial::kWrongBrowserContext,
+               AgentErrorCode::kInvalidTarget);
+}
