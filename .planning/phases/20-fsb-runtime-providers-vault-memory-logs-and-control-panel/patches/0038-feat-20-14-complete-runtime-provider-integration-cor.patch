+IN_PROC_BROWSER_TEST_F(PrometheusMcpIntegrationBrowserTest,
+                       RuntimeExternalGatewayWorkflows) {
+  PrometheusRuntimeProfileService* runtime =
+      PrometheusRuntimeProfileServiceFactory::GetForProfile(
+          browser()->profile());
+  ASSERT_TRUE(runtime);
+  const PrometheusProviderConfig provider =
+      MakeCorpusProvider("openai_responses", 1000);
+  ASSERT_EQ(
+      RuntimeProfileStatus::kOk,
+      runtime->SetProviders(RuntimeCallerOrigin::kLocalControlUi, {provider}));
+
+  const std::string owner = SessionId(CreateSession("Runtime owner"));
+  const std::string peer = SessionId(CreateSession("Runtime peer"));
+  ASSERT_FALSE(owner.empty());
+  ASSERT_FALSE(peer.empty());
+
+  base::DictValue empty_params;
+  base::DictValue diagnostics = Command(owner, "runtime_diagnostics",
+                                        std::nullopt, std::move(empty_params));
+  ASSERT_TRUE(diagnostics.FindBool("ok").value_or(false));
+  const base::DictValue* diagnostics_result = diagnostics.FindDict("result");
+  ASSERT_TRUE(diagnostics_result);
+  const base::ListValue* components =
+      diagnostics_result->FindList("components");
+  ASSERT_TRUE(components);
+  EXPECT_EQ(4u, components->size());
+
+  base::DictValue provider_params;
+  provider_params.Set("include_disabled", true);
+  base::DictValue providers = Command(owner, "list_providers", std::nullopt,
+                                      std::move(provider_params));
+  ASSERT_TRUE(providers.FindBool("ok").value_or(false));
+  const base::ListValue* provider_list =
+      providers.FindDict("result")->FindList("providers");
+  ASSERT_TRUE(provider_list);
+  ASSERT_EQ(1u, provider_list->size());
+  EXPECT_EQ(provider.provider_id,
+            *provider_list->front().GetDict().FindString("provider_id"));
+
+  base::DictValue mutation_params;
+  mutation_params.Set("provider_id", provider.provider_id);
+  mutation_params.Set("model_id", "forbidden-mcp-mutation");
+  base::DictValue mutation = Command(owner, "set_provider_config", std::nullopt,
+                                     std::move(mutation_params));
+  ExpectCode(mutation, "LOCAL_UI_REQUIRED");
+  ASSERT_EQ(1u, runtime->ListProvidersForTransport().size());
+  EXPECT_EQ(provider.model_id,
+            runtime->ListProvidersForTransport().front().model_id);
+
+  base::DictValue memory_params;
+  memory_params.Set("title", "Bounded note");
+  memory_params.Set("text", "Safe caller-owned memory");
+  base::ListValue memory_tags;
+  memory_tags.Append("phase20");
+  memory_params.Set("tags", std::move(memory_tags));
+  memory_params.Set("shared", false);
+  base::DictValue saved_memory =
+      Command(owner, "save_memory", std::nullopt, std::move(memory_params));
+  ASSERT_TRUE(saved_memory.FindBool("ok").value_or(false));
+  ASSERT_TRUE(saved_memory.FindDict("result")->FindDict("memory"));
+
+  base::DictValue list_memory_params;
+  list_memory_params.Set("limit", 20);
+  base::DictValue listed_memory = Command(owner, "list_memory", std::nullopt,
+                                          std::move(list_memory_params));
+  ASSERT_TRUE(listed_memory.FindBool("ok").value_or(false));
+  ASSERT_EQ(1u, listed_memory.FindDict("result")->FindList("memories")->size());
+
+  base::DictValue guide_params;
+  guide_params.Set("title", "Exact origin guide");
+  guide_params.Set("instructions", "Use only the visible account menu");
+  guide_params.Set("canonical_origin", "https://example.test");
+  base::ListValue guide_tags;
+  guide_tags.Append("account");
+  guide_params.Set("tags", std::move(guide_tags));
+  guide_params.Set("shared", false);
+  base::DictValue saved_guide =
+      Command(owner, "save_site_guide", std::nullopt, std::move(guide_params));
+  ASSERT_TRUE(saved_guide.FindBool("ok").value_or(false));
+  const base::DictValue* saved_guide_value =
+      saved_guide.FindDict("result")->FindDict("guide");
+  ASSERT_TRUE(saved_guide_value);
+  EXPECT_EQ("https://example.test",
+            *saved_guide_value->FindString("canonical_origin"));
+
+  base::DictValue list_guides_params;
+  list_guides_params.Set("limit", 20);
+  base::DictValue listed_guides = Command(
+      owner, "list_site_guides", std::nullopt, std::move(list_guides_params));
+  ASSERT_TRUE(listed_guides.FindBool("ok").value_or(false));
+  ASSERT_EQ(1u, listed_guides.FindDict("result")->FindList("guides")->size());
+
+  constexpr std::string_view kRawPrompt =
+      "Open https://example.test/?token=EVAL_RAW_PROMPT_SENTINEL";
+  base::DictValue run_params;
+  run_params.Set("prompt", kRawPrompt);
+  run_params.Set("requested_execution", "auto");
+  base::DictValue submitted =
+      Command(owner, "run_task", std::nullopt, std::move(run_params));
+  ASSERT_TRUE(submitted.FindBool("ok").value_or(false))
+      << base::WriteJson(submitted).value_or("");
+  const base::DictValue* task = submitted.FindDict("result")->FindDict("task");
+  ASSERT_TRUE(task);
+  const std::string* task_id = task->FindString("task_id");
+  ASSERT_TRUE(task_id);
+  EXPECT_EQ("Task: Open [link]", *task->FindString("safe_title"));
+  EXPECT_EQ(std::string::npos, base::WriteJson(submitted).value_or("").find(
+                                   "EVAL_RAW_PROMPT_SENTINEL"));
+
+  base::DictValue status_params;
+  status_params.Set("task_id", *task_id);
+  base::DictValue status =
+      Command(owner, "get_task_status", std::nullopt, std::move(status_params));
+  ASSERT_TRUE(status.FindBool("ok").value_or(false));
+  EXPECT_EQ("queued",
+            *status.FindDict("result")->FindDict("task")->FindString("state"));
+
+  base::DictValue peer_status_params;
+  peer_status_params.Set("task_id", *task_id);
+  base::DictValue peer_status = Command(peer, "get_task_status", std::nullopt,
+                                        std::move(peer_status_params));
+  ExpectCode(peer_status, "NOT_FOUND");
+
+  base::DictValue logs_params;
+  logs_params.Set("limit", 20);
+  base::DictValue logs =
+      Command(owner, "get_logs", std::nullopt, std::move(logs_params));
+  ASSERT_TRUE(logs.FindBool("ok").value_or(false));
+  EXPECT_FALSE(logs.FindDict("result")->FindList("logs")->empty());
+  EXPECT_EQ(std::string::npos, base::WriteJson(logs).value_or("").find(
+                                   "EVAL_RAW_PROMPT_SENTINEL"));
+
+  base::DictValue stop_params;
+  stop_params.Set("task_id", *task_id);
+  base::DictValue stopped =
+      Command(owner, "stop_task", std::nullopt, std::move(stop_params));
+  ASSERT_TRUE(stopped.FindBool("ok").value_or(false));
+  EXPECT_EQ("cancelled",
+            *stopped.FindDict("result")->FindDict("task")->FindString("state"));
+
+  for (const base::DictValue* response :
+       {&diagnostics, &providers, &mutation, &saved_memory, &listed_memory,
+        &saved_guide, &listed_guides, &submitted, &status, &peer_status, &logs,
+        &stopped}) {
+    const std::string serialized = base::WriteJson(*response).value_or("");
+    for (std::string_view forbidden :
+         {"EVAL_SECRET_SENTINEL", "EVAL_TYPED_SECRET_SENTINEL",
+          "EVAL_PAGE_SENTINEL", "EVAL_AUTHORITY_SENTINEL",
+          "EVAL_BOOTSTRAP_CONFIG_SENTINEL", "ciphertext-sentinel",
+          "provider-body-sentinel", "/Users/private/profile"}) {
+      EXPECT_EQ(std::string::npos, serialized.find(forbidden));
+    }
+  }
+}
