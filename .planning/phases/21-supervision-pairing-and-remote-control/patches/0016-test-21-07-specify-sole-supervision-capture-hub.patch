+#include "chrome/browser/prometheus/prometheus_supervision_types.h"
+#include "content/public/browser/web_contents_observer.h"
+
+namespace content {
+class NavigationHandle;
+class Page;
+class RenderFrameHost;
+class WebContents;
+}  // namespace content
+
+namespace prometheus {
+
+enum class SupervisionCaptureConsumerKind {
+  kDashboard,
+  kAgentCompatibility,
+};
+
+using SupervisionCaptureConsumerId = uint64_t;
+
+// Consumer-facing deliveries carry only browser-created stream stamps and
+// privacy-filtered projection output. Mojo endpoints and renderer identity are
+// intentionally not representable in this API.
+struct SupervisionCaptureBaselineDelivery {
+  SupervisionStreamStamp stamp;
+  SupervisionBaseline baseline;
+};
+
+struct SupervisionCaptureDiffDelivery {
+  SupervisionStreamStamp stamp;
+  SupervisionDiff diff;
+};
+
+// One hub is bound to one stable target and its current primary page. It is the
+// sole owner of renderer control pipes, dirty-host receivers, APC capture,
+// normalized tree/history, document epoch, and sequence for that target.
+class PrometheusSupervisionCaptureHub : public content::WebContentsObserver {
+ public:
+  using CaptureForTestingCallback = base::RepeatingCallback<void(
+      base::OnceCallback<void(SupervisionBaseline)>)>;
+  using NowCallback = base::RepeatingCallback<base::Time()>;
+
+  PrometheusSupervisionCaptureHub(
+      content::WebContents* web_contents,
+      int32_t stable_tab_id,
+      const SupervisionLimits& limits = SupervisionLimits());
+
+  // State-machine-only construction for deterministic unit tests. Production
+  // callers must use the exact-WebContents constructor above.
+  PrometheusSupervisionCaptureHub(
+      int32_t stable_tab_id,
+      const SupervisionLimits& limits,
+      CaptureForTestingCallback capture_for_testing);
+
+  ~PrometheusSupervisionCaptureHub() override;
+
+  PrometheusSupervisionCaptureHub(
+      const PrometheusSupervisionCaptureHub&) = delete;
+  PrometheusSupervisionCaptureHub& operator=(
+      const PrometheusSupervisionCaptureHub&) = delete;
+
+  std::optional<SupervisionCaptureConsumerId> AttachConsumer(
+      SupervisionCaptureConsumerKind kind,
+      base::Time expiry);
+  std::optional<SupervisionCaptureBaselineDelivery> ReadBaseline(
+      SupervisionCaptureConsumerId consumer_id);
+  std::optional<SupervisionCaptureDiffDelivery> ReadNext(
+      SupervisionCaptureConsumerId consumer_id);
+  bool Ack(SupervisionCaptureConsumerId consumer_id,
+           const SupervisionStreamStamp& stamp);
+  bool RevokeConsumer(SupervisionCaptureConsumerId consumer_id);
+  bool DetachConsumer(SupervisionCaptureConsumerId consumer_id);
+  void SweepExpiredConsumers();
+
+  size_t consumer_count() const { return consumers_.size(); }
+  bool ConsumerNeedsBaseline(
+      SupervisionCaptureConsumerId consumer_id) const;
+
+  // Deterministic lifecycle hooks and counters. They expose no endpoint or
+  // document identity and are used only by native/browser verification.
+  void SetNowCallbackForTesting(NowCallback now_callback);
+  void NotifyDirtyForTesting(bool overflow);
+  void ReplaceDocumentForTesting();
+  void DisconnectRendererForTesting();
+  size_t enable_count_for_testing() const { return enable_count_; }
+  size_t disable_count_for_testing() const { return disable_count_; }
+  size_t capture_count_for_testing() const { return capture_count_; }
+  size_t retained_batch_count_for_testing() const { return history_.size(); }
+  size_t retained_bytes_for_testing() const { return retained_bytes_; }
+  bool capture_in_flight_for_testing() const { return capture_in_flight_; }
+
+ private:
+  class FrameEntry;
+
+  struct SharedBatch {
+    uint64_t sequence = 0;
+    SupervisionDiff diff;
+  };
+
+  struct ConsumerState {
+    SupervisionCaptureConsumerKind kind =
+        SupervisionCaptureConsumerKind::kDashboard;
+    base::UnguessableToken session;
+    base::Time expiry;
+    uint64_t acknowledged_sequence = 0;
+    uint64_t next_sequence = 0;
+    bool needs_baseline = true;
+  };
+
+  // content::WebContentsObserver:
+  void RenderFrameCreated(content::RenderFrameHost* render_frame_host) override;
+  void RenderFrameDeleted(content::RenderFrameHost* render_frame_host) override;
+  void PrimaryPageChanged(content::Page& page) override;
+  void DidFinishNavigation(
+      content::NavigationHandle* navigation_handle) override;
+  void WebContentsDestroyed() override;
+
+  base::Time Now() const;
+  void StartObservation();
+  void StopObservation();
+  void StartNewDocumentEpoch();
+  void BindCurrentFrames();
+  void BindFrame(content::RenderFrameHost* render_frame_host);
+  void OnFrameDirty(content::RenderFrameHost* render_frame_host,
+                    uint64_t frame_generation,
+                    bool overflow);
+  void OnFrameDisconnected(content::RenderFrameHost* render_frame_host,
+                           uint64_t frame_generation);
+  void RequestCapture(bool force_baseline);
+  void OnCapturedForTesting(uint64_t capture_generation,
+                            bool force_baseline,
+                            SupervisionBaseline baseline);
+  void RequireBaselineForAll();
+  void RequireBaseline(ConsumerState& consumer);
+  void PruneHistory();
+  bool HasCurrentConsumer(SupervisionCaptureConsumerId consumer_id) const;
+
+  [[maybe_unused]] const int32_t stable_tab_id_;
+  const SupervisionLimits limits_;
+  CaptureForTestingCallback capture_for_testing_;
+  NowCallback now_callback_;
+
+  std::map<content::RenderFrameHost*, std::unique_ptr<FrameEntry>> frames_;
+  std::map<SupervisionCaptureConsumerId, ConsumerState> consumers_;
+  std::deque<SharedBatch> history_;
+  size_t retained_bytes_ = 0;
+  SupervisionBaseline baseline_;
+  base::UnguessableToken document_epoch_;
+  [[maybe_unused]] uint64_t sequence_ = 0;
+  [[maybe_unused]] uint64_t document_generation_ = 0;
+  [[maybe_unused]] uint64_t capture_generation_ = 0;
+  [[maybe_unused]] uint64_t next_frame_generation_ = 0;
+  [[maybe_unused]] SupervisionCaptureConsumerId next_consumer_id_ = 0;
+  [[maybe_unused]] bool observing_ = false;
+  bool capture_in_flight_ = false;
+  [[maybe_unused]] bool dirty_while_capturing_ = false;
+  [[maybe_unused]] bool force_baseline_after_capture_ = false;
+  [[maybe_unused]] bool destroyed_ = false;
+  size_t enable_count_ = 0;
+  size_t disable_count_ = 0;
+  size_t capture_count_ = 0;
+
+  base::WeakPtrFactory<PrometheusSupervisionCaptureHub> weak_factory_{this};
+};
+
+}  // namespace prometheus
+
+#endif  // CHROME_BROWSER_PROMETHEUS_PROMETHEUS_SUPERVISION_CAPTURE_HUB_H_
