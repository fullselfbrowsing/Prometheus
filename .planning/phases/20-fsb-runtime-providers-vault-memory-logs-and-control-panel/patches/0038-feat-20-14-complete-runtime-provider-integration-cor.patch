+PrometheusProviderConfig MakeCorpusProvider(std::string_view family,
+                                            size_t index) {
+  PrometheusProviderKind kind = PrometheusProviderKind::kOpenAI;
+  if (family == "openai_chat") {
+    kind = PrometheusProviderKind::kCustom;
+  } else if (family == "anthropic_messages") {
+    kind = PrometheusProviderKind::kAnthropic;
+  } else if (family == "gemini_generate_content") {
+    kind = PrometheusProviderKind::kGemini;
+  }
+  PrometheusProviderConfig provider{
+      .provider_id = "phase20-eval-" + base::NumberToString(index),
+      .label = "Phase 20 fake provider",
+      .kind = kind,
+      .family = ExpectedPrometheusProviderFamily(kind),
+      .route_class = ExpectedPrometheusProviderRouteClass(kind),
+      .canonical_endpoint = kind == PrometheusProviderKind::kCustom
+                                ? "https://models.example.test/v1/"
+                                : *FixedPrometheusProviderEndpoint(kind),
+      .model_id = "model-1.0",
+      .enabled = true,
+      .health = PrometheusProviderHealth::kHealthy,
+      .discovery_state = PrometheusProviderDiscoveryState::kNotStarted,
+      .capabilities = {.tool_calling = true,
+                       .model_discovery = true,
+                       .responses_api = family == "openai_responses"},
+      .secret_configured = true,
+      .fallback_rank = 0,
+      .input_rate_microunits = 11,
+      .output_rate_microunits = 13,
+      .trusted = true,
+  };
+  return provider;
+}
+
+ProviderTurnRequest MakeCorpusTurnRequest(
+    const PrometheusProviderConfig& provider,
+    std::string_view prompt) {
+  base::DictValue schema;
+  schema.Set("type", "object");
+  schema.Set("additionalProperties", false);
+  ProviderTurnRequest request{
+      .family = provider.family,
+      .use_responses_api = provider.capabilities.responses_api,
+      .model = provider.model_id,
+      .system_instruction = "Use only the closed read_page tool.",
+      .user_text = std::string(prompt),
+      .max_output_tokens = 128,
+  };
+  request.tools.push_back({.name = "read_page",
+                           .description = "Read the owned visible page.",
+                           .input_schema = std::move(schema)});
+  return request;
+}
+
+std::string CorpusTurnResponse(std::string_view family,
+                               std::string_view fixture) {
+  const bool unknown_tool = fixture == "unknown_tool";
+  const std::string tool_name = unknown_tool ? "execute_js" : "read_page";
+  if (fixture == "tool_call" || unknown_tool) {
+    if (family == "openai_responses") {
+      return R"({"status":"completed","output":[{"type":"function_call","call_id":"call-1","name":")" +
+             tool_name +
+             R"(","arguments":"{}"}],"usage":{"input_tokens":5,"output_tokens":3}})";
+    }
+    if (family == "openai_chat") {
+      return R"({"choices":[{"finish_reason":"tool_calls","message":{"content":null,"tool_calls":[{"id":"chat-1","type":"function","function":{"name":")" +
+             tool_name +
+             R"(","arguments":"{}"}}]}}],"usage":{"prompt_tokens":5,"completion_tokens":3}})";
+    }
+    if (family == "anthropic_messages") {
+      return R"({"stop_reason":"tool_use","content":[{"type":"tool_use","id":"anthropic-1","name":")" +
+             tool_name +
+             R"(","input":{}}],"usage":{"input_tokens":5,"output_tokens":3}})";
+    }
+    return R"({"candidates":[{"finishReason":"STOP","content":{"parts":[{"functionCall":{"id":"gemini-1","name":")" +
+           tool_name +
+           R"(","args":{}}}]}}],"usageMetadata":{"promptTokenCount":5,"candidatesTokenCount":3,"totalTokenCount":8}})";
+  }
+
+  if (fixture == "multiple_tools") {
+    if (family == "openai_chat") {
+      return R"({"choices":[{"finish_reason":"tool_calls","message":{"content":null,"tool_calls":[{"id":"chat-1","type":"function","function":{"name":"read_page","arguments":"{}"}},{"id":"chat-2","type":"function","function":{"name":"read_page","arguments":"{}"}}]}}],"usage":{"prompt_tokens":5,"completion_tokens":3}})";
+    }
+    return R"({"stop_reason":"tool_use","content":[{"type":"tool_use","id":"anthropic-1","name":"read_page","input":{}},{"type":"tool_use","id":"anthropic-2","name":"read_page","input":{}}],"usage":{"input_tokens":5,"output_tokens":3}})";
+  }
+
+  const std::string text =
+      fixture == "secret_echo" ? kCorpusActiveSecret : "complete";
+  if (family == "openai_responses") {
+    return R"({"status":"completed","output":[{"type":"message","content":[{"type":"output_text","text":")" +
+           text + R"("}]}],"usage":{"input_tokens":11,"output_tokens":7}})";
+  }
+  if (family == "openai_chat") {
+    return R"({"choices":[{"finish_reason":"stop","message":{"content":")" +
+           text + R"("}}],"usage":{"prompt_tokens":11,"completion_tokens":7}})";
+  }
+  if (family == "anthropic_messages") {
+    return R"({"stop_reason":"end_turn","content":[{"type":"text","text":")" +
+           text + R"("}],"usage":{"input_tokens":11,"output_tokens":7}})";
+  }
+  return R"({"candidates":[{"finishReason":"STOP","content":{"parts":[{"text":")" +
+         text +
+         R"("}]}}],"usageMetadata":{"promptTokenCount":11,"candidatesTokenCount":7,"totalTokenCount":18}})";
+}
