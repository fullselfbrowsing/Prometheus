+++ b/chrome/browser/ui/webui/prometheus/prometheus_web_ui_browsertest.cc
@@ -3579,3 +3579,170 @@ IN_PROC_BROWSER_TEST_F(
   }));
   EXPECT_EQ(0u, service->controller_count_for_testing());
 }
+
+IN_PROC_BROWSER_TEST_F(
+    PrometheusWebUIBrowserTest,
+    SidePanelSupervisionRuntimeEndIsZeroArgumentBulkExactAndTeardownSafe) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL target_url =
+      embedded_test_server()->GetURL("a.test", "/title1.html");
+  const GURL other_url =
+      embedded_test_server()->GetURL("b.test", "/title2.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), target_url));
+
+  PrometheusSidePanelUI* const controller = ShowSidePanel(browser());
+  ASSERT_TRUE(controller);
+  content::WebContents* const side_panel_contents =
+      visible_side_panel_web_contents();
+  ASSERT_TRUE(side_panel_contents);
+  auto* const service = supervision_service();
+  ASSERT_TRUE(service);
+  ASSERT_FALSE(ClaimSelectedTabForAgent("Bulk end owner").empty());
+  prometheus::SupervisionRedemptionResult first_viewer =
+      RedeemSelectedTab("First reviewer");
+  prometheus::SupervisionRedemptionResult second_viewer =
+      RedeemSelectedTab("Second reviewer");
+  ASSERT_TRUE(first_viewer.ok);
+  ASSERT_TRUE(second_viewer.ok);
+  ASSERT_EQ(first_viewer.stable_tab_id, second_viewer.stable_tab_id);
+  const int32_t stable_tab_id = first_viewer.stable_tab_id;
+  EnableControlAndAccept(first_viewer.dashboard_session);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return service->viewer_count_for_testing(stable_tab_id) == 2u &&
+           content::EvalJs(side_panel_contents, R"(
+             const state =
+                 window.prometheusRuntimeSnapshotForTesting?.supervision;
+             state?.viewer_count === 2 && state.controlled === true;
+           )")
+               .ExtractBool();
+  }));
+
+  ASSERT_TRUE(content::ExecJs(side_panel_contents, R"(
+    window.prometheusRuntimeOperationForTesting = null;
+    chrome.send('prometheusEndSelectedTabSupervision', [{
+      dashboard_session: 'FORGED_SESSION',
+      result: 'FORGED_RESULT',
+      title: 'FORGED_TITLE',
+    }]);
+  )"));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(side_panel_contents, R"(
+      window.prometheusRuntimeOperationForTesting?.status ===
+          'INVALID_REQUEST';
+    )")
+        .ExtractBool();
+  }));
+  const std::string rejected_operation =
+      content::EvalJs(side_panel_contents, R"(
+        JSON.stringify(window.prometheusRuntimeOperationForTesting);
+      )")
+          .ExtractString();
+  EXPECT_EQ(std::string::npos, rejected_operation.find("FORGED_SESSION"));
+  EXPECT_EQ(std::string::npos, rejected_operation.find("FORGED_RESULT"));
+  EXPECT_EQ(std::string::npos, rejected_operation.find("FORGED_TITLE"));
+  EXPECT_EQ(2u, service->viewer_count_for_testing(stable_tab_id));
+  EXPECT_EQ(1u, service->controller_count_for_testing());
+
+  ASSERT_TRUE(content::ExecJs(side_panel_contents, R"(
+    window.prometheusSawEndingForTesting = false;
+    const receiveSnapshot = window.prometheusRuntimeReceiveSnapshot;
+    window.prometheusRuntimeReceiveSnapshot = snapshot => {
+      if (snapshot?.supervision?.ending === true) {
+        window.prometheusSawEndingForTesting = true;
+      }
+      receiveSnapshot(snapshot);
+    };
+    window.prometheusRuntimeOperationForTesting = null;
+    chrome.send('prometheusEndSelectedTabSupervision');
+  )"));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return service->viewer_count_for_testing(stable_tab_id) == 0u &&
+           service->controller_count_for_testing() == 0u &&
+           content::EvalJs(side_panel_contents, R"(
+             const state =
+                 window.prometheusRuntimeSnapshotForTesting?.supervision;
+             window.prometheusSawEndingForTesting === true &&
+                 window.prometheusRuntimeOperationForTesting?.accepted ===
+                     true &&
+                 state?.viewer_count === 0 && state.controlled === false &&
+                 state.ending === false;
+           )")
+               .ExtractBool();
+  }));
+
+  ASSERT_TRUE(content::ExecJs(side_panel_contents, R"(
+    window.prometheusRuntimeOperationForTesting = null;
+    chrome.send('prometheusEndSelectedTabSupervision');
+  )"));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(side_panel_contents, R"(
+      window.prometheusRuntimeOperationForTesting?.accepted === false;
+    )")
+        .ExtractBool();
+  }));
+  EXPECT_EQ(0u, service->viewer_count_for_testing(stable_tab_id));
+
+  first_viewer = RedeemSelectedTab("Third reviewer");
+  second_viewer = RedeemSelectedTab("Fourth reviewer");
+  ASSERT_TRUE(first_viewer.ok);
+  ASSERT_TRUE(second_viewer.ok);
+  ASSERT_EQ(stable_tab_id, first_viewer.stable_tab_id);
+  ASSERT_EQ(stable_tab_id, second_viewer.stable_tab_id);
+  ASSERT_TRUE(
+      AddTabAtIndexToBrowser(browser(), 1, other_url, ui::PAGE_TRANSITION_TYPED));
+  browser()->tab_strip_model()->ActivateTabAt(1);
+  ASSERT_TRUE(content::WaitForLoadStop(
+      browser()->tab_strip_model()->GetActiveWebContents()));
+  ASSERT_TRUE(content::ExecJs(side_panel_contents, R"(
+    window.prometheusRuntimeOperationForTesting = null;
+    chrome.send('prometheusEndSelectedTabSupervision');
+  )"));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(side_panel_contents, R"(
+      window.prometheusRuntimeOperationForTesting?.accepted === false;
+    )")
+        .ExtractBool();
+  }));
+  EXPECT_EQ(2u, service->viewer_count_for_testing(stable_tab_id));
+
+  browser()->tab_strip_model()->ActivateTabAt(0);
+  ASSERT_TRUE(content::ExecJs(side_panel_contents, R"(
+    window.prometheusRuntimeOperationForTesting = null;
+    chrome.send('prometheusEndSelectedTabSupervision');
+  )"));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return service->viewer_count_for_testing(stable_tab_id) == 0u &&
+           content::EvalJs(side_panel_contents, R"(
+             window.prometheusRuntimeOperationForTesting?.accepted === true;
+           )")
+               .ExtractBool();
+  }));
+
+  prometheus::SupervisionRedemptionResult teardown_viewer =
+      RedeemSelectedTab("Reload reviewer");
+  ASSERT_TRUE(teardown_viewer.ok);
+  ASSERT_EQ(stable_tab_id, teardown_viewer.stable_tab_id);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return service->viewer_count_for_testing(stable_tab_id) == 1u;
+  }));
+  side_panel_contents->GetController().Reload(content::ReloadType::NORMAL,
+                                               false);
+  ASSERT_TRUE(content::WaitForLoadStop(side_panel_contents));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(side_panel_contents, R"(
+      window.prometheusRuntimeSnapshotForTesting?.supervision?.viewer_count ===
+          1;
+    )")
+        .ExtractBool();
+  }));
+  ASSERT_TRUE(service->EndSession(teardown_viewer.dashboard_session).ok);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return service->viewer_count_for_testing(stable_tab_id) == 0u &&
+           content::EvalJs(side_panel_contents, R"(
+             window.prometheusRuntimeSnapshotForTesting?.supervision
+                     ?.viewer_count === 0 &&
+                 window.prometheusRuntimeOperationForTesting === null;
+           )")
+               .ExtractBool();
+  }));
+}
