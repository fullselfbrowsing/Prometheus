+void PrometheusSupervisionProfileService::SweepExpired() {
+  const base::Time now = Now();
+  SweepFailedAttempts(now);
+  SweepExpiredPairings(now);
+  SweepExpiredViewers(now);
+  while (!recent_terminal_sessions_.empty() &&
+         recent_terminal_sessions_.front().retained_until <= now) {
+    recent_terminal_sessions_.pop_front();
+  }
+}
+
+void PrometheusSupervisionProfileService::SweepExpiredPairings(base::Time now) {
+  std::vector<int32_t> expired;
+  for (auto& [stable_tab_id, pairing] : pending_pairings_) {
+    if (pairing->state == SupervisionPairingState::kPending &&
+        pairing->expires_at <= now) {
+      pairing->state = SupervisionPairingState::kExpired;
+      last_pairing_states_[stable_tab_id] = SupervisionPairingState::kExpired;
+      expired.push_back(stable_tab_id);
+    }
+  }
+  for (int32_t stable_tab_id : expired) {
+    AddAudit(stable_tab_id, SupervisionAuditEvent::kPairingCodeExpired,
+             std::nullopt, SupervisionErrorCode::kExpiredCode);
+    NotifySnapshotChanged(stable_tab_id);
+    ScheduleObservedTabRelease(stable_tab_id);
+  }
+}
+
+void PrometheusSupervisionProfileService::SweepExpiredViewers(base::Time now) {
+  std::vector<base::UnguessableToken> expired;
+  for (const auto& [dashboard_session, viewer] : viewers_) {
+    if (viewer->expires_at <= now) {
+      expired.push_back(dashboard_session);
+    }
+  }
+  for (const base::UnguessableToken& dashboard_session : expired) {
+    TerminateViewer(dashboard_session, SupervisionViewerState::kExpired,
+                    SupervisionTerminalReason::kExpired,
+                    SupervisionAuditEvent::kAccessExpired,
+                    SupervisionErrorCode::kNone);
+  }
+}
+
+void PrometheusSupervisionProfileService::SweepFailedAttempts(base::Time now) {
+  while (!failed_attempts_.empty() &&
+         failed_attempts_.front() + PairingTtl(limits_) <= now) {
+    failed_attempts_.pop_front();
+  }
+}
