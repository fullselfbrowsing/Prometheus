--- /dev/null
+++ b/chrome/browser/resources/prometheus/css/prometheus_fonts.css
@@ -0,0 +1,46 @@
+/* Copyright 2026 The Chromium Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* Prometheus design system fonts.
+ * NO local() fallback — all fonts must be served from the bundled resource
+ * pack to satisfy the offline guarantee (D-11, DESIGN-03).
+ * Source: SIL OFL 1.1 — see third_party/poppins/OFL.txt and
+ * third_party/space_mono/OFL.txt for full license text.
+ * URL scheme: url(//resources/prometheus/fonts/...) mirrors the in-tree
+ * ui/webui/resources/roboto/ precedent (chrome://resources/roboto/). */
+
+@font-face {
+  font-family: 'Poppins';
+  font-style: normal;
+  font-weight: 100;
+  src: url(//resources/prometheus/fonts/Poppins-Thin.woff2) format('woff2');
+}
+
+@font-face {
+  font-family: 'Poppins';
+  font-style: normal;
+  font-weight: 300;
+  src: url(//resources/prometheus/fonts/Poppins-Light.woff2) format('woff2');
+}
+
+@font-face {
+  font-family: 'Poppins';
+  font-style: normal;
+  font-weight: 800;
+  src: url(//resources/prometheus/fonts/Poppins-ExtraBold.woff2) format('woff2');
+}
+
+@font-face {
+  font-family: 'Poppins';
+  font-style: normal;
+  font-weight: 900;
+  src: url(//resources/prometheus/fonts/Poppins-Black.woff2) format('woff2');
+}
+
+@font-face {
+  font-family: 'Space Mono';
+  font-style: normal;
+  font-weight: 400;
+  src: url(//resources/prometheus/fonts/SpaceMono-Regular.woff2) format('woff2');
+}
