+++ b/chrome/browser/prometheus/prometheus_extension_smoke_controller.h
@@ -173,6 +173,8 @@ class PrometheusExtensionSmokeController
   void OnRemoveButtonPointResolved(base::TimeTicks deadline,
                                    base::Value result);
   void DispatchRealMouseClick(const gfx::Point& point_in_viewport);
+  void PollRemoveClickReceipt(base::TimeTicks deadline);
+  void OnRemoveClickReceiptRead(base::TimeTicks deadline, base::Value result);
   void PollRemoveConfirmationReady(base::TimeTicks deadline);
   void OnExtensionRemovedObserved();
   void Complete();
