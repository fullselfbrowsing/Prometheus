+
+bool PrometheusControlPanelUI::HasExactControlBinding() const {
+  return profile_ && bound_web_contents_ && control_runtime_ &&
+         profile_->IsRegularProfile() &&
+         bound_web_contents_->GetBrowserContext() == profile_ &&
+         control_runtime_->IsBoundTo(profile_, bound_web_contents_);
+}
+
+void PrometheusControlPanelUI::SendControlSnapshot(base::DictValue snapshot) {
+  ++runtime_observer_delivery_count_;
+  ++g_total_control_snapshot_delivery_count;
+  web_ui()->CallJavascriptFunctionUnsafe("prometheusControlReceiveSnapshot",
+                                         base::Value(std::move(snapshot)));
+}
+
+void PrometheusControlPanelUI::SendFreshControlSnapshot() {
+  SendControlSnapshot(
+      HasExactControlBinding()
+          ? control_runtime_->GetSanitizedSnapshot()
+          : ControlErrorValue("Reload the exact regular-profile control panel",
+                              "TARGET_LOST"));
+}
+
+void PrometheusControlPanelUI::SendControlOperation(
+    base::DictValue operation) {
+  web_ui()->CallJavascriptFunctionUnsafe("prometheusControlReceiveOperation",
+                                         base::Value(std::move(operation)));
+}
