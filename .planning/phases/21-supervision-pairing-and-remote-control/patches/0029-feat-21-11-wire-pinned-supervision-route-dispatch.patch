+void PrometheusSupervisionProfileService::ExecuteCompatibilityRoute(
+    BrowserWindowInterface* exact_browser,
+    const AgentRouteRequest& request,
+    PrometheusAgentService::RouteCallback callback) {
+  if (shutdown_ || profile_kind_ != SupervisionProfileKind::kRegular ||
+      !exact_browser || exact_browser->IsDeleteScheduled() ||
+      exact_browser->GetProfile() != profile_) {
+    std::move(callback).Run(AgentRouteResult::Failure(
+        AgentErrorCode::kStaleTarget,
+        "The exact regular supervision target is unavailable",
+        "Create a new Agent session from the intended tab"));
+    return;
+  }
+  std::move(callback).Run(AgentRouteResult::Failure(
+      AgentErrorCode::kCapabilityNotReady,
+      std::string(AgentRouteNameToString(request.route_name)) +
+          " compatibility semantics are not ready",
+      "Retry after native diagnostics reports supervision ready"));
+}
+
+bool PrometheusSupervisionProfileService::MatchesPendingPairingForComposition(
+    std::string_view pairing_code) {
+  if (shutdown_ || profile_kind_ != SupervisionProfileKind::kRegular) {
+    return false;
+  }
+  SweepExpired();
+  return FindPendingPairing(NormalizePairingCode(pairing_code)) != nullptr;
+}
+
+bool PrometheusSupervisionProfileService::OwnsDashboardSessionForComposition(
+    const base::UnguessableToken& dashboard_session) {
+  if (shutdown_ || profile_kind_ != SupervisionProfileKind::kRegular ||
+      !dashboard_session) {
+    return false;
+  }
+  SweepExpired();
+  return viewers_.contains(dashboard_session);
+}
