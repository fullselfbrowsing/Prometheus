+  void Action(const SupervisionGatewayRequest& request,
+              SupervisionGatewayDispatcher::ResultCallback callback) {
+    const auto& params =
+        std::get<SupervisionActionParams>(request.transport.params);
+    DashboardOwner* owner = FindOwner(params.dashboard_session);
+    if (!owner || !owner->last_delivery ||
+        owner->last_delivery->document_epoch.ToString() !=
+            params.document_epoch ||
+        owner->last_delivery->sequence != params.sequence) {
+      CompleteUnknown(request.transport.operation, std::move(callback));
+      return;
+    }
+    SupervisionServiceResult enabled =
+        owner->service->EnableControl(owner->session);
+    if (!enabled.ok) {
+      Complete(std::move(callback),
+               Failure(request.transport.operation, enabled));
+      return;
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            &PrometheusSupervisionComposition::ExecuteActionAfterControl,
+            weak_factory_.GetWeakPtr(), params.dashboard_session,
+            params.document_epoch, params.sequence, params.action,
+            std::move(callback)));
+  }
+
+  void ExecuteActionAfterControl(
+      std::string dashboard_session,
+      std::string document_epoch,
+      uint64_t sequence,
+      SupervisionRemoteActionRequest action,
+      SupervisionGatewayDispatcher::ResultCallback callback) {
+    DashboardOwner* owner = FindOwner(dashboard_session);
+    if (!owner || !owner->last_delivery ||
+        owner->last_delivery->document_epoch.ToString() != document_epoch ||
+        owner->last_delivery->sequence != sequence) {
+      CompleteUnknown(SupervisionTransportOperation::kAction,
+                      std::move(callback));
+      return;
+    }
+    owner->service->ExecuteDashboardAction(
+        owner->session, document_epoch, sequence, action,
+        base::BindOnce(&PrometheusSupervisionComposition::OnActionComplete,
+                       weak_factory_.GetWeakPtr(), std::move(dashboard_session),
+                       std::move(document_epoch), sequence,
+                       std::move(callback)));
+  }
+
+  void OnActionComplete(
+      std::string dashboard_session,
+      std::string document_epoch,
+      uint64_t sequence,
+      SupervisionGatewayDispatcher::ResultCallback callback,
+      SupervisionActionResult action_result) {
+    if (!action_result.ok) {
+      Complete(
+          std::move(callback),
+          SupervisionTransportResult::SupervisionFailure(
+              SupervisionTransportOperation::kAction,
+              action_result.error_code,
+              "The remote action was not completed",
+              "Refresh supervision state and retry"));
+      return;
+    }
+    DashboardOwner* owner = FindOwner(dashboard_session);
+    if (!owner) {
+      CompleteUnknown(SupervisionTransportOperation::kAction,
+                      std::move(callback));
+      return;
+    }
+    SupervisionTransportResult result = SupervisionTransportResult::Success(
+        SupervisionTransportOperation::kAction);
+    result.dashboard_authority = SupervisionDashboardWireAuthority{
+        .dashboard_session = std::move(dashboard_session),
+        .document_epoch = std::move(document_epoch),
+        .sequence = sequence,
+    };
+    result.sanitized_snapshot =
+        owner->service->GetSanitizedSnapshot(owner->stable_tab_id);
+    Complete(std::move(callback), std::move(result));
+  }
+
