+void PrometheusSupervisionProfileService::ExecuteDashboardAction(
+    const base::UnguessableToken& dashboard_session,
+    std::string_view document_epoch,
+    uint64_t sequence,
+    const SupervisionRemoteActionRequest& action,
+    DashboardActionCallback callback) {
+  if (!callback) {
+    return;
+  }
+  auto fail = [&callback](SupervisionErrorCode error_code) {
+    SupervisionActionResult result;
+    result.error_code = error_code;
+    std::move(callback).Run(std::move(result));
+  };
+  if (shutdown_) {
+    fail(SupervisionErrorCode::kShutdown);
+    return;
+  }
+  SweepExpired();
+  auto viewer = viewers_.find(dashboard_session);
+  if (viewer == viewers_.end()) {
+    fail(SupervisionErrorCode::kUnknownSession);
+    return;
+  }
+  if (!RevalidateViewerOwner(dashboard_session)) {
+    fail(SupervisionErrorCode::kViewOnly);
+    return;
+  }
+  viewer = viewers_.find(dashboard_session);
+  if (viewer == viewers_.end()) {
+    fail(SupervisionErrorCode::kUnknownSession);
+    return;
+  }
+  ViewerSession& session = *viewer->second;
+  if (!session.action_controller) {
+    fail(SupervisionErrorCode::kShutdown);
+    return;
+  }
+  if (session.action_controller->has_in_flight_action_for_testing()) {
+    fail(SupervisionErrorCode::kControllerConflict);
+    return;
+  }
+  const SupervisionActionClassification classification =
+      PrometheusSupervisionActionController::Classify(action);
+  if (classification == SupervisionActionClassification::kRejected) {
+    fail(SupervisionErrorCode::kRestrictedTarget);
+    return;
+  }
+
+  session.action_category = action.category;
+  session.action_state = SupervisionRemoteActionState::kValidating;
+  AddAudit(session.stable_tab_id,
+           SupervisionAuditEvent::kRemoteActionRequested,
+           std::optional<std::string>(session.client_label),
+           SupervisionErrorCode::kNone, action.category);
+  NotifySnapshotChanged(session.stable_tab_id);
+  session.action_controller->ExecuteAction(
+      dashboard_session, document_epoch, sequence, action,
+      base::BindOnce(
+          [](base::WeakPtr<PrometheusSupervisionProfileService> service,
+             base::UnguessableToken session,
+             SupervisionRemoteActionCategory category,
+             DashboardActionCallback external_callback,
+             SupervisionActionResult result) {
+            if (service) {
+              service->OnDashboardActionCompleted(session, category, result);
+            }
+            if (external_callback) {
+              std::move(external_callback).Run(std::move(result));
+            }
+          },
+          weak_factory_.GetWeakPtr(), dashboard_session, action.category,
+          std::move(callback)));
+
+  viewer = viewers_.find(dashboard_session);
+  if (viewer != viewers_.end() && viewer->second->action_controller &&
+      viewer->second->action_controller->has_in_flight_action_for_testing()) {
+    viewer->second->action_state =
+        viewer->second->action_controller->awaiting_confirmation_for_testing()
+            ? SupervisionRemoteActionState::kAwaitingConfirmation
+            : SupervisionRemoteActionState::kExecuting;
+    NotifySnapshotChanged(viewer->second->stable_tab_id);
+  }
+}
+
+SupervisionServiceResult
+PrometheusSupervisionProfileService::ResolveDashboardActionConfirmation(
+    const base::UnguessableToken& dashboard_session,
+    bool allow_once) {
+  if (shutdown_) {
+    return UnavailableResult();
+  }
+  SweepExpired();
+  auto viewer = viewers_.find(dashboard_session);
+  if (viewer == viewers_.end()) {
+    return UnknownSessionResult();
+  }
+  if (!viewer->second->action_controller ||
+      !viewer->second->action_controller->awaiting_confirmation_for_testing()) {
+    return ServiceFailure(SupervisionErrorCode::kControllerConflict,
+                          "No supervision action awaits confirmation",
+                          "Request one consequential action at a time");
+  }
+  viewer->second->action_controller->ResolvePendingConfirmation(allow_once);
+  return SupervisionServiceResult::Success();
+}
