+TEST(PrometheusAgentTransportCodecTest,
+     SupervisionRejectsWrongVariantsMalformedStructureAndBounds) {
+  auto wrong_route = SerializeAgentTransportResult(
+      AgentRouteResult::SupervisionSuccess(
+          AgentRouteName::kCreateSupervisionPairing,
+          AgentSupervisionBaselineResult{.nodes = {SafeNode("node-1")}}));
+  ASSERT_FALSE(wrong_route.has_value());
+  EXPECT_EQ(AgentErrorCode::kInvalidRequest,
+            wrong_route.error().error_code);
+
+  AgentRouteResult mixed = AgentRouteResult::SupervisionSuccess(
+      AgentRouteName::kGetSupervisionSnapshot,
+      AgentSupervisionBaselineResult{.nodes = {SafeNode("node-1")}});
+  mixed.target.tab_handle = tabs::TabHandle(7);
+  mixed.changed_state = {"snapshot_returned"};
+  auto mixed_result = SerializeAgentTransportResult(mixed);
+  ASSERT_FALSE(mixed_result.has_value());
+  EXPECT_EQ(AgentErrorCode::kInvalidRequest,
+            mixed_result.error().error_code);
+
+  AgentSupervisionBaselineResult oversized;
+  oversized.nodes.reserve(kMaxAgentSupervisionNodes + 1);
+  for (size_t index = 0; index <= kMaxAgentSupervisionNodes; ++index) {
+    oversized.nodes.push_back(SafeNode("node-" + std::to_string(index)));
+  }
+  auto oversized_result = SerializeAgentTransportResult(
+      AgentRouteResult::SupervisionSuccess(
+          AgentRouteName::kGetSupervisionSnapshot, std::move(oversized)));
+  ASSERT_FALSE(oversized_result.has_value());
+  EXPECT_EQ(AgentErrorCode::kRequestTooLarge,
+            oversized_result.error().error_code);
+
+  AgentSupervisionNode malformed = SafeNode("node-1", "missing-parent");
+  auto malformed_result = SerializeAgentTransportResult(
+      AgentRouteResult::SupervisionSuccess(
+          AgentRouteName::kGetSupervisionSnapshot,
+          AgentSupervisionBaselineResult{.nodes = {std::move(malformed)}}));
+  ASSERT_FALSE(malformed_result.has_value());
+  EXPECT_EQ(AgentErrorCode::kInvalidRequest,
+            malformed_result.error().error_code);
+
+  AgentSupervisionDiffOperation invalid_remove;
+  invalid_remove.type = AgentSupervisionDiffOperationType::kRemove;
+  invalid_remove.ref = "node-1";
+  invalid_remove.parent_ref = "stale-parent";
+  auto invalid_diff = SerializeAgentTransportResult(
+      AgentRouteResult::SupervisionSuccess(
+          AgentRouteName::kGetSupervisionDiff,
+          AgentSupervisionDiffResult{
+              .operations = {std::move(invalid_remove)}}));
+  ASSERT_FALSE(invalid_diff.has_value());
+  EXPECT_EQ(AgentErrorCode::kInvalidRequest,
+            invalid_diff.error().error_code);
+}
+
+TEST(PrometheusAgentTransportCodecTest,
+     SupervisionRejectsRecursiveAuthorityContentAndSecretSentinels) {
+  for (std::string_view sentinel : {
+           "pairing-code-sentinel", "dashboard-session-sentinel",
+           "controller-lease-sentinel", "browser-id-sentinel",
+           "profile-path-sentinel", "tab-id-sentinel",
+           "document-token-sentinel", "document-epoch-sentinel",
+           "sequence-sentinel", "cursor-sentinel", "bearer-sentinel",
+           "authorization-sentinel", "api-key-sentinel",
+           "password-sentinel", "payment-sentinel", "otp-sentinel",
+           "secret-sentinel", "renderer-sentinel",
+       }) {
+    SCOPED_TRACE(sentinel);
+    AgentSupervisionNode node = SafeNode("node-1");
+    node.name = std::string(sentinel);
+    auto serialized = SerializeAgentTransportResult(
+        AgentRouteResult::SupervisionSuccess(
+            AgentRouteName::kGetSupervisionSnapshot,
+            AgentSupervisionBaselineResult{.nodes = {std::move(node)}}));
+    ASSERT_FALSE(serialized.has_value());
+    EXPECT_NE(AgentErrorCode::kNone, serialized.error().error_code);
+    EXPECT_EQ(std::string::npos,
+              serialized.error().message.find(sentinel));
+    EXPECT_EQ(std::string::npos,
+              serialized.error().recovery.find(sentinel));
+  }
+
+  AgentRouteResult unsafe_error = AgentRouteResult::Failure(
+      AgentErrorCode::kInvalidRequest, "secret-sentinel",
+      "Retry with bearer-sentinel");
+  auto serialized_error = SerializeAgentTransportResult(unsafe_error);
+  ASSERT_FALSE(serialized_error.has_value());
+  EXPECT_NE(AgentErrorCode::kNone, serialized_error.error().error_code);
+  EXPECT_EQ(std::string::npos,
+            serialized_error.error().message.find("secret-sentinel"));
+}
