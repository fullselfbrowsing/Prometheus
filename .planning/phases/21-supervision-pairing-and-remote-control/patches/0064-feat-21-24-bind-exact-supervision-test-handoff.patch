 void PrometheusSupervisionTestComposition::Shutdown() {
+  if (shutdown_) {
+    return;
+  }
   shutdown_ = true;
+  weak_ptr_factory_.InvalidateWeakPtrs();
+  if (bound_) {
+    set_dispatcher_.Run({});
+    bound_ = false;
+    ObserveLifecycle("test_dispatcher_unbound");
+  }
+  if (bootstrap_) {
+    bootstrap_->Shutdown();
+    bootstrap_.reset();
+    ObserveLifecycle("bootstrap_destroyed");
+  }
+  set_dispatcher_.Reset();
 }
 
