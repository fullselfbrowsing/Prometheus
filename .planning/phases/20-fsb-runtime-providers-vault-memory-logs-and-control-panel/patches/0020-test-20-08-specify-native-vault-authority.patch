+TEST_F(PrometheusVaultServiceTest,
+       McpApprovalIsShortLivedOneUseAndRequiresIdenticalRetry) {
+  PrometheusVaultMetadata metadata = CreateConfiguredCredential();
+  ASSERT_FALSE(metadata.id.empty());
+  PrometheusVaultUseRequest request =
+      UseRequest(metadata.id, PrometheusVaultUseOrigin::kMcp);
+  EXPECT_EQ(BeginAndReply(request, true),
+            PrometheusVaultStatus::kNativeConfirmationRequired);
+  EXPECT_EQ(secret_store_.read_count, 0);
+  ASSERT_TRUE(service_.approval_for_testing().has_value());
+  EXPECT_FALSE(service_.approval_for_testing()->consumed);
+
+  PrometheusVaultUseRequest changed = request;
+  changed.request_hash = "different-request";
+  base::test::TestFuture<PrometheusVaultUseResult> mismatch;
+  service_.UseEntry(std::move(changed), mismatch.GetCallback());
+  EXPECT_EQ(mismatch.Get().status,
+            PrometheusVaultStatus::kApprovalMismatch);
+  EXPECT_EQ(secret_store_.read_count, 0);
+
+  base::test::TestFuture<PrometheusVaultUseResult> accepted;
+  service_.UseEntry(request, accepted.GetCallback());
+  EXPECT_EQ(accepted.Get().status, PrometheusVaultStatus::kSuccess);
+  EXPECT_EQ(secret_store_.read_count, 1);
+  ASSERT_TRUE(service_.approval_for_testing().has_value());
+  EXPECT_TRUE(service_.approval_for_testing()->consumed);
+
+  base::test::TestFuture<PrometheusVaultUseResult> replay;
+  service_.UseEntry(request, replay.GetCallback());
+  EXPECT_EQ(replay.Get().status, PrometheusVaultStatus::kApprovalReplay);
+  EXPECT_EQ(secret_store_.read_count, 1);
+
+  service_.Shutdown();
+  base::test::TestFuture<PrometheusVaultUseResult> shutdown;
+  service_.UseEntry(request, shutdown.GetCallback());
+  EXPECT_EQ(shutdown.Get().status, PrometheusVaultStatus::kProfileShutdown);
+}
