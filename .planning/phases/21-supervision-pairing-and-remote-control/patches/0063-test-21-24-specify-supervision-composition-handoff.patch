+PrometheusSupervisionTestComposition::PrometheusSupervisionTestComposition(
+    std::unique_ptr<PrometheusSupervisionTestBootstrap> bootstrap,
+    PrometheusSupervisionTestCompositionHooks hooks)
+    : bootstrap_(std::move(bootstrap)),
+      set_dispatcher_(std::move(hooks.set_dispatcher)),
+      observe_lifecycle_(std::move(hooks.observe_lifecycle)) {}
+
+PrometheusSupervisionTestComposition::~PrometheusSupervisionTestComposition() {
+  Shutdown();
+}
+
+PrometheusSupervisionTestBootstrapResult
+PrometheusSupervisionTestComposition::Create(
+    const base::CommandLine& command_line,
+    bool is_official_build,
+    PrometheusSupervisionTestCompositionHooks hooks,
+    std::unique_ptr<PrometheusSupervisionTestComposition>* composition) {
+  if (!composition) {
+    return PrometheusSupervisionTestBootstrapResult::kBindingDenied;
+  }
+  composition->reset();
+  if (!hooks.service_available) {
+    return PrometheusSupervisionTestBootstrapResult::kBindingDenied;
+  }
+  std::unique_ptr<PrometheusSupervisionTestBootstrap> bootstrap;
+  return PrometheusSupervisionTestBootstrap::Create(
+      command_line, is_official_build, hooks.profile_facts, hooks.file_access,
+      std::move(hooks.binding), std::move(hooks.create_pairing_code),
+      std::move(hooks.now), std::move(hooks.zeroization), &bootstrap);
+}
+
+bool PrometheusSupervisionTestComposition::ObservePairingRedeemed(
+    int sequence) {
+  return bootstrap_ && bootstrap_->ObservePairingRedeemed(sequence);
+}
+
+void PrometheusSupervisionTestComposition::ObserveLifecycle(
+    std::string_view event) {
+  if (observe_lifecycle_) {
+    observe_lifecycle_.Run(event);
+  }
+}
+
+void PrometheusSupervisionTestComposition::Shutdown() {
+  shutdown_ = true;
+}
