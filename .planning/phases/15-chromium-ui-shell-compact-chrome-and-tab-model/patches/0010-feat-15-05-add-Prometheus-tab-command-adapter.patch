+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PROMETHEUS_PROMETHEUS_TAB_COMMANDS_H_
+#define CHROME_BROWSER_PROMETHEUS_PROMETHEUS_TAB_COMMANDS_H_
+
+class BrowserWindowInterface;
+
+enum class PrometheusTabCommand {
+  kDuplicate,
+  kMoveToNewWindow,
+  kClose,
+  kCloseOthers,
+  kCloseToRight,
+  kAddToNewGroup,
+  kTogglePinned,
+  kToggleMuted,
+  kUnloadOrDiscard,
+};
+
+bool ExecutePrometheusTabCommand(BrowserWindowInterface* browser,
+                                 PrometheusTabCommand command,
+                                 int tab_index);
+
+#endif  // CHROME_BROWSER_PROMETHEUS_PROMETHEUS_TAB_COMMANDS_H_
