+IN_PROC_BROWSER_TEST_F(
+    PrometheusExtensionConfirmationBrowserTest,
+    SafeDefaultEscapePrivateCopyAndSingleReply) {
+  ASSERT_TRUE(prometheus::ExtensionInteractConfirmationImplementedForTesting());
+  prometheus::PrometheusExtensionInteractDialogModel model;
+  model.extension_name = "Fixture Extension";
+  int replies = 0;
+  bool accepted = true;
+  ASSERT_TRUE(prometheus::ShowPrometheusExtensionInteractDialog(
+      browser(), model,
+      base::BindOnce(
+          [](int* replies, bool* accepted, bool result) {
+            ++*replies;
+            *accepted = result;
+          },
+          &replies, &accepted)));
+  views::Widget* widget =
+      prometheus::PrometheusRuntimeDialogWidgetForTesting();
+  ASSERT_TRUE(widget);
+  views::DialogDelegate* dialog =
+      widget->widget_delegate()->AsDialogDelegate();
+  ASSERT_TRUE(dialog);
+  EXPECT_EQ(prometheus::PrometheusRuntimeDialogKind::
+                kExtensionInteractConfirmation,
+            prometheus::PrometheusRuntimeDialogKindForTesting());
+  EXPECT_EQ(u"Allow Agent interaction with Fixture Extension?",
+            dialog->GetWindowTitle());
+  EXPECT_EQ(u"Allow interaction",
+            dialog->GetDialogButtonLabel(ui::mojom::DialogButton::kOk));
+  EXPECT_EQ(u"Keep current access",
+            dialog->GetDialogButtonLabel(ui::mojom::DialogButton::kCancel));
+  EXPECT_EQ(static_cast<int>(ui::mojom::DialogButton::kCancel),
+            dialog->GetDefaultDialogButton());
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return widget->GetFocusManager()->GetFocusedView() ==
+           dialog->GetCancelButton();
+  }));
+  widget->CloseWithReason(views::Widget::ClosedReason::kEscKeyPressed);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return replies == 1; }));
+  EXPECT_FALSE(accepted);
+
+  model.private_mode = true;
+  replies = 0;
+  accepted = false;
+  ASSERT_TRUE(prometheus::ShowPrometheusExtensionInteractDialog(
+      browser(), model,
+      base::BindOnce(
+          [](int* replies, bool* accepted, bool result) {
+            ++*replies;
+            *accepted = result;
+          },
+          &replies, &accepted)));
+  widget = prometheus::PrometheusRuntimeDialogWidgetForTesting();
+  ASSERT_TRUE(widget);
+  dialog = widget->widget_delegate()->AsDialogDelegate();
+  ASSERT_TRUE(dialog);
+  EXPECT_EQ(
+      u"Allow Agent interaction with Fixture Extension in Private windows?",
+      dialog->GetWindowTitle());
+  dialog->AcceptDialog();
+  ASSERT_TRUE(base::test::RunUntil([&]() { return replies == 1; }));
+  EXPECT_TRUE(accepted);
