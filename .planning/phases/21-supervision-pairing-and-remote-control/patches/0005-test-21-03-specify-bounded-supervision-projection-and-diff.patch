+TEST(PrometheusSupervisionProjectionTest,
+     IdenticalApcProducesByteIdenticalAuthoritativeBaseline) {
+  AnnotatedPageContent page_content = MakePageContent();
+  ContentNode* heading =
+      AddNode(page_content.mutable_root_node(), 2,
+              optimization_guide::proto::CONTENT_ATTRIBUTE_HEADING);
+  heading->mutable_content_attributes()->set_label("Stable heading");
+
+  const SupervisionBaseline first =
+      BuildSupervisionBaseline(page_content, "main-doc");
+  const SupervisionBaseline second =
+      BuildSupervisionBaseline(page_content, "main-doc");
+
+  ASSERT_TRUE(first.authoritative());
+  EXPECT_EQ(first, second);
+  EXPECT_FALSE(first.serialized_json.empty());
+  EXPECT_NE(nullptr, FindNormalizedNode(first, "main-doc:2"));
+}
+
+TEST(PrometheusSupervisionProjectionTest,
+     ProjectsPrimaryAndSameSiteDocumentsInStableOrder) {
+  AnnotatedPageContent page_content = MakePageContent();
+  ContentNode* iframe =
+      AddNode(page_content.mutable_root_node(), 2,
+              optimization_guide::proto::CONTENT_ATTRIBUTE_IFRAME);
+  iframe->mutable_content_attributes()
+      ->mutable_iframe_data()
+      ->mutable_frame_data()
+      ->mutable_document_identifier()
+      ->set_serialized_token("same-site-doc");
+  ContentNode* child =
+      AddNode(iframe, 3, optimization_guide::proto::CONTENT_ATTRIBUTE_ANCHOR);
+  child->mutable_content_attributes()->set_label("Same-site child");
+
+  const SupervisionBaseline baseline =
+      BuildSupervisionBaseline(page_content, "main-doc");
+
+  ASSERT_TRUE(baseline.authoritative());
+  ASSERT_EQ(3u, baseline.nodes.size());
+  EXPECT_EQ("main-doc:1", baseline.nodes[0].ref);
+  EXPECT_EQ("main-doc:2", baseline.nodes[1].ref);
+  EXPECT_EQ("same-site-doc:3", baseline.nodes[2].ref);
+  EXPECT_EQ("main-doc:2", baseline.nodes[2].parent_ref);
+}
+
+TEST(PrometheusSupervisionProjectionTest,
+     RestrictedCrossSiteAndFencedFrameContentIsStructurallyAbsent) {
+  AnnotatedPageContent page_content = MakePageContent();
+  ContentNode* cross_site =
+      AddNode(page_content.mutable_root_node(), 2,
+              optimization_guide::proto::CONTENT_ATTRIBUTE_IFRAME);
+  cross_site->mutable_content_attributes()
+      ->mutable_iframe_data()
+      ->mutable_redacted_frame_metadata()
+      ->set_reason(
+          optimization_guide::proto::
+              IframeData_RedactedFrameMetadata_Reason_REASON_CROSS_SITE);
+  ContentNode* cross_site_secret =
+      AddNode(cross_site, 3, optimization_guide::proto::CONTENT_ATTRIBUTE_TEXT);
+  cross_site_secret->mutable_content_attributes()
+      ->mutable_text_data()
+      ->set_text_content("restricted-cross-site-sentinel");
+
+  ContentNode* fenced =
+      AddNode(page_content.mutable_root_node(), 4,
+              optimization_guide::proto::CONTENT_ATTRIBUTE_IFRAME);
+  fenced->mutable_content_attributes()
+      ->mutable_iframe_data()
+      ->mutable_redacted_frame_metadata()
+      ->set_reason(
+          optimization_guide::proto::
+              IframeData_RedactedFrameMetadata_Reason_REASON_CROSS_ORIGIN);
+  ContentNode* fenced_secret =
+      AddNode(fenced, 5, optimization_guide::proto::CONTENT_ATTRIBUTE_TEXT);
+  fenced_secret->mutable_content_attributes()
+      ->mutable_text_data()
+      ->set_text_content("restricted-fenced-sentinel");
+
+  const SupervisionBaseline baseline =
+      BuildSupervisionBaseline(page_content, "main-doc");
+
+  ASSERT_TRUE(baseline.authoritative());
+  const SupervisionNormalizedNode* cross_site_node =
+      FindNormalizedNode(baseline, "main-doc:2");
+  const SupervisionNormalizedNode* fenced_node =
+      FindNormalizedNode(baseline, "main-doc:4");
+  ASSERT_NE(nullptr, cross_site_node);
+  ASSERT_NE(nullptr, fenced_node);
+  EXPECT_TRUE(cross_site_node->frame_restricted);
+  EXPECT_TRUE(fenced_node->frame_restricted);
+  EXPECT_EQ(nullptr, FindNormalizedNode(baseline, "main-doc:3"));
+  EXPECT_EQ(nullptr, FindNormalizedNode(baseline, "main-doc:5"));
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(baseline.serialized_json, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(parsed.has_value());
+  EXPECT_FALSE(ContainsKeyOrString(*parsed, {"restricted-cross-site-sentinel",
+                                             "restricted-fenced-sentinel"}));
+}
