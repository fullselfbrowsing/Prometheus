+  ASSERT_TRUE(tab);
+  prometheus::RuntimePrincipalResult principal =
+      service->CreateSidePanelPrincipal(browser(), tab->GetHandle().raw_value());
+  ASSERT_TRUE(principal.principal);
+  ASSERT_TRUE(service
+                  ->SubmitTask(*principal.principal, kSafePrompt,
+                               prometheus::RequestedExecution::kAuto)
