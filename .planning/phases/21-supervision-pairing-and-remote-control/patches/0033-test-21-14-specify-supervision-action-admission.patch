+      SupervisionRemoteActionCategory::kKeyPress,
+      SupervisionRemoteActionCategory::kScroll,
+      SupervisionRemoteActionCategory::kHover,
+      SupervisionRemoteActionCategory::kSelect,
+      SupervisionRemoteActionCategory::kClear,
+  };
+  for (SupervisionRemoteActionCategory category : categories) {
+    auto controller = MakeController();
+    auto result = Execute(*controller, Action(category));
+    ASSERT_TRUE(result.has_value());
+    EXPECT_TRUE(result->ok);
+  }
+  ASSERT_EQ(std::size(categories), dispatched_requests_.size());
+  EXPECT_EQ(&browser_, dispatched_browser_);
+  for (const AgentRouteRequest& request : dispatched_requests_) {
+    EXPECT_EQ(owner_, request.session_id);
+    EXPECT_EQ(browser_id_.id(), request.target.browser_session_id);
+    EXPECT_EQ(browser_id_.id(), request.target.window_session_id);
+    EXPECT_EQ(tab_.GetHandle(), request.target.tab_handle);
+  }
+}
