 }
 
@@ -400,14 +459,33 @@ void PrometheusSupervisionCaptureHub::SweepExpiredConsumers() {
     return;
   }
   const base::Time now = Now();
-  std::erase_if(consumers_, [now](const auto& entry) {
-    return entry.second.expiry <= now;
-  });
+  std::vector<DiffWaitCallback> expired_waits;
+  for (auto consumer = consumers_.begin(); consumer != consumers_.end();) {
+    if (consumer->second.expiry > now) {
+      ++consumer;
+      continue;
+    }
+    if (consumer->second.pending_diff_wait) {
+      expired_waits.push_back(std::move(consumer->second.pending_diff_wait));
+    }
+    consumer = consumers_.erase(consumer);
+  }
   if (consumers_.empty()) {
     StopObservation();
   } else {
     PruneHistory();
   }
+  NotifyReadyDiffWaiters();
+  for (DiffWaitCallback& callback : expired_waits) {
+    CompleteDiffWaitAsync(std::move(callback),
+                          SupervisionCaptureWaitReason::kConsumerEnded);
+  }
+}
