@@ -79,6 +86,19 @@ ExtensionPopup* ExtensionPopup::last_popup_for_testing() {
   return g_last_popup_for_testing;
 }
 
+// static
+std::vector<ExtensionPopup*> ExtensionPopup::GetVisiblePopupsForBrowser(
+    BrowserWindowInterface* browser) {
+  std::vector<ExtensionPopup*> visible;
+  for (ExtensionPopup* popup : LiveExtensionPopups()) {
+    if (popup->browser_ == browser && popup->host_ && popup->GetWidget() &&
+        popup->GetWidget()->IsVisible()) {
+      visible.push_back(popup);
+    }
+  }
+  return visible;
+}
+
 // static
 void ExtensionPopup::ShowPopup(
     BrowserWindowInterface* browser,
