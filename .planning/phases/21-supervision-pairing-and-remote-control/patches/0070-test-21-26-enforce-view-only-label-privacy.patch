+++ b/chrome/browser/ui/webui/prometheus/prometheus_web_ui_browsertest.cc
@@ -4285,7 +4285,7 @@ IN_PROC_BROWSER_TEST_F(
       const state = window.prometheusRuntimeSnapshotForTesting?.supervision;
       state?.available === true && state.viewer_count === 1 &&
           state.controlled === false &&
-          state.client_label === 'Review console' &&
+          !Object.hasOwn(state, 'client_label') &&
           state.safe_target_title === 'Quarterly report' &&
           state.activity === 'viewing';
     )")
