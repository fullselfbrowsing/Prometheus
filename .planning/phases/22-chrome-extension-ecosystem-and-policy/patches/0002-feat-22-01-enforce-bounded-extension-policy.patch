+constexpr char kSchemaVersionKey[] = "schema_version";
+constexpr char kGrantsKey[] = "grants";
+constexpr char kRegularKey[] = "regular";
+constexpr char kPrivateKey[] = "private";
+
 base::DictValue MakeDefaultExtensionPolicyData() {
   base::DictValue root;
-  root.Set("schema_version", kPrometheusExtensionPolicySchemaVersion);
-  root.Set("grants", base::DictValue());
+  root.Set(kSchemaVersionKey, kPrometheusExtensionPolicySchemaVersion);
+  root.Set(kGrantsKey, base::DictValue());
   return root;
 }
 
+bool HasOnlyChoiceKeys(const base::DictValue& value) {
+  return value.size() == 2u && value.Find(kRegularKey) &&
+         value.Find(kPrivateKey);
+}
+
+void RetainLexicographicallyFirstChoices(ExtensionPolicyChoices* choices) {
+  while (choices->size() > kMaxExtensionPolicyEntries) {
+    choices->erase(std::prev(choices->end()));
+  }
+}
+
 }  // namespace
 
 void RegisterPrometheusExtensionPolicyProfilePrefs(
@@ -29,16 +49,89 @@ void RegisterPrometheusExtensionPolicyProfilePrefs(
 
 ExtensionPolicyChoices ReadPrometheusExtensionPolicyChoices(
     const PrefService& prefs) {
-  return {};
+  const base::DictValue& root =
+      prefs.GetDict(kPrometheusExtensionPolicyProfileData);
+  if (root.size() != 2u || root.FindInt(kSchemaVersionKey) !=
+                               kPrometheusExtensionPolicySchemaVersion) {
+    return {};
+  }
+
+  const base::DictValue* grants = root.FindDict(kGrantsKey);
+  if (!grants) {
+    return {};
+  }
+
+  ExtensionPolicyChoices choices;
+  for (const auto [extension_id, stored_value] : *grants) {
+    if (!stored_value.is_dict()) {
+      return {};
+    }
+    const base::DictValue& stored_choice = stored_value.GetDict();
+    if (!HasOnlyChoiceKeys(stored_choice)) {
+      return {};
+    }
+    const std::string* regular_value = stored_choice.FindString(kRegularKey);
+    const std::string* private_value = stored_choice.FindString(kPrivateKey);
+    if (!regular_value || !private_value) {
+      return {};
+    }
+    const std::optional<ExtensionAgentGrant> regular =
+        ExtensionAgentGrantFromString(*regular_value);
+    const std::optional<ExtensionAgentGrant> private_mode =
+        ExtensionAgentGrantFromString(*private_value);
+    if (!regular || !private_mode) {
+      return {};
+    }
+    if (!crx_file::id_util::IdIsValid(extension_id)) {
+      continue;
+    }
+
+    choices.emplace(extension_id, ExtensionPolicyChoice{
+                                      *regular, ClampPrivateExtensionGrant(
+                                                    *regular, *private_mode)});
+    RetainLexicographicallyFirstChoices(&choices);
+  }
+  return choices;
 }
 
 void WritePrometheusExtensionPolicyChoices(
     PrefService& prefs,
-    const ExtensionPolicyChoices& choices) {}
+    const ExtensionPolicyChoices& choices) {
+  base::DictValue grants;
+  size_t stored_count = 0;
+  for (const auto& [extension_id, choice] : choices) {
+    if (stored_count == kMaxExtensionPolicyEntries) {
+      break;
+    }
+    if (!crx_file::id_util::IdIsValid(extension_id)) {
+      continue;
+    }
+    const ExtensionAgentGrant private_mode =
+        ClampPrivateExtensionGrant(choice.regular, choice.private_mode);
+    grants.Set(
+        extension_id,
+        base::DictValue()
+            .Set(kRegularKey, ExtensionAgentGrantToString(choice.regular))
+            .Set(kPrivateKey, ExtensionAgentGrantToString(private_mode)));
+    ++stored_count;
+  }
+
+  base::DictValue root;
+  root.Set(kSchemaVersionKey, kPrometheusExtensionPolicySchemaVersion);
+  root.Set(kGrantsKey, std::move(grants));
+  prefs.SetDict(kPrometheusExtensionPolicyProfileData, std::move(root));
+}
 
 bool RemovePrometheusExtensionPolicyChoice(PrefService& prefs,
                                            std::string_view extension_id) {
-  return false;
+  ExtensionPolicyChoices choices = ReadPrometheusExtensionPolicyChoices(prefs);
+  const auto choice_it = choices.find(extension_id);
+  if (choice_it == choices.end()) {
+    return false;
+  }
+  choices.erase(choice_it);
+  WritePrometheusExtensionPolicyChoices(prefs, choices);
+  return true;
 }
 
 }  // namespace prometheus
