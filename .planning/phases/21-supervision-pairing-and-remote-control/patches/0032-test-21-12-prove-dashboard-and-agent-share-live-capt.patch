+  ASSERT_TRUE(agent_first_diff.ok) << agent_first_diff.message;
+  EXPECT_NE(
+      std::string::npos,
+      dashboard_a_diff.delivery->diff.serialized_json.find(kMutationMarker));
+  EXPECT_NE(std::string::npos,
+            agent_first_diff.serialized.find(kMutationMarker));
