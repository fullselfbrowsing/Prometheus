+std::string_view MemoryVisibilityValue(MemoryVisibility visibility) {
+  return visibility == MemoryVisibility::kProfileShared ? "profile_shared"
+                                                        : "caller_owned";
+}
+
+std::optional<MemoryVisibility> MemoryVisibilityFromControl(
+    std::string_view visibility) {
+  if (visibility == "caller_owned") {
+    return MemoryVisibility::kCallerOwned;
+  }
+  if (visibility == "profile_shared") {
+    return MemoryVisibility::kProfileShared;
+  }
+  return std::nullopt;
+}
+
+std::string_view MemoryStoreStatusValue(MemoryStoreStatus status) {
+  switch (status) {
+    case MemoryStoreStatus::kOk:
+      return "OK";
+    case MemoryStoreStatus::kNotFound:
+      return "NOT_FOUND";
+    case MemoryStoreStatus::kDenied:
+      return "DENIED";
+    case MemoryStoreStatus::kInvalidInput:
+      return "INVALID_REQUEST";
+    case MemoryStoreStatus::kOriginMismatch:
+      return "GUIDE_ORIGIN_MISMATCH";
+    case MemoryStoreStatus::kDocumentChanged:
+      return "GUIDE_DOCUMENT_CHANGED";
+    case MemoryStoreStatus::kNotCurrentDocument:
+      return "GUIDE_NOT_CURRENT_DOCUMENT";
+    case MemoryStoreStatus::kStoreFull:
+      return "STORE_FULL";
+  }
+}
+
+base::DictValue MemoryOperationValue(MemoryStoreStatus status,
+                                     std::string record_id = std::string()) {
+  base::DictValue value;
+  value.Set("status", MemoryStoreStatusValue(status));
+  value.Set("accepted", status == MemoryStoreStatus::kOk);
+  if (!record_id.empty()) {
+    value.Set("record_id", std::move(record_id));
+  }
+  if (status != MemoryStoreStatus::kOk) {
+    value.Set("recovery", "Review the bounded record metadata and retry");
+  }
+  return value;
+}
+
+std::string_view GuideOutcomeStatus(SiteGuideApplyOutcome outcome) {
+  switch (outcome) {
+    case SiteGuideApplyOutcome::kApplied:
+      return "GUIDE_APPLIED";
+    case SiteGuideApplyOutcome::kNotFound:
+      return "NOT_FOUND";
+    case SiteGuideApplyOutcome::kDenied:
+      return "DENIED";
+    case SiteGuideApplyOutcome::kOriginMismatch:
+      return "GUIDE_ORIGIN_MISMATCH";
+    case SiteGuideApplyOutcome::kDocumentChanged:
+      return "GUIDE_DOCUMENT_CHANGED";
+    case SiteGuideApplyOutcome::kNotCurrentDocument:
+      return "GUIDE_NOT_CURRENT_DOCUMENT";
+  }
+}
+
+base::DictValue GuideOperationValue(
+    const SiteGuideApplicationRecord& application) {
+  base::DictValue value;
+  value.Set("status", GuideOutcomeStatus(application.outcome));
+  value.Set("accepted", application.applied());
+  if (!application.applied()) {
+    value.Set("recovery", "Refresh the current page and retry the exact guide");
+  }
+  return value;
+}
+
+base::DictValue VaultOperationValue(PrometheusVaultStatus status) {
+  base::DictValue value;
+  value.Set("status", PrometheusVaultStatusToString(status));
+  value.Set("accepted", status == PrometheusVaultStatus::kSuccess);
+  if (status != PrometheusVaultStatus::kSuccess) {
+    value.Set("recovery", "Review the vault metadata and retry");
+  }
+  return value;
+}
+
+base::ListValue TagsValue(const std::vector<std::string>& tags) {
+  base::ListValue value;
+  for (const std::string& tag : tags) {
+    value.Append(tag);
+  }
+  return value;
+}
+
+base::DictValue MemoryRecordValue(const MemoryRecord& record) {
+  base::DictValue value;
+  value.Set("memory_id", record.memory_id);
+  value.Set("title", record.title);
+  value.Set("text", record.text);
+  value.Set("tags", TagsValue(record.tags));
+  value.Set("visibility", MemoryVisibilityValue(record.visibility));
+  value.Set("created_at_ms", static_cast<double>(record.created_at_ms));
+  value.Set("updated_at_ms", static_cast<double>(record.updated_at_ms));
+  value.Set("byte_count", static_cast<int>(record.byte_count));
+  value.Set("editable", record.owned_by_caller);
+  return value;
+}
+
+base::DictValue SiteGuideRecordValue(const SiteGuideRecord& record) {
+  base::DictValue value;
+  value.Set("guide_id", record.guide_id);
+  value.Set("title", record.title);
+  value.Set("instructions", record.instructions);
+  value.Set("tags", TagsValue(record.tags));
+  value.Set("canonical_origin", record.canonical_origin);
+  value.Set("visibility", MemoryVisibilityValue(record.visibility));
+  value.Set("created_at_ms", static_cast<double>(record.created_at_ms));
+  value.Set("updated_at_ms", static_cast<double>(record.updated_at_ms));
+  value.Set("byte_count", static_cast<int>(record.byte_count));
+  value.Set("editable", record.owned_by_caller);
+  return value;
+}
+
+base::DictValue GuideApplicationValue(
+    const SiteGuideApplicationRecord& application) {
+  base::DictValue value;
+  value.Set("guide_id", application.guide_id);
+  value.Set("canonical_origin", application.canonical_origin);
+  switch (application.outcome) {
+    case SiteGuideApplyOutcome::kApplied:
+      value.Set("status", "applied");
+      break;
+    case SiteGuideApplyOutcome::kNotFound:
+      value.Set("status", "not_found");
+      break;
+    case SiteGuideApplyOutcome::kDenied:
+      value.Set("status", "denied");
+      break;
+    case SiteGuideApplyOutcome::kOriginMismatch:
+      value.Set("status", "origin_mismatch");
+      break;
+    case SiteGuideApplyOutcome::kDocumentChanged:
+      value.Set("status", "document_changed");
+      break;
+    case SiteGuideApplyOutcome::kNotCurrentDocument:
+      value.Set("status", "not_current_document");
+      break;
+  }
+  value.Set("timestamp_ms", static_cast<double>(application.timestamp_ms));
+  return value;
+}
+
+base::DictValue VaultMetadataValue(const PrometheusVaultMetadata& metadata) {
+  base::DictValue value;
+  value.Set("id", metadata.id);
+  value.Set("label", metadata.label);
+  value.Set("kind", PrometheusVaultKindToString(metadata.kind));
+  value.Set("canonical_origin", metadata.canonical_site_origin);
+  value.Set("updated_time_ms", static_cast<double>(metadata.updated_time_ms));
+  value.Set("secret_configured", metadata.secret_configured);
+  return value;
+}
