-void PrometheusSupervisionCaptureHub::SweepExpiredConsumers() {}
+void PrometheusSupervisionCaptureHub::SweepExpiredConsumers() {
+  if (consumers_.empty()) {
+    return;
+  }
+  const base::Time now = Now();
+  std::erase_if(consumers_, [now](const auto& entry) {
+    return entry.second.expiry <= now;
+  });
+  if (consumers_.empty()) {
+    StopObservation();
+  } else {
+    PruneHistory();
+  }
+}
 
