+TEST(PrometheusAgentGatewayTest,
+     SupervisionUnbindCancelsPendingAndIgnoresLateCompletion) {
+  FakeSupervisionGatewayDispatcher fake;
+  fake.hold_requests = true;
+  PrometheusAgentGateway gateway({});
+  gateway.SetSupervisionGatewayDispatcher(fake.Bind());
+  NativeResponse response;
+  gateway.HandleNativeRequestForTesting(
+      "/v1/supervision", kSupervisionRequests[2],
+      base::BindOnce(
+          [](NativeResponse* output, int status, std::string body) {
+            ++output->callbacks;
+            output->status = status;
+            output->body = std::move(body);
+          },
+          &response));
+  ASSERT_EQ(1u, fake.held_callbacks.size());
+  ASSERT_EQ(1u, gateway.pending_supervision_request_count_for_testing());
+
+  gateway.SetSupervisionGatewayDispatcher({});
+  ASSERT_EQ(1u, fake.cancellations.size());
+  EXPECT_EQ(fake.requests[0].cancellation_token, fake.cancellations[0]);
+  EXPECT_EQ(1u, fake.shutdowns);
+  EXPECT_EQ(1u, response.callbacks);
+  EXPECT_EQ(net::HTTP_OK, response.status);
+  EXPECT_NE(std::string::npos, response.body.find("UNAVAILABLE"));
+  EXPECT_EQ(0u, gateway.pending_supervision_request_count_for_testing());
+
+  std::move(fake.held_callbacks[0])
