+
+  raw_ptr<PrometheusProviderRegistry> registry_;
+  raw_ptr<PrometheusSecretStore> secret_store_;
+  scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory_;
+  ProviderTransportLimits limits_;
+  raw_ptr<const base::TickClock> tick_clock_;
+  OperationId next_operation_id_ = 1;
+  std::map<OperationId, std::unique_ptr<Operation>> operations_;
+  base::WeakPtrFactory<PrometheusProviderTransport> weak_factory_{this};
+};
