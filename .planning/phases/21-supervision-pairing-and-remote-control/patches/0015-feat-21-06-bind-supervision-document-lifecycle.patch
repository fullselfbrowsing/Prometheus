 .../renderer/modules/modules_initializer.cc   |  5 +++
 4 files changed, 54 insertions(+)

diff --git a/third_party/blink/renderer/modules/content_extraction/prometheus_supervision_document_supplement.cc b/third_party/blink/renderer/modules/content_extraction/prometheus_supervision_document_supplement.cc
index dc789ad672..85dedb9a86 100644
--- a/third_party/blink/renderer/modules/content_extraction/prometheus_supervision_document_supplement.cc
+++ b/third_party/blink/renderer/modules/content_extraction/prometheus_supervision_document_supplement.cc
@@ -11,6 +11,7 @@
 #include "third_party/blink/renderer/core/frame/local_dom_window.h"
 #include "third_party/blink/renderer/core/frame/local_frame.h"
 #include "third_party/blink/renderer/platform/bindings/exception_state.h"
+#include "third_party/blink/renderer/platform/wtf/functional.h"
 
 namespace blink {
 
@@ -93,6 +94,9 @@ void PrometheusSupervisionDocumentSupplement::Bind(
   receiver_.Bind(
       std::move(receiver),
       GetSupplementable()->GetTaskRunner(TaskType::kInternalUserInteraction));
+  receiver_.set_disconnect_handler(BindOnce(
+      &PrometheusSupervisionDocumentSupplement::OnReceiverDisconnected,
+      WrapWeakPersistent(this)));
 }
 
 void PrometheusSupervisionDocumentSupplement::Enable(
@@ -101,6 +105,9 @@ void PrometheusSupervisionDocumentSupplement::Enable(
   host_.Bind(
       std::move(host),
       GetSupplementable()->GetTaskRunner(TaskType::kInternalUserInteraction));
+  host_.set_disconnect_handler(
+      BindOnce(&PrometheusSupervisionDocumentSupplement::OnHostDisconnected,
+               WrapWeakPersistent(this)));
   enabled_ = true;
   ObserveDocument();
 }
@@ -167,6 +174,15 @@ void PrometheusSupervisionDocumentSupplement::DirtyTimerFired(TimerBase*) {
   host_->OnDocumentDirty(signal);
 }
 
+void PrometheusSupervisionDocumentSupplement::OnReceiverDisconnected() {
+  Disable();
+  receiver_.reset();
+}
+
+void PrometheusSupervisionDocumentSupplement::OnHostDisconnected() {
+  Disable();
+}
+
 void PrometheusSupervisionDocumentSupplement::ContextDestroyed() {
   Disable();
   receiver_.reset();
