diff --git a/chrome/browser/prometheus/prometheus_extension_policy_service.cc b/chrome/browser/prometheus/prometheus_extension_policy_service.cc
index af0818f7fc..a6a7f8106a 100644
--- a/chrome/browser/prometheus/prometheus_extension_policy_service.cc
+++ b/chrome/browser/prometheus/prometheus_extension_policy_service.cc
@@ -168,12 +168,59 @@ PrometheusExtensionPolicyService::SetRequestedGrant(size_t ordinal,
   if (generation != generation_) {
     return ExtensionPolicyMutationResult::kStaleGeneration;
   }
+  const std::optional<std::string> extension_id =
+      ResolveExtensionIdForMutation(ordinal, generation);
+  if (!extension_id) {
+    return ExtensionPolicyMutationResult::kMissingExtension;
+  }
+  return SetRequestedGrantForExtension(ordinal, generation, *extension_id,
+                                       private_mode, grant);
+}
+
+std::optional<std::string>
+PrometheusExtensionPolicyService::ResolveExtensionIdForMutation(
+    size_t ordinal,
+    uint64_t generation) const {
+  if (shutdown_ || !prefs_) {
+    return std::nullopt;
+  }
+  if (generation != generation_) {
+    return std::nullopt;
+  }
 
   const std::vector<ExtensionPolicyInventoryEntry> inventory = BuildInventory();
   if (ordinal >= inventory.size() ||
       ordinal >= kMaxExtensionPolicySnapshotRows) {
+    return std::nullopt;
+  }
+  return inventory[ordinal].extension_id;
+}
+
+ExtensionPolicyMutationResult
+PrometheusExtensionPolicyService::SetRequestedGrantForExtension(
+    size_t ordinal,
+    uint64_t generation,
+    std::string_view expected_extension_id,
+    bool private_mode,
+    ExtensionAgentGrant grant) {
+  if (shutdown_ || !prefs_) {
+    return ExtensionPolicyMutationResult::kUnavailable;
+  }
+  if (generation != generation_) {
+    return ExtensionPolicyMutationResult::kStaleGeneration;
+  }
+
+  const std::vector<ExtensionPolicyInventoryEntry> inventory = BuildInventory();
+  if (ordinal >= inventory.size() ||
+      ordinal >= kMaxExtensionPolicySnapshotRows ||
+      inventory[ordinal].extension_id != expected_extension_id) {
     return ExtensionPolicyMutationResult::kMissingExtension;
   }
+  if (!IsSystemReady() || !inventory[ordinal].enabled ||
+      !inventory[ordinal].ready ||
+      inventory[ordinal].browser_context != regular_context_) {
+    return ExtensionPolicyMutationResult::kInactiveExtension;
+  }
 
   ExtensionPolicyChoices choices =
       ReadPrometheusExtensionPolicyChoices(*prefs_);
