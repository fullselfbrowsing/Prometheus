+bool HasOnlySchemaKeywords(const base::DictValue& schema,
+                           std::initializer_list<std::string_view> allowed) {
+  for (const auto [key, ignored] : schema) {
+    static_cast<void>(ignored);
+    if (std::find(allowed.begin(), allowed.end(), key) == allowed.end()) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool HasValidSchemaDescription(const base::DictValue& schema) {
+  const base::Value* description = schema.Find("description");
+  return !description ||
+         (description->is_string() &&
+          description->GetString().size() <= kMaxProviderToolDescriptionBytes &&
+          base::IsStringUTF8(description->GetString()));
+}
+
+bool HasValidNonNegativeBounds(const base::DictValue& schema,
+                               std::string_view minimum_key,
+                               std::string_view maximum_key) {
+  std::optional<int> minimum = schema.FindInt(minimum_key);
+  std::optional<int> maximum = schema.FindInt(maximum_key);
+  if ((schema.contains(minimum_key) && !minimum) ||
+      (schema.contains(maximum_key) && !maximum) || (minimum && *minimum < 0) ||
+      (maximum && *maximum < 0) ||
+      (minimum && maximum && *minimum > *maximum)) {
+    return false;
+  }
+  return true;
+}
+
+bool IsValidToolSchemaNode(const base::DictValue& schema, size_t depth) {
+  if (depth > kMaxProviderToolSchemaDepth ||
+      !HasValidSchemaDescription(schema)) {
+    return false;
+  }
+  const std::string* type = schema.FindString("type");
+  if (!type) {
+    return false;
+  }
+
+  if (*type == "object") {
+    if (!HasOnlySchemaKeywords(schema, {"type", "description", "properties",
+                                        "required", "additionalProperties"}) ||
+        schema.FindBool("additionalProperties") != false) {
+      return false;
+    }
+    const base::Value* properties_value = schema.Find("properties");
+    if (properties_value && !properties_value->is_dict()) {
+      return false;
+    }
+    const base::DictValue* properties = schema.FindDict("properties");
+    if (properties) {
+      for (const auto [name, property] : *properties) {
+        if (name.empty() || name.size() > kMaxProviderToolNameBytes ||
+            !property.is_dict() ||
+            !IsValidToolSchemaNode(property.GetDict(), depth + 1)) {
+          return false;
+        }
+      }
+    }
+    const base::Value* required_value = schema.Find("required");
+    if (required_value && !required_value->is_list()) {
+      return false;
+    }
+    std::set<std::string> required_names;
+    if (const base::ListValue* required = schema.FindList("required")) {
+      for (const base::Value& entry : *required) {
+        if (!entry.is_string() ||
+            !required_names.insert(entry.GetString()).second || !properties ||
+            !properties->contains(entry.GetString())) {
+          return false;
+        }
+      }
+    }
+    return true;
+  }
+
+  if (*type == "array") {
+    if (!HasOnlySchemaKeywords(
+            schema, {"type", "description", "items", "minItems", "maxItems"}) ||
+        !HasValidNonNegativeBounds(schema, "minItems", "maxItems")) {
+      return false;
+    }
+    const base::DictValue* items = schema.FindDict("items");
+    return items && IsValidToolSchemaNode(*items, depth + 1);
+  }
+
+  if (*type == "string") {
+    return HasOnlySchemaKeywords(
+               schema, {"type", "description", "minLength", "maxLength"}) &&
+           HasValidNonNegativeBounds(schema, "minLength", "maxLength");
+  }
+
+  if (*type == "integer") {
+    if (!HasOnlySchemaKeywords(schema,
+                               {"type", "description", "minimum", "maximum"})) {
+      return false;
+    }
+    std::optional<int> minimum = schema.FindInt("minimum");
+    std::optional<int> maximum = schema.FindInt("maximum");
+    return !(schema.contains("minimum") && !minimum) &&
+           !(schema.contains("maximum") && !maximum) &&
+           !(minimum && maximum && *minimum > *maximum);
+  }
+
+  if (*type == "boolean") {
+    return HasOnlySchemaKeywords(schema, {"type", "description"});
+  }
+  return false;
+}
