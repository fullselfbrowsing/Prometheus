+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PROMETHEUS_PROMETHEUS_SUPERVISION_ACTION_CONTROLLER_H_
+#define CHROME_BROWSER_PROMETHEUS_PROMETHEUS_SUPERVISION_ACTION_CONTROLLER_H_
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/unguessable_token.h"
+#include "chrome/browser/prometheus/prometheus_agent_profile_service.h"
+#include "chrome/browser/prometheus/prometheus_agent_route.h"
+#include "chrome/browser/prometheus/prometheus_supervision_transport_codec.h"
+#include "chrome/browser/prometheus/prometheus_supervision_types.h"
+#include "components/tabs/public/tab_interface.h"
+
+class BrowserWindowInterface;
+class Profile;
+
+namespace prometheus {
+
+enum class SupervisionActionClassification {
+  kOrdinary,
+  kConsequential,
+  kRejected,
+};
+
+// A browser-owned snapshot. Remote action envelopes never populate this type.
+struct SupervisionActionAuthoritySnapshot {
+  raw_ptr<Profile> profile = nullptr;
+  raw_ptr<BrowserWindowInterface> exact_browser = nullptr;
+  tabs::TabHandle stable_tab;
+  std::string live_owner_session_id;
+  std::optional<base::UnguessableToken> active_controller_session;
+  std::optional<base::UnguessableToken> controller_lease;
+  base::UnguessableToken document_epoch;
+  uint64_t sequence = 0;
+  uint64_t authority_generation = 0;
+  bool stream_live = false;
+};
+
+// Deliberately content-free. Raw action values and Agent result payloads never
+// cross the supervision boundary.
+struct SupervisionActionResult {
+  bool ok = false;
+  SupervisionRemoteActionState state =
+      SupervisionRemoteActionState::kBlocked;
+  SupervisionErrorCode error_code = SupervisionErrorCode::kNone;
+  AgentErrorCode agent_error_code = AgentErrorCode::kNone;
+  base::TimeDelta duration;
+};
+
+class PrometheusSupervisionActionController {
+ public:
+  using AuthorityResolver = base::RepeatingCallback<
+      std::optional<SupervisionActionAuthoritySnapshot>()>;
+  using FrameResolver = base::RepeatingCallback<std::optional<AgentFrameTarget>(
+      BrowserWindowInterface*,
+      tabs::TabHandle,
+      const SupervisionRemoteActionRequest&)>;
+  using AgentRouteDispatcher = base::RepeatingCallback<void(
+      BrowserWindowInterface*,
+      const AgentRouteRequest&,
+      PrometheusAgentService::RouteCallback)>;
+  using CompletionCallback = base::OnceCallback<void(SupervisionActionResult)>;
+
+  PrometheusSupervisionActionController(
+      Profile* profile,
+      base::WeakPtr<BrowserWindowInterface> exact_browser,
+      tabs::TabHandle stable_tab,
+      base::UnguessableToken dashboard_session,
+      std::string immutable_owner_session_id,
+      AuthorityResolver authority_resolver,
+      AgentRouteDispatcher route_dispatcher,
+      FrameResolver frame_resolver = FrameResolver());
+  PrometheusSupervisionActionController(
+      const PrometheusSupervisionActionController&) = delete;
+  PrometheusSupervisionActionController& operator=(
+      const PrometheusSupervisionActionController&) = delete;
+  ~PrometheusSupervisionActionController();
+
+  static SupervisionActionClassification Classify(
+      const SupervisionRemoteActionRequest& action);
+
+  void ExecuteAction(const base::UnguessableToken& dashboard_session,
+                     std::string_view document_epoch,
+                     uint64_t sequence,
+                     const SupervisionRemoteActionRequest& action,
+                     CompletionCallback callback);
+  void ResolvePendingConfirmation(bool allow_once);
+  void Cancel(SupervisionErrorCode error_code);
+
+  bool has_in_flight_action_for_testing() const;
+  bool awaiting_confirmation_for_testing() const;
+
+ private:
+  struct PendingAction;
+
+  raw_ptr<Profile> profile_ = nullptr;
+  base::WeakPtr<BrowserWindowInterface> exact_browser_;
+  const tabs::TabHandle stable_tab_;
+  const base::UnguessableToken dashboard_session_;
+  const std::string immutable_owner_session_id_;
+  AuthorityResolver authority_resolver_;
+  AgentRouteDispatcher route_dispatcher_;
+  FrameResolver frame_resolver_;
+  std::unique_ptr<PendingAction> pending_action_;
+  uint64_t next_action_id_ = 0;
+  base::WeakPtrFactory<PrometheusSupervisionActionController> weak_factory_{
+      this};
+};
+
+PrometheusSupervisionActionController::AgentRouteDispatcher
+BindPrometheusSupervisionAgentRouteDispatcher(
+    base::WeakPtr<PrometheusAgentProfileService> agent_profile_service);
+
+}  // namespace prometheus
+
+#endif  // CHROME_BROWSER_PROMETHEUS_PROMETHEUS_SUPERVISION_ACTION_CONTROLLER_H_
