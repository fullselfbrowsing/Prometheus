 void PrometheusExtensionSmokeController::OnDisableClickIssued(
+    base::TimeTicks deadline,
     base::Value result) {
   if (pending_transition_ != PrometheusExtensionSmokePendingTransition::kDisable) {
     return;
   }
   const std::string status = ResultValueOrEmpty(result);
-  if (status != "clicked") {
-    Fail(stage_, "disable_click_failed:" + status);
+  if (status == "clicked") {
+    ArmPendingTransitionTimeout(kTransitionObservedTimeout,
+                               "disable_not_observed_timeout");
     return;
   }
-  ArmPendingTransitionTimeout(kTransitionObservedTimeout,
-                             "disable_not_observed_timeout");
+  // The item's card can render before its enable toggle becomes actionable
+  // (Lit re-renders the card, then the toggle's own disabled/hidden bindings
+  // settle in a later update); retry the click until the bounded deadline
+  // instead of treating a transient toggle state as a hard failure.
+  if ((status == "disabled_toggle" || status == "hidden_toggle") &&
+      base::TimeTicks::Now() < deadline) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&PrometheusExtensionSmokeController::ClickDisableToggle,
+                       weak_ptr_factory_.GetWeakPtr(), deadline),
+        kPollInterval);
+    return;
+  }
+  Fail(stage_, "disable_click_failed:" + status);
 }
 
