new file mode 100644
index 0000000000..001b5119ee
--- /dev/null
+++ b/chrome/browser/prometheus/prometheus_supervision_capture_hub.cc
@@ -0,0 +1,176 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_supervision_capture_hub.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/memory/raw_ptr.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "third_party/blink/public/mojom/content_extraction/prometheus_supervision_document.mojom.h"
+
+namespace prometheus {
+
+// The retained RED scaffold fixes the endpoint ownership in this private hub
+// entry. Task 2 completes binding and lifecycle behavior.
+class PrometheusSupervisionCaptureHub::FrameEntry
+    : public blink::mojom::PrometheusSupervisionDocumentHost {
+ public:
+  FrameEntry(PrometheusSupervisionCaptureHub* owner,
+             content::RenderFrameHost* render_frame_host,
+             uint64_t generation)
+      : owner_(owner),
+        render_frame_host_(render_frame_host),
+        generation_(generation),
+        host_receiver_(this) {}
+  ~FrameEntry() override = default;
+
+  void OnDocumentDirty(
+      blink::mojom::PrometheusSupervisionDirtySignal signal) override {}
+
+ private:
+  raw_ptr<PrometheusSupervisionCaptureHub> owner_;
+  raw_ptr<content::RenderFrameHost> render_frame_host_;
+  [[maybe_unused]] uint64_t generation_ = 0;
+  mojo::Remote<blink::mojom::PrometheusSupervisionDocument> document_remote_;
+  mojo::Receiver<blink::mojom::PrometheusSupervisionDocumentHost>
+      host_receiver_;
+};
+
+PrometheusSupervisionCaptureHub::PrometheusSupervisionCaptureHub(
+    content::WebContents* web_contents,
+    int32_t stable_tab_id,
+    const SupervisionLimits& limits)
+    : content::WebContentsObserver(web_contents),
+      stable_tab_id_(stable_tab_id),
+      limits_(ClampSupervisionLimits(limits)),
+      now_callback_(base::BindRepeating(&base::Time::Now)) {}
+
+PrometheusSupervisionCaptureHub::PrometheusSupervisionCaptureHub(
+    int32_t stable_tab_id,
+    const SupervisionLimits& limits,
+    CaptureForTestingCallback capture_for_testing)
+    : content::WebContentsObserver(nullptr),
+      stable_tab_id_(stable_tab_id),
+      limits_(ClampSupervisionLimits(limits)),
+      capture_for_testing_(std::move(capture_for_testing)),
+      now_callback_(base::BindRepeating(&base::Time::Now)) {}
+
+PrometheusSupervisionCaptureHub::~PrometheusSupervisionCaptureHub() = default;
+
+std::optional<SupervisionCaptureConsumerId>
+PrometheusSupervisionCaptureHub::AttachConsumer(
+    SupervisionCaptureConsumerKind kind,
+    base::Time expiry) {
+  return std::nullopt;
+}
+
+std::optional<SupervisionCaptureBaselineDelivery>
+PrometheusSupervisionCaptureHub::ReadBaseline(
+    SupervisionCaptureConsumerId consumer_id) {
+  return std::nullopt;
+}
+
+std::optional<SupervisionCaptureDiffDelivery>
+PrometheusSupervisionCaptureHub::ReadNext(
+    SupervisionCaptureConsumerId consumer_id) {
+  return std::nullopt;
+}
+
+bool PrometheusSupervisionCaptureHub::Ack(
+    SupervisionCaptureConsumerId consumer_id,
+    const SupervisionStreamStamp& stamp) {
+  return false;
+}
+
+bool PrometheusSupervisionCaptureHub::RevokeConsumer(
+    SupervisionCaptureConsumerId consumer_id) {
+  return false;
+}
+
+bool PrometheusSupervisionCaptureHub::DetachConsumer(
+    SupervisionCaptureConsumerId consumer_id) {
+  return false;
+}
+
+void PrometheusSupervisionCaptureHub::SweepExpiredConsumers() {}
+
+bool PrometheusSupervisionCaptureHub::ConsumerNeedsBaseline(
+    SupervisionCaptureConsumerId consumer_id) const {
+  return true;
+}
+
+void PrometheusSupervisionCaptureHub::SetNowCallbackForTesting(
+    NowCallback now_callback) {
+  now_callback_ = std::move(now_callback);
+}
+
+void PrometheusSupervisionCaptureHub::NotifyDirtyForTesting(bool overflow) {}
+
+void PrometheusSupervisionCaptureHub::ReplaceDocumentForTesting() {}
+
+void PrometheusSupervisionCaptureHub::DisconnectRendererForTesting() {}
+
+void PrometheusSupervisionCaptureHub::RenderFrameCreated(
+    content::RenderFrameHost* render_frame_host) {}
+
+void PrometheusSupervisionCaptureHub::RenderFrameDeleted(
+    content::RenderFrameHost* render_frame_host) {}
+
+void PrometheusSupervisionCaptureHub::PrimaryPageChanged(content::Page& page) {}
+
+void PrometheusSupervisionCaptureHub::DidFinishNavigation(
+    content::NavigationHandle* navigation_handle) {}
+
+void PrometheusSupervisionCaptureHub::WebContentsDestroyed() {}
+
+base::Time PrometheusSupervisionCaptureHub::Now() const {
+  return now_callback_.Run();
+}
+
+void PrometheusSupervisionCaptureHub::StartObservation() {}
+
+void PrometheusSupervisionCaptureHub::StopObservation() {}
+
+void PrometheusSupervisionCaptureHub::StartNewDocumentEpoch() {}
+
+void PrometheusSupervisionCaptureHub::BindCurrentFrames() {}
+
+void PrometheusSupervisionCaptureHub::BindFrame(
+    content::RenderFrameHost* render_frame_host) {}
+
+void PrometheusSupervisionCaptureHub::OnFrameDirty(
+    content::RenderFrameHost* render_frame_host,
+    uint64_t frame_generation,
+    bool overflow) {}
+
+void PrometheusSupervisionCaptureHub::OnFrameDisconnected(
+    content::RenderFrameHost* render_frame_host,
+    uint64_t frame_generation) {}
+
+void PrometheusSupervisionCaptureHub::RequestCapture(bool force_baseline) {}
+
+void PrometheusSupervisionCaptureHub::OnCapturedForTesting(
+    uint64_t capture_generation,
+    bool force_baseline,
+    SupervisionBaseline baseline) {}
+
+void PrometheusSupervisionCaptureHub::RequireBaselineForAll() {}
+
+void PrometheusSupervisionCaptureHub::RequireBaseline(ConsumerState& consumer) {}
+
+void PrometheusSupervisionCaptureHub::PruneHistory() {}
+
+bool PrometheusSupervisionCaptureHub::HasCurrentConsumer(
+    SupervisionCaptureConsumerId consumer_id) const {
+  return false;
+}
+
+}  // namespace prometheus
