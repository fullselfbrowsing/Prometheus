+TEST(PrometheusSupervisionProjectionTest,
+     NodeAndByteCapsNeverPublishPlausibleTruncation) {
+  EXPECT_EQ(500u, kDefaultSupervisionBaselineNodes);
+  EXPECT_EQ(200u * 1024u, kDefaultSupervisionBaselineBytes);
+
+  AnnotatedPageContent page_content = MakePageContent();
+  for (int id = 2; id <= 500; ++id) {
+    ContentNode* node =
+        AddNode(page_content.mutable_root_node(), id,
+                optimization_guide::proto::CONTENT_ATTRIBUTE_TEXT);
+    node->mutable_content_attributes()->mutable_text_data()->set_text_content(
+        "bounded node");
+  }
+  SupervisionLimits limits;
+  limits.baseline_nodes = 500;
+  limits.baseline_bytes = kDefaultSupervisionBaselineBytes;
+  const SupervisionBaseline at_node_cap =
+      BuildSupervisionBaseline(page_content, "main-doc", limits);
+  ASSERT_TRUE(at_node_cap.authoritative());
+  EXPECT_EQ(500u, at_node_cap.nodes.size());
+  EXPECT_LE(at_node_cap.serialized_json.size(),
+            kDefaultSupervisionBaselineBytes);
+
+  AddNode(page_content.mutable_root_node(), 501,
+          optimization_guide::proto::CONTENT_ATTRIBUTE_TEXT);
+  const SupervisionBaseline over_node_cap =
+      BuildSupervisionBaseline(page_content, "main-doc", limits);
+  EXPECT_FALSE(over_node_cap.authoritative());
+  EXPECT_TRUE(over_node_cap.nodes.empty());
+  EXPECT_TRUE(over_node_cap.serialized_json.empty());
+
+  AnnotatedPageContent byte_content = MakePageContent();
+  for (int id = 2; id <= 200; ++id) {
+    ContentNode* node = AddFormControl(
+        &byte_content, id, std::string(200, 'v'),
+        optimization_guide::proto::FORM_CONTROL_TYPE_INPUT_TEXT,
+        optimization_guide::proto::REDACTION_DECISION_NO_REDACTION_NECESSARY);
+    node->mutable_content_attributes()->set_label(std::string(80, 'n'));
+  }
+  limits.baseline_nodes = 500;
+  limits.baseline_bytes = kHardSupervisionBaselineBytes;
+  const SupervisionBaseline sized =
+      BuildSupervisionBaseline(byte_content, "main-doc", limits);
+  ASSERT_TRUE(sized.authoritative());
+  ASSERT_GT(sized.serialized_json.size(), 1u);
+
+  limits.baseline_bytes = sized.serialized_json.size();
+  EXPECT_TRUE(BuildSupervisionBaseline(byte_content, "main-doc", limits)
+                  .authoritative());
+  --limits.baseline_bytes;
+  const SupervisionBaseline over_byte_cap =
+      BuildSupervisionBaseline(byte_content, "main-doc", limits);
+  EXPECT_FALSE(over_byte_cap.authoritative());
+  EXPECT_TRUE(over_byte_cap.nodes.empty());
+  EXPECT_TRUE(over_byte_cap.serialized_json.empty());
+}
