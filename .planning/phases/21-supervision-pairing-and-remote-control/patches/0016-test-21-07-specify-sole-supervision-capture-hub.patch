+TEST_F(PrometheusSupervisionCaptureHubTest,
+       WrongSessionTargetEpochOrSequenceAcksFailConsumerLocal) {
+  auto hub = CreateHub();
+  const auto [first, second] = AttachTwo(*hub);
+  capture_source_.CompleteNext(MakeBaseline("initial"));
+  const auto first_baseline = hub->ReadBaseline(first);
+  const auto second_baseline = hub->ReadBaseline(second);
+  ASSERT_TRUE(first_baseline.has_value());
+  ASSERT_TRUE(second_baseline.has_value());
+
+  SupervisionStreamStamp stale = first_baseline->stamp;
+  stale.session = base::UnguessableToken::Create();
+  EXPECT_FALSE(hub->Ack(first, stale));
+  EXPECT_TRUE(hub->ConsumerNeedsBaseline(first));
+  EXPECT_FALSE(hub->Ack(first, first_baseline->stamp));
+  EXPECT_TRUE(hub->Ack(second, second_baseline->stamp));
+  EXPECT_FALSE(hub->ConsumerNeedsBaseline(second));
+}
