+IN_PROC_BROWSER_TEST_F(PrometheusAgentGatewayBrowserTest,
+                       ExtensionHealthIsLiveBoundedAndInventoryFree) {
+  PrometheusExtensionPolicyService* const service =
+      PrometheusExtensionPolicyServiceFactory::GetForProfile(
+          browser()->profile());
+  ASSERT_TRUE(service);
+  service->SetInventoryForTesting({ExtensionPolicyInventoryEntry{
+      .extension_id = "abcdefghijklmnopabcdefghijklmnop",
+      .name = "Installed extension inventory sentinel",
+      .source = ExtensionPolicySource::kUnpacked,
+      .enabled = true,
+      .ready = true,
+      .manifest_version = 3,
+      .native_private_eligible = true,
+      .browser_context = browser()->profile(),
+  }});
+
+  auto expect_extension_health = [&](std::string_view expected_status,
+                                     std::string_view expected_reason) {
+    HttpResult response = Authorized("GET", "/v1/health", "");
+    ASSERT_EQ(200, response.status);
+    auto root = base::JSONReader::ReadDict(response.body, base::JSON_PARSE_RFC);
+    ASSERT_TRUE(root.has_value()) << response.body;
+    const base::ListValue* diagnostics = root->FindList("diagnostics");
+    ASSERT_TRUE(diagnostics);
+    ASSERT_EQ(10u, diagnostics->size());
+    constexpr std::array<std::string_view, 10> kExpectedKeys = {
+        "browser",          "bridge",        "active_tab", "content_adapter",
+        "internal_adapter", "webui_adapter", "vault",      "provider",
+        "supervision",      "extensions"};
+    std::set<std::string> unique_keys;
+    for (size_t index = 0; index < diagnostics->size(); ++index) {
+      const base::DictValue* component = (*diagnostics)[index].GetIfDict();
+      ASSERT_TRUE(component);
+      const std::string* key = component->FindString("key");
+      ASSERT_TRUE(key);
+      EXPECT_EQ(kExpectedKeys[index], *key);
+      EXPECT_TRUE(unique_keys.insert(*key).second);
+    }
+
+    const base::DictValue* extension = diagnostics->back().GetIfDict();
+    ASSERT_TRUE(extension);
+    const std::string* status = extension->FindString("status");
+    const std::string* reason = extension->FindString("reason");
+    const std::string* recovery = extension->FindString("next_action");
+    ASSERT_TRUE(status);
+    ASSERT_TRUE(reason);
+    ASSERT_TRUE(recovery);
+    EXPECT_EQ(expected_status, *status);
+    EXPECT_EQ(expected_reason, *reason);
+    EXPECT_LE(reason->size(), kMaxExtensionPolicyReasonBytes);
+    EXPECT_LE(recovery->size(), kMaxExtensionPolicyRecoveryBytes);
+    for (std::string_view sentinel :
+         {"abcdefghijklmnopabcdefghijklmnop",
+          "Installed extension inventory sentinel", "manifest_permissions",
+          "https://private-origin.example", "page-content-sentinel",
+          "form-value-sentinel", "script-source-sentinel",
+          "/Users/private/profile", "browser-session-sentinel",
+          "bearer-authority-sentinel", "Interact"}) {
+      EXPECT_EQ(std::string::npos, response.body.find(sentinel)) << sentinel;
+    }
+  };
+
+  service->SetSystemReadyForTesting(true);
+  expect_extension_health("ready", "extension_policy_ready");
+  service->SetSystemReadyForTesting(false);
+  expect_extension_health("degraded", "extension_system_not_ready");
+  service->Shutdown();
+  expect_extension_health("unavailable", "extension_policy_unavailable");
+}
