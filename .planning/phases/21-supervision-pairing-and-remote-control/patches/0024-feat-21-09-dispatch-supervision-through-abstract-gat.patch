+std::string SerializeSupervisionResponse(
+    const SupervisionTransportResult& result) {
+  auto serialized = SerializeSupervisionDashboardResult(result);
+  if (serialized.has_value()) {
+    return std::move(serialized.value());
+  }
+
+  const SupervisionTransportErrorCode error_code =
+      serialized.error().transport_error ==
+              SupervisionTransportErrorCode::kRequestTooLarge
+          ? SupervisionTransportErrorCode::kRequestTooLarge
+          : SupervisionTransportErrorCode::kOutputNotSanitized;
+  SupervisionTransportResult failure =
+      SupervisionTransportResult::TransportFailure(
+          result.operation, error_code,
+          error_code == SupervisionTransportErrorCode::kRequestTooLarge
+              ? "The supervision result exceeded transport bounds"
+              : "The supervision result was not safe to transport",
+          "Refresh supervision state and retry");
+  serialized = SerializeSupervisionDashboardResult(failure);
+  return serialized.has_value()
+             ? std::move(serialized.value())
+             : R"({"ok":false,"error_code":"OUTPUT_NOT_SANITIZED","message":"The supervision result was not safe to transport","recovery":"Refresh supervision state and retry","operation":"redeem","result":{}})";
+}
+
+SupervisionTransportResult SupervisionUnavailable(
+    SupervisionTransportOperation operation) {
+  return SupervisionTransportResult::TransportFailure(
+      operation, SupervisionTransportErrorCode::kUnavailable,
+      "Supervision is unavailable",
+      "Open a regular Prometheus browser window and retry");
+}
