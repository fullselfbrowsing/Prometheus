   margin: 0;
   overflow-wrap: anywhere;
@@ -547,6 +555,18 @@ textarea {
   color: #f3d18e;
 }
 
+.runtime-task__timeline {
+  color: var(--prometheus-color-text-2);
+  display: grid;
+  gap: 4px;
+  padding-left: 20px;
+}
+
+.runtime-task__timeline time {
