+// Real content::WebContentsObserver used only to learn when a tab this
+// controller opened (the manager or the options page) has finished its
+// initial load. Carries no script/content access of its own.
+class PrometheusExtensionSmokeController::TabLoadWatcher
+    : public content::WebContentsObserver {
+ public:
+  TabLoadWatcher(content::WebContents* web_contents,
+                base::OnceClosure on_stopped_loading)
+      : content::WebContentsObserver(web_contents),
+        on_stopped_loading_(std::move(on_stopped_loading)) {}
+  TabLoadWatcher(const TabLoadWatcher&) = delete;
+  TabLoadWatcher& operator=(const TabLoadWatcher&) = delete;
+  ~TabLoadWatcher() override = default;
+
+  // content::WebContentsObserver:
+  void DidStopLoading() override {
+    if (on_stopped_loading_) {
+      std::move(on_stopped_loading_).Run();
+    }
+  }
+  void WebContentsDestroyed() override {
+    on_stopped_loading_.Reset();
+  }
+
+ private:
+  base::OnceClosure on_stopped_loading_;
+};
