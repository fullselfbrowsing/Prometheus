   if (registry_) {
     registry_->RemoveObserver(this);
     registry_ = nullptr;
@@ -241,12 +242,18 @@ void PrometheusExtensionPolicyService::Shutdown() {
 void PrometheusExtensionPolicyService::OnExtensionLoaded(
     content::BrowserContext* browser_context,
     const extensions::Extension* extension) {
+  if (!IsExpectedRegistryEvent(browser_context, extension)) {
+    return;
+  }
   ReconcileAndNotify();
 }
 
 void PrometheusExtensionPolicyService::OnExtensionReady(
     content::BrowserContext* browser_context,
     const extensions::Extension* extension) {
+  if (!IsExpectedRegistryEvent(browser_context, extension)) {
+    return;
+  }
   ReconcileAndNotify();
 }
 
@@ -254,6 +261,9 @@ void PrometheusExtensionPolicyService::OnExtensionUnloaded(
     content::BrowserContext* browser_context,
     const extensions::Extension* extension,
     extensions::UnloadedExtensionReason reason) {
+  if (!IsExpectedRegistryEvent(browser_context, extension)) {
+    return;
+  }
   ReconcileAndNotify();
 }
 
@@ -261,6 +271,9 @@ void PrometheusExtensionPolicyService::OnExtensionInstalled(
     content::BrowserContext* browser_context,
     const extensions::Extension* extension,
     bool is_update) {
+  if (!IsExpectedRegistryEvent(browser_context, extension)) {
+    return;
+  }
   ReconcileAndNotify();
 }
 
@@ -268,20 +281,22 @@ void PrometheusExtensionPolicyService::OnExtensionUninstalled(
     content::BrowserContext* browser_context,
     const extensions::Extension* extension,
     extensions::UninstallReason reason) {
-  if (!shutdown_ && prefs_ && extension) {
-    RemovePrometheusExtensionPolicyChoice(*prefs_, extension->id());
+  if (!IsExpectedRegistryEvent(browser_context, extension)) {
+    return;
+  }
+  const std::string extension_id = extension->id();
+  if (prefs_) {
+    RemovePrometheusExtensionPolicyChoice(*prefs_, extension_id);
   }
   ReconcileAndNotify();
 }
 
 void PrometheusExtensionPolicyService::OnShutdown(
     extensions::ExtensionRegistry* registry) {
-  if (registry_ != registry) {
+  if (shutdown_ || !registry || registry_ != registry) {
     return;
   }
-  registry_->RemoveObserver(this);
-  registry_ = nullptr;
-  ReconcileAndNotify();
+  Shutdown();
 }
 
 std::vector<ExtensionPolicyInventoryEntry>
@@ -358,6 +373,37 @@ bool PrometheusExtensionPolicyService::IsAllowedContext(
          current_profile->GetOriginalProfile() == regular_profile;
 }
 
+bool PrometheusExtensionPolicyService::IsExpectedRegistryEvent(
+    content::BrowserContext* browser_context,
+    const extensions::Extension* extension) const {
+  return !shutdown_ && extension && browser_context == regular_context_;
+}
+
+void PrometheusExtensionPolicyService::CollapseIneligiblePrivateChoices() {
+  if (!prefs_) {
+    return;
+  }
+  const std::vector<ExtensionPolicyInventoryEntry> inventory = BuildInventory();
+  ExtensionPolicyChoices choices =
+      ReadPrometheusExtensionPolicyChoices(*prefs_);
+  bool changed = false;
+  for (const ExtensionPolicyInventoryEntry& entry : inventory) {
+    if (entry.native_private_eligible) {
+      continue;
+    }
+    const auto choice_it = choices.find(entry.extension_id);
+    if (choice_it == choices.end() ||
+        choice_it->second.private_mode == ExtensionAgentGrant::kBlocked) {
+      continue;
+    }
+    choice_it->second.private_mode = ExtensionAgentGrant::kBlocked;
+    changed = true;
+  }
+  if (changed) {
+    WritePrometheusExtensionPolicyChoices(*prefs_, choices);
+  }
+}
+
 void PrometheusExtensionPolicyService::AdvanceGeneration() {
   ++generation_;
   if (generation_ == 0u) {
@@ -369,15 +415,29 @@ void PrometheusExtensionPolicyService::ReconcileAndNotify() {
   if (shutdown_) {
     return;
   }
-  AdvanceGeneration();
-  const ExtensionPolicySnapshot snapshot = GetSnapshot();
-  for (PrometheusExtensionPolicyServiceObserver& observer : observers_) {
-    observer.OnPrometheusExtensionPolicyChanged(snapshot);
+  if (notifying_observers_) {
+    reconcile_pending_ = true;
+    return;
   }
+
+  do {
+    reconcile_pending_ = false;
+    CollapseIneligiblePrivateChoices();
+    AdvanceGeneration();
+    const ExtensionPolicySnapshot snapshot = GetSnapshot();
+    notifying_observers_ = true;
+    for (PrometheusExtensionPolicyServiceObserver& observer : observers_) {
+      observer.OnPrometheusExtensionPolicyChanged(snapshot);
+      if (shutdown_) {
+        break;
+      }
+    }
+    notifying_observers_ = false;
+  } while (reconcile_pending_ && !shutdown_);
 }
 
 bool ExtensionPolicyLifecycleImplementedForTesting() {
-  return false;
+  return true;
 }
 
 }  // namespace prometheus
