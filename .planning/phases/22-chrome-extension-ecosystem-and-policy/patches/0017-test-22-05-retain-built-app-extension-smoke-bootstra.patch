+
+// Ordered stages of the one-shot built-app extension lifecycle smoke. Each
+// value names the step whose completion advances the controller; the result
+// record's "stage" field is always the last stage the controller reached.
+enum class PrometheusExtensionSmokeStage {
+  kNotStarted,
+  kManagerLoaded,
+  kDeveloperModeEnabled,
+  kLoadUnpackedClicked,
+  kExtensionInstalled,
+  kInspected,
+  kReloaded,
+  kDisabled,
+  kEnabled,
+  kPolicyExercised,
+  kOptionsRoutingChecked,
+  kRemoved,
+  kComplete,
+};
+
+enum class PrometheusExtensionSmokeOutcome {
+  kRunning,
+  kSucceeded,
+  kFailed,
+};
+
+// What the controller's ExtensionRegistryObserver overrides are currently
+// waiting to observe. Distinct from `PrometheusExtensionSmokeStage`, which
+// only ever records the last stage the controller actually *completed*.
+enum class PrometheusExtensionSmokePendingTransition {
+  kNone,
+  kInstall,
+  kReload,
+  kDisable,
+  kEnable,
+  kRemove,
+};
+
+std::string_view PrometheusExtensionSmokeStageToString(
+    PrometheusExtensionSmokeStage stage);
+
+// Owns the one-shot native lifecycle drive over a real chrome://extensions
+// manager tab in the disposable, non-official, test-typed profile the
+// bootstrap validated. Composed exactly once by PrometheusBrowserMainExtraParts
+// after PrometheusExtensionSmokeBootstrap::Create() returns kApplied.
+//
+// This class never calls extensions::UnpackedInstaller, ExtensionRegistrar,
+// or any Extension registry mutation method directly: every lifecycle
+// transition is driven by a real DOM click routed through the ordinary
+// developerPrivate API, and observed only via ExtensionRegistryObserver.
+class PrometheusExtensionSmokeController
+    : public extensions::ExtensionRegistryObserver {
+ public:
+  PrometheusExtensionSmokeController(const PrometheusExtensionSmokeController&) =
+      delete;
+  PrometheusExtensionSmokeController& operator=(
+      const PrometheusExtensionSmokeController&) = delete;
+  ~PrometheusExtensionSmokeController() override;
+
+  // Returns nullptr if `profile` or `browser` is not a live, regular,
+  // non-OTR combination, or if `bootstrap` is null. Ownership of `bootstrap`
+  // transfers to the returned controller.
+  static std::unique_ptr<PrometheusExtensionSmokeController> Create(
+      std::unique_ptr<PrometheusExtensionSmokeBootstrap> bootstrap,
+      Profile* profile,
+      Browser* browser);
+
+  // Idempotent; safe to call multiple times and from the destructor. Removes
+  // any installed chooser factory, stops observing the registry, and writes
+  // a terminal "failed" result if the smoke had not already completed.
+  void Shutdown();
+
+  PrometheusExtensionSmokeOutcome outcome_for_testing() const {
+    return outcome_;
+  }
+  PrometheusExtensionSmokeStage stage_for_testing() const { return stage_; }
+  const std::string& extension_id_for_testing() const {
+    return extension_id_;
+  }
+
+  // extensions::ExtensionRegistryObserver:
+  void OnExtensionLoaded(content::BrowserContext* browser_context,
+                        const extensions::Extension* extension) override;
+  void OnExtensionUnloaded(content::BrowserContext* browser_context,
+                          const extensions::Extension* extension,
+                          extensions::UnloadedExtensionReason reason) override;
+  void OnExtensionUninstalled(content::BrowserContext* browser_context,
+                              const extensions::Extension* extension,
+                              extensions::UninstallReason reason) override;
+  void OnShutdown(extensions::ExtensionRegistry* registry) override;
+
+ private:
+  class OneShotChooser;
+  class OneShotChooserFactory;
+  class TabLoadWatcher;
+
+  PrometheusExtensionSmokeController(
+      std::unique_ptr<PrometheusExtensionSmokeBootstrap> bootstrap,
+      Profile* profile,
+      Browser* browser);
+
+  void Start();
+  void OpenManagerTab();
+  void OnManagerTabWatcherFired();
+  void PollManagerReady(base::TimeTicks deadline);
+  void OnManagerReadyPolled(base::TimeTicks deadline, base::Value result);
+  void ClickDeveloperModeToggle();
+  void PollDeveloperModeReady(base::TimeTicks deadline);
+  void OnDeveloperModeReadyPolled(base::TimeTicks deadline, base::Value result);
+  void ClickLoadUnpacked();
+  void OnChooserInvoked();
+  void OnLoadUnpackedClickIssued(base::Value result);
+  void ArmPendingTransitionTimeout(base::TimeDelta timeout, std::string reason);
+  void OnPendingTransitionTimedOut(int generation, std::string reason);
+  void OnExtensionInstalledObserved(const std::string& extension_id);
+  void AttemptInspect();
+  void OnInspectAttempted(base::Value result);
+  void ClickReload();
+  void OnReloadClickIssued(base::Value result);
+  void ClickDisableToggle();
+  void OnDisableClickIssued(base::Value result);
+  void ClickEnableToggle();
+  void OnEnableClickIssued(base::Value result);
+  void ExercisePolicyGrants();
+  void OpenOptionsTab();
+  void OnOptionsTabWatcherFired();
+  void CheckOptionsRoutingAndBackgroundDenial();
+  void ClickRemove();
+  void OnRemoveClickIssued(base::Value result);
+  void PollRemoveConfirmationReady(base::TimeTicks deadline);
+  void OnExtensionRemovedObserved();
+  void Complete();
+  void Fail(PrometheusExtensionSmokeStage stage_reached, std::string reason);
+  void WriteResult(PrometheusExtensionSmokeOutcome outcome,
+                   std::string reason);
+  content::WebContents* ManagerWebContents() const;
+  content::WebContents* OptionsWebContents() const;
+  void ExecuteInManager(const std::string& script,
+                       base::OnceCallback<void(base::Value)> callback);
+
+  std::unique_ptr<PrometheusExtensionSmokeBootstrap> bootstrap_;
+  raw_ptr<Profile> profile_;
+  raw_ptr<Browser> browser_;
+  base::WeakPtr<content::WebContents> manager_web_contents_;
+  base::WeakPtr<content::WebContents> options_web_contents_;
+  std::unique_ptr<TabLoadWatcher> manager_watcher_;
+  std::unique_ptr<TabLoadWatcher> options_watcher_;
+  base::ScopedObservation<extensions::ExtensionRegistry,
+                          extensions::ExtensionRegistryObserver>
+      registry_observation_{this};
+
+  // Exact values the one-shot chooser (installed immediately before the real
+  // Load-unpacked click) requires of the single dialog request it accepts.
+  // `expected_chooser_caller_` is only ever satisfied by the developer-private
+  // integration's copy of the live, committed chrome://extensions sender URL.
+  std::u16string expected_chooser_title_;
+  gfx::NativeWindow expected_chooser_window_ = gfx::NativeWindow();
+  GURL expected_chooser_caller_;
+
+  PrometheusExtensionSmokeStage stage_ = PrometheusExtensionSmokeStage::kNotStarted;
+  PrometheusExtensionSmokeOutcome outcome_ = PrometheusExtensionSmokeOutcome::kRunning;
+  PrometheusExtensionSmokePendingTransition pending_transition_ =
+      PrometheusExtensionSmokePendingTransition::kNone;
+  std::string extension_id_;
+  int reload_transitions_seen_ = 0;
+  int pending_wait_generation_ = 0;
+  bool awaiting_reload_reload_ = false;
+  bool inspected_ = false;
+  bool policy_default_blocked_ = false;
+  bool policy_read_only_applied_ = false;
+  bool policy_interact_applied_ = false;
+  bool options_routing_visible_ = false;
+  bool background_denied_ = false;
+  bool shutdown_ = false;
+  bool result_written_ = false;
+
+  base::WeakPtrFactory<PrometheusExtensionSmokeController> weak_ptr_factory_{
+      this};
+};
+
+}  // namespace prometheus
