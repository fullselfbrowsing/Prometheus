+      observed->lease.data()->owner_session_id();
+  base::WeakPtr<BrowserWindowInterface> exact_browser = pairing->exact_browser;
+  raw_ptr<tabs::TabInterface> exact_tab = pairing->tab;
+  pending_pairings_.erase(stable_tab_id);
+
+  auto viewer = std::make_unique<ViewerSession>();
+  viewer->dashboard_session = base::UnguessableToken::Create();
+  viewer->stable_tab_id = stable_tab_id;
+  viewer->tab = exact_tab;
+  viewer->exact_browser = std::move(exact_browser);
+  viewer->immutable_owner_session_id = immutable_owner;
+  viewer->client_label = DeriveSupervisionSafeClientLabel(client_label);
+  viewer->connected_at = now;
+  viewer->last_seen_at = now;
+  viewer->expires_at = now + ViewerTtl(limits_);
+
+  result.dashboard_session = viewer->dashboard_session;
+  result.stable_tab_id = stable_tab_id;
+  result.expires_at = viewer->expires_at;
+  viewers_[viewer->dashboard_session] = std::move(viewer);
+  last_pairing_states_[stable_tab_id] = SupervisionPairingState::kRedeemed;
+  AddAudit(stable_tab_id, SupervisionAuditEvent::kDashboardPaired,
+           std::optional<std::string>(
+               viewers_.at(result.dashboard_session)->client_label));
+  AddAudit(stable_tab_id, SupervisionAuditEvent::kViewingStarted,
+           std::optional<std::string>(
+               viewers_.at(result.dashboard_session)->client_label));
+  NotifySnapshotChanged(stable_tab_id);
+
+  static_cast<SupervisionServiceResult&>(result) =
+      SupervisionServiceResult::Success();
   return result;
 }
 
