+RuntimeStoreSnapshot
+PrometheusRuntimeProfileService::GetRuntimeSnapshotForTransport() const {
+  if (owned_runtime_store_) {
+    return owned_runtime_store_->GetSnapshot();
+  }
+  RuntimeStoreSnapshot snapshot;
+  snapshot.tasks.reserve(tasks_.size());
+  for (const auto& [task_id, task] : tasks_) {
+    static_cast<void>(task_id);
+    snapshot.tasks.push_back(RuntimeStoredTask{.snapshot = task.snapshot,
+                                               .generation = task.generation});
+  }
+  return snapshot;
+}
