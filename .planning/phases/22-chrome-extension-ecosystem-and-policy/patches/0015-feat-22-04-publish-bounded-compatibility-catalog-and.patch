+
+// Exact order/spelling required by `controlExtensionCompatibilityCategories`
+// in prometheus_webui.js. The renderer silently drops any row whose
+// `category` does not match one of these five strings, so a spelling drift
+// here would make a whole row vanish from the Control Panel without any
+// visible error.
+constexpr std::array<std::string_view, kExtensionCompatibilityCatalogSize>
+    kExpectedCategoryLabelsInOrder = {
+        "Password manager",
+        "Ad blocker",
+        "Productivity content script",
+        "Side panel and tooling",
+        "Developer extension",
+    };
+
+bool IsLowercaseHexSha256(std::string_view value) {
+  if (value.size() != kExtensionCompatibilitySha256HexLength) {
+    return false;
+  }
+  return std::ranges::all_of(value, [](char character) {
+    return base::IsHexDigit(character) &&
+           (base::IsAsciiDigit(character) || base::IsAsciiLower(character));
+  });
+}
+
+TEST(PrometheusExtensionCompatibilityCatalogTest,
+    HasExactlyFiveRowsWithRequiredUniqueKeysInOrder) {
+  const auto& catalog = GetExtensionCompatibilityCatalog();
+  ASSERT_EQ(kExtensionCompatibilityCatalogSize, catalog.size());
+  for (size_t i = 0; i < catalog.size(); ++i) {
+    EXPECT_EQ(kExpectedCategoryKeysInOrder[i], catalog[i].category_key)
+        << "row " << i;
+    EXPECT_EQ(kExpectedCategoryLabelsInOrder[i], catalog[i].category_label)
+        << "row " << i;
+  }
+
+  std::set<std::string_view> keys;
+  for (const auto& row : catalog) {
+    keys.insert(row.category_key);
+  }
+  EXPECT_EQ(kExtensionCompatibilityCatalogSize, keys.size())
+      << "category keys must be unique";
+}
+
+TEST(PrometheusExtensionCompatibilityCatalogTest, EveryRowIsManifestV3) {
+  for (const auto& row : GetExtensionCompatibilityCatalog()) {
+    EXPECT_EQ(3, row.manifest_version) << row.category_key;
+  }
+}
+
+TEST(PrometheusExtensionCompatibilityCatalogTest,
+    EveryRowUsesTheClosedVerifiedResultVocabulary) {
+  for (const auto& row : GetExtensionCompatibilityCatalog()) {
+    const std::string_view result_string =
+        ExtensionCompatibilityResultToString(row.result);
+    EXPECT_TRUE(result_string == "Verified" || result_string == "Degraded" ||
+               result_string == "Unsupported")
+        << row.category_key;
+    ASSERT_TRUE(ExtensionCompatibilityResultFromString(result_string)
+                    .has_value());
+    EXPECT_EQ(row.result,
+             *ExtensionCompatibilityResultFromString(result_string));
+  }
+}
+
+TEST(PrometheusExtensionCompatibilityCatalogTest,
+    ResultFromStringRejectsUnknownAndCaseVariantValues) {
+  EXPECT_FALSE(ExtensionCompatibilityResultFromString("").has_value());
+  EXPECT_FALSE(ExtensionCompatibilityResultFromString("verified").has_value());
+  EXPECT_FALSE(ExtensionCompatibilityResultFromString("supported").has_value());
+  EXPECT_FALSE(
+      ExtensionCompatibilityResultFromString("Chrome-compatible").has_value());
+}
+
+TEST(PrometheusExtensionCompatibilityCatalogTest,
+    FixtureHashesAreValidLowercaseHexSha256) {
+  for (const auto& row : GetExtensionCompatibilityCatalog()) {
+    EXPECT_TRUE(IsLowercaseHexSha256(row.fixture_sha256))
+        << row.category_key << ": " << row.fixture_sha256;
+  }
+}
+
+TEST(PrometheusExtensionCompatibilityCatalogTest,
+    EveryRowHasNonEmptyBoundedEvidenceFields) {
+  for (const auto& row : GetExtensionCompatibilityCatalog()) {
+    EXPECT_FALSE(row.fixture_name.empty());
+    EXPECT_FALSE(row.fixture_version.empty());
+    EXPECT_FALSE(row.install_source.empty());
+    EXPECT_FALSE(row.prometheus_build.empty());
+    EXPECT_FALSE(row.chromium_revision.empty());
+    EXPECT_FALSE(row.actions_exercised.empty());
+    EXPECT_FALSE(row.limitation.empty());
+    EXPECT_FALSE(row.last_verified.empty());
+    ASSERT_FALSE(row.evidence_artifact.empty());
+    EXPECT_NE(std::string_view::npos,
+             row.evidence_artifact.find(
+                 "prometheus_extension_fixtures_browsertest.cc:"
+                 "PrometheusExtensionFixturesBrowserTest."))
+        << row.evidence_artifact;
+  }
+
+  std::set<std::string_view> evidence_artifacts;
+  for (const auto& row : GetExtensionCompatibilityCatalog()) {
+    evidence_artifacts.insert(row.evidence_artifact);
+  }
+  EXPECT_EQ(kExtensionCompatibilityCatalogSize, evidence_artifacts.size())
+      << "every row must point at a distinct retained test";
+}
+
+TEST(PrometheusExtensionCompatibilityCatalogTest,
+    OnlyTheAdBlockerRowExercisesAnExplicitPrivateModeCheck) {
+  for (const auto& row : GetExtensionCompatibilityCatalog()) {
+    EXPECT_TRUE(row.regular_mode_exercised) << row.category_key;
+    const bool expect_private = row.category_key == "ad_blocker";
+    EXPECT_EQ(expect_private, row.private_mode_exercised) << row.category_key;
+  }
+}
+
+TEST(PrometheusExtensionCompatibilityCatalogTest,
+    NoRowTextClaimsWebStoreOrManifestV2Support) {
+  static constexpr std::array<std::string_view, 4> kForbiddenSubstrings = {
+      "Web Store", "web store", "Manifest V2", "manifest_version 2",
+  };
+  for (const auto& row : GetExtensionCompatibilityCatalog()) {
+    for (std::string_view forbidden : kForbiddenSubstrings) {
+      EXPECT_EQ(std::string_view::npos,
+               row.actions_exercised.find(forbidden))
+          << row.category_key << " actions_exercised contains " << forbidden;
+      EXPECT_EQ(std::string_view::npos, row.limitation.find(forbidden))
+          << row.category_key << " limitation contains " << forbidden;
+      EXPECT_EQ(std::string_view::npos, row.install_source.find(forbidden))
+          << row.category_key << " install_source contains " << forbidden;
+    }
+  }
+}
+
+TEST(PrometheusExtensionCompatibilityCatalogTest,
+    IsClosedExtensionCompatibilityCatalogAcceptsTheRealCatalog) {
+  EXPECT_TRUE(IsClosedExtensionCompatibilityCatalog());
+}
+
+TEST(PrometheusExtensionCompatibilityCatalogTest,
+    RowToValueProjectsExactlyTheBoundedWebUiShapeWithNoRawHash) {
+  const auto& catalog = GetExtensionCompatibilityCatalog();
+  ASSERT_FALSE(catalog.empty());
+  const base::DictValue value = ExtensionCompatibilityRowToValue(catalog[0]);
+
+  static constexpr std::array<std::string_view, 9> kExpectedKeys = {
+      "category", "status",   "fixture",       "manifest", "source",
+      "behaviors", "revision", "last_verified", "limitation",
+  };
+  EXPECT_EQ(kExpectedKeys.size(), value.size());
+  for (std::string_view key : kExpectedKeys) {
+    EXPECT_TRUE(value.contains(key)) << key;
+  }
+
+  EXPECT_EQ("Password manager", *value.FindString("category"));
+  EXPECT_EQ("verified", *value.FindString("status"));
+  EXPECT_EQ("Manifest V3", *value.FindString("manifest"));
+
+  for (const auto [key, entry] : value) {
+    ASSERT_TRUE(entry.is_string()) << key;
+    const std::string& rendered = entry.GetString();
+    EXPECT_EQ(std::string::npos, rendered.find(catalog[0].fixture_sha256))
+        << key << " leaked the raw fixture SHA-256 into the WebUI dict";
+  }
+}
+
+TEST(PrometheusExtensionCompatibilityCatalogTest,
+    RowToValueLowercasesEveryClosedResultForTheExistingRenderer) {
+  for (const auto& row : GetExtensionCompatibilityCatalog()) {
+    const base::DictValue value = ExtensionCompatibilityRowToValue(row);
+    const std::string* status = value.FindString("status");
+    ASSERT_TRUE(status);
+    EXPECT_TRUE(*status == "verified" || *status == "degraded" ||
+               *status == "unsupported")
+        << row.category_key << ": " << *status;
+    EXPECT_EQ(base::ToLowerASCII(*status), *status);
+  }
+}
+
+// Regression guard: prometheus_webui.js's `controlExtensionText` bounds the
+// projected `limitation` field at 160 bytes and silently substitutes a
+// generic placeholder ("Representative compatibility evidence has not run
+// in this build.") whenever a row exceeds that bound -- there is no runtime
+// error, so an over-length row fails only visually. Assert the exact
+// projected value directly instead of only its length, so a future
+// oversized edit is caught here rather than by manually inspecting the
+// rendered Control Panel.
+TEST(PrometheusExtensionCompatibilityCatalogTest,
+    ProjectedLimitationStaysUnderTheWebUiRendererByteBudget) {
+  constexpr size_t kWebUiLimitationByteBudget = 160;
+  for (const auto& row : GetExtensionCompatibilityCatalog()) {
+    const base::DictValue value = ExtensionCompatibilityRowToValue(row);
+    const std::string* limitation = value.FindString("limitation");
+    ASSERT_TRUE(limitation);
+    EXPECT_LE(limitation->size(), kWebUiLimitationByteBudget)
+        << row.category_key << ": \"" << *limitation << "\" ("
+        << limitation->size() << " bytes)";
+    EXPECT_NE(*limitation,
+             "Representative compatibility evidence has not run in this "
+             "build.")
+        << row.category_key
+        << " rendered the WebUI's over-length fallback placeholder";
+  }
+}
