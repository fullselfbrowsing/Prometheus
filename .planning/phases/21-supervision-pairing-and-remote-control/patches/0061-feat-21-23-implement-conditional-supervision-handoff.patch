+class ScopedStringWiper {
+ public:
+  ScopedStringWiper(
+      std::string* value,
+      PrometheusSupervisionTestBootstrap::ZeroizationCallback zeroization)
+      : value_(value), zeroization_(std::move(zeroization)) {}
+  ~ScopedStringWiper() {
+    if (!value_ || value_->empty()) {
+      return;
+    }
+    const size_t bytes = value_->size();
+    crypto::SecureZeroBuffer(base::as_writable_byte_span(*value_));
+    value_->clear();
+    if (zeroization_) {
+      zeroization_.Run("bootstrap_config", bytes);
+    }
+  }
+
+ private:
+  raw_ptr<std::string> value_;
+  PrometheusSupervisionTestBootstrap::ZeroizationCallback zeroization_;
+};
