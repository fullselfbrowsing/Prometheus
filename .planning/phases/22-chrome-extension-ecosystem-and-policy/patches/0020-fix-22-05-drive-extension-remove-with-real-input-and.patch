+// Widget name of the real native uninstall confirmation dialog. Set as the
+// ui::DialogModel internal name in
+// chrome/browser/ui/extensions/extension_uninstall_dialog_impl.cc
+// (`dialog_builder.SetInternalName("ExtensionUninstallDialog")`), which
