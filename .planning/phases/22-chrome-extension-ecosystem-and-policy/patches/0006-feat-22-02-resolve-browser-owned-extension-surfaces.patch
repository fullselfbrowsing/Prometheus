 namespace prometheus {
 namespace {
 
+struct BrowserOwnedCandidate {
+  raw_ptr<content::WebContents> web_contents = nullptr;
+  std::string ui_extension_id;
+  PrometheusExtensionObservedContext observed_context =
+      PrometheusExtensionObservedContext::kUnknown;
+  bool visible = false;
+  bool exact_browser = true;
+  bool ui_owned = false;
+};
+
 PrometheusExtensionSurfaceClassification Deny(
     PrometheusExtensionSurfaceDenial denial,
     AgentErrorCode error_code) {
@@ -24,6 +65,140 @@ PrometheusExtensionSurfaceClassification Accept(
           .error_code = AgentErrorCode::kNone};
 }
 
+AgentRouteResult SurfaceFailure(
+    const PrometheusExtensionSurfaceClassification& classification) {
+  if (classification.error_code == AgentErrorCode::kStaleTarget) {
+    return AgentRouteResult::Failure(
+        AgentErrorCode::kStaleTarget,
+        "The selected extension surface changed before it could be used",
+        "Reopen the extension surface and retry with its stable tab id");
+  }
+  return AgentRouteResult::Failure(
+      AgentErrorCode::kInvalidTarget,
+      "The selected extension surface is not a current visible browser view",
+      "Show the extension tab, popup, or side panel and retry");
+}
+
+PrometheusExtensionObservedContext ObservedContextForViewType(
+    extensions::mojom::ViewType view_type) {
+  switch (view_type) {
+    case extensions::mojom::ViewType::kTabContents:
+      return PrometheusExtensionObservedContext::kTabContents;
+    case extensions::mojom::ViewType::kExtensionPopup:
+      return PrometheusExtensionObservedContext::kPopup;
+    case extensions::mojom::ViewType::kExtensionSidePanel:
+      return PrometheusExtensionObservedContext::kSidePanel;
+    case extensions::mojom::ViewType::kExtensionGuest:
+      return PrometheusExtensionObservedContext::kOptionsGuest;
+    case extensions::mojom::ViewType::kExtensionBackgroundPage:
+      return PrometheusExtensionObservedContext::kBackgroundPage;
+    case extensions::mojom::ViewType::kBackgroundContents:
+      return PrometheusExtensionObservedContext::kBackgroundContents;
+    case extensions::mojom::ViewType::kOffscreenDocument:
+      return PrometheusExtensionObservedContext::kOffscreenDocument;
+    case extensions::mojom::ViewType::kDeveloperTools:
+      return PrometheusExtensionObservedContext::kDeveloperTools;
+    case extensions::mojom::ViewType::kInvalid:
+    case extensions::mojom::ViewType::kAppWindow:
+    case extensions::mojom::ViewType::kComponent:
+      return PrometheusExtensionObservedContext::kUnknown;
+  }
+}
+
+void AddShownSidePanelCandidate(
+    SidePanelRegistry* registry,
+    extensions::ExtensionSidePanelManager* manager,
+    SidePanelUI* side_panel_ui,
+    bool for_tab,
+    std::vector<BrowserOwnedCandidate>* candidates) {
+  if (!registry || !manager || !side_panel_ui) {
+    return;
+  }
+  std::optional<SidePanelEntry*> active = registry->GetActiveEntry();
+  if (!active.has_value() || !*active ||
+      (*active)->key().id() != SidePanelEntry::Id::kExtension ||
+      !(*active)->key().extension_id().has_value() ||
+      !side_panel_ui->IsSidePanelEntryShowing((*active)->key(), for_tab)) {
+    return;
+  }
+  const extensions::ExtensionId extension_id =
+      *(*active)->key().extension_id();
+  extensions::ExtensionSidePanelCoordinator* coordinator =
+      manager->GetExtensionCoordinator(extension_id);
+  if (!coordinator) {
+    return;
+  }
+  content::WebContents* contents = coordinator->GetHostWebContents();
+  if (!contents) {
+    return;
+  }
+  candidates->push_back(
+      {.web_contents = contents,
+       .ui_extension_id = extension_id,
+       .observed_context =
+           PrometheusExtensionObservedContext::kSidePanel,
+       .visible = true,
+       .exact_browser = true,
+       .ui_owned = true});
+}
+
+std::vector<BrowserOwnedCandidate> SelectCandidates(
+    Browser* browser,
+    tabs::TabInterface* anchor_tab,
+    std::optional<AgentExtensionSurfaceSelector> selector) {
+  std::vector<BrowserOwnedCandidate> candidates;
+  if (!selector.has_value()) {
+    content::WebContents* contents = anchor_tab->GetContents();
+    if (contents) {
+      candidates.push_back(
+          {.web_contents = contents,
+           .observed_context = ObservedContextForViewType(
+               extensions::GetViewType(contents->GetPrimaryMainFrame())),
+           .visible =
+               anchor_tab->IsActivated() &&
+               contents->GetVisibility() == content::Visibility::VISIBLE,
+           .exact_browser =
+               anchor_tab->GetBrowserWindowInterface() == browser,
+           .ui_owned = anchor_tab->IsActivated()});
+    }
+    return candidates;
+  }
+
+  if (!anchor_tab->IsActivated() ||
+      anchor_tab->GetBrowserWindowInterface() != browser) {
+    return candidates;
+  }
+
+  if (*selector == AgentExtensionSurfaceSelector::kPopup) {
+    for (ExtensionPopup* popup :
+         ExtensionPopup::GetVisiblePopupsForBrowser(browser)) {
+      extensions::ExtensionViewHost* host = popup->host();
+      if (!host || !host->host_contents()) {
+        continue;
+      }
+      candidates.push_back(
+          {.web_contents = host->host_contents(),
+           .ui_extension_id = host->extension_id(),
+           .observed_context = PrometheusExtensionObservedContext::kPopup,
+           .visible = true,
+           .exact_browser = true,
+           .ui_owned = true});
+    }
+    return candidates;
+  }
+
+  SidePanelUI* side_panel_ui = browser->GetFeatures().side_panel_ui();
+  AddShownSidePanelCandidate(
+      SidePanelRegistry::From(browser),
+      browser->GetFeatures().extension_side_panel_manager(), side_panel_ui,
+      /*for_tab=*/false, &candidates);
+  AddShownSidePanelCandidate(
+      SidePanelRegistry::From(anchor_tab),
+      anchor_tab->GetTabFeatures()->extension_side_panel_manager(),
+      side_panel_ui, /*for_tab=*/true, &candidates);
+  return candidates;
+}
+
 }  // namespace
 
 PrometheusExtensionSurfaceResolver::PrometheusExtensionSurfaceResolver(
@@ -39,14 +214,145 @@ PrometheusExtensionSurfaceResolver::Resolve(
     tabs::TabInterface* anchor_tab,
     std::optional<AgentExtensionSurfaceSelector> selector,
     std::optional<uint64_t> expected_policy_generation) const {
-  static_cast<void>(browser);
-  static_cast<void>(anchor_tab);
-  static_cast<void>(selector);
-  static_cast<void>(expected_policy_generation);
-  return base::unexpected(AgentRouteResult::Failure(
-      AgentErrorCode::kInvalidTarget,
-      "The selected extension surface is not available",
-      "Show the extension surface in the selected tab and retry"));
+  if (!browser || !anchor_tab || !policy_service_) {
+    return base::unexpected(AgentRouteResult::Failure(
+        AgentErrorCode::kInvalidTarget,
+        "The extension surface has no current browser owner",
+        "Choose a visible extension surface in the selected browser"));
+  }
+
+  Profile* profile = browser->profile();
+  PrometheusExtensionSurfaceEvidence evidence;
+  evidence.selector = selector;
+  evidence.expected_policy_generation = expected_policy_generation;
+  evidence.exact_browser =
+      anchor_tab->GetBrowserWindowInterface() == browser;
+  evidence.exact_browser_context =
+      anchor_tab->GetProfile() == profile;
+
+  std::vector<BrowserOwnedCandidate> candidates =
+      SelectCandidates(browser, anchor_tab, selector);
+  evidence.selector_match_count = candidates.size();
+  if (selector.has_value() && candidates.size() != 1u) {
+    const auto classification = ClassifyEvidenceForTesting(evidence);
+    return base::unexpected(SurfaceFailure(classification));
+  }
+  if (candidates.size() != 1u || !candidates.front().web_contents) {
+    return base::unexpected(AgentRouteResult::Failure(
+        AgentErrorCode::kInvalidTarget,
+        "The extension target does not identify one current browser view",
+        "Choose one visible extension tab, popup, or side panel"));
+  }
+
+  const BrowserOwnedCandidate& candidate = candidates.front();
+  content::WebContents* web_contents = candidate.web_contents;
+  content::RenderFrameHost* primary_frame =
+      web_contents->GetPrimaryMainFrame();
+  evidence.observed_context = candidate.observed_context;
+  evidence.exact_browser =
+      evidence.exact_browser && candidate.exact_browser;
+  evidence.exact_browser_context =
+      evidence.exact_browser_context &&
+      web_contents->GetBrowserContext() == profile;
+  evidence.visible =
+      candidate.visible &&
+      web_contents->GetVisibility() == content::Visibility::VISIBLE;
+  evidence.browser_ui_owned = candidate.ui_owned;
+  evidence.primary_frame_committed =
+      primary_frame && primary_frame->IsRenderFrameLive() &&
+      !primary_frame->GetLastCommittedOrigin().opaque();
+
+  std::string extension_id;
+  if (evidence.primary_frame_committed) {
+    const url::Origin& committed_origin =
+        primary_frame->GetLastCommittedOrigin();
+    evidence.extension_origin =
+        committed_origin.scheme() == extensions::kExtensionScheme;
+    extension_id = committed_origin.host();
+    evidence.origin_matches_browser_identity =
+        evidence.extension_origin &&
+        crx_file::id_util::IdIsValid(extension_id) &&
+        (candidate.ui_extension_id.empty() ||
+         candidate.ui_extension_id == extension_id);
+  } else {
+    evidence.extension_origin = false;
+    evidence.origin_matches_browser_identity = false;
+  }
+
+  extensions::ExtensionSystem* extension_system =
+      extensions::ExtensionSystem::Get(profile);
+  evidence.extension_system_ready =
+      extension_system && extension_system->is_ready();
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(profile);
+  const extensions::Extension* installed_extension =
+      registry && !extension_id.empty()
+          ? registry->GetInstalledExtension(extension_id)
+          : nullptr;
+  const extensions::Extension* enabled_extension =
+      registry && !extension_id.empty()
+          ? registry->enabled_extensions().GetByID(extension_id)
+          : nullptr;
+  evidence.lifecycle_alive = installed_extension != nullptr;
+  evidence.extension_enabled =
+      enabled_extension &&
+      registry->ready_extensions().GetByID(extension_id);
+  evidence.extension_terminated =
+      registry && registry->terminated_extensions().GetByID(extension_id);
+
+  if (primary_frame && selector.has_value()) {
+    extensions::ExtensionHostRegistry* host_registry =
+        extensions::ExtensionHostRegistry::Get(profile);
+    extensions::ExtensionHost* host =
+        host_registry
+            ? host_registry->GetExtensionHostForPrimaryMainFrame(primary_frame)
+            : nullptr;
+    evidence.browser_ui_owned =
+        evidence.browser_ui_owned && host &&
+        host->host_contents() == web_contents &&
+        host->browser_context() == profile &&
+        host->extension_id() == extension_id;
+  }
+
+  if (primary_frame &&
+      evidence.observed_context ==
+          PrometheusExtensionObservedContext::kOptionsGuest) {
+    guest_view::GuestViewBase* guest =
+        guest_view::GuestViewBase::FromRenderFrameHost(primary_frame);
+    evidence.options_guest_primary_frame =
+        primary_frame == web_contents->GetPrimaryMainFrame();
+    evidence.options_guest_ambiguous =
+        !guest ||
+        guest->GetViewType() != extensions::ExtensionOptionsGuest::Type;
+    evidence.browser_ui_owned =
+        evidence.browser_ui_owned && guest && guest->attached() &&
+        guest->owner_web_contents() == anchor_tab->GetContents();
+  }
+
+  if (enabled_extension &&
+      evidence.observed_context ==
+          PrometheusExtensionObservedContext::kTabContents) {
+    evidence.options_page =
+        extensions::OptionsPageInfo::GetOptionsPage(enabled_extension) ==
+        web_contents->GetLastCommittedURL();
+  }
+
+  const ExtensionPolicySnapshot snapshot = policy_service_->GetSnapshot();
+  evidence.policy_generation = snapshot.generation;
+  const auto classification = ClassifyEvidenceForTesting(evidence);
+  if (!classification.accepted()) {
+    return base::unexpected(SurfaceFailure(classification));
+  }
+
+  PrometheusResolvedExtensionSurface resolved;
+  resolved.extension_id = std::move(extension_id);
+  resolved.kind = *classification.kind;
+  resolved.policy_generation = snapshot.generation;
+  resolved.private_mode = profile->IsOffTheRecord();
+  resolved.anchor_tab = anchor_tab->GetWeakPtr();
+  resolved.web_contents = web_contents->GetWeakPtr();
+  resolved.primary_frame_id = primary_frame->GetGlobalId();
+  return resolved;
 }
 
 // static
@@ -146,7 +452,7 @@ PrometheusExtensionSurfaceResolver::ClassifyEvidenceForTesting(
 }
 
 bool ExtensionSurfaceResolutionContractImplementedForTesting() {
-  return false;
+  return true;
 }
 
 }  // namespace prometheus
