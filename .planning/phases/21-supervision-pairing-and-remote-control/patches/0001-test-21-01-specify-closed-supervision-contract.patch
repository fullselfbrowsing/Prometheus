+++ b/chrome/browser/prometheus/prometheus_supervision_types_unittest.cc
@@ -0,0 +1,590 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_supervision_types.h"
+
+#include <array>
+#include <initializer_list>
+#include <limits>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/json/json_writer.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace prometheus {
+
+namespace {
+
+class PrometheusSupervisionTypesTest : public testing::Test {};
+
+template <typename Enum>
+void ExpectRoundTrips(
+    std::initializer_list<std::pair<std::string_view, Enum>> cases,
+    std::optional<Enum> (*from_string)(std::string_view),
+    std::optional<std::string_view> (*to_string)(Enum)) {
+  for (const auto& [name, value] : cases) {
+    SCOPED_TRACE(name);
+    EXPECT_EQ(value, from_string(name));
+    EXPECT_EQ(name, to_string(value));
+  }
+}
+
+constexpr std::array kPairingStates = {
+    SupervisionPairingState::kPending,    SupervisionPairingState::kRedeemed,
+    SupervisionPairingState::kCancelled,  SupervisionPairingState::kExpired,
+    SupervisionPairingState::kTargetLost,
+};
+
+constexpr std::array kViewerStates = {
+    SupervisionViewerState::kViewOnly,
+    SupervisionViewerState::kController,
+    SupervisionViewerState::kExpired,
+    SupervisionViewerState::kRevoked,
+    SupervisionViewerState::kTargetClosed,
+    SupervisionViewerState::kAuthorityLost,
+    SupervisionViewerState::kEnded,
+};
+
+constexpr std::array kStreamStates = {
+    SupervisionStreamState::kPreparingBaseline,
+    SupervisionStreamState::kLive,
+    SupervisionStreamState::kResyncing,
+    SupervisionStreamState::kPaused,
+    SupervisionStreamState::kEnded,
+};
+
+constexpr std::array kActionStates = {
+    SupervisionRemoteActionState::kIdle,
+    SupervisionRemoteActionState::kValidating,
+    SupervisionRemoteActionState::kExecuting,
+    SupervisionRemoteActionState::kAwaitingConfirmation,
+    SupervisionRemoteActionState::kVerifying,
+    SupervisionRemoteActionState::kCompleted,
+    SupervisionRemoteActionState::kBlocked,
+    SupervisionRemoteActionState::kFailed,
+};
+
+bool ExpectedPairingTransition(SupervisionPairingState from,
+                               SupervisionPairingState to) {
+  return from == SupervisionPairingState::kPending &&
+         (to == SupervisionPairingState::kRedeemed ||
+          to == SupervisionPairingState::kCancelled ||
+          to == SupervisionPairingState::kExpired ||
+          to == SupervisionPairingState::kTargetLost);
+}
+
+bool ExpectedViewerTransition(SupervisionViewerState from,
+                              SupervisionViewerState to) {
+  if (from == SupervisionViewerState::kViewOnly) {
+    return to == SupervisionViewerState::kController ||
+           to == SupervisionViewerState::kExpired ||
+           to == SupervisionViewerState::kRevoked ||
+           to == SupervisionViewerState::kTargetClosed ||
+           to == SupervisionViewerState::kAuthorityLost ||
+           to == SupervisionViewerState::kEnded;
+  }
+  if (from == SupervisionViewerState::kController) {
+    return to == SupervisionViewerState::kViewOnly ||
+           to == SupervisionViewerState::kExpired ||
+           to == SupervisionViewerState::kRevoked ||
+           to == SupervisionViewerState::kTargetClosed ||
+           to == SupervisionViewerState::kAuthorityLost ||
+           to == SupervisionViewerState::kEnded;
+  }
+  return false;
+}
+
+bool ExpectedStreamTransition(SupervisionStreamState from,
+                              SupervisionStreamState to) {
+  switch (from) {
+    case SupervisionStreamState::kPreparingBaseline:
+      return to == SupervisionStreamState::kLive ||
+             to == SupervisionStreamState::kResyncing ||
+             to == SupervisionStreamState::kPaused ||
+             to == SupervisionStreamState::kEnded;
+    case SupervisionStreamState::kLive:
+      return to == SupervisionStreamState::kResyncing ||
+             to == SupervisionStreamState::kPaused ||
+             to == SupervisionStreamState::kEnded;
+    case SupervisionStreamState::kResyncing:
+      return to == SupervisionStreamState::kLive ||
+             to == SupervisionStreamState::kPaused ||
+             to == SupervisionStreamState::kEnded;
+    case SupervisionStreamState::kPaused:
+      return to == SupervisionStreamState::kResyncing ||
+             to == SupervisionStreamState::kEnded;
+    case SupervisionStreamState::kEnded:
+      return false;
+  }
+}
+
+bool ExpectedActionTransition(SupervisionRemoteActionState from,
+                              SupervisionRemoteActionState to) {
+  switch (from) {
+    case SupervisionRemoteActionState::kIdle:
+      return to == SupervisionRemoteActionState::kValidating;
+    case SupervisionRemoteActionState::kValidating:
+      return to == SupervisionRemoteActionState::kExecuting ||
+             to == SupervisionRemoteActionState::kAwaitingConfirmation ||
+             to == SupervisionRemoteActionState::kBlocked ||
+             to == SupervisionRemoteActionState::kFailed;
+    case SupervisionRemoteActionState::kAwaitingConfirmation:
+      return to == SupervisionRemoteActionState::kExecuting ||
+             to == SupervisionRemoteActionState::kBlocked ||
+             to == SupervisionRemoteActionState::kFailed;
+    case SupervisionRemoteActionState::kExecuting:
+      return to == SupervisionRemoteActionState::kVerifying ||
+             to == SupervisionRemoteActionState::kCompleted ||
+             to == SupervisionRemoteActionState::kBlocked ||
+             to == SupervisionRemoteActionState::kFailed;
+    case SupervisionRemoteActionState::kVerifying:
+      return to == SupervisionRemoteActionState::kCompleted ||
+             to == SupervisionRemoteActionState::kBlocked ||
+             to == SupervisionRemoteActionState::kFailed;
+    case SupervisionRemoteActionState::kCompleted:
+    case SupervisionRemoteActionState::kBlocked:
+    case SupervisionRemoteActionState::kFailed:
+      return false;
+  }
+}
