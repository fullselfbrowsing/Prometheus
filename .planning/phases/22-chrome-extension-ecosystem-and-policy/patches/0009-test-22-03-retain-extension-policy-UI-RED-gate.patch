+    EXPECT_EQ(std::string::npos, serialized.find(sentinel)) << sentinel;
+  }
+  EXPECT_TRUE(content::EvalJs(contents, R"(
+    (() => {
+      const policy = document.querySelector('#control-extension-policy');
+      const radios = Array.from(policy.querySelectorAll('[role="radio"]'));
+      const live = policy.querySelector(
+          '#control-extension-policy-operation[aria-live="polite"]');
+      const manage = policy.querySelector('#control-manage-extensions');
+      const firstRow = policy.querySelector('[role="option"]');
