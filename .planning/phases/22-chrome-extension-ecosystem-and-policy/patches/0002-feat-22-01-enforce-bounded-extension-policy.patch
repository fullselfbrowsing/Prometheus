 ExtensionAgentGrant PrometheusExtensionPolicyService::GetEffectiveGrant(
     std::string_view extension_id,
     content::BrowserContext* current_context,
     bool private_mode) const {
-  return ExtensionAgentGrant::kBlocked;
+  if (shutdown_ || !prefs_ || !IsSystemReady() ||
+      !IsAllowedContext(current_context, private_mode)) {
+    return ExtensionAgentGrant::kBlocked;
+  }
+
+  const std::vector<ExtensionPolicyInventoryEntry> inventory = BuildInventory();
+  const auto entry_it = std::ranges::find(
+      inventory, extension_id, &ExtensionPolicyInventoryEntry::extension_id);
+  if (entry_it == inventory.end() || !entry_it->enabled || !entry_it->ready ||
+      entry_it->browser_context != regular_context_) {
+    return ExtensionAgentGrant::kBlocked;
+  }
+
+  const ExtensionPolicyChoices choices =
+      ReadPrometheusExtensionPolicyChoices(*prefs_);
+  const auto choice_it = choices.find(extension_id);
+  if (choice_it == choices.end()) {
+    return ExtensionAgentGrant::kBlocked;
+  }
+  if (!private_mode) {
+    return choice_it->second.regular;
+  }
+  if (!entry_it->native_private_eligible) {
+    return ExtensionAgentGrant::kBlocked;
+  }
+  return ClampPrivateExtensionGrant(choice_it->second.regular,
+                                    choice_it->second.private_mode);
 }
 
