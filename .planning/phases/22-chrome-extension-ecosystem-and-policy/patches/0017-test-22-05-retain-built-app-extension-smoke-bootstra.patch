+PrometheusExtensionSmokeController::PrometheusExtensionSmokeController(
+    std::unique_ptr<PrometheusExtensionSmokeBootstrap> bootstrap,
+    Profile* profile,
+    Browser* browser)
+    : bootstrap_(std::move(bootstrap)), profile_(profile), browser_(browser) {
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(profile_);
+  if (registry) {
+    registry_observation_.Observe(registry);
+  }
