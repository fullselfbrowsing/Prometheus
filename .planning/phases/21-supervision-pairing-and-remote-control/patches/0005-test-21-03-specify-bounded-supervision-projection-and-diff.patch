index 0000000000..467c866810
--- /dev/null
+++ b/chrome/browser/prometheus/prometheus_supervision_projection.h
@@ -0,0 +1,71 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PROMETHEUS_PROMETHEUS_SUPERVISION_PROJECTION_H_
+#define CHROME_BROWSER_PROMETHEUS_PROMETHEUS_SUPERVISION_PROJECTION_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "chrome/browser/prometheus/prometheus_supervision_types.h"
+
+namespace optimization_guide::proto {
+class AnnotatedPageContent;
+}  // namespace optimization_guide::proto
+
+namespace prometheus {
+
+enum class SupervisionProjectionState {
+  kAuthoritative,
+  kNeedsBaseline,
+};
+
+// One privacy-filtered APC node. `ref` is stable only for the lifetime of its
+// document and `parent_ref` is empty only for an emitted root.
+struct SupervisionNormalizedNode {
+  std::string ref;
+  std::string parent_ref;
+  std::vector<std::string> child_refs;
+  std::string tag;
+  std::string role;
+  std::string name;
+  std::string text_snippet;
+  bool disabled = false;
+  bool focusable = false;
+  bool clickable = false;
+  std::optional<std::string> input_value;
+  std::optional<std::string> input_type;
+  std::optional<bool> checked;
+  bool required = false;
+  bool readonly = false;
+  bool frame_restricted = false;
+  std::string frame_restricted_reason;
+
+  bool operator==(const SupervisionNormalizedNode&) const = default;
+};
+
+// An authoritative baseline is all-or-nothing. A cap, malformed ref, duplicate
+// ref, unknown document, or traversal overflow returns kNeedsBaseline with no
+// nodes and no plausible serialized payload.
+struct SupervisionBaseline {
+  SupervisionProjectionState state = SupervisionProjectionState::kNeedsBaseline;
+  std::vector<SupervisionNormalizedNode> nodes;
+  std::string serialized_json;
+
+  bool authoritative() const {
+    return state == SupervisionProjectionState::kAuthoritative;
+  }
+
+  bool operator==(const SupervisionBaseline&) const = default;
+};
+
+SupervisionBaseline BuildSupervisionBaseline(
+    const optimization_guide::proto::AnnotatedPageContent& page_content,
+    const std::string& primary_document_token,
+    const SupervisionLimits& limits = SupervisionLimits());
+
+}  // namespace prometheus
