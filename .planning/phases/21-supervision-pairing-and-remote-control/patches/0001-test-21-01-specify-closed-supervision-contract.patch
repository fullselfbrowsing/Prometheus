+TEST_F(PrometheusSupervisionTypesTest,
+       ValidatesCodeStampGenerationAndSequenceWithoutWrap) {
+  EXPECT_TRUE(IsValidSupervisionPairingCode("ABCDEFGH"));
+  EXPECT_TRUE(IsValidSupervisionPairingCode("23456789"));
+  EXPECT_FALSE(IsValidSupervisionPairingCode("ABC-DEFG"));
+  EXPECT_FALSE(IsValidSupervisionPairingCode("ABCI0O1Z"));
+  EXPECT_FALSE(IsValidSupervisionPairingCode("abcdefg2"));
+
+  SupervisionStreamStamp stamp{
+      .session = base::UnguessableToken::Create(),
+      .stable_tab_id = 7,
+      .document_epoch = base::UnguessableToken::Create(),
+      .sequence = 1,
+  };
+  EXPECT_TRUE(IsValidSupervisionStreamStamp(stamp));
+  stamp.sequence = 0;
+  EXPECT_FALSE(IsValidSupervisionStreamStamp(stamp));
+  stamp.sequence = 1;
+  stamp.stable_tab_id = 0;
+  EXPECT_FALSE(IsValidSupervisionStreamStamp(stamp));
+
+  SupervisionTargetBinding binding{
+      .stable_tab_id = 7,
+      .document_epoch = base::UnguessableToken::Create(),
+      .target_generation = 1,
+      .document_generation = 1,
+  };
+  EXPECT_TRUE(IsValidSupervisionTargetBinding(binding));
+  binding.document_generation = 0;
+  EXPECT_FALSE(IsValidSupervisionTargetBinding(binding));
+
+  EXPECT_EQ(1u, CheckedNextSupervisionSequence(0));
+  EXPECT_EQ(2u, CheckedNextSupervisionSequence(1));
+  EXPECT_EQ(std::nullopt, CheckedNextSupervisionSequence(
+                              std::numeric_limits<uint64_t>::max()));
+  EXPECT_EQ(1u, CheckedNextSupervisionGeneration(0));
+  EXPECT_EQ(std::nullopt, CheckedNextSupervisionGeneration(
+                              std::numeric_limits<uint64_t>::max()));
+}
