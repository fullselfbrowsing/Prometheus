+base::expected<void, AgentRouteResult> ValidateSupervisionDiffOperation(
+    const AgentSupervisionDiffOperation& operation) {
+  auto valid_ref = ValidateSupervisionString(
+      operation.ref, kMaxAgentSupervisionNodeRefBytes, false);
+  if (!valid_ref.has_value()) {
+    return valid_ref;
+  }
+  auto valid_parent = ValidateSupervisionString(
+      operation.parent_ref, kMaxAgentSupervisionNodeRefBytes);
+  if (!valid_parent.has_value()) {
+    return valid_parent;
+  }
+
+  switch (operation.type) {
+    case AgentSupervisionDiffOperationType::kInsertSubtree: {
+      if (operation.subtree.empty() || operation.replacement.has_value() ||
+          !operation.child_order.empty() ||
+          operation.index >
+              static_cast<size_t>(std::numeric_limits<int>::max()) ||
+          operation.subtree.front().ref != operation.ref ||
+          operation.subtree.front().parent_ref != operation.parent_ref) {
+        return base::unexpected(
+            InvalidRequest("Malformed supervision subtree insertion"));
+      }
+      return ValidateSupervisionNodeCollection(operation.subtree,
+                                               operation.parent_ref);
+    }
+    case AgentSupervisionDiffOperationType::kRemove:
+      if (!operation.parent_ref.empty() || operation.index != 0 ||
+          !operation.subtree.empty() || operation.replacement.has_value() ||
+          !operation.child_order.empty()) {
+        return base::unexpected(
+            InvalidRequest("Malformed supervision removal"));
+      }
+      return base::ok();
+    case AgentSupervisionDiffOperationType::kReplaceFields:
+      if (!operation.parent_ref.empty() || operation.index != 0 ||
+          !operation.subtree.empty() || !operation.replacement.has_value() ||
+          !operation.child_order.empty() ||
+          operation.replacement->ref != operation.ref) {
+        return base::unexpected(
+            InvalidRequest("Malformed supervision field replacement"));
+      }
+      return ValidateSupervisionNode(*operation.replacement);
+    case AgentSupervisionDiffOperationType::kReorderChildren: {
+      if (!operation.parent_ref.empty() || operation.index != 0 ||
+          !operation.subtree.empty() || operation.replacement.has_value() ||
+          operation.child_order.size() > kMaxAgentSupervisionChildrenPerNode) {
+        return base::unexpected(
+            InvalidRequest("Malformed supervision child reorder"));
+      }
+      std::set<std::string_view> child_order;
+      for (const std::string& child_ref : operation.child_order) {
+        auto valid = ValidateSupervisionString(
+            child_ref, kMaxAgentSupervisionNodeRefBytes, false);
+        if (!valid.has_value()) {
+          return valid;
+        }
+        if (!child_order.insert(child_ref).second) {
+          return base::unexpected(InvalidRequest(
+              "Supervision child reorder references must be unique"));
+        }
+      }
+      return base::ok();
+    }
+  }
+  return base::unexpected(InvalidRequest("Unknown supervision diff operation"));
+}
