 using TabSupervision = PrometheusTabState::Supervision;
+using TabStateObservations =
+    std::vector<raw_ptr<PrometheusTabStateObservation>>;
+
+TabStateObservations& GetTabStateObservations() {
+  static base::NoDestructor<TabStateObservations> observations;
+  return *observations;
