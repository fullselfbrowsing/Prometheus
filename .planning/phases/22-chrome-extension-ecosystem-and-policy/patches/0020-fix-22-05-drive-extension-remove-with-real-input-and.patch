+constexpr char kUninstallDialogWidgetName[] = "ExtensionUninstallDialog";
+
+// Returns true once the extension's activation has settled at the *process*
+// level, not merely at the registry-notification level: the registry reports it
+// ready, it owns at least one renderer process, and every renderer process
+// ProcessMap attributes to it has finished launching.
+//
+// This gates the disable click. Disabling an extension whose background
+// service-worker process is still launching aborts that in-flight start, and the
+// service worker context then restarts the worker in a brand new renderer
+// process. If that replacement process is allocated while the extension is
+// disabled, ChromeContentBrowserClientExtensionsPart::
+// SiteInstanceGotProcessAndSite() returns before ProcessMap::Insert() because
+// GetEnabledExtensionFromSecurityPrincipal() finds no *enabled* extension -- and
+// nothing ever inserts retroactively, since ProcessMap::Insert() has exactly
+// that one caller and ProcessMap::Remove() runs only from
+// ExtensionService::RenderProcessHostDestroyed(). Once the extension is
+// re-enabled, that permanently unmapped process finishes launching and its
+// service worker registers its listeners, at which point
+// EventRouter::ValidateServiceWorkerListenerForExtension() no longer suppresses
+// the message (ShouldIgnoreListenerMessageForUnloadedExtension() suppresses only
+// while the extension is disabled) and
+// IsProcessAuthorizedForExtensionProcessListener() fails, so the browser kills
+// the renderer for the bad Mojo message "Tried to manipulate an event listener
+// for an unauthorized extension ID."
+//
+// Observed directly (Phase 22 Plan 22-05 instrumented runs). Without this wait
+// the disable click landed 173 ms before the extension's process became ready;
+// that process was destroyed 20 ms later, its replacement was created 0.8 ms
+// after that and 12 ms *before* the re-enable with the enabled-extension set
+// empty at that instant, never appeared in ProcessMap at any later snapshot, was
+// confirmed to host chrome-extension://<id>/service_worker.js, and was
+// terminated with status=2 exit_code=3 (RESULT_CODE_KILLED_BAD_MESSAGE). With
+// this wait the replacement process is instead created while the extension is
+// enabled, is present in ProcessMap, and no bad message occurs.
+//
+// Measured, not assumed. Over 12 consecutive direct runs of
+// FullLifecycleInstallsInspectsAndReloads: waiting only for process readiness
+// left the bad message in 10 runs and failed 8; additionally waiting for the
+// service worker to have actually started (below) left it in 0 and failed 1,
+// that one being an unrelated BUS_ADRALN environment flake on a base:: thread.
+//
+// IMPORTANT -- what this wait is and is not. It is NOT a fix for that race, and
+// the race is NOT an artifact of this harness driving faster than a user. Every
+// link in the chain above is ordinary product code reached by an ordinary
+// sequence of user actions, the vulnerable window is the extension renderer's
+// whole launch (562 ms as measured here, longer on slower or colder machines),
+// and the resulting ProcessMap omission is permanent for that process's lifetime
+// because nothing re-runs SiteInstanceGotProcessAndSite() when an extension
+// later becomes enabled. A developer who reloads an unpacked extension and
+// toggles it off before its service worker has finished starting can reach it,
+// and the visible effect is the browser killing that extension's background
+// service worker as if it were hostile. That is an upstream Chromium defect and
+// is recorded as a product finding, not closed by this wait.
+//
+// What this wait legitimately buys is a correct *precondition* for the smoke:
+// the lifecycle contract under test is install/inspect/reload/disable/enable/
+// policy/options/remove, and a driver asserting that contract should disable an
+// extension whose activation it has actually confirmed rather than one caught
+// mid-activation. Waiting for a settled precondition is what a correct driver
+// does regardless of the upstream bug; it keeps this smoke scoped to its own
+// contract instead of doubling as a regression test for an unrelated race.
+bool ExtensionActivationSettled(Profile* profile,
+                                const std::string& extension_id) {
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(profile);
+  extensions::ExtensionSystem* system =
+      extensions::ExtensionSystem::Get(profile);
+  if (!registry || !system || !system->is_ready() ||
+      !registry->ready_extensions().Contains(extension_id)) {
+    return false;
+  }
+  extensions::ProcessMap* process_map = extensions::ProcessMap::Get(profile);
+  if (!process_map || !process_map->ExtensionHasProcess(extension_id)) {
+    return false;
+  }
+  for (content::RenderProcessHost::iterator it =
+           content::RenderProcessHost::AllHostsIterator();
+       !it.IsAtEnd(); it.Advance()) {
+    content::RenderProcessHost* host = it.GetCurrentValue();
+    if (process_map->Contains(extension_id, host->GetID()) &&
+        !host->IsReady()) {
+      return false;
+    }
+  }
+  // Process readiness alone is NOT sufficient, and assuming it was is what made
+  // the first version of this wait ineffective (bad message still reproduced in
+  // 10 of 12 runs). RenderProcessHost::IsReady() means the process launched and
+  // its channel connected -- it says nothing about whether the extension's
+  // background service worker has finished starting inside it. The window this
+  // wait exists to close is precisely an *in-flight service-worker start* being
+  // aborted by the disable, so the predicate has to observe the worker itself.
+  //
+  // ProcessManager registers a WorkerId only once the worker has actually
+  // started, so a non-empty GetServiceWorkersForExtension() is the direct
+  // signal. Require its host to be live, ready, and ProcessMap-attributed too,
+  // so a worker registered against a still-launching process does not count.
+  extensions::ProcessManager* process_manager =
+      extensions::ProcessManager::Get(profile);
+  if (!process_manager) {
+    return false;
+  }
+  const std::vector<extensions::WorkerId> workers =
+      process_manager->GetServiceWorkersForExtension(extension_id);
+  if (workers.empty()) {
+    return false;
+  }
+  for (const extensions::WorkerId& worker : workers) {
+    content::RenderProcessHost* host =
+        content::RenderProcessHost::FromID(worker.render_process_id);
+    if (!host || !host->IsInitializedAndNotDead() || !host->IsReady() ||
+        !process_map->Contains(extension_id, worker.render_process_id)) {
+      return false;
+    }
+  }
+  return true;
+}
