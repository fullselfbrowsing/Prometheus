+      kActions = {{
+          {"click", R"({"category":"click","ref":"node:1"})"},
+          {"type", R"({"category":"type","ref":"node:1","text":"hello"})"},
+          {"key_press", R"({"category":"key_press","key":"Enter"})"},
+          {"scroll", R"({"category":"scroll","delta_y":500})"},
+          {"hover", R"({"category":"hover","ref":"node:1"})"},
+          {"select", R"({"category":"select","ref":"node:1","option":"one"})"},
+          {"clear", R"({"category":"clear","ref":"node:1"})"},
+          {"drag",
+           R"({"category":"drag","ref":"node:1","target_ref":"node:2"})"},
+          {"drop", R"({"category":"drop","ref":"node:1"})"},
+          {"navigate",
+           R"({"category":"navigate","navigation":"https://example.test/next"})"},
+      }};
+
+  for (const auto& [name, action] : kActions) {
+    SCOPED_TRACE(name);
+    const std::string params =
