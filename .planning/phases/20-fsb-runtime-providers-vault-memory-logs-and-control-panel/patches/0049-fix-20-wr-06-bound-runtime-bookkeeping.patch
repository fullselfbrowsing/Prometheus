+void PrometheusRuntimeProfileService::PruneFinishedTaskRecordsForAdmission() {
+  if (owned_runtime_store_) {
+    return;
+  }
+  while (tasks_.size() >= kMaxStoredRuntimeTasks) {
+    auto oldest = tasks_.end();
+    for (auto task = tasks_.begin(); task != tasks_.end(); ++task) {
+      if (!task->second.finished) {
+        continue;
+      }
+      if (oldest == tasks_.end() ||
+          task->second.snapshot.updated_at_ms <
+              oldest->second.snapshot.updated_at_ms ||
+          (task->second.snapshot.updated_at_ms ==
+               oldest->second.snapshot.updated_at_ms &&
+           (task->second.snapshot.created_at_ms <
+                oldest->second.snapshot.created_at_ms ||
+            (task->second.snapshot.created_at_ms ==
+                 oldest->second.snapshot.created_at_ms &&
+             task->first < oldest->first)))) {
+        oldest = task;
+      }
+    }
+    if (oldest == tasks_.end()) {
+      return;
+    }
+    tasks_.erase(oldest);
+  }
+}
+
+void PrometheusRuntimeProfileService::PruneFinishedTaskRecordsAgainstSnapshot(
+    const RuntimeStoreSnapshot& snapshot) {
+  std::set<std::string, std::less<>> retained_task_ids;
+  for (const RuntimeStoredTask& task : snapshot.tasks) {
+    retained_task_ids.insert(task.snapshot.task_id);
+  }
+  for (auto task = tasks_.begin(); task != tasks_.end();) {
+    if (task->second.finished && !retained_task_ids.contains(task->first)) {
+      task = tasks_.erase(task);
+    } else {
+      ++task;
+    }
+  }
+}
+
+void PrometheusRuntimeProfileService::PruneCompletedDiscoveriesForAdmission() {
+  while (discoveries_.size() >= kMaxRuntimeDiscoveryRecords) {
+    const auto completed = std::ranges::find_if(
+        discoveries_, [](const auto& item) { return item.second.finished; });
+    if (completed == discoveries_.end()) {
+      return;
+    }
+    discoveries_.erase(completed);
+  }
+}
+
