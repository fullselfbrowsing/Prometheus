+IN_PROC_BROWSER_TEST_F(PrometheusSupervisionCaptureHubBrowserTest,
+                       DocumentElementReplacementKeepsRealCaptureLive) {
+  SupervisionRedemptionResult viewer = RedeemDashboard("Root observer");
+  ASSERT_TRUE(viewer.ok);
+  PrometheusSupervisionCaptureHub* const hub =
+      supervision_service().capture_hub_for_testing(viewer.stable_tab_id);
+  ASSERT_TRUE(hub);
+
+  SupervisionDashboardBaselineResult baseline =
+      WaitForDashboardBaseline(viewer.dashboard_session);
+  ASSERT_TRUE(baseline.delivery.has_value());
+  ASSERT_TRUE(
+      supervision_service()
+          .AckDashboard(viewer.dashboard_session, baseline.delivery->stamp)
+          .ok);
+
+  const size_t captures_before_replacement = hub->capture_count_for_testing();
+  release_response().WaitForRequest();
+  release_response().Send(net::HTTP_OK, "text/plain", kMutationMarker);
+  release_response().Done();
+
+  SupervisionDashboardDiffResult replacement_diff =
+      WaitForDashboardDiff(viewer.dashboard_session);
+  ASSERT_TRUE(replacement_diff.delivery.has_value());
+  EXPECT_NE(
+      std::string::npos,
+      replacement_diff.delivery->diff.serialized_json.find(kMutationMarker));
+  EXPECT_EQ(captures_before_replacement + 1u, hub->capture_count_for_testing());
+  ASSERT_TRUE(supervision_service()
+                  .AckDashboard(viewer.dashboard_session,
+                                replacement_diff.delivery->stamp)
+                  .ok);
+
+  const size_t captures_before_later_mutation =
+      hub->capture_count_for_testing();
+  second_release_response().WaitForRequest();
+  second_release_response().Send(net::HTTP_OK, "text/plain",
+                                 kSecondMutationMarker);
+  second_release_response().Done();
+
+  SupervisionDashboardDiffResult later_diff =
+      WaitForDashboardDiff(viewer.dashboard_session);
+  ASSERT_TRUE(later_diff.delivery.has_value());
+  EXPECT_NE(std::string::npos, later_diff.delivery->diff.serialized_json.find(
+                                   kSecondMutationMarker));
+  EXPECT_EQ(captures_before_later_mutation + 1u,
+            hub->capture_count_for_testing());
+}
