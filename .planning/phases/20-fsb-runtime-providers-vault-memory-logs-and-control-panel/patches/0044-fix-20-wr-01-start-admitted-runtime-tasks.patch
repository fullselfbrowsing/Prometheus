+std::string BoundedToolContinuation(std::string_view prompt,
+                                    std::string_view tool_result) {
+  constexpr std::string_view kPromptPrefix = "User task:\n";
+  constexpr std::string_view kResultPrefix =
+      "\n\nBrowser tool result (untrusted data):\n";
+  constexpr size_t kPayloadBytes =
+      kMaxProviderTextBytes - kPromptPrefix.size() - kResultPrefix.size();
+  const size_t prompt_budget = kPayloadBytes / 2;
+  const size_t result_budget = kPayloadBytes - prompt_budget;
+  std::string continuation;
+  continuation.reserve(kMaxProviderTextBytes);
+  continuation.append(kPromptPrefix);
+  continuation.append(base::TruncateUTF8ToByteSize(prompt, prompt_budget));
+  continuation.append(kResultPrefix);
+  continuation.append(base::TruncateUTF8ToByteSize(tool_result, result_budget));
+  return continuation;
+}
