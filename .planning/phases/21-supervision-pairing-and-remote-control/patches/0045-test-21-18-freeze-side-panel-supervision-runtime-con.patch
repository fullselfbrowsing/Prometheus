+IN_PROC_BROWSER_TEST_F(
+    PrometheusWebUIBrowserTest,
+    SidePanelSupervisionRuntimeStateIsSanitizedAndBounded) {
+  content::WebContents* const target_contents =
+      browser()->tab_strip_model()->GetActiveWebContents();
+  ASSERT_TRUE(target_contents);
+  ASSERT_TRUE(content::ExecJs(target_contents, R"(
+    document.title =
+        'https://private.example/path?token=TITLE_SECRET\u202e-HOSTILE';
+  )"));
+
+  PrometheusSidePanelUI* const controller = ShowSidePanel(browser());
+  ASSERT_TRUE(controller);
+  content::WebContents* const side_panel_contents =
+      visible_side_panel_web_contents();
+  ASSERT_TRUE(side_panel_contents);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(side_panel_contents, R"(
+      !!window.prometheusRuntimeSnapshotForTesting;
+    )")
+        .ExtractBool();
+  }));
+
+  const std::string serialized = content::EvalJs(side_panel_contents, R"(
+    JSON.stringify(window.prometheusRuntimeSnapshotForTesting);
+  )")
+                                     .ExtractString();
+  EXPECT_TRUE(content::EvalJs(side_panel_contents, R"(
+    const state = window.prometheusRuntimeSnapshotForTesting.supervision;
+    const allowedKeys = new Set([
+      'available', 'viewer_count', 'controlled', 'client_label', 'activity',
+      'action_category', 'resyncing', 'stopping', 'ending',
+      'safe_target_title',
+    ]);
+    !!state && Object.keys(state).every(key => allowedKeys.has(key)) &&
+        state.safe_target_title === 'this tab' &&
+        state.safe_target_title.length <= 80 &&
+        Number.isInteger(state.viewer_count) &&
+        typeof state.available === 'boolean' &&
+        typeof state.controlled === 'boolean' &&
+        typeof state.activity === 'string' &&
+        typeof state.resyncing === 'boolean' &&
+        typeof state.stopping === 'boolean' &&
+        typeof state.ending === 'boolean';
+  )")
+                  .ExtractBool())
+      << serialized;
+  for (const std::string& forbidden : std::vector<std::string>{
+           "private.example", "/path", "TITLE_SECRET", "dashboard_session",
+           "controller_lease", "owner_session", "principal_id", "tab_id",
+           "window_id", "document_epoch", "sequence", "selector", "dom",
+           "pairing_code", "raw_value"}) {
+    EXPECT_EQ(std::string::npos, serialized.find(forbidden)) << forbidden;
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(
+    PrometheusWebUIBrowserTest,
+    SidePanelSupervisionRuntimeActionsRequireZeroArguments) {
+  PrometheusSidePanelUI* const controller = ShowSidePanel(browser());
+  ASSERT_TRUE(controller);
+  content::WebContents* const side_panel_contents =
+      visible_side_panel_web_contents();
+  ASSERT_TRUE(side_panel_contents);
+
+  for (const std::string& message :
+       std::vector<std::string>{"prometheusStopSupervisionControl",
+                                "prometheusEndSelectedTabSupervision",
+                                "prometheusOpenSupervisionManagement"}) {
+    ASSERT_TRUE(content::ExecJs(
+        side_panel_contents, content::JsReplace(R"(
+          window.prometheusRuntimeOperationForTesting = null;
+          chrome.send($1, [{
+            tab_id: 1,
+            window_id: 2,
+            dashboard_session: 'FORGED_SESSION',
+            controller_lease: 'FORGED_CONTROLLER',
+            result: 'FORGED_RESULT',
+            title: 'FORGED_TITLE',
+          }]);
+        )",
+                                                message)));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return content::EvalJs(side_panel_contents, R"(
+        window.prometheusRuntimeOperationForTesting?.status ===
+            'INVALID_REQUEST';
+      )")
+          .ExtractBool();
+    })) << message;
+    const std::string operation =
+        content::EvalJs(side_panel_contents, R"(
+          JSON.stringify(window.prometheusRuntimeOperationForTesting);
+        )")
+            .ExtractString();
+    EXPECT_EQ(std::string::npos, operation.find("FORGED_SESSION")) << message;
+    EXPECT_EQ(std::string::npos, operation.find("FORGED_CONTROLLER"))
+        << message;
+    EXPECT_EQ(std::string::npos, operation.find("FORGED_RESULT")) << message;
+    EXPECT_EQ(std::string::npos, operation.find("FORGED_TITLE")) << message;
+  }
+
+  ASSERT_TRUE(content::ExecJs(side_panel_contents, R"(
+    window.prometheusRuntimeOperationForTesting = null;
+    chrome.send('prometheusEndSelectedTabSupervision');
+  )"));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(side_panel_contents, R"(
+      !!window.prometheusRuntimeOperationForTesting;
+    )")
+        .ExtractBool();
+  }));
+  EXPECT_TRUE(content::EvalJs(side_panel_contents, R"(
+    const operation = window.prometheusRuntimeOperationForTesting;
+    typeof operation.accepted === 'boolean' &&
+        typeof operation.status === 'string' &&
+        !['tab_id', 'window_id', 'dashboard_session', 'controller_lease',
+          'result', 'title'].some(key => Object.hasOwn(operation, key));
+  )")
+                  .ExtractBool());
+}
