+template <typename T>
+concept HasControllerLeaseField = requires(T value) { value.controller_lease; };
+template <typename T>
+concept HasOwnerField = requires(T value) { value.owner_session_id; };
+template <typename T>
+concept HasProfileField = requires(T value) { value.profile; };
+template <typename T>
+concept HasBrowserField = requires(T value) { value.browser; };
+template <typename T>
+concept HasTabField = requires(T value) { value.stable_tab_id; };
+template <typename T>
+concept HasDocumentField = requires(T value) { value.document_epoch; };
