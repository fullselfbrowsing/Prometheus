+TEST_F(PrometheusSupervisionTestBootstrapTest,
+       WrongChallengeOwnerTargetDocumentTimeoutAndShutdownReturnNoCredential) {
+  ASSERT_EQ(Create(MakeLaunch(base::FilePath(kConfigPath))),
+            PrometheusSupervisionTestBootstrapResult::kApplied);
+  ASSERT_TRUE(bootstrap_);
+
+  std::vector<HandoffResponse> denials;
+  denials.push_back(
+      Dispatch(std::string(kPrometheusSupervisionTestChallengeBytes, 'a'),
+               "owner-session", 1));
+  denials.push_back(Dispatch(kChallenge, "replacement-owner", 1));
+  for (const HandoffResponse& response : denials) {
+    ASSERT_TRUE(response.result);
+    EXPECT_NE(SupervisionTestHandoffStatus::kDelivered,
+              response.result->status);
+    EXPECT_TRUE(response.result->pairing_code.empty());
+  }
+  EXPECT_EQ(0, create_code_calls_);
+
+  current_binding_.document_identity = "document-2";
+  HandoffResponse changed_document = Dispatch(kChallenge, "owner-session", 1);
+  EXPECT_EQ(SupervisionTestHandoffStatus::kTargetLost,
+            changed_document.result->status);
+  EXPECT_TRUE(changed_document.result->pairing_code.empty());
+
+  bootstrap_.reset();
+  current_binding_.document_identity = "document-1";
+  ASSERT_EQ(Create(MakeLaunch(base::FilePath(kConfigPath))),
+            PrometheusSupervisionTestBootstrapResult::kApplied);
+  now_ += kPrometheusSupervisionTestHandoffTtl + base::Milliseconds(1);
+  HandoffResponse expired = Dispatch(kChallenge, "owner-session", 1);
+  EXPECT_EQ(SupervisionTestHandoffStatus::kExpired, expired.result->status);
+  EXPECT_TRUE(expired.result->pairing_code.empty());
+
+  bootstrap_.reset();
+  now_ = base::TimeTicks() + base::Seconds(10);
+  ASSERT_EQ(Create(MakeLaunch(base::FilePath(kConfigPath))),
+            PrometheusSupervisionTestBootstrapResult::kApplied);
+  bootstrap_->Shutdown();
+  HandoffResponse shutdown = Dispatch(kChallenge, "owner-session", 1);
+  EXPECT_EQ(SupervisionTestHandoffStatus::kShutdown, shutdown.result->status);
+  EXPECT_TRUE(shutdown.result->pairing_code.empty());
+}
