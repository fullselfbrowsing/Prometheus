+          manifestVersion :
+          0,
+      private_eligible: item?.private_eligible === true,
+      requested_regular: controlExtensionGrant(item?.requested_regular),
+      requested_private: controlExtensionGrant(item?.requested_private),
+      effective_regular: controlExtensionGrant(item?.effective_regular),
+      effective_private: controlExtensionGrant(item?.effective_private),
+      ordinal,
+      generation: rowGeneration,
