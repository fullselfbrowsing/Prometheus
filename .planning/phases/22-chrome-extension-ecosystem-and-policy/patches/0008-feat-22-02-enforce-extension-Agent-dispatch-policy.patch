+bool IsExtensionPrimaryFrame(content::WebContents* web_contents,
+                             content::RenderFrameHost* frame,
+                             std::string_view extension_id) {
+  if (!web_contents || web_contents->IsBeingDestroyed() ||
+      web_contents->IsCrashed() || !frame || !frame->IsActive() ||
+      !frame->IsRenderFrameLive() ||
+      content::WebContents::FromRenderFrameHost(frame) != web_contents ||
+      web_contents->GetPrimaryMainFrame() != frame ||
+      !frame->GetPage().IsPrimary()) {
+    return false;
+  }
+  const url::Origin& origin = frame->GetLastCommittedOrigin();
+  return !origin.opaque() &&
+         origin.scheme() == extensions::kExtensionScheme &&
+         origin.host() == extension_id;
