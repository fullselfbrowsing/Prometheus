+std::vector<ExtensionPolicyInventoryEntry>
+PrometheusExtensionPolicyService::BuildInventory() const {
+  ++registry_lookup_count_for_testing_;
+  if (inventory_for_testing_) {
+    return *inventory_for_testing_;
+  }
+  std::vector<ExtensionPolicyInventoryEntry> inventory;
+  if (shutdown_ || !registry_) {
+    return inventory;
+  }
+
+  extensions::ExtensionSet installed =
+      registry_->GenerateInstalledExtensionsSet();
+  inventory.reserve(
+      std::min(installed.size(), kMaxExtensionPolicySnapshotRows));
+  for (const scoped_refptr<const extensions::Extension>& extension :
+       installed) {
+    if (inventory.size() == kMaxExtensionPolicySnapshotRows) {
+      break;
+    }
+    ExtensionPolicyInventoryEntry entry;
+    entry.extension_id = extension->id();
+    entry.name = extension->name();
+    entry.source = PolicySourceForExtension(*extension);
+    entry.enabled = registry_->enabled_extensions().Contains(extension->id());
+    entry.ready = registry_->ready_extensions().Contains(extension->id());
+    entry.manifest_version = extension->manifest_version();
+    entry.native_private_eligible =
+        extensions::util::IsIncognitoEnabled(extension->id(), regular_context_);
+    entry.browser_context = regular_context_;
+    inventory.push_back(std::move(entry));
+  }
+  std::ranges::sort(inventory, InventoryOrder);
+  if (inventory.size() > kMaxExtensionPolicySnapshotRows) {
+    inventory.resize(kMaxExtensionPolicySnapshotRows);
+  }
+  return inventory;
+}
+
+bool PrometheusExtensionPolicyService::IsSystemReady() const {
+  if (system_ready_for_testing_) {
+    return *system_ready_for_testing_;
+  }
+  if (!regular_context_) {
+    return false;
+  }
+  extensions::ExtensionSystem* const system =
+      extensions::ExtensionSystem::Get(regular_context_);
+  return system && system->is_ready();
+}
+
+bool PrometheusExtensionPolicyService::IsAllowedContext(
+    content::BrowserContext* current_context,
+    bool private_mode) const {
+  if (inventory_for_testing_) {
+    return current_context == regular_context_;
+  }
+  if (!regular_context_ || !current_context) {
+    return false;
+  }
+  if (!private_mode) {
+    return current_context == regular_context_ &&
+           !current_context->IsOffTheRecord();
+  }
+  if (!current_context->IsOffTheRecord()) {
+    return false;
+  }
+  Profile* const regular_profile =
+      Profile::FromBrowserContext(regular_context_);
+  Profile* const current_profile = Profile::FromBrowserContext(current_context);
+  return regular_profile && current_profile &&
+         current_profile->GetOriginalProfile() == regular_profile;
+}
+
+void PrometheusExtensionPolicyService::AdvanceGeneration() {
+  ++generation_;
+  if (generation_ == 0u) {
+    generation_ = 1u;
+  }
+}
+
+void PrometheusExtensionPolicyService::ReconcileAndNotify() {
+  if (shutdown_) {
+    return;
+  }
+  AdvanceGeneration();
+  const ExtensionPolicySnapshot snapshot = GetSnapshot();
+  for (PrometheusExtensionPolicyServiceObserver& observer : observers_) {
+    observer.OnPrometheusExtensionPolicyChanged(snapshot);
+  }
+}
 
 }  // namespace prometheus
