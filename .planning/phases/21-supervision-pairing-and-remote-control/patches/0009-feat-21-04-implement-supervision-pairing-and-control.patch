+void PrometheusSupervisionProfileService::AddAudit(
+    int32_t stable_tab_id,
+    SupervisionAuditEvent event,
+    std::optional<std::string> client_label,
+    SupervisionErrorCode error_code) {
+  tabs::TabInterface* tab = nullptr;
+  auto observed = observed_tabs_.find(stable_tab_id);
+  if (observed != observed_tabs_.end()) {
+    tab = observed->second->tab;
+  }
+  SupervisionAuditSnapshot row;
+  row.event = event;
+  row.timestamp_ms = Now().InMillisecondsSinceUnixEpoch();
+  if (client_label.has_value()) {
+    row.client_label = DeriveSupervisionSafeClientLabel(*client_label);
+  }
+  row.safe_target_title = SafeTitle(tab);
+  row.safe_origin = SafeOrigin(tab);
+  row.error_code = error_code;
+  audit_.emplace_back(stable_tab_id, std::move(row));
+  while (audit_.size() > limits_.audit_rows) {
+    audit_.pop_front();
+  }
+}
