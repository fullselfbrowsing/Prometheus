 namespace ui {
 class ColorProvider;
 }
 
+// D-05: Four named accent swatch constants — locked v1 swatches.
+// Phase 14 hardcodes FSB Orange as the default accent.
+// Phase-16 picker selects among these four; no picker UI is built here.
+constexpr SkColor kPrometheusAccentFsbOrange = SkColorSetRGB(0xff, 0x6b, 0x35);  // default
+constexpr SkColor kPrometheusAccentIndigo    = SkColorSetRGB(0x63, 0x66, 0xf1);  // #6366f1
+constexpr SkColor kPrometheusAccentTeal      = SkColorSetRGB(0x14, 0xb8, 0xa6);  // #14b8a6
+constexpr SkColor kPrometheusAccentRose      = SkColorSetRGB(0xf4, 0x3f, 0x5e);  // #f43f5e
+
