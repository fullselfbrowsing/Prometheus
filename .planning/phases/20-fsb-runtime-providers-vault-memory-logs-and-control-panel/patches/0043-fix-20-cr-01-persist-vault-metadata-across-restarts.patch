+void PrometheusVaultService::LoadMetadata() {
+  metadata_.clear();
+  next_metadata_id_ = 0;
+  if (!prefs_) {
+    return;
+  }
+
+  const base::DictValue& root = prefs_->GetDict(kPrometheusRuntimeProfileData);
+  if (root.FindInt(kRuntimeSchemaVersionKey) !=
+      kPrometheusRuntimeSchemaVersion) {
+    return;
+  }
+  const base::DictValue* data = root.FindDict(kRuntimeDataKey);
+  const base::DictValue* store =
+      data ? data->FindDict(kVaultStoreKey) : nullptr;
+  if (store) {
+    std::optional<std::string> serialized = base::WriteJson(*store);
+    const std::string* next_id =
+        store->FindString(kVaultStoreNextMetadataIdKey);
+    const base::ListValue* entries = store->FindList(kVaultStoreEntriesKey);
+    uint64_t persisted_next_id = 0;
+    if (store->size() == 3u && serialized.has_value() &&
+        serialized->size() <= kMaxVaultStoreSerializedBytes &&
+        store->FindInt(kVaultStoreSchemaVersionKey) ==
+            kVaultStoreSchemaVersion &&
+        next_id && base::StringToUint64(*next_id, &persisted_next_id) &&
+        entries && entries->size() <= kMaxPrometheusVaultEntries) {
+      next_metadata_id_ = persisted_next_id;
+      for (const base::Value& value : *entries) {
+        if (!value.is_dict()) {
+          continue;
+        }
+        std::optional<PrometheusVaultMetadata> metadata =
+            VaultMetadataFromValue(value.GetDict());
+        if (!metadata.has_value() || metadata_.contains(metadata->id)) {
+          continue;
+        }
+        next_metadata_id_ =
+            std::max(next_metadata_id_, *VaultIdSequence(metadata->id));
+        metadata_.emplace(metadata->id, std::move(*metadata));
+      }
+    }
+  }
+
+  ReconcileSecretRecords();
+  PersistMetadata();
+}
+
+void PrometheusVaultService::ReconcileSecretRecords() {
+  std::map<std::string, std::vector<PrometheusSecretBinding>, std::less<>>
+      vault_bindings;
+  for (const base::Value& value :
+       secret_store_->GetSanitizedMetadataSnapshot()) {
+    std::optional<PrometheusSecretBinding> binding =
+        SecretBindingFromSnapshot(value);
+    if (binding.has_value() && IsVaultSecretBinding(*binding)) {
+      if (std::optional<uint64_t> sequence =
+              VaultIdSequence(binding->record_id)) {
+        next_metadata_id_ = std::max(next_metadata_id_, *sequence);
+      }
+      vault_bindings[binding->record_id].push_back(std::move(*binding));
+    }
+  }
+
+  for (auto& [entry_id, metadata] : metadata_) {
+    auto bindings_it = vault_bindings.find(entry_id);
+    const bool has_exact_secret =
+        bindings_it != vault_bindings.end() &&
+        bindings_it->second.size() == 1u &&
+        bindings_it->second.front() == SecretBindingFor(metadata);
+    if (metadata.secret_configured && !has_exact_secret) {
+      metadata.secret_configured = false;
+    }
+  }
+
+  for (auto& [record_id, bindings] : vault_bindings) {
+    auto metadata_it = metadata_.find(record_id);
+    const bool retain =
+        metadata_it != metadata_.end() &&
+        metadata_it->second.secret_configured && bindings.size() == 1u &&
+        bindings.front() == SecretBindingFor(metadata_it->second);
+    if (retain) {
+      continue;
+    }
+    for (PrometheusSecretBinding& binding : bindings) {
+      secret_store_->Delete(std::move(binding), base::DoNothing());
+    }
+  }
+}
+
+void PrometheusVaultService::PersistMetadata() {
+  if (!prefs_) {
+    return;
+  }
+  base::ListValue entries;
+  entries.reserve(metadata_.size());
+  for (const auto& [entry_id, metadata] : metadata_) {
+    static_cast<void>(entry_id);
+    entries.Append(VaultMetadataToValue(metadata));
+  }
+  base::DictValue store;
+  store.Set(kVaultStoreSchemaVersionKey, kVaultStoreSchemaVersion);
+  store.Set(kVaultStoreNextMetadataIdKey,
+            base::NumberToString(next_metadata_id_));
+  store.Set(kVaultStoreEntriesKey, std::move(entries));
+
+  std::optional<std::string> serialized = base::WriteJson(store);
+  CHECK(serialized.has_value());
+  CHECK_LE(serialized->size(), kMaxVaultStoreSerializedBytes);
+
+  base::DictValue root = prefs_->GetDict(kPrometheusRuntimeProfileData).Clone();
+  if (root.FindInt(kRuntimeSchemaVersionKey) !=
+      kPrometheusRuntimeSchemaVersion) {
+    return;
+  }
+  base::DictValue data = root.FindDict(kRuntimeDataKey)
+                             ? root.FindDict(kRuntimeDataKey)->Clone()
+                             : base::DictValue();
+  data.Set(kVaultStoreKey, std::move(store));
+  root.Set(kRuntimeDataKey, std::move(data));
+  prefs_->SetDict(kPrometheusRuntimeProfileData, std::move(root));
+}
