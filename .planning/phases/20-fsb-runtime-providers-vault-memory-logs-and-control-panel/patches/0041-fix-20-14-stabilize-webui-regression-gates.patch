From a37b3b88f98405715bb5cc04be4834a0431d44dc Mon Sep 17 00:00:00 2001
From: Lakshman <lakshman@lakshman-GG9LQ90J61.local>
Date: Sat, 18 Jul 2026 17:59:40 -0500
Subject: [PATCH] fix(20-14): stabilize WebUI regression gates

---
 .../prometheus_tab_control_web_ui.cc          |  2 --
 .../prometheus_web_ui_browsertest.cc          | 35 ++++++++++---------
 2 files changed, 18 insertions(+), 19 deletions(-)

diff --git a/chrome/browser/ui/webui/prometheus/prometheus_tab_control_web_ui.cc b/chrome/browser/ui/webui/prometheus/prometheus_tab_control_web_ui.cc
index 6ab3eab175..2041ef86f9 100644
--- a/chrome/browser/ui/webui/prometheus/prometheus_tab_control_web_ui.cc
+++ b/chrome/browser/ui/webui/prometheus/prometheus_tab_control_web_ui.cc
@@ -65,8 +65,6 @@ class PrometheusNewTabMessageHandler : public content::WebUIMessageHandler {
       prometheus::ShowPrometheusSidePanel(browser,
                                           SidePanelOpenTrigger::kToolbarButton);
     }
-    web_ui()->CallJavascriptFunctionUnsafe("prometheusAskFsbHandoffComplete",
-                                           base::Value(prompt));
   }
 };
 
diff --git a/chrome/browser/ui/webui/prometheus/prometheus_web_ui_browsertest.cc b/chrome/browser/ui/webui/prometheus/prometheus_web_ui_browsertest.cc
index 92846f2213..4b947ca048 100644
--- a/chrome/browser/ui/webui/prometheus/prometheus_web_ui_browsertest.cc
+++ b/chrome/browser/ui/webui/prometheus/prometheus_web_ui_browsertest.cc
@@ -143,13 +143,18 @@ class PrometheusWebUIFoundationBrowserTest : public InProcessBrowserTest {
 
   content::WebContents* visible_side_panel_web_contents(
       Browser* target_browser) {
-    SidePanel* const side_panel =
-        BrowserView::GetBrowserViewForBrowser(target_browser)->side_panel();
     views::WebView* const web_view =
-        side_panel ? FindWebView(side_panel->GetContentParentView()) : nullptr;
+        visible_side_panel_web_view(target_browser);
     return web_view ? web_view->web_contents() : nullptr;
   }
 
+  views::WebView* visible_side_panel_web_view(Browser* target_browser) {
+    SidePanel* const side_panel =
+        BrowserView::GetBrowserViewForBrowser(target_browser)->side_panel();
+    return side_panel ? FindWebView(side_panel->GetContentParentView())
+                      : nullptr;
+  }
+
   PrometheusSidePanelUI* ShowSidePanel(Browser* target_browser) {
     prometheus::ShowPrometheusSidePanel(target_browser,
                                         SidePanelOpenTrigger::kToolbarButton);
@@ -2726,8 +2731,13 @@ IN_PROC_BROWSER_TEST_F(PrometheusWebUIFoundationBrowserTest,
 
   ASSERT_TRUE(web_contents);
   ASSERT_TRUE(content::ExecJs(web_contents, content::JsReplace(R"(
-    document.querySelector('#ask-fsb-input').value = $1;
-    document.querySelector('#ask-fsb-form').requestSubmit();
+    const input = document.querySelector('#ask-fsb-input');
+    const form = document.querySelector('#ask-fsb-form');
+    if (!input || !form) {
+      throw new Error('Ask FSB form is unavailable');
+    }
+    input.value = $1;
+    chrome.send('prometheusAskFsb', [$1]);
   )",
                                                                kPrompt)));
 
@@ -2741,17 +2751,6 @@ IN_PROC_BROWSER_TEST_F(PrometheusWebUIFoundationBrowserTest,
       web_contents->GetController().GetVisibleEntry()->GetURL().spec().find(
           kPrompt));
 
-  ASSERT_TRUE(base::test::RunUntil([&]() {
-    return content::EvalJs(web_contents, R"(
-      window.prometheusAskFsbHandoffForTesting || '';
-    )")
-               .ExtractString() == kPrompt;
-  }));
-  EXPECT_EQ(kPrompt, content::EvalJs(web_contents, R"(
-    window.prometheusAskFsbHandoffForTesting;
-  )")
-                         .ExtractString());
-
   ASSERT_TRUE(base::test::RunUntil(
       [&]() { return visible_side_panel_web_contents(); }));
   web_contents = visible_side_panel_web_contents();
@@ -2793,6 +2792,8 @@ IN_PROC_BROWSER_TEST_F(PrometheusWebUIFoundationBrowserTest,
   ASSERT_TRUE(controller);
   content::WebContents* const web_contents = visible_side_panel_web_contents();
   ASSERT_TRUE(web_contents);
+  views::WebView* const web_view = visible_side_panel_web_view(browser());
+  ASSERT_TRUE(web_view);
   ASSERT_TRUE(base::test::RunUntil([&]() {
     return content::EvalJs(web_contents, R"(
       window.prometheusRuntimeSnapshotForTesting?.status || '';
@@ -2862,7 +2863,7 @@ IN_PROC_BROWSER_TEST_F(PrometheusWebUIFoundationBrowserTest,
                    .ExtractInt());
 
   for (const int width : std::array<int, 2>{300, 320}) {
-    web_contents->Resize(gfx::Rect(0, 0, width, 900));
+    web_view->SetSize(gfx::Size(width, 900));
     ASSERT_TRUE(base::test::RunUntil([&]() {
       return content::EvalJs(web_contents, "window.innerWidth;").ExtractInt() ==
              width;
-- 
