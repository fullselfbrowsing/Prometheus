+TEST(PrometheusAgentGatewayTest, RequiresBearerOnEveryClosedEndpoint) {
+  constexpr std::array<std::string_view, 6> kPaths = {
+      "/v1/session/create", "/v1/session/resume", "/v1/session/touch",
+      "/v1/session/close",  "/v1/agent/command", "/v1/health"};
+  for (std::string_view path : kPaths) {
+    auto missing = ValidRequest(path);
+    missing.headers.erase("authorization");
+    ExpectRejected(missing, PrometheusAgentRequestRejection::kUnauthorized);
+
+    auto wrong = ValidRequest(path);
+    wrong.headers["authorization"] = "Bearer definitely-wrong";
+    ExpectRejected(wrong, PrometheusAgentRequestRejection::kUnauthorized);
+
+    ExpectRejected(ValidRequest(path), PrometheusAgentRequestRejection::kNone);
+  }
+}
