+
+#ifndef CHROME_BROWSER_PROMETHEUS_PROMETHEUS_SUPERVISION_TYPES_H_
+#define CHROME_BROWSER_PROMETHEUS_PROMETHEUS_SUPERVISION_TYPES_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/unguessable_token.h"
+#include "base/values.h"
+
+namespace prometheus {
+
+enum class SupervisionPairingState {
+  kPending,
+  kRedeemed,
+  kCancelled,
+  kExpired,
+  kTargetLost,
+};
+
+enum class SupervisionViewerState {
+  kViewOnly,
+  kController,
+  kExpired,
+  kRevoked,
+  kTargetClosed,
+  kAuthorityLost,
+  kEnded,
+};
+
+enum class SupervisionStreamState {
+  kPreparingBaseline,
+  kLive,
+  kResyncing,
+  kPaused,
+  kEnded,
+};
+
+enum class SupervisionRemoteActionCategory {
+  kClick,
+  kType,
+  kKeyPress,
+  kScroll,
+  kHover,
+  kSelect,
+  kClear,
+  kDrag,
+  kDrop,
+  kNavigate,
+};
+
+enum class SupervisionRemoteActionState {
+  kIdle,
+  kValidating,
+  kExecuting,
+  kAwaitingConfirmation,
+  kVerifying,
+  kCompleted,
+  kBlocked,
+  kFailed,
+};
+
+enum class SupervisionAuditEvent {
+  kPairingCodeCreated,
+  kPairingCodeCancelled,
+  kPairingCodeExpired,
+  kDashboardPaired,
+  kViewingStarted,
+  kControlEnabled,
+  kRemoteActionRequested,
+  kRemoteActionCompleted,
+  kRemoteActionBlocked,
+  kControlStopped,
+  kAccessRevoked,
+  kAccessExpired,
+  kResyncRequired,
+  kResyncCompleted,
+  kTargetClosed,
+  kAuthorityLost,
+};
+
+enum class SupervisionTerminalReason {
+  kNone,
+  kCancelled,
+  kExpired,
+  kRevoked,
+  kTargetClosed,
+  kAuthorityLost,
+  kOwnerLost,
+  kBrowserShutdown,
+  kProfileShutdown,
+};
+
+enum class SupervisionErrorCode {
+  kNone,
+  kInvalidCode,
+  kExpiredCode,
+  kAttemptCapReached,
+  kUnknownSession,
+  kViewOnly,
+  kControllerConflict,
+  kStaleTarget,
+  kStaleEpoch,
+  kStaleSequence,
+  kResyncRequired,
+  kRestrictedTarget,
+  kTooLarge,
+  kConfirmationDenied,
+  kShutdown,
+};
+
+inline constexpr uint64_t kDefaultSupervisionPairingCodeCharacters = 8;
+inline constexpr uint64_t kHardSupervisionPairingCodeCharacters = 8;
+inline constexpr uint64_t kDefaultSupervisionPairingCodeTtlMs = 5 * 60 * 1000;
+inline constexpr uint64_t kHardSupervisionPairingCodeTtlMs = 10 * 60 * 1000;
+inline constexpr uint64_t kDefaultSupervisionViewerTtlMs = 15 * 60 * 1000;
+inline constexpr uint64_t kHardSupervisionViewerTtlMs = 60 * 60 * 1000;
+inline constexpr uint64_t kDefaultSupervisionViewersPerTab = 8;
+inline constexpr uint64_t kHardSupervisionViewersPerTab = 16;
+inline constexpr uint64_t kDefaultSupervisionSessionsPerProfile = 32;
+inline constexpr uint64_t kHardSupervisionSessionsPerProfile = 64;
+inline constexpr uint64_t kDefaultSupervisionAttemptsPerCode = 8;
+inline constexpr uint64_t kHardSupervisionAttemptsPerCode = 16;
+inline constexpr uint64_t kDefaultSupervisionBaselineNodes = 500;
+inline constexpr uint64_t kHardSupervisionBaselineNodes = 2000;
+inline constexpr uint64_t kDefaultSupervisionBaselineBytes = 200 * 1024;
+inline constexpr uint64_t kHardSupervisionBaselineBytes = 1024 * 1024;
+inline constexpr uint64_t kDefaultSupervisionDiffOperations = 128;
+inline constexpr uint64_t kHardSupervisionDiffOperations = 512;
+inline constexpr uint64_t kDefaultSupervisionDiffBytes = 64 * 1024;
+inline constexpr uint64_t kHardSupervisionDiffBytes = 256 * 1024;
+inline constexpr uint64_t kDefaultSupervisionRetainedBatches = 32;
+inline constexpr uint64_t kHardSupervisionRetainedBatches = 128;
+inline constexpr uint64_t kDefaultSupervisionRetainedBytesPerViewer =
+    256 * 1024;
+inline constexpr uint64_t kHardSupervisionRetainedBytesPerViewer = 1024 * 1024;
+inline constexpr uint64_t kDefaultSupervisionDirtyDebounceMs = 50;
+inline constexpr uint64_t kHardSupervisionDirtyDebounceMs = 500;
+inline constexpr uint64_t kDefaultSupervisionAuditRows = 20;
+inline constexpr uint64_t kHardSupervisionAuditRows = 100;
+
+inline constexpr size_t kMaxSupervisionSafeLabelBytes = 96;
+inline constexpr size_t kMaxSupervisionSafeTitleBytes = 160;
+inline constexpr size_t kMaxSupervisionSafeOriginBytes = 256;
+inline constexpr char kSupervisionClientLabelFallback[] = "Local dashboard";
+inline constexpr char kSupervisionTargetTitleFallback[] = "Untitled tab";
+
+struct SupervisionLimits {
+  uint64_t pairing_code_characters = kDefaultSupervisionPairingCodeCharacters;
+  uint64_t pairing_code_ttl_ms = kDefaultSupervisionPairingCodeTtlMs;
+  uint64_t viewer_ttl_ms = kDefaultSupervisionViewerTtlMs;
+  uint64_t viewers_per_tab = kDefaultSupervisionViewersPerTab;
+  uint64_t sessions_per_profile = kDefaultSupervisionSessionsPerProfile;
+  uint64_t attempts_per_code = kDefaultSupervisionAttemptsPerCode;
+  uint64_t baseline_nodes = kDefaultSupervisionBaselineNodes;
+  uint64_t baseline_bytes = kDefaultSupervisionBaselineBytes;
+  uint64_t diff_operations = kDefaultSupervisionDiffOperations;
+  uint64_t diff_bytes = kDefaultSupervisionDiffBytes;
+  uint64_t retained_batches = kDefaultSupervisionRetainedBatches;
+  uint64_t retained_bytes_per_viewer =
+      kDefaultSupervisionRetainedBytesPerViewer;
+  uint64_t dirty_debounce_ms = kDefaultSupervisionDirtyDebounceMs;
+  uint64_t audit_rows = kDefaultSupervisionAuditRows;
+
+  bool operator==(const SupervisionLimits&) const = default;
+};
+
+// Browser-only, memory-only identity. No serializer is intentionally exposed.
+struct SupervisionStreamStamp {
+  base::UnguessableToken session;
+  int32_t stable_tab_id = 0;
+  base::UnguessableToken document_epoch;
+  uint64_t sequence = 0;
+
+  bool operator==(const SupervisionStreamStamp&) const = default;
+};
+
+// Browser-only target authority. Generations invalidate asynchronous work.
+// This type must never enter prefs, WebUI, audit, diagnostics, or MCP values.
+struct SupervisionTargetBinding {
+  int32_t stable_tab_id = 0;
+  base::UnguessableToken document_epoch;
+  uint64_t target_generation = 0;
+  uint64_t document_generation = 0;
+
+  bool operator==(const SupervisionTargetBinding&) const = default;
+};
+
+// Browser-only session/controller authority. No base::Value projection exists.
+struct SupervisionAuthorityBinding {
+  base::UnguessableToken session;
+  std::optional<base::UnguessableToken> controller_lease;
+  SupervisionTargetBinding target;
+  uint64_t authority_generation = 0;
+
+  bool operator==(const SupervisionAuthorityBinding&) const = default;
+};
+
+struct SupervisionTargetSnapshot {
+  std::string safe_title;
+  std::string safe_origin;
+  std::optional<std::string> owner_label;
+  bool eligible = false;
+  bool agent_active = false;
+  size_t viewer_count = 0;
+  std::optional<std::string> controller_label;
+};
+
+struct SupervisionClientSnapshot {
+  std::string display_label;
+  int64_t connected_at_ms = 0;
+  int64_t last_seen_at_ms = 0;
+  int64_t expires_at_ms = 0;
+};
+
+struct SupervisionSessionSnapshot {
+  SupervisionClientSnapshot client;
+  SupervisionViewerState viewer_state = SupervisionViewerState::kViewOnly;
+  SupervisionStreamState stream_state =
+      SupervisionStreamState::kPreparingBaseline;
+  SupervisionRemoteActionState action_state =
+      SupervisionRemoteActionState::kIdle;
+  std::optional<SupervisionRemoteActionCategory> action_category;
+  SupervisionTerminalReason terminal_reason = SupervisionTerminalReason::kNone;
+};
+
+struct SupervisionAuditSnapshot {
+  SupervisionAuditEvent event = SupervisionAuditEvent::kPairingCodeCreated;
+  int64_t timestamp_ms = 0;
+  std::optional<std::string> client_label;
+  std::string safe_target_title;
+  std::string safe_origin;
+  std::optional<SupervisionRemoteActionCategory> action_category;
+  SupervisionErrorCode error_code = SupervisionErrorCode::kNone;
+  int64_t duration_ms = 0;
+};
+
+struct SanitizedSupervisionSnapshot {
+  SupervisionPairingState pairing_state = SupervisionPairingState::kPending;
+  SupervisionTargetSnapshot target;
+  std::vector<SupervisionSessionSnapshot> sessions;
+  std::vector<SupervisionAuditSnapshot> audit;
+};
+
+std::optional<SupervisionPairingState> SupervisionPairingStateFromString(
+    std::string_view value);
+std::optional<std::string_view> SupervisionPairingStateToString(
+    SupervisionPairingState value);
+std::optional<SupervisionViewerState> SupervisionViewerStateFromString(
+    std::string_view value);
+std::optional<std::string_view> SupervisionViewerStateToString(
+    SupervisionViewerState value);
+std::optional<SupervisionStreamState> SupervisionStreamStateFromString(
+    std::string_view value);
+std::optional<std::string_view> SupervisionStreamStateToString(
+    SupervisionStreamState value);
+std::optional<SupervisionRemoteActionCategory>
+SupervisionRemoteActionCategoryFromString(std::string_view value);
+std::optional<std::string_view> SupervisionRemoteActionCategoryToString(
+    SupervisionRemoteActionCategory value);
+std::optional<SupervisionRemoteActionState>
+SupervisionRemoteActionStateFromString(std::string_view value);
+std::optional<std::string_view> SupervisionRemoteActionStateToString(
+    SupervisionRemoteActionState value);
+std::optional<SupervisionAuditEvent> SupervisionAuditEventFromString(
+    std::string_view value);
+std::optional<std::string_view> SupervisionAuditEventToString(
+    SupervisionAuditEvent value);
+std::optional<SupervisionTerminalReason> SupervisionTerminalReasonFromString(
+    std::string_view value);
+std::optional<std::string_view> SupervisionTerminalReasonToString(
+    SupervisionTerminalReason value);
+std::optional<SupervisionErrorCode> SupervisionErrorCodeFromString(
+    std::string_view value);
+std::optional<std::string_view> SupervisionErrorCodeToString(
+    SupervisionErrorCode value);
+
+bool IsLegalSupervisionPairingTransition(SupervisionPairingState from,
+                                         SupervisionPairingState to);
+bool IsTerminalSupervisionPairingState(SupervisionPairingState state);
+bool IsLegalSupervisionViewerTransition(SupervisionViewerState from,
+                                        SupervisionViewerState to);
+bool IsTerminalSupervisionViewerState(SupervisionViewerState state);
+bool IsLegalSupervisionStreamTransition(SupervisionStreamState from,
+                                        SupervisionStreamState to);
+bool IsLegalSupervisionRemoteActionTransition(SupervisionRemoteActionState from,
+                                              SupervisionRemoteActionState to);
+
+SupervisionLimits ClampSupervisionLimits(const SupervisionLimits& limits);
+std::optional<uint64_t> CheckedNextSupervisionSequence(uint64_t sequence);
+std::optional<uint64_t> CheckedNextSupervisionGeneration(uint64_t generation);
+bool IsValidSupervisionStreamStamp(const SupervisionStreamStamp& stamp);
+bool IsValidSupervisionTargetBinding(const SupervisionTargetBinding& binding);
+bool IsValidSupervisionPairingCode(std::string_view code);
+
+std::string DeriveSupervisionSafeClientLabel(std::string_view input);
+std::string DeriveSupervisionSafeTargetTitle(std::string_view input);
+std::optional<std::string> CanonicalizeSupervisionSafeOrigin(
+    std::string_view input);
+
+std::optional<base::DictValue> SupervisionTargetSnapshotToValue(
+    const SupervisionTargetSnapshot& snapshot,
+    const SupervisionLimits& limits = SupervisionLimits());
+std::optional<base::DictValue> SupervisionClientSnapshotToValue(
+    const SupervisionClientSnapshot& snapshot,
+    const SupervisionLimits& limits = SupervisionLimits());
+std::optional<base::DictValue> SupervisionSessionSnapshotToValue(
+    const SupervisionSessionSnapshot& snapshot,
+    const SupervisionLimits& limits = SupervisionLimits());
+std::optional<base::DictValue> SupervisionAuditSnapshotToValue(
+    const SupervisionAuditSnapshot& snapshot,
+    const SupervisionLimits& limits = SupervisionLimits());
+std::optional<base::DictValue> SanitizedSupervisionSnapshotToValue(
+    const SanitizedSupervisionSnapshot& snapshot,
+    const SupervisionLimits& limits = SupervisionLimits());
+
+}  // namespace prometheus
+
+#endif  // CHROME_BROWSER_PROMETHEUS_PROMETHEUS_SUPERVISION_TYPES_H_
