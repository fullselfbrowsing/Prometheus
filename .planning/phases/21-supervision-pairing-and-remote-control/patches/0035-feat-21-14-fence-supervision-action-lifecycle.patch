+TEST_F(PrometheusSupervisionProfileServiceTest,
+       ActionSingleConfirmationSlotAndStopCancelBeforeRelease) {
+  PrometheusAgentTabObservationLease owner_lease =
+      agent_service_->ObserveOrCreateTabData(&tab_, &observer_tab_data_);
+  ASSERT_NE(nullptr, owner_lease.data());
+  ASSERT_TRUE(owner_lease.data()->ClaimIfUnowned("owner-a", "Agent A").ok);
+  ReadyActionViewer ready = CreateReadyActionViewer();
+  std::vector<SupervisionActionResult> first_results;
+  service_->ExecuteDashboardAction(
+      ready.redemption.dashboard_session, ready.stamp.document_epoch.ToString(),
+      ready.stamp.sequence,
+      MakeNavigationAction("https://example.test/private-one"),
+      base::BindLambdaForTesting([&](SupervisionActionResult result) {
+        first_results.push_back(std::move(result));
+      }));
+  EXPECT_TRUE(first_results.empty());
+
+  std::optional<SupervisionActionResult> second_result;
+  service_->ExecuteDashboardAction(
+      ready.redemption.dashboard_session, ready.stamp.document_epoch.ToString(),
+      ready.stamp.sequence,
+      MakeNavigationAction("https://example.test/private-two"),
+      base::BindLambdaForTesting([&](SupervisionActionResult result) {
+        second_result.emplace(std::move(result));
+      }));
+  ASSERT_TRUE(second_result.has_value());
+  EXPECT_EQ(SupervisionErrorCode::kControllerConflict,
+            second_result->error_code);
+
+  ASSERT_TRUE(service_->StopControl(ready.redemption.dashboard_session).ok);
+  ASSERT_EQ(1u, first_results.size());
+  EXPECT_EQ(SupervisionErrorCode::kViewOnly, first_results[0].error_code);
+  SanitizedSupervisionSnapshot snapshot =
+      service_->GetSanitizedSnapshot(ready.redemption.stable_tab_id);
+  ASSERT_FALSE(snapshot.sessions.empty());
+  EXPECT_EQ(SupervisionRemoteActionState::kBlocked,
+            snapshot.sessions[0].action_state);
+  ASSERT_TRUE(snapshot.sessions[0].action_category.has_value());
+  EXPECT_EQ(SupervisionRemoteActionCategory::kNavigate,
+            *snapshot.sessions[0].action_category);
+  std::optional<base::DictValue> value =
+      SanitizedSupervisionSnapshotToValue(snapshot);
+  ASSERT_TRUE(value.has_value());
+  const std::string json = base::WriteJson(*value).value_or("");
+  EXPECT_EQ(std::string::npos, json.find("private-one"));
+}
