+
+// Finds the single visible dialog widget owned by `browser`'s window (the
+// native chrome.management.uninstall() confirmation) and presses its real,
+// public DialogDelegate::AcceptDialog() accept action -- the same call the
+// dialog's own OK button issues. This never bypasses, hides, or auto-answers
+// the dialog before it exists: it only presses the already-shown dialog's
+// real accept control.
+bool TryAcceptVisibleBrowserOwnedDialog(Browser* browser) {
+  if (!browser || !browser->window()) {
+    return false;
+  }
+  views::Widget* browser_widget =
+      views::Widget::GetWidgetForNativeWindow(browser->window()->GetNativeWindow());
+  if (!browser_widget) {
+    return false;
+  }
+  for (views::Widget* owned :
+      views::Widget::GetAllOwnedWidgets(browser_widget->GetNativeView())) {
+    if (!owned || !owned->IsVisible()) {
+      continue;
+    }
+    views::WidgetDelegate* delegate = owned->widget_delegate();
+    views::DialogDelegate* dialog =
+        delegate ? delegate->AsDialogDelegate() : nullptr;
+    if (dialog) {
+      dialog->AcceptDialog();
+      return true;
+    }
+  }
+  return false;
+}
