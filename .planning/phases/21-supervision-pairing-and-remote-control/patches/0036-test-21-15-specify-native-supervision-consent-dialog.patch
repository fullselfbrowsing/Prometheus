+namespace prometheus {
+namespace {
+
+void CollectLabelText(views::View* view, std::vector<std::u16string>* text) {
+  if (auto* label = views::AsViewClass<views::Label>(view)) {
+    text->emplace_back(label->GetText());
+  }
+  for (views::View* child : view->children()) {
+    CollectLabelText(child, text);
+  }
+}
+
+bool ContainsOrderedText(const std::vector<std::u16string>& actual,
+                         const std::vector<std::u16string>& expected) {
+  size_t next = 0;
+  for (const std::u16string& text : actual) {
+    if (next < expected.size() && text == expected[next]) {
+      ++next;
+    }
+  }
+  return next == expected.size();
+}
+
+std::u16string JoinLabelText(views::View* root) {
+  std::vector<std::u16string> labels;
+  CollectLabelText(root, &labels);
+  std::u16string joined;
+  for (const std::u16string& label : labels) {
+    joined.append(label);
+    joined.push_back(u'\n');
+  }
+  return joined;
+}
+
+class PrometheusSupervisionConfirmationBrowserTest
+    : public InProcessBrowserTest {
+ protected:
+  PrometheusSupervisionDialogModel EnableModel() const {
+    PrometheusSupervisionDialogModel model;
+    model.kind = PrometheusSupervisionDialogKind::kEnableControl;
+    model.client_label = "Review console";
+    model.target_tab_title = "Quarterly report";
+    model.site_origin = "https://example.test";
+    model.expires_label = "10:45 AM";
+    return model;
+  }
+
+  PrometheusSupervisionDialogModel ConsequentialModel() const {
+    PrometheusSupervisionDialogModel model = EnableModel();
+    model.kind = PrometheusSupervisionDialogKind::kConsequentialAction;
+    model.action_label = "Navigate";
+    model.permission_boundary = "Page actions";
+    return model;
+  }
+
+  views::DialogDelegate* CurrentDialog() const {
+    views::Widget* widget = PrometheusRuntimeDialogWidgetForTesting();
+    return widget ? widget->widget_delegate()->AsDialogDelegate() : nullptr;
+  }
+
+  void ExpectSafeFocus(views::DialogDelegate* dialog) {
+    ASSERT_TRUE(dialog);
+    ASSERT_TRUE(dialog->GetCancelButton());
+    EXPECT_EQ(static_cast<int>(ui::mojom::DialogButton::kCancel),
+              dialog->GetDefaultDialogButton());
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return dialog->GetWidget()->GetFocusManager()->GetFocusedView() ==
+             dialog->GetCancelButton();
+    }));
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(PrometheusSupervisionConfirmationBrowserTest,
+                       EnableControlHasExactCopyRowsAndSafeFocus) {
+  int replies = 0;
+  PrometheusSupervisionDialogResult result =
+      PrometheusSupervisionDialogResult::kApproved;
+  ASSERT_TRUE(ShowPrometheusSupervisionDialog(
+      browser(), EnableModel(),
+      base::BindOnce(
+          [](int* replies, PrometheusSupervisionDialogResult* result,
+             PrometheusSupervisionDialogResult reply) {
+            ++*replies;
+            *result = reply;
+          },
+          &replies, &result)));
+  views::Widget* widget = PrometheusRuntimeDialogWidgetForTesting();
+  ASSERT_TRUE(widget);
+  views::DialogDelegate* dialog = CurrentDialog();
+  ASSERT_TRUE(dialog);
+  EXPECT_EQ(PrometheusRuntimeDialogKind::kSupervisionEnableControl,
+            PrometheusRuntimeDialogKindForTesting());
+  EXPECT_EQ(u"Enable remote control?", dialog->GetWindowTitle());
+  EXPECT_EQ(u"Enable control", dialog->GetDialogButtonLabel(
+                                   ui::mojom::DialogButton::kOk));
+  EXPECT_EQ(u"Keep view only", dialog->GetDialogButtonLabel(
+                                    ui::mojom::DialogButton::kCancel));
+  std::vector<std::u16string> labels;
+  CollectLabelText(widget->GetRootView(), &labels);
+  EXPECT_TRUE(ContainsOrderedText(
+      labels,
+      {u"Review console can act in Quarterly report until 10:45 AM. "
+       u"Prometheus will still enforce tab ownership, permissions, target "
+       u"validation, and confirmations.",
+       u"Client", u"Review console", u"Target tab", u"Quarterly report",
+       u"Site origin", u"https://example.test", u"Access", u"Page actions",
+       u"Expires", u"10:45 AM", u"Vault", u"Confirmation required"}));
+  ExpectSafeFocus(dialog);
+  dialog->CancelDialog();
+  ASSERT_TRUE(base::test::RunUntil(
+      []() { return !PrometheusRuntimeDialogWidgetForTesting(); }));
+  EXPECT_EQ(1, replies);
+  EXPECT_EQ(PrometheusSupervisionDialogResult::kDenied, result);
+}
+
+IN_PROC_BROWSER_TEST_F(PrometheusSupervisionConfirmationBrowserTest,
+                       EnableControlEscapeAndCloseDenyExactlyOnce) {
+  int escape_replies = 0;
+  PrometheusSupervisionDialogResult escape_result =
+      PrometheusSupervisionDialogResult::kApproved;
+  ASSERT_TRUE(ShowPrometheusSupervisionDialog(
+      browser(), EnableModel(),
+      base::BindOnce(
+          [](int* replies, PrometheusSupervisionDialogResult* result,
+             PrometheusSupervisionDialogResult reply) {
+            ++*replies;
+            *result = reply;
+          },
+          &escape_replies, &escape_result)));
+  views::Widget* escape_widget = PrometheusRuntimeDialogWidgetForTesting();
+  ASSERT_TRUE(escape_widget);
+  views::test::WidgetDestroyedWaiter escape_waiter(escape_widget);
+  EXPECT_TRUE(escape_widget->client_view()->AcceleratorPressed(
+      ui::Accelerator(ui::VKEY_ESCAPE, 0)));
+  escape_waiter.Wait();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1, escape_replies);
+  EXPECT_EQ(PrometheusSupervisionDialogResult::kDenied, escape_result);
+
+  int close_replies = 0;
+  PrometheusSupervisionDialogResult close_result =
+      PrometheusSupervisionDialogResult::kApproved;
+  ASSERT_TRUE(ShowPrometheusSupervisionDialog(
+      browser(), EnableModel(),
+      base::BindOnce(
+          [](int* replies, PrometheusSupervisionDialogResult* result,
+             PrometheusSupervisionDialogResult reply) {
+            ++*replies;
+            *result = reply;
+          },
+          &close_replies, &close_result)));
+  views::Widget* close_widget = PrometheusRuntimeDialogWidgetForTesting();
+  ASSERT_TRUE(close_widget);
+  views::test::WidgetDestroyedWaiter close_waiter(close_widget);
+  close_widget->Close();
+  close_waiter.Wait();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1, close_replies);
+  EXPECT_EQ(PrometheusSupervisionDialogResult::kDenied, close_result);
+}
+
+IN_PROC_BROWSER_TEST_F(PrometheusSupervisionConfirmationBrowserTest,
+                       ConsequentialCopyIsClosedAndRawValuesStayAbsent) {
+  constexpr char16_t kRawText[] = u"RAW-TYPED-VALUE-SENTINEL";
+  constexpr char16_t kRawKey[] = u"RAW-KEY-SENTINEL";
+  constexpr char16_t kRawUrl[] = u"private-destination?secret=sentinel";
+  int replies = 0;
+  ASSERT_TRUE(ShowPrometheusSupervisionDialog(
+      browser(), ConsequentialModel(),
+      base::BindOnce(
+          [](int* replies, PrometheusSupervisionDialogResult) { ++*replies; },
+          &replies)));
+  views::Widget* widget = PrometheusRuntimeDialogWidgetForTesting();
+  ASSERT_TRUE(widget);
+  views::DialogDelegate* dialog = CurrentDialog();
+  ASSERT_TRUE(dialog);
+  EXPECT_EQ(PrometheusRuntimeDialogKind::kSupervisionConsequentialAction,
+            PrometheusRuntimeDialogKindForTesting());
+  EXPECT_EQ(u"Confirm remote action", dialog->GetWindowTitle());
+  EXPECT_EQ(u"Allow once", dialog->GetDialogButtonLabel(
+                               ui::mojom::DialogButton::kOk));
+  EXPECT_EQ(u"Block action", dialog->GetDialogButtonLabel(
+                                 ui::mojom::DialogButton::kCancel));
+  std::vector<std::u16string> labels;
+  CollectLabelText(widget->GetRootView(), &labels);
+  EXPECT_TRUE(ContainsOrderedText(
+      labels,
+      {u"Review console wants to Navigate in Quarterly report. Prometheus "
+       u"will recheck ownership, permissions, and the current page before "
+       u"acting.",
+       u"Client", u"Review console", u"Target tab", u"Quarterly report",
+       u"Site origin", u"https://example.test", u"Action", u"Navigate",
+       u"Controller expires", u"10:45 AM", u"Permission boundary",
+       u"Page actions"}));
+  const std::u16string all_text = JoinLabelText(widget->GetRootView());
+  EXPECT_EQ(std::u16string::npos, all_text.find(kRawText));
+  EXPECT_EQ(std::u16string::npos, all_text.find(kRawKey));
+  EXPECT_EQ(std::u16string::npos, all_text.find(kRawUrl));
+  ExpectSafeFocus(dialog);
+  dialog->CancelDialog();
+  ASSERT_TRUE(base::test::RunUntil(
+      []() { return !PrometheusRuntimeDialogWidgetForTesting(); }));
+  EXPECT_EQ(1, replies);
+}
+
+}  // namespace
