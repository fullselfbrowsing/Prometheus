+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_extension_page_adapter.h"
+
+#include <utility>
+
+#include "chrome/browser/prometheus/prometheus_agent_session.h"
+#include "chrome/browser/prometheus/prometheus_extension_policy_service.h"
+
+namespace prometheus {
+
+PrometheusExtensionPageAdapter::PrometheusExtensionPageAdapter(
+    PrometheusExtensionPolicyService* policy_service)
+    : policy_service_(policy_service) {}
+
+PrometheusExtensionPageAdapter::~PrometheusExtensionPageAdapter() = default;
+
+void PrometheusExtensionPageAdapter::Execute(
+    const AgentRouteRequest& request,
+    Browser* browser,
+    tabs::TabInterface* anchor_tab,
+    const AgentSession& session,
+    CompletionCallback callback) {
+  std::move(callback).Run(AgentRouteResult::Failure(
+      AgentErrorCode::kCapabilityNotReady,
+      "Extension page dispatch is not implemented",
+      "Retry after extension page dispatch is available"));
+}
+
+// static
+PrometheusExtensionRouteFamily
+PrometheusExtensionPageAdapter::RouteFamilyForTesting(
+    AgentRouteName route_name) {
+  return PrometheusExtensionRouteFamily::kOutsidePageBoundary;
+}
+
+// static
+PrometheusExtensionAdmissionDecision
+PrometheusExtensionPageAdapter::EvaluateAdmissionForTesting(
+    AgentRouteName route_name,
+    ExtensionAgentGrant grant,
+    const PrometheusExtensionAdmissionEvidence& evidence) {
+  return {};
+}
+
+// static
+bool PrometheusExtensionPageAdapter::ShouldUseExtensionAdapterForTesting(
+    bool has_extension_surface_selector,
+    const GURL& committed_primary_url) {
+  return false;
+}
+
+// static
+PrometheusExtensionAuditProjection
+PrometheusExtensionPageAdapter::BuildAuditProjectionForTesting(
+    std::string extension_id,
+    PrometheusExtensionSurfaceKind surface,
+    ExtensionAgentGrant grant,
+    std::string result) {
+  return {};
+}
+
+// static
+bool PrometheusExtensionPageAdapter::IsAuditProjectionSafeForTesting(
+    const PrometheusExtensionAuditProjection& projection) {
+  return false;
+}
+
+bool ExtensionAgentDispatchContractImplementedForTesting() {
+  return false;
+}
+
+}  // namespace prometheus
diff --git a/chrome/browser/prometheus/prometheus_extension_page_adapter.h b/chrome/browser/prometheus/prometheus_extension_page_adapter.h
new file mode 100644
index 0000000000..4e55bfd106
--- /dev/null
+++ b/chrome/browser/prometheus/prometheus_extension_page_adapter.h
@@ -0,0 +1,119 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PROMETHEUS_PROMETHEUS_EXTENSION_PAGE_ADAPTER_H_
+#define CHROME_BROWSER_PROMETHEUS_PROMETHEUS_EXTENSION_PAGE_ADAPTER_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/prometheus/prometheus_agent_route.h"
+#include "chrome/browser/prometheus/prometheus_extension_policy_types.h"
+#include "chrome/browser/prometheus/prometheus_extension_surface_resolver.h"
+#include "url/gurl.h"
+
+class Browser;
+
+namespace tabs {
+class TabInterface;
+}
+
+namespace prometheus {
+
+class PrometheusExtensionPolicyService;
+struct AgentSession;
+
+enum class PrometheusExtensionRouteFamily {
+  kRead,
+  kInteract,
+  kScript,
+  kAlwaysDenied,
+  kOutsidePageBoundary,
+};
+
+enum class PrometheusExtensionAdmissionDenial {
+  kNone,
+  kSurfaceBlocked,
+  kReadDenied,
+  kInteractionDenied,
+  kScriptDenied,
+  kUnsupportedRoute,
+  kStalePolicy,
+  kPrivateDenied,
+  kUnavailable,
+};
+
+struct PrometheusExtensionAdmissionEvidence {
+  bool surface_resolved = true;
+  bool policy_generation_current = true;
+  bool exact_browser_context = true;
+  bool visible = true;
+  bool exact_document = true;
+  bool private_mode = false;
+  bool private_policy_allowed = true;
+};
+
+struct PrometheusExtensionAdmissionDecision {
+  bool allowed = false;
+  PrometheusExtensionRouteFamily family =
+      PrometheusExtensionRouteFamily::kOutsidePageBoundary;
+  PrometheusExtensionAdmissionDenial denial =
+      PrometheusExtensionAdmissionDenial::kUnavailable;
+  AgentErrorCode error_code = AgentErrorCode::kPermissionBlocked;
+};
+
+struct PrometheusExtensionAuditProjection {
+  std::string id_suffix;
+  std::string surface;
+  std::string grant;
+  std::string result;
+};
+
+class PrometheusExtensionPageAdapter {
+ public:
+  using CompletionCallback = base::OnceCallback<void(AgentRouteResult)>;
+
+  explicit PrometheusExtensionPageAdapter(
+      PrometheusExtensionPolicyService* policy_service);
+  PrometheusExtensionPageAdapter(const PrometheusExtensionPageAdapter&) =
+      delete;
+  PrometheusExtensionPageAdapter& operator=(
+      const PrometheusExtensionPageAdapter&) = delete;
+  ~PrometheusExtensionPageAdapter();
+
+  void Execute(const AgentRouteRequest& request,
+               Browser* browser,
+               tabs::TabInterface* anchor_tab,
+               const AgentSession& session,
+               CompletionCallback callback);
+
+  static PrometheusExtensionRouteFamily RouteFamilyForTesting(
+      AgentRouteName route_name);
+  static PrometheusExtensionAdmissionDecision EvaluateAdmissionForTesting(
+      AgentRouteName route_name,
+      ExtensionAgentGrant grant,
+      const PrometheusExtensionAdmissionEvidence& evidence);
+  static bool ShouldUseExtensionAdapterForTesting(
+      bool has_extension_surface_selector,
+      const GURL& committed_primary_url);
+  static PrometheusExtensionAuditProjection BuildAuditProjectionForTesting(
+      std::string extension_id,
+      PrometheusExtensionSurfaceKind surface,
+      ExtensionAgentGrant grant,
+      std::string result);
+  static bool IsAuditProjectionSafeForTesting(
+      const PrometheusExtensionAuditProjection& projection);
+
+ private:
+  raw_ptr<PrometheusExtensionPolicyService> policy_service_;
+  base::WeakPtrFactory<PrometheusExtensionPageAdapter> weak_factory_{this};
+};
+
+bool ExtensionAgentDispatchContractImplementedForTesting();
+
+}  // namespace prometheus
+
+#endif  // CHROME_BROWSER_PROMETHEUS_PROMETHEUS_EXTENSION_PAGE_ADAPTER_H_
diff --git a/chrome/browser/prometheus/prometheus_extension_page_adapter_unittest.cc b/chrome/browser/prometheus/prometheus_extension_page_adapter_unittest.cc
new file mode 100644
index 0000000000..d1a63649b0
--- /dev/null
+++ b/chrome/browser/prometheus/prometheus_extension_page_adapter_unittest.cc
@@ -0,0 +1,177 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_extension_page_adapter.h"
+
+#include <array>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace prometheus {
+namespace {
+
+constexpr auto kReadRoutes = std::to_array<AgentRouteName>({
+    AgentRouteName::kReadPage,
+    AgentRouteName::kGetDomSnapshot,
+    AgentRouteName::kGetPageSnapshot,
+    AgentRouteName::kGetText,
+    AgentRouteName::kGetAttribute,
+});
+
+constexpr auto kInteractRoutes = std::to_array<AgentRouteName>({
+    AgentRouteName::kClick,
+    AgentRouteName::kTypeText,
+    AgentRouteName::kPressKey,
+    AgentRouteName::kScroll,
+    AgentRouteName::kHover,
+    AgentRouteName::kSelectOption,
+    AgentRouteName::kClear,
+});
+
+void RequireGreenContract() {
+  ASSERT_TRUE(ExtensionAgentDispatchContractImplementedForTesting())
+      << "retained RED: the extension Agent dispatch boundary is not "
+         "implemented";
+}
+
+PrometheusExtensionAdmissionDecision Decide(AgentRouteName route,
+                                            ExtensionAgentGrant grant) {
+  return PrometheusExtensionPageAdapter::EvaluateAdmissionForTesting(
+      route, grant, PrometheusExtensionAdmissionEvidence());
+}
+
+TEST(PrometheusExtensionAgentAdapterTest, BlockedDeniesEveryReadAndAction) {
+  RequireGreenContract();
+  for (AgentRouteName route : kReadRoutes) {
+    const auto decision = Decide(route, ExtensionAgentGrant::kBlocked);
+    EXPECT_FALSE(decision.allowed);
+    EXPECT_EQ(PrometheusExtensionAdmissionDenial::kReadDenied,
+              decision.denial);
+  }
+  for (AgentRouteName route : kInteractRoutes) {
+    const auto decision = Decide(route, ExtensionAgentGrant::kBlocked);
+    EXPECT_FALSE(decision.allowed);
+    EXPECT_EQ(PrometheusExtensionAdmissionDenial::kInteractionDenied,
+              decision.denial);
+  }
+}
+
+TEST(PrometheusExtensionAgentAdapterTest, ReadOnlyAllowsExactlyFiveReads) {
+  RequireGreenContract();
+  for (AgentRouteName route : kReadRoutes) {
+    const auto decision = Decide(route, ExtensionAgentGrant::kReadOnly);
+    EXPECT_TRUE(decision.allowed);
+    EXPECT_EQ(PrometheusExtensionRouteFamily::kRead, decision.family);
+  }
+  for (AgentRouteName route : kInteractRoutes) {
+    const auto decision = Decide(route, ExtensionAgentGrant::kReadOnly);
+    EXPECT_FALSE(decision.allowed);
+    EXPECT_EQ(PrometheusExtensionAdmissionDenial::kInteractionDenied,
+              decision.denial);
+  }
+}
+
+TEST(PrometheusExtensionAgentAdapterTest,
+     InteractAddsExactlySevenTypedActions) {
+  RequireGreenContract();
+  for (AgentRouteName route : kReadRoutes) {
+    EXPECT_TRUE(Decide(route, ExtensionAgentGrant::kInteract).allowed);
+  }
+  for (AgentRouteName route : kInteractRoutes) {
+    const auto decision = Decide(route, ExtensionAgentGrant::kInteract);
+    EXPECT_TRUE(decision.allowed);
+    EXPECT_EQ(PrometheusExtensionRouteFamily::kInteract, decision.family);
+  }
+}
+
+TEST(PrometheusExtensionAgentAdapterTest, ScriptsDragAndDropRemainDenied) {
+  RequireGreenContract();
+  for (ExtensionAgentGrant grant :
+       {ExtensionAgentGrant::kBlocked, ExtensionAgentGrant::kReadOnly,
+        ExtensionAgentGrant::kInteract}) {
+    const auto script = Decide(AgentRouteName::kExecuteJs, grant);
+    EXPECT_FALSE(script.allowed);
+    EXPECT_EQ(PrometheusExtensionAdmissionDenial::kScriptDenied,
+              script.denial);
+    for (AgentRouteName route :
+         {AgentRouteName::kDrag, AgentRouteName::kDropFile}) {
+      const auto denied = Decide(route, grant);
+      EXPECT_FALSE(denied.allowed);
+      EXPECT_EQ(PrometheusExtensionAdmissionDenial::kUnsupportedRoute,
+                denied.denial);
+    }
+  }
+}
+
+TEST(PrometheusExtensionAgentAdapterTest,
+     ExecutionRevalidatesPolicyVisibilityContextAndDocument) {
+  RequireGreenContract();
+  PrometheusExtensionAdmissionEvidence evidence;
+  for (bool* condition :
+       {&evidence.surface_resolved, &evidence.policy_generation_current,
+        &evidence.exact_browser_context, &evidence.visible,
+        &evidence.exact_document}) {
+    *condition = false;
+    const auto decision =
+        PrometheusExtensionPageAdapter::EvaluateAdmissionForTesting(
+            AgentRouteName::kClick, ExtensionAgentGrant::kInteract, evidence);
+    EXPECT_FALSE(decision.allowed);
+    EXPECT_NE(PrometheusExtensionAdmissionDenial::kNone, decision.denial);
+    *condition = true;
+  }
+}
+
+TEST(PrometheusExtensionAgentAdapterTest,
+     PrivatePolicyIsExplicitAndNeverInherited) {
+  RequireGreenContract();
+  PrometheusExtensionAdmissionEvidence evidence;
+  evidence.private_mode = true;
+  evidence.private_policy_allowed = false;
+  const auto decision =
+      PrometheusExtensionPageAdapter::EvaluateAdmissionForTesting(
+          AgentRouteName::kReadPage, ExtensionAgentGrant::kInteract, evidence);
+  EXPECT_FALSE(decision.allowed);
+  EXPECT_EQ(PrometheusExtensionAdmissionDenial::kPrivateDenied,
+            decision.denial);
+}
+
+TEST(PrometheusExtensionAgentAdapterTest,
+     ContentScriptHttpPageKeepsNormalPageProvenance) {
+  RequireGreenContract();
+  EXPECT_FALSE(
+      PrometheusExtensionPageAdapter::ShouldUseExtensionAdapterForTesting(
+          false, GURL("https://example.test/content-script-host")));
+  EXPECT_TRUE(
+      PrometheusExtensionPageAdapter::ShouldUseExtensionAdapterForTesting(
+          false, GURL("chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/"
+                      "page.html")));
+  EXPECT_TRUE(
+      PrometheusExtensionPageAdapter::ShouldUseExtensionAdapterForTesting(
+          true, GURL("https://example.test/anchor")));
+}
+
+TEST(PrometheusExtensionAgentAdapterTest,
+     AuditProjectionIsSuffixOnlyClosedAndContentFree) {
+  RequireGreenContract();
+  const auto projection =
+      PrometheusExtensionPageAdapter::BuildAuditProjectionForTesting(
+          "aaaaaaaaaaaaaaaaaaaaaaaaaabc123",
+          PrometheusExtensionSurfaceKind::kPopup,
+          ExtensionAgentGrant::kReadOnly, "allowed");
+  EXPECT_EQ("abc123", projection.id_suffix);
+  EXPECT_EQ("popup", projection.surface);
+  EXPECT_EQ("read_only", projection.grant);
+  EXPECT_EQ("allowed", projection.result);
+  EXPECT_TRUE(
+      PrometheusExtensionPageAdapter::IsAuditProjectionSafeForTesting(
+          projection));
+
+  auto unsafe = projection;
+  unsafe.result = "page_content=sentinel";
+  EXPECT_FALSE(
+      PrometheusExtensionPageAdapter::IsAuditProjectionSafeForTesting(unsafe));
+}
+
+}  // namespace
+}  // namespace prometheus
