+TEST(PrometheusSupervisionTransportCodecTest,
+     CompatibilitySerializationStructurallyOmitsDashboardAuthority) {
+  SupervisionTransportResult result =
+      MakeDashboardResult(SupervisionTransportOperation::kBaseline);
+  auto serialized = SerializeSupervisionCompatibilityResult(result);
+  ASSERT_TRUE(serialized.has_value()) << serialized.error().message;
+  constexpr std::array<std::string_view, 10> kForbidden = {
+      "dashboard_session", "document_epoch", "sequence",
+      kDashboardSession,   kDocumentEpoch,   "pairing_code",
+      "controller_lease",  "profile_path",   "browser_id",
+      "owner_id",
+  };
+  for (std::string_view forbidden : kForbidden) {
+    EXPECT_EQ(std::string::npos, serialized->find(forbidden)) << forbidden;
+  }
+  EXPECT_NE(std::string::npos, serialized->find("safe_title"));
+  EXPECT_NE(std::string::npos, serialized->find("Release notes"));
+}
