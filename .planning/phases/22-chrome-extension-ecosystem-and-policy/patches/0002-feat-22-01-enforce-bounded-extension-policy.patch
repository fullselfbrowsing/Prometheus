+ExtensionPolicySource PolicySourceForExtension(
+    const extensions::Extension& extension) {
+  if (extensions::Manifest::IsComponentLocation(extension.location())) {
+    return ExtensionPolicySource::kComponent;
+  }
+  if (extensions::Manifest::IsPolicyLocation(extension.location())) {
+    return ExtensionPolicySource::kPolicy;
+  }
+  if (extensions::Manifest::IsUnpackedLocation(extension.location())) {
+    return ExtensionPolicySource::kUnpacked;
+  }
+  if (extension.location() == extensions::mojom::ManifestLocation::kInternal) {
+    return ExtensionPolicySource::kWebStore;
+  }
+  return ExtensionPolicySource::kOther;
+}
+
+bool InventoryOrder(const ExtensionPolicyInventoryEntry& left,
+                    const ExtensionPolicyInventoryEntry& right) {
+  return left.extension_id < right.extension_id;
+}
