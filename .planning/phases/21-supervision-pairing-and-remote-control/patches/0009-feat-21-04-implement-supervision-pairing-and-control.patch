     Profile* profile,
@@ -98,58 +223,365 @@ PrometheusSupervisionProfileService::CreatePairing(
     BrowserWindowInterface* exact_browser,
     tabs::TabInterface* exact_tab) {
   SupervisionPairingCreationResult result;
-  static_cast<SupervisionServiceResult&>(result) = UnavailableResult();
+  if (shutdown_ || profile_kind_ != SupervisionProfileKind::kRegular ||
+      !observe_tab_data_) {
+    static_cast<SupervisionServiceResult&>(result) = UnavailableResult();
+    return result;
+  }
+  if (!IsEligibleTarget(profile_, exact_browser, exact_tab)) {
+    static_cast<SupervisionServiceResult&>(result) = ServiceFailure(
+        SupervisionErrorCode::kRestrictedTarget,
+        "The selected tab is not eligible for supervision",
+        "Choose a live HTTP or HTTPS tab in this regular profile");
+    return result;
+  }
+  base::WeakPtr<BrowserWindowInterface> exact_browser_weak =
+      exact_browser->GetWeakPtr();
+  if (!exact_browser_weak) {
+    static_cast<SupervisionServiceResult&>(result) =
+        ServiceFailure(SupervisionErrorCode::kStaleTarget,
+                       "The selected browser is no longer available",
+                       "Choose the tab again from a live browser window");
+    return result;
+  }
+
+  SweepExpired();
+  const int32_t stable_tab_id = exact_tab->GetHandle().raw_value();
+  if (!AcquireObservedTab(exact_tab)) {
+    static_cast<SupervisionServiceResult&>(result) =
+        ServiceFailure(SupervisionErrorCode::kStaleTarget,
+                       "The selected tab could not be observed",
+                       "Choose the tab again and retry");
+    return result;
+  }
+
+  auto previous = pending_pairings_.find(stable_tab_id);
+  if (previous != pending_pairings_.end()) {
+    if (previous->second->state == SupervisionPairingState::kPending) {
+      last_pairing_states_[stable_tab_id] = SupervisionPairingState::kCancelled;
+      AddAudit(stable_tab_id, SupervisionAuditEvent::kPairingCodeCancelled,
+               std::nullopt);
+    }
+    pending_pairings_.erase(previous);
+  }
+
+  while (pending_pairings_.size() >= limits_.sessions_per_profile) {
+    auto terminal = std::find_if(
+        pending_pairings_.begin(), pending_pairings_.end(),
+        [](const auto& entry) {
+          return entry.second->state != SupervisionPairingState::kPending;
+        });
+    if (terminal == pending_pairings_.end()) {
+      static_cast<SupervisionServiceResult&>(result) =
+          ServiceFailure(SupervisionErrorCode::kTooLarge,
+                         "The profile pairing limit has been reached",
+                         "Cancel an existing pairing and retry");
+      ReleaseObservedTabIfUnused(stable_tab_id);
+      return result;
+    }
+    pending_pairings_.erase(terminal);
+  }
+
+  const std::string pairing_code = GeneratePairingCode();
+  if (!IsValidSupervisionPairingCode(pairing_code)) {
+    static_cast<SupervisionServiceResult&>(result) = ServiceFailure(
+        SupervisionErrorCode::kShutdown,
+        "A pairing code could not be generated", "Retry pairing");
+    ReleaseObservedTabIfUnused(stable_tab_id);
+    return result;
+  }
+
+  const base::Time now = Now();
+  auto pairing = std::make_unique<PendingPairing>();
+  pairing->stable_tab_id = stable_tab_id;
+  pairing->tab = exact_tab;
+  pairing->exact_browser = std::move(exact_browser_weak);
+  pairing->salt = base::RandBytesAsString(kPairingSaltBytes);
+  pairing->digest = PairingDigest(pairing->salt, pairing_code);
+  pairing->created_at = now;
+  pairing->expires_at = now + PairingTtl(limits_);
+  pairing->serial = ++next_pairing_serial_;
+  result.stable_tab_id = stable_tab_id;
+  result.expires_at = pairing->expires_at;
+  pending_pairings_[stable_tab_id] = std::move(pairing);
+  last_pairing_states_[stable_tab_id] = SupervisionPairingState::kPending;
+  AddAudit(stable_tab_id, SupervisionAuditEvent::kPairingCodeCreated,
+           std::nullopt);
+  NotifySnapshotChanged(stable_tab_id);
+
+  static_cast<SupervisionServiceResult&>(result) =
+      SupervisionServiceResult::Success();
+  result.pairing_code = pairing_code;
   return result;
 }
 
 SupervisionServiceResult PrometheusSupervisionProfileService::CancelPairing(
     int32_t stable_tab_id) {
-  return UnavailableResult();
+  if (shutdown_) {
+    return UnavailableResult();
+  }
+  SweepExpired();
+  auto pairing = pending_pairings_.find(stable_tab_id);
+  if (pairing == pending_pairings_.end() ||
+      pairing->second->state != SupervisionPairingState::kPending) {
+    return ServiceFailure(SupervisionErrorCode::kInvalidCode,
+                          "No pending pairing exists for this tab",
+                          "Create a new pairing");
+  }
+  last_pairing_states_[stable_tab_id] = SupervisionPairingState::kCancelled;
+  pending_pairings_.erase(pairing);
+  AddAudit(stable_tab_id, SupervisionAuditEvent::kPairingCodeCancelled,
+           std::nullopt);
+  NotifySnapshotChanged(stable_tab_id);
+  ScheduleObservedTabRelease(stable_tab_id);
+  return SupervisionServiceResult::Success();
 }
 
 SupervisionRedemptionResult PrometheusSupervisionProfileService::RedeemPairing(
     std::string_view pairing_code,
     std::string_view client_label) {
   SupervisionRedemptionResult result;
-  static_cast<SupervisionServiceResult&>(result) = UnavailableResult();
+  if (shutdown_ || profile_kind_ != SupervisionProfileKind::kRegular) {
+    static_cast<SupervisionServiceResult&>(result) = UnavailableResult();
+    return result;
+  }
+
+  SweepExpired();
+  const base::Time now = Now();
+  if (failed_attempts_.size() >= limits_.attempts_per_code) {
+    static_cast<SupervisionServiceResult&>(result) =
+        ServiceFailure(SupervisionErrorCode::kAttemptCapReached,
+                       "The pairing attempt limit has been reached",
+                       "Wait for the attempt window to expire before retrying");
+    return result;
+  }
+
+  const std::string normalized = NormalizePairingCode(pairing_code);
+  PendingPairing* pairing = FindPendingPairing(normalized);
+  if (!pairing) {
+    failed_attempts_.push_back(now);
+    static_cast<SupervisionServiceResult&>(result) = ServiceFailure(
+        SupervisionErrorCode::kInvalidCode, "The pairing code is invalid",
+        "Check the one-time code and retry");
+    return result;
+  }
+
+  const int32_t stable_tab_id = pairing->stable_tab_id;
+  if (pairing->state == SupervisionPairingState::kExpired ||
