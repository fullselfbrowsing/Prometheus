+RuntimeTransportResult DiscoveryTransportResult(
+    RuntimeDiscoveryResult discovery) {
+  if (discovery.status != RuntimeProfileStatus::kOk) {
+    return RuntimeStatusFailure(RuntimeRouteName::kDiscoverModels,
+                                discovery.status,
+                                std::move(discovery.sanitized_error));
+  }
+  if (discovery.operation_id == 0) {
+    return RuntimeTransportResult::Failure(
+        RuntimeRouteName::kDiscoverModels, RuntimeTransportErrorCode::kInternal,
+        "The model discovery operation was invalid",
+        "Retry model discovery from the same browser-issued session");
+  }
+  ClampList(&discovery.models, kMaxPrometheusDiscoveredModels);
+  return RuntimeTransportResult::Success(
+      RuntimeRouteName::kDiscoverModels,
+      RuntimeModelListResult{
+          .operation_id = base::NumberToString(discovery.operation_id),
+          .models = std::move(discovery.models),
+          .pending = discovery.pending,
+      });
