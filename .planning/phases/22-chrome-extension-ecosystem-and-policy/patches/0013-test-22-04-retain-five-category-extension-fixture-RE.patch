+  return false;
+}
+
+}  // namespace
+
+class PrometheusExtensionFixturesBrowserTest : public InProcessBrowserTest {
+ public:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    embedded_test_server()->ServeFilesFromSourceDirectory(
+        GetChromeTestDataDir());
+  }
+
+ protected:
+  base::FilePath ChromeTestDataRoot() const {
+    return base::PathService::CheckedGet(base::DIR_SRC_TEST_DATA_ROOT)
+        .Append(GetChromeTestDataDir());
+  }
+
+  base::FilePath FixtureRoot() const {
+    return ChromeTestDataRoot()
+        .AppendASCII("prometheus")
+        .AppendASCII("extensions");
+  }
+
+  void CopyFixture(extensions::TestExtensionDir* destination,
+                   std::string_view fixture_name,
+                   std::initializer_list<const char*> files) {
+    const base::FilePath source =
+        FixtureRoot().AppendASCII(std::string(fixture_name));
+    for (const char* file : files) {
+      destination->CopyFileTo(
+          source.AppendASCII(file), base::FilePath::FromASCII(file).value());
+    }
+  }
+
+  scoped_refptr<const extensions::Extension> LoadFixture(
+      extensions::TestExtensionDir* fixture,
+      extensions::ChromeTestExtensionLoader* loader) {
+    scoped_refptr<const extensions::Extension> extension =
+        loader->LoadExtension(fixture->UnpackedPath());
+    EXPECT_TRUE(extension);
+    if (extension) {
+      EXPECT_EQ(3, extension->manifest_version());
+    }
+    return extension;
+  }
+
+  content::WebContents* active_web_contents() {
+    return browser()->tab_strip_model()->GetActiveWebContents();
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(PrometheusExtensionFixturesBrowserTest,
+                       PasswordManagerLikeLifecycleAndIsolation) {
+  extensions::TestExtensionDir fixture;
+  CopyFixture(&fixture, "password_manager_like",
+              {"manifest.json", "popup.html", "popup.js", "options.html",
+               "options.js"});
+  extensions::ChromeTestExtensionLoader loader(browser()->profile());
+  scoped_refptr<const extensions::Extension> extension =
+      LoadFixture(&fixture, &loader);
+  ASSERT_TRUE(extension);
+
+  ASSERT_TRUE(NavigateToURL(active_web_contents(),
+                            extension->GetResourceURL("options.html")));
+  EXPECT_EQ("Prometheus synthetic helper options",
+            content::EvalJs(active_web_contents(), "document.title"));
+  EXPECT_EQ("", content::EvalJs(active_web_contents(),
+                                "document.querySelector('#fixture-label').value"));
+
+  PrometheusExtensionAdmissionEvidence evidence;
+  EXPECT_FALSE(PrometheusExtensionPageAdapter::EvaluateAdmissionForTesting(
+                   AgentRouteName::kReadPage, ExtensionAgentGrant::kBlocked,
+                   evidence)
+                   .allowed);
+  EXPECT_TRUE(PrometheusExtensionPageAdapter::EvaluateAdmissionForTesting(
+                  AgentRouteName::kReadPage, ExtensionAgentGrant::kReadOnly,
+                  evidence)
+                  .allowed);
+  EXPECT_TRUE(PrometheusExtensionPageAdapter::EvaluateAdmissionForTesting(
+                  AgentRouteName::kTypeText, ExtensionAgentGrant::kInteract,
+                  evidence)
+                  .allowed);
+  const auto script =
+      PrometheusExtensionPageAdapter::EvaluateAdmissionForTesting(
+          AgentRouteName::kExecuteJs, ExtensionAgentGrant::kInteract, evidence);
+  EXPECT_FALSE(script.allowed);
+  EXPECT_EQ(PrometheusExtensionAdmissionDenial::kScriptDenied, script.denial);
+
+  EXPECT_TRUE(FixtureMatrixImplementedForTesting())
+      << "retained RED: password-manager-like lifecycle and isolation";
+}
+
+IN_PROC_BROWSER_TEST_F(PrometheusExtensionFixturesBrowserTest,
+                       AdBlockerLifecycleAndPermissionIsolation) {
+  extensions::TestExtensionDir fixture;
+  CopyFixture(&fixture, "ad_blocker", {"manifest.json", "rules.json"});
+  extensions::ChromeTestExtensionLoader loader(browser()->profile());
+  scoped_refptr<const extensions::Extension> extension =
+      LoadFixture(&fixture, &loader);
+  ASSERT_TRUE(extension);
+
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(NavigateToURL(
+      active_web_contents(),
+      embedded_test_server()->GetURL("/empty.html")));
+  EXPECT_EQ("blocked",
+            content::EvalJs(
+                active_web_contents(),
+                R"(
+                  fetch('/prometheus-fixture-blocked')
+                    .then(() => 'allowed')
+                    .catch(() => 'blocked')
+                )"));
+
+  auto* policy =
+      PrometheusExtensionPolicyServiceFactory::GetForProfile(
+          browser()->profile());
+  ASSERT_TRUE(policy);
+  EXPECT_EQ(ExtensionAgentGrant::kBlocked,
+            policy->GetEffectiveGrant(extension->id(), browser()->profile(),
+                                      false));
+  EXPECT_EQ(ExtensionAgentGrant::kBlocked,
+            policy->GetEffectiveGrant(extension->id(), browser()->profile(),
+                                      true));
+
+  EXPECT_TRUE(FixtureMatrixImplementedForTesting())
+      << "retained RED: DNR behavior and manifest-permission isolation";
+}
+
+IN_PROC_BROWSER_TEST_F(PrometheusExtensionFixturesBrowserTest,
+                       ProductivityContentScriptRoutingAndIsolation) {
+  extensions::TestExtensionDir fixture;
+  CopyFixture(&fixture, "productivity_content_script",
+              {"manifest.json", "content.js"});
+  extensions::ChromeTestExtensionLoader loader(browser()->profile());
+  scoped_refptr<const extensions::Extension> extension =
+      LoadFixture(&fixture, &loader);
+  ASSERT_TRUE(extension);
+
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL page_url = embedded_test_server()->GetURL("/empty.html");
+  ASSERT_TRUE(NavigateToURL(active_web_contents(), page_url));
+  EXPECT_EQ("content-script-active",
+            content::EvalJs(
+                active_web_contents(),
+                "document.querySelector('#prometheus-productivity-marker')"
+                ".textContent"));
+  EXPECT_FALSE(
+      PrometheusExtensionPageAdapter::ShouldUseExtensionAdapterForTesting(
+          false, active_web_contents()->GetLastCommittedURL()));
+
+  EXPECT_TRUE(FixtureMatrixImplementedForTesting())
+      << "retained RED: content-script DOM remains ordinary HTTP page data";
+}
+
+IN_PROC_BROWSER_TEST_F(PrometheusExtensionFixturesBrowserTest,
+                       SidePanelToolingVisibilityAndIsolation) {
+  extensions::TestExtensionDir fixture;
+  CopyFixture(&fixture, "side_panel_tooling",
+              {"manifest.json", "side_panel.html", "side_panel.js"});
+  extensions::ChromeTestExtensionLoader loader(browser()->profile());
+  scoped_refptr<const extensions::Extension> extension =
+      LoadFixture(&fixture, &loader);
+  ASSERT_TRUE(extension);
+
+  ASSERT_TRUE(NavigateToURL(active_web_contents(),
+                            extension->GetResourceURL("side_panel.html")));
+  EXPECT_EQ("Prometheus side panel fixture",
+            content::EvalJs(active_web_contents(), "document.title"));
+
+  PrometheusExtensionSurfaceEvidence evidence;
+  evidence.selector = AgentExtensionSurfaceSelector::kSidePanel;
+  evidence.observed_context =
+      PrometheusExtensionObservedContext::kSidePanel;
+  EXPECT_TRUE(
+      PrometheusExtensionSurfaceResolver::ClassifyEvidenceForTesting(evidence)
+          .accepted());
+  evidence.visible = false;
+  const auto hidden =
+      PrometheusExtensionSurfaceResolver::ClassifyEvidenceForTesting(evidence);
+  EXPECT_FALSE(hidden.accepted());
+  EXPECT_EQ(PrometheusExtensionSurfaceDenial::kHiddenSurface, hidden.denial);
+  evidence.visible = true;
+  evidence.observed_context =
+      PrometheusExtensionObservedContext::kDeveloperTools;
+  EXPECT_FALSE(
+      PrometheusExtensionSurfaceResolver::ClassifyEvidenceForTesting(evidence)
+          .accepted());
+
+  EXPECT_TRUE(FixtureMatrixImplementedForTesting())
+      << "retained RED: only an active visible side panel is routable";
+}
+
+IN_PROC_BROWSER_TEST_F(PrometheusExtensionFixturesBrowserTest,
+                       DeveloperWorkflowLifecycleAndWorkerIsolation) {
+  ExtensionTestMessageListener ready("prometheus-developer-ready");
+  extensions::TestExtensionDir fixture;
+  CopyFixture(&fixture, "developer_workflow",
+              {"manifest.json", "service_worker.js", "options.html",
+               "options.js"});
+  extensions::ChromeTestExtensionLoader loader(browser()->profile());
+  scoped_refptr<const extensions::Extension> extension =
+      LoadFixture(&fixture, &loader);
+  ASSERT_TRUE(extension);
+  EXPECT_TRUE(ready.WaitUntilSatisfied());
+
+  const std::string extension_id = extension->id();
+  auto* registry =
+      extensions::ExtensionRegistry::Get(browser()->profile());
+  auto* registrar =
+      extensions::ExtensionRegistrar::Get(browser()->profile());
+  ASSERT_TRUE(registry);
+  ASSERT_TRUE(registrar);
+
+  {
+    extensions::TestExtensionRegistryObserver observer(registry, extension_id);
+    registrar->ReloadExtension(extension_id);
+    EXPECT_TRUE(observer.WaitForExtensionLoaded());
+  }
+  {
+    extensions::TestExtensionRegistryObserver observer(registry, extension_id);
+    registrar->DisableExtension(
+        extension_id,
+        {extensions::disable_reason::DISABLE_USER_ACTION});
+    EXPECT_TRUE(observer.WaitForExtensionUnloaded());
+    EXPECT_TRUE(registry->disabled_extensions().Contains(extension_id));
+  }
+  {
+    extensions::TestExtensionRegistryObserver observer(registry, extension_id);
+    registrar->EnableExtension(extension_id);
+    EXPECT_TRUE(observer.WaitForExtensionLoaded());
+    EXPECT_TRUE(registry->enabled_extensions().Contains(extension_id));
+  }
+
+  PrometheusExtensionSurfaceEvidence worker_evidence;
+  worker_evidence.observed_context =
+      PrometheusExtensionObservedContext::kBackgroundContents;
+  EXPECT_FALSE(PrometheusExtensionSurfaceResolver::ClassifyEvidenceForTesting(
+                   worker_evidence)
+                   .accepted());
+
+  {
+    extensions::TestExtensionRegistryObserver observer(registry, extension_id);
+    std::u16string error;
+    EXPECT_TRUE(registrar->UninstallExtension(
+        extension_id, extensions::UNINSTALL_REASON_FOR_TESTING, &error));
+    EXPECT_TRUE(observer.WaitForExtensionUninstalled());
+    EXPECT_FALSE(registry->GetInstalledExtension(extension_id));
+  }
+
+  EXPECT_TRUE(FixtureMatrixImplementedForTesting())
+      << "retained RED: developer lifecycle and worker isolation";
+}
+
+}  // namespace prometheus
