+TEST_F(PrometheusSupervisionTypesTest,
+       SanitizedSerializationContainsOnlySafeClosedMetadata) {
+  const SanitizedSupervisionSnapshot snapshot = MakeValidSnapshot();
+  std::optional<base::DictValue> value =
+      SanitizedSupervisionSnapshotToValue(snapshot);
+  ASSERT_TRUE(value.has_value());
+  ASSERT_NE(nullptr, value->FindString("pairing_state"));
+  EXPECT_EQ("redeemed", *value->FindString("pairing_state"));
+  const base::DictValue* target = value->FindDict("target");
+  ASSERT_NE(nullptr, target);
+  ASSERT_NE(nullptr, target->FindString("safe_title"));
+  EXPECT_EQ("Release notes", *target->FindString("safe_title"));
+  ASSERT_NE(nullptr, target->FindString("safe_origin"));
+  EXPECT_EQ("https://example.test", *target->FindString("safe_origin"));
+  const base::ListValue* sessions = value->FindList("sessions");
+  ASSERT_NE(nullptr, sessions);
+  ASSERT_EQ(1u, sessions->size());
+  ASSERT_NE(nullptr, (*sessions)[0].GetDict().FindString("viewer_state"));
+  EXPECT_EQ("controller", *(*sessions)[0].GetDict().FindString("viewer_state"));
+  const base::ListValue* audit = value->FindList("audit");
+  ASSERT_NE(nullptr, audit);
+  ASSERT_EQ(1u, audit->size());
+
+  const std::string json = base::WriteJson(*value).value_or("");
+  for (std::string_view forbidden :
+       {"pairing_code", "session_id", "controller_lease", "bearer",
+        "profile_path", "document_epoch", "sequence", "selector",
+        "page_content", "typed_value", "secret", "authorization"}) {
+    EXPECT_EQ(std::string::npos, json.find(forbidden)) << forbidden;
+  }
