+void PrometheusAgentService::PruneConfirmedVaultReplay(base::Time timestamp) {
+  std::erase_if(confirmed_vault_replay_entries_,
+                [timestamp](const ConfirmedVaultReplayEntry& entry) {
+                  return entry.retained_until < timestamp;
+                });
