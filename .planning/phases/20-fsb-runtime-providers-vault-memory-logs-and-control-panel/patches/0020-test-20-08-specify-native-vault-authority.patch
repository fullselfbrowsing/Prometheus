+  std::vector<ConfirmedVaultFieldValue> fields;
+  uint64_t generation = 0;
+  base::Time expires_at;
+};
+
+enum class ConfirmedVaultInsertionStatus {
+  kSuccess,
+  kInvalidRequest,
+  kUnauthorized,
+  kProfileMismatch,
+  kStaleTarget,
