+PrometheusGatewayRuntimeTaskTracker::PrometheusGatewayRuntimeTaskTracker() =
+    default;
+PrometheusGatewayRuntimeTaskTracker::~PrometheusGatewayRuntimeTaskTracker() =
+    default;
+
+bool PrometheusGatewayRuntimeTaskTracker::Record(const void* runtime_scope,
+                                                 std::string task_id,
+                                                 std::string gateway_session_id,
+                                                 std::string caller_id) {
+  if (!runtime_scope || task_id.empty() || gateway_session_id.empty() ||
+      caller_id.empty()) {
+    return false;
+  }
+  auto scope = owners_.find(runtime_scope);
+  if (scope != owners_.end() && scope->second.contains(task_id)) {
+    scope->second[std::move(task_id)] = {
+        .gateway_session_id = std::move(gateway_session_id),
+        .caller_id = std::move(caller_id),
+    };
+    return true;
+  }
+  if (task_count_ >= kMaxGatewayRuntimeTaskOwners) {
+    return false;
+  }
+  auto& scoped_owners = owners_[runtime_scope];
+  scoped_owners.emplace(
+      std::move(task_id),
+      Owner{.gateway_session_id = std::move(gateway_session_id),
+            .caller_id = std::move(caller_id)});
+  ++task_count_;
+  return true;
+}
+
+bool PrometheusGatewayRuntimeTaskTracker::Owns(
+    const void* runtime_scope,
+    std::string_view task_id,
+    std::string_view gateway_session_id,
+    std::string_view caller_id) const {
+  const auto scope = owners_.find(runtime_scope);
+  if (scope == owners_.end()) {
+    return false;
+  }
+  const auto owner = scope->second.find(task_id);
+  return owner != scope->second.end() &&
+         owner->second.gateway_session_id == gateway_session_id &&
+         owner->second.caller_id == caller_id;
+}
+
+void PrometheusGatewayRuntimeTaskTracker::Reconcile(
+    const void* runtime_scope,
+    const RuntimeStoreSnapshot& snapshot) {
+  auto scope = owners_.find(runtime_scope);
+  if (scope == owners_.end()) {
+    return;
+  }
+  std::set<std::string, std::less<>> retained_task_ids;
+  for (const RuntimeStoredTask& task : snapshot.tasks) {
+    retained_task_ids.insert(task.snapshot.task_id);
+  }
+  for (auto owner = scope->second.begin(); owner != scope->second.end();) {
+    if (!retained_task_ids.contains(owner->first)) {
+      owner = scope->second.erase(owner);
+      --task_count_;
+    } else {
+      ++owner;
+    }
+  }
+  if (scope->second.empty()) {
+    owners_.erase(scope);
+  }
+}
+
+void PrometheusGatewayRuntimeTaskTracker::RemoveSession(
+    std::string_view gateway_session_id) {
+  for (auto scope = owners_.begin(); scope != owners_.end();) {
+    for (auto owner = scope->second.begin(); owner != scope->second.end();) {
+      if (owner->second.gateway_session_id == gateway_session_id) {
+        owner = scope->second.erase(owner);
+        --task_count_;
+      } else {
+        ++owner;
+      }
+    }
+    if (scope->second.empty()) {
+      scope = owners_.erase(scope);
+    } else {
+      ++scope;
+    }
+  }
+}
