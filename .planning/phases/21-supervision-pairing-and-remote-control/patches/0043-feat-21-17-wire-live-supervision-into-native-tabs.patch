+using ActionCategory = PrometheusTabState::Supervision::ActionCategory;
+using ControlState = PrometheusTabState::Supervision::ControlState;
+using Severity = PrometheusTabState::Supervision::Severity;
+
+bool HasViewers(const PrometheusTabState& state) {
+  return state.supervision.viewer_count > 0;
+}
+
+bool HasController(const PrometheusTabState& state) {
+  return state.supervision.controller_label.has_value() &&
+         (state.supervision.control_state == ControlState::kControllerReady ||
+          state.supervision.control_state == ControlState::kStopping);
+}
+
+bool HasActiveAction(const PrometheusTabState& state) {
+  return state.supervision.HasActiveAction() &&
+         state.supervision.action_category.has_value();
+}
+
+bool HasHealthWarning(const PrometheusTabState& state) {
+  return state.health == PrometheusTabState::Health::kNeedsAttention ||
+         state.supervision.severity != Severity::kNormal;
+}
+
+bool HasSupervision(const PrometheusTabState& state) {
+  return HasActiveAction(state) || HasController(state) || HasViewers(state) ||
+         state.supervision_active;
+}
 
 bool IsSafeDefault(const PrometheusTabState& state) {
   return state.owner_label.empty() && !state.automation_active &&
-         !state.supervision_active &&
-         state.health == PrometheusTabState::Health::kOk;
+         !HasSupervision(state) && !HasHealthWarning(state);
+}
+
+std::string SafeOwnerLabel(std::string_view label) {
+  std::string safe_label =
+      prometheus::DeriveSupervisionSafeClientLabel(label);
+  if (safe_label == prometheus::kSupervisionClientLabelFallback &&
+      base::CollapseWhitespaceASCII(label, true) != safe_label) {
+    return "Agent";
+  }
+  return safe_label;
+}
+
+std::u16string ActionCategoryName(ActionCategory category) {
+  switch (category) {
+    case ActionCategory::kClick:
+      return u"Click";
+    case ActionCategory::kType:
