From abdebbb608137f94e1da27fc5602daaf8c6f2de6 Mon Sep 17 00:00:00 2001
From: Lakshman <lakshman@lakshman-GG9LQ90J61.local>
Date: Wed, 22 Jul 2026 06:08:34 -0500
Subject: [PATCH] test(21-12): specify shared-hub compatibility semantics

Require owner-bound Agent consumers on the existing capture hub.

Distinguish baseline, diff, no-change, resync, replacement, end, codec rollback, and recursive authority exclusion.
---
 ...ometheus_agent_transport_codec_unittest.cc |  44 +++
 ...us_supervision_profile_service_unittest.cc | 270 ++++++++++++++++++
 2 files changed, 314 insertions(+)

diff --git a/chrome/browser/prometheus/prometheus_agent_transport_codec_unittest.cc b/chrome/browser/prometheus/prometheus_agent_transport_codec_unittest.cc
index e9acb9f413..25857a0253 100644
--- a/chrome/browser/prometheus/prometheus_agent_transport_codec_unittest.cc
+++ b/chrome/browser/prometheus/prometheus_agent_transport_codec_unittest.cc
@@ -445,5 +445,49 @@ TEST(PrometheusAgentTransportCodecTest,
             serialized_error.error().message.find("secret-sentinel"));
 }
 
+TEST(PrometheusAgentTransportCodecTest,
+     SupervisionSemanticsSerializeOnlyClosedRealOutcomes) {
+  AgentSupervisionNode baseline_node = SafeNode("node-1");
+  baseline_node.name = "Shared safe baseline";
+  AgentSupervisionDiffOperation replacement;
+  replacement.type = AgentSupervisionDiffOperationType::kReplaceFields;
+  replacement.ref = "node-1";
+  replacement.replacement = SafeNode("node-1");
+  replacement.replacement->name = "Shared safe mutation";
+
+  std::array<AgentRouteResult, 5> outcomes = {
+      AgentRouteResult::SupervisionSuccess(
+          AgentRouteName::kCreateSupervisionPairing,
+          AgentSupervisionLocalUiResult()),
+      AgentRouteResult::SupervisionSuccess(
+          AgentRouteName::kStartSupervisionSession,
+          AgentSupervisionBaselineResult{.nodes = {baseline_node}}),
+      AgentRouteResult::SupervisionSuccess(
+          AgentRouteName::kGetSupervisionSnapshot,
+          AgentSupervisionBaselineResult{.nodes = {baseline_node}}),
+      AgentRouteResult::SupervisionSuccess(
+          AgentRouteName::kGetSupervisionDiff,
+          AgentSupervisionDiffResult{.operations = {replacement}}),
+      AgentRouteResult::SupervisionSuccess(
+          AgentRouteName::kEndSupervisionSession,
+          AgentSupervisionEndedResult()),
+  };
+  for (const AgentRouteResult& outcome : outcomes) {
+    auto serialized = SerializeAgentTransportResult(outcome);
+    ASSERT_TRUE(serialized.has_value()) << serialized.error().message;
+    ExpectNoAuthorityOrSecretFields(*serialized);
+    EXPECT_EQ(std::string::npos, serialized->find("serialized_json"));
+    EXPECT_EQ(std::string::npos, serialized->find("safe\":true"));
+  }
+
+  auto no_change = SerializeAgentTransportResult(
+      AgentRouteResult::SupervisionSuccess(
+          AgentRouteName::kGetSupervisionDiff,
+          AgentSupervisionNoChangeResult()));
+  ASSERT_TRUE(no_change.has_value()) << no_change.error().message;
+  ExpectNoAuthorityOrSecretFields(*no_change);
+  EXPECT_NE(std::string::npos, no_change->find("no_change"));
+}
+
 }  // namespace
 }  // namespace prometheus
diff --git a/chrome/browser/prometheus/prometheus_supervision_profile_service_unittest.cc b/chrome/browser/prometheus/prometheus_supervision_profile_service_unittest.cc
index 3959665078..75d473e6c4 100644
--- a/chrome/browser/prometheus/prometheus_supervision_profile_service_unittest.cc
+++ b/chrome/browser/prometheus/prometheus_supervision_profile_service_unittest.cc
@@ -181,6 +181,27 @@ class PrometheusSupervisionProfileServiceTest : public testing::Test {
     return service_->RedeemPairing(creation.pairing_code, label);
   }
 
+  AgentRouteRequest CompatibilityRequest(AgentRouteName route_name,
+                                         std::string session_id) {
+    AgentRouteRequest request;
+    request.route_name = route_name;
+    request.session_id = std::move(session_id);
+    request.target.tab_handle = tab_.GetHandle();
+    return request;
+  }
+
+  std::optional<AgentRouteResult> ExecuteCompatibility(
+      AgentRouteName route_name,
+      std::string session_id) {
+    std::optional<AgentRouteResult> result;
+    service_->ExecuteCompatibilityRoute(
+        &browser_, CompatibilityRequest(route_name, std::move(session_id)),
+        base::BindLambdaForTesting([&](AgentRouteResult route_result) {
+          result.emplace(std::move(route_result));
+        }));
+    return result;
+  }
+
   base::test::TaskEnvironment task_environment_;
   base::Time now_;
   int profile_storage_ = 0;
@@ -1211,5 +1232,254 @@ TEST_F(PrometheusSupervisionProfileServiceTest,
   EXPECT_EQ(1, target_wait_d_count);
 }
 
+TEST_F(PrometheusSupervisionProfileServiceTest,
+       CompatibilityCreateIsLocalUiOnlyAndRequiresLiveOwner) {
+  PrometheusAgentTabObservationLease owner_lease =
+      agent_service_->ObserveOrCreateTabData(&tab_, &observer_tab_data_);
+  ASSERT_NE(nullptr, owner_lease.data());
+  ASSERT_TRUE(owner_lease.data()->ClaimIfUnowned("agent-a", "Agent A").ok);
+
+  std::optional<AgentRouteResult> created = ExecuteCompatibility(
+      AgentRouteName::kCreateSupervisionPairing, "agent-a");
+  ASSERT_TRUE(created.has_value());
+  ASSERT_TRUE(created->ok) << created->message;
+  ASSERT_TRUE(created->supervision_result.has_value());
+  EXPECT_TRUE(std::holds_alternative<AgentSupervisionLocalUiResult>(
+      created->supervision_result->payload));
+  EXPECT_EQ(0u, service_->pending_pairing_count_for_testing());
+  EXPECT_EQ(0u, service_->capture_hub_count_for_testing());
+
+  std::optional<AgentRouteResult> wrong_owner = ExecuteCompatibility(
+      AgentRouteName::kCreateSupervisionPairing, "agent-b");
+  ASSERT_TRUE(wrong_owner.has_value());
+  EXPECT_FALSE(wrong_owner->ok);
+  EXPECT_EQ(AgentErrorCode::kTabNotOwned, wrong_owner->error_code);
+  EXPECT_EQ(0u, service_->pending_pairing_count_for_testing());
+}
+
+TEST_F(PrometheusSupervisionProfileServiceTest,
+       CompatibilitySharedHubBaselineDiffNoChangeSnapshotAndEnd) {
+  PrometheusAgentTabObservationLease owner_lease =
+      agent_service_->ObserveOrCreateTabData(&tab_, &observer_tab_data_);
+  ASSERT_NE(nullptr, owner_lease.data());
+  ASSERT_TRUE(owner_lease.data()->ClaimIfUnowned("agent-a", "Agent A").ok);
+  SupervisionPairingCreationResult creation = CreatePairing();
+  ASSERT_TRUE(creation.ok);
+  SupervisionRedemptionResult dashboard = Redeem(creation, "Dashboard");
+  ASSERT_TRUE(dashboard.ok);
+  ASSERT_EQ(1u, capture_source_.pending_count());
+  capture_source_.CompleteNext(MakeServiceBaseline("shared baseline"));
+  SupervisionDashboardBaselineResult dashboard_baseline =
+      service_->ReadDashboardBaseline(dashboard.dashboard_session);
+  ASSERT_TRUE(dashboard_baseline.delivery.has_value());
+  ASSERT_TRUE(service_
+                  ->AckDashboard(dashboard.dashboard_session,
+                                 dashboard_baseline.delivery->stamp)
+                  .ok);
+
+  PrometheusSupervisionCaptureHub* hub =
+      service_->capture_hub_for_testing(creation.stable_tab_id);
+  ASSERT_NE(nullptr, hub);
+  ASSERT_EQ(1u, hub->consumer_count());
+  std::optional<AgentRouteResult> started = ExecuteCompatibility(
+      AgentRouteName::kStartSupervisionSession, "agent-a");
+  ASSERT_TRUE(started.has_value());
+  ASSERT_TRUE(started->ok) << started->message;
+  ASSERT_TRUE(started->supervision_result.has_value());
+  const auto* start_baseline =
+      std::get_if<AgentSupervisionBaselineResult>(
+          &started->supervision_result->payload);
+  ASSERT_NE(nullptr, start_baseline);
+  ASSERT_EQ(1u, start_baseline->nodes.size());
+  EXPECT_EQ("shared baseline", start_baseline->nodes.front().name);
+  EXPECT_EQ(2u, hub->consumer_count());
+  EXPECT_EQ(1u, hub->enable_count_for_testing());
+  EXPECT_EQ(1u, hub->capture_count_for_testing());
+
+  hub->NotifyDirtyForTesting(/*overflow=*/false);
+  ASSERT_EQ(1u, capture_source_.pending_count());
+  capture_source_.CompleteNext(MakeServiceBaseline("shared mutation"));
+  std::optional<AgentRouteResult> diff = ExecuteCompatibility(
+      AgentRouteName::kGetSupervisionDiff, "agent-a");
+  ASSERT_TRUE(diff.has_value());
+  ASSERT_TRUE(diff->ok) << diff->message;
+  ASSERT_TRUE(diff->supervision_result.has_value());
+  const auto* diff_payload = std::get_if<AgentSupervisionDiffResult>(
+      &diff->supervision_result->payload);
+  ASSERT_NE(nullptr, diff_payload);
+  EXPECT_FALSE(diff_payload->operations.empty());
+
+  SupervisionDashboardDiffResult dashboard_diff =
+      service_->ReadDashboardDiff(dashboard.dashboard_session);
+  ASSERT_TRUE(dashboard_diff.ok);
+  ASSERT_TRUE(dashboard_diff.delivery.has_value());
+  ASSERT_TRUE(service_
+                  ->AckDashboard(dashboard.dashboard_session,
+                                 dashboard_diff.delivery->stamp)
+                  .ok);
+
+  std::optional<AgentRouteResult> no_change = ExecuteCompatibility(
+      AgentRouteName::kGetSupervisionDiff, "agent-a");
+  ASSERT_TRUE(no_change.has_value());
+  ASSERT_TRUE(no_change->ok) << no_change->message;
+  ASSERT_TRUE(no_change->supervision_result.has_value());
+  EXPECT_TRUE(std::holds_alternative<AgentSupervisionNoChangeResult>(
+      no_change->supervision_result->payload));
+
+  std::optional<AgentRouteResult> snapshot = ExecuteCompatibility(
+      AgentRouteName::kGetSupervisionSnapshot, "agent-a");
+  ASSERT_TRUE(snapshot.has_value());
+  ASSERT_TRUE(snapshot->ok) << snapshot->message;
+  ASSERT_TRUE(snapshot->supervision_result.has_value());
+  const auto* current = std::get_if<AgentSupervisionBaselineResult>(
+      &snapshot->supervision_result->payload);
+  ASSERT_NE(nullptr, current);
+  ASSERT_EQ(1u, current->nodes.size());
+  EXPECT_EQ("shared mutation", current->nodes.front().name);
+
+  std::optional<AgentRouteResult> ended = ExecuteCompatibility(
+      AgentRouteName::kEndSupervisionSession, "agent-a");
+  ASSERT_TRUE(ended.has_value());
+  ASSERT_TRUE(ended->ok) << ended->message;
+  ASSERT_TRUE(ended->supervision_result.has_value());
+  EXPECT_TRUE(std::holds_alternative<AgentSupervisionEndedResult>(
+      ended->supervision_result->payload));
+  EXPECT_EQ(1u, hub->consumer_count());
+  EXPECT_TRUE(service_->ReadDashboardDiff(dashboard.dashboard_session).ok);
+
+  std::optional<AgentRouteResult> ended_again = ExecuteCompatibility(
+      AgentRouteName::kEndSupervisionSession, "agent-a");
+  ASSERT_TRUE(ended_again.has_value());
+  EXPECT_TRUE(ended_again->ok) << ended_again->message;
+  EXPECT_EQ(1u, hub->consumer_count());
+}
+
+TEST_F(PrometheusSupervisionProfileServiceTest,
+       CompatibilityReplacementGapAndCodecRollbackRequireRealState) {
+  SupervisionLimits limits;
+  limits.retained_batches = 1;
+  ResetService(SupervisionProfileKind::kRegular, limits);
+  PrometheusAgentTabObservationLease owner_lease =
+      agent_service_->ObserveOrCreateTabData(&tab_, &observer_tab_data_);
+  ASSERT_NE(nullptr, owner_lease.data());
+  ASSERT_TRUE(owner_lease.data()->ClaimIfUnowned("agent-a", "Agent A").ok);
+  SupervisionPairingCreationResult creation = CreatePairing();
+  ASSERT_TRUE(creation.ok);
+  SupervisionRedemptionResult dashboard = Redeem(creation, "Dashboard");
+  ASSERT_TRUE(dashboard.ok);
+  capture_source_.CompleteNext(MakeServiceBaseline("baseline"));
+  SupervisionDashboardBaselineResult dashboard_baseline =
+      service_->ReadDashboardBaseline(dashboard.dashboard_session);
+  ASSERT_TRUE(dashboard_baseline.delivery.has_value());
+  ASSERT_TRUE(service_
+                  ->AckDashboard(dashboard.dashboard_session,
+                                 dashboard_baseline.delivery->stamp)
+                  .ok);
+  ASSERT_TRUE(ExecuteCompatibility(AgentRouteName::kStartSupervisionSession,
+                                   "agent-a")
+                  ->ok);
+
+  PrometheusSupervisionCaptureHub* hub =
+      service_->capture_hub_for_testing(creation.stable_tab_id);
+  ASSERT_NE(nullptr, hub);
+  ASSERT_EQ(2u, hub->consumer_count());
+  std::optional<AgentRouteResult> replacement = ExecuteCompatibility(
+      AgentRouteName::kStartSupervisionSession, "agent-a");
+  ASSERT_TRUE(replacement.has_value());
+  EXPECT_TRUE(replacement->ok) << replacement->message;
+  EXPECT_EQ(2u, hub->consumer_count());
+
+  hub->NotifyDirtyForTesting(/*overflow=*/false);
+  capture_source_.CompleteNext(MakeServiceBaseline("mutation one"));
+  SupervisionDashboardDiffResult dashboard_one =
+      service_->ReadDashboardDiff(dashboard.dashboard_session);
+  ASSERT_TRUE(dashboard_one.delivery.has_value());
+  ASSERT_TRUE(service_
+                  ->AckDashboard(dashboard.dashboard_session,
+                                 dashboard_one.delivery->stamp)
+                  .ok);
+  hub->NotifyDirtyForTesting(/*overflow=*/false);
+  capture_source_.CompleteNext(MakeServiceBaseline("mutation two"));
+
+  std::optional<AgentRouteResult> gap = ExecuteCompatibility(
+      AgentRouteName::kGetSupervisionDiff, "agent-a");
+  ASSERT_TRUE(gap.has_value());
+  EXPECT_FALSE(gap->ok);
+  EXPECT_EQ(AgentErrorCode::kStaleTarget, gap->error_code);
+  std::optional<AgentRouteResult> resynced = ExecuteCompatibility(
+      AgentRouteName::kGetSupervisionSnapshot, "agent-a");
+  ASSERT_TRUE(resynced.has_value());
+  ASSERT_TRUE(resynced->ok) << resynced->message;
+  const auto* resync_baseline = std::get_if<AgentSupervisionBaselineResult>(
+      &resynced->supervision_result->payload);
+  ASSERT_NE(nullptr, resync_baseline);
+  EXPECT_EQ("mutation two", resync_baseline->nodes.front().name);
+
+  hub->NotifyDirtyForTesting(/*overflow=*/false);
+  capture_source_.CompleteNext(MakeServiceBaseline("secret-sentinel"));
+  std::optional<AgentRouteResult> rejected_once = ExecuteCompatibility(
+      AgentRouteName::kGetSupervisionDiff, "agent-a");
+  std::optional<AgentRouteResult> rejected_twice = ExecuteCompatibility(
+      AgentRouteName::kGetSupervisionDiff, "agent-a");
+  ASSERT_TRUE(rejected_once.has_value());
+  ASSERT_TRUE(rejected_twice.has_value());
+  EXPECT_FALSE(rejected_once->ok);
+  EXPECT_FALSE(rejected_twice->ok);
+  EXPECT_EQ(AgentErrorCode::kInvalidRequest, rejected_once->error_code);
+  EXPECT_EQ(rejected_once->error_code, rejected_twice->error_code);
+
+  hub->NotifyDirtyForTesting(/*overflow=*/false);
+  capture_source_.CompleteNext(MakeServiceBaseline("safe recovery"));
+  std::optional<AgentRouteResult> recovered = ExecuteCompatibility(
+      AgentRouteName::kGetSupervisionSnapshot, "agent-a");
+  ASSERT_TRUE(recovered.has_value());
+  EXPECT_TRUE(recovered->ok) << recovered->message;
+}
+
+TEST_F(PrometheusSupervisionProfileServiceTest,
+       CompatibilityMismatchEndAndShutdownNeverDetachDashboardEarly) {
+  PrometheusAgentTabObservationLease owner_lease =
+      agent_service_->ObserveOrCreateTabData(&tab_, &observer_tab_data_);
+  ASSERT_NE(nullptr, owner_lease.data());
+  ASSERT_TRUE(owner_lease.data()->ClaimIfUnowned("agent-a", "Agent A").ok);
+  SupervisionPairingCreationResult creation = CreatePairing();
+  ASSERT_TRUE(creation.ok);
+  SupervisionRedemptionResult dashboard = Redeem(creation, "Dashboard");
+  ASSERT_TRUE(dashboard.ok);
+  capture_source_.CompleteNext(MakeServiceBaseline("baseline"));
+  SupervisionDashboardBaselineResult dashboard_baseline =
+      service_->ReadDashboardBaseline(dashboard.dashboard_session);
+  ASSERT_TRUE(dashboard_baseline.delivery.has_value());
+  ASSERT_TRUE(service_
+                  ->AckDashboard(dashboard.dashboard_session,
+                                 dashboard_baseline.delivery->stamp)
+                  .ok);
+
+  std::optional<AgentRouteResult> mismatch = ExecuteCompatibility(
+      AgentRouteName::kStartSupervisionSession, "agent-b");
+  ASSERT_TRUE(mismatch.has_value());
+  EXPECT_FALSE(mismatch->ok);
+  EXPECT_EQ(AgentErrorCode::kTabNotOwned, mismatch->error_code);
+  EXPECT_EQ(1u, service_->capture_consumer_count_for_testing(
+                    creation.stable_tab_id));
+
+  ASSERT_TRUE(ExecuteCompatibility(AgentRouteName::kStartSupervisionSession,
+                                   "agent-a")
+                  ->ok);
+  EXPECT_EQ(2u, service_->capture_consumer_count_for_testing(
+                    creation.stable_tab_id));
+  ASSERT_TRUE(ExecuteCompatibility(AgentRouteName::kEndSupervisionSession,
+                                   "agent-a")
+                  ->ok);
+  EXPECT_EQ(1u, service_->capture_consumer_count_for_testing(
+                    creation.stable_tab_id));
+  EXPECT_TRUE(service_->ReadDashboardDiff(dashboard.dashboard_session).ok);
+
+  service_->Shutdown();
+  service_->Shutdown();
+  EXPECT_EQ(0u, service_->capture_hub_count_for_testing());
+  EXPECT_EQ(1u, service_->released_capture_disable_count_for_testing());
+}
+
 }  // namespace
 }  // namespace prometheus
