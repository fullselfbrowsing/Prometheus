+void PrometheusRuntimeProfileService::StartTask(std::string task_id) {
+  auto task = tasks_.find(task_id);
+  if (task == tasks_.end() || task->second.finished ||
+      task->second.snapshot.state != RuntimeTaskState::kQueued) {
+    return;
+  }
+
+  const RuntimePolicy policy = ReadEffectivePolicy();
+  const int64_t now_ms = hooks_.now_ms ? hooks_.now_ms.Run() : 0;
+  if (owned_runtime_store_) {
+    RuntimeStoreMutation running = owned_runtime_store_->TransitionTask(
+        task_id, task->second.generation, RuntimeTaskState::kRunning, now_ms);
+    if (running.status != RuntimeStoreStatus::kOk) {
+      FinishTaskOnce(task_id, task->second.generation,
+                     RuntimeCompletionSource::kProvider, {}, {},
+                     RuntimeErrorCode::kInvalidTransition);
+      return;
+    }
+    task->second.generation = running.generation;
+  }
+  task->second.snapshot.state = RuntimeTaskState::kRunning;
+  task->second.snapshot.updated_at_ms = now_ms;
+  task->second.started_at_ms = now_ms;
+  task->second.auto_advance = true;
+  if (profile_) {
+    task->second.timeout_timer = std::make_unique<base::OneShotTimer>();
+    task->second.timeout_timer->Start(
+        FROM_HERE, base::Milliseconds(policy.limits.max_duration_ms),
+        base::BindOnce(&PrometheusRuntimeProfileService::OnTaskTimeout,
+                       weak_factory_.GetWeakPtr(), task_id,
+                       task->second.generation));
+  }
+  EmitTelemetryIfEnabled(policy, RuntimeTelemetryEventKind::kTaskState);
+  StartAutomaticProviderTurn(std::move(task_id), task->second.prompt);
+}
+
+void PrometheusRuntimeProfileService::StartAutomaticProviderTurn(
+    std::string task_id,
+    std::string user_text) {
+  auto task = tasks_.find(task_id);
+  if (task == tasks_.end() || task->second.finished ||
+      !task->second.auto_advance) {
+    return;
+  }
+  const RuntimePolicy policy = ReadEffectivePolicy();
+  const int64_t now_ms = hooks_.now_ms ? hooks_.now_ms.Run() : 0;
+  if (task->second.turn_count >= static_cast<size_t>(policy.limits.max_turns) ||
+      now_ms < task->second.started_at_ms ||
+      now_ms - task->second.started_at_ms > policy.limits.max_duration_ms) {
+    FinishTaskOnce(task_id, task->second.generation,
+                   RuntimeCompletionSource::kTimeout, {},
+                   task->second.snapshot.usage);
+    return;
+  }
+  if (!hooks_.execute_provider_turn) {
+    FinishTaskOnce(task_id, task->second.generation,
+                   RuntimeCompletionSource::kProvider, {}, {},
+                   RuntimeErrorCode::kProviderUnavailable);
+    return;
+  }
+  const int64_t used_tokens = task->second.snapshot.usage.input_tokens +
+                              task->second.snapshot.usage.output_tokens;
+  const int64_t remaining_tokens = policy.limits.max_total_tokens - used_tokens;
+  if (remaining_tokens <= 0) {
+    FinishTaskOnce(task_id, task->second.generation,
+                   RuntimeCompletionSource::kProvider, {},
+                   task->second.snapshot.usage,
+                   RuntimeErrorCode::kProviderInvalidResponse);
+    return;
+  }
+
+  ProviderTurnRequest request;
+  request.family = task->second.provider.family;
+  request.use_responses_api = task->second.provider.capabilities.responses_api;
+  request.model = task->second.provider.model_id;
+  request.system_instruction = kRuntimeSystemInstruction;
+  request.user_text = std::move(user_text);
+  request.max_output_tokens = std::min<int64_t>(1024, remaining_tokens);
+  request.tools.reserve(kRuntimeSafeTools.size());
+  for (RuntimeSafeTool tool : kRuntimeSafeTools) {
+    request.tools.push_back(BasicToolDefinition(tool));
+  }
+
+  ++task->second.turn_count;
+  const uint64_t callback_generation = ++task->second.callback_generation;
+  auto immediate_result =
+      std::make_shared<std::optional<RuntimeOperationResult>>();
+  ProviderTurnRequest transport_request = CloneProviderTurnRequest(request);
+  const uint64_t provider_operation_id = hooks_.execute_provider_turn.Run(
+      task->second.provider.provider_id, std::move(transport_request),
+      base::BindOnce(
+          &PrometheusRuntimeProfileService::OnAutomaticProviderTurnComplete,
+          weak_factory_.GetWeakPtr(), task_id, callback_generation,
+          immediate_result, std::move(request)));
+  task = tasks_.find(task_id);
+  if (task != tasks_.end() && !task->second.finished &&
+      task->second.callback_generation == callback_generation &&
+      !immediate_result->has_value()) {
+    if (provider_operation_id == 0) {
+      FinishTaskOnce(task_id, task->second.generation,
+                     RuntimeCompletionSource::kProvider, {}, {},
+                     RuntimeErrorCode::kProviderUnavailable);
+    } else {
+      task->second.provider_operation_id = provider_operation_id;
+    }
+  }
+}
+
+void PrometheusRuntimeProfileService::OnAutomaticProviderTurnComplete(
+    std::string task_id,
+    uint64_t callback_generation,
+    std::shared_ptr<std::optional<RuntimeOperationResult>> immediate_result,
+    ProviderTurnRequest request,
+    ProviderTurnResult result) {
+  auto task = tasks_.find(task_id);
+  if (task == tasks_.end() || task->second.finished ||
+      task->second.callback_generation != callback_generation) {
+    return;
+  }
+  task->second.provider_operation_id.reset();
+
+  if (!result.ok() && IsRetryableProviderFailure(result.failure) &&
+      !task->second.mutation_started && hooks_.execute_provider_turn) {
+    const std::vector<PrometheusProviderConfig> fresh_providers =
+        hooks_.list_providers ? hooks_.list_providers.Run()
+                              : std::vector<PrometheusProviderConfig>();
+    std::optional<size_t> next_index;
+    for (size_t index = task->second.fallback_index + 1;
+         index < task->second.fallback_order.size(); ++index) {
+      const PrometheusProviderConfig& candidate =
+          task->second.fallback_order[index];
+      if (ProviderMatchesRequestedExecution(
+              candidate, task->second.snapshot.requested_execution) &&
+          std::ranges::find(fresh_providers, candidate) !=
+              fresh_providers.end()) {
+        next_index = index;
+        break;
+      }
+    }
+    if (next_index) {
+      const PrometheusProviderConfig candidate =
+          task->second.fallback_order[*next_index];
+      task->second.provider = candidate;
+      task->second.fallback_index = *next_index;
+      request.family = candidate.family;
+      request.use_responses_api = candidate.capabilities.responses_api;
+      request.model = candidate.model_id;
+      ProviderTurnRequest transport_request = CloneProviderTurnRequest(request);
+      const uint64_t provider_operation_id = hooks_.execute_provider_turn.Run(
+          candidate.provider_id, std::move(transport_request),
+          base::BindOnce(
+              &PrometheusRuntimeProfileService::OnAutomaticProviderTurnComplete,
+              weak_factory_.GetWeakPtr(), task_id, callback_generation,
+              immediate_result, std::move(request)));
+      task = tasks_.find(task_id);
+      if (task != tasks_.end() && !task->second.finished &&
+          task->second.callback_generation == callback_generation &&
+          !immediate_result->has_value()) {
+        if (provider_operation_id == 0) {
+          FinishTaskOnce(task_id, task->second.generation,
+                         RuntimeCompletionSource::kProvider, {}, {},
+                         RuntimeErrorCode::kProviderUnavailable);
+        } else {
+          task->second.provider_operation_id = provider_operation_id;
+        }
+      }
+      return;
+    }
+  }
+  OnProviderTurnComplete(std::move(task_id), callback_generation,
+                         std::move(immediate_result), std::move(result));
+}
