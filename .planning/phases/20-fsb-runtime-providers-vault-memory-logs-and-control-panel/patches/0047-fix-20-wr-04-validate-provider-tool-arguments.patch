+ProviderToolDefinition MakeStructuredTool() {
+  base::DictValue label;
+  label.Set("type", "string");
+  label.Set("minLength", 1);
+  label.Set("maxLength", 4);
+  base::DictValue attempts;
+  attempts.Set("type", "integer");
+  attempts.Set("minimum", 0);
+  attempts.Set("maximum", 2);
+  base::DictValue enabled;
+  enabled.Set("type", "boolean");
+
+  base::DictValue options_properties;
+  options_properties.Set("label", std::move(label));
+  options_properties.Set("attempts", std::move(attempts));
+  options_properties.Set("enabled", std::move(enabled));
+  base::ListValue options_required;
+  options_required.Append("label");
+  options_required.Append("attempts");
+  options_required.Append("enabled");
+  base::DictValue options;
+  options.Set("type", "object");
+  options.Set("properties", std::move(options_properties));
+  options.Set("required", std::move(options_required));
+  options.Set("additionalProperties", false);
+
+  base::DictValue properties;
+  properties.Set("options", std::move(options));
+  base::ListValue required;
+  required.Append("options");
+  base::DictValue schema;
+  schema.Set("type", "object");
+  schema.Set("properties", std::move(properties));
+  schema.Set("required", std::move(required));
+  schema.Set("additionalProperties", false);
+  return {
+      .name = "structured",
+      .description = "Exercise a recursively closed tool schema.",
+      .input_schema = std::move(schema),
+  };
+}
