+  EXPECT_EQ(Read(changed).error, PrometheusSecretError::kBindingMismatch);
+
+  changed = ProviderBinding();
+  changed.owner_kind = "anthropic";
+  EXPECT_EQ(Read(changed).error, PrometheusSecretError::kBindingMismatch);
+
+  changed = ProviderBinding();
+  changed.canonical_origin = "https://api.openai.com/v2/";
+  EXPECT_EQ(Read(changed).error, PrometheusSecretError::kBindingMismatch);
+
+  MutateEnvelope("schema_version", base::Value(99));
+  EXPECT_EQ(Read().error, PrometheusSecretError::kCorruptEnvelope);
+  MutateEnvelope("schema_version",
+                 base::Value(kPrometheusSecretEnvelopeSchemaVersion));
+  MutateEnvelope("record_id", base::Value("different-record"));
+  EXPECT_EQ(Read().error, PrometheusSecretError::kBindingMismatch);
