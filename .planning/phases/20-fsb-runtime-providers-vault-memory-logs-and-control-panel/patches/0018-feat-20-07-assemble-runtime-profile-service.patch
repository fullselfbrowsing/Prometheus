+RuntimeProfileStatus PrometheusRuntimeProfileService::PolicyDenial(
+    RuntimePolicyDecision decision,
+    std::string* recovery) const {
+  CHECK(recovery);
+  *recovery = "Runtime policy denied the operation: ";
+  recovery->append(RuntimePolicyDecisionToString(decision));
+  return RuntimeProfileStatus::kPolicyBlocked;
+}
