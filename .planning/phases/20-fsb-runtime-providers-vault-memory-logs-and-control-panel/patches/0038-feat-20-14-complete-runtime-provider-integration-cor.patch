+IN_PROC_BROWSER_TEST_F(PrometheusMcpIntegrationBrowserTest,
+                       RuntimeProviderWireCorpus) {
+  const base::ListValue cases = LoadRuntimeEvaluationCases();
+  size_t real_loop_count = 0;
+  std::map<std::string, size_t, std::less<>> family_counts;
+
+  for (size_t index = 0; index < cases.size(); ++index) {
+    const base::DictValue& eval_case = cases[index].GetDict();
+    if (!eval_case.FindBool("real_provider_loop").value_or(false)) {
+      continue;
+    }
+    const std::string& id = *eval_case.FindString("id");
+    const std::string& family = *eval_case.FindString("provider_family");
+    const std::string& fixture = *eval_case.FindString("provider_fixture");
+    const std::string& prompt = *eval_case.FindString("prompt");
+    const std::string& sentinel = *eval_case.FindString("sentinel");
+    SCOPED_TRACE(id);
+    ++real_loop_count;
+    ++family_counts[family];
+
+    PrometheusProviderRegistry registry(browser()->profile()->GetPrefs());
+    PrometheusProviderConfig provider = MakeCorpusProvider(family, index);
+    ASSERT_EQ(PrometheusProviderError::kNone,
+              registry.SetProviders({provider}));
+    CorpusFakeSecretStore secret_store;
+    network::TestURLLoaderFactory url_loader_factory(true);
+    ProviderTransportLimits limits;
+    if (fixture == "oversize") {
+      limits.max_response_bytes = 128;
+    }
+    PrometheusProviderTransport transport(
+        &registry, &secret_store, url_loader_factory.GetSafeWeakWrapper(),
+        limits);
+
+    if (fixture == "models_ready" || fixture == "models_delayed_cancel") {
+      int callback_count = 0;
+      std::optional<ProviderModelListResult> result;
+      const auto operation = transport.DiscoverModels(
+          provider.provider_id,
+          base::BindLambdaForTesting([&](ProviderModelListResult value) {
+            ++callback_count;
+            result = std::move(value);
+          }));
+      const std::optional<GURL> url = registry.BuildRequestUrl(
+          provider.provider_id, PrometheusProviderRequestRoute::kModels);
+      ASSERT_TRUE(url.has_value());
+      const network::ResourceRequest* request = nullptr;
+      ASSERT_TRUE(url_loader_factory.IsPending(url->spec(), &request));
+      ASSERT_TRUE(request);
+      EXPECT_EQ("GET", request->method);
+      EXPECT_EQ(network::mojom::CredentialsMode::kOmit,
+                request->credentials_mode);
+      EXPECT_EQ(network::mojom::RedirectMode::kError, request->redirect_mode);
+      EXPECT_FALSE(
+          request->headers.GetHeader(net::HttpRequestHeaders::kCookie));
+      if (fixture == "models_delayed_cancel") {
+        EXPECT_TRUE(transport.Cancel(operation));
+        base::RunLoop().RunUntilIdle();
+        EXPECT_EQ(0, callback_count);
+        EXPECT_FALSE(url_loader_factory.IsPending(url->spec()));
+      } else {
+        EXPECT_TRUE(url_loader_factory.SimulateResponseForPendingRequest(
+            url->spec(), R"({"data":[{"id":"model-a"},{"id":"model-b"}]})"));
+        ASSERT_TRUE(result.has_value());
+        EXPECT_EQ(1, callback_count);
+        EXPECT_EQ(ProviderModelListState::kReady, result->state);
+        EXPECT_EQ((std::vector<std::string>{"model-a", "model-b"}),
+                  result->models);
+      }
+    } else {
+      int callback_count = 0;
+      std::optional<ProviderTurnResult> result;
+      const auto operation = transport.ExecuteTurn(
+          provider.provider_id, MakeCorpusTurnRequest(provider, prompt),
+          base::BindLambdaForTesting([&](ProviderTurnResult value) {
+            ++callback_count;
+            result = std::move(value);
+          }));
+      const std::optional<GURL> url = registry.BuildRequestUrl(
+          provider.provider_id, PrometheusProviderRequestRoute::kInference);
+      ASSERT_TRUE(url.has_value());
+      const network::ResourceRequest* request = nullptr;
+      ASSERT_TRUE(url_loader_factory.IsPending(url->spec(), &request));
+      ASSERT_TRUE(request);
+      EXPECT_EQ("POST", request->method);
+      EXPECT_EQ(network::mojom::CredentialsMode::kOmit,
+                request->credentials_mode);
+      EXPECT_EQ(network::mojom::RedirectMode::kError, request->redirect_mode);
+      EXPECT_TRUE(request->referrer.is_empty());
+      EXPECT_TRUE(request->load_flags & net::LOAD_DISABLE_CACHE);
+      EXPECT_TRUE(request->load_flags & net::LOAD_BYPASS_CACHE);
+      EXPECT_FALSE(
+          request->headers.GetHeader(net::HttpRequestHeaders::kCookie));
+      ASSERT_TRUE(secret_store.last_binding());
+      EXPECT_EQ(provider.canonical_endpoint,
+                secret_store.last_binding()->canonical_origin);
+
+      if (family == "anthropic_messages") {
+        EXPECT_EQ(kCorpusActiveSecret, request->headers.GetHeader("x-api-key"));
+        EXPECT_FALSE(request->headers.GetHeader(
+            net::HttpRequestHeaders::kAuthorization));
+      } else if (family == "gemini_generate_content") {
+        EXPECT_EQ(kCorpusActiveSecret,
+                  request->headers.GetHeader("x-goog-api-key"));
+        EXPECT_FALSE(request->headers.GetHeader(
+            net::HttpRequestHeaders::kAuthorization));
+      } else {
+        EXPECT_EQ("Bearer " + std::string(kCorpusActiveSecret),
+                  request->headers.GetHeader(
+                      net::HttpRequestHeaders::kAuthorization));
+      }
+
+      if (fixture == "delayed_cancel") {
+        EXPECT_TRUE(transport.Cancel(operation));
+        base::RunLoop().RunUntilIdle();
+        EXPECT_EQ(0, callback_count);
+        EXPECT_FALSE(url_loader_factory.IsPending(url->spec()));
+      } else if (fixture == "authentication_failure" ||
+                 fixture == "rate_limited" || fixture == "server_failure") {
+        const net::HttpStatusCode status =
+            fixture == "authentication_failure" ? net::HTTP_UNAUTHORIZED
+            : fixture == "rate_limited"         ? net::HTTP_TOO_MANY_REQUESTS
+                                        : net::HTTP_INTERNAL_SERVER_ERROR;
+        EXPECT_TRUE(url_loader_factory.SimulateResponseForPendingRequest(
+            url->spec(), "{}", status));
+      } else if (fixture == "redirect_rejected") {
+        net::RedirectInfo redirect;
+        redirect.new_url = GURL("https://attacker.example/secret");
+        redirect.status_code = net::HTTP_TEMPORARY_REDIRECT;
+        network::TestURLLoaderFactory::Redirects redirects;
+        redirects.emplace_back(redirect,
+                               network::mojom::URLResponseHead::New());
+        url_loader_factory.AddResponse(
+            *url, network::CreateURLResponseHead(net::HTTP_OK), "{}",
+            network::URLLoaderCompletionStatus(net::OK), std::move(redirects));
+        base::RunLoop().RunUntilIdle();
+      } else {
+        const std::string body =
+            fixture == "malformed" ? "{"
+            : fixture == "oversize"
+                ? std::string(limits.max_response_bytes + 1, 'x')
+                : CorpusTurnResponse(family, fixture);
+        EXPECT_TRUE(url_loader_factory.SimulateResponseForPendingRequest(
+            url->spec(), body));
+      }
+
+      if (fixture != "delayed_cancel") {
+        ASSERT_TRUE(result.has_value());
+        EXPECT_EQ(1, callback_count);
+        if (fixture == "authentication_failure") {
+          EXPECT_EQ(ProviderFailureKind::kAuthentication, result->failure);
+        } else if (fixture == "rate_limited") {
+          EXPECT_EQ(ProviderFailureKind::kRateLimited, result->failure);
+          EXPECT_TRUE(IsRetryableProviderFailure(result->failure));
+        } else if (fixture == "server_failure") {
+          EXPECT_EQ(ProviderFailureKind::kServer, result->failure);
+          EXPECT_TRUE(IsRetryableProviderFailure(result->failure));
+        } else if (fixture == "redirect_rejected") {
+          EXPECT_EQ(ProviderFailureKind::kEndpointPolicy, result->failure);
+        } else if (fixture == "malformed" || fixture == "multiple_tools" ||
+                   fixture == "unknown_tool") {
+          EXPECT_EQ(ProviderFailureKind::kInvalidOutput, result->failure);
+        } else if (fixture == "oversize") {
+          EXPECT_EQ(ProviderFailureKind::kBounds, result->failure);
+        } else {
+          EXPECT_TRUE(result->ok());
+          EXPECT_EQ(fixture == "tool_call" ? 5 : 11,
+                    result->usage.input_tokens);
+          EXPECT_EQ(fixture == "tool_call" ? 3 : 7,
+                    result->usage.output_tokens);
+          if (fixture == "tool_call") {
+            ASSERT_TRUE(result->tool_call);
+            EXPECT_EQ("read_page", result->tool_call->name);
+          }
+          EXPECT_EQ(std::string::npos,
+                    result->safe_result.text.find(kCorpusActiveSecret));
+        }
+
+        std::string observable = result->safe_result.text;
+        observable.append(
+            base::WriteJson(registry.GetSanitizedSnapshot()).value_or(""));
+        EXPECT_EQ(std::string::npos, observable.find(kCorpusActiveSecret));
+        if (!sentinel.empty()) {
+          EXPECT_EQ(std::string::npos, observable.find(sentinel));
+        }
+        EXPECT_EQ(std::string::npos,
+                  observable.find("EVAL_PROVIDER_BODY_SENTINEL"));
+        EXPECT_EQ(std::string::npos,
+                  observable.find("EVAL_AUTHORITY_SENTINEL"));
+        EXPECT_EQ(std::string::npos,
+                  observable.find("EVAL_BOOTSTRAP_CONFIG_SENTINEL"));
+      }
+    }
+    EXPECT_EQ(1, secret_store.read_count());
+    EXPECT_EQ(1u, url_loader_factory.total_requests());
+    EXPECT_EQ(0u, transport.in_flight_for_testing());
+  }
+
+  EXPECT_EQ(28u, real_loop_count);
+  EXPECT_GT(family_counts["openai_responses"], 0u);
+  EXPECT_GT(family_counts["openai_chat"], 0u);
+  EXPECT_GT(family_counts["anthropic_messages"], 0u);
+  EXPECT_GT(family_counts["gemini_generate_content"], 0u);
+}
