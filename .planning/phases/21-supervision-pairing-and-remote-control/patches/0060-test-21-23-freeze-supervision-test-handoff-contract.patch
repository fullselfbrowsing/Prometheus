+enum class SupervisionTestHandoffStatus {
+  kDelivered,
+  kInvalidRequest,
+  kDenied,
+  kNotReady,
+  kOutOfOrder,
+  kExhausted,
+  kTargetLost,
+  kExpired,
+  kShutdown,
+};
+
+// Move-only because challenge and browser-issued session authority must be
+// cleared when dispatch completes or is denied.
+struct SupervisionTestHandoffRequest {
+  SupervisionTestHandoffRequest();
+  SupervisionTestHandoffRequest(std::string challenge,
+                                std::string session_id,
+                                int sequence);
+  SupervisionTestHandoffRequest(SupervisionTestHandoffRequest&&);
+  SupervisionTestHandoffRequest& operator=(SupervisionTestHandoffRequest&&);
+  SupervisionTestHandoffRequest(const SupervisionTestHandoffRequest&) = delete;
+  SupervisionTestHandoffRequest& operator=(
+      const SupervisionTestHandoffRequest&) = delete;
+  ~SupervisionTestHandoffRequest();
+
+  std::string challenge;
+  std::string session_id;
+  int sequence = 0;
+};
+
+// The pairing code is present only for kDelivered and is securely cleared by
+// the move-only result owner after the gateway has serialized it.
+struct SupervisionTestHandoffResult {
+  SupervisionTestHandoffResult();
+  SupervisionTestHandoffResult(SupervisionTestHandoffResult&&);
+  SupervisionTestHandoffResult& operator=(SupervisionTestHandoffResult&&);
+  SupervisionTestHandoffResult(const SupervisionTestHandoffResult&) = delete;
+  SupervisionTestHandoffResult& operator=(const SupervisionTestHandoffResult&) =
+      delete;
+  ~SupervisionTestHandoffResult();
+
+  static SupervisionTestHandoffResult Delivered(int sequence,
+                                                std::string pairing_code);
+  static SupervisionTestHandoffResult Failure(
+      SupervisionTestHandoffStatus status);
+
+  SupervisionTestHandoffStatus status =
+      SupervisionTestHandoffStatus::kInvalidRequest;
+  int sequence = 0;
+  std::string pairing_code;
+};
+
+using SupervisionTestHandoffParseResult =
+    base::expected<SupervisionTestHandoffRequest, SupervisionTestHandoffResult>;
+
+SupervisionTestHandoffParseResult ParseSupervisionTestHandoffRequest(
+    std::string_view body);
+std::string SerializeSupervisionTestHandoffResult(
+    const SupervisionTestHandoffResult& result);
+
+// Dependency-neutral seam. The gateway knows only whether this validated
+// dispatcher is installed; concrete profile/service composition is deferred.
+struct SupervisionTestHandoffDispatcher {
+  using ResultCallback =
+      base::OnceCallback<void(SupervisionTestHandoffResult result)>;
+  using DispatchCallback =
+      base::RepeatingCallback<void(SupervisionTestHandoffRequest request,
+                                   ResultCallback callback)>;
+
+  bool IsComplete() const { return dispatch && shutdown; }
+
+  DispatchCallback dispatch;
+  base::RepeatingClosure shutdown;
+};
+
 }  // namespace prometheus
 
 #endif  // CHROME_BROWSER_PROMETHEUS_PROMETHEUS_AGENT_GATEWAY_CONTRACT_H_
