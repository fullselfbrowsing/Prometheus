+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_PROMETHEUS_PROMETHEUS_TOKEN_GALLERY_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_PROMETHEUS_PROMETHEUS_TOKEN_GALLERY_VIEW_H_
+
+// Native Views counterpart to chrome://prometheus-theme-preview (D-13): a
+// throwaway dev gallery enumerating all 20 kColorPrometheus* color ids and
+// rebuilding on OnThemeChanged() as the live dark/light toggle proof.
+// Explicitly dev-only — Phase 16 deletes or folds this surface. Gated the
+// same way as the WebUI preview (DCHECK_IS_ON()) since both are D-13
+// verification-only surfaces, not product UI.
+#include "base/dcheck_is_on.h"
+
+#if DCHECK_IS_ON()
+
+#include <cstddef>
+
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/controls/scroll_view.h"
+
+namespace views {
+class View;
+}  // namespace views
+
+class PrometheusTokenGalleryView : public views::ScrollView {
+  METADATA_HEADER(PrometheusTokenGalleryView, views::ScrollView)
+
+ public:
+  PrometheusTokenGalleryView();
+  PrometheusTokenGalleryView(const PrometheusTokenGalleryView&) = delete;
+  PrometheusTokenGalleryView& operator=(const PrometheusTokenGalleryView&) =
+      delete;
+  ~PrometheusTokenGalleryView() override;
+
+  // views::ScrollView:
+  void AddedToWidget() override;
+  void OnThemeChanged() override;
+
+  // Test accessor (avoids the browsertest reaching into privates): number of
+  // color rows the gallery currently contains. Expected to always be 20 (one
+  // per kColorPrometheus* id) both before and after an OnThemeChanged()
+  // rebuild.
+  size_t color_row_count() const { return color_row_count_; }
+
+ private:
+  // Builds (or rebuilds) the contents view: a two-column table of token name
+  // + resolved color swatch for all 20 kColorPrometheus* ids. Called from
+  // the constructor and from OnThemeChanged() so the gallery always reflects
+  // the current ColorProvider.
+  void CreateGallery();
+
+  size_t color_row_count_ = 0;
+};
+
+#endif  // DCHECK_IS_ON()
+
+#endif  // CHROME_BROWSER_UI_VIEWS_PROMETHEUS_PROMETHEUS_TOKEN_GALLERY_VIEW_H_
