-void PrometheusAgentGateway::HandleNativeRequest(std::string_view path,
-                                                 std::string_view body,
-                                                 ResponseCallback callback) {
+void PrometheusAgentGateway::HandleNativeRequest(
+    std::string_view path,
+    std::string_view body,
+    SupervisionGatewayCancellationToken cancellation,
+    ResponseCallback callback) {
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
   PruneSessionBindings();
 
+  if (path == "/v1/supervision") {
+    auto request = ParseSupervisionTransportRequest(body);
+    if (!request.has_value()) {
+      std::move(callback).Run(net::HTTP_BAD_REQUEST,
+                              SerializeSupervisionResponse(request.error()));
+      return;
+    }
+    if (!supervision_dispatcher_) {
+      std::move(callback).Run(
+          net::HTTP_OK,
+          SerializeSupervisionResponse(
+              SupervisionUnavailable(request->operation)));
+      return;
+    }
+
+    const SupervisionTransportOperation operation = request->operation;
+    if (!cancellation ||
+        pending_supervision_requests_.contains(cancellation.value)) {
+      std::move(callback).Run(
+          net::HTTP_OK,
+          SerializeSupervisionResponse(
+              SupervisionTransportResult::TransportFailure(
+                  operation, SupervisionTransportErrorCode::kInternal,
+                  "The supervision request token was already active",
+                  "Retry the supervision request")));
+      return;
+    }
+    pending_supervision_requests_.emplace(
+        cancellation.value,
+        PendingSupervisionRequest{operation, std::move(callback)});
+    supervision_dispatcher_->dispatch.Run(
+        SupervisionGatewayRequest{.transport = std::move(request.value()),
+                                  .cancellation_token = cancellation},
+        base::BindOnce(
+            &PrometheusAgentGateway::OnSupervisionRequestCompleted,
+            weak_ptr_factory_.GetWeakPtr(), cancellation));
+    return;
+  }
+
   if (path == "/v1/health") {
     GlobalBrowserCollection* const browsers =
         GetGlobalBrowserCollectionIfAvailable();
