+// The one-shot ui::SelectFileDialog this controller installs immediately
+// before -- and only for -- the real Load-unpacked click. It never shows a
+// platform picker: SelectFileImpl() either delivers the bootstrap-verified
+// fixture directory through the ordinary Listener::FileSelected() callback,
+// or declines (FileSelectionCanceled()) for anything that does not match
+// every expected fact.
+class PrometheusExtensionSmokeController::OneShotChooser
+    : public ui::SelectFileDialog {
+ public:
+  OneShotChooser(base::WeakPtr<PrometheusExtensionSmokeController> controller,
+                Listener* listener,
+                std::unique_ptr<ui::SelectFilePolicy> policy)
+      : ui::SelectFileDialog(listener, std::move(policy)),
+        controller_(std::move(controller)) {}
+  OneShotChooser(const OneShotChooser&) = delete;
+  OneShotChooser& operator=(const OneShotChooser&) = delete;
+
+ private:
+  ~OneShotChooser() override = default;
+
+  // ui::SelectFileDialog:
+  void SelectFileImpl(Type type,
+                      const std::u16string& title,
+                      const base::FilePath& default_path,
+                      const FileTypeInfo* file_types,
+                      int file_type_index,
+                      const base::FilePath::StringType& default_extension,
+                      gfx::NativeWindow owning_window,
+                      const GURL* caller) override {
+    Listener* current_listener = listener_;
+    if (!current_listener) {
+      return;
+    }
+    const bool matches =
+        controller_ &&
+        controller_->stage_ ==
+            PrometheusExtensionSmokeStage::kLoadUnpackedClicked &&
+        type == SELECT_EXISTING_FOLDER &&
+        title == controller_->expected_chooser_title_ &&
+        owning_window == controller_->expected_chooser_window_ && caller &&
+        *caller == controller_->expected_chooser_caller_ &&
+        !controller_->expected_chooser_caller_.is_empty();
+    if (!matches) {
+      current_listener->FileSelectionCanceled();
+      return;
+    }
+    const base::FilePath fixture_path = controller_->bootstrap_->fixture_path();
+    controller_->OnChooserInvoked();
+    current_listener->FileSelected(ui::SelectedFileInfo(fixture_path),
+                                   /*index=*/0);
+  }
+  bool HasMultipleFileTypeChoicesImpl() override { return false; }
+  bool IsRunning(gfx::NativeWindow owning_window) const override {
+    return false;
+  }
+  void ListenerDestroyed() override { listener_ = nullptr; }
+
+  base::WeakPtr<PrometheusExtensionSmokeController> controller_;
+};
+
+// Creates exactly one OneShotChooser and then immediately removes itself as
+// the global ui::SelectFileDialog factory: this factory answers at most one
+// SelectFileDialog::Create() call, matched or not, so a second or unrelated
+// picker anywhere in the browser always reaches the ordinary platform
+// dialog instead of this seam.
+class PrometheusExtensionSmokeController::OneShotChooserFactory
+    : public ui::SelectFileDialogFactory {
+ public:
+  explicit OneShotChooserFactory(
+      base::WeakPtr<PrometheusExtensionSmokeController> controller)
+      : controller_(std::move(controller)) {}
+  OneShotChooserFactory(const OneShotChooserFactory&) = delete;
+  OneShotChooserFactory& operator=(const OneShotChooserFactory&) = delete;
+  ~OneShotChooserFactory() override = default;
+
+  ui::SelectFileDialog* Create(
+      ui::SelectFileDialog::Listener* listener,
+      std::unique_ptr<ui::SelectFilePolicy> policy) override {
+    // Copy to the stack first: SetFactory(nullptr) deletes the currently
+    // installed factory, i.e. `this`. Nothing below may read a member of
+    // `this` after that call.
+    base::WeakPtr<PrometheusExtensionSmokeController> controller = controller_;
+    ui::SelectFileDialog::SetFactory(nullptr);
+    return new OneShotChooser(std::move(controller), listener,
+                              std::move(policy));
+  }
+
+ private:
+  base::WeakPtr<PrometheusExtensionSmokeController> controller_;
+};
