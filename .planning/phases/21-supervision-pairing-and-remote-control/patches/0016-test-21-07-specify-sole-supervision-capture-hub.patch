+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_supervision_capture_hub.h"
+
+#include "base/time/time.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "net/dns/mock_host_resolver.h"
+
+namespace prometheus {
+
+class PrometheusSupervisionCaptureHubBrowserTest
+    : public InProcessBrowserTest {
+ public:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), embedded_test_server()->GetURL("/title1.html")));
+  }
+
+  content::WebContents* contents() {
+    return browser()->tab_strip_model()->GetActiveWebContents();
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(PrometheusSupervisionCaptureHubBrowserTest,
+                       TwoConsumersUseOneRendererEnableAndApcCapture) {
+  ASSERT_TRUE(contents());
+  PrometheusSupervisionCaptureHub hub(contents(), 23);
+
+  const auto first = hub.AttachConsumer(
+      SupervisionCaptureConsumerKind::kDashboard,
+      base::Time::Now() + base::Minutes(5));
+  const auto second = hub.AttachConsumer(
+      SupervisionCaptureConsumerKind::kAgentCompatibility,
+      base::Time::Now() + base::Minutes(5));
+
+  EXPECT_TRUE(first.has_value());
+  EXPECT_TRUE(second.has_value());
+  EXPECT_EQ(1u, hub.enable_count_for_testing());
+  EXPECT_EQ(1u, hub.capture_count_for_testing());
+}
+
+IN_PROC_BROWSER_TEST_F(PrometheusSupervisionCaptureHubBrowserTest,
+                       NavigationTearsDownOldDocumentBeforeRebinding) {
+  ASSERT_TRUE(contents());
+  PrometheusSupervisionCaptureHub hub(contents(), 24);
+  EXPECT_TRUE(hub.AttachConsumer(SupervisionCaptureConsumerKind::kDashboard,
+                                 base::Time::Now() + base::Minutes(5))
+                  .has_value());
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title2.html")));
+  EXPECT_EQ(2u, hub.enable_count_for_testing());
+  EXPECT_EQ(1u, hub.disable_count_for_testing());
+  EXPECT_EQ(2u, hub.capture_count_for_testing());
+}
+
+IN_PROC_BROWSER_TEST_F(PrometheusSupervisionCaptureHubBrowserTest,
+                       LastDetachDisablesTheOnlyRendererGeneration) {
+  ASSERT_TRUE(contents());
+  PrometheusSupervisionCaptureHub hub(contents(), 25);
+  const auto first = hub.AttachConsumer(
+      SupervisionCaptureConsumerKind::kDashboard,
+      base::Time::Now() + base::Minutes(5));
+  const auto second = hub.AttachConsumer(
+      SupervisionCaptureConsumerKind::kDashboard,
+      base::Time::Now() + base::Minutes(5));
+  ASSERT_TRUE(first.has_value());
+  ASSERT_TRUE(second.has_value());
+
+  EXPECT_TRUE(hub.DetachConsumer(*first));
+  EXPECT_EQ(0u, hub.disable_count_for_testing());
+  EXPECT_TRUE(hub.DetachConsumer(*second));
+  EXPECT_EQ(1u, hub.disable_count_for_testing());
+}
+
+}  // namespace prometheus
