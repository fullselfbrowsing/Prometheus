+template <typename Enum, size_t N>
+std::optional<Enum> EnumFromString(
+    std::string_view value,
+    const std::array<std::pair<Enum, std::string_view>, N>& names) {
+  for (const auto& [candidate, name] : names) {
+    if (value == name) {
+      return candidate;
+    }
+  }
+  return std::nullopt;
+}
+
+template <typename Enum, size_t N>
+std::optional<std::string_view> EnumToString(
+    Enum value,
+    const std::array<std::pair<Enum, std::string_view>, N>& names) {
+  for (const auto& [candidate, name] : names) {
+    if (value == candidate) {
+      return name;
+    }
+  }
+  return std::nullopt;
+}
