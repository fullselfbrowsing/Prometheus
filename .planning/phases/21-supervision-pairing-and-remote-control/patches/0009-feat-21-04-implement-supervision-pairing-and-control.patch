+PrometheusSupervisionProfileService::ObservedTab*
+PrometheusSupervisionProfileService::AcquireObservedTab(
+    tabs::TabInterface* tab) {
+  if (!tab || !observe_tab_data_) {
+    return nullptr;
+  }
+  const int32_t stable_tab_id = tab->GetHandle().raw_value();
+  auto existing = observed_tabs_.find(stable_tab_id);
+  if (existing != observed_tabs_.end()) {
+    return existing->second->tab == tab && existing->second->lease.data()
+               ? existing->second.get()
+               : nullptr;
+  }
+
+  auto observed = std::make_unique<ObservedTab>();
+  observed->stable_tab_id = stable_tab_id;
+  observed->tab = tab;
+  observed->observer = std::make_unique<TabOwnerObserver>(
+      weak_factory_.GetWeakPtr(), stable_tab_id);
+  observed->lease = observe_tab_data_.Run(tab, observed->observer.get());
+  if (!observed->lease.data()) {
+    return nullptr;
+  }
+  ObservedTab* result = observed.get();
+  observed_tabs_[stable_tab_id] = std::move(observed);
+  return result;
+}
