+    PruneHistory();
+    return true;
+  }
+
+  if (!state.offered_diff_sequence.has_value() ||
+      *state.offered_diff_sequence != state.next_sequence ||
+      stamp.sequence != state.next_sequence) {
+    RequireBaseline(state);
+    PruneHistory();
+    return false;
