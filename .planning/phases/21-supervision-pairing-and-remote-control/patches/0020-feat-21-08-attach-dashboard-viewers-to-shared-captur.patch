+TEST_F(PrometheusSupervisionProfileServiceTest,
+       HubLaggingViewerResyncDoesNotAdvanceCurrentViewer) {
+  SupervisionLimits limits;
+  limits.retained_batches = 1;
+  ResetService(SupervisionProfileKind::kRegular, limits);
+  SupervisionPairingCreationResult first = CreatePairing();
+  ASSERT_TRUE(first.ok);
+  SupervisionRedemptionResult lagging = Redeem(first, "Lagging");
+  ASSERT_TRUE(lagging.ok);
+  SupervisionPairingCreationResult second = CreatePairing();
+  ASSERT_TRUE(second.ok);
+  SupervisionRedemptionResult current = Redeem(second, "Current");
+  ASSERT_TRUE(current.ok);
+
+  capture_source_.CompleteNext(MakeServiceBaseline("baseline"));
+  SupervisionDashboardBaselineResult lagging_baseline =
+      service_->ReadDashboardBaseline(lagging.dashboard_session);
+  SupervisionDashboardBaselineResult current_baseline =
+      service_->ReadDashboardBaseline(current.dashboard_session);
+  ASSERT_TRUE(lagging_baseline.delivery.has_value());
+  ASSERT_TRUE(current_baseline.delivery.has_value());
+  ASSERT_TRUE(service_
+                  ->AckDashboard(lagging.dashboard_session,
+                                 lagging_baseline.delivery->stamp)
+                  .ok);
+  ASSERT_TRUE(service_
+                  ->AckDashboard(current.dashboard_session,
+                                 current_baseline.delivery->stamp)
+                  .ok);
+
+  PrometheusSupervisionCaptureHub* hub =
+      service_->capture_hub_for_testing(first.stable_tab_id);
+  ASSERT_NE(nullptr, hub);
+  hub->NotifyDirtyForTesting(/*overflow=*/false);
+  capture_source_.CompleteNext(MakeServiceBaseline("mutation one"));
+  SupervisionDashboardDiffResult first_current =
+      service_->ReadDashboardDiff(current.dashboard_session);
+  ASSERT_TRUE(first_current.delivery.has_value());
+  ASSERT_TRUE(service_
+                  ->AckDashboard(current.dashboard_session,
+                                 first_current.delivery->stamp)
+                  .ok);
+
+  hub->NotifyDirtyForTesting(/*overflow=*/false);
+  capture_source_.CompleteNext(MakeServiceBaseline("mutation two"));
+  SupervisionDashboardDiffResult lagged =
+      service_->ReadDashboardDiff(lagging.dashboard_session);
+  EXPECT_FALSE(lagged.ok);
+  EXPECT_EQ(SupervisionErrorCode::kResyncRequired, lagged.error_code);
+  SupervisionDashboardDiffResult second_current =
+      service_->ReadDashboardDiff(current.dashboard_session);
+  ASSERT_TRUE(second_current.ok);
+  ASSERT_TRUE(second_current.delivery.has_value());
+
+  SupervisionDashboardBaselineResult replacement =
+      service_->ReadDashboardBaseline(lagging.dashboard_session);
+  ASSERT_TRUE(replacement.ok);
+  ASSERT_TRUE(replacement.delivery.has_value());
+  EXPECT_EQ(second_current.delivery->stamp.sequence,
+            replacement.delivery->stamp.sequence);
+  EXPECT_TRUE(
+      service_
+          ->AckDashboard(lagging.dashboard_session, replacement.delivery->stamp)
+          .ok);
+  EXPECT_TRUE(service_->ReadDashboardDiff(current.dashboard_session)
+                  .delivery.has_value());
+}
