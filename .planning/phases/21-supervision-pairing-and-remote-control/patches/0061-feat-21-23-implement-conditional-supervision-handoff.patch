+
+bool IsLoopbackHttpOrigin(std::string_view origin) {
+  const GURL url(origin);
+  if (!url.is_valid() || !url.SchemeIs("http") || url.has_username() ||
+      url.has_password() || url.has_query() || url.has_ref() ||
+      (url.path() != "/" && !url.path().empty())) {
+    return false;
+  }
+  const std::string host = base::ToLowerASCII(url.host());
+  if (host != "localhost" && host != "127.0.0.1" && host != "[::1]" &&
+      host != "::1") {
+    return false;
+  }
+  std::string canonical = url.DeprecatedGetOriginAsURL().spec();
+  if (canonical.ends_with('/')) {
+    canonical.pop_back();
+  }
+  return canonical == origin;
+}
