+TEST(PrometheusAgentGatewayTest,
+     DiscoveryTrackerFailsClosedAtBoundAndReleasesSessionEntries) {
+  PrometheusGatewayDiscoveryTracker tracker;
+  int start_calls = 0;
+  auto start = base::BindRepeating(
+      [](int* calls, std::string_view provider_id) {
+        ++*calls;
+        return RuntimeTransportResult::Success(
+            RuntimeRouteName::kDiscoverModels,
+            RuntimeModelListResult{.operation_id = std::to_string(*calls),
+                                   .models = {},
+                                   .pending = true});
+      },
+      &start_calls);
+  DiscoverModelsParams params{.provider_id = "provider-1"};
+
+  for (size_t index = 0; index < kMaxGatewayDiscoveryOperations; ++index) {
+    const std::string session_id = "session-" + std::to_string(index % 8);
+    const std::string caller_id = "caller-" + std::to_string(index % 8);
+    RuntimeTransportResult result =
+        tracker.Dispatch(params, session_id, caller_id, start,
+                         PrometheusGatewayDiscoveryTracker::StatusCallback());
+    ASSERT_TRUE(result.ok) << index;
+  }
+  EXPECT_EQ(kMaxGatewayDiscoveryOperations,
+            tracker.operation_count_for_testing());
+
+  RuntimeTransportResult saturated =
+      tracker.Dispatch(params, "session-overflow", "caller-overflow", start,
+                       PrometheusGatewayDiscoveryTracker::StatusCallback());
+  EXPECT_FALSE(saturated.ok);
+  EXPECT_EQ(RuntimeTransportErrorCode::kCapabilityNotReady,
+            saturated.error_code);
+  EXPECT_EQ(static_cast<int>(kMaxGatewayDiscoveryOperations), start_calls);
+
+  tracker.RemoveSession("session-0");
+  EXPECT_EQ(kMaxGatewayDiscoveryOperations - 64,
+            tracker.operation_count_for_testing());
+  EXPECT_TRUE(tracker
+                  .Dispatch(params, "session-replacement", "caller-replacement",
+                            start,
+                            PrometheusGatewayDiscoveryTracker::StatusCallback())
+                  .ok);
+}
+
+TEST(PrometheusAgentGatewayTest,
+     RuntimeTaskTrackerReconcilesEvictionAndReleasesSessionEntries) {
+  PrometheusGatewayRuntimeTaskTracker tracker;
+  constexpr size_t kScopeCount = 8;
+  constexpr size_t kTasksPerScope = kMaxStoredRuntimeTasks;
+  std::array<int, kScopeCount> runtime_scope_tokens{};
+
+  for (size_t scope_index = 0; scope_index < kScopeCount; ++scope_index) {
+    const void* runtime_scope = &runtime_scope_tokens[scope_index];
+    for (size_t task_index = 0; task_index < kTasksPerScope; ++task_index) {
+      ASSERT_TRUE(tracker.Record(runtime_scope,
+                                 "task-" + std::to_string(scope_index) + "-" +
+                                     std::to_string(task_index),
+                                 "session-" + std::to_string(scope_index),
+                                 "caller-" + std::to_string(scope_index)));
+    }
+  }
+  EXPECT_EQ(kMaxGatewayRuntimeTaskOwners, tracker.task_count_for_testing());
+  int overflow_scope = 0;
+  EXPECT_FALSE(tracker.Record(&overflow_scope, "overflow", "overflow-session",
+                              "overflow-caller"));
+
+  const void* first_scope = &runtime_scope_tokens.front();
+  RuntimeStoreSnapshot retained;
+  for (size_t task_index = 1; task_index < kTasksPerScope; ++task_index) {
+    RuntimeStoredTask task;
+    task.snapshot.task_id = "task-0-" + std::to_string(task_index);
+    retained.tasks.push_back(std::move(task));
+  }
+  RuntimeStoredTask replacement;
+  replacement.snapshot.task_id = "task-0-replacement";
+  retained.tasks.push_back(std::move(replacement));
+  tracker.Reconcile(first_scope, retained);
+  EXPECT_EQ(kMaxGatewayRuntimeTaskOwners - 1, tracker.task_count_for_testing());
+  EXPECT_FALSE(tracker.Owns(first_scope, "task-0-0", "session-0", "caller-0"));
+  EXPECT_TRUE(tracker.Record(first_scope, "task-0-replacement", "session-0",
+                             "caller-0"));
+  EXPECT_TRUE(
+      tracker.Owns(first_scope, "task-0-replacement", "session-0", "caller-0"));
+  EXPECT_EQ(kMaxGatewayRuntimeTaskOwners, tracker.task_count_for_testing());
+
+  tracker.RemoveSession("session-0");
+  EXPECT_EQ(kMaxGatewayRuntimeTaskOwners - kTasksPerScope,
+            tracker.task_count_for_testing());
+  EXPECT_FALSE(
+      tracker.Owns(first_scope, "task-0-replacement", "session-0", "caller-0"));
+}
