+TEST(PrometheusAgentGatewayTest,
+     SupervisionDispatchesEveryClosedOperationThroughFake) {
+  FakeSupervisionGatewayDispatcher fake;
+  PrometheusAgentGateway gateway({});
+  gateway.SetSupervisionGatewayDispatcher(fake.Bind());
+
+  for (size_t index = 0; index < kSupervisionRequests.size(); ++index) {
+    SCOPED_TRACE(index);
+    auto expected =
+        ParseSupervisionTransportRequest(kSupervisionRequests[index]);
+    ASSERT_TRUE(expected.has_value()) << expected.error().message;
+    NativeResponse response =
+        HandleSupervisionRequest(gateway, kSupervisionRequests[index]);
+    EXPECT_EQ(1u, response.callbacks);
+    EXPECT_EQ(net::HTTP_OK, response.status);
+    auto body = base::JSONReader::ReadDict(response.body, base::JSON_PARSE_RFC);
+    ASSERT_TRUE(body.has_value());
+    EXPECT_EQ(true, body->FindBool("ok"));
+    ASSERT_EQ(index + 1, fake.requests.size());
+    EXPECT_EQ(expected->operation, fake.requests.back().transport.operation);
+    EXPECT_EQ(expected->params.index(),
+              fake.requests.back().transport.params.index());
+    EXPECT_TRUE(fake.requests.back().cancellation_token);
+  }
+  EXPECT_EQ(kSupervisionTransportOperationCount, fake.requests.size());
+  EXPECT_TRUE(fake.cancellations.empty());
+}
