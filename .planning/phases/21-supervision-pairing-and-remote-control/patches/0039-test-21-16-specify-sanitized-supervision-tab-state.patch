 PrometheusAgentTabData::~PrometheusAgentTabData() {
+  for (PrometheusTabStateObserver& observer : tab_state_observers_) {
+    observer.OnPrometheusTabStateInvalidated();
+  }
+  tab_state_observers_.Clear();
   for (Observer& observer : observers_) {
     observer.OnPrometheusAgentTabDataDestroying();
   }
   observers_.Clear();
 }
 
+void PrometheusAgentTabData::AddTabStateObserver(
+    PrometheusTabStateObserver* observer) {
+  if (observer && !tab_state_observers_.HasObserver(observer)) {
+    tab_state_observers_.AddObserver(observer);
+  }
+}
+
+void PrometheusAgentTabData::RemoveTabStateObserver(
+    PrometheusTabStateObserver* observer) {
+  if (observer && tab_state_observers_.HasObserver(observer)) {
+    tab_state_observers_.RemoveObserver(observer);
+  }
+}
+
 void PrometheusAgentTabData::AddObserver(Observer* observer) {
   observers_.AddObserver(observer);
 }
