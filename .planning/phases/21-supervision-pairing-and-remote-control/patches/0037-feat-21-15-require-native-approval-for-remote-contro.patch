+void PrometheusSupervisionProfileService::OnEnableControlConfirmation(
+    const base::UnguessableToken& dashboard_session,
+    uint64_t confirmation_generation,
+    uint64_t authority_generation,
+    PrometheusSupervisionDialogResult result) {
+  auto viewer = viewers_.find(dashboard_session);
+  if (shutdown_ || viewer == viewers_.end() ||
+      !viewer->second->awaiting_enable_confirmation ||
+      viewer->second->enable_confirmation_generation !=
+          confirmation_generation) {
+    return;
+  }
+
+  content::WebContents* const expected_contents =
+      viewer->second->enable_target_contents;
+  const GURL expected_url = viewer->second->enable_target_url;
+  const std::optional<base::UnguessableToken> expected_document_epoch =
+      viewer->second->enable_document_epoch;
+  viewer->second->awaiting_enable_confirmation = false;
+  viewer->second->enable_target_contents = nullptr;
+  viewer->second->enable_target_url = GURL();
+  viewer->second->enable_document_epoch.reset();
+  if (result != PrometheusSupervisionDialogResult::kApproved) {
+    return;
+  }
+
+  SweepExpired();
+  viewer = viewers_.find(dashboard_session);
+  if (viewer == viewers_.end() ||
+      viewer->second->authority_generation != authority_generation ||
+      viewer->second->enable_confirmation_generation !=
+          confirmation_generation ||
+      viewer->second->viewer_state != SupervisionViewerState::kViewOnly ||
+      viewer->second->controller_lease.has_value() ||
+      viewer->second->immutable_owner_session_id.empty() ||
+      viewer->second->expires_at <= Now()) {
+    return;
+  }
+  if (!RevalidateViewerOwner(dashboard_session)) {
+    return;
+  }
+  viewer = viewers_.find(dashboard_session);
+  if (viewer == viewers_.end()) {
+    return;
+  }
+  tabs::TabInterface* const exact_tab = ResolveExactTarget(*viewer->second);
+  if (!exact_tab || exact_tab->GetContents() != expected_contents ||
+      exact_tab->GetURL() != expected_url) {
+    return;
+  }
+
+  std::optional<base::UnguessableToken> current_document_epoch;
+  if (CaptureHubEntry* const capture_hub = FindCaptureHub(*viewer->second);
+      capture_hub && viewer->second->capture_consumer_token.has_value()) {
+    std::optional<SupervisionCaptureBaselineDelivery> current =
+        capture_hub->hub->ReadCurrentBaseline(
+            *viewer->second->capture_consumer_token);
+    if (current.has_value()) {
+      current_document_epoch = current->stamp.document_epoch;
+    }
+  }
+  if (current_document_epoch != expected_document_epoch) {
+    return;
+  }
+
+  const int32_t stable_tab_id = viewer->second->stable_tab_id;
+  if (controllers_.contains(stable_tab_id)) {
+    return;
+  }
   controllers_[stable_tab_id] = dashboard_session;
   viewer->second->viewer_state = SupervisionViewerState::kController;
   viewer->second->controller_lease = base::UnguessableToken::Create();
@@ -988,7 +1144,6 @@ SupervisionServiceResult PrometheusSupervisionProfileService::EnableControl(
   AddAudit(stable_tab_id, SupervisionAuditEvent::kControlEnabled,
            std::optional<std::string>(viewer->second->client_label));
   NotifySnapshotChanged(stable_tab_id);
-  return SupervisionServiceResult::Success();
