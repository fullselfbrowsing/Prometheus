@@ -0,0 +1,237 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/modules/content_extraction/prometheus_supervision_document_supplement.h"
+
+#include "base/test/task_environment.h"
+#include "base/time/time.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/frame/frame_test_helpers.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/core/html/html_div_element.h"
+#include "third_party/blink/renderer/core/html_names.h"
+#include "third_party/blink/renderer/platform/testing/task_environment.h"
+#include "third_party/blink/renderer/platform/testing/unit_test_helpers.h"
+#include "third_party/blink/renderer/platform/testing/url_test_helpers.h"
+
+namespace blink {
+
+namespace {
+
+using DirtySignal = mojom::blink::PrometheusSupervisionDirtySignal;
+
+class RecordingHost final
+    : public mojom::blink::PrometheusSupervisionDocumentHost {
+ public:
+  mojo::PendingRemote<mojom::blink::PrometheusSupervisionDocumentHost>
+  BindNewPipeAndPassRemote() {
+    return receiver_.BindNewPipeAndPassRemote();
+  }
+
+  void OnDocumentDirty(DirtySignal signal) override {
+    signals_.push_back(signal);
+  }
+
+  const Vector<DirtySignal>& signals() const { return signals_; }
+  void Disconnect() { receiver_.reset(); }
+
+ private:
+  mojo::Receiver<mojom::blink::PrometheusSupervisionDocumentHost> receiver_{
+      this};
+  Vector<DirtySignal> signals_;
+};
+
+class PrometheusSupervisionDocumentSupplementTest : public testing::Test {
+ public:
+  void SetUp() override {
+    helper_.Initialize();
+    LoadHTML("<html><body></body></html>");
+    BindDocument();
+  }
+
+ protected:
+  void LoadHTML(const std::string& html) {
+    frame_test_helpers::LoadHTMLString(
+        helper_.LocalMainFrame(), html,
+        url_test_helpers::ToKURL("https://example.test/"));
+  }
+
+  Document& GetDocument() {
+    return *helper_.LocalMainFrame()->GetFrame()->GetDocument();
+  }
+
+  void BindDocument() {
+    document_remote_.reset();
+    PrometheusSupervisionDocumentSupplement::BindReceiver(
+        helper_.LocalMainFrame()->GetFrame(),
+        document_remote_.BindNewPipeAndPassReceiver());
+    document_remote_.FlushForTesting();
+  }
+
+  void Enable(RecordingHost& host) {
+    document_remote_->Enable(host.BindNewPipeAndPassRemote());
+    document_remote_.FlushForTesting();
+  }
+
+  void MutateAttribute(const char* value) {
+    GetDocument().documentElement()->setAttribute(html_names::kClassAttr,
+                                                  AtomicString(value));
+    test::RunPendingTasks();
+  }
+
+  void AppendMutations(size_t count) {
+    for (size_t i = 0; i < count; ++i) {
+      GetDocument().body()->AppendChild(
+          MakeGarbageCollected<HTMLDivElement>(GetDocument()));
+    }
+    test::RunPendingTasks();
+  }
+
+  void AdvanceDebounce() {
+    task_environment_.FastForwardBy(base::Milliseconds(50));
+    test::RunPendingTasks();
+  }
+
+  test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  frame_test_helpers::WebViewHelper helper_;
+  mojo::Remote<mojom::blink::PrometheusSupervisionDocument> document_remote_;
+};
+
+TEST_F(PrometheusSupervisionDocumentSupplementTest, DirtyAfterDebounce) {
+  RecordingHost host;
+  Enable(host);
+
+  MutateAttribute("one");
+  EXPECT_TRUE(host.signals().empty());
+  task_environment_.FastForwardBy(base::Milliseconds(49));
+  test::RunPendingTasks();
+  EXPECT_TRUE(host.signals().empty());
+  task_environment_.FastForwardBy(base::Milliseconds(1));
+  test::RunPendingTasks();
+
+  ASSERT_EQ(host.signals().size(), 1u);
+  EXPECT_EQ(host.signals()[0], DirtySignal::kDirty);
+}
+
+TEST_F(PrometheusSupervisionDocumentSupplementTest, DirtyBurstCoalesces) {
+  RecordingHost host;
+  Enable(host);
+
+  MutateAttribute("one");
+  MutateAttribute("two");
+  MutateAttribute("three");
+  AdvanceDebounce();
+
+  ASSERT_EQ(host.signals().size(), 1u);
+  EXPECT_EQ(host.signals()[0], DirtySignal::kDirty);
+}
+
+TEST_F(PrometheusSupervisionDocumentSupplementTest, OverflowCollapsesBurst) {
+  RecordingHost host;
+  Enable(host);
+
+  AppendMutations(1024u);
+  AdvanceDebounce();
+
+  ASSERT_EQ(host.signals().size(), 1u);
+  EXPECT_EQ(host.signals()[0], DirtySignal::kOverflow);
+}
+
+TEST_F(PrometheusSupervisionDocumentSupplementTest, DisableCancelsSignal) {
+  RecordingHost host;
+  Enable(host);
+  MutateAttribute("one");
+
+  document_remote_->Disable();
+  document_remote_.FlushForTesting();
+  AdvanceDebounce();
+
+  EXPECT_TRUE(host.signals().empty());
+}
+
+TEST_F(PrometheusSupervisionDocumentSupplementTest,
+       RepeatedEnableReplacesHost) {
+  RecordingHost first_host;
+  RecordingHost second_host;
+  Enable(first_host);
+  Enable(second_host);
+
+  MutateAttribute("one");
+  AdvanceDebounce();
+
+  EXPECT_TRUE(first_host.signals().empty());
+  ASSERT_EQ(second_host.signals().size(), 1u);
+  EXPECT_EQ(second_host.signals()[0], DirtySignal::kDirty);
+}
+
+TEST_F(PrometheusSupervisionDocumentSupplementTest,
+       ReceiverDisconnectCancelsSignal) {
+  RecordingHost host;
+  Enable(host);
+  MutateAttribute("one");
+
+  document_remote_.reset();
+  test::RunPendingTasks();
+  AdvanceDebounce();
+
+  EXPECT_TRUE(host.signals().empty());
+}
+
+TEST_F(PrometheusSupervisionDocumentSupplementTest,
+       HostDisconnectCancelsSignal) {
+  RecordingHost host;
+  Enable(host);
+  MutateAttribute("one");
+
+  host.Disconnect();
+  test::RunPendingTasks();
+  AdvanceDebounce();
+
+  EXPECT_TRUE(host.signals().empty());
+}
+
+TEST_F(PrometheusSupervisionDocumentSupplementTest,
+       DocumentReplacementDropsOldSignal) {
+  RecordingHost old_host;
+  Enable(old_host);
+  MutateAttribute("old");
+
+  Document* old_document = &GetDocument();
+  auto* old_supplement =
+      PrometheusSupervisionDocumentSupplement::From(*old_document);
+  ASSERT_TRUE(old_supplement);
+  LoadHTML("<html><body>replacement</body></html>");
+  EXPECT_NE(old_document, &GetDocument());
+  BindDocument();
+  auto* new_supplement =
+      PrometheusSupervisionDocumentSupplement::From(GetDocument());
+  ASSERT_TRUE(new_supplement);
+  EXPECT_NE(old_supplement, new_supplement);
+
+  AdvanceDebounce();
+  EXPECT_TRUE(old_host.signals().empty());
+}
+
+TEST_F(PrometheusSupervisionDocumentSupplementTest,
+       RepeatedTeardownIsIdempotent) {
+  RecordingHost host;
+  Enable(host);
+
+  document_remote_->Disable();
+  document_remote_->Disable();
+  document_remote_.FlushForTesting();
+  document_remote_.reset();
+  host.Disconnect();
+  test::RunPendingTasks();
+
+  SUCCEED();
+}
+
+}  // namespace
+
+}  // namespace blink
