+TEST_F(PrometheusSupervisionProfileServiceTest,
+       EnableControlDenyOwnerLossAndExpiryNeverCreateLease) {
+  PrometheusAgentTabObservationLease owner_lease =
+      agent_service_->ObserveOrCreateTabData(&tab_, &observer_tab_data_);
+  ASSERT_NE(nullptr, owner_lease.data());
+  ASSERT_TRUE(owner_lease.data()->ClaimIfUnowned("owner-a", "Agent A").ok);
+  hold_dialog_callbacks_ = true;
+
+  SupervisionPairingCreationResult denied_creation = CreatePairing();
+  ASSERT_TRUE(denied_creation.ok);
+  SupervisionRedemptionResult denied = Redeem(denied_creation, "Denied");
+  ASSERT_TRUE(denied.ok);
+  ASSERT_TRUE(service_->EnableControl(denied.dashboard_session).ok);
+  ReplyToNextDialog(PrometheusSupervisionDialogResult::kDenied);
+  EXPECT_EQ(0u, service_->controller_count_for_testing());
+
+  SupervisionPairingCreationResult owner_creation = CreatePairing();
+  ASSERT_TRUE(owner_creation.ok);
+  SupervisionRedemptionResult owner_lost =
+      Redeem(owner_creation, "Owner lost");
+  ASSERT_TRUE(owner_lost.ok);
+  ASSERT_TRUE(service_->EnableControl(owner_lost.dashboard_session).ok);
+  ASSERT_TRUE(owner_lease.data()->ReleaseIfOwned("owner-a").ok);
+  ReplyToNextDialog(PrometheusSupervisionDialogResult::kApproved);
+  EXPECT_EQ(0u, service_->controller_count_for_testing());
+  EXPECT_EQ(0u,
+            service_->viewer_count_for_testing(owner_creation.stable_tab_id));
+
+  ASSERT_TRUE(owner_lease.data()->ClaimIfUnowned("owner-b", "Agent B").ok);
+  SupervisionPairingCreationResult expiry_creation = CreatePairing();
+  ASSERT_TRUE(expiry_creation.ok);
+  SupervisionRedemptionResult expired =
+      Redeem(expiry_creation, "Expired");
+  ASSERT_TRUE(expired.ok);
+  ASSERT_TRUE(service_->EnableControl(expired.dashboard_session).ok);
+  now_ += base::Minutes(16);
+  ReplyToNextDialog(PrometheusSupervisionDialogResult::kApproved);
