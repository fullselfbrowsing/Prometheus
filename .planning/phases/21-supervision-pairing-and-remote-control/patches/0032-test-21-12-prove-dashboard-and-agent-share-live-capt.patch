+IN_PROC_BROWSER_TEST_F(
+    PrometheusAgentGatewayBrowserTest,
+    SupervisionCommandSemanticsUseProductionBindingsAndUnbindSafely) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title1.html")));
+  tabs::TabInterface* const target_tab =
+      TabListInterface::From(browser())->GetActiveTab();
+  ASSERT_TRUE(target_tab);
+  const int32_t stable_tab_id = target_tab->GetHandle().raw_value();
+  const int32_t window_id = browser()->GetSessionID().id();
+
+  production_parts_ = std::make_unique<PrometheusBrowserMainExtraParts>(true);
+  production_parts_->PostBrowserStart();
+  ASSERT_TRUE(
+      production_parts_->BindSupervisionGatewayForTesting(gateway_.get()));
+  EXPECT_EQ(1u, supervision_shutdowns_);
+
+  HttpResult created =
+      Authorized("POST", "/v1/session/create",
+                 R"({"display_label":"Production supervision Agent"})");
+  ASSERT_EQ(200, created.status);
+  const std::string agent_session = ExtractSessionId(created);
+  ASSERT_FALSE(agent_session.empty());
+
+  const std::string exact_target =
+      "{\"browser_session_id\":" + std::to_string(window_id) +
+      ",\"window_session_id\":" + std::to_string(window_id) +
+      ",\"tab_id\":" + std::to_string(stable_tab_id) + "}";
+  HttpResult claimed =
+      Authorized("POST", "/v1/agent/command",
+                 "{\"route\":\"activate_tab\",\"session_id\":\"" +
+                     agent_session + "\",\"target\":" + exact_target + "}");
+  ASSERT_EQ(200, claimed.status);
+  EXPECT_NE(std::string::npos, claimed.body.find("\"ok\":true"));
+
+  PrometheusSupervisionProfileService* const service =
+      PrometheusSupervisionProfileServiceFactory::GetForProfile(
+          browser()->profile());
+  ASSERT_TRUE(service);
+  SupervisionPairingCreationResult pairing =
+      service->CreatePairing(browser(), target_tab);
+  ASSERT_TRUE(pairing.ok) << pairing.message;
+
+  HttpResult redeemed =
+      Authorized("POST", "/v1/supervision",
+                 "{\"operation\":\"redeem\",\"params\":{\"pairing_code\":\"" +
+                     pairing.pairing_code +
+                     "\",\"client_label\":\"Production dashboard\"}}");
+  ASSERT_EQ(200, redeemed.status);
+  auto redeemed_json =
+      base::JSONReader::ReadDict(redeemed.body, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(redeemed_json.has_value()) << redeemed.body;
+  ASSERT_EQ(true, redeemed_json->FindBool("ok"));
+  const base::DictValue* redeemed_result = redeemed_json->FindDict("result");
+  ASSERT_TRUE(redeemed_result);
+  const std::string* dashboard_session =
+      redeemed_result->FindString("dashboard_session");
+  ASSERT_TRUE(dashboard_session);
+
+  HttpResult baseline = Authorized(
+      "POST", "/v1/supervision",
+      "{\"operation\":\"baseline\",\"params\":{\"dashboard_session\":\"" +
+          *dashboard_session + "\"}}");
+  ASSERT_EQ(200, baseline.status);
+  auto baseline_json =
+      base::JSONReader::ReadDict(baseline.body, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(baseline_json.has_value()) << baseline.body;
+  ASSERT_EQ(true, baseline_json->FindBool("ok"));
+  const base::DictValue* baseline_result = baseline_json->FindDict("result");
+  ASSERT_TRUE(baseline_result);
+  const std::string* document_epoch =
+      baseline_result->FindString("document_epoch");
+  std::optional<double> sequence = baseline_result->FindDouble("sequence");
+  ASSERT_TRUE(document_epoch);
+  ASSERT_TRUE(sequence.has_value());
+
+  HttpResult acked = Authorized(
+      "POST", "/v1/supervision",
+      "{\"operation\":\"ack\",\"params\":{\"dashboard_session\":\"" +
+          *dashboard_session + "\",\"document_epoch\":\"" + *document_epoch +
+          "\",\"sequence\":" + base::NumberToString(*sequence) + "}}");
+  ASSERT_EQ(200, acked.status);
+  EXPECT_NE(std::string::npos, acked.body.find("\"ok\":true"));
+
+  HttpResult agent_started =
+      Authorized("POST", "/v1/agent/command",
+                 "{\"route\":\"start_supervision_session\",\"session_id\":\"" +
+                     agent_session + "\"}");
+  ASSERT_EQ(200, agent_started.status);
+  EXPECT_NE(std::string::npos,
+            agent_started.body.find("\"kind\":\"baseline\""));
+  EXPECT_EQ(std::string::npos, agent_started.body.find("dashboard_session"));
+  EXPECT_EQ(2u, service->capture_consumer_count_for_testing(stable_tab_id));
+  PrometheusSupervisionCaptureHub* const hub =
+      service->capture_hub_for_testing(stable_tab_id);
+  ASSERT_TRUE(hub);
+  EXPECT_EQ(1u, hub->enable_count_for_testing());
+  EXPECT_EQ(1u, hub->capture_count_for_testing());
+
+  const std::string pending_diff_body =
+      "{\"operation\":\"diff\",\"params\":{\"dashboard_session\":\"" +
+      *dashboard_session + "\",\"document_epoch\":\"" + *document_epoch +
+      "\",\"after_sequence\":" + base::NumberToString(*sequence) + "}}";
+  RawHttpClient pending_dashboard(gateway_->endpoint_for_testing());
+  pending_dashboard.Send(
+      MakeRequest("POST", "/v1/supervision", gateway_->port_for_testing(),
+                  gateway_->bearer_for_testing(), pending_diff_body));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return gateway_->pending_supervision_request_count_for_testing() == 1u;
+  }));
+
+  gateway_->SetSupervisionGatewayDispatcher({});
+  EXPECT_EQ(1u, service->capture_consumer_count_for_testing(stable_tab_id));
+  production_parts_->UnbindSupervisionAgentForTesting();
+  HttpResult cancelled = pending_dashboard.ReadResponse();
+  EXPECT_EQ(200, cancelled.status);
+  EXPECT_NE(std::string::npos, cancelled.body.find("UNAVAILABLE"));
+  EXPECT_EQ(cancelled.raw.find("HTTP/1.1"), cancelled.raw.rfind("HTTP/1.1"));
+  EXPECT_EQ(0u, gateway_->pending_supervision_request_count_for_testing());
+
+  HttpResult dashboard_unavailable = Authorized(
+      "POST", "/v1/supervision",
+      "{\"operation\":\"baseline\",\"params\":{\"dashboard_session\":\"" +
+          *dashboard_session + "\"}}");
+  EXPECT_EQ(200, dashboard_unavailable.status);
+  EXPECT_NE(std::string::npos, dashboard_unavailable.body.find("UNAVAILABLE"));
+  HttpResult agent_unavailable =
+      Authorized("POST", "/v1/agent/command",
+                 "{\"route\":\"get_supervision_diff\",\"session_id\":\"" +
+                     agent_session + "\"}");
+  EXPECT_EQ(200, agent_unavailable.status);
+  EXPECT_NE(std::string::npos,
+            agent_unavailable.body.find("CAPABILITY_NOT_READY"));
+
+  ASSERT_EQ(200, Authorized("POST", "/v1/session/close",
+                            "{\"session_id\":\"" + agent_session + "\"}")
+                     .status);
+  EXPECT_EQ(0u, service->capture_hub_count_for_testing());
+}
