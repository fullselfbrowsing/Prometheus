+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>Prometheus Side Panel</title>
+    <link rel="stylesheet" href="prometheus_webui.css">
+    <script type="module" src="prometheus_webui.js"></script>
+  </head>
+  <body>
+    <main class="surface surface--narrow" data-prometheus-surface="side-panel">
+      <header class="brand">
+        <img class="brand__mark" src="images/pm_mark_dark.png" alt="">
+        <div>
+          <div class="brand__name">Prometheus</div>
+          <div class="brand__meta">Powered by FSB</div>
+        </div>
