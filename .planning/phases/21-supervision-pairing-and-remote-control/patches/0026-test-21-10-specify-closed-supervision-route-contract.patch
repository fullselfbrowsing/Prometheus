+TEST(PrometheusAgentTransportCodecTest,
+     SupervisionBaselineSerializesDeterministicSafeApcNodes) {
+  AgentSupervisionNode root = SafeNode("node-1");
+  root.child_refs = {"node-2"};
+  AgentSupervisionNode child = SafeNode("node-2", "node-1");
+  child.input_value = "public choice";
+  child.input_type = "text";
+  child.checked = false;
+
+  AgentRouteResult result = AgentRouteResult::SupervisionSuccess(
+      AgentRouteName::kGetSupervisionSnapshot,
+      AgentSupervisionBaselineResult{.nodes = {root, child}});
+  auto serialized = SerializeAgentTransportResult(result);
+  ASSERT_TRUE(serialized.has_value()) << serialized.error().message;
+  ExpectNoAuthorityOrSecretFields(*serialized);
+
+  auto parsed = base::JSONReader::ReadDict(*serialized, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(parsed.has_value());
+  const base::DictValue* supervision = SupervisionValue(*parsed);
+  ASSERT_TRUE(supervision);
+  EXPECT_EQ("baseline", *supervision->FindString("kind"));
+  const base::ListValue* nodes = supervision->FindList("nodes");
+  ASSERT_TRUE(nodes);
+  ASSERT_EQ(2u, nodes->size());
+  EXPECT_EQ("node-1", *(*nodes)[0].GetDict().FindString("ref"));
+  EXPECT_EQ("node-2", *(*nodes)[1].GetDict().FindString("ref"));
+  EXPECT_EQ("public choice",
+            *(*nodes)[1].GetDict().FindDict("fields")->FindString(
+                "input_value"));
+
+  auto repeated = SerializeAgentTransportResult(result);
+  ASSERT_TRUE(repeated.has_value());
+  EXPECT_EQ(*serialized, *repeated);
+}
+
+TEST(PrometheusAgentTransportCodecTest,
+     SupervisionDiffAndActualNoChangeHaveDistinctClosedShapes) {
+  AgentSupervisionDiffOperation insert;
+  insert.type = AgentSupervisionDiffOperationType::kInsertSubtree;
+  insert.ref = "node-2";
+  insert.parent_ref = "node-1";
+  insert.index = 0;
+  insert.subtree = {SafeNode("node-2", "node-1")};
+
+  AgentSupervisionDiffOperation replace;
+  replace.type = AgentSupervisionDiffOperationType::kReplaceFields;
+  replace.ref = "node-1";
+  replace.replacement = SafeNode("node-1");
+  replace.replacement->name = "Continue now";
+
+  AgentSupervisionDiffOperation reorder;
+  reorder.type = AgentSupervisionDiffOperationType::kReorderChildren;
+  reorder.ref = "node-1";
+  reorder.child_order = {"node-2"};
+
+  AgentSupervisionDiffOperation remove;
+  remove.type = AgentSupervisionDiffOperationType::kRemove;
+  remove.ref = "node-3";
+
+  auto diff = SerializeRoot(AgentRouteResult::SupervisionSuccess(
+      AgentRouteName::kGetSupervisionDiff,
+      AgentSupervisionDiffResult{
+          .operations = {insert, replace, reorder, remove}}));
+  ASSERT_TRUE(diff.has_value()) << diff.error().message;
+  const base::DictValue* diff_payload = SupervisionValue(*diff);
+  ASSERT_TRUE(diff_payload);
+  EXPECT_EQ("diff", *diff_payload->FindString("kind"));
+  const base::ListValue* operations = diff_payload->FindList("operations");
+  ASSERT_TRUE(operations);
+  ASSERT_EQ(4u, operations->size());
+  EXPECT_EQ("insert_subtree",
+            *(*operations)[0].GetDict().FindString("op"));
+  EXPECT_EQ("replace_fields",
+            *(*operations)[1].GetDict().FindString("op"));
+  EXPECT_EQ("reorder_children",
+            *(*operations)[2].GetDict().FindString("op"));
+  EXPECT_EQ("remove", *(*operations)[3].GetDict().FindString("op"));
+
+  auto no_change = SerializeRoot(AgentRouteResult::SupervisionSuccess(
+      AgentRouteName::kGetSupervisionDiff,
+      AgentSupervisionNoChangeResult()));
+  ASSERT_TRUE(no_change.has_value()) << no_change.error().message;
+  const base::DictValue* no_change_payload = SupervisionValue(*no_change);
+  ASSERT_TRUE(no_change_payload);
+  EXPECT_EQ(1u, no_change_payload->size());
+  EXPECT_EQ("no_change", *no_change_payload->FindString("kind"));
+}
