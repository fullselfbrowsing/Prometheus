+#include "chrome/browser/prometheus/prometheus_supervision_test_bootstrap.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/prometheus/prometheus_runtime_test_bootstrap.h"
+
+namespace prometheus {
+
+PrometheusSupervisionTestBootstrap::PrometheusSupervisionTestBootstrap() =
+    default;
+
+PrometheusSupervisionTestBootstrap::~PrometheusSupervisionTestBootstrap() {
+  Shutdown();
+}
+
+PrometheusSupervisionTestBootstrapResult
+PrometheusSupervisionTestBootstrap::Create(
+    const base::CommandLine& command_line,
+    bool is_official_build,
+    PrometheusSupervisionTestBootstrapProfileFacts profile_facts,
+    const PrometheusSupervisionTestBootstrapFileAccess& file_access,
+    BindingCallback binding,
+    CreatePairingCodeCallback create_pairing_code,
+    NowCallback now,
+    ZeroizationCallback zeroization,
+    std::unique_ptr<PrometheusSupervisionTestBootstrap>* bootstrap) {
+  static_cast<void>(command_line);
+  static_cast<void>(is_official_build);
+  static_cast<void>(profile_facts);
+  static_cast<void>(file_access);
+  static_cast<void>(binding);
+  static_cast<void>(create_pairing_code);
+  static_cast<void>(now);
+  static_cast<void>(zeroization);
+  if (bootstrap) {
+    bootstrap->reset();
+  }
+  return PrometheusSupervisionTestBootstrapResult::kNotRequested;
+}
+
+SupervisionTestHandoffDispatcher
+PrometheusSupervisionTestBootstrap::CreateGatewayDispatcher() {
+  return {};
+}
+
+bool PrometheusSupervisionTestBootstrap::ObservePairingRedeemed(int sequence) {
+  static_cast<void>(sequence);
+  return false;
+}
+
+std::optional<PrometheusSupervisionTestDialogResponse>
+PrometheusSupervisionTestBootstrap::ConsumeDialogResponse(
+    PrometheusSupervisionTestDialog dialog) {
+  static_cast<void>(dialog);
+  return std::nullopt;
+}
+
+void PrometheusSupervisionTestBootstrap::Shutdown() {
+  terminal_ = true;
+  weak_ptr_factory_.InvalidateWeakPtrs();
+}
+
+void PrometheusSupervisionTestBootstrap::Dispatch(
+    SupervisionTestHandoffRequest request,
+    SupervisionTestHandoffDispatcher::ResultCallback callback) {
+  static_cast<void>(request);
+  std::move(callback).Run(SupervisionTestHandoffResult::Failure(
+      SupervisionTestHandoffStatus::kNotReady));
+}
+
+void PrometheusSupervisionTestBootstrap::ClearTerminalState(
+    SupervisionTestHandoffStatus status) {
+  static_cast<void>(status);
+  Shutdown();
+}
+
+PrometheusSupervisionTestBootstrapFileAccess
+CreatePrometheusSupervisionTestBootstrapFileAccess() {
+  return {};
+}
+
+}  // namespace prometheus
