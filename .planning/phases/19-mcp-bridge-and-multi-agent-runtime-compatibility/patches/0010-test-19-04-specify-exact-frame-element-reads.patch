+  ASSERT_TRUE(content::NavigateIframeToURL(cross_origin_tab->GetContents(),
+                                           "prometheus-child-frame",
+                                           cross_origin_url));
+  content::RenderFrameHost* cross_origin = content::ChildFrameAt(
+      cross_origin_tab->GetContents()->GetPrimaryMainFrame(), 0);
+  ASSERT_TRUE(cross_origin);
+  AgentRouteResult cross_origin_result = Execute(ElementReadRequest(
