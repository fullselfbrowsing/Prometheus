+TEST(PrometheusAgentGatewayTest,
+     OneShotCompletionAllowsExactlyOneTerminalOutcome) {
+  int callback_count = 0;
+  PrometheusAgentOneShotCompletion completion(
+      base::BindOnce([](int* count) { ++*count; }, &callback_count));
+  EXPECT_TRUE(completion.TryComplete());
+  EXPECT_FALSE(completion.TryComplete());
+  EXPECT_EQ(1, callback_count);
+}
