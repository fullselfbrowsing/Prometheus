+
+namespace prometheus {
+namespace {
+
+constexpr int kRequiredFilePermissions = 0600;
+constexpr std::array<std::string_view, 4> kSchemaKeys = {
+    "schema_version", "fixture_path", "fixture_sha256", "result_path"};
+constexpr char kManifestFileName[] = "manifest.json";
+
+enum class ObjectScanResult {
+  kValid,
+  kMalformed,
+  kDuplicateKey,
+};
+
+void SkipWhitespace(std::string_view input, size_t* position) {
+  while (*position < input.size() &&
+         std::isspace(static_cast<unsigned char>(input[*position]))) {
+    ++*position;
+  }
+}
+
+bool SkipJsonString(std::string_view input, size_t* position) {
+  if (*position >= input.size() || input[*position] != '"') {
+    return false;
+  }
+  ++*position;
+  bool escaped = false;
+  while (*position < input.size()) {
+    const char current = input[(*position)++];
+    if (escaped) {
+      escaped = false;
+      continue;
+    }
+    if (current == '\\') {
+      escaped = true;
+      continue;
+    }
+    if (current == '"') {
+      return true;
+    }
+    if (static_cast<unsigned char>(current) < 0x20) {
+      return false;
+    }
+  }
+  return false;
+}
+
+bool SkipJsonValue(std::string_view input, size_t* position, size_t depth) {
+  if (depth > 8u || *position >= input.size()) {
+    return false;
+  }
+  if (input[*position] == '"') {
+    return SkipJsonString(input, position);
+  }
+  if (input[*position] == '{') {
+    ++*position;
+    SkipWhitespace(input, position);
+    if (*position < input.size() && input[*position] == '}') {
+      ++*position;
+      return true;
+    }
+    while (*position < input.size()) {
+      if (!SkipJsonString(input, position)) {
+        return false;
+      }
+      SkipWhitespace(input, position);
+      if (*position >= input.size() || input[(*position)++] != ':') {
+        return false;
+      }
+      SkipWhitespace(input, position);
+      if (!SkipJsonValue(input, position, depth + 1)) {
+        return false;
+      }
+      SkipWhitespace(input, position);
+      if (*position >= input.size()) {
+        return false;
+      }
+      if (input[*position] == '}') {
+        ++*position;
+        return true;
+      }
+      if (input[(*position)++] != ',') {
+        return false;
+      }
+      SkipWhitespace(input, position);
+    }
+    return false;
+  }
+
+  const size_t value_start = *position;
+  while (*position < input.size() && input[*position] != ',' &&
+         input[*position] != '}' && input[*position] != ']' &&
+         !std::isspace(static_cast<unsigned char>(input[*position]))) {
+    ++*position;
+  }
+  return *position > value_start;
+}
+
+ObjectScanResult ScanObjectKeys(std::string_view input) {
+  size_t position = 0;
+  SkipWhitespace(input, &position);
+  if (position >= input.size() || input[position++] != '{') {
+    return ObjectScanResult::kMalformed;
+  }
+  std::set<std::string> keys;
+  SkipWhitespace(input, &position);
+  if (position < input.size() && input[position] == '}') {
+    ++position;
+    SkipWhitespace(input, &position);
+    return position == input.size() ? ObjectScanResult::kValid
+                                    : ObjectScanResult::kMalformed;
+  }
+
+  while (position < input.size()) {
+    if (input[position] != '"') {
+      return ObjectScanResult::kMalformed;
+    }
+    const size_t key_start = ++position;
+    while (position < input.size() && input[position] != '"') {
+      if (input[position] == '\\' ||
+          static_cast<unsigned char>(input[position]) < 0x20) {
+        return ObjectScanResult::kMalformed;
+      }
+      ++position;
+    }
+    if (position >= input.size()) {
+      return ObjectScanResult::kMalformed;
+    }
+    if (!keys.insert(std::string(input.substr(key_start, position - key_start)))
+             .second) {
+      return ObjectScanResult::kDuplicateKey;
+    }
+    ++position;
+    SkipWhitespace(input, &position);
+    if (position >= input.size() || input[position++] != ':') {
+      return ObjectScanResult::kMalformed;
+    }
+    SkipWhitespace(input, &position);
+    if (!SkipJsonValue(input, &position, 0)) {
+      return ObjectScanResult::kMalformed;
+    }
+    SkipWhitespace(input, &position);
+    if (position >= input.size()) {
+      return ObjectScanResult::kMalformed;
+    }
+    if (input[position] == '}') {
+      ++position;
+      SkipWhitespace(input, &position);
+      return position == input.size() ? ObjectScanResult::kValid
+                                      : ObjectScanResult::kMalformed;
+    }
+    if (input[position++] != ',') {
+      return ObjectScanResult::kMalformed;
+    }
+    SkipWhitespace(input, &position);
+  }
+  return ObjectScanResult::kMalformed;
+}
+
+bool HasExactSchemaKeys(const base::DictValue& value) {
+  return value.size() == kSchemaKeys.size() &&
+         std::ranges::all_of(kSchemaKeys, [&value](std::string_view key) {
+           return value.contains(key);
+         });
+}
+
+bool IsLowerHexSha256(std::string_view value) {
+  return value.size() == kPrometheusExtensionSmokeSha256HexLength &&
+         std::ranges::all_of(value, [](char character) {
+           return base::IsAsciiDigit(character) ||
+                  (character >= 'a' && character <= 'f');
+         });
+}
+
+std::optional<base::FilePath> ResolveAbsoluteNoSymlinkPath(
+    const base::FilePath& requested) {
+  if (requested.empty() || !requested.IsAbsolute() ||
+      requested.ReferencesParent()) {
+    return std::nullopt;
+  }
+#if BUILDFLAG(IS_POSIX)
+  return base::MakeAbsoluteFilePathNoResolveSymbolicLinks(requested);
+#else
+  return std::nullopt;
+#endif
+}
+
+std::optional<PrometheusExtensionSmokeBootstrapFileFacts> InspectPath(
+    const base::FilePath& path) {
+#if BUILDFLAG(IS_POSIX)
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  base::stat_wrapper_t information;
+  if (base::File::Lstat(path, &information) != 0) {
+    return std::nullopt;
+  }
+  return PrometheusExtensionSmokeBootstrapFileFacts{
+      .is_regular_file = S_ISREG(information.st_mode),
+      .is_directory = S_ISDIR(information.st_mode),
+      .is_symbolic_link = S_ISLNK(information.st_mode),
+      .is_owned_by_current_user = information.st_uid == geteuid(),
+      .posix_permissions = information.st_mode & 0777,
+      .size = information.st_size,
+  };
+#else
+  return std::nullopt;
+#endif
+}
+
+std::optional<std::string> ReadStrictConfigFile(const base::FilePath& path,
+                                                 size_t max_bytes) {
+#if BUILDFLAG(IS_POSIX)
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ |
+                            base::File::FLAG_NO_FOLLOW);
+  if (!file.IsValid()) {
+    return std::nullopt;
+  }
+  base::stat_wrapper_t information;
+  if (base::File::Fstat(file.GetPlatformFile(), &information) != 0 ||
+      !S_ISREG(information.st_mode) || information.st_uid != geteuid() ||
+      (information.st_mode & 0777) != kRequiredFilePermissions ||
+      information.st_size <= 0 ||
+      static_cast<uint64_t>(information.st_size) > max_bytes) {
+    return std::nullopt;
+  }
+  std::string contents(static_cast<size_t>(information.st_size), '\0');
+  if (!file.ReadAndCheck(0, base::as_writable_byte_span(contents))) {
+    return std::nullopt;
+  }
+  return contents;
+#else
+  return std::nullopt;
+#endif
+}
+
+std::optional<std::string> ReadFixtureFile(const base::FilePath& path,
+                                            size_t max_bytes) {
+#if BUILDFLAG(IS_POSIX)
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ |
+                            base::File::FLAG_NO_FOLLOW);
+  if (!file.IsValid()) {
+    return std::nullopt;
+  }
+  base::stat_wrapper_t information;
+  if (base::File::Fstat(file.GetPlatformFile(), &information) != 0 ||
+      !S_ISREG(information.st_mode) || information.st_size <= 0 ||
+      static_cast<uint64_t>(information.st_size) > max_bytes) {
+    return std::nullopt;
+  }
+  std::string contents(static_cast<size_t>(information.st_size), '\0');
+  if (!file.ReadAndCheck(0, base::as_writable_byte_span(contents))) {
+    return std::nullopt;
+  }
+  return contents;
+#else
+  return std::nullopt;
+#endif
+}
+
+}  // namespace
+
+PrometheusExtensionSmokeBootstrap::PrometheusExtensionSmokeBootstrap() =
+    default;
+PrometheusExtensionSmokeBootstrap::~PrometheusExtensionSmokeBootstrap() =
+    default;
+
+PrometheusExtensionSmokeBootstrapResult PrometheusExtensionSmokeBootstrap::Create(
+    const base::CommandLine& command_line,
+    bool is_official_build,
+    PrometheusExtensionSmokeBootstrapProfileFacts profile_facts,
+    const PrometheusExtensionSmokeBootstrapFileAccess& file_access,
+    const PrometheusExtensionSmokeFixtureAccess& fixture_access,
+    std::unique_ptr<PrometheusExtensionSmokeBootstrap>* bootstrap) {
+  if (bootstrap) {
+    bootstrap->reset();
+  }
+  const bool has_test_type =
+      command_line.HasSwitch(kPrometheusRuntimeTestTypeSwitch);
+  const bool has_config =
+      command_line.HasSwitch(kPrometheusExtensionSmokeBootstrapSwitch);
+  if (!has_test_type && !has_config) {
+    return PrometheusExtensionSmokeBootstrapResult::kNotRequested;
+  }
+  if (!has_test_type || !has_config ||
+      command_line.GetSwitchValueASCII(kPrometheusRuntimeTestTypeSwitch) !=
+          kPrometheusRuntimeTestType) {
+    return PrometheusExtensionSmokeBootstrapResult::kLaunchDenied;
+  }
+#if defined(OFFICIAL_BUILD)
+  return PrometheusExtensionSmokeBootstrapResult::kOfficialBuildDenied;
+#endif
+  if (is_official_build) {
+    return PrometheusExtensionSmokeBootstrapResult::kOfficialBuildDenied;
+  }
+  if (!profile_facts.is_regular_profile ||
+      !profile_facts.is_disposable_profile ||
+      profile_facts.is_off_the_record) {
+    return PrometheusExtensionSmokeBootstrapResult::kProfileDenied;
+  }
+  if (!bootstrap || !file_access.inspect || !file_access.read ||
+      !fixture_access.inspect || !fixture_access.read) {
+    return PrometheusExtensionSmokeBootstrapResult::kFileDenied;
+  }
+
+  const std::optional<base::FilePath> config_path =
+      ResolveAbsoluteNoSymlinkPath(command_line.GetSwitchValuePath(
+          kPrometheusExtensionSmokeBootstrapSwitch));
+  if (!config_path) {
+    return PrometheusExtensionSmokeBootstrapResult::kPathDenied;
+  }
+
+  const std::optional<PrometheusExtensionSmokeBootstrapFileFacts> config_facts =
+      file_access.inspect.Run(*config_path);
+  if (!config_facts || !config_facts->is_regular_file ||
+      config_facts->is_symbolic_link ||
+      !config_facts->is_owned_by_current_user ||
+      config_facts->posix_permissions != kRequiredFilePermissions ||
+      config_facts->size <= 0 ||
+      static_cast<uint64_t>(config_facts->size) >
+          kMaxPrometheusExtensionSmokeBootstrapBytes) {
+    return PrometheusExtensionSmokeBootstrapResult::kFileDenied;
+  }
+
+  const std::optional<std::string> contents = file_access.read.Run(
+      *config_path, kMaxPrometheusExtensionSmokeBootstrapBytes);
+  if (!contents || contents->size() != static_cast<size_t>(config_facts->size)) {
+    return PrometheusExtensionSmokeBootstrapResult::kReadDenied;
+  }
+  if (!base::IsStringUTF8(*contents)) {
+    return PrometheusExtensionSmokeBootstrapResult::kJsonDenied;
+  }
+  const ObjectScanResult scan = ScanObjectKeys(*contents);
+  if (scan == ObjectScanResult::kDuplicateKey) {
+    return PrometheusExtensionSmokeBootstrapResult::kSchemaDenied;
+  }
+  if (scan != ObjectScanResult::kValid) {
+    return PrometheusExtensionSmokeBootstrapResult::kJsonDenied;
+  }
+
+  std::optional<base::DictValue> parsed =
+      base::JSONReader::ReadDict(*contents, base::JSON_PARSE_RFC, 4);
+  if (!parsed) {
+    return PrometheusExtensionSmokeBootstrapResult::kJsonDenied;
+  }
+  if (!HasExactSchemaKeys(*parsed)) {
+    return PrometheusExtensionSmokeBootstrapResult::kSchemaDenied;
+  }
+  const std::optional<int> schema_version = parsed->FindInt("schema_version");
+  const std::string* fixture_path_string = parsed->FindString("fixture_path");
+  const std::string* fixture_sha256 = parsed->FindString("fixture_sha256");
+  const std::string* result_path_string = parsed->FindString("result_path");
+  if (schema_version != 1 || !fixture_path_string ||
+      fixture_path_string->empty() || !fixture_sha256 ||
+      !IsLowerHexSha256(*fixture_sha256) || !result_path_string ||
+      result_path_string->empty()) {
+    return PrometheusExtensionSmokeBootstrapResult::kSchemaDenied;
+  }
+
+  const std::optional<base::FilePath> fixture_path = ResolveAbsoluteNoSymlinkPath(
+      base::FilePath::FromUTF8Unsafe(*fixture_path_string));
+  if (!fixture_path) {
+    return PrometheusExtensionSmokeBootstrapResult::kPathDenied;
+  }
+  const std::optional<PrometheusExtensionSmokeBootstrapFileFacts>
+      fixture_dir_facts = fixture_access.inspect.Run(*fixture_path);
+  if (!fixture_dir_facts || !fixture_dir_facts->is_directory ||
+      fixture_dir_facts->is_symbolic_link) {
+    return PrometheusExtensionSmokeBootstrapResult::kFixtureDenied;
+  }
+  const base::FilePath manifest_path =
+      fixture_path->AppendASCII(kManifestFileName);
+  const std::optional<PrometheusExtensionSmokeBootstrapFileFacts>
+      manifest_facts = fixture_access.inspect.Run(manifest_path);
+  if (!manifest_facts || !manifest_facts->is_regular_file ||
+      manifest_facts->is_symbolic_link || manifest_facts->size <= 0 ||
+      static_cast<uint64_t>(manifest_facts->size) >
+          kMaxPrometheusExtensionSmokeFixtureManifestBytes) {
+    return PrometheusExtensionSmokeBootstrapResult::kFixtureDenied;
+  }
+  const std::optional<std::string> manifest_contents = fixture_access.read.Run(
+      manifest_path, kMaxPrometheusExtensionSmokeFixtureManifestBytes);
+  if (!manifest_contents ||
+      manifest_contents->size() != static_cast<size_t>(manifest_facts->size)) {
+    return PrometheusExtensionSmokeBootstrapResult::kFixtureDenied;
+  }
+  const std::string computed_hash =
+      base::HexEncodeLower(crypto::hash::Sha256(*manifest_contents));
+  if (computed_hash != base::ToLowerASCII(*fixture_sha256)) {
+    return PrometheusExtensionSmokeBootstrapResult::kFixtureDenied;
+  }
+
+  const std::optional<base::FilePath> result_path = ResolveAbsoluteNoSymlinkPath(
+      base::FilePath::FromUTF8Unsafe(*result_path_string));
+  if (!result_path) {
+    return PrometheusExtensionSmokeBootstrapResult::kResultPathDenied;
+  }
+  const std::optional<PrometheusExtensionSmokeBootstrapFileFacts>
+      existing_result_facts = file_access.inspect.Run(*result_path);
+  if (existing_result_facts && existing_result_facts->is_symbolic_link) {
+    return PrometheusExtensionSmokeBootstrapResult::kResultPathDenied;
+  }
+  const std::optional<PrometheusExtensionSmokeBootstrapFileFacts> parent_facts =
+      file_access.inspect.Run(result_path->DirName());
+  if (!parent_facts || !parent_facts->is_directory ||
+      parent_facts->is_symbolic_link) {
+    return PrometheusExtensionSmokeBootstrapResult::kResultPathDenied;
+  }
+
+  auto state = std::unique_ptr<PrometheusExtensionSmokeBootstrap>(
+      new PrometheusExtensionSmokeBootstrap());
+  state->fixture_path_ = *fixture_path;
+  state->fixture_sha256_ = base::ToLowerASCII(*fixture_sha256);
+  state->result_path_ = *result_path;
+  *bootstrap = std::move(state);
+  return PrometheusExtensionSmokeBootstrapResult::kApplied;
+}
+
+PrometheusExtensionSmokeBootstrapFileAccess
+CreatePrometheusExtensionSmokeBootstrapFileAccess() {
+  return {
+      .inspect = base::BindRepeating(&InspectPath),
+      .read = base::BindRepeating(&ReadStrictConfigFile),
+  };
+}
+
+PrometheusExtensionSmokeFixtureAccess
+CreatePrometheusExtensionSmokeFixtureAccess() {
+  return {
+      .inspect = base::BindRepeating(&InspectPath),
+      .read = base::BindRepeating(&ReadFixtureFile),
+  };
+}
+
+}  // namespace prometheus
