 namespace prometheus {
 
+namespace {
+
+constexpr std::string_view kPairingAlphabet =
+    "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
+constexpr size_t kPairingSaltBytes = 32;
+constexpr std::string_view kUnavailableOrigin = "https://unavailable.invalid";
+
+std::string NormalizePairingCode(std::string_view input) {
+  std::string normalized;
+  normalized.reserve(input.size());
+  for (char character : input) {
+    if (character == '-' || base::IsAsciiWhitespace(character)) {
+      continue;
+    }
+    normalized.push_back(base::ToUpperASCII(character));
+  }
+  return normalized;
+}
+
+std::string PairingDigest(std::string_view salt, std::string_view code) {
+  std::string material;
+  material.reserve(salt.size() + code.size());
+  material.append(salt);
+  material.append(code);
+  return crypto::SHA256HashString(material);
+}
+
+bool DigestsEqual(std::string_view left, std::string_view right) {
+  return crypto::SecureMemEqual(base::as_byte_span(left),
+                                base::as_byte_span(right));
+}
+
+base::TimeDelta PairingTtl(const SupervisionLimits& limits) {
+  return base::Milliseconds(limits.pairing_code_ttl_ms);
+}
+
+base::TimeDelta ViewerTtl(const SupervisionLimits& limits) {
+  return base::Milliseconds(limits.viewer_ttl_ms);
+}
+
+bool IsEligibleTarget(Profile* profile,
+                      BrowserWindowInterface* browser,
+                      tabs::TabInterface* tab) {
+  return profile && browser && tab && !browser->IsDeleteScheduled() &&
+         browser->GetProfile() == profile && tab->GetProfile() == profile &&
+         tab->GetBrowserWindowInterface() == browser &&
+         tab->GetHandle().raw_value() != tabs::TabHandle::NullValue &&
+         tab->GetURL().is_valid() && tab->GetURL().SchemeIsHTTPOrHTTPS();
+}
+
+std::string SafeTitle(tabs::TabInterface* tab) {
+  return tab ? DeriveSupervisionSafeTargetTitle(
+                   base::UTF16ToUTF8(tab->GetTitle()))
+             : std::string(kSupervisionTargetTitleFallback);
+}
+
+std::string SafeOrigin(tabs::TabInterface* tab) {
+  if (!tab) {
+    return std::string(kUnavailableOrigin);
+  }
+  return CanonicalizeSupervisionSafeOrigin(tab->GetURL().spec())
+      .value_or(std::string(kUnavailableOrigin));
+}
+
+SupervisionServiceResult ServiceFailure(SupervisionErrorCode error_code,
+                                        std::string message,
+                                        std::string recovery) {
+  return SupervisionServiceResult::Failure(error_code, std::move(message),
+                                           std::move(recovery));
+}
+
+}  // namespace
