+TEST(PrometheusAgentTransportCodecTest,
+     SupervisionResultUnionHasOnlyFiveSafeSuccessVariants) {
+  static_assert(std::variant_size_v<AgentSupervisionPayload> == 5u);
+  static_assert(std::is_same_v<
+                std::variant_alternative_t<0, AgentSupervisionPayload>,
+                AgentSupervisionLocalUiResult>);
+  static_assert(std::is_same_v<
+                std::variant_alternative_t<1, AgentSupervisionPayload>,
+                AgentSupervisionBaselineResult>);
+  static_assert(std::is_same_v<
+                std::variant_alternative_t<2, AgentSupervisionPayload>,
+                AgentSupervisionDiffResult>);
+  static_assert(std::is_same_v<
+                std::variant_alternative_t<3, AgentSupervisionPayload>,
+                AgentSupervisionNoChangeResult>);
+  static_assert(std::is_same_v<
+                std::variant_alternative_t<4, AgentSupervisionPayload>,
+                AgentSupervisionEndedResult>);
+
+  AgentRouteResult result = AgentRouteResult::SupervisionSuccess(
+      AgentRouteName::kCreateSupervisionPairing,
+      AgentSupervisionLocalUiResult());
+  ASSERT_TRUE(result.supervision_result.has_value());
+  EXPECT_EQ(AgentRouteName::kCreateSupervisionPairing,
+            result.supervision_result->route_name);
+  EXPECT_EQ(0u, result.supervision_result->payload.index());
+  EXPECT_TRUE(result.ok);
+  EXPECT_EQ(AgentErrorCode::kNone, result.error_code);
+}
+
+TEST(PrometheusAgentTransportCodecTest,
+     SupervisionLocalUiAndEndedUseFixedMinimalShapes) {
+  auto local = SerializeRoot(AgentRouteResult::SupervisionSuccess(
+      AgentRouteName::kCreateSupervisionPairing,
+      AgentSupervisionLocalUiResult()));
+  ASSERT_TRUE(local.has_value()) << local.error().message;
+  EXPECT_EQ(5u, local->size());
+  const base::DictValue* local_payload = SupervisionValue(*local);
+  ASSERT_TRUE(local_payload);
+  EXPECT_EQ(2u, local_payload->size());
+  EXPECT_EQ("local_ui", *local_payload->FindString("kind"));
+  EXPECT_EQ("control_panel", *local_payload->FindString("surface"));
+
+  auto ended = SerializeRoot(AgentRouteResult::SupervisionSuccess(
+      AgentRouteName::kEndSupervisionSession,
+      AgentSupervisionEndedResult()));
+  ASSERT_TRUE(ended.has_value()) << ended.error().message;
+  EXPECT_EQ(5u, ended->size());
+  const base::DictValue* ended_payload = SupervisionValue(*ended);
+  ASSERT_TRUE(ended_payload);
+  EXPECT_EQ(1u, ended_payload->size());
+  EXPECT_EQ("ended", *ended_payload->FindString("kind"));
+}
