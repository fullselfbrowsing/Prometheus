+SupervisionDashboardDiffResult
+PrometheusSupervisionProfileService::ReadDashboardDiff(
+    const base::UnguessableToken& dashboard_session) {
+  SupervisionDashboardDiffResult result;
+  if (shutdown_) {
+    static_cast<SupervisionServiceResult&>(result) = UnavailableResult();
+    return result;
+  }
+  SweepExpired();
+  if (!viewers_.contains(dashboard_session)) {
+    static_cast<SupervisionServiceResult&>(result) = UnknownSessionResult();
+    return result;
+  }
+  if (!RevalidateViewerOwner(dashboard_session)) {
+    static_cast<SupervisionServiceResult&>(result) =
+        ServiceFailure(SupervisionErrorCode::kUnknownSession,
+                       "The dashboard session no longer has target authority",
+                       "Create and redeem a new pairing");
+    return result;
+  }
+
+  auto viewer = viewers_.find(dashboard_session);
+  CaptureHubEntry* capture_hub = FindCaptureHub(*viewer->second);
+  if (!capture_hub || !viewer->second->capture_consumer_token.has_value()) {
+    TerminateViewer(dashboard_session, SupervisionViewerState::kTargetClosed,
+                    SupervisionTerminalReason::kTargetClosed,
+                    SupervisionAuditEvent::kTargetClosed,
+                    SupervisionErrorCode::kStaleTarget);
+    static_cast<SupervisionServiceResult&>(result) =
+        ServiceFailure(SupervisionErrorCode::kStaleTarget,
+                       "The dashboard capture target is no longer available",
+                       "Create and redeem a new pairing");
+    return result;
+  }
+
+  const CaptureConsumerToken consumer_token =
+      *viewer->second->capture_consumer_token;
+  if (capture_hub->hub->ConsumerNeedsBaseline(consumer_token)) {
+    viewer->second->stream_state = SupervisionStreamState::kResyncing;
+    static_cast<SupervisionServiceResult&>(result) =
+        ServiceFailure(SupervisionErrorCode::kResyncRequired,
+                       "A fresh dashboard baseline is required",
+                       "Read and acknowledge the current baseline");
+    return result;
+  }
+
+  result.delivery = capture_hub->hub->ReadNext(consumer_token);
+  if (!result.delivery.has_value() &&
+      capture_hub->hub->ConsumerNeedsBaseline(consumer_token)) {
+    viewer->second->stream_state = SupervisionStreamState::kResyncing;
+    static_cast<SupervisionServiceResult&>(result) =
+        ServiceFailure(SupervisionErrorCode::kResyncRequired,
+                       "The dashboard diff cursor is no longer retained",
+                       "Read and acknowledge the current baseline");
+    return result;
+  }
+  viewer->second->last_seen_at = Now();
+  static_cast<SupervisionServiceResult&>(result) =
+      SupervisionServiceResult::Success();
+  return result;
+}
+
+SupervisionServiceResult PrometheusSupervisionProfileService::AckDashboard(
+    const base::UnguessableToken& dashboard_session,
+    const SupervisionStreamStamp& stamp) {
+  if (shutdown_) {
+    return UnavailableResult();
+  }
+  SweepExpired();
+  if (!viewers_.contains(dashboard_session)) {
+    return UnknownSessionResult();
+  }
+  if (!RevalidateViewerOwner(dashboard_session)) {
+    return ServiceFailure(SupervisionErrorCode::kUnknownSession,
+                          "The dashboard session no longer has authority",
+                          "Create and redeem a new pairing");
+  }
+
+  auto viewer = viewers_.find(dashboard_session);
+  CaptureHubEntry* capture_hub = FindCaptureHub(*viewer->second);
+  if (!capture_hub || !viewer->second->capture_consumer_token.has_value()) {
+    return ServiceFailure(SupervisionErrorCode::kStaleTarget,
+                          "The dashboard capture target is unavailable",
+                          "Create and redeem a new pairing");
+  }
+  if (!capture_hub->hub->Ack(*viewer->second->capture_consumer_token, stamp)) {
+    viewer->second->stream_state = SupervisionStreamState::kResyncing;
+    return ServiceFailure(SupervisionErrorCode::kResyncRequired,
+                          "The dashboard acknowledgement is stale",
+                          "Read and acknowledge the current baseline");
+  }
+  viewer->second->last_seen_at = Now();
+  viewer->second->stream_state = SupervisionStreamState::kLive;
+  return SupervisionServiceResult::Success();
+}
