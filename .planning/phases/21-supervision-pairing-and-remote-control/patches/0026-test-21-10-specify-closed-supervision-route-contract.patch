+// Compatibility supervision payloads are deliberately authority-free. The
+// browser-owned service retains session, target, document epoch, sequence,
+// cursor, and controller authority; these DTOs contain only strict safe APC
+// structure for the authenticated caller's internally scoped stream.
+struct AgentSupervisionNode {
+  std::string ref;
+  std::string parent_ref;
+  std::vector<std::string> child_refs;
+  std::string tag;
+  std::string role;
+  std::string name;
+  std::string text_snippet;
+  bool disabled = false;
+  bool focusable = false;
+  bool clickable = false;
+  std::optional<std::string> input_value;
+  std::optional<std::string> input_type;
+  std::optional<bool> checked;
+  bool required = false;
+  bool readonly = false;
+  bool frame_restricted = false;
+  std::string frame_restricted_reason;
+
+  bool operator==(const AgentSupervisionNode&) const = default;
+};
+
+enum class AgentSupervisionDiffOperationType {
+  kInsertSubtree,
+  kRemove,
+  kReplaceFields,
+  kReorderChildren,
+};
+
+struct AgentSupervisionDiffOperation {
+  AgentSupervisionDiffOperationType type =
+      AgentSupervisionDiffOperationType::kReplaceFields;
+  std::string ref;
+  std::string parent_ref;
+  size_t index = 0;
+  std::vector<AgentSupervisionNode> subtree;
+  std::optional<AgentSupervisionNode> replacement;
+  std::vector<std::string> child_order;
+
+  bool operator==(const AgentSupervisionDiffOperation&) const = default;
+};
+
+// Marker payloads intentionally serialize to fixed strings rather than
+// accepting caller- or service-provided free-form metadata.
+struct AgentSupervisionLocalUiResult {
+  bool operator==(const AgentSupervisionLocalUiResult&) const = default;
+};
+struct AgentSupervisionBaselineResult {
+  std::vector<AgentSupervisionNode> nodes;
+
+  bool operator==(const AgentSupervisionBaselineResult&) const = default;
+};
+struct AgentSupervisionDiffResult {
+  std::vector<AgentSupervisionDiffOperation> operations;
+
+  bool operator==(const AgentSupervisionDiffResult&) const = default;
+};
+struct AgentSupervisionNoChangeResult {
+  bool operator==(const AgentSupervisionNoChangeResult&) const = default;
+};
+struct AgentSupervisionEndedResult {
+  bool operator==(const AgentSupervisionEndedResult&) const = default;
+};
+
+using AgentSupervisionPayload =
+    std::variant<AgentSupervisionLocalUiResult,
+                 AgentSupervisionBaselineResult,
+                 AgentSupervisionDiffResult,
+                 AgentSupervisionNoChangeResult,
+                 AgentSupervisionEndedResult>;
+
+static_assert(std::variant_size_v<AgentSupervisionPayload> == 5u);
+
+struct AgentSupervisionTransportResult {
+  AgentRouteName route_name = AgentRouteName::kCreateSupervisionPairing;
+  AgentSupervisionPayload payload = AgentSupervisionLocalUiResult();
+
+  bool operator==(const AgentSupervisionTransportResult&) const = default;
+};
