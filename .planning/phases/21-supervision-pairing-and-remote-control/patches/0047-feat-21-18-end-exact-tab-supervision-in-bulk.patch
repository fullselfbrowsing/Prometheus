@@ -989,6 +992,9 @@ void PrometheusSidePanelUI::HandleInvalidRuntimeMessageForWebUI(
 }
 
 void PrometheusSidePanelUI::SendRuntimeSnapshot(base::DictValue snapshot) {
+  if (!runtime_initialized_) {
+    return;
+  }
   ++runtime_observer_delivery_count_;
   web_ui()->CallJavascriptFunctionUnsafe("prometheusRuntimeReceiveSnapshot",
                                          base::Value(std::move(snapshot)));
diff --git a/chrome/browser/ui/webui/prometheus/prometheus_web_ui.h b/chrome/browser/ui/webui/prometheus/prometheus_web_ui.h
