+IN_PROC_BROWSER_TEST_F(PrometheusTabSupervisionBadgeBrowserTest,
+                       RealTabExactTabIsolation) {
+  AddBackgroundTab();
+  ASSERT_EQ(2, tab_strip()->GetModelCount());
+  Tab* const first_tab = tab_view_at(0);
+  Tab* const second_tab = tab_view_at(1);
+  ASSERT_TRUE(first_tab);
+  ASSERT_TRUE(second_tab);
+
+  std::unique_ptr<prometheus::PrometheusAgentTabData> first_data =
+      prometheus::PrometheusAgentTabData::ForTabForTesting(
+          tab_interface_at(0));
+  std::unique_ptr<prometheus::PrometheusAgentTabData> second_data =
+      prometheus::PrometheusAgentTabData::ForTabForTesting(
+          tab_interface_at(1));
+  ASSERT_TRUE(first_data);
+  ASSERT_TRUE(second_data);
+
+  PrometheusTabState first_state = ViewingState(1);
+  first_state.supervision.control_state = ControlState::kControllerReady;
+  first_state.supervision.controller_label = "Dashboard A";
+  first_data->UpdateSupervisionState(first_state.supervision);
+
+  EXPECT_TRUE(first_tab->prometheus_tab_status_badge_for_testing()
+                  ->GetVisible());
+  EXPECT_FALSE(second_tab->prometheus_tab_status_badge_for_testing()
+                   ->GetVisible());
+  EXPECT_EQ(
+      u"No agent owns this tab; Supervised by 1 trusted client; Remote control enabled for Dashboard A; Tab health OK",
+      first_tab->prometheus_tab_status_badge_for_testing()
+          ->GetViewAccessibility()
+          .GetCachedName());
+
+  second_data->UpdateSupervisionState(ViewingState(2).supervision);
+  EXPECT_EQ(
+      u"No agent owns this tab; Supervised by 2 trusted clients; Tab health OK",
+      second_tab->prometheus_tab_status_badge_for_testing()
+          ->GetViewAccessibility()
+          .GetCachedName());
+  EXPECT_EQ(
+      u"No agent owns this tab; Supervised by 1 trusted client; Remote control enabled for Dashboard A; Tab health OK",
+      first_tab->prometheus_tab_status_badge_for_testing()
+          ->GetViewAccessibility()
+          .GetCachedName());
+
+  first_data.reset();
+  EXPECT_FALSE(first_tab->prometheus_tab_status_badge_for_testing()
+                   ->GetVisible());
+  EXPECT_TRUE(second_tab->prometheus_tab_status_badge_for_testing()
+                  ->GetVisible());
+}
