+using testing::Return;
+using testing::ReturnRef;
+
+SupervisionRemoteActionRequest Action(
+    SupervisionRemoteActionCategory category) {
+  SupervisionRemoteActionRequest action;
+  action.category = category;
+  switch (category) {
+    case SupervisionRemoteActionCategory::kClick:
+    case SupervisionRemoteActionCategory::kHover:
+    case SupervisionRemoteActionCategory::kClear:
+    case SupervisionRemoteActionCategory::kDrop:
+      action.element_ref = "document-1:7";
+      break;
+    case SupervisionRemoteActionCategory::kType:
+      action.element_ref = "document-1:7";
+      action.text = "private text";
+      break;
+    case SupervisionRemoteActionCategory::kKeyPress:
+      action.key = "Enter";
+      break;
+    case SupervisionRemoteActionCategory::kScroll:
+      action.scroll_delta_y = 120;
+      break;
+    case SupervisionRemoteActionCategory::kSelect:
+      action.element_ref = "document-1:7";
+      action.option = "private option";
+      break;
+    case SupervisionRemoteActionCategory::kDrag:
+      action.element_ref = "document-1:7";
+      action.target_element_ref = "document-1:9";
+      break;
+    case SupervisionRemoteActionCategory::kNavigate:
+      action.navigation = "https://example.test/private-destination";
+      break;
+  }
+  return action;
+}
+
+class PrometheusSupervisionActionControllerTest : public testing::Test {
+ public:
+  PrometheusSupervisionActionControllerTest()
+      : profile_(reinterpret_cast<Profile*>(&profile_storage_)),
+        other_profile_(reinterpret_cast<Profile*>(&other_profile_storage_)),
+        browser_weak_factory_(&browser_),
+        other_browser_weak_factory_(&other_browser_),
+        dashboard_session_(base::UnguessableToken::Create()),
+        controller_lease_(base::UnguessableToken::Create()),
+        document_epoch_(base::UnguessableToken::Create()) {
+    ON_CALL(browser_, GetProfile()).WillByDefault(Return(profile_.get()));
+    ON_CALL(browser_, GetSessionID()).WillByDefault(ReturnRef(browser_id_));
+    ON_CALL(browser_, GetWeakPtr()).WillByDefault([this]() {
+      return browser_weak_factory_.GetWeakPtr();
+    });
+    ON_CALL(browser_, IsDeleteScheduled()).WillByDefault(Return(false));
+    ON_CALL(other_browser_, GetProfile())
+        .WillByDefault(Return(profile_.get()));
+    ON_CALL(other_browser_, GetSessionID())
+        .WillByDefault(ReturnRef(other_browser_id_));
+    ON_CALL(other_browser_, GetWeakPtr()).WillByDefault([this]() {
+      return other_browser_weak_factory_.GetWeakPtr();
+    });
+    ON_CALL(other_browser_, IsDeleteScheduled()).WillByDefault(Return(false));
+    ON_CALL(tab_, GetUnownedUserDataHost()).WillByDefault(ReturnRef(tab_host_));
+    ON_CALL(tab_, GetProfile()).WillByDefault(Return(profile_.get()));
+    ON_CALL(tab_, GetTabHandle()).WillByDefault(Return(43u));
+    ON_CALL(tab_, GetBrowserWindowInterface()).WillByDefault(Return(&browser_));
+    ON_CALL(other_tab_, GetUnownedUserDataHost())
+        .WillByDefault(ReturnRef(other_tab_host_));
+    ON_CALL(other_tab_, GetProfile()).WillByDefault(Return(profile_.get()));
+    ON_CALL(other_tab_, GetTabHandle()).WillByDefault(Return(44u));
+    ON_CALL(other_tab_, GetBrowserWindowInterface())
+        .WillByDefault(Return(&browser_));
+
+    authority_.profile = profile_;
+    authority_.exact_browser = &browser_;
+    authority_.stable_tab = tab_.GetHandle();
+    authority_.live_owner_session_id = owner_;
+    authority_.active_controller_session = dashboard_session_;
+    authority_.controller_lease = controller_lease_;
+    authority_.document_epoch = document_epoch_;
+    authority_.sequence = sequence_;
+    authority_.authority_generation = generation_;
+    authority_.stream_live = true;
+  }
+
+ protected:
+  std::unique_ptr<PrometheusSupervisionActionController> MakeController(
+      std::string immutable_owner = "agent-owner") {
+    return std::make_unique<PrometheusSupervisionActionController>(
+        profile_, browser_weak_factory_.GetWeakPtr(), tab_.GetHandle(),
+        dashboard_session_, std::move(immutable_owner),
+        base::BindRepeating(
+            &PrometheusSupervisionActionControllerTest::ResolveAuthority,
+            base::Unretained(this)),
+        base::BindRepeating(
+            &PrometheusSupervisionActionControllerTest::Dispatch,
+            base::Unretained(this)),
+        base::BindRepeating(
+            &PrometheusSupervisionActionControllerTest::ResolveFrame,
+            base::Unretained(this)));
+  }
+
+  std::optional<SupervisionActionAuthoritySnapshot> ResolveAuthority() {
+    ++authority_resolve_count_;
+    if (mutate_authority_at_ == authority_resolve_count_ &&
+        mutate_authority_) {
+      mutate_authority_.Run();
+    }
+    if (!authority_available_) {
+      return std::nullopt;
+    }
+    return authority_;
+  }
+
+  std::optional<AgentFrameTarget> ResolveFrame(
+      BrowserWindowInterface* browser,
+      tabs::TabHandle tab,
+      const SupervisionRemoteActionRequest&) {
+    ++frame_resolve_count_;
+    if (!frame_available_ || browser != &browser_ || tab != tab_.GetHandle()) {
+      return std::nullopt;
+    }
+    AgentFrameTarget frame;
+    frame.document_token = "document-1";
+    frame.render_process_id = 17;
+    frame.render_frame_routing_id = 19;
+    return frame;
+  }
+
+  void Dispatch(BrowserWindowInterface* browser,
+                const AgentRouteRequest& request,
+                PrometheusAgentService::RouteCallback callback) {
+    ++dispatch_count_;
+    dispatched_browser_ = browser;
+    dispatched_requests_.push_back(request);
+    if (hold_dispatch_) {
+      pending_agent_callbacks_.push_back(std::move(callback));
+      return;
+    }
+    std::move(callback).Run(next_agent_result_);
+  }
+
+  std::optional<SupervisionActionResult> Execute(
+      PrometheusSupervisionActionController& controller,
+      const SupervisionRemoteActionRequest& action,
+      const base::UnguessableToken& dashboard_session,
+      std::string_view document_epoch,
+      uint64_t sequence) {
+    std::optional<SupervisionActionResult> result;
+    controller.ExecuteAction(
+        dashboard_session, document_epoch, sequence, action,
+        base::BindLambdaForTesting([&](SupervisionActionResult action_result) {
+          result.emplace(std::move(action_result));
+        }));
+    return result;
+  }
+
+  std::optional<SupervisionActionResult> Execute(
+      PrometheusSupervisionActionController& controller,
+      const SupervisionRemoteActionRequest& action) {
+    return Execute(controller, action, dashboard_session_,
+                   document_epoch_.ToString(), sequence_);
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  int profile_storage_ = 0;
+  int other_profile_storage_ = 0;
+  raw_ptr<Profile> profile_;
+  raw_ptr<Profile> other_profile_;
+  testing::NiceMock<MockBrowserWindowInterface> browser_;
+  testing::NiceMock<MockBrowserWindowInterface> other_browser_;
+  base::WeakPtrFactory<MockBrowserWindowInterface> browser_weak_factory_;
+  base::WeakPtrFactory<MockBrowserWindowInterface> other_browser_weak_factory_;
+  const SessionID browser_id_ = SessionID::FromSerializedValue(31);
+  const SessionID other_browser_id_ = SessionID::FromSerializedValue(32);
+  ui::UnownedUserDataHost tab_host_;
+  ui::UnownedUserDataHost other_tab_host_;
+  tabs::MockTabInterface tab_;
+  tabs::MockTabInterface other_tab_;
+  const base::UnguessableToken dashboard_session_;
+  const base::UnguessableToken controller_lease_;
+  const base::UnguessableToken document_epoch_;
+  const std::string owner_ = "agent-owner";
+  const uint64_t sequence_ = 7;
+  const uint64_t generation_ = 4;
+  SupervisionActionAuthoritySnapshot authority_;
+  bool authority_available_ = true;
+  bool frame_available_ = true;
+  int authority_resolve_count_ = 0;
+  int frame_resolve_count_ = 0;
+  int mutate_authority_at_ = 0;
+  base::RepeatingClosure mutate_authority_;
+  int dispatch_count_ = 0;
+  raw_ptr<BrowserWindowInterface> dispatched_browser_ = nullptr;
+  std::vector<AgentRouteRequest> dispatched_requests_;
+  bool hold_dispatch_ = false;
+  std::vector<PrometheusAgentService::RouteCallback> pending_agent_callbacks_;
+  AgentRouteResult next_agent_result_ = AgentRouteResult::Success({"changed"});
+};
+
+TEST_F(PrometheusSupervisionActionControllerTest, CategoryClickIsOrdinary) {
