+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PROMETHEUS_PROMETHEUS_EXTENSION_POLICY_TYPES_H_
+#define CHROME_BROWSER_PROMETHEUS_PROMETHEUS_EXTENSION_POLICY_TYPES_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/values.h"
+
+namespace content {
+class BrowserContext;
+}
+
+namespace prometheus {
+
+enum class ExtensionAgentGrant {
+  kBlocked,
+  kReadOnly,
+  kInteract,
+};
+
+enum class ExtensionPolicySource {
+  kComponent,
+  kPolicy,
+  kWebStore,
+  kUnpacked,
+  kOther,
+};
+
+enum class ExtensionPolicyHealthStatus {
+  kReady,
+  kDegraded,
+  kUnavailable,
+};
+
+inline constexpr int kPrometheusExtensionPolicySchemaVersion = 1;
+inline constexpr size_t kMaxExtensionPolicyEntries = 128;
+inline constexpr size_t kMaxExtensionPolicySnapshotRows = 128;
+inline constexpr size_t kMaxExtensionPolicyNameBytes = 80;
+inline constexpr size_t kExtensionPolicyIdSuffixBytes = 6;
+inline constexpr size_t kMaxExtensionPolicyReasonBytes = 48;
+inline constexpr size_t kMaxExtensionPolicyRecoveryBytes = 160;
+inline constexpr char kExtensionPolicyNameFallback[] = "Unnamed extension";
+inline constexpr char kExtensionPolicyReasonFallback[] =
+    "extension_policy_unavailable";
+inline constexpr char kExtensionPolicyRecoveryFallback[] =
+    "Review extension diagnostics and try again.";
+
+struct ExtensionPolicyChoice {
+  ExtensionAgentGrant regular = ExtensionAgentGrant::kBlocked;
+  ExtensionAgentGrant private_mode = ExtensionAgentGrant::kBlocked;
+
+  bool operator==(const ExtensionPolicyChoice&) const = default;
+};
+
+// Browser-only inventory input. `extension_id` and `browser_context` are
+// intentionally absent from every renderer and external projection.
+struct ExtensionPolicyInventoryEntry {
+  std::string extension_id;
+  std::string name;
+  ExtensionPolicySource source = ExtensionPolicySource::kOther;
+  bool enabled = false;
+  bool ready = false;
+  int manifest_version = 0;
+  bool native_private_eligible = false;
+  raw_ptr<content::BrowserContext> browser_context = nullptr;
+};
+
+struct ExtensionPolicyRow {
+  std::string name;
+  std::string id_suffix;
+  ExtensionPolicySource source = ExtensionPolicySource::kOther;
+  bool enabled = false;
+  int manifest_version = 0;
+  bool native_private_eligible = false;
+  ExtensionAgentGrant requested_regular = ExtensionAgentGrant::kBlocked;
+  ExtensionAgentGrant requested_private = ExtensionAgentGrant::kBlocked;
+  ExtensionAgentGrant effective_regular = ExtensionAgentGrant::kBlocked;
+  ExtensionAgentGrant effective_private = ExtensionAgentGrant::kBlocked;
+  size_t ordinal = 0;
+  uint64_t generation = 0;
+
+  bool operator==(const ExtensionPolicyRow&) const = default;
+};
+
+struct ExtensionPolicySnapshot {
+  uint64_t generation = 0;
+  std::vector<ExtensionPolicyRow> rows;
+
+  bool operator==(const ExtensionPolicySnapshot&) const = default;
+};
+
+struct ExtensionPolicyHealth {
+  ExtensionPolicyHealthStatus status =
+      ExtensionPolicyHealthStatus::kUnavailable;
+  std::string reason = kExtensionPolicyReasonFallback;
+  std::string recovery = kExtensionPolicyRecoveryFallback;
+
+  bool operator==(const ExtensionPolicyHealth&) const = default;
+};
+
+std::string_view ExtensionAgentGrantToString(ExtensionAgentGrant grant);
+std::optional<ExtensionAgentGrant> ExtensionAgentGrantFromString(
+    std::string_view value);
+std::string_view ExtensionPolicySourceToString(ExtensionPolicySource source);
+std::string_view ExtensionPolicyHealthStatusToString(
+    ExtensionPolicyHealthStatus status);
+
+ExtensionAgentGrant ClampPrivateExtensionGrant(
+    ExtensionAgentGrant regular,
+    ExtensionAgentGrant private_mode);
+std::string SanitizeExtensionPolicyName(std::string_view name);
+std::string ExtensionPolicyIdSuffix(std::string_view extension_id);
+std::string SanitizeExtensionPolicyReason(std::string_view reason);
+std::string SanitizeExtensionPolicyRecovery(std::string_view recovery);
+std::optional<base::DictValue> ExtensionPolicyRowToValue(
+    const ExtensionPolicyRow& row);
+std::optional<base::DictValue> ExtensionPolicyHealthToValue(
+    const ExtensionPolicyHealth& health);
+
+// Retained RED fixture seam. It is false until the bounded policy behavior is
+// implemented, so the contract compiles and fails only by named assertions.
+bool ExtensionPolicyContractImplementedForTesting();
+
+}  // namespace prometheus
+
+#endif  // CHROME_BROWSER_PROMETHEUS_PROMETHEUS_EXTENSION_POLICY_TYPES_H_
