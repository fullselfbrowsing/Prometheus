+std::optional<PrometheusVaultKind> VaultKindFromString(std::string_view value) {
+  if (value == "credential") {
+    return PrometheusVaultKind::kCredential;
+  }
+  if (value == "payment") {
+    return PrometheusVaultKind::kPayment;
+  }
+  return std::nullopt;
+}
+
+std::optional<uint64_t> VaultIdSequence(std::string_view id) {
+  if (!base::StartsWith(id, kVaultIdPrefix)) {
+    return std::nullopt;
+  }
+  uint64_t sequence = 0;
+  if (!base::StringToUint64(id.substr(std::size(kVaultIdPrefix) - 1),
+                            &sequence) ||
+      sequence == 0 ||
+      id != std::string(kVaultIdPrefix) + base::NumberToString(sequence)) {
+    return std::nullopt;
+  }
+  return sequence;
+}
+
+base::DictValue VaultMetadataToValue(const PrometheusVaultMetadata& metadata) {
+  base::DictValue value;
+  value.Set(kVaultMetadataIdKey, metadata.id);
+  value.Set(kVaultMetadataLabelKey, metadata.label);
+  value.Set(kVaultMetadataKindKey,
+            std::string(PrometheusVaultKindToString(metadata.kind)));
+  value.Set(kVaultMetadataOriginKey, metadata.canonical_site_origin);
+  value.Set(kVaultMetadataUpdatedTimeKey,
+            base::NumberToString(metadata.updated_time_ms));
+  value.Set(kVaultMetadataSecretConfiguredKey, metadata.secret_configured);
+  return value;
+}
+
+std::optional<PrometheusVaultMetadata> VaultMetadataFromValue(
+    const base::DictValue& value) {
+  if (value.size() != 6u) {
+    return std::nullopt;
+  }
+  const std::string* id = value.FindString(kVaultMetadataIdKey);
+  const std::string* label = value.FindString(kVaultMetadataLabelKey);
+  const std::string* kind_value = value.FindString(kVaultMetadataKindKey);
+  const std::string* origin_value = value.FindString(kVaultMetadataOriginKey);
+  const std::string* updated_time_value =
+      value.FindString(kVaultMetadataUpdatedTimeKey);
+  std::optional<bool> secret_configured =
+      value.FindBool(kVaultMetadataSecretConfiguredKey);
+  if (!id || !VaultIdSequence(*id).has_value() || !label || label->empty() ||
+      label->size() > kMaxPrometheusVaultLabelBytes ||
+      !base::IsStringUTF8(*label) || !kind_value || !origin_value ||
+      !updated_time_value || !secret_configured.has_value()) {
+    return std::nullopt;
+  }
+  std::optional<PrometheusVaultKind> kind = VaultKindFromString(*kind_value);
+  std::optional<std::string> canonical_origin =
+      CanonicalSiteOrigin(*origin_value);
+  int64_t updated_time_ms = 0;
+  if (!kind.has_value() || !canonical_origin.has_value() ||
+      *canonical_origin != *origin_value ||
+      !base::StringToInt64(*updated_time_value, &updated_time_ms) ||
+      updated_time_ms < 0) {
+    return std::nullopt;
+  }
+  return PrometheusVaultMetadata{
+      .id = *id,
+      .label = *label,
+      .kind = *kind,
+      .canonical_site_origin = *canonical_origin,
+      .updated_time_ms = updated_time_ms,
+      .secret_configured = *secret_configured,
+  };
+}
+
+std::optional<PrometheusSecretBinding> SecretBindingFromSnapshot(
+    const base::Value& value) {
+  if (!value.is_dict() || value.GetDict().size() != 5u) {
+    return std::nullopt;
+  }
+  const base::DictValue& metadata = value.GetDict();
+  const std::string* record_id = metadata.FindString(kSecretRecordIdKey);
+  const std::string* kind_value = metadata.FindString(kSecretKindKey);
+  const std::string* owner_kind = metadata.FindString(kSecretOwnerKindKey);
+  const std::string* origin = metadata.FindString(kSecretCanonicalOriginKey);
+  std::optional<bool> configured = metadata.FindBool(kSecretConfiguredKey);
+  if (!record_id || !kind_value || !owner_kind || !origin ||
+      configured != true) {
+    return std::nullopt;
+  }
+  std::optional<PrometheusSecretKind> kind =
+      PrometheusSecretKindFromString(*kind_value);
+  if (!kind.has_value()) {
+    return std::nullopt;
+  }
+  PrometheusSecretBinding binding{
+      .record_id = *record_id,
+      .secret_kind = *kind,
+      .owner_kind = *owner_kind,
+      .canonical_origin = *origin,
+  };
+  return IsValidPrometheusSecretBinding(binding)
+             ? std::optional(std::move(binding))
+             : std::nullopt;
+}
+
+bool IsVaultSecretBinding(const PrometheusSecretBinding& binding) {
+  return binding.secret_kind == PrometheusSecretKind::kVaultCredential ||
+         binding.secret_kind == PrometheusSecretKind::kVaultPayment;
+}
