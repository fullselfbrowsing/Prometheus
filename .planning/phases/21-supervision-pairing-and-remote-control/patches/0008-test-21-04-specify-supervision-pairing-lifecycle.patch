+
+class RecordingSupervisionObserver final
+    : public PrometheusSupervisionProfileService::Observer {
+ public:
+  void OnPrometheusSupervisionSnapshotChanged(
+      int32_t stable_tab_id,
+      const SanitizedSupervisionSnapshot& snapshot) override {
+    stable_tab_ids.push_back(stable_tab_id);
+    snapshots.push_back(snapshot);
+  }
+
+  std::vector<int32_t> stable_tab_ids;
+  std::vector<SanitizedSupervisionSnapshot> snapshots;
+};
+
+class NoopTabDataObserver final : public PrometheusAgentTabData::Observer {
+ public:
+  void OnPrometheusAgentTabOwnerChanged(std::string_view,
+                                        std::string_view) override {}
+  void OnPrometheusAgentTabDataDestroying() override {}
+};
+
+class PrometheusSupervisionProfileServiceTest : public testing::Test {
+ public:
+  PrometheusSupervisionProfileServiceTest()
+      : now_(base::Time::FromMillisecondsSinceUnixEpoch(100'000)),
+        profile_(reinterpret_cast<Profile*>(&profile_storage_)),
+        browser_weak_factory_(&browser_),
+        registry_(kDefaultMaxAgentSessions, base::Hours(1)),
+        agent_service_(std::make_unique<PrometheusAgentService>(&registry_)) {
+    ON_CALL(browser_, GetProfile()).WillByDefault(Return(profile_.get()));
+    ON_CALL(browser_, GetWeakPtr()).WillByDefault([this]() {
+      return browser_weak_factory_.GetWeakPtr();
+    });
+    ON_CALL(browser_, IsDeleteScheduled()).WillByDefault(Return(false));
+    ON_CALL(tab_, GetUnownedUserDataHost()).WillByDefault(ReturnRef(tab_host_));
+    ON_CALL(tab_, GetProfile()).WillByDefault(Return(profile_.get()));
+    ON_CALL(tab_, GetBrowserWindowInterface()).WillByDefault(Return(&browser_));
+    ON_CALL(tab_, GetTitle()).WillByDefault(Return(u"Release notes"));
+    ON_CALL(tab_, GetURL())
+        .WillByDefault(Return(GURL("https://example.test/private?q=secret")));
+    ON_CALL(tab_, RegisterWillDetach(_))
+        .WillByDefault([this](tabs::TabInterface::WillDetach callback) {
+          will_detach_ = std::move(callback);
+          return base::CallbackListSubscription();
+        });
+    pairing_codes_ = {"ABCDEFGH", "JKLMNPQS", "TUVWXYZ2", "3456789A"};
+    ResetService(SupervisionProfileKind::kRegular, SupervisionLimits());
+  }
+
+  ~PrometheusSupervisionProfileServiceTest() override {
+    if (service_) {
+      service_->RemoveObserver(&observer_);
+    }
+  }
+
+ protected:
+  void ResetService(SupervisionProfileKind kind, SupervisionLimits limits) {
+    if (service_) {
+      service_->RemoveObserver(&observer_);
+      service_.reset();
+    }
+    service_ = std::make_unique<PrometheusSupervisionProfileService>(
+        profile_, kind,
+        base::BindRepeating(
+            &PrometheusSupervisionProfileServiceTest::ObserveTabData,
+            base::Unretained(this)),
+        base::BindRepeating(&PrometheusSupervisionProfileServiceTest::Now,
+                            base::Unretained(this)),
+        base::BindRepeating(
+            &PrometheusSupervisionProfileServiceTest::NextPairingCode,
+            base::Unretained(this)),
+        limits);
+    service_->AddObserver(&observer_);
+  }
+
+  base::Time Now() const { return now_; }
+
+  std::string NextPairingCode() {
+    if (next_pairing_code_ >= pairing_codes_.size()) {
+      return "ABCDEFGH";
+    }
+    return pairing_codes_[next_pairing_code_++];
+  }
+
+  PrometheusAgentTabObservationLease ObserveTabData(
+      tabs::TabInterface* tab,
+      PrometheusAgentTabData::Observer* observer) {
+    return agent_service_->ObserveOrCreateTabData(tab, observer);
+  }
+
+  SupervisionPairingCreationResult CreatePairing() {
+    return service_->CreatePairing(&browser_, &tab_);
+  }
+
+  SupervisionRedemptionResult Redeem(
+      const SupervisionPairingCreationResult& creation,
+      std::string_view label = "Dashboard one") {
+    return service_->RedeemPairing(creation.pairing_code, label);
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  base::Time now_;
+  int profile_storage_ = 0;
+  raw_ptr<Profile> profile_;
+  MockBrowserWindowInterface browser_;
+  base::WeakPtrFactory<MockBrowserWindowInterface> browser_weak_factory_;
+  ui::UnownedUserDataHost tab_host_;
+  tabs::MockTabInterface tab_;
+  tabs::TabInterface::WillDetach will_detach_;
+  AgentSessionRegistry registry_;
+  std::unique_ptr<PrometheusAgentService> agent_service_;
+  std::vector<std::string> pairing_codes_;
+  size_t next_pairing_code_ = 0;
+  NoopTabDataObserver observer_tab_data_;
+  RecordingSupervisionObserver observer_;
+  std::unique_ptr<PrometheusSupervisionProfileService> service_;
+};
+
+TEST_F(PrometheusSupervisionProfileServiceTest,
+       PairingReplacementHappensBeforeNewCodeBecomesRedeemable) {
+  SupervisionPairingCreationResult first = CreatePairing();
+  ASSERT_TRUE(first.ok);
+  SupervisionPairingCreationResult second = CreatePairing();
+  ASSERT_TRUE(second.ok);
+  EXPECT_NE(first.pairing_code, second.pairing_code);
+  EXPECT_FALSE(service_->RedeemPairing(first.pairing_code, "old").ok);
+  EXPECT_TRUE(Redeem(second, "new").ok);
+  EXPECT_EQ(0u, service_->pending_pairing_count_for_testing());
+}
+
+TEST_F(PrometheusSupervisionProfileServiceTest,
+       PairingOneUseConsumesAtomicallyAndCapturesOwnerAtRedemption) {
+  SupervisionPairingCreationResult creation = CreatePairing();
+  ASSERT_TRUE(creation.ok);
+  PrometheusAgentTabObservationLease owner_lease =
+      agent_service_->ObserveOrCreateTabData(&tab_, &observer_tab_data_);
+  ASSERT_NE(nullptr, owner_lease.data());
+  ASSERT_TRUE(owner_lease.data()->ClaimIfUnowned("owner-a", "Agent A").ok);
+
+  SupervisionRedemptionResult redeemed = Redeem(creation);
+  ASSERT_TRUE(redeemed.ok);
+  EXPECT_EQ(std::optional<std::string>("owner-a"),
+            service_->immutable_owner_for_testing(redeemed.dashboard_session));
+  EXPECT_FALSE(Redeem(creation, "racer").ok);
+  EXPECT_EQ(1u, service_->viewer_count_for_testing(creation.stable_tab_id));
+}
+
+TEST_F(PrometheusSupervisionProfileServiceTest,
+       PairingCreateTimeOwnerDoesNotOverrideLaterAtomicRedemptionOwner) {
+  PrometheusAgentTabObservationLease owner_lease =
+      agent_service_->ObserveOrCreateTabData(&tab_, &observer_tab_data_);
+  ASSERT_NE(nullptr, owner_lease.data());
+  ASSERT_TRUE(owner_lease.data()->ClaimIfUnowned("owner-a", "Agent A").ok);
+  SupervisionPairingCreationResult creation = CreatePairing();
+  ASSERT_TRUE(creation.ok);
+  ASSERT_TRUE(owner_lease.data()->ReleaseIfOwned("owner-a").ok);
+  ASSERT_TRUE(owner_lease.data()->ClaimIfUnowned("owner-b", "Agent B").ok);
+
+  SupervisionRedemptionResult redeemed = Redeem(creation);
+  ASSERT_TRUE(redeemed.ok);
+  EXPECT_EQ(std::optional<std::string>("owner-b"),
+            service_->immutable_owner_for_testing(redeemed.dashboard_session));
+}
+
+TEST_F(PrometheusSupervisionProfileServiceTest,
+       PairingExpiryAndBoundedBadAttemptsFailClosed) {
+  SupervisionLimits limits;
+  limits.attempts_per_code = 2;
+  limits.sessions_per_profile = 2;
+  ResetService(SupervisionProfileKind::kRegular, limits);
+  SupervisionPairingCreationResult creation = CreatePairing();
+  ASSERT_TRUE(creation.ok);
+  EXPECT_EQ(SupervisionErrorCode::kInvalidCode,
+            service_->RedeemPairing("22222222", "guess").error_code);
+  EXPECT_EQ(SupervisionErrorCode::kInvalidCode,
+            service_->RedeemPairing("33333333", "guess").error_code);
+  EXPECT_EQ(SupervisionErrorCode::kAttemptCapReached,
+            service_->RedeemPairing("44444444", "guess").error_code);
+  EXPECT_LE(service_->global_failed_attempt_count_for_testing(), 4u);
+
+  now_ += base::Minutes(6);
+  EXPECT_EQ(SupervisionErrorCode::kExpiredCode, Redeem(creation).error_code);
+}
+
+TEST_F(PrometheusSupervisionProfileServiceTest,
+       ViewerSessionsRevokeAndExpireIndependently) {
+  SupervisionPairingCreationResult first = CreatePairing();
+  ASSERT_TRUE(first.ok);
+  SupervisionRedemptionResult viewer_a = Redeem(first, "Viewer A");
+  ASSERT_TRUE(viewer_a.ok);
+  SupervisionPairingCreationResult second = CreatePairing();
+  ASSERT_TRUE(second.ok);
+  SupervisionRedemptionResult viewer_b = Redeem(second, "Viewer B");
+  ASSERT_TRUE(viewer_b.ok);
+  EXPECT_EQ(2u, service_->viewer_count_for_testing(first.stable_tab_id));
+  EXPECT_TRUE(service_->RevokeSession(viewer_a.dashboard_session).ok);
+  EXPECT_EQ(1u, service_->viewer_count_for_testing(first.stable_tab_id));
+
+  now_ += base::Minutes(16);
+  SanitizedSupervisionSnapshot snapshot =
+      service_->GetSanitizedSnapshot(first.stable_tab_id);
+  EXPECT_EQ(0u, service_->viewer_count_for_testing(first.stable_tab_id));
+  EXPECT_FALSE(snapshot.sessions.empty());
+}
+
+TEST_F(PrometheusSupervisionProfileServiceTest,
+       ControllerLeaseIsSoleAndConflictNeverStealsAuthority) {
+  PrometheusAgentTabObservationLease owner_lease =
+      agent_service_->ObserveOrCreateTabData(&tab_, &observer_tab_data_);
+  ASSERT_NE(nullptr, owner_lease.data());
+  ASSERT_TRUE(owner_lease.data()->ClaimIfUnowned("owner-a", "Agent A").ok);
+  SupervisionPairingCreationResult first = CreatePairing();
+  ASSERT_TRUE(first.ok);
+  SupervisionRedemptionResult viewer_a = Redeem(first, "Viewer A");
+  ASSERT_TRUE(viewer_a.ok);
+  SupervisionPairingCreationResult second = CreatePairing();
+  ASSERT_TRUE(second.ok);
+  SupervisionRedemptionResult viewer_b = Redeem(second, "Viewer B");
+  ASSERT_TRUE(viewer_b.ok);
+
+  EXPECT_TRUE(service_->EnableControl(viewer_a.dashboard_session).ok);
+  EXPECT_EQ(SupervisionErrorCode::kControllerConflict,
+            service_->EnableControl(viewer_b.dashboard_session).error_code);
+  EXPECT_EQ(1u, service_->controller_count_for_testing());
+  EXPECT_TRUE(service_->StopControl(viewer_a.dashboard_session).ok);
+  EXPECT_TRUE(service_->EnableControl(viewer_b.dashboard_session).ok);
+}
+
+TEST_F(PrometheusSupervisionProfileServiceTest,
+       ControllerDeniedForImmutableEmptyOwnerAndLaterClaimEndsViewer) {
+  SupervisionPairingCreationResult creation = CreatePairing();
+  ASSERT_TRUE(creation.ok);
+  SupervisionRedemptionResult viewer = Redeem(creation);
+  ASSERT_TRUE(viewer.ok);
+  EXPECT_EQ(std::optional<std::string>(""),
+            service_->immutable_owner_for_testing(viewer.dashboard_session));
+  EXPECT_FALSE(service_->EnableControl(viewer.dashboard_session).ok);
+
+  PrometheusAgentTabObservationLease owner_lease =
+      agent_service_->ObserveOrCreateTabData(&tab_, &observer_tab_data_);
