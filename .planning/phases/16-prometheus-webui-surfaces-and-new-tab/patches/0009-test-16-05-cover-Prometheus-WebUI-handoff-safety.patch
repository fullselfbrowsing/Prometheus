+views::WebView* FindWebView(views::View* view) {
+  if (!view) {
+    return nullptr;
+  }
+  if (auto* const web_view = views::AsViewClass<views::WebView>(view)) {
+    return web_view;
+  }
+  for (views::View* child : view->children()) {
+    if (auto* const web_view = FindWebView(child)) {
+      return web_view;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
