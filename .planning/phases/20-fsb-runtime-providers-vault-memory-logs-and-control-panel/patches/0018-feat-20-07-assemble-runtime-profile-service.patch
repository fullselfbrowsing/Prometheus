+void PrometheusRuntimeProfileService::OnDiscoveryComplete(
+    uint64_t operation_id,
+    std::shared_ptr<std::optional<RuntimeDiscoveryResult>> immediate_result,
+    ProviderModelListResult provider_result) {
+  auto discovery = discoveries_.find(operation_id);
