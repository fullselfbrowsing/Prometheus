+              captured.ok = result.ok;
+              captured.error_code = result.error_code;
+              captured.message = result.message;
+              auto serialized = SerializeAgentTransportResult(result);
+              if (serialized.has_value()) {
+                captured.serialized = std::move(*serialized);
+              } else {
+                captured.message = serialized.error().message;
+              }
+              observation->emplace(std::move(captured));
+              std::move(completed).Run();
+            },
+            &observation, completed.QuitClosure()));
+    if (!observation.has_value()) {
