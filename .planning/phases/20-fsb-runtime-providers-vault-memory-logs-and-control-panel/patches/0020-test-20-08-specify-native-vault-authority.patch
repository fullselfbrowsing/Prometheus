+      !std::is_copy_constructible_v<ConfirmedVaultInsertionRequest>);
+  static_assert(
+      !std::is_copy_assignable_v<ConfirmedVaultInsertionRequest>);
+  static_assert(std::is_move_constructible_v<ConfirmedVaultInsertionRequest>);
