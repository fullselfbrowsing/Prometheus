+      R"json({"stop_reason":"tool_use","content":[{"type":"text","text":"opening"},{"type":"tool_use","id":"anthropic-1","name":"navigate","input":{"url":"https://example.test"}}],"usage":{"input_tokens":12,"output_tokens":5}})json",
+      "secret");
