+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/prometheus_tab_status_badge.h"
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/prometheus/prometheus_action.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/color/color_id.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/controls/image_view.h"
+#include "ui/views/layout/box_layout.h"
+
+namespace {
+
+constexpr int kBadgeSpacing = 2;
+
+bool IsSafeDefault(const PrometheusTabState& state) {
+  return state.owner_label.empty() && !state.automation_active &&
+         !state.supervision_active &&
+         state.health == PrometheusTabState::Health::kOk;
+}
+
+std::u16string BuildAccessibleName(const PrometheusTabState& state) {
+  if (IsSafeDefault(state)) {
+    return u"No agent owns this tab";
+  }
+
+  std::vector<std::u16string> parts;
+  if (state.owner_label.empty()) {
+    parts.push_back(u"No agent owns this tab");
+  } else {
+    std::u16string owner = u"Owned by ";
+    owner += base::UTF8ToUTF16(state.owner_label);
+    parts.push_back(std::move(owner));
+  }
+
+  if (state.automation_active) {
+    parts.push_back(u"Agent is working in this tab");
+  }
+  if (state.supervision_active) {
+    parts.push_back(u"Supervision active");
+  }
+
+  parts.push_back(state.health == PrometheusTabState::Health::kOk
+                      ? u"Tab health OK"
+                      : u"Tab needs attention");
+
+  return base::JoinString(parts, u", ");
+}
+
+ui::ImageModel GetPrometheusBadgeIcon(PrometheusAction action,
+                                      ui::ColorId color_id) {
+  return ui::ImageModel::FromVectorIcon(
+      *GetPrometheusActionIconMap().at(action), color_id,
+      PrometheusTabStatusBadge::kIconSize);
+}
+
+views::ImageView* AddBadgeIcon(views::View* parent) {
+  auto* icon = parent->AddChildView(std::make_unique<views::ImageView>());
+  icon->SetImageSize(gfx::Size(PrometheusTabStatusBadge::kIconSize,
+                               PrometheusTabStatusBadge::kIconSize));
+  icon->SetCanProcessEventsWithinSubtree(false);
+  icon->SetVisible(false);
+  return icon;
+}
+
+void SetBadgeIcon(views::ImageView* icon,
+                  bool visible,
+                  PrometheusAction action,
+                  ui::ColorId color_id) {
+  icon->SetVisible(visible);
+  if (!visible) {
+    return;
+  }
+  icon->SetImage(GetPrometheusBadgeIcon(action, color_id));
+}
+
+}  // namespace
+
+PrometheusTabStatusBadge::PrometheusTabStatusBadge() {
+  SetCanProcessEventsWithinSubtree(false);
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),
+      kBadgeSpacing));
+
+  owner_or_automation_badge_ = AddBadgeIcon(this);
+  supervision_badge_ = AddBadgeIcon(this);
+  health_badge_ = AddBadgeIcon(this);
+
+  SetState(PrometheusTabState::SafeDefault());
+}
+
+PrometheusTabStatusBadge::~PrometheusTabStatusBadge() = default;
+
+void PrometheusTabStatusBadge::SetState(const PrometheusTabState& state) {
+  const bool has_owner_or_automation =
+      !state.owner_label.empty() || state.automation_active;
+  const bool has_health_warning =
+      state.health == PrometheusTabState::Health::kNeedsAttention;
+
+  SetBadgeIcon(owner_or_automation_badge_, has_owner_or_automation,
+               PrometheusAction::kBolt, kColorPrometheusAccent);
+  SetBadgeIcon(supervision_badge_, state.supervision_active,
+               PrometheusAction::kShield, kColorPrometheusAccent);
+  SetBadgeIcon(health_badge_, has_health_warning,
+               PrometheusAction::kTriangleExclamation,
+               kColorPrometheusAccent);
+
+  SetVisible(has_owner_or_automation || state.supervision_active ||
+             has_health_warning);
+  GetViewAccessibility().SetName(BuildAccessibleName(state));
+  PreferredSizeChanged();
+  SchedulePaint();
+}
+
+BEGIN_METADATA(PrometheusTabStatusBadge)
+END_METADATA
