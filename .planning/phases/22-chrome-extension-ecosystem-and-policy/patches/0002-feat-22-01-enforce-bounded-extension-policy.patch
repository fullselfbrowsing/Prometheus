+PrometheusExtensionPolicyService::SetRequestedGrant(size_t ordinal,
+                                                    uint64_t generation,
+                                                    bool private_mode,
+                                                    ExtensionAgentGrant grant) {
+  if (shutdown_ || !prefs_) {
+    return ExtensionPolicyMutationResult::kUnavailable;
+  }
+  if (generation != generation_) {
+    return ExtensionPolicyMutationResult::kStaleGeneration;
+  }
+
+  const std::vector<ExtensionPolicyInventoryEntry> inventory = BuildInventory();
+  if (ordinal >= inventory.size() ||
+      ordinal >= kMaxExtensionPolicySnapshotRows) {
+    return ExtensionPolicyMutationResult::kMissingExtension;
+  }
+
+  ExtensionPolicyChoices choices =
+      ReadPrometheusExtensionPolicyChoices(*prefs_);
+  ExtensionPolicyChoice& choice = choices[inventory[ordinal].extension_id];
+  if (private_mode) {
+    if (!inventory[ordinal].native_private_eligible ||
+        ClampPrivateExtensionGrant(choice.regular, grant) != grant) {
+      return ExtensionPolicyMutationResult::kInvalidPrivateGrant;
+    }
+    choice.private_mode = grant;
+  } else {
+    choice.regular = grant;
+    choice.private_mode =
+        ClampPrivateExtensionGrant(choice.regular, choice.private_mode);
+  }
+  WritePrometheusExtensionPolicyChoices(*prefs_, choices);
+  ReconcileAndNotify();
+  return ExtensionPolicyMutationResult::kApplied;
 }
 
