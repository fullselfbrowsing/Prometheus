   PrometheusTabStatusBadge();
   PrometheusTabStatusBadge(const PrometheusTabStatusBadge&) = delete;
@@ -27,6 +28,16 @@ class PrometheusTabStatusBadge : public views::View {
 
   void SetState(const PrometheusTabState& state);
 
+  views::ImageView* owner_or_automation_badge_for_testing() const {
+    return owner_or_automation_badge_;
+  }
+  views::ImageView* supervision_badge_for_testing() const {
+    return supervision_badge_;
+  }
+  views::ImageView* health_badge_for_testing() const {
+    return health_badge_;
+  }
+
  private:
   raw_ptr<views::ImageView> owner_or_automation_badge_ = nullptr;
   raw_ptr<views::ImageView> supervision_badge_ = nullptr;
