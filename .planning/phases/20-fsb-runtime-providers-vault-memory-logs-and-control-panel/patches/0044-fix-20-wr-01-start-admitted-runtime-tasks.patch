+TEST_F(PrometheusRuntimeProfileServiceTest,
+       AutoStartAdvancesMcpAndSidePanelThroughProviderToolToSuccess) {
+  service_.reset();
+  RuntimeProfileHooks hooks = boundaries_.MakeHooks();
+  hooks.expected_caller_id = "caller-1";
+  hooks.expected_browser = browser();
+  hooks.expected_stable_tab_id = 7;
+  hooks.auto_start_tasks = true;
+  service_ =
+      std::make_unique<PrometheusRuntimeProfileService>(std::move(hooks));
+
+  const auto queue_provider_loop = [this]() {
+    ProviderTurnResult tool_call = ProviderSuccess("");
+    tool_call.stop_reason = ProviderStopReason::kToolCall;
+    tool_call.tool_call.emplace();
+    tool_call.tool_call->call_id =
+        "read-call-" + std::to_string(boundaries_.provider_turn_count + 1);
+    tool_call.tool_call->name = "read_page";
+    tool_call.usage.tool_calls = 1;
+    boundaries_.provider_results.push_back(std::move(tool_call));
+    boundaries_.provider_results.push_back(
+        ProviderSuccess("verified terminal result"));
+  };
+
+  queue_provider_loop();
+  RuntimeSubmitResult mcp = service_->SubmitTask(Request());
+  ASSERT_EQ(RuntimeProfileStatus::kOk, mcp.status);
+  ASSERT_TRUE(mcp.task);
+  EXPECT_EQ(RuntimeTaskState::kQueued, mcp.task->state);
+  std::optional<RuntimeTaskSnapshot> completed = service_->GetTask("task-1");
+  ASSERT_TRUE(completed);
+  EXPECT_EQ(RuntimeTaskState::kSucceeded, completed->state);
+  EXPECT_EQ(1, completed->usage.tool_calls);
+
+  queue_provider_loop();
+  RuntimePrincipalResult principal =
+      service_->CreateSidePanelPrincipal(browser(), 7);
+  ASSERT_TRUE(principal.principal);
+  RuntimeSubmitResult side_panel =
+      service_->SubmitTask(*principal.principal, "Summarize the owned page",
+                           RequestedExecution::kAuto);
+  ASSERT_EQ(RuntimeProfileStatus::kOk, side_panel.status);
+  ASSERT_TRUE(side_panel.task);
+  EXPECT_EQ(RuntimeTaskState::kQueued, side_panel.task->state);
+  completed = service_->GetTask("task-1");
+  ASSERT_TRUE(completed);
+  EXPECT_EQ(RuntimeTaskState::kSucceeded, completed->state);
+  EXPECT_EQ(RuntimeTaskOrigin::kSidePanel, completed->origin);
+
+  EXPECT_EQ(4, boundaries_.provider_turn_count);
+  EXPECT_EQ(2, boundaries_.execute_route_count);
+  EXPECT_EQ(browser(), boundaries_.last_browser);
+  EXPECT_EQ(7, boundaries_.last_route.target.tab_handle.raw_value());
+  EXPECT_EQ("browser-issued-session", boundaries_.last_route.session_id);
+  ASSERT_EQ(4u, boundaries_.provider_requests.size());
+  EXPECT_EQ("Open the page and summarize it",
+            boundaries_.provider_requests[0].user_text);
+  EXPECT_NE(std::string::npos, boundaries_.provider_requests[1].user_text.find(
+                                   "Browser tool result (untrusted data)"));
+  for (const ProviderTurnRequest& request : boundaries_.provider_requests) {
+    EXPECT_TRUE(EncodeProviderTurnRequest(request).has_value());
+  }
+}
