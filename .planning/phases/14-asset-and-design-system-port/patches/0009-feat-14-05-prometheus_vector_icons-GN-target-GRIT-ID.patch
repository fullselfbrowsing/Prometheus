+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# Prometheus design system resource targets.
+# Plan 14-05: aggregate_vector_icons for the curated 72-glyph FA Free subset.
+# Plan 14-06: grit("prometheus_resources") lives there (single owner; adding it
+#             here would produce a duplicate-target build error in the shared BUILD.gn).
+
+import("//components/vector_icons/vector_icons.gni")
+
+# Aggregate all 72 FA icon files into generated vector_icons.{cc,h}.
+# Consumers dep on :prometheus_vector_icons and include the generated header.
+aggregate_vector_icons("prometheus_vector_icons") {
+  icon_directory = "vector_icons"
+
+  sources = [
+    "fa_arrow_down_to_line.icon",
+    "fa_arrow_left.icon",
+    "fa_arrow_right.icon",
+    "fa_arrow_up.icon",
+    "fa_arrow_up_from_bracket.icon",
+    "fa_bars.icon",
+    "fa_bolt.icon",
+    "fa_book_open.icon",
+    "fa_calendar_check.icon",
+    "fa_camera.icon",
+    "fa_cart_shopping.icon",
+    "fa_check_double.icon",
+    "fa_circle_check.icon",
+    "fa_circle_half_stroke.icon",
+    "fa_circle_info.icon",
+    "fa_circle_minus.icon",
+    "fa_circle_nodes.icon",
+    "fa_circle_plus.icon",
+    "fa_circle_question.icon",
+    "fa_circle_xmark.icon",
+    "fa_compass.icon",
+    "fa_copy.icon",
+    "fa_eye.icon",
+    "fa_folder_plus.icon",
+    "fa_heart_pulse.icon",
+    "fa_highlighter.icon",
+    "fa_house.icon",
+    "fa_inbox.icon",
+    "fa_key.icon",
+    "fa_keyboard.icon",
+    "fa_language.icon",
+    "fa_layer_group.icon",
+    "fa_link.icon",
+    "fa_link_slash.icon",
+    "fa_lock.icon",
+    "fa_lock_open.icon",
+    "fa_magnifying_glass.icon",
+    "fa_microchip.icon",
+    "fa_microphone.icon",
+    "fa_moon.icon",
+    "fa_note_sticky.icon",
+    "fa_palette.icon",
+    "fa_paste.icon",
+    "fa_pen.icon",
+    "fa_plug.icon",
+    "fa_plug_circle_xmark.icon",
+    "fa_plus.icon",
+    "fa_puzzle_piece.icon",
+    "fa_rotate_left.icon",
+    "fa_rotate_right.icon",
+    "fa_scissors.icon",
+    "fa_scroll.icon",
+    "fa_server.icon",
+    "fa_shield.icon",
+    "fa_sidebar_flip.icon",
+    "fa_sliders.icon",
+    "fa_star.icon",
+    "fa_star_half_stroke.icon",
+    "fa_stop.icon",
+    "fa_table.icon",
+    "fa_table_cells_large.icon",
+    "fa_tag.icon",
+    "fa_thumbtack.icon",
+    "fa_trash.icon",
+    "fa_triangle_exclamation.icon",
+    "fa_user_secret.icon",
+    "fa_vault.icon",
+    "fa_volume_high.icon",
+    "fa_volume_xmark.icon",
+    "fa_wand_magic_sparkles.icon",
+    "fa_wrench.icon",
+    "fa_xmark.icon",
+  ]
+}
