+IN_PROC_BROWSER_TEST_F(PrometheusTabSupervisionBadgeBrowserTest,
+                       RealTabLiveTransitionsAndTerminalClear) {
+  ASSERT_EQ(1, tab_strip()->GetModelCount());
+  Tab* const tab = tab_view_at(0);
+  ASSERT_TRUE(tab);
+  PrometheusTabStatusBadge* const badge =
+      tab->prometheus_tab_status_badge_for_testing();
+  ASSERT_TRUE(badge);
+  EXPECT_FALSE(badge->GetVisible());
+
+  std::unique_ptr<prometheus::PrometheusAgentTabData> tab_data =
+      prometheus::PrometheusAgentTabData::ForTabForTesting(
+          tab_interface_at(0));
+  ASSERT_TRUE(tab_data);
+  EXPECT_EQ(tab_data.get(), prometheus::PrometheusAgentTabData::From(
+                                tab_interface_at(0)));
+  EXPECT_FALSE(badge->GetVisible());
+
+  EXPECT_TRUE(tab_data->ClaimIfUnowned("owner-a", "Agent A").ok);
+  EXPECT_EQ(u"Owned by Agent A; Tab health OK",
+            badge->GetViewAccessibility().GetCachedName());
+
+  tab_data->set_automation_active(true);
+  PrometheusTabState::Supervision supervision;
+  supervision.available = true;
+  supervision.viewer_count = 2;
+  supervision.view_state = ViewState::kViewing;
+  supervision.control_state = ControlState::kControllerReady;
+  supervision.controller_label = "Dashboard A";
+  supervision.activity_state = ActivityState::kExecuting;
+  supervision.action_category = ActionCategory::kClick;
+  tab_data->UpdateSupervisionState(supervision);
+  FlushLayouts();
+
+  EXPECT_EQ(badge, tab->prometheus_tab_status_badge_for_testing());
+  EXPECT_TRUE(badge->GetVisible());
+  EXPECT_EQ(ExpectedIcon(PrometheusAction::kCircleNodes,
+                         kColorPrometheusAccent),
+            badge->supervision_badge_for_testing()->GetImageModel());
+  EXPECT_EQ(
+      u"Owned by Agent A; Agent is working in this tab; Supervised by 2 trusted clients; Remote control enabled for Dashboard A; Remote action active: Click; Tab health OK",
+      badge->GetViewAccessibility().GetCachedName());
+
+  supervision.activity_state = ActivityState::kCompleted;
+  supervision.action_category.reset();
+  tab_data->UpdateSupervisionState(supervision);
+  EXPECT_EQ(ExpectedIcon(PrometheusAction::kShield, kColorPrometheusAccent),
+            badge->supervision_badge_for_testing()->GetImageModel());
+
+  supervision.control_state = ControlState::kViewOnly;
+  supervision.controller_label.reset();
+  tab_data->UpdateSupervisionState(supervision);
+  EXPECT_EQ(ExpectedIcon(PrometheusAction::kEye, kColorPrometheusAccent),
+            badge->supervision_badge_for_testing()->GetImageModel());
+
+  tab_data->ClearSupervisionState();
+  EXPECT_TRUE(tab_data->ReleaseIfOwned("owner-a").ok);
+  EXPECT_FALSE(badge->GetVisible());
+  EXPECT_EQ(u"No agent owns this tab",
+            badge->GetViewAccessibility().GetCachedName());
+
+  tab_data->UpdateSupervisionState(ViewingState(1).supervision);
+  EXPECT_TRUE(badge->GetVisible());
+  tab_data.reset();
+  EXPECT_FALSE(badge->GetVisible());
+
+  tab_data = prometheus::PrometheusAgentTabData::ForTabForTesting(
+      tab_interface_at(0));
+  ASSERT_TRUE(tab_data);
+  tab_data->UpdateSupervisionState(ViewingState(3).supervision);
+  EXPECT_TRUE(badge->GetVisible());
+  EXPECT_EQ(
+      u"No agent owns this tab; Supervised by 3 trusted clients; Tab health OK",
+      badge->GetViewAccessibility().GetCachedName());
+}
