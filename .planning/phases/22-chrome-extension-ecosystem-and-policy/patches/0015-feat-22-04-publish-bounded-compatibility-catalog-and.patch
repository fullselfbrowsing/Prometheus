+
+std::string ManifestVersionLabel(int manifest_version) {
+  switch (manifest_version) {
+    case 3:
+      return "Manifest V3";
+    case 2:
+      return "Manifest V2";
+    default:
+      return "Manifest unknown";
+  }
+}
+
+}  // namespace
+
+const std::array<ExtensionCompatibilityRow,
+                 kExtensionCompatibilityCatalogSize>&
+GetExtensionCompatibilityCatalog() {
+  return kExtensionCompatibilityCatalog;
+}
+
+std::string_view ExtensionCompatibilityResultToString(
+    ExtensionCompatibilityResult result) {
+  switch (result) {
+    case ExtensionCompatibilityResult::kVerified:
+      return "Verified";
+    case ExtensionCompatibilityResult::kDegraded:
+      return "Degraded";
+    case ExtensionCompatibilityResult::kUnsupported:
+      return "Unsupported";
+  }
+}
+
+std::optional<ExtensionCompatibilityResult>
+ExtensionCompatibilityResultFromString(std::string_view value) {
+  if (value == "Verified") {
+    return ExtensionCompatibilityResult::kVerified;
+  }
+  if (value == "Degraded") {
+    return ExtensionCompatibilityResult::kDegraded;
+  }
+  if (value == "Unsupported") {
+    return ExtensionCompatibilityResult::kUnsupported;
+  }
+  return std::nullopt;
+}
+
+base::DictValue ExtensionCompatibilityRowToValue(
+    const ExtensionCompatibilityRow& row) {
+  base::DictValue value;
+  value.Set("category", row.category_label);
+  value.Set("status", base::ToLowerASCII(
+                          ExtensionCompatibilityResultToString(row.result)));
+  value.Set("fixture",
+            base::StrCat({row.fixture_name, " v", row.fixture_version}));
+  value.Set("manifest", ManifestVersionLabel(row.manifest_version));
+  value.Set("source", row.install_source);
+  value.Set("behaviors", row.actions_exercised);
+  value.Set("revision", base::StrCat({"Prometheus ", row.prometheus_build,
+                                      " (Chromium ", row.chromium_revision,
+                                      ")"}));
+  value.Set("last_verified", row.last_verified);
+  value.Set("limitation", base::StrCat({row.limitation, kLimitationSuffix}));
+  return value;
+}
+
+bool IsClosedExtensionCompatibilityCatalog() {
+  const auto& catalog = GetExtensionCompatibilityCatalog();
+  if (catalog.size() != kExtensionCompatibilityCatalogSize) {
+    return false;
+  }
+
+  static constexpr std::array<std::string_view, kExtensionCompatibilityCatalogSize>
+      kRequiredCategoryKeys = {
+          "password_manager_like",
+          "ad_blocker",
+          "productivity_content_script",
+          "side_panel_tooling",
+          "developer_workflow",
+      };
+
+  std::set<std::string_view> seen_keys;
+  for (const ExtensionCompatibilityRow& row : catalog) {
+    if (row.category_key.empty() || row.category_label.empty() ||
+        row.fixture_name.empty() || row.fixture_version.empty() ||
+        row.install_source.empty() || row.prometheus_build.empty() ||
+        row.chromium_revision.empty() || row.actions_exercised.empty() ||
+        row.limitation.empty() || row.evidence_artifact.empty() ||
+        row.last_verified.empty()) {
+      return false;
+    }
+    if (row.manifest_version != 3) {
+      return false;
+    }
+    if (row.fixture_sha256.size() != kExtensionCompatibilitySha256HexLength ||
+        !std::ranges::all_of(row.fixture_sha256, [](char character) {
+          return base::IsHexDigit(character) &&
+                 (base::IsAsciiDigit(character) ||
+                  base::IsAsciiLower(character));
+        })) {
+      return false;
+    }
+    if (!std::ranges::any_of(kRequiredCategoryKeys,
+                             [&row](std::string_view key) {
+                               return key == row.category_key;
+                             })) {
+      return false;
+    }
+    if (!seen_keys.insert(row.category_key).second) {
+      return false;
+    }
+  }
+
+  return seen_keys.size() == kExtensionCompatibilityCatalogSize;
+}
+
+}  // namespace prometheus
