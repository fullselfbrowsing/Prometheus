+std::string_view PrometheusExtensionSmokeStageToString(
+    PrometheusExtensionSmokeStage stage) {
+  switch (stage) {
+    case PrometheusExtensionSmokeStage::kNotStarted:
+      return "not_started";
+    case PrometheusExtensionSmokeStage::kManagerLoaded:
+      return "manager_loaded";
+    case PrometheusExtensionSmokeStage::kDeveloperModeEnabled:
+      return "developer_mode_enabled";
+    case PrometheusExtensionSmokeStage::kLoadUnpackedClicked:
+      return "load_unpacked_clicked";
+    case PrometheusExtensionSmokeStage::kExtensionInstalled:
+      return "extension_installed";
+    case PrometheusExtensionSmokeStage::kInspected:
+      return "inspected";
+    case PrometheusExtensionSmokeStage::kReloaded:
+      return "reloaded";
+    case PrometheusExtensionSmokeStage::kDisabled:
+      return "disabled";
+    case PrometheusExtensionSmokeStage::kEnabled:
+      return "enabled";
+    case PrometheusExtensionSmokeStage::kPolicyExercised:
+      return "policy_exercised";
+    case PrometheusExtensionSmokeStage::kOptionsRoutingChecked:
+      return "options_routing_checked";
+    case PrometheusExtensionSmokeStage::kRemoved:
+      return "removed";
+    case PrometheusExtensionSmokeStage::kComplete:
+      return "complete";
+  }
+  return "unknown";
+}
