-  std::move(callback).Run(AgentRouteResult::Failure(
-      AgentErrorCode::kCapabilityNotReady,
-      std::string(AgentRouteNameToString(request.route_name)) +
-          " compatibility semantics are not ready",
-      "Retry after native diagnostics reports supervision ready"));
+  SweepExpired();
+
+  tabs::TabInterface* const exact_tab = request.target.tab_handle.Get();
+  if (request.session_id.empty() || !exact_tab ||
+      exact_tab->GetHandle() != request.target.tab_handle ||
+      !IsEligibleTarget(profile_, exact_browser, exact_tab)) {
+    TerminateCompatibilitySession(
+        request.session_id,
+        CompatibilityStale("The exact supervision tab is no longer live"));
+    std::move(callback).Run(
+        CompatibilityStale("The exact supervision tab is no longer live"));
+    return;
+  }
+
+  ObservedTab* const observed = AcquireObservedTab(exact_tab);
+  if (!observed || !observed->lease.data() ||
+      observed->lease.data()->owner_session_id() != request.session_id) {
+    TerminateCompatibilitySession(request.session_id,
+                                  CompatibilityOwnerMismatch());
+    ScheduleObservedTabRelease(exact_tab->GetHandle().raw_value());
+    std::move(callback).Run(CompatibilityOwnerMismatch());
+    return;
+  }
+
+  const int32_t stable_tab_id = exact_tab->GetHandle().raw_value();
+  auto existing = compatibility_sessions_.find(request.session_id);
+  if (request.route_name != AgentRouteName::kStartSupervisionSession &&
+      request.route_name != AgentRouteName::kCreateSupervisionPairing &&
+      existing != compatibility_sessions_.end() &&
+      existing->second->stable_tab_id != stable_tab_id) {
+    TerminateCompatibilitySession(
+        request.session_id,
+        CompatibilityStale("The supervision compatibility target changed"));
+    std::move(callback).Run(
+        CompatibilityStale("The supervision compatibility target changed"));
+    return;
+  }
+
+  switch (request.route_name) {
+    case AgentRouteName::kCreateSupervisionPairing: {
+      const bool opened = local_ui_opener_.Run(
+          exact_browser, GURL(chrome::kChromeUIPrometheusControlPanelURL));
+      ScheduleObservedTabRelease(stable_tab_id);
+      if (!opened) {
+        std::move(callback).Run(CompatibilityStale(
+            "The local supervision Control Panel could not be opened"));
+        return;
+      }
+      std::move(callback).Run(
+          PreflightCompatibilityResult(AgentRouteResult::SupervisionSuccess(
+              request.route_name, AgentSupervisionLocalUiResult())));
+      return;
+    }
+    case AgentRouteName::kStartSupervisionSession: {
+      if (existing != compatibility_sessions_.end()) {
+        PrometheusAgentService::RouteCallback displaced =
+            DetachCompatibilitySession(request.session_id);
+        if (displaced) {
+          std::move(displaced).Run(CompatibilityStale(
+              "A newer supervision start replaced the pending request"));
+        }
+      }
+      if (compatibility_sessions_.size() >= limits_.sessions_per_profile) {
+        ScheduleObservedTabRelease(stable_tab_id);
+        std::move(callback).Run(AgentRouteResult::Failure(
+            AgentErrorCode::kAgentCapReached,
+            "The profile supervision compatibility limit was reached",
+            "End another supervision compatibility session and retry"));
+        return;
+      }
+      const std::optional<uint64_t> generation =
+          CheckedNextSupervisionGeneration(next_compatibility_generation_);
+      CaptureHubEntry* const capture_hub =
+          GetOrCreateCaptureHub(exact_browser, exact_tab);
+      if (!generation.has_value() || !capture_hub) {
+        ScheduleObservedTabRelease(stable_tab_id);
+        std::move(callback).Run(AgentRouteResult::Failure(
+            AgentErrorCode::kCapabilityNotReady,
+            "The exact supervision capture hub is unavailable",
+            "Retry from the live Agent-owned tab"));
+        return;
+      }
+      const base::Time expiry = Now() + ViewerTtl(limits_);
+      std::optional<CaptureConsumerToken> token =
+          capture_hub->hub->AttachConsumer(
+              SupervisionCaptureConsumerKind::kAgentCompatibility, expiry);
+      if (!token.has_value()) {
+        ReleaseCaptureHubIfUnused(stable_tab_id);
+        ScheduleObservedTabRelease(stable_tab_id);
+        std::move(callback).Run(AgentRouteResult::Failure(
+            AgentErrorCode::kAgentCapReached,
+            "The exact tab supervision consumer limit was reached",
+            "End another viewer or compatibility session and retry"));
+        return;
+      }
+      next_compatibility_generation_ = *generation;
+      auto session = std::make_unique<CompatibilitySession>();
+      session->stable_tab_id = stable_tab_id;
+      session->capture_consumer_token = *token;
+      session->generation = *generation;
+      session->expires_at = expiry;
+      CompatibilitySession* const inserted = session.get();
+      compatibility_sessions_.emplace(request.session_id, std::move(session));
+      std::optional<AgentRouteResult> result = TryReadCompatibilityRoute(
+          *inserted, AgentRouteName::kStartSupervisionSession);
+      if (result.has_value()) {
+        std::move(callback).Run(std::move(*result));
+        return;
+      }
+      if (!BeginCompatibilityWait(*inserted, request.route_name,
+                                  std::move(callback))) {
+        TerminateCompatibilitySession(
+            request.session_id,
+            CompatibilityStale("The supervision baseline wait was lost"));
+      }
+      return;
+    }
+    case AgentRouteName::kGetSupervisionSnapshot:
+    case AgentRouteName::kGetSupervisionDiff: {
+      existing = compatibility_sessions_.find(request.session_id);
+      if (existing == compatibility_sessions_.end() ||
+          !RevalidateCompatibilitySession(request.session_id,
+                                          *existing->second)) {
+        TerminateCompatibilitySession(
+            request.session_id,
+            CompatibilityStale("The supervision compatibility session ended"));
+        std::move(callback).Run(CompatibilityStale(
+            "Start supervision before reading its safe stream"));
+        return;
+      }
+      CompatibilitySession& session = *existing->second;
+      if (session.pending_callback) {
+        std::move(callback).Run(AgentRouteResult::Failure(
+            AgentErrorCode::kRepeatedAction,
+            "A supervision compatibility read is already pending",
+            "Wait for the pending read to complete"));
+        return;
+      }
+      std::optional<AgentRouteResult> result =
+          TryReadCompatibilityRoute(session, request.route_name);
+      if (result.has_value()) {
+        std::move(callback).Run(std::move(*result));
+        return;
+      }
+      if (!BeginCompatibilityWait(session, request.route_name,
+                                  std::move(callback))) {
+        TerminateCompatibilitySession(
+            request.session_id,
+            CompatibilityStale("The supervision read wait was lost"));
+      }
+      return;
+    }
+    case AgentRouteName::kEndSupervisionSession: {
+      PrometheusAgentService::RouteCallback pending =
+          DetachCompatibilitySession(request.session_id);
+      if (pending) {
+        std::move(pending).Run(CompatibilityStale(
+            "The supervision compatibility session was ended"));
+      }
+      ScheduleObservedTabRelease(stable_tab_id);
+      std::move(callback).Run(
+          PreflightCompatibilityResult(AgentRouteResult::SupervisionSuccess(
+              request.route_name, AgentSupervisionEndedResult())));
+      return;
+    }
+    default:
+      ScheduleObservedTabRelease(stable_tab_id);
+      std::move(callback).Run(AgentRouteResult::Failure(
+          AgentErrorCode::kInvalidRoute,
+          "The route is not a supervision compatibility command",
+          "Use one of the five native supervision compatibility routes"));
+      return;
+  }
 }
 
