+// Phase 22 built-app extension smoke (see
+// chrome/browser/prometheus/prometheus_extension_smoke_controller.h): the
+// smoke's one-shot ui::SelectFileDialogFactory only ever answers a request
+// whose `caller` is the live, currently-committed chrome://extensions
+// WebContents that issued it. That fact must come from developer-private
+// code itself, not from the smoke controller reaching into the extension
+// system -- these two tests are the retained RED/GREEN contract for that
+// narrow copy. Retained RED: as of this commit, ShowSelectFileDialog() does
+// not yet pass a `caller` at all, so the first test fails here until a later
+// plan copies the sender's committed URL into SelectFileDialog::SelectFile().
+TEST_F(DeveloperPrivateApiUnitTest,
+      LoadUnpackedPassesCommittedManagerCallerToSelectFileDialog) {
+  std::unique_ptr<content::WebContents> web_contents(
+      content::WebContentsTester::CreateTestWebContents(profile(), nullptr));
+  content::WebContentsTester::For(web_contents.get())
+      ->NavigateAndCommit(GURL(chrome::kChromeUIExtensionsURL));
+
+  ui::FakeSelectFileDialog::Factory* factory =
+      ui::FakeSelectFileDialog::RegisterFactory();
+  bool observed_caller_present = false;
+  GURL observed_caller;
+  factory->SetOpenCallback(base::BindLambdaForTesting([&]() {
+    ui::FakeSelectFileDialog* dialog = factory->GetLastDialog();
+    ASSERT_TRUE(dialog);
+    if (dialog->caller()) {
+      observed_caller_present = true;
+      observed_caller = *dialog->caller();
+    }
+    dialog->CallFileSelectionCanceled();
+  }));
+
+  auto function =
+      base::MakeRefCounted<api::DeveloperPrivateLoadUnpackedFunction>();
+  function->SetRenderFrameHost(web_contents->GetPrimaryMainFrame());
+  EXPECT_FALSE(RunFunction(function, base::ListValue()));
+  ui::SelectFileDialog::SetFactory(nullptr);
+
+  ASSERT_TRUE(observed_caller_present)
+      << "ShowSelectFileDialog() must pass the live committed "
+        "chrome://extensions caller to SelectFileDialog::SelectFile()";
+  EXPECT_EQ(GURL(chrome::kChromeUIExtensionsURL), observed_caller);
+}
+
+// Ordinary (non-manager) senders must retain exactly today's native
+// behavior: no caller at all. This guards against the narrow developer-private
+// change ever widening to pass a caller for callers other than the live
+// chrome://extensions WebContents.
+TEST_F(DeveloperPrivateApiUnitTest,
+      LoadUnpackedPassesNoCallerForNonManagerSender) {
+  std::unique_ptr<content::WebContents> web_contents(
+      content::WebContentsTester::CreateTestWebContents(profile(), nullptr));
+  content::WebContentsTester::For(web_contents.get())
+      ->NavigateAndCommit(GURL("https://example.com/"));
+
+  ui::FakeSelectFileDialog::Factory* factory =
+      ui::FakeSelectFileDialog::RegisterFactory();
+  bool observed_caller_present = false;
+  factory->SetOpenCallback(base::BindLambdaForTesting([&]() {
+    ui::FakeSelectFileDialog* dialog = factory->GetLastDialog();
+    ASSERT_TRUE(dialog);
+    observed_caller_present = dialog->caller() != nullptr;
+    dialog->CallFileSelectionCanceled();
+  }));
+
+  auto function =
+      base::MakeRefCounted<api::DeveloperPrivateLoadUnpackedFunction>();
+  function->SetRenderFrameHost(web_contents->GetPrimaryMainFrame());
+  EXPECT_FALSE(RunFunction(function, base::ListValue()));
+  ui::SelectFileDialog::SetFactory(nullptr);
+
+  EXPECT_FALSE(observed_caller_present);
+}
