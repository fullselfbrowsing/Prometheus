+TEST(PrometheusExtensionPolicyRegistryTest,
+     ReplacementAndReorderRejectStaleOrdinalGeneration) {
+  ASSERT_TRUE(ExtensionPolicyLifecycleImplementedForTesting())
+      << "retained RED: registry lifecycle reconciliation is not implemented";
+  sync_preferences::TestingPrefServiceSyncable prefs;
+  RegisterPrometheusExtensionPolicyProfilePrefs(prefs.registry());
+  PrometheusExtensionPolicyService service(nullptr, &prefs, nullptr);
+  service.SetSystemReadyForTesting(true);
+  service.SetInventoryForTesting({MakeInventoryEntry(kFirstExtensionId),
+                                  MakeInventoryEntry(kSecondExtensionId)});
+
+  const ExtensionPolicySnapshot old_snapshot = service.GetSnapshot();
+  service.SetInventoryForTesting(
+      {MakeInventoryEntry(kSecondExtensionId),
+       MakeInventoryEntry(
+           crx_file::id_util::GenerateId("replacement-extension"))});
+  service.ReconcileForTesting();
+
+  EXPECT_EQ(ExtensionPolicyMutationResult::kStaleGeneration,
+            service.SetRequestedGrant(0, old_snapshot.generation,
+                                      /*private_mode=*/false,
+                                      ExtensionAgentGrant::kInteract));
+  EXPECT_EQ(ExtensionAgentGrant::kBlocked,
+            service.GetEffectiveGrant(kSecondExtensionId, nullptr,
+                                      /*private_mode=*/false));
+
+  const ExtensionPolicySnapshot fresh_snapshot = service.GetSnapshot();
+  ASSERT_EQ("bbbbbb", fresh_snapshot.rows.front().id_suffix);
+  EXPECT_EQ(ExtensionPolicyMutationResult::kApplied,
+            service.SetRequestedGrant(0, fresh_snapshot.generation,
+                                      /*private_mode=*/false,
+                                      ExtensionAgentGrant::kReadOnly));
+  EXPECT_EQ(ExtensionAgentGrant::kReadOnly,
+            service.GetEffectiveGrant(kSecondExtensionId, nullptr,
+                                      /*private_mode=*/false));
+}
