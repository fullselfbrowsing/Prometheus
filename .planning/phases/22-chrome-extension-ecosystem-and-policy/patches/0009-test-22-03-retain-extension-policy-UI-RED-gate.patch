+    EXPECT_TRUE(issues.empty()) << "width=" << width << " " << issues;
+  }
+
+  contents->Resize(gfx::Rect(0, 0, 640, 1000));
+  zoom::ZoomController* const zoom_controller =
+      zoom::ZoomController::FromWebContents(contents);
+  ASSERT_TRUE(zoom_controller);
+  zoom_controller->SetZoomLevel(blink::ZoomFactorToZoomLevel(2.0));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return zoom_controller->GetZoomPercent() == 200; }));
+  EXPECT_TRUE(content::EvalJs(
+                  contents,
+                  "window.prometheusExtensionPolicyResponsiveIssuesForTesting()")
+                  .ExtractString()
+                  .empty());
+  zoom_controller->SetZoomLevel(blink::ZoomFactorToZoomLevel(1.0));
+
+  std::string renderer_source;
+  std::string control_html_source;
+  std::string stylesheet_source;
+  {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    base::FilePath source_root;
+    ASSERT_TRUE(
+        base::PathService::Get(base::DIR_SRC_TEST_DATA_ROOT, &source_root));
+    ASSERT_TRUE(base::ReadFileToString(
+        source_root.AppendASCII(
+            "chrome/browser/resources/prometheus/prometheus_webui.js"),
+        &renderer_source));
+    ASSERT_TRUE(base::ReadFileToString(
+        source_root.AppendASCII("chrome/browser/resources/prometheus/"
+                                "prometheus_control_panel.html"),
+        &control_html_source));
+    ASSERT_TRUE(base::ReadFileToString(
+        source_root.AppendASCII(
+            "chrome/browser/resources/prometheus/prometheus_webui.css"),
+        &stylesheet_source));
+  }
+  const std::string packaged_sources =
+      renderer_source + control_html_source + stylesheet_source;
+  for (const std::string& forbidden : std::vector<std::string>{
+           ".innerHTML =", "insertAdjacentHTML", "<iframe", "<object",
+           "url(http://", "url(https://", "@import"}) {
+    EXPECT_EQ(std::string::npos, packaged_sources.find(forbidden)) << forbidden;
+  }
+  EXPECT_NE(std::string::npos,
