+  void OnNativeConfirmation(uint64_t generation, bool approved);
+  void ContinueAfterApproval(uint64_t generation);
+  void OnSecretRead(uint64_t generation, PrometheusSecretReadResult result);
+  void OnInsertionComplete(uint64_t generation,
