+TEST_F(PrometheusSupervisionDocumentSupplementTest,
+       EnableBeforeDocumentElementCreationObservesLaterRoot) {
+  Element* const old_root = GetDocument().documentElement();
+  ASSERT_TRUE(old_root);
+  old_root->remove();
+  test::RunPendingTasks();
+  ASSERT_FALSE(GetDocument().documentElement());
+
+  RecordingHost host;
+  Enable(host);
+
+  Element* const new_root =
+      GetDocument().CreateRawElement(html_names::kHTMLTag);
+  GetDocument().AppendChild(new_root);
+  test::RunPendingTasks();
+  AdvanceDebounce();
+
+  ASSERT_EQ(host.signals().size(), 1u);
+  EXPECT_EQ(host.signals()[0], DirtySignal::kDirty);
+
+  new_root->setAttribute(html_names::kClassAttr, AtomicString("after-create"));
+  test::RunPendingTasks();
+  AdvanceDebounce();
+
+  ASSERT_EQ(host.signals().size(), 2u);
+  EXPECT_EQ(host.signals()[1], DirtySignal::kDirty);
+}
+
+TEST_F(PrometheusSupervisionDocumentSupplementTest,
+       DocumentElementReplacementObservesNewRootMutations) {
+  RecordingHost host;
+  Enable(host);
+
+  Element* const old_root = GetDocument().documentElement();
+  ASSERT_TRUE(old_root);
+  Element* const new_root =
+      GetDocument().CreateRawElement(html_names::kHTMLTag);
+  GetDocument().ReplaceChild(new_root, old_root);
+  test::RunPendingTasks();
+  AdvanceDebounce();
+
+  ASSERT_EQ(GetDocument().documentElement(), new_root);
+  ASSERT_EQ(host.signals().size(), 1u);
+  EXPECT_EQ(host.signals()[0], DirtySignal::kDirty);
+
+  new_root->setAttribute(html_names::kClassAttr, AtomicString("replacement"));
+  test::RunPendingTasks();
+  AdvanceDebounce();
+
+  ASSERT_EQ(host.signals().size(), 2u);
+  EXPECT_EQ(host.signals()[1], DirtySignal::kDirty);
+}
