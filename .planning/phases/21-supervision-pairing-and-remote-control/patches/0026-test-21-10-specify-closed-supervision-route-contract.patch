+namespace prometheus {
+namespace {
+
+constexpr std::string_view kSession = "browser-issued-session";
+
+struct SupervisionRouteCase {
+  std::string_view name;
+  AgentRouteName route;
+};
+
+constexpr std::array<SupervisionRouteCase, kAgentSupervisionRouteCount>
+    kSupervisionRoutes = {{{"create_supervision_pairing",
+                            AgentRouteName::kCreateSupervisionPairing},
+                           {"start_supervision_session",
+                            AgentRouteName::kStartSupervisionSession},
+                           {"get_supervision_snapshot",
+                            AgentRouteName::kGetSupervisionSnapshot},
+                           {"get_supervision_diff",
+                            AgentRouteName::kGetSupervisionDiff},
+                           {"end_supervision_session",
+                            AgentRouteName::kEndSupervisionSession}}};
+
+std::string RequestJson(std::string_view route,
+                        std::string_view target = "{}",
+                        std::string_view params = "{}",
+                        std::string_view visual = "{}") {
+  return "{\"route\":\"" + std::string(route) +
+         "\",\"session_id\":\"" + std::string(kSession) +
+         "\",\"target\":" + std::string(target) +
+         ",\"params\":" + std::string(params) +
+         ",\"visual\":" + std::string(visual) + "}";
+}
+
+AgentRouteResult ParseError(std::string_view json) {
+  auto parsed = ParseAgentTransportRequest(json);
+  EXPECT_FALSE(parsed.has_value());
+  return parsed.has_value()
+             ? AgentRouteResult::Success({})
+             : std::move(parsed.error());
+}
+
+base::expected<base::DictValue, AgentRouteResult> SerializeRoot(
+    const AgentRouteResult& result) {
+  auto serialized = SerializeAgentTransportResult(result);
+  if (!serialized.has_value()) {
+    return base::unexpected(std::move(serialized.error()));
+  }
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(*serialized, base::JSON_PARSE_RFC);
+  if (!root.has_value()) {
+    return base::unexpected(AgentRouteResult::Failure(
+        AgentErrorCode::kInvalidRequest, "Serialized result was not JSON",
+        "Fix the native supervision codec"));
+  }
+  return std::move(*root);
+}
+
+AgentSupervisionNode SafeNode(std::string ref,
+                              std::string parent_ref = std::string()) {
+  AgentSupervisionNode node;
+  node.ref = std::move(ref);
+  node.parent_ref = std::move(parent_ref);
+  node.tag = "button";
+  node.role = "button";
+  node.name = "Continue";
+  node.text_snippet = "Continue";
+  node.focusable = true;
+  node.clickable = true;
+  return node;
+}
+
+const base::DictValue* SupervisionValue(const base::DictValue& root) {
+  return root.FindDict("supervision");
+}
+
+void ExpectNoAuthorityOrSecretFields(std::string_view serialized) {
+  for (std::string_view forbidden : {
+           "pairing_code", "dashboard_session", "controller_lease",
+           "browser_id", "profile_path", "tab_id", "document_token",
+           "document_epoch", "sequence", "cursor", "bearer",
+           "authorization", "api_key", "password", "payment", "otp",
+           "secret", "url", "renderer",
+       }) {
+    SCOPED_TRACE(forbidden);
+    EXPECT_EQ(std::string::npos, serialized.find(forbidden));
+  }
+}
+
+TEST(PrometheusAgentTransportCodecTest,
+     SupervisionManifestHasExactlyFiveBijectiveRoutes) {
+  static_assert(kSupervisionRoutes.size() == 5u);
+  static_assert(kAgentRouteNameCount == 37u);
+
+  std::set<std::string_view> names;
+  std::set<AgentRouteName> routes;
+  for (const auto& fixture : kSupervisionRoutes) {
+    SCOPED_TRACE(fixture.name);
+    std::optional<AgentRouteName> parsed =
+        AgentRouteNameFromString(fixture.name);
+    ASSERT_TRUE(parsed.has_value());
+    EXPECT_EQ(fixture.route, *parsed);
+    EXPECT_EQ(fixture.name, AgentRouteNameToString(fixture.route));
+    EXPECT_TRUE(names.insert(fixture.name).second);
+    EXPECT_TRUE(routes.insert(fixture.route).second);
+  }
+  EXPECT_EQ(5u, names.size());
+  EXPECT_EQ(5u, routes.size());
+  EXPECT_FALSE(AgentRouteNameFromString("start_visual_session"));
+  EXPECT_FALSE(AgentRouteNameFromString("end_visual_session"));
+  EXPECT_FALSE(AgentRouteNameFromString("create_supervision_pairing_v2"));
+  EXPECT_TRUE(
+      AgentRouteNameToString(static_cast<AgentRouteName>(999)).empty());
+}
+
+TEST(PrometheusAgentTransportCodecTest,
+     SupervisionRequestsAcceptOnlyEmptyCallerScopedObjects) {
+  constexpr std::array<std::array<std::string_view, 3>, 12> kInvalidObjects =
+      {{{R"({"tab_id":7})", "{}", "{}"},
+        {R"({"tabIndex":0})", "{}", "{}"},
+        {R"({"browser_session_id":1})", "{}", "{}"},
+        {"{}", R"({"url":"https://example.test"})", "{}"},
+        {"{}", R"({"text":"content"})", "{}"},
+        {"{}", R"({"element":{"element_ref":"node-1"}})", "{}"},
+        {"{}", R"({"document_token":"epoch"})", "{}"},
+        {"{}", R"({"session_id":"chosen"})", "{}"},
+        {"{}", R"({"pairing_code":"AAAA-BBBB"})", "{}"},
+        {"{}", R"({"cursor":1})", "{}"},
+        {"{}", "{}", R"({"client":"Codex"})"},
+        {"{}", "{}", R"({"visual_reason":"content"})"}}};
+
+  for (const auto& fixture : kSupervisionRoutes) {
+    SCOPED_TRACE(fixture.name);
+    auto parsed = ParseAgentTransportRequest(RequestJson(fixture.name));
+    ASSERT_TRUE(parsed.has_value()) << parsed.error().message;
+    EXPECT_EQ(fixture.route, parsed->route_name);
+    EXPECT_EQ(kSession, parsed->session_id);
+    EXPECT_EQ(tabs::TabHandle::NullValue,
+              parsed->target.tab_handle.raw_value());
+    EXPECT_FALSE(parsed->target.browser_session_id.has_value());
+    EXPECT_FALSE(parsed->target.window_session_id.has_value());
+    EXPECT_FALSE(parsed->target.tab_index.has_value());
+    EXPECT_FALSE(parsed->page_request.has_value());
+    EXPECT_FALSE(parsed->visual_context.has_value());
+    EXPECT_FALSE(parsed->url.has_value());
+    EXPECT_FALSE(parsed->internal_surface.has_value());
+
+    for (const auto& [target, params, visual] : kInvalidObjects) {
+      AgentRouteResult error =
+          ParseError(RequestJson(fixture.name, target, params, visual));
+      EXPECT_EQ(AgentErrorCode::kInvalidRequest, error.error_code);
+    }
+  }
+
+  AgentRouteResult top_level = ParseError(
+      R"({"route":"get_supervision_diff","session_id":"s","target":{},"params":{},"visual":{},"owner_id":"chosen"})");
+  EXPECT_EQ(AgentErrorCode::kInvalidRequest, top_level.error_code);
+}
