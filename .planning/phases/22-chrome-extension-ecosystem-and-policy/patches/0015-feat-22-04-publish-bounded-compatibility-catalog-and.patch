+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PROMETHEUS_PROMETHEUS_EXTENSION_COMPATIBILITY_CATALOG_H_
+#define CHROME_BROWSER_PROMETHEUS_PROMETHEUS_EXTENSION_COMPATIBILITY_CATALOG_H_
+
+#include <array>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/values.h"
+
+namespace prometheus {
+
+// Closed bounded result vocabulary for representative extension-category
+// compatibility evidence. There is no "generally supported" value: every
+// result is scoped to the exact fixture/version/build/revision recorded
+// alongside it.
+enum class ExtensionCompatibilityResult {
+  kVerified,
+  kDegraded,
+  kUnsupported,
+};
+
+// Exactly five Prometheus-owned MV3 fixtures form the acceptance catalog.
+// This enum exists only to key `kExtensionCompatibilityCatalog` below; it is
+// not a general extension taxonomy.
+enum class ExtensionCompatibilityCategory {
+  kPasswordManagerLike,
+  kAdBlocker,
+  kProductivityContentScript,
+  kSidePanelTooling,
+  kDeveloperWorkflow,
+};
+
+inline constexpr size_t kExtensionCompatibilityCatalogSize = 5;
+inline constexpr size_t kExtensionCompatibilitySha256HexLength = 64;
+
+// One closed, bounded evidence row. Every field is a fixed compile-time
+// constant baked from the last exact fixture proof (see
+// `prometheus_extension_fixtures_browsertest.cc`); nothing here is derived
+// from live user data, network state, or renderer/MCP input. Regenerating
+// `22-COMPATIBILITY.json`/`.md` from a fresh fixture run and this catalog must
+// agree, and `verify-phase-22-extension-fixtures.sh` statically enforces that
+// agreement for `fixture_sha256`.
+struct ExtensionCompatibilityRow {
+  ExtensionCompatibilityCategory category =
+      ExtensionCompatibilityCategory::kPasswordManagerLike;
+
+  // Machine-stable key matching the fixture directory name under
+  // chrome/test/data/prometheus/extensions/.
+  std::string_view category_key;
+
+  // Exact human-facing label rendered by the existing Control Panel Parity
+  // Matrix renderer (`controlExtensionCompatibilityCategories` in
+  // prometheus_webui.js). Must not change without updating that closed list.
+  std::string_view category_label;
+
+  std::string_view fixture_name;
+  std::string_view fixture_version;
+
+  // Lowercase hex SHA-256 of the fixture's manifest.json, exactly
+  // `kExtensionCompatibilitySha256HexLength` characters.
+  std::string_view fixture_sha256;
+
+  int manifest_version = 3;
+
+  // How the fixture was installed for this evidence row. Every row in this
+  // catalog is loaded through the same developer-mode unpacked path; no row
+  // may claim Chrome Web Store support.
+  std::string_view install_source;
+
+  // Exact Prometheus/Chromium build and nested source revision this evidence
+  // was captured against (see chrome/VERSION and the nested git HEAD at
+  // capture time).
+  std::string_view prometheus_build;
+  std::string_view chromium_revision;
+
+  // Whether the browser test evidence exercised the extension while resolving
+  // Agent policy in a regular profile / an explicit Private (OTR) profile
+  // check, respectively. Only rows whose browser test actually calls
+  // `GetEffectiveGrant(..., /*private_mode=*/true)` may set the private flag;
+  // the shared policy/surface-resolver unit tests separately cover the full
+  // Private-mode lattice for every category.
+  bool regular_mode_exercised = true;
+  bool private_mode_exercised = false;
+
+  std::string_view actions_exercised;
+  ExtensionCompatibilityResult result = ExtensionCompatibilityResult::kVerified;
+  std::string_view limitation;
+
+  // Qualified `file.cc:Suite.Test` pointer to the exact retained evidence.
+  std::string_view evidence_artifact;
+
+  // ISO-8601 UTC timestamp of the fixture run this row reflects.
+  std::string_view last_verified;
+};
+
+// Returns the closed, bounded, exactly-five-row acceptance catalog in fixed
+// category order (password-manager-like, ad blocker, productivity content
+// script, side panel/tooling, developer workflow). The returned span is
+// backed by static storage and never mutates at runtime; there is no
+// per-profile, per-install, or live-network variant.
+const std::array<ExtensionCompatibilityRow, kExtensionCompatibilityCatalogSize>&
+GetExtensionCompatibilityCatalog();
+
+std::string_view ExtensionCompatibilityResultToString(
+    ExtensionCompatibilityResult result);
+std::optional<ExtensionCompatibilityResult> ExtensionCompatibilityResultFromString(
+    std::string_view value);
+
+// Projects one row into the same bounded shape the local Control Panel
+// already renders (see `normalizeControlExtensionCompatibility` in
+// prometheus_webui.js): `category`, `status`, `fixture`, `manifest`,
+// `source`, `behaviors`, `revision`, `last_verified`, `limitation`. `status`
+// is lowercased (`verified`/`degraded`/`unsupported`) to match the existing
+// renderer contract; every other field is bounded plain text with no
+// extension ID, permission, page content, or authority material.
+base::DictValue ExtensionCompatibilityRowToValue(
+    const ExtensionCompatibilityRow& row);
+
+// True iff the catalog has exactly five rows, unique category keys equal to
+// the required five, MV3 manifests, valid lowercase-hex SHA-256 fixture
+// hashes, and only closed `ExtensionCompatibilityResult` values. Used by the
+// unit test and safe to call from production code as a defensive assertion
+// seam.
+bool IsClosedExtensionCompatibilityCatalog();
+
+}  // namespace prometheus
+
+#endif  // CHROME_BROWSER_PROMETHEUS_PROMETHEUS_EXTENSION_COMPATIBILITY_CATALOG_H_
