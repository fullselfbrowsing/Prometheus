diff --git a/chrome/browser/prometheus/prometheus_chrome_mode.cc b/chrome/browser/prometheus/prometheus_chrome_mode.cc
new file mode 100644
index 0000000000..eb20480b07
--- /dev/null
+++ b/chrome/browser/prometheus/prometheus_chrome_mode.cc
@@ -0,0 +1,43 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/prometheus/prometheus_chrome_mode.h"
+
+#include <string>
+
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+
+namespace {
+
+constexpr std::string_view kSeparateMode = "separate";
+constexpr std::string_view kCompactMode = "compact";
+
+}  // namespace
+
+PrometheusChromeMode PrometheusChromeModeFromString(std::string_view value) {
+  if (value == kCompactMode) {
+    return PrometheusChromeMode::kCompact;
+  }
+  return PrometheusChromeMode::kSeparate;
+}
+
+std::string_view PrometheusChromeModeToString(PrometheusChromeMode mode) {
+  switch (mode) {
+    case PrometheusChromeMode::kSeparate:
+      return kSeparateMode;
+    case PrometheusChromeMode::kCompact:
+      return kCompactMode;
+  }
+}
+
+PrometheusChromeMode GetPrometheusChromeMode(const PrefService& prefs) {
+  return PrometheusChromeModeFromString(
+      prefs.GetString(prefs::kPrometheusChromeMode));
+}
+
+void SetPrometheusChromeMode(PrefService& prefs, PrometheusChromeMode mode) {
+  prefs.SetString(prefs::kPrometheusChromeMode,
+                  std::string(PrometheusChromeModeToString(mode)));
+}
diff --git a/chrome/browser/prometheus/prometheus_chrome_mode.h b/chrome/browser/prometheus/prometheus_chrome_mode.h
new file mode 100644
index 0000000000..bb6d367bb1
--- /dev/null
+++ b/chrome/browser/prometheus/prometheus_chrome_mode.h
@@ -0,0 +1,23 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PROMETHEUS_PROMETHEUS_CHROME_MODE_H_
+#define CHROME_BROWSER_PROMETHEUS_PROMETHEUS_CHROME_MODE_H_
+
+#include <string_view>
+
+class PrefService;
+
+enum class PrometheusChromeMode {
+  kSeparate,
+  kCompact,
+};
+
+PrometheusChromeMode PrometheusChromeModeFromString(std::string_view value);
+std::string_view PrometheusChromeModeToString(PrometheusChromeMode mode);
+
+PrometheusChromeMode GetPrometheusChromeMode(const PrefService& prefs);
+void SetPrometheusChromeMode(PrefService& prefs, PrometheusChromeMode mode);
+
