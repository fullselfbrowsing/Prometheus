+  AgentRouteResult validation =
+      validation_callback.Run(web_contents, frame);
+  if (!validation.ok) {
+    std::move(callback).Run(std::move(validation));
+    return;
+  }
+  if (!snapshot_result.has_value()) {
+    std::move(callback).Run(VerificationFailed(
+        "Failed to extract extension page content",
+        "Reopen the extension surface and retry the snapshot route"));
+    return;
+  }
+  const optimization_guide::proto::AnnotatedPageContent& page_content =
+      snapshot_result.value().proto;
+  if (!page_content.has_main_frame_data() ||
+      !page_content.main_frame_data().has_document_identifier() ||
+      page_content.main_frame_data()
+          .document_identifier()
+          .serialized_token()
+          .empty()) {
+    std::move(callback).Run(
+        AdmissionFailure(PrometheusExtensionAdmissionDenial::kStalePolicy));
+    return;
+  }
+  const bool compact = route_name == AgentRouteName::kGetPageSnapshot;
+  const size_t max_nodes = page_request.read_options.max_nodes > 0
+                               ? page_request.read_options.max_nodes
+                               : (compact ? kDefaultCompactSnapshotMaxNodes
+                                          : kDefaultDomSnapshotMaxNodes);
+  const size_t max_chars = page_request.read_options.max_chars > 0
+                               ? page_request.read_options.max_chars
+                               : kDefaultSnapshotMaxChars;
+  AgentPageResult page_result;
+  std::string snapshot_json = BuildSnapshotJson(
+      page_content,
+      page_content.main_frame_data().document_identifier().serialized_token(),
+      compact, max_nodes, max_chars, &page_result.truncated,
+      &page_result.omitted_count);
+  if (compact) {
+    page_result.compact_snapshot_json = std::move(snapshot_json);
+  } else {
+    page_result.dom_snapshot_json = std::move(snapshot_json);
+  }
+  AgentRouteResult result = AgentRouteResult::Success(
+      {compact ? "compact_snapshot_returned" : "snapshot_returned"});
+  result.page_result = std::move(page_result);
+  std::move(callback).Run(std::move(result));
+}
+
+void PrometheusExtensionPageAdapter::OnElementReadFinished(
+    uint64_t operation_id) {
+  in_flight_element_read_operations_.erase(operation_id);
+}
+
+bool PrometheusExtensionPageAdapter::RecordActionFingerprint(
+    std::string session_id,
+    int32_t tab_handle_value,
+    std::string fingerprint) {
+  return action_history_.RecordAndCheck(
+      {.session_id = std::move(session_id),
+       .tab_handle_value = tab_handle_value,
+       .fingerprint = std::move(fingerprint)});
+}
+
+void PrometheusExtensionPageAdapter::OnActionOperationFinished(
+    uint64_t operation_id) {
+  in_flight_action_operations_.erase(operation_id);
 }
 
