+  browser_weak_factory_.InvalidateWeakPtrs();
+  EXPECT_FALSE(service_->ReadDashboardDiff(viewer_c.dashboard_session).ok);
+  EXPECT_EQ(1, target_wait_c_count);
+  EXPECT_EQ(1, target_wait_d_count);
+  EXPECT_EQ(0u, service_->capture_hub_count_for_testing());
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(1, target_wait_c_count);
+  EXPECT_EQ(1, target_wait_d_count);
+}
