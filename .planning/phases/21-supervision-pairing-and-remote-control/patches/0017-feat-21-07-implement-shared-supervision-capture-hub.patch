     SupervisionCaptureConsumerId consumer_id) const {
-  return true;
+  const auto consumer = consumers_.find(consumer_id);
+  return consumer == consumers_.end() || consumer->second.expiry <= Now() ||
+         consumer->second.needs_baseline;
 }
 
