+base::DictValue SupervisionOperationValue(SupervisionServiceResult result) {
+  base::DictValue value;
+  value.Set("accepted", result.ok);
+  if (result.ok) {
+    value.Set("status", "OK");
+  } else {
+    const std::optional<std::string_view> error =
+        SupervisionErrorCodeToString(result.error_code);
+    value.Set("status",
+              error ? base::ToUpperASCII(std::string(*error)) : "NOT_READY");
+  }
+  if (!result.recovery.empty()) {
+    value.Set("recovery", std::move(result.recovery));
+  }
+  return value;
+}
+
+PrometheusSidePanelSupervisionActionCategory SidePanelActionCategory(
+    SupervisionRemoteActionCategory category) {
+  switch (category) {
+    case SupervisionRemoteActionCategory::kClick:
+      return PrometheusSidePanelSupervisionActionCategory::kClick;
+    case SupervisionRemoteActionCategory::kType:
+      return PrometheusSidePanelSupervisionActionCategory::kType;
+    case SupervisionRemoteActionCategory::kKeyPress:
+      return PrometheusSidePanelSupervisionActionCategory::kKeyPress;
+    case SupervisionRemoteActionCategory::kScroll:
+      return PrometheusSidePanelSupervisionActionCategory::kScroll;
+    case SupervisionRemoteActionCategory::kHover:
+      return PrometheusSidePanelSupervisionActionCategory::kHover;
+    case SupervisionRemoteActionCategory::kSelect:
+      return PrometheusSidePanelSupervisionActionCategory::kSelect;
+    case SupervisionRemoteActionCategory::kClear:
+      return PrometheusSidePanelSupervisionActionCategory::kClear;
+    case SupervisionRemoteActionCategory::kDrag:
+      return PrometheusSidePanelSupervisionActionCategory::kDrag;
+    case SupervisionRemoteActionCategory::kDrop:
+      return PrometheusSidePanelSupervisionActionCategory::kDrop;
+    case SupervisionRemoteActionCategory::kNavigate:
+      return PrometheusSidePanelSupervisionActionCategory::kNavigate;
+  }
+}
+
+PrometheusSidePanelSupervisionSnapshot SidePanelSupervisionSnapshot(
+    tabs::TabInterface* selected_tab,
+    const SanitizedSupervisionSnapshot& source,
+    bool stopping,
+    bool ending) {
+  PrometheusSidePanelSupervisionSnapshot snapshot;
+  snapshot.available = selected_tab && source.target.eligible;
+  snapshot.viewer_count = source.target.viewer_count;
+  snapshot.controlled = source.target.controller_label.has_value();
+  snapshot.safe_target_title = SanitizeSidePanelSupervisionTargetTitle(
+      selected_tab ? std::u16string_view(selected_tab->GetTitle())
+                   : std::u16string_view());
+  snapshot.stopping = stopping;
+  snapshot.ending = ending;
+  if (snapshot.controlled) {
+    snapshot.client_label = source.target.controller_label;
+    snapshot.activity =
+        PrometheusSidePanelSupervisionActivity::kControlReady;
+  } else if (!source.sessions.empty()) {
+    snapshot.client_label = source.sessions.front().client.display_label;
+  }
+
+  for (const SupervisionSessionSnapshot& session : source.sessions) {
+    if (session.viewer_state == SupervisionViewerState::kController) {
+      snapshot.controlled = true;
+      snapshot.client_label = session.client.display_label;
+      snapshot.activity =
+          PrometheusSidePanelSupervisionActivity::kControlReady;
+    }
+    if (session.stream_state == SupervisionStreamState::kPaused) {
+      snapshot.resyncing = true;
+      snapshot.activity =
+          PrometheusSidePanelSupervisionActivity::kPausedForResync;
+    } else if (session.stream_state == SupervisionStreamState::kResyncing) {
+      snapshot.resyncing = true;
+      snapshot.activity =
+          PrometheusSidePanelSupervisionActivity::kResyncing;
+    }
+    switch (session.action_state) {
+      case SupervisionRemoteActionState::kIdle:
+      case SupervisionRemoteActionState::kCompleted:
+        break;
+      case SupervisionRemoteActionState::kValidating:
+        snapshot.activity =
+            PrometheusSidePanelSupervisionActivity::kValidatingRemoteAction;
+        break;
+      case SupervisionRemoteActionState::kExecuting:
+      case SupervisionRemoteActionState::kVerifying:
+        snapshot.activity =
+            PrometheusSidePanelSupervisionActivity::kRemoteAction;
+        if (session.action_category.has_value()) {
+          snapshot.action_category =
+              SidePanelActionCategory(*session.action_category);
+        }
+        break;
+      case SupervisionRemoteActionState::kAwaitingConfirmation:
+        snapshot.activity =
+            PrometheusSidePanelSupervisionActivity::kConfirmationRequired;
+        break;
+      case SupervisionRemoteActionState::kBlocked:
+      case SupervisionRemoteActionState::kFailed:
+        snapshot.activity =
+            PrometheusSidePanelSupervisionActivity::kRemoteActionBlocked;
+        break;
+    }
+  }
+  if (stopping) {
+    snapshot.activity =
+        PrometheusSidePanelSupervisionActivity::kStoppingControl;
+  }
+  return snapshot;
+}
