+IN_PROC_BROWSER_TEST_F(
+    PrometheusAgentGatewayBrowserTest,
+    SupervisionDispatchesAllSevenOperationsThroughInstalledFake) {
+  for (size_t index = 0; index < kSupervisionRequests.size(); ++index) {
+    SCOPED_TRACE(index);
+    auto expected =
+        ParseSupervisionTransportRequest(kSupervisionRequests[index]);
+    ASSERT_TRUE(expected.has_value()) << expected.error().message;
+    HttpResult response = Authorized("POST", "/v1/supervision",
+                                     kSupervisionRequests[index]);
+    EXPECT_EQ(200, response.status);
+    ExpectSecureResponseHeaders(response);
+    auto body = base::JSONReader::ReadDict(response.body, base::JSON_PARSE_RFC);
+    ASSERT_TRUE(body.has_value()) << response.body;
+    EXPECT_EQ(true, body->FindBool("ok"));
+    ASSERT_EQ(index + 1, supervision_requests_.size());
+    EXPECT_EQ(expected->operation,
+              supervision_requests_.back().transport.operation);
+    EXPECT_EQ(expected->params.index(),
+              supervision_requests_.back().transport.params.index());
+    EXPECT_TRUE(supervision_requests_.back().cancellation_token);
