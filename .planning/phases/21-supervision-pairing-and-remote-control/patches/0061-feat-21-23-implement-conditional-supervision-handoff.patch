+    if (input[position] == '}') {
+      ++position;
+      SkipWhitespace(input, &position);
+      return position == input.size() ? ObjectScanResult::kValid
+                                      : ObjectScanResult::kMalformed;
+    }
+    if (input[position++] != ',') {
+      return ObjectScanResult::kMalformed;
+    }
+    SkipWhitespace(input, &position);
+  }
+  return ObjectScanResult::kMalformed;
+}
