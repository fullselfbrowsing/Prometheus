+std::optional<AgentExtensionSurfaceSelector>
+AgentExtensionSurfaceSelectorFromString(std::string_view surface) {
+  if (surface == "popup") {
+    return AgentExtensionSurfaceSelector::kPopup;
+  }
+  if (surface == "side_panel") {
+    return AgentExtensionSurfaceSelector::kSidePanel;
+  }
+  return std::nullopt;
